# The repository art is generated. render_repo_art.py writes LF on every
# platform, and the gate's receipt records each file's byte count and SHA-256
# read from the checked-out bytes. Pinning the checkout keeps those numbers the
# same whoever cloned the repository.
docs/art/*.svg text eol=lf
docs/art/*.json text eol=lf

# Registry packages are hashed byte for byte (see docs/PACKAGES.md). Git must
# not rewrite their line endings on checkout, or a Windows clone would hash
# differently from a Linux one. `buildc pkg publish` writes text with LF.
registry/** -text

# The held-out probe is checked against MANIFEST.sha256, so its bytes stay as committed.
bench/heldout-2026-11-08/** -text
