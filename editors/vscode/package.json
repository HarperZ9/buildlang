{
  "name": "buildlang",
  "displayName": "BuildLang",
  "description": "BuildLang language support: syntax highlighting, snippets, bracket matching, and buildc LSP client for .bld files.",
  "version": "1.15.0",
  "publisher": "HarperZ9",
  "icon": "icons/icon.png",
  "homepage": "https://harperz9.github.io/buildlang.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarperZ9/buildlang.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/HarperZ9/buildlang/issues"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "buildlang",
    "compiler",
    "algebraic-effects",
    "capability-security",
    "shaders",
    "hlsl",
    "glsl",
    "wgsl",
    "metal",
    "systems-programming"
  ],
  "galleryBanner": {
    "color": "#0b0f1a",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:buildlang"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "buildlang",
        "aliases": [
          "BuildLang",
          "build"
        ],
        "extensions": [
          ".bld"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/build-light.png",
          "dark": "./icons/build-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "buildlang",
        "scopeName": "source.bld",
        "path": "./syntaxes/buildlang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "buildlang",
        "path": "./snippets/buildlang.json"
      }
    ],
    "configuration": {
      "title": "BuildLang",
      "properties": {
        "buildlang.serverPath": {
          "type": "string",
          "default": "buildc",
          "description": "Path to the buildc compiler binary"
        },
        "buildlang.target": {
          "type": "string",
          "default": "c",
          "enum": [
            "c",
            "hlsl",
            "glsl",
            "wgsl",
            "msl",
            "spirv",
            "llvm",
            "wasm",
            "x86-64",
            "arm64",
            "riscv64",
            "rust"
          ],
          "description": "Default compilation target"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
