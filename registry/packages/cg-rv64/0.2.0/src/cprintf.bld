// cg-rv64: printf. `println!` reaches the MIR as a call of printf with a
// C format string. The generator reads the format when it compiles the
// call and emits one runtime call for each run of plain bytes and for
// each conversion, so the runtime holds no format interpreter and a
// conversion the generator does not cover is refused by name.
//
// Conversions covered: %% %d %u %lld %llu %x %llx with an optional 0 flag
// and width on the hex forms, and %s for a Bool (printed as true or
// false, as the C backend does) and for a string constant.

// The string number of the format of a printf whose first argument is
// v: v is a string constant, or a local that the function assigns once,
// from a string constant. CG_NONE otherwise.
fn cp_format(g: &Cg, d: &CjDoc, v: u64) -> u64 {
    let c = cv_const(d, v);
    if cj_tag_is(d, c, "Str") { return cj_mag(d, cj_body(d, c)); }
    if !cv_is_local(d, v) { return CG_NONE; }
    let id = cv_local(d, v);
    let loc = cj_at(d, cj_get(d, g.fnode, "locals"), id);
    if cj_kind(d, cj_get(d, loc, "is_param")) != CJ_FALSE { return CG_NONE; }
    let mut defs: u64 = 0_u64;
    let mut idx = CG_NONE;
    let mut b = cj_first(d, cj_get(d, g.fnode, "blocks"));
    while b != CG_NONE {
        let mut s = cj_first(d, cj_get(d, b, "stmts"));
        while s != CG_NONE {
            let a = cj_get(d, cj_get(d, s, "kind"), "Assign");
            if a != CG_NONE && cj_mag(d, cj_get(d, a, "dest")) == id {
                defs = defs + 1_u64;
                let sc = cv_const(d, cj_get(d, cj_get(d, a, "value"), "Use"));
                if cj_tag_is(d, sc, "Str") { idx = cj_mag(d, cj_body(d, sc)); }
            }
            s = cj_next(d, s);
        }
        let call = cj_get(d, cj_get(d, b, "terminator"), "Call");
        let dn = cj_get(d, call, "dest");
        if call != CG_NONE && cj_kind(d, dn) == CJ_NUM && cj_mag(d, dn) == id { defs = defs + 1_u64; }
        b = cj_next(d, b);
    }
    if defs != 1_u64 { return CG_NONE; }
    idx
}

// Prints the plain bytes gathered in lit, if any.
fn cp_flush(g: &mut Cg) {
    let n = g.lit.len() as u64;
    if n == 0_u64 { return; }
    cv_bytes(g, 10_u64, n, true);
    ci_jal(g, 1_u64, "rt_puts");
    g.lit.clear();
}

// The integer type of a printf argument: of a local or global, or the
// type written on an integer constant. CG_NONE for anything else.
fn cp_int_ty(g: &Cg, d: &CjDoc, arg: u64) -> u64 {
    let mut t = cv_ty(g, d, arg);
    if t == CG_NONE && cv_is_int(d, arg) { t = cv_int_ty(d, arg); }
    if ct_kind(d, t) != CT_INT { return CG_NONE; }
    t
}

// %d %u %x and their ll forms. C reads a %d argument as int and a %lld
// argument as long long, so the width of the argument type must be the
// width the conversion reads: 64 bits with ll, at most 32 without.
// Defect 16 pads a hex number with spaces where the format asks for
// zeros.
fn cp_int(g: &mut Cg, d: &CjDoc, arg: u64, conv: u8, ll: bool, zero: bool, width: u64) {
    let t = cp_int_ty(g, d, arg);
    let wide = ct_bits(d, t) == 64_u64;
    let hex = conv == 120_u8;
    let sign_ok = hex || ct_signed(d, t) == (conv == 100_u8);
    if t == CG_NONE || wide != ll || !sign_ok || (!hex && (zero || width != 0_u64)) || width > 64_u64 {
        cg_refuse(g, d, "printf conversion that does not fit the type of its argument");
        return;
    }
    cv_load(g, d, 10_u64, arg, t);
    if !hex {
        if conv == 100_u8 { ci_jal(g, 1_u64, "rt_put_i64"); } else { ci_jal(g, 1_u64, "rt_put_u64"); }
        return;
    }
    if !ll {
        ci_i(g, "slli", 10_u64, 10_u64, 32_u64);
        ci_i(g, "srli", 10_u64, 10_u64, 32_u64);
    }
    ci_li(g, 11_u64, width);
    if zero && g.v != CGC_HEXPAD { ci_li(g, 12_u64, 48_u64); } else { ci_li(g, 12_u64, 32_u64); }
    ci_jal(g, 1_u64, "rt_put_hex");
}

// %s: a Bool prints as true or false; a string constant prints as its
// bytes.
fn cp_str(g: &mut Cg, d: &CjDoc, arg: u64) {
    let t = cv_ty(g, d, arg);
    let c = cv_const(d, arg);
    if ct_kind(d, t) == CT_BOOL || cv_is_bool(d, arg) {
        if ct_kind(d, t) == CT_BOOL {
            cv_load(g, d, 5_u64, arg, t);
        } else {
            ci_li(g, 5_u64, 0_u64);
            if cj_kind(d, cj_body(d, c)) == CJ_TRUE { ci_li(g, 5_u64, 1_u64); }
        }
        cv_text(g, 10_u64, "false");
        ci_skip(g, "beq", 5_u64, 0_u64, 3_u64);
        cv_text(g, 10_u64, "true");
        g.lit.clear();
        ci_jal(g, 1_u64, "rt_puts");
        return;
    }
    let mut tmp: Vec<u8> = Vec::new();
    if !cj_tag_is(d, c, "Str") || !cv_string(g, d, cj_mag(d, cj_body(d, c)), &mut tmp) {
        cg_refuse(g, d, "printf %s whose argument is neither a Bool nor a string constant");
        return;
    }
    g.fmt.clear();
    let mut i: usize = 0;
    while i < tmp.len() {
        g.fmt.push(tmp[i]);
        i = i + 1;
    }
    cv_bytes(g, 10_u64, tmp.len() as u64, false);
    ci_jal(g, 1_u64, "rt_puts");
}

// One conversion. f[at] is the byte after the percent sign. Returns the
// index after the conversion.
fn cp_conv(g: &mut Cg, d: &CjDoc, f: &Vec<u8>, at: usize, arg: u64) -> usize {
    let mut i = at;
    let mut zero = false;
    let mut width: u64 = 0_u64;
    let mut ll = false;
    if i < f.len() && f[i] == 48_u8 {
        zero = true;
        i = i + 1;
    }
    while i < f.len() && f[i] >= 48_u8 && f[i] <= 57_u8 && width < 1000_u64 {
        width = width * 10_u64 + (f[i] - 48_u8) as u64;
        i = i + 1;
    }
    if i + 1 < f.len() && f[i] == 108_u8 && f[i + 1] == 108_u8 {
        ll = true;
        i = i + 2;
    }
    let mut conv: u8 = 0_u8;
    if i < f.len() { conv = f[i]; }
    if arg == CG_NONE {
        cg_refuse(g, d, "printf with fewer arguments than conversions");
    } else if conv == 100_u8 || conv == 117_u8 || conv == 120_u8 {
        cp_int(g, d, arg, conv, ll, zero, width);
    } else if conv == 115_u8 && !zero && width == 0_u64 && !ll {
        cp_str(g, d, arg);
    } else {
        cg_refuse(g, d, "printf conversion outside %d %u %lld %llu %x %llx %s");
    }
    i + 1
}

// The call printf(format, args...).
fn cp_printf(g: &mut Cg, d: &CjDoc, body: u64) {
    let a0 = cj_first(d, cj_get(d, body, "args"));
    let idx = cp_format(g, d, a0);
    let mut f: Vec<u8> = Vec::new();
    if idx == CG_NONE || !cv_string(g, d, idx, &mut f) {
        cg_refuse(g, d, "printf whose format is not one string constant the generator can read");
        return;
    }
    g.lit.clear();
    let mut arg = cj_next(d, a0);
    let mut i: usize = 0;
    while i < f.len() {
        if f[i] != 37_u8 {
            g.lit.push(f[i]);
            i = i + 1;
        } else if i + 1 < f.len() && f[i + 1] == 37_u8 {
            g.lit.push(37_u8);
            i = i + 2;
        } else {
            cp_flush(g);
            i = cp_conv(g, d, &f, i + 1, arg);
            arg = cj_next(d, arg);
        }
    }
    cp_flush(g);
    if arg != CG_NONE { cg_refuse(g, d, "printf with more arguments than conversions"); }
}
