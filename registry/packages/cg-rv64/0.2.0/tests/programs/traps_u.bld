// Generated by tests/tools/gen_corpus.py: arithmetic traps of the
// unsigned types. run(k) takes case k % 16 of type k / 16. A case
// that traps prints the case number, then the trap line, and ends with
// status 101. tests/corpus.txt lists the range of k.

fn trap_u8(op: u64) ~ Console {
    let hi: u8 = 255_u8;
    let zero: u8 = 0_u8;
    let one: u8 = 1_u8;
    if op == 0_u64 { println!("{}", hi + one); }
    if op == 1_u64 { println!("{}", zero - one); }
    if op == 2_u64 { println!("{}", hi * 2_u8); }
    if op == 3_u64 { println!("{}", hi / zero); }
    if op == 4_u64 { println!("{}", hi % zero); }
    if op == 5_u64 { println!("{}", (hi - one) + one); }
}

fn trap_u16(op: u64) ~ Console {
    let hi: u16 = 65535_u16;
    let zero: u16 = 0_u16;
    let one: u16 = 1_u16;
    if op == 0_u64 { println!("{}", hi + one); }
    if op == 1_u64 { println!("{}", zero - one); }
    if op == 2_u64 { println!("{}", hi * 2_u16); }
    if op == 3_u64 { println!("{}", hi / zero); }
    if op == 4_u64 { println!("{}", hi % zero); }
    if op == 5_u64 { println!("{}", (hi - one) + one); }
}

fn trap_u32(op: u64) ~ Console {
    let hi: u32 = 4294967295_u32;
    let zero: u32 = 0_u32;
    let one: u32 = 1_u32;
    if op == 0_u64 { println!("{}", hi + one); }
    if op == 1_u64 { println!("{}", zero - one); }
    if op == 2_u64 { println!("{}", hi * 2_u32); }
    if op == 3_u64 { println!("{}", hi / zero); }
    if op == 4_u64 { println!("{}", hi % zero); }
    if op == 5_u64 { println!("{}", (hi - one) + one); }
}

fn trap_u64(op: u64) ~ Console {
    let hi: u64 = 18446744073709551615_u64;
    let zero: u64 = 0_u64;
    let one: u64 = 1_u64;
    if op == 0_u64 { println!("{}", hi + one); }
    if op == 1_u64 { println!("{}", zero - one); }
    if op == 2_u64 { println!("{}", hi * 2_u64); }
    if op == 3_u64 { println!("{}", hi / zero); }
    if op == 4_u64 { println!("{}", hi % zero); }
    if op == 5_u64 { println!("{}", (hi - one) + one); }
}

fn run(k: u64) ~ Console {
    println!("case {}", k);
    if k / 16_u64 == 0_u64 { trap_u8(k % 16_u64); }
    if k / 16_u64 == 1_u64 { trap_u16(k % 16_u64); }
    if k / 16_u64 == 2_u64 { trap_u32(k % 16_u64); }
    if k / 16_u64 == 3_u64 { trap_u64(k % 16_u64); }
    println!("no trap");
}

fn main() ~ Console + Process + Environment {
    run(args_get(1).parse_int() as u64);
}
