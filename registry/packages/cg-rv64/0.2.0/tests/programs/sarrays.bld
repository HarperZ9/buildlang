// Differential corpus, since 0.2.0: struct literals with an array field
// beside other fields (refused by 0.1.0), stores into array fields of
// locals, nested structs and arrays of structs, and an element store
// through a slice of structs. Written by tests/tools/gen_corpus2.py.

struct A_u8 { a: u8, w: [u8; 3], z: i64 }
struct B_u8 { w: [u8; 4], b: u16 }
struct C_u8 { c: i32, w: [u8; 1] }
struct N_u8 { h: u8, inner: A_u8, ws: [A_u8; 2] }
fn mk_u8(k: u64) -> A_u8 { A_u8 { a: k as u8, w: [51_u8, 228_u8, 149_u8], z: -7_i64 } }
fn sw_u8(xs: &mut [A_u8], i: u64, v: u8) { xs[i].w[i % 3] = v; xs[i].a = 9_u8; }
fn byv_u8(mut x: A_u8) -> u8 { x.w[1] = 0_u8; x.w[1] }
fn sec_u8(k: u64) ~ Console {
    let four: [u8; 4] = [255_u8, 168_u8, 89_u8, 10_u8];
    let mut a = A_u8 { a: 1_u8, w: [0_u8, 255_u8, 29_u8], z: -2_i64 };
    let b = B_u8 { w: four, b: 9_u16 };
    let c = C_u8 { c: -1_i32, w: [206_u8] };
    println!("{} {} {} {} {} {} {} {} {} {}", a.a, a.w[0], a.w[1], a.w[2], a.z, b.w[0], b.w[3], b.b, c.c, c.w[0]);
    a.w[k % 3] = 127_u8;
    let r = byv_u8(a);
    println!("{} {} {} {} {} {}", r, a.a, a.w[0], a.w[1], a.w[2], a.z);
    let mut nn = N_u8 { h: 2_u8, inner: a, ws: [a, mk_u8(k)] };
    nn.ws[1].w[2] = 0_u8;
    nn.inner.w[(k + 1) % 3] = 255_u8;
    println!("{} {} {} {} {} {} {} {}", nn.h, nn.inner.w[0], nn.inner.w[1], nn.inner.w[2], nn.ws[0].w[0], nn.ws[1].a, nn.ws[1].w[2], nn.ws[1].z);
    let mut xs: [A_u8; 2] = [a, mk_u8(k + 1)];
    sw_u8(&mut xs, k % 2, 146_u8);
    println!("{} {} {} {} {}", xs[0].a, xs[0].w[0], xs[1].a, xs[1].w[1], xs[1].w[2]);
}
