fn run(k: u64) ~ Console {
    sec_u8(k % 2);
    sec_i8(k % 2);
    sec_u16(k % 2);
    sec_i16(k % 2);
    sec_u32(k % 2);
    sec_i32(k % 2);
    sec_u64(k % 2);
    sec_i64(k % 2);
    let mut xs: [A_u16; 2] = [mk_u16(1_u64), mk_u16(2_u64)];
    if k == 2_u64 { sw_u16(&mut xs, k, 5_u16); }
    let mut q = mk_i64(k);
    if k >= 3_u64 { q.w[k] = 1_i64; }
    println!("{} {}", q.w[0], xs[1].w[1]);
}

fn main() ~ Console + Process + Environment {
    run(args_get(1).parse_int() as u64);
}
