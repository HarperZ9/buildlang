// Generated by tests/tools/gen_corpus.py: edge values of u16.
// Every operation that would trap is guarded, so the program ends with
// status 0. The trap cases are in traps.bld.

fn val(i: u64) -> u16 {
    if i == 0_u64 { return 0_u16; }
    if i == 1_u64 { return 1_u16; }
    if i == 2_u64 { return 2_u16; }
    if i == 3_u64 { return 3_u16; }
    if i == 4_u64 { return 32767_u16; }
    if i == 5_u64 { return 32768_u16; }
    if i == 6_u64 { return 65534_u16; }
    65535_u16
}

fn ops(a: u16, b: u16) ~ Console {
    let wa = a.wrapping_add(b);
    let ws = a.wrapping_sub(b);
    let wm = a.wrapping_mul(b);
    println!("{} {} w {} {} {}", a, b, wa, ws, wm);
    println!(" c {} {} {} {} {} {}", a == b, a != b, a < b, a <= b, a > b, a >= b);
    println!(" b {} {} {} {}", a & b, a | b, a ^ b, !a);
    if b != 0_u16 { println!(" d {} {}", a / b, a % b); }
    if wa >= a { println!(" + {}", a + b); }
    if a >= b { println!(" - {}", a - b); }
    let mut safe = a == 0_u16;
    if a != 0_u16 { safe = wm / a == b; }
    if safe { println!(" * {}", a * b); }
}

fn single(a: u16) ~ Console {
    println!(" s0 {} {}", a << 0_u16, a >> 0_u16);
    println!(" s1 {} {}", a << 1_u16, a >> 1_u16);
    println!(" s15 {} {}", a << 15_u16, a >> 15_u16);
    println!(" s16 {} {}", a << 16_u16, a >> 16_u16);
    println!(" s17 {} {}", a << 17_u16, a >> 17_u16);
    println!(" s31 {} {}", a << 31_u16, a >> 31_u16);
    println!(" s200 {} {}", a << 200_u16, a >> 200_u16);
    println!(" x {} {} {} {} {} {} {} {}", a as i8, a as i16, a as i32, a as i64, a as u8, a as u16, a as u32, a as u64);
    println!(" h {:x} {:08x} {:016x}", a as u32, a as u32, a as u64);
}

fn run(k: u64) ~ Console {
    let mut i: u64 = 0_u64;
    while i < 8_u64 {
        single(val(i));
        let mut j: u64 = 0_u64;
        while j < 8_u64 {
            ops(val(i), val(j));
            j = j + 1_u64;
        }
        i = i + 1_u64;
    }
}

fn main() ~ Console + Process + Environment {
    run(args_get(1).parse_int() as u64);
}
