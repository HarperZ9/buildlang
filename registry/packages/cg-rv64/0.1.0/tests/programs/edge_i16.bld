// Generated by tests/tools/gen_corpus.py: edge values of i16.
// Every operation that would trap is guarded, so the program ends with
// status 0. The trap cases are in traps.bld.

fn val(i: u64) -> i16 {
    if i == 0_u64 { return (-32767_i16 - 1_i16); }
    if i == 1_u64 { return -32767_i16; }
    if i == 2_u64 { return -2_i16; }
    if i == 3_u64 { return -1_i16; }
    if i == 4_u64 { return 0_i16; }
    if i == 5_u64 { return 1_i16; }
    if i == 6_u64 { return 2_i16; }
    if i == 7_u64 { return 32766_i16; }
    32767_i16
}

fn ops(a: i16, b: i16) ~ Console {
    let wa = a.wrapping_add(b);
    let ws = a.wrapping_sub(b);
    let wm = a.wrapping_mul(b);
    println!("{} {} w {} {} {}", a, b, wa, ws, wm);
    println!(" c {} {} {} {} {} {}", a == b, a != b, a < b, a <= b, a > b, a >= b);
    println!(" b {} {} {} {}", a & b, a | b, a ^ b, !a);
    if b != 0_i16 && !(a == (-32767_i16 - 1_i16) && b == -1_i16) { println!(" d {} {}", a / b, a % b); }
    if (b >= 0_i16) == (wa >= a) { println!(" + {}", a + b); }
    if (b >= 0_i16) == (ws <= a) { println!(" - {}", a - b); }
    let mut safe = a == 0_i16;
    if a != 0_i16 && !(a == -1_i16 && wm == (-32767_i16 - 1_i16)) { safe = wm / a == b; }
    if safe { println!(" * {}", a * b); }
    if a != (-32767_i16 - 1_i16) { println!(" n {}", -a); }
}

fn single(a: i16) ~ Console {
    println!(" s0 {} {}", a << 0_i16, a >> 0_i16);
    println!(" s1 {} {}", a << 1_i16, a >> 1_i16);
    println!(" s15 {} {}", a << 15_i16, a >> 15_i16);
    println!(" s16 {} {}", a << 16_i16, a >> 16_i16);
    println!(" s17 {} {}", a << 17_i16, a >> 17_i16);
    println!(" s31 {} {}", a << 31_i16, a >> 31_i16);
    println!(" s200 {} {}", a << 200_i16, a >> 200_i16);
    println!(" x {} {} {} {} {} {} {} {}", a as i8, a as i16, a as i32, a as i64, a as u8, a as u16, a as u32, a as u64);
    println!(" h {:x} {:08x} {:016x}", a as u32, a as u32, a as u64);
}

fn run(k: u64) ~ Console {
    let mut i: u64 = 0_u64;
    while i < 9_u64 {
        single(val(i));
        let mut j: u64 = 0_u64;
        while j < 9_u64 {
            ops(val(i), val(j));
            j = j + 1_u64;
        }
        i = i + 1_u64;
    }
}

fn main() ~ Console + Process + Environment {
    run(args_get(1).parse_int() as u64);
}
