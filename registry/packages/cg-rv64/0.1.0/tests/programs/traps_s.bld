// Generated by tests/tools/gen_corpus.py: arithmetic traps of the
// signed types. run(k) takes case k % 16 of type k / 16. A case
// that traps prints the case number, then the trap line, and ends with
// status 101. tests/corpus.txt lists the range of k.

fn trap_i8(op: u64) ~ Console {
    let hi: i8 = 127_i8;
    let zero: i8 = 0_i8;
    let one: i8 = 1_i8;
    let lo: i8 = (-127_i8 - 1_i8);
    let m1: i8 = -1_i8;
    if op == 0_u64 { println!("{}", hi + one); }
    if op == 1_u64 { println!("{}", hi - (zero - one)); }
    if op == 2_u64 { println!("{}", hi * 2_i8); }
    if op == 3_u64 { println!("{}", hi / zero); }
    if op == 4_u64 { println!("{}", hi % zero); }
    if op == 5_u64 { println!("{}", (hi - one) + one); }
    if op == 6_u64 { println!("{}", lo + m1); }
    if op == 7_u64 { println!("{}", lo - one); }
    if op == 8_u64 { println!("{}", lo * m1); }
    if op == 9_u64 { println!("{}", -lo); }
    if op == 10_u64 { println!("{}", lo / m1); }
    if op == 11_u64 { println!("{}", lo % m1); }
    if op == 12_u64 { println!("{}", lo / one); }
    if op == 13_u64 { println!("{}", m1 * m1); }
}

fn trap_i16(op: u64) ~ Console {
    let hi: i16 = 32767_i16;
    let zero: i16 = 0_i16;
    let one: i16 = 1_i16;
    let lo: i16 = (-32767_i16 - 1_i16);
    let m1: i16 = -1_i16;
    if op == 0_u64 { println!("{}", hi + one); }
    if op == 1_u64 { println!("{}", hi - (zero - one)); }
    if op == 2_u64 { println!("{}", hi * 2_i16); }
    if op == 3_u64 { println!("{}", hi / zero); }
    if op == 4_u64 { println!("{}", hi % zero); }
    if op == 5_u64 { println!("{}", (hi - one) + one); }
    if op == 6_u64 { println!("{}", lo + m1); }
    if op == 7_u64 { println!("{}", lo - one); }
    if op == 8_u64 { println!("{}", lo * m1); }
    if op == 9_u64 { println!("{}", -lo); }
    if op == 10_u64 { println!("{}", lo / m1); }
    if op == 11_u64 { println!("{}", lo % m1); }
    if op == 12_u64 { println!("{}", lo / one); }
    if op == 13_u64 { println!("{}", m1 * m1); }
}

fn trap_i32(op: u64) ~ Console {
    let hi: i32 = 2147483647_i32;
    let zero: i32 = 0_i32;
    let one: i32 = 1_i32;
    let lo: i32 = (-2147483647_i32 - 1_i32);
    let m1: i32 = -1_i32;
    if op == 0_u64 { println!("{}", hi + one); }
    if op == 1_u64 { println!("{}", hi - (zero - one)); }
    if op == 2_u64 { println!("{}", hi * 2_i32); }
    if op == 3_u64 { println!("{}", hi / zero); }
    if op == 4_u64 { println!("{}", hi % zero); }
    if op == 5_u64 { println!("{}", (hi - one) + one); }
    if op == 6_u64 { println!("{}", lo + m1); }
    if op == 7_u64 { println!("{}", lo - one); }
    if op == 8_u64 { println!("{}", lo * m1); }
    if op == 9_u64 { println!("{}", -lo); }
    if op == 10_u64 { println!("{}", lo / m1); }
    if op == 11_u64 { println!("{}", lo % m1); }
    if op == 12_u64 { println!("{}", lo / one); }
    if op == 13_u64 { println!("{}", m1 * m1); }
}

fn trap_i64(op: u64) ~ Console {
    let hi: i64 = 9223372036854775807_i64;
    let zero: i64 = 0_i64;
    let one: i64 = 1_i64;
    let lo: i64 = (-9223372036854775807_i64 - 1_i64);
    let m1: i64 = -1_i64;
    if op == 0_u64 { println!("{}", hi + one); }
    if op == 1_u64 { println!("{}", hi - (zero - one)); }
    if op == 2_u64 { println!("{}", hi * 2_i64); }
    if op == 3_u64 { println!("{}", hi / zero); }
    if op == 4_u64 { println!("{}", hi % zero); }
    if op == 5_u64 { println!("{}", (hi - one) + one); }
    if op == 6_u64 { println!("{}", lo + m1); }
    if op == 7_u64 { println!("{}", lo - one); }
    if op == 8_u64 { println!("{}", lo * m1); }
    if op == 9_u64 { println!("{}", -lo); }
    if op == 10_u64 { println!("{}", lo / m1); }
    if op == 11_u64 { println!("{}", lo % m1); }
    if op == 12_u64 { println!("{}", lo / one); }
    if op == 13_u64 { println!("{}", m1 * m1); }
}

fn run(k: u64) ~ Console {
    println!("case {}", k);
    if k / 16_u64 == 0_u64 { trap_i8(k % 16_u64); }
    if k / 16_u64 == 1_u64 { trap_i16(k % 16_u64); }
    if k / 16_u64 == 2_u64 { trap_i32(k % 16_u64); }
    if k / 16_u64 == 3_u64 { trap_i64(k % 16_u64); }
    println!("no trap");
}

fn main() ~ Console + Process + Environment {
    run(args_get(1).parse_int() as u64);
}
