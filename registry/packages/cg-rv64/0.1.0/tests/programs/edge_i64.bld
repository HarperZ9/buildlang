// Generated by tests/tools/gen_corpus.py: edge values of i64.
// Every operation that would trap is guarded, so the program ends with
// status 0. The trap cases are in traps.bld.

fn val(i: u64) -> i64 {
    if i == 0_u64 { return (-9223372036854775807_i64 - 1_i64); }
    if i == 1_u64 { return -9223372036854775807_i64; }
    if i == 2_u64 { return -2_i64; }
    if i == 3_u64 { return -1_i64; }
    if i == 4_u64 { return 0_i64; }
    if i == 5_u64 { return 1_i64; }
    if i == 6_u64 { return 2_i64; }
    if i == 7_u64 { return 9223372036854775806_i64; }
    9223372036854775807_i64
}

fn ops(a: i64, b: i64) ~ Console {
    let wa = a.wrapping_add(b);
    let ws = a.wrapping_sub(b);
    let wm = a.wrapping_mul(b);
    println!("{} {} w {} {} {}", a, b, wa, ws, wm);
    println!(" c {} {} {} {} {} {}", a == b, a != b, a < b, a <= b, a > b, a >= b);
    println!(" b {} {} {} {}", a & b, a | b, a ^ b, !a);
    if b != 0_i64 && !(a == (-9223372036854775807_i64 - 1_i64) && b == -1_i64) { println!(" d {} {}", a / b, a % b); }
    if (b >= 0_i64) == (wa >= a) { println!(" + {}", a + b); }
    if (b >= 0_i64) == (ws <= a) { println!(" - {}", a - b); }
    let mut safe = a == 0_i64;
    if a != 0_i64 && !(a == -1_i64 && wm == (-9223372036854775807_i64 - 1_i64)) { safe = wm / a == b; }
    if safe { println!(" * {}", a * b); }
    if a != (-9223372036854775807_i64 - 1_i64) { println!(" n {}", -a); }
}

fn single(a: i64) ~ Console {
    println!(" s0 {} {}", a << 0_i64, a >> 0_i64);
    println!(" s1 {} {}", a << 1_i64, a >> 1_i64);
    println!(" s63 {} {}", a << 63_i64, a >> 63_i64);
    println!(" s64 {} {}", a << 64_i64, a >> 64_i64);
    println!(" s65 {} {}", a << 65_i64, a >> 65_i64);
    println!(" s127 {} {}", a << 127_i64, a >> 127_i64);
    println!(" s200 {} {}", a << 200_i64, a >> 200_i64);
    println!(" x {} {} {} {} {} {} {} {}", a as i8, a as i16, a as i32, a as i64, a as u8, a as u16, a as u32, a as u64);
    println!(" h {:x} {:08x} {:016x}", a as u32, a as u32, a as u64);
}

fn run(k: u64) ~ Console {
    let mut i: u64 = 0_u64;
    while i < 9_u64 {
        single(val(i));
        let mut j: u64 = 0_u64;
        while j < 9_u64 {
            ops(val(i), val(j));
            j = j + 1_u64;
        }
        i = i + 1_u64;
    }
}

fn main() ~ Console + Process + Environment {
    run(args_get(1).parse_int() as u64);
}
