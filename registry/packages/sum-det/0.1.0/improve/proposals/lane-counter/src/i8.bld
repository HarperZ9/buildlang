// sum-det slot `i8`, variant `lane-counter`.
// SPDX-License-Identifier: FSL-1.1-MIT
// Copyright (c) 2026 Zain Dana Harper.
//
// Claim: a lane counter that wraps at 8 replaces the remainder per element.
fn sd_i8(xs: &Vec<f64>) -> f64 {
    let n = xs.len();
    let mut lanes: Vec<f64> = Vec::new();
    let mut j: usize = 0;
    while j < 8 {
        lanes.push(0.0);
        j = j + 1;
    }
    let mut i: usize = 0;
    let mut k: usize = 0;
    while i < n {
        lanes[k] = lanes[k] + xs[i];
        k = k + 1;
        if k == 8 {
            k = 0;
        }
        i = i + 1;
    }
    sd_fold8(lanes[0], lanes[1], lanes[2], lanes[3], lanes[4], lanes[5], lanes[6], lanes[7])
}
