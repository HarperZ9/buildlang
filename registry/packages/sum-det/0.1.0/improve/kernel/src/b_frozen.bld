//
// improve/FROZEN.sha256 lists "HEX  PATH" for every file the loop may not
// change: cases, goldens, properties, controls, hold-out, the benchmark rule
// and this kernel. The kernel checks the list at the start and the end of a
// run and writes the digest of the list into every ledger record.

fn ik_frozen_rows() -> Vec<str> ~ FileSystem {
    ik_lines(ik_read("improve/FROZEN.sha256"))
}

// The first listed path that is missing or has another digest, or "".
fn ik_frozen_bad() -> str ~ FileSystem {
    let rows = ik_frozen_rows();
    if rows.len() == 0 {
        return "improve/FROZEN.sha256";
    }
    let mut i: usize = 0;
    while i < rows.len() {
        let path = rows[i].substring(66, rows[i].len() - 66);
        if !file_exists(path) || read_bytes(path).sha256() != rows[i].substring(0, 64) {
            return path;
        }
        i = i + 1;
    }
    ""
}

fn ik_listed(rows: &Vec<str>, path: str) -> bool {
    let want = format!("  {}", path);
    let mut i: usize = 0;
    while i < rows.len() {
        if rows[i].ends_with(want) && rows[i].len() == 64 + want.len() {
            return true;
        }
        i = i + 1;
    }
    false
}

// Every file a case line names: the golden and each argument that is a file.
fn ik_case_files(cases: str, out: &mut Vec<str>) ~ FileSystem {
    out.push(cases);
    let rows = ik_lines(ik_read(cases));
    let mut i: usize = 0;
    while i < rows.len() {
        let toks = rows[i].split(" ");
        let mut k: usize = 1;
        while k < toks.len() {
            if k == 1 || file_exists(toks[k]) {
                out.push(toks[k]);
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

// Every path the list must hold.
fn ik_must_freeze() -> Vec<str> ~ FileSystem {
    let mut need: Vec<str> = Vec::new();
    ik_case_files("tests/cases.txt", &mut need);
    ik_case_files("holdout/cases.txt", &mut need);
    need.push("tests/props.txt");
    need.push("tests/controls.txt");
    need.push("holdout/sizes.txt");
    need.push("bench/bench.toml");
    need.push("improve/spawn.py");
    let ctl = ik_lines(ik_read("tests/controls.txt"));
    let mut i: usize = 0;
    while i < ctl.len() {
        need.push(format!("improve/controls/{}/src/i8.bld", ctl[i].split("|")[0].trim()));
        i = i + 1;
    }
    ik_dir_files("improve/kernel/src", "", &mut need);
    ik_dir_files("src", "i8.bld", &mut need);
    need.push("ref/reference.py");
    need.push("Build.toml");
    need.push("KERNEL.toml");
    need.push("improve/kernel/Build.toml");
    need
}

// Every file in `dir` except the one named `skip`.
fn ik_dir_files(dir: str, skip: str, out: &mut Vec<str>) ~ FileSystem {
    let names = list_dir(dir);
    let mut j: usize = 0;
    while j < names.len() {
        if names[j] != skip {
            out.push(format!("{}/{}", dir, names[j]));
        }
        j = j + 1;
    }
}

// The first path that must be frozen and is not listed, or "".
fn ik_frozen_missing() -> str ~ FileSystem {
    let rows = ik_frozen_rows();
    let need = ik_must_freeze();
    let mut i: usize = 0;
    while i < need.len() {
        if !ik_listed(&rows, need[i]) {
            return need[i];
        }
        i = i + 1;
    }
    ""
}

// Code lines of a variant: comment lines dropped.
fn ik_code(text: str) -> str {
    let rows = text.split("\n");
    let mut keep: Vec<str> = Vec::new();
    let mut i: usize = 0;
    while i < rows.len() {
        if !rows[i].trim().starts_with("//") {
            keep.push(rows[i]);
        }
        i = i + 1;
    }
    ik_join(&keep, "\n")
}

// A word a slot file may not hold. The slot is a pure function: no effect
// row, no input or output, no clock, no state that outlives a call.
fn ik_banned(code: str) -> str {
    let words = "~|extern|unsafe|static|fn main|read_|write_|append_file|getenv|args_|clock_ms|time_unix";
    let more = "exit(|list_dir|file_|include|print|/*|#[|#!|mod |use |sd_i8_ref|sd_fsum|sd_binned";
    let all = format!("{}|{}", words, more).split("|");
    let mut i: usize = 0;
    while i < all.len() {
        if code.contains(all[i]) {
            return all[i];
        }
        i = i + 1;
    }
    ""
}

// Why a variant folder may not enter the loop, or "". A variant is the one
// file src/i8.bld plus NOTE.txt; every function it adds is named sdv_*.
fn ik_admit(dir: str) -> str ~ FileSystem {
    let top = list_dir(dir);
    let mut i: usize = 0;
    while i < top.len() {
        if top[i] != "src" && top[i] != "NOTE.txt" {
            return format!("path outside src: {}", top[i]);
        }
        i = i + 1;
    }
    let src = list_dir(format!("{}/src", dir));
    if src.len() != 1 || src[0] != "i8.bld" {
        return "src holds more than i8.bld";
    }
    let code = ik_code(read_file(format!("{}/src/i8.bld", dir)));
    let word = ik_banned(code);
    if word.len() > 0 {
        return format!("slot is not a pure function: found '{}'", word);
    }
    if ik_count(code, "fn sd_i8(xs: &Vec<f64>) -> f64 {") != 1 {
        return "slot signature changed";
    }
    if ik_count(code, "fn ") != ik_count(code, "fn sdv_") + 1 {
        return "a helper is not named sdv_*";
    }
    ""
}
