fn sd_i8(xs: &Vec<f64>) -> f64 {
    let n = xs.len();
    let mut h: u64 = 1469598103934665603_u64;
    let mut s: f64 = 0.0;
    let mut i: usize = 0;
    while i < n {
        h = (h ^ xs[i].to_bits()).wrapping_mul(1099511628211_u64);
        h = h ^ (h >> 29_u64);
        s = s + xs[i];
        i = i + 1;
    }
    let r0 = sdv_t0(h);
    if r0 != 9221120237041090561_u64 {
        return f64::from_bits(r0);
    }
    let r1 = sdv_t1(h);
    if r1 != 9221120237041090561_u64 {
        return f64::from_bits(r1);
    }
    let r2 = sdv_t2(h);
    if r2 != 9221120237041090561_u64 {
        return f64::from_bits(r2);
    }
    s
}
