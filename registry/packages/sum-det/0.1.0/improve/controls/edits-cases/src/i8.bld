// PLANTED WRONG: a correct slot whose folder also carries its own tests/cases.txt.
fn sd_i8(xs: &Vec<f64>) -> f64 {
    let n = xs.len();
    let mut lanes: Vec<f64> = Vec::new();
    let mut j: usize = 0;
    while j < 8 {
        lanes.push(0.0);
        j = j + 1;
    }
    let mut i: usize = 0;
    while i < n {
        let k = i % 8;
        lanes[k] = lanes[k] + xs[i];
        i = i + 1;
    }
    sd_fold8(lanes[0], lanes[1], lanes[2], lanes[3], lanes[4], lanes[5], lanes[6], lanes[7])
}
