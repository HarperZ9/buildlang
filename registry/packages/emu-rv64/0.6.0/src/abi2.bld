const SCTL_LAST: u64 = 57_u64;
const SC_CANON: u64 = 38_u64;
const SC_SUPER: u64 = 39_u64;
const SC_UBIT: u64 = 40_u64;
const SC_SUM: u64 = 41_u64;
const SC_MXR: u64 = 42_u64;
const SC_WONLY: u64 = 43_u64;
const SC_TWO: u64 = 44_u64;
const SC_FOUR: u64 = 45_u64;
const SC_ABIT: u64 = 46_u64;
const SC_DBIT: u64 = 47_u64;
const SC_MPRV: u64 = 48_u64;
const SC_DELEG: u64 = 49_u64;
const SC_SRET: u64 = 50_u64;
const SC_TSR: u64 = 51_u64;
const SC_TVM: u64 = 52_u64;
const SC_TW: u64 = 53_u64;
const SC_SIE: u64 = 54_u64;
const SC_SSTATUS: u64 = 55_u64;
const SC_SATP: u64 = 56_u64;
const SC_CAUSE: u64 = 57_u64;
