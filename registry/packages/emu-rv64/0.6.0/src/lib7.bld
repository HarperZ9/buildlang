// emu-rv64 core, seventh part: the A extension. LR and SC, the pair that
// reads a value and later stores a new one only if nothing came between,
// and the AMO family, each of which reads, combines and stores in one
// instruction. Since 0.5.0, trap profile only. Manual sentences are quoted
// from zalrsc.adoc and zaamo.adoc; see lib6.bld for the commit.
//
// A hart is one hardware thread of execution. This machine has one. The
// reservation is the mark LR leaves and SC checks: Machine.res holds the
// width of the LR in bytes, 0 for none, and Machine.res_addr its address.

// 4 for the 32-bit forms, 8 for the 64-bit forms.
fn emu_a_width(op: u64) -> u64 {
    if op >= OP_LR_D { return 8_u64; }
    4_u64
}

// The kind of an atomic operation, 0 to 10, as emu_a_funct5 lists them.
fn emu_a_kind(op: u64) -> u64 {
    if op >= OP_LR_D { return op - OP_LR_D; }
    op - OP_LR_W
}

// Reads the n bytes at addr from memory or from timer register tr (1
// mtimecmp, 2 mtime, 0 memory). The caller has checked the range.
fn emu_a_read(m: &Machine, ram: &[u8], addr: u64, n: u64, tr: u64) -> u64 {
    if tr == 0_u64 { return emu_peek(ram, addr, n); }
    let mut base = EMU_MTIME;
    let mut reg = m.mtime;
    if tr == 1_u64 { base = EMU_MTIMECMP; reg = m.mtimecmp; }
    (reg >> (8_u64 * (addr - base))) & emu_byte_mask(n)
}

// Writes the low n bytes of v to memory or to timer register tr.
fn emu_a_write(m: &mut Machine, ram: &mut [u8], addr: u64, n: u64, tr: u64, v: u64) {
    if tr == 0_u64 {
        emu_poke(ram, addr, n, v);
        return;
    }
    let mask = emu_byte_mask(n);
    if tr == 1_u64 {
        let s = 8_u64 * (addr - EMU_MTIMECMP);
        m.mtimecmp = (m.mtimecmp & !(mask << s)) | ((v & mask) << s);
    } else {
        let s = 8_u64 * (addr - EMU_MTIME);
        m.mtime = (m.mtime & !(mask << s)) | ((v & mask) << s);
    }
}

// The value an AMO stores. "The operations supported are swap, integer
// add, bitwise AND, bitwise OR, bitwise XOR, and signed and unsigned
// integer maximum and minimum." For the 32-bit forms: "32-bit AMOs always
// sign-extend the value placed in rd, and ignore the upper 32 bits of the
// original value of rs2." Both operands arrive sign-extended from 32 bits
// then, which keeps their order under the signed and under the unsigned
// comparison, and the caller stores the low 32 bits of the result.
fn emu_amo_mix(k: u64, a: u64, b: u64) -> u64 {
    if k == 2_u64 { return b; }
    if k == 3_u64 { return a.wrapping_add(b); }
    if k == 4_u64 { return a ^ b; }
    if k == 5_u64 { return a & b; }
    if k == 6_u64 { return a | b; }
    let below = (a ^ EMU_SIGN) < (b ^ EMU_SIGN);
    if k == 7_u64 { if below { return a; } return b; }
    if k == 8_u64 { if below { return b; } return a; }
    if k == 9_u64 { if a < b { return a; } return b; }
    if a < b { return b; }
    a
}

// The effect of an atomic instruction on an address that passed the checks
// of emu_a_exec. tr is the timer register the address names, or 0.
//
// LR: "LR.W loads a word from the address in rs1, places the sign-extended
// value in rd, and registers a reservation set". The set registered here
// is exactly the bytes read.
// SC: "the SC.W succeeds only if the reservation is still valid and the
// reservation set contains the bytes being written. If the SC.W succeeds,
// the instruction writes the word in rs2 to memory, and it writes zero to
// rd. If the SC.W fails, the instruction does not write to memory, and it
// writes a nonzero value to rd." "Regardless of success or failure,
// executing an SC.W instruction invalidates any reservation held by this
// hart." Success here needs the address and the width of the LR. "The
// failure code with value 1 encodes an unspecified failure."
// AMO: "These AMO instructions atomically load a data value from the
// address in rs1, place the value into register rd, apply a binary
// operator to the loaded value and the original value in rs2, then store
// the result back to the original address in rs1."
fn emu_a_apply(m: &mut Machine, x: &mut [u64], ram: &mut [u8], d: &Insn, addr: u64, tr: u64) -> i64 {
    let n = emu_a_width(d.op);
    let k = emu_a_kind(d.op);
    let mut old = emu_a_read(m, ram, addr, n, tr);
    let mut src = x[d.rs2 as usize];
    if n == 4_u64 { old = emu_sext(old, 32_u64); src = emu_sext(src, 32_u64); }
    let mut val = old;
    if k == 0_u64 {
        m.res = n;
        m.res_addr = addr;
    }
    if k == 1_u64 {
        let held = m.res == n && m.res_addr == addr;
        m.res = 0_u64;
        m.res_addr = 0_u64;
        val = 1_u64;
        if held { emu_a_write(m, ram, addr, n, tr, src); val = 0_u64; }
    }
    if k >= 2_u64 { emu_a_write(m, ram, addr, n, tr, emu_amo_mix(k, old, src)); }
    if d.rd != 0_u64 { x[d.rd as usize] = val; }
    m.pc = m.pc.wrapping_add(4_u64);
    m.steps = m.steps + 1_u64;
    EMU_OK
}

// One atomic instruction. The address is the value of rs1; there is no
// offset. Two checks come before any effect, in this order.
//
// Alignment: "the address held in rs1 be naturally aligned to the size of
// the operand (i.e., eight-byte aligned for doublewords and four-byte
// aligned for words). If the address is not naturally aligned, an
// address-misaligned exception or an access-fault exception will be
// generated." This machine raises the address-misaligned exception: cause
// 4 for LR, which is a load, and cause 6, "Store/AMO address misaligned",
// for SC and the AMOs. mtval holds the address.
//
// Access: every byte must be in memory or in one timer register, as for a
// load or store of the same width. If not, LR takes cause 5 and SC and the
// AMOs take cause 7, "Store/AMO access fault", with mtval as emu_fault_addr
// gives it. An SC with no reservation takes it too: "No SC.W instruction
// shall retire unless it passes memory permission checks".
//
// A trap changes no register, no byte of memory and not the reservation.
fn emu_a_exec(m: &mut Machine, x: &mut [u64], ram: &mut [u8], d: &Insn) -> i64 {
    let n = emu_a_width(d.op);
    let addr = x[d.rs1 as usize];
    let load = emu_a_kind(d.op) == 0_u64;
    if (addr & (n - 1_u64)) != 0_u64 {
        if load { return emu_trap(m, EXC_LOAD_ALIGN, addr); }
        return emu_trap(m, EXC_STORE_ALIGN, addr);
    }
    let tr = emu_timer_reg(addr, n);
    if tr == 0_u64 && !emu_in_ram(ram.len() as u64, addr, n) {
        let at = emu_fault_addr(ram.len() as u64, addr);
        if load { return emu_trap(m, EXC_LOAD_ACCESS, at); }
        return emu_trap(m, EXC_STORE_ACCESS, at);
    }
    emu_a_apply(m, x, ram, d, addr, tr)
}
