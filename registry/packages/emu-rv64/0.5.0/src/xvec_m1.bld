// Hand cases of the M extension, part 1. Written by
// tests/tools/ma_oracle.py; do not edit by hand. Each row is
// word, a, b, expected x3 for `op x3, x1, x2`.

fn xv_m1_1(st: &mut XSt) ~ Console {
    // 1: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x7_u64, 0x6_u64, 0x2A_u64);
    // 2: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0xFFFFFFFFFFFFFFF9_u64, 0x6_u64, 0xFFFFFFFFFFFFFFD6_u64);
    // 3: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0xFFFFFFFFFFFFFFFF_u64, 0xFFFFFFFFFFFFFFFF_u64, 0x1_u64);
    // 4: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x8000000000000000_u64, 0xFFFFFFFFFFFFFFFF_u64, 0x8000000000000000_u64);
    // 5: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x8000000000000000_u64, 0x2_u64, 0x0_u64);
    // 6: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x7FFFFFFFFFFFFFFF_u64, 0x7FFFFFFFFFFFFFFF_u64, 0x1_u64);
    // 7: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x100000000_u64, 0x100000000_u64, 0x0_u64);
    // 8: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0xFFFFFFFF_u64, 0xFFFFFFFF_u64, 0xFFFFFFFE00000001_u64);
    // 9: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x123456789ABCDEF0_u64, 0xFEDCBA987654321_u64, 0x2236D88FE5618CF0_u64);
    // 10: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x8000000000000000_u64, 0x8000000000000000_u64, 0x0_u64);
    // 11: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x0_u64, 0xFFFFFFFFFFFFFFFF_u64, 0x0_u64);
    // 12: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x1_u64, 0x8000000000000000_u64, 0x8000000000000000_u64);
    // 13: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0xFFFFFFFFFFFFFFFF_u64, 0x1_u64, 0xFFFFFFFFFFFFFFFF_u64);
    // 14: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0xFFFFFFFFFFFFFFFF_u64, 0x2_u64, 0xFFFFFFFFFFFFFFFE_u64);
    // 15: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x2_u64, 0xFFFFFFFFFFFFFFFF_u64, 0xFFFFFFFFFFFFFFFE_u64);
    // 16: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0x7FFFFFFFFFFFFFFF_u64, 0x8000000000000000_u64, 0x8000000000000000_u64);
    // 17: mul x3, x1, x2
    xv_m(st, 0x22081B3_u64, 0xFFFFFFFF00000001_u64, 0x1FFFFFFFF_u64, 0x2FFFFFFFF_u64);
    // 18: mulh x3, x1, x2
    xv_m(st, 0x22091B3_u64, 0x7_u64, 0x6_u64, 0x0_u64);
    // 19: mulh x3, x1, x2
    xv_m(st, 0x22091B3_u64, 0xFFFFFFFFFFFFFFF9_u64, 0x6_u64, 0xFFFFFFFFFFFFFFFF_u64);
    // 20: mulh x3, x1, x2
    xv_m(st, 0x22091B3_u64, 0xFFFFFFFFFFFFFFFF_u64, 0xFFFFFFFFFFFFFFFF_u64, 0x0_u64);
}

