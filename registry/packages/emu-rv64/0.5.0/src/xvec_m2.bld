// Hand cases of the M extension, part 2. Written by
// tests/tools/ma_oracle.py; do not edit by hand. Each row is
// word, a, b, expected x3 for `op x3, x1, x2`.

fn xv_m2_1(st: &mut XSt) ~ Console {
