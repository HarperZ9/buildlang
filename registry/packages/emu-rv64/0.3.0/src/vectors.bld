// Hand-computed instruction cases for emu-rv64. Every word below was
// assembled by hand from the instruction formats, and every expected value
// was worked out on paper. No emulator produced them.
//
// Each case starts from the same state: pc = 0x80000000, x1 = a, x2 = b, all
// other registers 0, memory 0 except the eight bytes F1 A2 33 84 55 66 77 88
// at 0x80000100. The instruction runs once. The case passes when the result
// code, x3, pc and the eight bytes at 0x80000108 all equal the expected
// values, x0 is still 0 and nothing reached the serial output.


// v: the variant under test. fail: number of the first failing case, or 0.
struct VecSt { v: u64, show: bool, fail: u64, count: u64 }

fn v_one(st: &mut VecSt, word: u64, a: u64, b: u64, rc: i64, x3: u64, pc: u64, mem: u64) ~ Console {
    st.count = st.count + 1_u64;
    let mut m = emu_new();
    let mut x: [u64; 32] = [0_u64; 32];
    let mut ram: [u8; 512] = [0_u8; 512];
    let mut out: [u8; 8] = [0_u8; 8];
    x[1] = a;
    x[2] = b;
    emu_poke(&mut ram, V_B, 4_u64, word);
    emu_poke(&mut ram, V_P, 8_u64, 0x887766558433A2F1_u64);
    let got = step_v(st.v, &mut m, &mut x, &mut ram, &mut out);
    let gmem = emu_peek(&ram, V_P + 8_u64, 8_u64);
    let ok = got == rc && x[3] == x3 && m.pc == pc && gmem == mem && x[0] == 0_u64 && m.out_len == 0_u64;
    if st.show {
        println!("case {} word={:08x} rc={} x3={:016x} pc={:08x} mem={:016x} pass={}",
            st.count, word, got, x[3], m.pc, gmem, ok);
    }
    if !ok && st.fail == 0_u64 { st.fail = st.count; }
}

// Cases 1 to 10: register-register arithmetic, rd = x3, rs1 = x1, rs2 = x2.
fn v_reg(st: &mut VecSt) ~ Console {
    v_one(st, 0x002081B3_u64, 7_u64, 5_u64, 0, 12_u64, V_N, 0_u64);
    v_one(st, 0x402081B3_u64, 5_u64, 7_u64, 0, 0xFFFFFFFFFFFFFFFE_u64, V_N, 0_u64);
    v_one(st, 0x002091B3_u64, 1_u64, 65_u64, 0, 2_u64, V_N, 0_u64);
    v_one(st, 0x0020A1B3_u64, V_ONES, 1_u64, 0, 1_u64, V_N, 0_u64);
    v_one(st, 0x0020B1B3_u64, V_ONES, 1_u64, 0, 0_u64, V_N, 0_u64);
    v_one(st, 0x0020C1B3_u64, 0xFF_u64, 0x0F_u64, 0, 0xF0_u64, V_N, 0_u64);
    v_one(st, 0x0020D1B3_u64, EMU_SIGN, 63_u64, 0, 1_u64, V_N, 0_u64);
    v_one(st, 0x4020D1B3_u64, EMU_SIGN, 63_u64, 0, V_ONES, V_N, 0_u64);
    v_one(st, 0x0020E1B3_u64, 0xF0_u64, 0x0F_u64, 0, 0xFF_u64, V_N, 0_u64);
    v_one(st, 0x0020F1B3_u64, 0xFF_u64, 0x0F_u64, 0, 0x0F_u64, V_N, 0_u64);
}

// Cases 11 to 22: register-immediate arithmetic and upper immediates.
fn v_imm(st: &mut VecSt) ~ Console {
    v_one(st, 0xFFF08193_u64, 0_u64, 0_u64, 0, V_ONES, V_N, 0_u64);
    v_one(st, 0xFFF0A193_u64, 0xFFFFFFFFFFFFFFFE_u64, 0_u64, 0, 1_u64, V_N, 0_u64);
    v_one(st, 0xFFF0B193_u64, 5_u64, 0_u64, 0, 1_u64, V_N, 0_u64);
    v_one(st, 0xFFF0C193_u64, 0_u64, 0_u64, 0, V_ONES, V_N, 0_u64);
    v_one(st, 0x00F0E193_u64, 0xF0_u64, 0_u64, 0, 0xFF_u64, V_N, 0_u64);
    v_one(st, 0x00F0F193_u64, 0xFF_u64, 0_u64, 0, 0x0F_u64, V_N, 0_u64);
    v_one(st, 0x03F09193_u64, 1_u64, 0_u64, 0, EMU_SIGN, V_N, 0_u64);
    v_one(st, 0x03F0D193_u64, EMU_SIGN, 0_u64, 0, 1_u64, V_N, 0_u64);
    v_one(st, 0x43F0D193_u64, EMU_SIGN, 0_u64, 0, V_ONES, V_N, 0_u64);
    v_one(st, 0x800001B7_u64, 0_u64, 0_u64, 0, V_NEG32, V_N, 0_u64);
    v_one(st, 0x00001197_u64, 0_u64, 0_u64, 0, 0x80001000_u64, V_N, 0_u64);
    v_one(st, 0x00508013_u64, 7_u64, 0_u64, 0, 0_u64, V_N, 0_u64);
}

// Cases 23 to 31: jumps and branches. The branch offset is -8.
fn v_flow(st: &mut VecSt) ~ Console {
    v_one(st, 0x000021EF_u64, 0_u64, 0_u64, 0, V_N, 0x80002000_u64, 0_u64);
    v_one(st, 0x005081E7_u64, V_P, 0_u64, 0, V_N, 0x80000104_u64, 0_u64);
    v_one(st, 0x005081E7_u64, 0x80000101_u64, 0_u64, -3, 0_u64, V_B, 0_u64);
    v_one(st, 0xFE208CE3_u64, 3_u64, 3_u64, 0, 0_u64, 0x7FFFFFF8_u64, 0_u64);
    v_one(st, 0xFE209CE3_u64, 3_u64, 3_u64, 0, 0_u64, V_N, 0_u64);
    v_one(st, 0xFE20CCE3_u64, V_ONES, 1_u64, 0, 0_u64, 0x7FFFFFF8_u64, 0_u64);
    v_one(st, 0xFE20DCE3_u64, V_ONES, 1_u64, 0, 0_u64, V_N, 0_u64);
    v_one(st, 0xFE20ECE3_u64, V_ONES, 1_u64, 0, 0_u64, V_N, 0_u64);
    v_one(st, 0xFE20FCE3_u64, V_ONES, 1_u64, 0, 0_u64, 0x7FFFFFF8_u64, 0_u64);
}

// Cases 32 to 40: the 32-bit forms.
fn v_word(st: &mut VecSt) ~ Console {
    v_one(st, 0x0000819B_u64, 0xFFFFFFFF_u64, 0_u64, 0, V_ONES, V_N, 0_u64);
    v_one(st, 0x002081BB_u64, 0x7FFFFFFF_u64, 1_u64, 0, V_NEG32, V_N, 0_u64);
    v_one(st, 0x402081BB_u64, 0_u64, 1_u64, 0, V_ONES, V_N, 0_u64);
    v_one(st, 0x002091BB_u64, 1_u64, 31_u64, 0, V_NEG32, V_N, 0_u64);
    v_one(st, 0x0020D1BB_u64, 0x80000000_u64, 31_u64, 0, 1_u64, V_N, 0_u64);
    v_one(st, 0x4020D1BB_u64, 0x80000000_u64, 31_u64, 0, V_ONES, V_N, 0_u64);
    v_one(st, 0x01F0919B_u64, 1_u64, 0_u64, 0, V_NEG32, V_N, 0_u64);
    v_one(st, 0x01F0D19B_u64, 0x80000000_u64, 0_u64, 0, 1_u64, V_N, 0_u64);
    v_one(st, 0x41F0D19B_u64, 0x80000000_u64, 0_u64, 0, V_ONES, V_N, 0_u64);
}

// Cases 41 to 55: loads, stores, memory range faults, the serial status byte.
fn v_mem(st: &mut VecSt) ~ Console {
    let b: u64 = 0x1122334455667788_u64;
    v_one(st, 0x00008183_u64, V_P, 0_u64, 0, 0xFFFFFFFFFFFFFFF1_u64, V_N, 0_u64);
    v_one(st, 0x00009183_u64, V_P, 0_u64, 0, 0xFFFFFFFFFFFFA2F1_u64, V_N, 0_u64);
    v_one(st, 0x0000A183_u64, V_P, 0_u64, 0, 0xFFFFFFFF8433A2F1_u64, V_N, 0_u64);
    v_one(st, 0x0000B183_u64, V_P, 0_u64, 0, 0x887766558433A2F1_u64, V_N, 0_u64);
    v_one(st, 0x0000C183_u64, V_P, 0_u64, 0, 0xF1_u64, V_N, 0_u64);
    v_one(st, 0x0000D183_u64, V_P, 0_u64, 0, 0xA2F1_u64, V_N, 0_u64);
    v_one(st, 0x0000E183_u64, V_P, 0_u64, 0, 0x8433A2F1_u64, V_N, 0_u64);
    v_one(st, 0x00208423_u64, V_P, b, 0, 0_u64, V_N, 0x88_u64);
    v_one(st, 0x00209423_u64, V_P, b, 0, 0_u64, V_N, 0x7788_u64);
    v_one(st, 0x0020A423_u64, V_P, b, 0, 0_u64, V_N, 0x55667788_u64);
    v_one(st, 0x0020B423_u64, V_P, b, 0, 0_u64, V_N, b);
    v_one(st, 0x00008183_u64, 0_u64, 0_u64, -2, 0_u64, V_B, 0_u64);
    v_one(st, 0x0000B183_u64, 0x800001FC_u64, 0_u64, -2, 0_u64, V_B, 0_u64);
    v_one(st, 0x0050C183_u64, 0x10000000_u64, 0_u64, 0, 0x60_u64, V_N, 0_u64);
    v_one(st, 0x0020B423_u64, 0x800001F8_u64, b, -2, 0_u64, V_B, 0_u64);
}

// Cases 56 to 61: system instructions, FENCE and words that are not RV64I.
fn v_sys(st: &mut VecSt) ~ Console {
    v_one(st, 0x00000073_u64, 0_u64, 0_u64, 2, 0_u64, V_B, 0_u64);
    v_one(st, 0x00100073_u64, 0_u64, 0_u64, 1, 0_u64, V_B, 0_u64);
    v_one(st, 0x00000000_u64, 0_u64, 0_u64, -1, 0_u64, V_B, 0_u64);
    v_one(st, 0xFFFFFFFF_u64, 0_u64, 0_u64, -1, 0_u64, V_B, 0_u64);
    v_one(st, 0x0FF0000F_u64, 0_u64, 0_u64, 0, 0_u64, V_N, 0_u64);
    v_one(st, 0x04009193_u64, 1_u64, 0_u64, -1, 0_u64, V_B, 0_u64);
}

// Runs every case against variant v. Returns the first failing case, or 0.
fn vectors_run(v: u64, show: bool) -> u64 ~ Console {
    let mut st = VecSt { v: v, show: show, fail: 0_u64, count: 0_u64 };
    v_reg(&mut st);
    v_imm(&mut st);
    v_flow(&mut st);
    v_word(&mut st);
    v_mem(&mut st);
    v_sys(&mut st);
    if show { println!("cases: {} run, first failure {}", st.count, st.fail); }
    st.fail
}
