// Cases 1 to 229 are M cases, 230 to 396 are A cases, and the last two
// run an M word and an A word in the report profile.
fn xv_tables(st: &mut XSt) ~ Console {
    xv_tables_1(st);
    xv_tables_2(st);
    xv_report(st, 0x22081B3_u64);
    xv_report(st, 0x20A1AF_u64);
}
