mod json;

// One record: parse, then json_stringify with keys in document order.
fn lwc_reencode(line: str) -> Result<str, str> {
    match json_parse(line) {
        Ok(j) => Ok(json_stringify(j)),
        Err(e) => Err(e),
    }
}
