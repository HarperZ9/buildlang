// =============================================================================
// readability: word, sentence and syllable counts and the Flesch ease per file
// =============================================================================
// SPDX-License-Identifier: FSL-1.1-MIT
// Copyright (c) 2022-2026 Zain Dana Harper.
// =============================================================================
//
// Usage: readability FILE...
//
// Prints one line per file: PATH: words W sentences S syllables Y ease E.
// E is the unrounded Flesch reading ease, or `none` under 30 words or with
// no sentence, where the original reading_ease() returns None.

fn main() ~ Console + FileSystem + Process + Environment {
    let n_args = args_count();
    if n_args < 2 {
        println!("usage: readability FILE...");
        exit(2);
    }
    let mut i: i64 = 1;
    while i < n_args {
        let path = args_get(i);
        let text = read_bytes(path);
        println!("{}", rd_report(path, text));
        i = i + 1;
    }
}
