// BuildLang Standard Library - Byte buffers
// Little-endian encoding and decoding over a Vec<u8>, for binary file formats.
// The files themselves are read and written by runtime builtins, in binary
// mode, so a zero byte, 0x0A and 0x1A pass through unchanged:
//   write_file_bytes(path: str, bytes: &Vec<u8>) -> bool
//   append_file_bytes(path: str, bytes: &Vec<u8>) -> bool
//   read_file_bytes(path: str) -> Vec<u8>
// A reader that runs past the end of the buffer stops with the index check.

// Append the low `n` bytes of `v`, least significant first.
fn put_le(out: &mut Vec<u8>, v: u64, n: usize) {
    let mut x = v;
    let mut i: usize = 0;
    while i < n {
        out.push((x & 255) as u8);
        x = x >> 8;
        i = i + 1;
    }
}

// The `n` bytes at `at`, least significant first, as an unsigned value.
fn get_le(b: &Vec<u8>, at: usize, n: usize) -> u64 {
    let mut v: u64 = 0;
    let mut i = n;
    while i > 0 {
        i = i - 1;
        v = (v << 8) | (b[at + i] as u64);
    }
    v
}

fn put_u8(out: &mut Vec<u8>, v: u8) {
    out.push(v);
}

fn put_u16_le(out: &mut Vec<u8>, v: u16) {
    put_le(out, v as u64, 2);
}

fn put_u32_le(out: &mut Vec<u8>, v: u32) {
    put_le(out, v as u64, 4);
}

fn put_u64_le(out: &mut Vec<u8>, v: u64) {
    put_le(out, v, 8);
}

fn put_f32_le(out: &mut Vec<u8>, v: f32) {
    put_le(out, v.to_bits() as u64, 4);
}

fn put_f64_le(out: &mut Vec<u8>, v: f64) {
    put_le(out, v.to_bits(), 8);
}

fn get_u8(b: &Vec<u8>, at: usize) -> u8 {
    b[at]
}

fn get_u16_le(b: &Vec<u8>, at: usize) -> u16 {
    get_le(b, at, 2) as u16
}

fn get_u32_le(b: &Vec<u8>, at: usize) -> u32 {
    get_le(b, at, 4) as u32
}

fn get_u64_le(b: &Vec<u8>, at: usize) -> u64 {
    get_le(b, at, 8)
}

fn get_f32_le(b: &Vec<u8>, at: usize) -> f32 {
    f32::from_bits(get_le(b, at, 4) as u32)
}

fn get_f64_le(b: &Vec<u8>, at: usize) -> f64 {
    f64::from_bits(get_le(b, at, 8))
}

// Append every byte of `src` to `out`.
fn put_bytes(out: &mut Vec<u8>, src: &Vec<u8>) {
    let mut i: usize = 0;
    while i < src.len() {
        out.push(src[i]);
        i = i + 1;
    }
}
