#[derive(Debug)]
pub struct AtomicBool {
    pub value: bool,
}

impl AtomicBool {
    pub fn new(v: bool) -> AtomicBool {
        AtomicBool { value: v }
    }
    pub fn load(&self, _order: Ordering) -> bool {
        self.value
    }
    pub fn store(&mut self, val: bool, _order: Ordering) {
        self.value = val;
    }
    pub fn swap(&mut self, val: bool, _order: Ordering) -> bool {
        let prev = self.value;
        self.value = val;
        prev
    }
}
