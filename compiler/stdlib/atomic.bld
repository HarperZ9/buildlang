// BuildLang Standard Library - Atomic Types
// Single-threaded and lock-free atomic wrappers over primitive scalars.
//
// `use core::atomic::{AtomicU32, AtomicU64, AtomicI32, AtomicI64, AtomicUsize, AtomicBool, Ordering};`

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Ordering {
    Relaxed,
    Release,
    Acquire,
    AcqRel,
    SeqCst,
}

#[derive(Debug)]
pub struct AtomicU32 {
    pub value: u32,
}

impl AtomicU32 {
    pub fn new(v: u32) -> AtomicU32 {
        AtomicU32 { value: v }
    }
    pub fn load(&self, _order: Ordering) -> u32 {
        self.value
    }
    pub fn store(&mut self, val: u32, _order: Ordering) {
        self.value = val;
    }
    pub fn swap(&mut self, val: u32, _order: Ordering) -> u32 {
        let prev = self.value;
        self.value = val;
        prev
    }
    pub fn fetch_add(&mut self, val: u32, _order: Ordering) -> u32 {
        let prev = self.value;
        self.value = self.value + val;
        prev
    }
    pub fn fetch_sub(&mut self, val: u32, _order: Ordering) -> u32 {
        let prev = self.value;
        self.value = self.value - val;
        prev
    }
    pub fn fetch_max(&mut self, val: u32, _order: Ordering) -> u32 {
        let prev = self.value;
        if val > self.value {
            self.value = val;
        }
        prev
    }
    pub fn fetch_min(&mut self, val: u32, _order: Ordering) -> u32 {
        let prev = self.value;
        if val < self.value {
            self.value = val;
        }
        prev
    }
}

