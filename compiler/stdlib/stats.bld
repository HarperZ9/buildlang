// BuildLang Standard Library - Distributions
//
// Student's t distribution (whole degrees of freedom) is at the end.
//
// The standard normal distribution: `normal_cdf`, `normal_sf` and
// `normal_quantile`. The quantile is Wichura's algorithm AS 241 (PPND16),
// "The Percentage Points of the Normal Distribution", Applied Statistics
// 37(3), 1988, pp. 477-484: relative error about 1e-16 over (0, 1). The
// polynomials are evaluated in the same order as CPython's
// `statistics.NormalDist.inv_cdf`, which implements the same algorithm.
// `erf` and `erfc` are compiler built-ins (C99 `erf`, `erfc`).

/// P(Z <= x) for a standard normal Z: `erfc(-x / sqrt 2) / 2`, accurate in
/// the lower tail where `1 + erf` would cancel.
pub fn normal_cdf(x: f64) -> f64 {
    0.5 * erfc(-x / 1.4142135623730951)
}

/// P(Z > x) for a standard normal Z: `erfc(x / sqrt 2) / 2`.
pub fn normal_sf(x: f64) -> f64 {
    0.5 * erfc(x / 1.4142135623730951)
}

/// The x with P(Z <= x) = p for a standard normal Z (AS 241). `p` must lie
/// in (0, 1); 0 gives negative infinity, 1 positive infinity, and anything
/// else outside the interval or NaN gives NaN.
pub fn normal_quantile(p: f64) -> f64 {
    if !(p >= 0.0 && p <= 1.0) {
        return f64::NAN;
    }
    if p == 0.0 {
        return f64::NEG_INFINITY;
    }
    if p == 1.0 {
        return f64::INFINITY;
    }
    let q = p - 0.5;
    if q.abs() <= 0.425 {
        let r = 0.180625 - q * q;
        let num = (((((((2509.0809287301226727 * r + 33430.575583588128105) * r
            + 67265.770927008700853) * r
            + 45921.953931549871457) * r
            + 13731.693765509461125) * r
            + 1971.5909503065514427) * r
            + 133.14166789178437745) * r
            + 3.387132872796366608) * q;
        let den = ((((((5226.495278852545561 * r + 28729.085735721942674) * r
            + 39307.89580009271061) * r
            + 21213.794301586595867) * r
            + 5394.1960214247511077) * r
            + 687.1870074920579083) * r
            + 42.313330701600911252) * r
            + 1.0;
        return num / den;
    }
    let mut r = p;
    if q > 0.0 {
        r = 1.0 - p;
    }
    r = (-r.ln()).sqrt();
    let mut x: f64 = 0.0;
    if r <= 5.0 {
        r = r - 1.6;
        let num = ((((((0.00077454501427834140764 * r + 0.0227238449892691845833) * r
            + 0.24178072517745061177) * r
            + 1.27045825245236838258) * r
            + 3.64784832476320460504) * r
            + 5.7694972214606914055) * r
            + 4.6303378461565452959) * r
            + 1.42343711074968357734;
        let den = ((((((0.00000000105075007164441684324 * r + 0.000547593808499534494600) * r
            + 0.0151986665636164571966) * r
            + 0.14810397642748007459) * r
            + 0.68976733498510000455) * r
            + 1.6763848301838038494) * r
            + 2.05319162663775882187) * r
            + 1.0;
        x = num / den;
    } else {
        r = r - 5.0;
        let num = ((((((0.000000201033439929228813265 * r + 0.0000271155556874348757815) * r
            + 0.0012426609473880784386) * r
            + 0.026532189526576123093) * r
            + 0.29656057182850489123) * r
            + 1.7848265399172913358) * r
            + 5.4637849111641143699) * r
            + 6.6579046435011037772;
        let den = ((((((0.00000000000000204426310338993978564 * r + 0.00000014215117583164458887) * r
            + 0.000018463183175100546818) * r
            + 0.0007868691311456132591) * r
            + 0.0148753612908506148525) * r
            + 0.13692988092273580531) * r
            + 0.59983220655588793769) * r
            + 1.0;
        x = num / den;
    }
    if q < 0.0 {
        return -x;
    }
    x
}

// Student's t distribution with a whole number of degrees of freedom.
//
// The distribution function is the finite series of Abramowitz and Stegun,
// "Handbook of Mathematical Functions" (1964), 26.7.3 and 26.7.4, with
// theta = atan(|t| / sqrt(nu)): only + - * / and trigonometry, so no gamma
// function is needed. The quantile starts from the normal quantile and takes
// Newton steps on that function; one and two degrees of freedom have closed
// forms. The tails are computed as 1 - A, so a probability below about 1e-12
// (or above 1 - 1e-12) loses relative accuracy.

/// A(t | nu) = P(-|t| <= T <= |t|) for T with `nu` degrees of freedom.
fn student_t_a(t: f64, nu: i64) -> f64 {
    let theta = (t.abs() / (nu as f64).sqrt()).atan();
    let s = theta.sin();
    let c = theta.cos();
    let c2 = c * c;
    if nu % 2 == 1 {
        if nu == 1 {
            return 2.0 * theta / 3.141592653589793;
        }
        // cos(theta) + 2/3 cos^3 + (2 4)/(3 5) cos^5 + ... up to cos^(nu - 2).
        let mut term = c;
        let mut sum = c;
        let mut k: i64 = 2;
        while k <= nu - 3 {
            term = term * c2 * (k as f64) / ((k + 1) as f64);
            sum = sum + term;
            k = k + 2;
        }
        return 2.0 / 3.141592653589793 * (theta + s * sum);
    }
    // 1 + 1/2 cos^2 + (1 3)/(2 4) cos^4 + ... up to cos^(nu - 2).
    let mut term: f64 = 1.0;
    let mut sum: f64 = 1.0;
    let mut k: i64 = 1;
    while k <= nu - 3 {
        term = term * c2 * (k as f64) / ((k + 1) as f64);
        sum = sum + term;
        k = k + 2;
    }
    s * sum
}

/// P(T <= t) for T with `nu` degrees of freedom (`nu` at least 1; otherwise NaN).
pub fn student_t_cdf(t: f64, nu: i64) -> f64 {
    if nu < 1 || t != t {
        return f64::NAN;
    }
    let a = student_t_a(t, nu);
    if t < 0.0 {
        return 0.5 - 0.5 * a;
    }
    0.5 + 0.5 * a
}

/// The density of T with `nu` degrees of freedom at `t`.
pub fn student_t_pdf(t: f64, nu: i64) -> f64 {
    if nu < 1 {
        return f64::NAN;
    }
    // r = Gamma((nu + 1) / 2) / Gamma(nu / 2), by r(nu + 2) = r(nu) (nu + 1) / nu.
    let mut r: f64 = 0.5641895835477563;
    let mut k: i64 = 1;
    if nu % 2 == 0 {
        r = 0.886226925452758;
        k = 2;
    }
    while k < nu {
        r = r * ((k + 1) as f64) / (k as f64);
        k = k + 2;
    }
    let n = nu as f64;
    let base = 1.0 + t * t / n;
    r / (n * 3.141592653589793).sqrt() * (-(n + 1.0) / 2.0 * base.ln()).exp()
}

/// The t with P(T <= t) = p for T with `nu` degrees of freedom. 0 gives
/// negative infinity, 1 positive infinity; p outside [0, 1], NaN or `nu`
/// below 1 gives NaN.
pub fn student_t_quantile(p: f64, nu: i64) -> f64 {
    if nu < 1 || !(p >= 0.0 && p <= 1.0) {
        return f64::NAN;
    }
    if p == 0.0 {
        return f64::NEG_INFINITY;
    }
    if p == 1.0 {
        return f64::INFINITY;
    }
    if p == 0.5 {
        return 0.0;
    }
    if nu == 1 {
        return (3.141592653589793 * (p - 0.5)).tan();
    }
    if nu == 2 {
        return (2.0 * p - 1.0) / (2.0 * p * (1.0 - p)).sqrt();
    }
    // Work in the upper half and reflect.
    let upper = p > 0.5;
    let q = if upper { p } else { 1.0 - p };
    let n = nu as f64;
    let z = normal_quantile(q);
    let z3 = z * z * z;
    let z5 = z3 * z * z;
    let mut t = z + (z3 + z) / (4.0 * n) + (5.0 * z5 + 16.0 * z3 + 3.0 * z) / (96.0 * n * n);
    let mut i: i64 = 0;
    while i < 60 {
        let f = student_t_cdf(t, nu) - q;
        let d = student_t_pdf(t, nu);
        if d == 0.0 {
            break;
        }
        let mut next = t - f / d;
        // Stay in the upper half: a step past zero is halved back.
        while next <= 0.0 {
            next = (next + t) / 2.0;
        }
        if (next - t).abs() <= 1e-15 * next.abs() {
            t = next;
            break;
        }
        t = next;
        i = i + 1;
    }
    if upper {
        return t;
    }
    -t
}
