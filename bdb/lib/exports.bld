// SPDX-License-Identifier: AGPL-3.0-only
// =========================================================================
// C ABI: qdb as a library (bdb/lib). Appended to db.bld without its main()
// by bdb/lib/make_lib.py; built with `buildc build --emit staticlib`.
// =========================================================================
// A host opens a database once and runs any number of statements on it in
// one process. Output goes to the host's stdout, exactly as the CLI prints
// it. The handle is opaque: the header forward-declares DB.
//
//   DB* d = qdb_open("app.db");          load the .db and replay the WAL
//   qdb_exec(d, "SELECT * FROM t");      one statement, as the CLI runs it
//   qdb_close(d);                        checkpoint (or HOLD) and free
//
// Limit: a statement the parser rejects ends the process with exit code 1,
// as the CLI does (24 process_exit sites in db.bld). A host must pass
// statements it trusts to parse, or run qdb in a child process.

extern "C" {
    fn strlen(p: *const u8) -> usize;
    fn free(p: *mut u8);
}

fn qdb_from_c(p: *const u8) -> String ~ Foreign {
    let mut out = String::new();
    if p as usize == 0 {
        return out;
    }
    let n = unsafe { strlen(p) };
    let bytes = unsafe { slice::from_raw_parts(p, n) };
    let mut i: usize = 0;
    while i < n {
        out.push(bytes[i] as char);
        i = i + 1;
    }
    out
}

// A statement's text from the host, with one lasting allocation (P29).
// qdb_from_c grows the String a byte at a time, and each step is a new
// buffer the runtime never frees: about 16 bytes of garbage per byte of SQL
// squared. Here the bytes index a table of one-byte strings, one join makes
// the text, and the list of parts is returned to the allocator.
fn qdb_text(d: &mut DB, p: *const u8) -> String ~ Foreign {
    if p as usize == 0 {
        return "";
    }
    if vec_len(d.byte_strs) == 0 {
        let mut k: i32 = 0;
        while k < 256 {
            let mut one = String::new();
            one.push((k as u8) as char);
            vec_push(d.byte_strs, one);
            k = k + 1;
        }
    }
    let n = unsafe { strlen(p) };
    let bytes = unsafe { slice::from_raw_parts(p, n) };
    let mut parts: Vec<String> = vec![];
    let mut i: usize = 0;
    while i < n {
        vec_push(parts, vec_get(d.byte_strs, bytes[i] as i32));
        i = i + 1;
    }
    let out = parts.join("");
    parts.clear();
    out
}

// The statement without one trailing ';' and without blank ends. A copy is
// made only when there is something to strip.
fn qdb_clean(text: String) -> String {
    let slen = text.len();
    let tb = text.as_bytes();
    let mut clean_sql = text;
    if slen > 0 {
        if tb[slen - 1] == 59 { clean_sql = text.substring(0, slen - 1); }
    }
    let cl = clean_sql.len();
    if cl == 0 { return clean_sql; }
    let cb = clean_sql.as_bytes();
    if cb[0] <= 32 || cb[cl - 1] <= 32 { return clean_sql.trim(); }
    clean_sql
}

extern "C" fn qdb_open(path: *const u8) -> *mut DB ~ Foreign + Console + FileSystem + Process {
    let mut d = db_new(qdb_from_c(path));
    db_load(&mut d);
    wal_replay(&mut d);
    let b = Box::new(d);
    b as *mut DB
}

extern "C" fn qdb_exec(h: *mut DB, sql: *const u8) -> i32 ~ Foreign + Console + FileSystem + Process {
    if h as usize == 0 {
        return 1;
    }
    let trimmed = unsafe { qdb_clean(qdb_text(&mut *h, sql)) };
    if trimmed.len() > 0 {
        unsafe { exec_sql(&mut *h, trimmed); }
    }
    0
}

extern "C" fn qdb_close(h: *mut DB) ~ Foreign + Console + FileSystem + Process {
    if h as usize == 0 {
        return;
    }
    unsafe {
        wal_close(&mut *h);
        free(h as *mut u8);
    }
}

// -------------------------------------------------------------------------
// Prepared statements and rows (COMPLETE.md P25). The shape follows SQLite's:
//
//   QStmt* s = qdb_prepare(d, "SELECT v FROM t WHERE id = ?");
//   qdb_bind_int64(s, 1, 42);                 parameters count from 1
//   while (qdb_step(d, s) == 100) {           100 a row, 101 done
//       qdb_column_text(s, 0, buf, sizeof buf);
//   }
//   qdb_reset(s);                             bindings stay
//   qdb_finalize(s);
//
// Results come back as rows; nothing is printed except an error message,
// which goes to stdout as the CLI prints it. Text cells are copied into the
// host's buffer; qdb_column_text returns the cell's length, or -1 for NULL.
// -------------------------------------------------------------------------

extern "C" fn qdb_prepare(h: *mut DB, sql: *const u8) -> *mut QStmt ~ Foreign + Console + Process {
    let st = unsafe { stmt_new(&mut *h, qdb_clean(qdb_text(&mut *h, sql))) };
    let b = Box::new(st);
    b as *mut QStmt
}

extern "C" fn qdb_bind_count(s: *mut QStmt) -> i32 ~ Foreign {
    unsafe { (*s).nparam }
}

extern "C" fn qdb_bind_int(s: *mut QStmt, i: i32, v: i32) -> i32 ~ Foreign {
    unsafe { stmt_bind_int(&mut *s, i, v as i64) }
}

extern "C" fn qdb_bind_int64(s: *mut QStmt, i: i32, v: i64) -> i32 ~ Foreign {
    unsafe { stmt_bind_int(&mut *s, i, v) }
}

extern "C" fn qdb_bind_text(s: *mut QStmt, i: i32, v: *const u8) -> i32 ~ Foreign {
    unsafe { stmt_bind(&mut *s, i, sql_quote(qdb_from_c(v)), 2) }
}

extern "C" fn qdb_bind_null(s: *mut QStmt, i: i32) -> i32 ~ Foreign {
    unsafe { stmt_bind(&mut *s, i, "NULL", 0) }
}

extern "C" fn qdb_step(h: *mut DB, s: *mut QStmt) -> i32 ~ Foreign + Console + FileSystem + Process {
    unsafe { stmt_step(&mut *h, &mut *s) }
}

extern "C" fn qdb_reset(s: *mut QStmt) -> i32 ~ Foreign {
    unsafe {
        (*s).done = false;
        (*s).cur = 0;
        (*s).nrows = 0;
    }
    0
}

extern "C" fn qdb_column_count(s: *mut QStmt) -> i32 ~ Foreign {
    unsafe { (*s).ncol }
}

fn qdb_copy_out(v: String, buf: *mut u8, cap: i32) -> i32 ~ Foreign {
    let n = v.len();
    if cap <= 0 { return n as i32; }
    let b = v.as_bytes();
    let out = unsafe { slice::from_raw_parts_mut(buf, cap as usize) };
    let mut i: i64 = 0;
    while i < n && i < (cap as i64) - 1 {
        out[i] = b[i];
        i = i + 1;
    }
    out[i] = 0 as u8;
    n as i32
}

extern "C" fn qdb_column_name(s: *mut QStmt, i: i32, buf: *mut u8, cap: i32) -> i32 ~ Foreign {
    unsafe {
        if i < 0 || i >= (*s).ncol { return 0 - 1; }
        qdb_copy_out(vec_get((*s).out_names, i), buf, cap)
    }
}

extern "C" fn qdb_column_text(s: *mut QStmt, i: i32, buf: *mut u8, cap: i32) -> i32 ~ Foreign {
    unsafe {
        let v = stmt_cell(&*s, i);
        if is_null(v) { return 0 - 1; }
        qdb_copy_out(v, buf, cap)
    }
}

extern "C" fn qdb_column_int64(s: *mut QStmt, i: i32) -> i64 ~ Foreign {
    unsafe { text_i64(stmt_cell(&*s, i)) }
}

extern "C" fn qdb_finalize(s: *mut QStmt) ~ Foreign {
    if s as usize == 0 {
        return;
    }
    free(s as *mut u8);
}
