// =============================================================================
// qdb — SQL Database Engine written in BuildLang
// =============================================================================
// SPDX-License-Identifier: AGPL-3.0-only
// Copyright (c) 2026 Zain Dana Harper.
//
// Architecture (sections in order of appearance):
//
//   SECTION 0: PRIMITIVES     (lines ~55-65)    — Character classification helpers
//   SECTION 1: DATA MODEL     (lines ~69-276)   — struct DB, constructor, string pool
//   SECTION 2: STORAGE        (lines ~278-523)  — File persistence (save/load)
//   SECTION 3: WAL            (lines ~525-850)   — Write-ahead log, snapshots, transactions
//   SECTION 4: TOKENIZER      (lines ~854-1027) — SQL lexical analysis
//   SECTION 5: PARSER         (lines ~1067-1920)— SQL statement parsing
//   SECTION 6: EXECUTOR       (lines ~1948-3384)— Query execution engine
//     6a: DDL execution (CREATE TABLE, DROP, ALTER)
//     6b: DML execution (INSERT, UPDATE, DELETE)
//     6c: SELECT — basic single-table queries
//     6d: SELECT — aggregate functions (no GROUP BY)
//     6e: SELECT — GROUP BY with aggregates + HAVING
//     6f: SELECT — JOIN (nested loop)
//     6g: Subquery execution
//   SECTION 7: HELPERS        (lines ~3386-3781)— WHERE eval, LIKE, sorting, formatting
//   SECTION 8: INDEX          (lines ~3783-4038)— Sorted-array indexes, binary search
//   SECTION 9: DISPATCH       (lines ~4040-4092)— SQL routing (exec_sql, exec_sql_no_wal)
//   SECTION 10: REPL          (lines ~4094-4192)— Interactive shell, dot-commands
//   SECTION 11: MAIN          (lines ~4194-end) — Entry point, argument handling
//
// Design Decisions:
//
//   - Single file: BuildLang does not support multi-file compilation or
//     `use` imports between .bld files. All code must live in one file.
//     Sections are separated by banner comments to maintain logical modularity.
//
//   - Single flat struct (DB): BuildLang's C codegen does not reliably emit
//     struct field assignments on local variables. All state passes through
//     &mut DB references to a single top-level struct.
//
//   - String pool: every string is interned once in `pool`, a Vec<String>,
//     and referred to by its integer id. sp_add and sp_get are O(1). A
//     Vec<String> must be created from a typed local (`let v: Vec<String> =
//     vec![];`); a bare vec![] in a struct literal is built as Vec<i32>.
//
//   - Text-based file format: Each line is a DDL statement or pipe-delimited
//     data row. Simple and human-readable. Not page-based like SQLite.
//
//   - Sorted-array indexes with binary search: Simpler than B-trees. Each
//     index maintains sorted key+rowid pairs. Equality uses binary search;
//     range queries scan the sorted array. Indexes are brought up to date
//     lazily, on the next index read: rows appended by INSERT are sorted and
//     merged in, and any other mutation triggers one full merge-sort rebuild.
//
//   - Single-table ORDER BY and index builds use a stable merge sort
//     (sort_rows, sort_positions), O(n log n). The UNION, grouped, JOIN and
//     grouped-JOIN sorts are still stable selection sorts, O(n^2).
//
//   - WAL for crash recovery: Append-only log of mutations, written with
//     append_file. On startup, committed transactions are replayed. The .db
//     is rewritten at a checkpoint, which runs when the WAL outgrows the .db
//     and at a clean exit. ROLLBACK restores from snapshot. See SECTION 3.
//
// SQL Support:
//   CREATE TABLE, INSERT, SELECT, UPDATE, DELETE, DROP TABLE
//   ALTER TABLE ADD COLUMN
//   WHERE (AND/OR, LIKE, IN, IS NULL, IS NOT NULL, BETWEEN, subqueries)
//   JOIN (nested-loop with aliases), GROUP BY, HAVING, DISTINCT
//   ORDER BY (ASC/DESC), LIMIT, column aliases (AS)
//   Aggregates: COUNT(*), SUM, AVG, MIN, MAX
//   CREATE INDEX, BEGIN/COMMIT/ROLLBACK
//
// Usage:
//   qdb test.db "CREATE TABLE users (id INTEGER, name TEXT, age INTEGER)"
//   qdb test.db "SELECT * FROM users WHERE age > 24 AND name = 'Zain'"
//   qdb test.db "SELECT u.name, o.total FROM users u JOIN orders o ON u.id = o.user_id"
//   qdb test.db "SELECT dept, AVG(salary) FROM employees GROUP BY dept"
//   qdb test.db "CREATE INDEX idx_age ON users (age)"
//   qdb test.db                         — interactive REPL mode
//
// Storage format (format 2; format 1 has a "QDB 1" header and format 0 none,
// and both load an empty cell as NULL; format 0 takes cells literally):
//   QDB 2 <txid>          every transaction up to <txid> is in this file
//   TABLE users
//   SCHEMA id:INTEGER name:TEXT age:INTEGER
//   ROW 1|Zain|25
//   ROW 2|a\|b|30          a cell escapes \\ \| \n \r
//   ROW 3|\N|           NULL is \N; an empty cell is ''
//   END
//   INDEX idx_age ON users (age)
// The checkpoint writes the text to <db>.tmp, flushes it and renames it
// over <db> (P14). A complete <db>.ckpt, ending in "QDB CHECKPOINT
// COMPLETE", left by a build before P14 still wins over the .db at load.
// =============================================================================

// =========================================================================
// SECTION 0: PRIMITIVES — Character Classification
// =========================================================================
// Pure functions for character-class tests. Used by both the SQL tokenizer
// and the file-format parser. BuildLang has no char type; single-char
// strings are compared by value.
// =========================================================================
fn is_ws(c: String) -> bool { c == " " || c == "\n" || c == "\r" || c == "\t" }
fn is_digit(c: String) -> bool { c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" }
fn is_lower(c: String) -> bool { c == "a" || c == "b" || c == "c" || c == "d" || c == "e" || c == "f" || c == "g" || c == "h" || c == "i" || c == "j" || c == "k" || c == "l" || c == "m" || c == "n" || c == "o" || c == "p" || c == "q" || c == "r" || c == "s" || c == "t" || c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z" }
fn is_upper(c: String) -> bool { c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" || c == "G" || c == "H" || c == "I" || c == "J" || c == "K" || c == "L" || c == "M" || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R" || c == "S" || c == "T" || c == "U" || c == "V" || c == "W" || c == "X" || c == "Y" || c == "Z" }
fn is_alpha(c: String) -> bool { is_lower(c) || is_upper(c) }
fn is_alnum(c: String) -> bool { is_alpha(c) || is_digit(c) || c == "_" }

// Token type codes (used by the tokenizer in Section 4):
//   0=Keyword, 1=Ident, 2=String literal, 3=Number literal
//   4=Operator, 5=Punctuation, 6=Star, 7=EOF

// =========================================================================
// SECTION 1: DATA MODEL — struct DB, Constructor, String Pool
// =========================================================================
// ALL engine state lives in one flat struct. This is not a design preference
// but a constraint: BuildLang's C codegen cannot reliably emit struct field
// assignments on local variables, so we pass &mut DB everywhere.
//
// The struct is organized into logical groups:
//   - File path and string pool (the interning mechanism)
//   - Table metadata (names, column schema, row data)
//   - Index metadata (sorted-array indexes)
//   - SQL parser state (tokenizer position, parsed AST fields)
//   - WAL/transaction state (log path, snapshot for rollback)
// =========================================================================
struct DB {
    // Database file path
    db_path: String,

    // String pool: one entry per interned string, id = position.
    pool: Vec<String>,
    pn: i32,
    // Per pool entry, filled on first use by sp_kind (P25): 0 not yet read,
    // 1 an integer as is_int_str reads it, 4 another number as is_numeric_str
    // reads it, 2 NULL, 3 other text; and the entry's parse_float, which
    // compare_vals uses on a numeric column.
    pool_nk: Vec<i32>,
    pool_num: Vec<f64>,

    // Tables: parallel arrays indexed by table index
    tbl_names: Vec<i32>,
    tbl_count: i32,

    // Per-table column schema (flattened)
    col_names: Vec<i32>,
    col_types: Vec<i32>,
    tbl_col_starts: Vec<i32>,
    tbl_col_counts: Vec<i32>,

    // Per-table row data: cells stored as pool indices
    cells: Vec<i32>,
    tbl_row_starts: Vec<i32>,
    tbl_row_counts: Vec<i32>,

    // Indexes: parallel arrays indexed by index number
    // Each index stores: name, table index, column index, sorted key+rowid pairs
    idx_names: Vec<i32>,
    idx_tables: Vec<i32>,
    idx_col_indices: Vec<i32>,
    idx_count: i32,
    // Flattened sorted pairs: for index i, keys start at idx_key_starts[i]
    // and run for idx_key_counts[i] entries.
    // idx_keys[start+j] = pool id of key value, idx_rowids[start+j] = row index
    idx_keys: Vec<i32>,
    idx_rowids: Vec<i32>,
    idx_key_starts: Vec<i32>,
    idx_key_counts: Vec<i32>,

    // SQL parser state
    input: String,
    ilen: i32,
    pos: i32,
    tk_type: i32,
    tk_val: String,

    // Parsed statement
    stmt_type: i32,
    p_table: i32,
    p_cols: Vec<i32>,
    p_col_count: i32,
    p_types: Vec<i32>,
    p_vals: Vec<i32>,
    p_val_count: i32,
    p_row_count: i32,
    // REPLACE INTO or INSERT OR REPLACE INTO (P24).
    ins_replace: bool,
    has_where: i32,
    // WHERE leaf conditions. Each entry is one comparison / LIKE / IN /
    // IS [NOT] NULL predicate; the boolean structure over them lives in the
    // wn_* node tree below, so these arrays carry no grouping of their own.
    wc_count: i32,
    wc_left: Vec<i32>,     // left column-ref string id, per condition
    wc_op: Vec<i32>,       // op code 0..9, per condition
    wc_right: Vec<i32>,    // right value string id (-1 for IN / IS [NOT] NULL)
    wc_neg: Vec<i32>,      // 1 = negate this condition (NOT IN / NOT LIKE)
    // WHERE as a boolean-expression tree over the leaf conditions above.
    // Node i has kind wn_kind[i] (0=leaf, 1=AND, 2=OR, 3=NOT). A leaf's wn_a
    // is its condition index into the wc_* arrays (wn_b unused). AND/OR read
    // both children (wn_a, wn_b); NOT reads its one child (wn_a). Nodes are
    // emitted post-order, so a parent's child indices already exist. wc_root
    // is the root node index, or -1 when there is no WHERE. This expresses
    // arbitrary parenthesized grouping, NOT of a group, and NOT BETWEEN with
    // full SQL precedence (OR binds loosest, then AND, then NOT).
    wn_kind: Vec<i32>,
    wn_a: Vec<i32>,
    wn_b: Vec<i32>,
    wn_count: i32,
    wc_root: i32,
    has_order: i32,
    order_col: i32,
    order_desc: i32,
    // Optional secondary ORDER BY key (a comma-separated second column).
    // order_col2 = -1 when the query gives only one key.
    order_col2: i32,
    order_desc2: i32,
    // Aggregate order key: 0 = order_col names a plain column (the common
    // case); 1..5 = COUNT/SUM/AVG/MIN/MAX, with order_col holding the arg
    // name ("*" for COUNT(*)). Lets ORDER BY match an aggregate output column.
    order_agg_func: i32,
    has_limit: i32,
    limit_val: i32,
    has_offset: i32,
    offset_val: i32,
    set_col: i32,
    set_val: i32,        // RHS: literal text, or left operand of an arithmetic RHS
    set_op: i32,         // UPDATE arithmetic op: 0=+ 1=- 2=* 3=/ ; -1 = plain literal
    set_operand: i32,    // right operand string id for arithmetic RHS (-1 if none)
    select_star: i32,
    // Aggregate functions for GROUP BY: 0=none, 1=COUNT, 2=SUM, 3=AVG, 4=MIN, 5=MAX
    p_agg_funcs: Vec<i32>,
    p_agg_cols: Vec<i32>,
    p_agg_count: i32,
    has_group_by: i32,
    group_col: i32,
    // JOIN state
    has_join: i32,
    // 0 = INNER (default), 1 = LEFT [OUTER]
    join_type: i32,
    join_table: i32,
    join_left_col: i32,
    join_right_col: i32,
    // Table aliases: alias pool ids for table1 and table2
    alias1: i32,
    alias2: i32,
    // CREATE INDEX state
    idx_name: i32,
    idx_table_name: i32,
    idx_col_name: i32,

    // IN operator: value lists for WHERE col IN (...). All conditions' IN
    // values are concatenated into one flat pool; each IN condition records
    // its slice via wc_in_start / wc_in_len (buildlang has no Vec<Vec<i32>>).
    wc_in_start: Vec<i32>,
    wc_in_len: Vec<i32>,
    wc_in_pool: Vec<i32>,

    // Scratch: the first result column of the most recent subquery, collected
    // across all matching rows. Turns IN (SELECT ...) into a real IN-list.
    subq_vals: Vec<i32>,
    subq_count: i32,

    // DISTINCT flag
    has_distinct: i32,

    // HAVING clause: agg func code, op code, comparison value
    has_having: i32,
    having_agg_func: i32,
    having_agg_col: i32,
    having_op: i32,
    having_val: i32,

    // Column aliases: parallel to p_agg_cols, -1 means no alias
    p_aliases: Vec<i32>,

    // DISTINCT flag per projection item, parallel to p_agg_funcs/p_agg_cols:
    // 1 = COUNT(DISTINCT col), 0 = plain aggregate or column.
    p_agg_distinct: Vec<i32>,

    // ALTER TABLE state
    alter_col_name: i32,
    alter_col_type: i32,

    // WAL state
    wal_path: String,
    in_transaction: bool,
    txn_id: i32,
    // FNV-1a hash of the open transaction's TXID and OP lines; its COMMIT
    // record carries it so replay can tell a whole transaction from a torn one.
    txn_hash: i64,
    // P16 history: the open transaction's TXID and OP lines as written, the
    // history file and whether it has appends not yet flushed.
    txn_parts: Vec<String>,
    // WAL lines of the open explicit transaction not yet appended (P21):
    // TXID and OP lines wait here and go to the WAL in one append, with
    // the COMMIT record or with HOLD at a clean exit.
    wal_pend: Vec<String>,
    hist_on: bool,
    hist_path: String,
    hist_dirty: bool,
    // Set by a mutation that printed an error and changed nothing; exec_sql
    // then keeps it out of the WAL (and so out of replay and history).
    stmt_failed: bool,
    // P16 receipts: result lines captured while a SELECT prints, and the
    // SHA-256 of the state, cached until the next statement that can change it.
    rcpt_on: bool,
    rcpt_parts: Vec<String>,
    state_sha: String,
    wal_buf: String,
    // Bytes appended to the WAL since the last checkpoint, and the size of
    // the .db file that checkpoint wrote. maybe_checkpoint compares the two.
    wal_bytes: i64,
    db_bytes: i64,
    // Fault injection for the crash tests (bdb/tests/test_qdb_crash.py),
    // read once from the environment in main. QDB_CRASH_AT=k stops the
    // process at its k-th durable write with exit code 77; with
    // QDB_CRASH_MODE=torn the first half of that write lands first,
    // otherwise none of it does. QDB_TRACE_WRITES=1 prints one line per
    // durable write to stderr. Unset, every write goes straight through.
    // File format and recovery state. fmt_escaped is true when the .db
    // began with a "QDB 1 <txid>" or "QDB 2 <txid>" header (cells escaped);
    // fmt_nulls is true for format 2 (NULL written \N, an empty cell is '').
    // A file with no header is format 0 and is read as before. applied_txid is the
    // <txid> of that header: every transaction with an id at or below it is
    // already in the .db, so replay skips it.
    fmt_escaped: bool,
    fmt_nulls: bool,
    applied_txid: i32,
    ckpt_path: String,
    crash_at: i32,
    crash_torn: bool,
    sync_on: bool,
    trace_writes: bool,
    write_seq: i32,
    // Set by any mutation that moves or rewrites existing rows (UPDATE,
    // DELETE, DROP, ALTER, ROLLBACK). The next index read then rebuilds
    // every index from scratch. INSERT leaves it alone: appended rows are
    // folded into each index incrementally by refresh_index.
    idx_stale: bool,
    // P17: canonical key text of every UNIQUE and PRIMARY KEY key in the
    // tables (see con_key), and "M<k>" -> the largest key of INTEGER PRIMARY
    // KEY constraint k. INSERT keeps it current; any other mutation marks it
    // stale and the next INSERT rebuilds it.
    con_map: HashMap<String, f64>,
    con_map_ok: bool,
    // Snapshot for rollback (saved at BEGIN)
    snap_cells: Vec<i32>,
    snap_row_starts: Vec<i32>,
    snap_row_counts: Vec<i32>,
    snap_tbl_names: Vec<i32>,
    snap_tbl_count: i32,
    snap_col_names: Vec<i32>,
    snap_col_types: Vec<i32>,
    snap_col_starts: Vec<i32>,
    snap_col_counts: Vec<i32>,
    snap_idx_names: Vec<i32>,
    snap_idx_tables: Vec<i32>,
    snap_idx_col_indices: Vec<i32>,
    snap_idx_count: i32,
    snap_idx_keys: Vec<i32>,
    snap_idx_rowids: Vec<i32>,
    snap_idx_key_starts: Vec<i32>,
    snap_idx_key_counts: Vec<i32>,

    // UNION accumulator: rows materialized across all branches of a UNION.
    // union_vals is row-major, union_ncol wide, each cell a string-pool id
    // (the same ids the source table cells already hold). Headers and per-
    // output-column types come from the first branch. union_started guards
    // one-time first-branch setup.
    union_vals: Vec<i32>,
    union_headers: Vec<i32>,
    union_coltypes: Vec<i32>,
    union_ncol: i32,
    union_rows: i32,
    union_started: i32,
    // Expression queries (SECTION 6h): expression nodes, query records.
    x_kind: Vec<i32>,
    x_a: Vec<i32>,
    x_b: Vec<i32>,
    x_c: Vec<i32>,
    x_s: Vec<i32>,
    x_as: Vec<i32>,
    x_an: Vec<i32>,
    x_args: Vec<i32>,
    qf_tbl: Vec<i32>,
    qf_alias: Vec<i32>,
    qs_expr: Vec<i32>,
    qs_name: Vec<i32>,
    qo_expr: Vec<i32>,
    qo_desc: Vec<i32>,
    q_fs: Vec<i32>,
    q_fn: Vec<i32>,
    q_ss: Vec<i32>,
    q_sn: Vec<i32>,
    q_where: Vec<i32>,
    q_os: Vec<i32>,
    q_on: Vec<i32>,
    q_limit: Vec<i32>,
    q_offset: Vec<i32>,
    q_distinct: Vec<i32>,
    // Table constraints (P13): kind 0 UNIQUE, 1 PRIMARY KEY, 2 NOT NULL, on
    // table con_tbl, columns con_cols[con_cs .. con_cs + con_cn]. The p_con_*
    // fields hold a CREATE TABLE's parsed constraints, by column name.
    con_tbl: Vec<i32>,
    con_kind: Vec<i32>,
    con_cs: Vec<i32>,
    con_cn: Vec<i32>,
    con_cols: Vec<i32>,
    snap_con_tbl: Vec<i32>,
    snap_con_kind: Vec<i32>,
    snap_con_cs: Vec<i32>,
    snap_con_cn: Vec<i32>,
    snap_con_cols: Vec<i32>,
    p_con_kind: Vec<i32>,
    p_con_cs: Vec<i32>,
    p_con_cn: Vec<i32>,
    p_con_names: Vec<i32>,
    xn: i32,
    xq_n: i32,
    xq_root: i32,
    x_ncol: i32,
    // Row API (P25): while rows_on, SELECT results go to row_names and
    // row_cells (row-major, raw cell text) instead of stdout. schema_ver
    // counts schema changes, so a prepared statement knows when to re-plan.
    rows_on: bool,
    row_names: Vec<String>,
    row_cells: Vec<String>,
    schema_ver: i32,
}

// Initialize a new empty DB. All parallel arrays start empty; pn (pool next
// id) starts at 0. The WAL path is derived by appending ".wal" to the db path.
fn db_new(db_path: String) -> DB {
    let wp = db_path + ".wal";
    let cp = db_path + ".ckpt";
    // Typed local: a bare vec![] in the struct literal is built as a Vec<i32>
    // by the C backend, and pushing strings into that corrupts memory.
    let pool0: Vec<String> = vec![];
    let parts0: Vec<String> = vec![];
    let txp0: Vec<String> = vec![];
    let wpd0: Vec<String> = vec![];
    let pnum0: Vec<f64> = vec![];
    let rown0: Vec<String> = vec![];
    let rowc0: Vec<String> = vec![];
    DB {
        db_path: db_path,
        pool: pool0, pn: 0, pool_nk: vec![], pool_num: pnum0,
        tbl_names: vec![], tbl_count: 0,
        col_names: vec![], col_types: vec![],
        tbl_col_starts: vec![], tbl_col_counts: vec![],
        cells: vec![],
        tbl_row_starts: vec![], tbl_row_counts: vec![],
        idx_names: vec![], idx_tables: vec![], idx_col_indices: vec![], idx_count: 0,
        idx_keys: vec![], idx_rowids: vec![], idx_key_starts: vec![], idx_key_counts: vec![],
        input: "", ilen: 0, pos: 0,
        tk_type: 7, tk_val: "",
        stmt_type: 0, p_table: -1,
        p_cols: vec![], p_col_count: 0,
        p_types: vec![],
        p_vals: vec![], p_val_count: 0, p_row_count: 0, ins_replace: false,
        has_where: 0, wc_count: 0,
        wc_left: vec![], wc_op: vec![], wc_right: vec![],
        wc_neg: vec![],
        wn_kind: vec![], wn_a: vec![], wn_b: vec![], wn_count: 0, wc_root: -1,
        has_order: 0, order_col: -1, order_desc: 0,
        order_col2: -1, order_desc2: 0, order_agg_func: 0,
        has_limit: 0, limit_val: 0,
        has_offset: 0, offset_val: 0,
        set_col: -1, set_val: -1, set_op: -1, set_operand: -1,
        select_star: 0,
        p_agg_funcs: vec![], p_agg_cols: vec![], p_agg_count: 0,
        has_group_by: 0, group_col: -1,
        has_join: 0, join_type: 0, join_table: -1, join_left_col: -1, join_right_col: -1,
        alias1: -1, alias2: -1,
        idx_name: -1, idx_table_name: -1, idx_col_name: -1,
        wc_in_start: vec![], wc_in_len: vec![], wc_in_pool: vec![],
        subq_vals: vec![], subq_count: 0,
        has_distinct: 0,
        has_having: 0, having_agg_func: 0, having_agg_col: -1, having_op: -1, having_val: -1,
        p_aliases: vec![],
        p_agg_distinct: vec![],
        alter_col_name: -1, alter_col_type: -1,
        wal_path: wp,
        in_transaction: false,
        txn_id: 0,
        txn_hash: 0,
        txn_parts: txp0,
        wal_pend: wpd0,
        hist_on: false,
        hist_path: db_path + ".hist",
        hist_dirty: false,
        stmt_failed: false,
        rcpt_on: false,
        rcpt_parts: parts0,
        state_sha: "",
        wal_buf: "",
        wal_bytes: 0, db_bytes: 0,
        fmt_escaped: false, fmt_nulls: false, applied_txid: 0, ckpt_path: cp,
        crash_at: 0, crash_torn: false, sync_on: true, trace_writes: false, write_seq: 0,
        idx_stale: false,
        con_map: map_new(),
        con_map_ok: false,
        snap_cells: vec![], snap_row_starts: vec![], snap_row_counts: vec![],
        snap_tbl_names: vec![], snap_tbl_count: 0,
        snap_col_names: vec![], snap_col_types: vec![],
        snap_col_starts: vec![], snap_col_counts: vec![],
        snap_idx_names: vec![], snap_idx_tables: vec![], snap_idx_col_indices: vec![], snap_idx_count: 0,
        snap_idx_keys: vec![], snap_idx_rowids: vec![], snap_idx_key_starts: vec![], snap_idx_key_counts: vec![],
        union_vals: vec![], union_headers: vec![], union_coltypes: vec![],
        union_ncol: -1, union_rows: 0, union_started: 0,
        x_kind: vec![], x_a: vec![], x_b: vec![], x_c: vec![], x_s: vec![], x_as: vec![], x_an: vec![], x_args: vec![], qf_tbl: vec![], qf_alias: vec![], qs_expr: vec![], qs_name: vec![], qo_expr: vec![], qo_desc: vec![], q_fs: vec![], q_fn: vec![], q_ss: vec![], q_sn: vec![], q_where: vec![], q_os: vec![], q_on: vec![], q_limit: vec![], q_offset: vec![], q_distinct: vec![],
        xn: 0, xq_n: 0, xq_root: -1, x_ncol: 0,
        rows_on: false, row_names: rown0, row_cells: rowc0, schema_ver: 0,
        con_tbl: vec![], con_kind: vec![], con_cs: vec![], con_cn: vec![], con_cols: vec![], snap_con_tbl: vec![], snap_con_kind: vec![], snap_con_cs: vec![], snap_con_cn: vec![], snap_con_cols: vec![], p_con_kind: vec![], p_con_cs: vec![], p_con_cn: vec![], p_con_names: vec![],
    }
}

// --- String Pool ---
// All strings in the engine are interned in d.pool, a Vec<String>. sp_add
// pushes the text and returns its integer ID; sp_get returns the text by ID.
// Pool IDs are used everywhere: table names, column names, cell values,
// parsed tokens. Both calls are O(1). The pool used to be one contiguous
// String grown by concatenation, which copied the whole pool on every
// sp_add, so loading N rows cost O(N^2) time and memory.
fn sp_add(d: &mut DB, text: String) -> i32 {
    let id = d.pn;
    vec_push(d.pool, text);
    vec_push(d.pool_nk, 0);
    vec_push(d.pool_num, 0.0);
    d.pn = d.pn + 1;
    id
}

// is_numeric_str and is_int_str over the bytes (an optional '-', a digit,
// then digits and at most one '.'): 1 an integer, 4 a number with a '.',
// 3 not a number.
fn numeric_bytes(t: String) -> i32 {
    let b = t.as_bytes();
    let n = t.len();
    let mut i: i64 = 0;
    if n > 0 && b[0] == 45 { i = 1; }
    if i >= n { return 3; }
    if b[i] < 48 || b[i] > 57 { return 3; }
    let mut dot = false;
    while i < n {
        let c = b[i];
        if c >= 48 && c <= 57 { i = i + 1; }
        else if c == 46 && !dot { dot = true; i = i + 1; }
        else { return 3; }
    }
    if dot { 4 } else { 1 }
}

// The kind of pool entry id (see pool_nk), read once and kept.
fn sp_kind(d: &mut DB, id: i32) -> i32 {
    let k = vec_get(d.pool_nk, id);
    if k != 0 { return k; }
    let t = vec_get(d.pool, id);
    let mut nk = 3;
    let mut x = 0.0;
    if is_null(t) { nk = 2; }
    else {
        x = t.parse_float();
        nk = numeric_bytes(t);
    }
    let kinds = d.pool_nk;
    kinds[id] = nk;
    let nums = d.pool_num;
    nums[id] = x;
    nk
}

fn sp_get(d: &DB, id: i32) -> String {
    if id < 0 { return ""; }
    vec_get(d.pool, id)
}

// --- SQL NULL ---
// NULL is one reserved cell text, the single character U+0001, kept apart
// from the empty string. A text literal that is exactly that character is
// refused (tok_value), so no stored text can be mistaken for NULL. Output
// renders NULL as `NULL` (disp); the file writes it as \N (escape_cell).
fn nullv() -> String { "\x01" }
fn is_null(s: String) -> bool { s == "\x01" }
fn disp(s: String) -> String { if s == "\x01" { "NULL" } else { s } }

// Three-valued logic for WHERE: 0 false, 1 true, 2 unknown.
fn not3(a: i32) -> i32 { if a == 2 { 2 } else { 1 - a } }
fn and3(a: i32, b: i32) -> i32 {
    if a == 0 || b == 0 { return 0; }
    if a == 1 && b == 1 { return 1; }
    2
}
fn or3(a: i32, b: i32) -> i32 {
    if a == 1 || b == 1 { return 1; }
    if a == 0 && b == 0 { return 0; }
    2
}

// =========================================================================
// SECTION 2: STORAGE — File Persistence (Save / Load)
// =========================================================================
// The database file uses a simple line-oriented text format:
//
//   TABLE <name>
//   SCHEMA <col1>:<TYPE> <col2>:<TYPE> ...
//   ROW <val1>|<val2>|...
//   ROW ...
//   END
//
//   INDEX <name> ON <table> (<column>)
//
// db_save serializes the entire in-memory state to this format.
// db_load parses the file back into the parallel-array structures.
// There is no incremental I/O; the full file is read/written each time.
// =========================================================================

// Join strings pairwise, round by round, so each byte is copied O(log parts)
// times. Appending every line to one growing String copied the whole output
// per line, O(size^2) per save.
// --- Escaped text (file formats 1 and 2) ---
// A cell is written with four escapes: a backslash as \\, a pipe as \|, a
// line feed as \n and a carriage return as \r. A WAL statement that holds a
// line break is written as an OPX line with the same escapes, minus the pipe.
// A string with none of these characters is written unchanged, so a file
// with no special text reads the same in either format.
fn needs_escape(s: String, pipe: bool) -> bool {
    if s.index_of("\\") >= 0 { return true; }
    if s.index_of("\n") >= 0 { return true; }
    if s.index_of("\r") >= 0 { return true; }
    if pipe { if s.index_of("|") >= 0 { return true; } }
    false
}

fn escape_text(s: String, pipe: bool) -> String {
    if !needs_escape(s, pipe) { return s; }
    let mut parts: Vec<String> = vec![];
    let n = s.len();
    let mut i: i64 = 0;
    while i < n {
        let c = s.char_at(i);
        if c == "\\" { vec_push(parts, "\\\\"); }
        else if c == "\n" { vec_push(parts, "\\n"); }
        else if c == "\r" { vec_push(parts, "\\r"); }
        else if pipe && c == "|" { vec_push(parts, "\\|"); }
        else { vec_push(parts, c); }
        i = i + 1;
    }
    concat_parts(parts)
}

// A cell in format 2: NULL is \N, any other text is escape_text with pipes.
fn escape_cell(s: String) -> String {
    if is_null(s) { return "\\N"; }
    escape_text(s, true)
}

// Inverse of escape_text. An unknown escape keeps both characters.
fn unescape_text(s: String) -> String {
    if s.index_of("\\") < 0 { return s; }
    let mut parts: Vec<String> = vec![];
    let n = s.len();
    let mut i: i64 = 0;
    while i < n {
        let c = s.char_at(i);
        if c == "\\" && i + 1 < n {
            let e = s.char_at(i + 1);
            if e == "n" { vec_push(parts, "\n"); }
            else if e == "r" { vec_push(parts, "\r"); }
            else if e == "\\" { vec_push(parts, "\\"); }
            else if e == "|" { vec_push(parts, "|"); }
            else { vec_push(parts, c + e); }
            i = i + 2;
        } else {
            vec_push(parts, c);
            i = i + 1;
        }
    }
    concat_parts(parts)
}

fn concat_parts(parts: Vec<String>) -> String {
    let mut cur: Vec<String> = parts;
    let mut n = vec_len(cur);
    if n == 0 { return ""; }
    while n > 1 {
        let mut next: Vec<String> = vec![];
        let mut i = 0;
        while i < n {
            let a: String = vec_get(cur, i);
            if i + 1 < n {
                let b: String = vec_get(cur, i + 1);
                vec_push(next, a + b);
            } else {
                vec_push(next, a);
            }
            i = i + 2;
        }
        cur = next;
        n = vec_len(cur);
    }
    vec_get(cur, 0)
}

// Serialize the entire database (all tables, rows, and index declarations)
// to the text-based file format and write to d.db_path. Returns the number
// of bytes written, which the checkpoint policy compares the WAL against.
// Does NOT write WAL — this is the "clean" checkpoint format.
// Output is built in chunks of about 64 KB, joined once by concat_parts.
fn db_text(d: &DB) -> String {
    let mut parts: Vec<String> = vec![];
    // Format 2 header: every transaction up to txn_id is in this file.
    let mut out = "QDB 2 " + to_string_i32(d.txn_id) + "\n";
    let mut t = 0;
    while t < d.tbl_count {
        let tname = sp_get(d, vec_get(d.tbl_names, t));
        out = out + "TABLE " + tname + "\n";
        // Schema line
        let cs = vec_get(d.tbl_col_starts, t);
        let cc = vec_get(d.tbl_col_counts, t);
        let mut schema = "SCHEMA";
        let mut c = 0;
        while c < cc {
            let cname = sp_get(d, vec_get(d.col_names, cs + c));
            let ctype = vec_get(d.col_types, cs + c);
            let tstr = if ctype == 0 { "INTEGER" } else if ctype == 1 { "REAL" } else { "TEXT" };
            schema = schema + " " + cname + ":" + tstr;
            c = c + 1;
        }
        out = out + schema + "\n";
        out = out + con_text(d, t, cs);
        // Rows
        let rs = vec_get(d.tbl_row_starts, t);
        let rc = vec_get(d.tbl_row_counts, t);
        let mut r = 0;
        while r < rc {
            let mut row_str = "ROW ";
            let mut ci = 0;
            while ci < cc {
                if ci > 0 { row_str = row_str + "|"; }
                let cell = sp_get(d, vec_get(d.cells, rs + r * cc + ci));
                row_str = row_str + escape_cell(cell);
                ci = ci + 1;
            }
            out = out + row_str + "\n";
            if out.len() > 65536 {
                vec_push(parts, out);
                out = "";
            }
            r = r + 1;
        }
        out = out + "END\n";
        if t + 1 < d.tbl_count {
            out = out + "\n";
        }
        t = t + 1;
    }
    // Save indexes
    let mut ix = 0;
    while ix < d.idx_count {
        let iname = sp_get(d, vec_get(d.idx_names, ix));
        let tbl_idx = vec_get(d.idx_tables, ix);
        let tname = sp_get(d, vec_get(d.tbl_names, tbl_idx));
        let col_i = vec_get(d.idx_col_indices, ix);
        let tcs = vec_get(d.tbl_col_starts, tbl_idx);
        let cname = sp_get(d, vec_get(d.col_names, tcs + col_i));
        out = out + "\nINDEX " + iname + " ON " + tname + " (" + cname + ")\n";
        ix = ix + 1;
    }
    vec_push(parts, out);
    concat_parts(parts)
}

// Rewrite the .db from memory. Returns the bytes written, which the
// checkpoint policy compares the WAL against.
// The rewrite is made crash-safe with a checkpoint file: the whole new
// state goes to <db>.ckpt first, ending in a completion line, then to the
// .db, and wal_checkpoint empties the .ckpt after the WAL is cleared. A
// torn .ckpt lacks its completion line and is ignored (the .db and WAL are
// untouched); a torn .db is ignored in favour of the complete .ckpt.
fn ckpt_marker() -> String { "QDB CHECKPOINT COMPLETE\n" }

fn db_save(d: &mut DB) -> i64 ~ Console + FileSystem + Process {
    // P14: one copy of the state, made atomic by rename: write <db>.tmp,
    // flush it, rename it over <db>. A crash before the rename leaves the old
    // .db and the WAL, which replay recovers; after it, the new .db.
    let all = db_text(d);
    let tmp = d.db_path + ".tmp";
    durable_write(d, tmp, all, false, "db_tmp");
    durable_sync(d, tmp, "db_tmp_sync");
    durable_rename(d, tmp, d.db_path, "db_rename");
    all.len()
}

// Load the database from the text file at d.db_path.
// Parses TABLE/SCHEMA/ROW/END/INDEX lines and populates all parallel arrays.
// If the file doesn't exist or is empty, returns immediately (empty database).
// After loading, the caller should also call wal_replay() to recover any
// committed transactions from the WAL that haven't been checkpointed.
fn db_load(d: &mut DB) ~ FileSystem {
    let mut content = "";
    let mut have = false;
    if file_exists(d.ckpt_path) {
        let ck = read_file(d.ckpt_path);
        let mk = ckpt_marker();
        if ck.len() >= mk.len() {
            if ck.substring(ck.len() - mk.len(), mk.len()) == mk {
                content = ck.substring(0, ck.len() - mk.len());
                have = true;
            }
        }
    }
    if !have {
        if !file_exists(d.db_path) { return; }
        content = read_file(d.db_path);
    }
    let clen = content.len();
    if clen == 0 { return; }

    d.db_bytes = clen;
    // Split once. Slicing off the rest of the content for every line copied
    // the remainder of the file per line, O(size^2) for a large .db.
    let lines: Vec<String> = content.lines();
    let nlines = vec_len(lines);
    let mut li: i64 = 0;
    let mut go = true;
    while go {
        if li >= nlines { go = false; }
        else {
            let line: String = vec_get(lines, li);
            li = li + 1;

            // Strip \r
            let llen = line.len();
            let clean = if llen > 0 {
                let last = line.char_at(llen - 1);
                if last == "\r" { line.substring(0, llen - 1) } else { line }
            } else { line };

            let clen2 = clean.len();
            if clen2 == 0 {
                // skip empty
            } else if clean.starts_with("QDB 1 ") || clean.starts_with("QDB 2 ") {
                d.fmt_escaped = true;
                d.fmt_nulls = clean.starts_with("QDB 2 ");
                d.applied_txid = parse_int_str(clean.substring(6, clen2 - 6));
                d.txn_id = d.applied_txid;
            } else if clean.starts_with("TABLE ") {
                let tname = clean.substring(6, clen2 - 6);
                let tid = sp_add(d, tname);
                vec_push(d.tbl_names, tid);
                vec_push(d.tbl_col_starts, vec_len(d.col_names));
                vec_push(d.tbl_col_counts, 0);
                vec_push(d.tbl_row_starts, vec_len(d.cells));
                vec_push(d.tbl_row_counts, 0);
                d.tbl_count = d.tbl_count + 1;
            } else if clean.starts_with("UNIQUE ") || clean.starts_with("PRIMARY KEY ") || clean.starts_with("NOT NULL ") {
                con_load_line(d, clean);
            } else if clean.starts_with("SCHEMA ") {
                let schema_str = clean.substring(7, clen2 - 7);
                let slen = schema_str.len();
                let mut sp: i64 = 0;
                let mut col_c = 0;
                let mut sgo = true;
                while sgo {
                    if sp >= slen { sgo = false; }
                    else {
                        // Skip spaces
                        let mut skip = true;
                        while skip {
                            if sp >= slen { skip = false; }
                            else {
                                let sc = schema_str.char_at(sp);
                                if sc == " " { sp = sp + 1; } else { skip = false; }
                            }
                        }
                        if sp >= slen { sgo = false; }
                        else {
                            // Read col_name:type token
                            let tok_start = sp;
                            let mut tgo = true;
                            while tgo {
                                if sp >= slen { tgo = false; }
                                else {
                                    let tc = schema_str.char_at(sp);
                                    if tc == " " { tgo = false; }
                                    else { sp = sp + 1; }
                                }
                            }
                            let tok = schema_str.substring(tok_start, sp - tok_start);
                            // Split on ':'
                            let colon = tok.index_of(":");
                            if colon > 0 {
                                let tlen = tok.len();
                                let cname = tok.substring(0, colon);
                                let ctype_str = tok.substring(colon + 1, tlen - colon - 1);
                                let ctype_up = ctype_str.to_uppercase();
                                let cnid = sp_add(d, cname);
                                vec_push(d.col_names, cnid);
                                let ct = type_code_for(ctype_up);
                                vec_push(d.col_types, ct);
                                col_c = col_c + 1;
                            }
                        }
                    }
                }
                // Update col count for current table
                let tidx = d.tbl_count - 1;
                let mut new_cc: Vec<i32> = vec![];
                let mut ci = 0;
                while ci < d.tbl_count {
                    if ci == tidx { vec_push(new_cc, col_c); }
                    else { vec_push(new_cc, vec_get(d.tbl_col_counts, ci)); }
                    ci = ci + 1;
                }
                d.tbl_col_counts = new_cc;
            } else if clean.starts_with("ROW ") {
                let row_str = clean.substring(4, clen2 - 4);
                let rlen = row_str.len();
                let mut rp: i64 = 0;
                let mut cell_count_in_row = 0;
                let mut rgo = true;
                while rgo {
                    if rp >= rlen { rgo = false; }
                    else {
                        let mut cell_val = "";
                        let mut cgo = true;
                        while cgo {
                            if rp >= rlen { cgo = false; }
                            else {
                                let rc = row_str.char_at(rp);
                                if rc == "|" { rp = rp + 1; cgo = false; }
                                else if rc == "\\" && d.fmt_escaped && rp + 1 < rlen {
                                    cell_val = cell_val + rc + row_str.char_at(rp + 1);
                                    rp = rp + 2;
                                }
                                else { cell_val = cell_val + rc; rp = rp + 1; }
                            }
                        }
                        // Format 2 writes NULL as \N; formats 0 and 1 had one empty
                        // cell for NULL and '', read as NULL, which IS NULL matched.
                        let cell_text = if d.fmt_nulls {
                            if cell_val == "\\N" { nullv() } else { unescape_text(cell_val) }
                        } else if cell_val.len() == 0 { nullv() }
                        else if d.fmt_escaped { unescape_text(cell_val) } else { cell_val };
                        let cid = sp_add(d, cell_text);
                        vec_push(d.cells, cid);
                        cell_count_in_row = cell_count_in_row + 1;
                    }
                }
                // Pad with empty cells if row has fewer cells than schema columns
                // (handles trailing pipe for NULL/empty values)
                let tidx = d.tbl_count - 1;
                let expected_cc = vec_get(d.tbl_col_counts, tidx);
                let mut pad_i = cell_count_in_row;
                while pad_i < expected_cc {
                    // Format 2 writes every cell, NULL as \N, so a missing trailing cell is ''.
                    let empty_id = if d.fmt_nulls { sp_add(d, "") } else { sp_add(d, nullv()) };
                    vec_push(d.cells, empty_id);
                    pad_i = pad_i + 1;
                }
                // Increment row count for current table
                let tidx = d.tbl_count - 1;
                let old_rc = vec_get(d.tbl_row_counts, tidx);
                let mut new_rc: Vec<i32> = vec![];
                let mut ri = 0;
                while ri < d.tbl_count {
                    if ri == tidx { vec_push(new_rc, old_rc + 1); }
                    else { vec_push(new_rc, vec_get(d.tbl_row_counts, ri)); }
                    ri = ri + 1;
                }
                d.tbl_row_counts = new_rc;
            // Parse INDEX lines: INDEX idx_name ON table_name (col_name)
            } else if clean.starts_with("INDEX ") {
                let idx_rest = clean.substring(6, clen2 - 6);
                // Parse: idx_name ON table_name (col_name)
                let sp1 = idx_rest.index_of(" ");
                if sp1 > 0 {
                    let iname = idx_rest.substring(0, sp1);
                    let after_name = idx_rest.substring(sp1 + 1, idx_rest.len() - sp1 - 1);
                    // skip "ON "
                    let trimmed_an = after_name.trim();
                    if trimmed_an.starts_with("ON ") {
                        let after_on = trimmed_an.substring(3, trimmed_an.len() - 3);
                        let trimmed_ao = after_on.trim();
                        let sp2 = trimmed_ao.index_of(" ");
                        if sp2 > 0 {
                            let tname_idx = trimmed_ao.substring(0, sp2);
                            let paren_part = trimmed_ao.substring(sp2 + 1, trimmed_ao.len() - sp2 - 1).trim();
                            // Extract col name from (col_name)
                            if paren_part.starts_with("(") {
                                let pp_len = paren_part.len();
                                let col_name_idx = paren_part.substring(1, pp_len - 2);
                                // Build the index
                                let tidx = find_table(d, tname_idx);
                                if tidx >= 0 {
                                    let ics = vec_get(d.tbl_col_starts, tidx);
                                    let icc = vec_get(d.tbl_col_counts, tidx);
                                    let icol = find_col(d, ics, icc, col_name_idx);
                                    if icol >= 0 {
                                        let inid = sp_add(d, iname);
                                        vec_push(d.idx_names, inid);
                                        vec_push(d.idx_tables, tidx);
                                        vec_push(d.idx_col_indices, icol);
                                        vec_push(d.idx_key_starts, vec_len(d.idx_keys));
                                        vec_push(d.idx_key_counts, 0);
                                        d.idx_count = d.idx_count + 1;
                                        // Rebuild index data from table rows
                                        rebuild_index(d, d.idx_count - 1);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // END and unknown lines are skipped
        }
    }
}

// =========================================================================
// SECTION 3: WAL — Write-Ahead Log, Snapshots, Transactions
// =========================================================================
// The WAL provides crash recovery and transaction support.
//
// WAL file format (append-only; every write opens the file in append mode):
//   TXID <n>        — start of transaction n
//   OP <sql>        — a mutation SQL statement within the transaction
//   OPX <sql>       — the same, escaped (\\ \n \r), for a statement that
//                     holds a line break or a backslash
//   COMMIT          — marks transaction n as committed
//   HOLD <n>        — a clean exit inside BEGIN; the next process resumes n
//   RESUME <n>      — a process resumed n (so an unclean exit drops it)
//
// Recovery flow (wal_replay):
//   1. Read the WAL in one pass. A TXID line opens a transaction; a COMMIT
//      record whose hash matches the TXID and OP lines (P15b) replays the
//      transaction's OP lines via exec_sql_no_wal. A torn record, or one
//      left after a power cut dropped an earlier record, does not match.
//      A transaction with no COMMIT (a crash mid-transaction, a torn final
//      record, a ROLLBACK, or a process that ended inside BEGIN without a
//      clean exit) is skipped. A transaction whose id is at or below the
//      .db header's <txid> is already in the .db and is skipped too.
//   2. If the WAL ends in HOLD for the open transaction, resume it (see
//      wal_close) and keep the WAL. Otherwise checkpoint (save + clear WAL).
//
// Transaction flow:
//   BEGIN    -> take_snapshot() + append TXID
//   mutations-> each appends "OP <sql>"
//   COMMIT   -> append COMMIT <hash>, flush the WAL, then maybe_checkpoint()
//   ROLLBACK -> restore_snapshot() + checkpoint (discards WAL entries)
//
// Auto-commit: a mutation outside an explicit transaction appends one
// record "TXID n / OP sql / COMMIT <hash>" in a single append, then calls
// maybe_checkpoint().
//
// Durability contract. A statement is durable once its COMMIT line is in the
// WAL: the next startup replays it whether or not a checkpoint ran. The
// engine has always relied on that point. Before this change the WAL was
// rewritten in full for every line and the .db after every statement; both
// writes truncate and refill a file, so a crash during either could lose
// committed data. An append never touches bytes already written, so a crash
// can at worst tear the last record, and a torn record lacks its COMMIT and
// is skipped. The .db rewrite is truncate-and-write, so db_save writes the
// .ckpt first (see SECTION 2), and the .db header's <txid> stops a replay of
// records the .db already holds after a crash between the rewrite and the
// WAL clear. bdb/tests/test_qdb_crash.py stops every statement at each of its
// durable writes, before the write and halfway through it, and checks the
// recovered state. No write calls fsync: durability is to the OS file cache.
//
// Checkpoint policy. maybe_checkpoint rewrites the .db only once the WAL
// holds more bytes than the .db plus wal_checkpoint_slack(), and never inside
// an open transaction. A checkpoint then costs at most the bytes appended
// since the previous one, so the save cost of a load grows linearly with its
// size. A clean exit (end of a single statement, or the REPL's .quit) also
// checkpoints, so the .db on disk is current between processes, as before.
// =========================================================================

fn wal_checkpoint_slack() -> i64 { 65536 }

// Every write that changes durable state goes through here: WAL appends,
// the .db rewrite and the WAL clear. `tag` names the write in the trace.
fn durable_write(d: &mut DB, path: String, text: String, append: bool, tag: String) ~ Console + FileSystem + Process {
    d.write_seq = d.write_seq + 1;
    if d.trace_writes {
        eprintln!("QDB_WRITE {} {} {}", d.write_seq, tag, text.len());
    }
    if d.crash_at > 0 && d.write_seq == d.crash_at {
        if d.crash_torn {
            let half = text.substring(0, text.len() / 2);
            if append { append_file(path, half); } else { write_file(path, half); }
        }
        process_exit(77);
    }
    if append { append_file(path, text); } else { write_file(path, text); }
}

// Flush a file to the device (P14). A crash point of the fault hook like a
// write: stopped before it, the bytes are written and not flushed, which a
// process crash cannot tell from flushed. QDB_SYNC=off skips the flush.
fn durable_sync(d: &mut DB, path: String, tag: String) ~ Console + FileSystem + Process {
    d.write_seq = d.write_seq + 1;
    if d.trace_writes {
        eprintln!("QDB_WRITE {} {} 0", d.write_seq, tag);
    }
    if d.crash_at > 0 && d.write_seq == d.crash_at { process_exit(77); }
    if d.sync_on { fsync_file(path); }
}

// Replace `to` with `from` in one step (P14). A crash point; a rename is
// never torn, so the torn mode stops before it as well.
fn durable_rename(d: &mut DB, from: String, to: String, tag: String) ~ Console + FileSystem + Process {
    d.write_seq = d.write_seq + 1;
    if d.trace_writes {
        eprintln!("QDB_WRITE {} {} 0", d.write_seq, tag);
    }
    if d.crash_at > 0 && d.write_seq == d.crash_at { process_exit(77); }
    if !rename_file(from, to) {
        eprintln!("Error: could not replace {} with {}", to, from);
        process_exit(1);
    }
}

// FNV-1a, 32 bits, over the bytes of s, continuing from h0. The commit record
// carries this hash of its transaction (P15b): a power cut can tear a record or
// leave a zero-filled hole before a later one, and replay must not mistake the
// survivors for a whole transaction.
fn fnv_init() -> i64 { 2166136261 }

fn fnv_extend(h0: i64, s: String) -> i64 {
    let b = s.as_bytes();
    let n = s.len();
    let mut h = h0;
    let mut i: i64 = 0;
    while i < n {
        h = ((h ^ (b[i] as i64)) * 16777619) % 4294967296;
        i = i + 1;
    }
    h
}

fn hex32(h: i64) -> String {
    let digits = "0123456789abcdef";
    let mut out = "";
    let mut k = 0;
    let mut v = h;
    while k < 8 {
        out = digits.char_at(v % 16) + out;
        v = v / 16;
        k = k + 1;
    }
    out
}

fn commit_line(h: i64) -> String { "COMMIT " + hex32(h) }

// SHA-256 of the bytes of s, as 64 hex digits, from the runtime (String.sha256,
// buildlang #192). Receipts (P16) name a state, a query and a result by it.
fn sha256_hex(s: String) -> String { s.sha256() }

// The TXID line at index from and the OP and OPX lines up to index to, each
// with its line break: the body of a history record.
fn txn_record_parts(lines: Vec<String>, from: i64, to: i64) -> Vec<String> {
    let mut parts: Vec<String> = vec![];
    let mut j = from;
    while j < to {
        let wl = strip_cr(vec_get(lines, j));
        if j == from || wl.starts_with("OP ") || wl.starts_with("OPX ") { vec_push(parts, wl + "\n"); }
        j = j + 1;
    }
    parts
}

fn txn_record(lines: Vec<String>, from: i64, to: i64) -> String {
    concat_parts(txn_record_parts(lines, from, to))
}

fn hist_append(d: &mut DB, rec: String) ~ Console + FileSystem + Process {
    if !d.hist_on { return; }
    durable_write(d, d.hist_path, rec, true, "hist_append");
    d.hist_dirty = true;
}

// Append newline-terminated text to the WAL in a single write.
fn wal_append(d: &mut DB, text: String, tag: String) ~ Console + FileSystem + Process {
    durable_write(d, d.wal_path, text, true, tag);
    d.wal_bytes = d.wal_bytes + text.len();
}

// Append a line to the WAL file
fn wal_write(d: &mut DB, line: String, tag: String) ~ Console + FileSystem + Process {
    wal_append(d, line + "\n", tag);
}

// Hold a line of the open explicit transaction for its closing append (P21).
// Nothing in a transaction is durable before its COMMIT record, and replay
// drops a transaction without one, so holding the lines in memory loses
// nothing a crash could have kept; it saves one file append per statement.
fn wal_hold_line(d: &mut DB, line: String) {
    vec_push(d.wal_pend, line + "\n");
}

// Append the held lines and the closing line in one write.
fn wal_flush_pend(d: &mut DB, last: String, tag: String) ~ Console + FileSystem + Process {
    vec_push(d.wal_pend, last + "\n");
    let text = concat_parts(d.wal_pend);
    let fresh: Vec<String> = vec![];
    d.wal_pend = fresh;
    wal_append(d, text, tag);
}

// Checkpoint: merge WAL into main .db file, then clear WAL
fn wal_checkpoint(d: &mut DB) ~ Console + FileSystem + Process {
    // Every transaction this checkpoint folds into the .db must be durable
    // in the history before the WAL that also holds it is cleared.
    if d.hist_dirty {
        durable_sync(d, d.hist_path, "hist_sync");
        d.hist_dirty = false;
    }
    d.db_bytes = db_save(d);
    // Clear the WAL file
    if file_exists(d.wal_path) {
        durable_write(d, d.wal_path, "", false, "wal_clear");
    }
    // A complete .ckpt from a build before P14 would win over this .db at
    // the next load; clear it once.
    if file_exists(d.ckpt_path) {
        durable_write(d, d.ckpt_path, "", false, "ckpt_clear");
    }
    d.wal_bytes = 0;
}

// Checkpoint once the WAL has grown past the .db it would be merged into.
// Never inside an explicit transaction: db_save would persist uncommitted
// in-memory changes.
fn maybe_checkpoint(d: &mut DB) ~ Console + FileSystem + Process {
    if d.in_transaction { return; }
    if d.wal_bytes > d.db_bytes + wal_checkpoint_slack() {
        wal_checkpoint(d);
    }
}

// Checkpoint at a clean exit so the .db file is current between processes.
// Skipped inside an open transaction, which stays uncommitted as before.
// A clean exit inside BEGIN appends "HOLD <txid>": the next process resumes
// the transaction, so BEGIN, the statements and COMMIT or ROLLBACK can each
// run as their own process. An exit that is not clean (a crash, or a
// statement rejected with exit code 1) leaves no HOLD as the WAL's last
// line (a resuming process appends RESUME first), and the open transaction
// is discarded at the next start, as before.
fn wal_close(d: &mut DB) ~ Console + FileSystem + Process {
    if d.in_transaction {
        wal_flush_pend(d, "HOLD " + to_string_i32(d.txn_id), "wal_hold");
        return;
    }
    if d.wal_bytes > 0 { wal_checkpoint(d); }
}

// Strip one trailing carriage return (a WAL or .db written on Windows).
fn strip_cr(line: String) -> String {
    let llen = line.len();
    if llen > 0 {
        let last = line.char_at(llen - 1);
        if last == "\r" { return line.substring(0, llen - 1); }
    }
    line
}

// Replay committed transactions from WAL into a freshly-loaded DB.
//
// Called once at startup after db_load(). One pass over the lines:
//   TXID   opens a transaction at the next line;
//   COMMIT replays the open transaction's OP lines, in order, through
//          exec_sql_no_wal (no re-logging), then closes it;
//   a later TXID before any COMMIT abandons the open transaction.
// An OP line outside any TXID, and every OP line of a transaction that never
// reached COMMIT, is skipped. Within one process transaction ids only grow,
// and every replay ends by clearing the WAL, so on any WAL the engine writes
// this replays exactly what the older two-pass rule did ("replay an OP if its
// TXID has a COMMIT"), in time linear in the WAL instead of quadratic.
// After replay, checkpoints to merge into the .db file and clears the WAL.
//
// Assumes: DB is already loaded from the .db file. WAL contains only
// mutations that happened after the last checkpoint.
fn wal_replay(d: &mut DB) ~ Console + FileSystem + Process {
    if !file_exists(d.wal_path) { return; }
    let content = read_file(d.wal_path);
    let clen = content.len();
    if clen == 0 { return; }

    let lines: Vec<String> = content.lines();
    let n = vec_len(lines);
    let mut txn_start: i64 = 0 - 1;
    let mut txn_open_id = 0;
    let mut max_id = d.txn_id;
    let mut last_line = "";
    let mut txn_h = fnv_init();
    // A bare COMMIT (written by builds before P15b) counts only when its line
    // break survived.
    let ends_nl = content.substring(clen - 1, 1) == "\n";
    let mut li: i64 = 0;
    while li < n {
        let wl = strip_cr(vec_get(lines, li));
        if wl.len() > 0 { last_line = wl; }
        if wl.starts_with("OP ") || wl.starts_with("OPX ") {
            txn_h = fnv_extend(txn_h, wl + "\n");
        }
        if wl.starts_with("TXID ") {
            txn_h = fnv_extend(fnv_init(), wl + "\n");
            let id = parse_int_str(wl.substring(5, wl.len() - 5));
            if id > max_id { max_id = id; }
            // A transaction at or below the .db's applied id is already in
            // the .db: a crash came after the checkpoint and before the WAL
            // was cleared. Replaying it again would apply it twice.
            if id > d.applied_txid { txn_start = li + 1; txn_open_id = id; }
            else { txn_start = 0 - 1; }
        } else if wl.starts_with("COMMIT") {
            let whole = wl == commit_line(txn_h) || (wl == "COMMIT" && (li + 1 < n || ends_nl));
            if !whole {
                // Torn, or its transaction lost a record: not a commit.
                txn_start = 0 - 1;
            } else if txn_start >= 0 {
                let mut j = txn_start;
                while j < li {
                    let sql = wal_op_sql(strip_cr(vec_get(lines, j)));
                    if sql.len() > 0 { exec_sql_no_wal(d, sql); }
                    j = j + 1;
                }
                // The history may have lost this record from its cache; its
                // reader keeps the first whole copy of each txid.
                if d.hist_on {
                    hist_append(d, txn_record(lines, txn_start - 1, li) + commit_line(txn_h) + "\n");
                }
                txn_start = 0 - 1;
            }
        }
        li = li + 1;
    }
    d.txn_id = max_id;

    // A transaction left open by a clean exit ends the WAL with its HOLD
    // line. Resume it: snapshot the committed state for ROLLBACK, apply the
    // transaction's statements, and keep the WAL as it is, since its open
    // records are the transaction's only durable copy.
    if txn_start >= 0 && last_line == "HOLD " + to_string_i32(txn_open_id) {
        take_snapshot(d);
        let mut j = txn_start;
        while j < n {
            let sql = wal_op_sql(strip_cr(vec_get(lines, j)));
            if sql.len() > 0 { exec_sql_no_wal(d, sql); }
            j = j + 1;
        }
        d.in_transaction = true;
        d.txn_id = txn_open_id;
        d.txn_hash = txn_h;
        let parts = txn_record_parts(lines, txn_start - 1, n);
        d.txn_parts = parts;
        d.wal_bytes = clen;
        // Mark the resume, so the WAL no longer ends in HOLD: if this
        // process does not exit cleanly, the transaction is dropped.
        wal_write(d, "RESUME " + to_string_i32(txn_open_id), "wal_resume");
        return;
    }

    // After replay, checkpoint to merge into .db and clear WAL
    wal_checkpoint(d);
}

// Take a deep copy of all mutable DB state into snap_* fields.
// Called at BEGIN to enable ROLLBACK. Copies: cells, row starts/counts,
// table names/count, column names/types/starts/counts, and all index arrays.
fn copy_vec(v: Vec<i32>) -> Vec<i32> {
    let mut out: Vec<i32> = vec![];
    let n = vec_len(v);
    let mut i = 0;
    while i < n { vec_push(out, vec_get(v, i)); i = i + 1; }
    out
}

fn take_snapshot(d: &mut DB) {
    d.snap_con_tbl = copy_vec(d.con_tbl);
    d.snap_con_kind = copy_vec(d.con_kind);
    d.snap_con_cs = copy_vec(d.con_cs);
    d.snap_con_cn = copy_vec(d.con_cn);
    d.snap_con_cols = copy_vec(d.con_cols);
    // Copy cells
    d.snap_cells = vec![];
    let nc = vec_len(d.cells);
    let mut i: i64 = 0;
    while i < nc {
        vec_push(d.snap_cells, vec_get(d.cells, i));
        i = i + 1;
    }
    // Copy row starts
    d.snap_row_starts = vec![];
    i = 0;
    while i < d.tbl_count {
        vec_push(d.snap_row_starts, vec_get(d.tbl_row_starts, i));
        i = i + 1;
    }
    // Copy row counts
    d.snap_row_counts = vec![];
    i = 0;
    while i < d.tbl_count {
        vec_push(d.snap_row_counts, vec_get(d.tbl_row_counts, i));
        i = i + 1;
    }
    // Copy table names
    d.snap_tbl_names = vec![];
    i = 0;
    while i < d.tbl_count {
        vec_push(d.snap_tbl_names, vec_get(d.tbl_names, i));
        i = i + 1;
    }
    d.snap_tbl_count = d.tbl_count;
    // Copy col names
    d.snap_col_names = vec![];
    let ncn = vec_len(d.col_names);
    i = 0;
    while i < ncn {
        vec_push(d.snap_col_names, vec_get(d.col_names, i));
        i = i + 1;
    }
    // Copy col types
    d.snap_col_types = vec![];
    i = 0;
    while i < ncn {
        vec_push(d.snap_col_types, vec_get(d.col_types, i));
        i = i + 1;
    }
    // Copy col starts
    d.snap_col_starts = vec![];
    i = 0;
    while i < d.tbl_count {
        vec_push(d.snap_col_starts, vec_get(d.tbl_col_starts, i));
        i = i + 1;
    }
    // Copy col counts
    d.snap_col_counts = vec![];
    i = 0;
    while i < d.tbl_count {
        vec_push(d.snap_col_counts, vec_get(d.tbl_col_counts, i));
        i = i + 1;
    }
    // Copy index state
    d.snap_idx_names = vec![];
    d.snap_idx_tables = vec![];
    d.snap_idx_col_indices = vec![];
    i = 0;
    while i < d.idx_count {
        vec_push(d.snap_idx_names, vec_get(d.idx_names, i));
        vec_push(d.snap_idx_tables, vec_get(d.idx_tables, i));
        vec_push(d.snap_idx_col_indices, vec_get(d.idx_col_indices, i));
        i = i + 1;
    }
    d.snap_idx_count = d.idx_count;
    d.snap_idx_keys = vec![];
    let nk = vec_len(d.idx_keys);
    i = 0;
    while i < nk {
        vec_push(d.snap_idx_keys, vec_get(d.idx_keys, i));
        i = i + 1;
    }
    d.snap_idx_rowids = vec![];
    let nr = vec_len(d.idx_rowids);
    i = 0;
    while i < nr {
        vec_push(d.snap_idx_rowids, vec_get(d.idx_rowids, i));
        i = i + 1;
    }
    d.snap_idx_key_starts = vec![];
    i = 0;
    while i < d.idx_count {
        vec_push(d.snap_idx_key_starts, vec_get(d.idx_key_starts, i));
        i = i + 1;
    }
    d.snap_idx_key_counts = vec![];
    i = 0;
    while i < d.idx_count {
        vec_push(d.snap_idx_key_counts, vec_get(d.idx_key_counts, i));
        i = i + 1;
    }
}

// Restore state from snapshot (for ROLLBACK)
fn restore_snapshot(d: &mut DB) {
    d.schema_ver = d.schema_ver + 1;
    // Copies, not the snapshot's own vectors: UPDATE and DELETE write the
    // live arrays in place (P20), which must never reach a snapshot.
    d.con_map_ok = false;
    d.con_tbl = copy_vec(d.snap_con_tbl);
    d.con_kind = copy_vec(d.snap_con_kind);
    d.con_cs = copy_vec(d.snap_con_cs);
    d.con_cn = copy_vec(d.snap_con_cn);
    d.con_cols = copy_vec(d.snap_con_cols);
    d.cells = copy_vec(d.snap_cells);
    d.tbl_row_starts = copy_vec(d.snap_row_starts);
    d.tbl_row_counts = copy_vec(d.snap_row_counts);
    d.tbl_names = d.snap_tbl_names;
    d.tbl_count = d.snap_tbl_count;
    d.col_names = d.snap_col_names;
    d.col_types = d.snap_col_types;
    d.tbl_col_starts = d.snap_col_starts;
    d.tbl_col_counts = d.snap_col_counts;
    d.idx_names = d.snap_idx_names;
    d.idx_tables = d.snap_idx_tables;
    d.idx_col_indices = d.snap_idx_col_indices;
    d.idx_count = d.snap_idx_count;
    d.idx_keys = copy_vec(d.snap_idx_keys);
    d.idx_rowids = copy_vec(d.snap_idx_rowids);
    d.idx_key_starts = copy_vec(d.snap_idx_key_starts);
    d.idx_key_counts = copy_vec(d.snap_idx_key_counts);
    // The snapshot's index entries may predate rows that were appended and
    // not yet folded in; rebuild from the restored rows on the next read.
    d.idx_stale = true;
}

// BEGIN — start a new explicit transaction
fn wal_begin(d: &mut DB) ~ Console + FileSystem + Process {
    if d.in_transaction {
        println!("Error: transaction already in progress");
        return;
    }
    d.in_transaction = true;
    d.txn_id = d.txn_id + 1;
    take_snapshot(d);
    let tl = "TXID " + to_string_i32(d.txn_id);
    d.txn_hash = fnv_extend(fnv_init(), tl + "\n");
    let fresh: Vec<String> = vec![];
    d.txn_parts = fresh;
    if d.hist_on { vec_push(d.txn_parts, tl + "\n"); }
    let fresh2: Vec<String> = vec![];
    d.wal_pend = fresh2;
    wal_hold_line(d, tl);
}

// COMMIT — finalize the current transaction
fn wal_commit(d: &mut DB) ~ Console + FileSystem + Process {
    if !d.in_transaction {
        println!("Error: no transaction in progress");
        return;
    }
    wal_flush_pend(d, commit_line(d.txn_hash), "wal_commit");
    durable_sync(d, d.wal_path, "wal_sync");
    if d.hist_on {
        hist_append(d, concat_parts(d.txn_parts) + commit_line(d.txn_hash) + "\n");
    }
    let fresh: Vec<String> = vec![];
    d.txn_parts = fresh;
    d.in_transaction = false;
    maybe_checkpoint(d);
}

// ROLLBACK — discard changes since BEGIN
fn wal_rollback(d: &mut DB) ~ Console + FileSystem + Process {
    if !d.in_transaction {
        println!("Error: no transaction in progress");
        return;
    }
    restore_snapshot(d);
    d.in_transaction = false;
    let fresh: Vec<String> = vec![];
    d.wal_pend = fresh;
    // Discard WAL entries for this txn by checkpointing restored state
    wal_checkpoint(d);
}

// One WAL line for a statement: "OP <sql>", or "OPX <escaped sql>" when the
// statement holds a line break or a backslash.
fn wal_op_line(sql: String) -> String {
    if needs_escape(sql, false) { return "OPX " + escape_text(sql, false); }
    "OP " + sql
}

// The statement of an OP or OPX line, or "" for any other line.
fn wal_op_sql(line: String) -> String {
    let n = line.len();
    if line.starts_with("OP ") { return line.substring(3, n - 3); }
    if line.starts_with("OPX ") { return unescape_text(line.substring(4, n - 4)); }
    ""
}

// Inside an explicit transaction: hold one OP line (with its line feed) for
// the COMMIT append, as wal_log_mutation does for a statement's text.
fn wal_hold_op(d: &mut DB, oln: String) {
    d.txn_hash = fnv_extend(d.txn_hash, oln);
    if d.hist_on { vec_push(d.txn_parts, oln); }
    vec_push(d.wal_pend, oln);
}

// Write a mutation to WAL and optionally auto-commit
fn wal_log_mutation(d: &mut DB, sql: String) ~ Console + FileSystem + Process {
    if d.in_transaction {
        // In explicit transaction — just append OP to WAL
        wal_hold_op(d, wal_op_line(sql) + "\n");
    } else {
        // Auto-commit: wrap in a single-statement transaction, written as one
        // append so a torn write cannot leave a COMMIT without its OP.
        d.txn_id = d.txn_id + 1;
        let body = "TXID " + to_string_i32(d.txn_id) + "\n" + wal_op_line(sql) + "\n";
        let rec = body + commit_line(fnv_extend(fnv_init(), body)) + "\n";
        wal_append(d, rec, "wal_auto");
        durable_sync(d, d.wal_path, "wal_sync");
        hist_append(d, rec);
        maybe_checkpoint(d);
    }
}

// Count WAL entries and pending status (for .wal command)
fn cmd_wal(d: &DB) ~ Console + FileSystem {
    if !file_exists(d.wal_path) {
        println!("WAL status: empty (no WAL file)");
        return;
    }
    let content = read_file(d.wal_path);
    let clen = content.len();
    if clen == 0 {
        println!("WAL status: empty");
        return;
    }
    let mut op_count = 0;
    let mut pending = 0;
    let mut in_txn = false;
    let lines: Vec<String> = content.lines();
    let n = vec_len(lines);
    let mut li: i64 = 0;
    while li < n {
        let clean = strip_cr(vec_get(lines, li));
        if clean.starts_with("OP ") || clean.starts_with("OPX ") { op_count = op_count + 1; }
        if clean.starts_with("TXID ") { in_txn = true; }
        if clean.starts_with("COMMIT") { in_txn = false; }
        li = li + 1;
    }
    if in_txn { pending = 1; }
    println!("WAL status: {} entries, {} pending transaction", op_count, pending);
}

// --- Table Lookup ---
// Linear scan of tbl_names to find a table by name. Returns table index or -1.
fn find_table(d: &DB, name: String) -> i32 {
    let mut i = 0;
    while i < d.tbl_count {
        let tn = sp_get(d, vec_get(d.tbl_names, i));
        if tn == name { return i; }
        i = i + 1;
    }
    0 - 1
}

// =========================================================================
// SECTION 4: TOKENIZER — SQL Lexical Analysis
// =========================================================================
// Converts the raw SQL input string into a stream of tokens. The tokenizer
// is stateful: d.pos tracks position in d.input, d.tk_type and d.tk_val
// hold the current token. Calling next_token() advances to the next token.
//
// Token types:
//   0 = Keyword (SELECT, FROM, WHERE, etc. — uppercased)
//   1 = Identifier (table/column names — preserved case)
//   2 = String literal (single-quoted, '' for escaped quotes)
//   3 = Number literal (integer or decimal, optional leading minus)
//   4 = Operator (=, <, >, <=, >=, <>, !=, +, -, /)
//   5 = Punctuation ((, ), ,, ;, .)
//   6 = Star (*)
//   7 = EOF
//
// The tokenizer recognizes all SQL keywords via is_keyword() and
// automatically uppercases them. Identifiers are NOT uppercased.
// =========================================================================
fn skip_ws_sql(d: &mut DB) {
    let mut go = true;
    while go {
        if d.pos >= d.ilen { go = false; }
        else {
            let c = d.input.char_at(d.pos);
            if is_ws(c) { d.pos = d.pos + 1; } else { go = false; }
        }
    }
}

fn is_keyword(word: String) -> i32 {
    let u = word.to_uppercase();
    if u == "SELECT" { return 1; }
    if u == "FROM" { return 1; }
    if u == "WHERE" { return 1; }
    if u == "INSERT" { return 1; }
    if u == "INTO" { return 1; }
    if u == "VALUES" { return 1; }
    if u == "CREATE" { return 1; }
    if u == "TABLE" { return 1; }
    if u == "UPDATE" { return 1; }
    if u == "SET" { return 1; }
    if u == "DELETE" { return 1; }
    if u == "DROP" { return 1; }
    if u == "ORDER" { return 1; }
    if u == "BY" { return 1; }
    if u == "ASC" { return 1; }
    if u == "DESC" { return 1; }
    if u == "LIMIT" { return 1; }
    if u == "OFFSET" { return 1; }
    if u == "AND" { return 1; }
    if u == "OR" { return 1; }
    if u == "NOT" { return 1; }
    if u == "NULL" { return 1; }
    if u == "INTEGER" { return 1; }
    if u == "REAL" { return 1; }
    if u == "TEXT" { return 1; }
    if u == "BLOB" { return 1; }
    if u == "PRIMARY" { return 1; }
    if u == "KEY" { return 1; }
    if u == "COUNT" { return 1; }
    if u == "INDEX" { return 1; }
    if u == "ON" { return 1; }
    if u == "JOIN" { return 1; }
    if u == "LEFT" { return 1; }
    if u == "RIGHT" { return 1; }
    if u == "INNER" { return 1; }
    if u == "OUTER" { return 1; }
    if u == "FULL" { return 1; }
    if u == "CROSS" { return 1; }
    if u == "GROUP" { return 1; }
    if u == "SUM" { return 1; }
    if u == "AVG" { return 1; }
    if u == "MIN" { return 1; }
    if u == "MAX" { return 1; }
    if u == "AS" { return 1; }
    if u == "BEGIN" { return 1; }
    if u == "COMMIT" { return 1; }
    if u == "ROLLBACK" { return 1; }
    if u == "LIKE" { return 1; }
    if u == "IN" { return 1; }
    if u == "IS" { return 1; }
    if u == "ALTER" { return 1; }
    if u == "ADD" { return 1; }
    if u == "COLUMN" { return 1; }
    if u == "DISTINCT" { return 1; }
    if u == "HAVING" { return 1; }
    if u == "BETWEEN" { return 1; }
    if u == "UNION" { return 1; }
    if u == "INTERSECT" { return 1; }
    if u == "EXCEPT" { return 1; }
    if u == "ALL" { return 1; }
    0
}

fn next_token(d: &mut DB) {
    skip_ws_sql(d);
    if d.pos >= d.ilen {
        d.tk_type = 7; d.tk_val = ""; return;
    }
    let c = d.input.char_at(d.pos);

    // String literal
    if c == "'" {
        d.pos = d.pos + 1;
        let mut val = "";
        let mut go = true;
        while go {
            if d.pos >= d.ilen { go = false; }
            else {
                let qc = d.input.char_at(d.pos);
                if qc == "'" {
                    if d.pos + 1 < d.ilen {
                        let nx = d.input.char_at(d.pos + 1);
                        if nx == "'" { val = val + "'"; d.pos = d.pos + 2; }
                        else { d.pos = d.pos + 1; go = false; }
                    } else { d.pos = d.pos + 1; go = false; }
                } else { val = val + qc; d.pos = d.pos + 1; }
            }
        }
        d.tk_type = 2; d.tk_val = val; return;
    }

    // Number literal
    if is_digit(c) || (c == "-" && d.pos + 1 < d.ilen) {
        let mut is_neg = false;
        if c == "-" {
            let nx = d.input.char_at(d.pos + 1);
            if is_digit(nx) { is_neg = true; }
        }
        if is_digit(c) || is_neg {
            let mut val = "";
            if is_neg { val = "-"; d.pos = d.pos + 1; }
            let mut ngo = true;
            while ngo {
                if d.pos >= d.ilen { ngo = false; }
                else {
                    let nc = d.input.char_at(d.pos);
                    if is_digit(nc) { val = val + nc; d.pos = d.pos + 1; }
                    else if nc == "." { val = val + nc; d.pos = d.pos + 1; }
                    else { ngo = false; }
                }
            }
            d.tk_type = 3; d.tk_val = val; return;
        }
    }

    // Identifier or keyword
    if is_alpha(c) || c == "_" {
        let mut val = "";
        let mut go = true;
        while go {
            if d.pos >= d.ilen { go = false; }
            else {
                let ic = d.input.char_at(d.pos);
                if is_alnum(ic) { val = val + ic; d.pos = d.pos + 1; }
                else { go = false; }
            }
        }
        let kw = is_keyword(val);
        if kw == 1 { d.tk_type = 0; d.tk_val = val.to_uppercase(); }
        else { d.tk_type = 1; d.tk_val = val; }
        return;
    }

    // Operators
    if c == "<" {
        d.pos = d.pos + 1;
        if d.pos < d.ilen {
            let nx = d.input.char_at(d.pos);
            if nx == "=" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "<="; return; }
            if nx == ">" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "<>"; return; }
        }
        d.tk_type = 4; d.tk_val = "<"; return;
    }
    if c == ">" {
        d.pos = d.pos + 1;
        if d.pos < d.ilen {
            let nx = d.input.char_at(d.pos);
            if nx == "=" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = ">="; return; }
        }
        d.tk_type = 4; d.tk_val = ">"; return;
    }
    if c == "!" {
        d.pos = d.pos + 1;
        if d.pos < d.ilen {
            let nx = d.input.char_at(d.pos);
            if nx == "=" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "!="; return; }
        }
        d.tk_type = 4; d.tk_val = "!"; return;
    }
    if c == "=" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "="; return; }
    if c == "+" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "+"; return; }
    if c == "-" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "-"; return; }
    if c == "/" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "/"; return; }
    if c == "*" { d.pos = d.pos + 1; d.tk_type = 6; d.tk_val = "*"; return; }
    if c == "(" { d.pos = d.pos + 1; d.tk_type = 5; d.tk_val = "("; return; }
    if c == ")" { d.pos = d.pos + 1; d.tk_type = 5; d.tk_val = ")"; return; }
    if c == "," { d.pos = d.pos + 1; d.tk_type = 5; d.tk_val = ","; return; }
    if c == ";" { d.pos = d.pos + 1; d.tk_type = 5; d.tk_val = ";"; return; }
    if c == "." { d.pos = d.pos + 1; d.tk_type = 5; d.tk_val = "."; return; }

    d.pos = d.pos + 1; d.tk_type = 1; d.tk_val = c;
}

// The value of the current token in a value position: the NULL keyword is
// SQL NULL, any other token its text. Fails closed on a text literal that is
// exactly the NULL sentinel.
fn tok_value(d: &DB) -> String ~ Console + Process {
    if d.tk_type == 0 && d.tk_val == "NULL" { return nullv(); }
    if is_null(d.tk_val) {
        println!("Error: the text value U+0001 alone is reserved for NULL");
        process_exit(1);
    }
    d.tk_val
}

fn tk_is_kw(d: &DB, kw: String) -> i32 {
    if d.tk_type == 0 { if d.tk_val == kw { return 1; } }
    0
}

fn tk_is_punct(d: &DB, p: String) -> i32 {
    if d.tk_type == 5 { if d.tk_val == p { return 1; } }
    0
}

fn expect_kw(d: &mut DB, kw: String) ~ Console + Process {
    if tk_is_kw(d, kw) == 0 {
        println!("Error: expected keyword '{}', got '{}'", kw, d.tk_val);
        process_exit(1);
    }
    next_token(d);
}

fn expect_punct(d: &mut DB, p: String) ~ Console + Process {
    if tk_is_punct(d, p) == 0 {
        println!("Error: expected '{}', got '{}'", p, d.tk_val);
        process_exit(1);
    }
    next_token(d);
}

fn op_encode(op: String) -> i32 {
    if op == "=" { return 0; }
    if op == "<" { return 1; }
    if op == ">" { return 2; }
    if op == "<=" { return 3; }
    if op == ">=" { return 4; }
    if op == "<>" { return 5; }
    if op == "!=" { return 5; }
    // 6=LIKE, 7=IN, 8=IS_NULL, 9=IS_NOT_NULL (set directly by parser)
    0 - 1
}

// =========================================================================
// SECTION 5: PARSER — SQL Statement Parsing
// =========================================================================
// Parses tokenized SQL into the "AST" fields of the DB struct. There is no
// separate AST data structure; parsed state is written directly into d.p_*,
// d.has_*, d.wc_* fields. The parser is recursive-descent.
//
// Statement types (d.stmt_type):
//   0 = SELECT    1 = INSERT     2 = CREATE TABLE
//   3 = UPDATE    4 = DELETE     5 = DROP TABLE
//   6 = CREATE INDEX  7 = BEGIN  8 = COMMIT  9 = ROLLBACK
//   10 = ALTER TABLE
//
// parse_sql() is the top-level dispatcher. It peeks at the first keyword
// and delegates to parse_select, parse_insert, parse_create_table, etc.
//
// reset_parser() must be called before each new statement to clear all
// parsed state back to defaults.
// =========================================================================

// Clear the per-statement parse fields to defaults, WITHOUT touching the
// tokenizer position or the UNION accumulator. reset_parser calls this after
// setting up the tokenizer; the UNION executor calls it between branches to
// clear branch 1's parse before parsing branch 2 while keeping the tokenizer
// where it stopped (just past UNION) and the accumulated rows intact.
fn reset_select_fields(d: &mut DB) {
    d.stmt_type = 0;
    d.p_table = -1;
    d.p_cols = vec![];
    d.p_col_count = 0;
    d.p_types = vec![];
    d.p_con_kind = vec![];
    d.p_con_cs = vec![];
    d.p_con_cn = vec![];
    d.p_con_names = vec![];
    d.p_vals = vec![];
    d.p_val_count = 0;
    d.p_row_count = 0;
    d.has_where = 0;
    d.wc_count = 0;
    d.wc_left = vec![];
    d.wc_op = vec![];
    d.wc_right = vec![];
    d.wc_neg = vec![];
    d.wn_kind = vec![];
    d.wn_a = vec![];
    d.wn_b = vec![];
    d.wn_count = 0;
    d.wc_root = -1;
    d.has_order = 0;
    d.order_col = -1;
    d.order_desc = 0;
    d.order_col2 = -1;
    d.order_desc2 = 0;
    d.order_agg_func = 0;
    d.has_limit = 0;
    d.limit_val = 0;
    d.has_offset = 0;
    d.offset_val = 0;
    d.set_col = -1;
    d.set_val = -1;
    d.set_op = -1;
    d.set_operand = -1;
    d.select_star = 0;
    d.p_agg_funcs = vec![];
    d.p_agg_cols = vec![];
    d.p_agg_count = 0;
    d.has_group_by = 0;
    d.group_col = -1;
    d.has_join = 0;
    d.join_type = 0;
    d.join_table = -1;
    d.join_left_col = -1;
    d.join_right_col = -1;
    d.alias1 = -1;
    d.alias2 = -1;
    d.idx_name = -1;
    d.idx_table_name = -1;
    d.idx_col_name = -1;
    d.wc_in_start = vec![];
    d.wc_in_len = vec![];
    d.wc_in_pool = vec![];
    d.subq_vals = vec![];
    d.subq_count = 0;
    d.has_distinct = 0;
    d.has_having = 0;
    d.having_agg_func = 0;
    d.having_agg_col = -1;
    d.having_op = -1;
    d.having_val = -1;
    d.p_aliases = vec![];
    d.p_agg_distinct = vec![];
    d.alter_col_name = -1;
    d.alter_col_type = -1;
}

// Clear all parser state fields to defaults. Must be called before parsing
// each new SQL statement to avoid stale values from previous parses. This is
// the top-level entry, so it also clears the UNION accumulator.
fn reset_parser(d: &mut DB, input: String) {
    d.input = input;
    d.ilen = input.len();
    d.pos = 0;
    d.tk_type = 7;
    d.tk_val = "";
    reset_select_fields(d);
    d.union_vals = vec![];
    d.union_headers = vec![];
    d.union_coltypes = vec![];
    d.union_ncol = -1;
    d.union_rows = 0;
    d.union_started = 0;
    d.x_kind = vec![];
    d.x_a = vec![];
    d.x_b = vec![];
    d.x_c = vec![];
    d.x_s = vec![];
    d.x_as = vec![];
    d.x_an = vec![];
    d.x_args = vec![];
    d.qf_tbl = vec![];
    d.qf_alias = vec![];
    d.qs_expr = vec![];
    d.qs_name = vec![];
    d.qo_expr = vec![];
    d.qo_desc = vec![];
    d.q_fs = vec![];
    d.q_fn = vec![];
    d.q_ss = vec![];
    d.q_sn = vec![];
    d.q_where = vec![];
    d.q_os = vec![];
    d.q_on = vec![];
    d.q_limit = vec![];
    d.q_offset = vec![];
    d.q_distinct = vec![];
    d.xn = 0;
    d.xq_n = 0;
    d.xq_root = -1;
    d.ins_replace = false;
}

fn parse_sql(d: &mut DB) ~ Console + Process {
    next_token(d);
    if tk_is_kw(d, "SELECT") == 1 {
        x_in_table_rewrite(d);
        if x_wanted(d) { parse_xselect(d); return; }
        parse_select(d);
        return;
    }
    if tk_is_kw(d, "INSERT") == 1 { parse_insert(d); return; }
    if tk_word(d) == "REPLACE" { d.ins_replace = true; parse_insert(d); return; }
    if tk_is_kw(d, "CREATE") == 1 {
        // Peek: CREATE TABLE or CREATE INDEX?
        next_token(d);
        if tk_is_kw(d, "INDEX") == 1 { next_token(d); parse_create_index(d); return; }
        if tk_is_kw(d, "TABLE") == 1 { next_token(d); parse_create_table(d); return; }
        println!("Error: expected TABLE or INDEX after CREATE, got '{}'", d.tk_val);
        process_exit(1);
    }
    if tk_is_kw(d, "UPDATE") == 1 { parse_update(d); return; }
    if tk_is_kw(d, "DELETE") == 1 { parse_delete(d); return; }
    if tk_is_kw(d, "DROP") == 1 { parse_drop(d); return; }
    if tk_is_kw(d, "ALTER") == 1 { parse_alter_table(d); return; }
    println!("Error: unrecognized statement starting with '{}'", d.tk_val);
    process_exit(1);
}

// Helper: read a possibly dotted identifier (table.col or just col).
// Returns the full string including the dot.
fn read_col_ref(d: &mut DB) -> String {
    let first = d.tk_val;
    next_token(d);
    if tk_is_punct(d, ".") == 1 {
        next_token(d);
        let second = d.tk_val;
        next_token(d);
        return first + "." + second;
    }
    first
}

// Helper: check if a string is an aggregate keyword
fn is_agg_kw(val: String) -> i32 {
    let u = val.to_uppercase();
    if u == "COUNT" { return 1; }
    if u == "SUM" { return 2; }
    if u == "AVG" { return 3; }
    if u == "MIN" { return 4; }
    if u == "MAX" { return 5; }
    0
}

// Parse a SELECT statement.
//
// Grammar (simplified):
//   SELECT [DISTINCT] <select_list> FROM <table> [alias]
//     [JOIN <table2> [alias2] ON <col> = <col>]
//     [WHERE <conditions>]
//     [GROUP BY <col>]
//     [HAVING <agg_condition>]
//     [ORDER BY <col> [ASC|DESC]]
//     [LIMIT <n>]
//
// Populates: d.select_star, d.p_cols, d.p_agg_funcs, d.p_agg_cols,
//   d.p_aliases, d.p_table, d.alias1, d.has_join, d.join_table, d.alias2,
//   d.join_left_col, d.join_right_col, d.has_where, d.has_group_by,
//   d.has_having, d.has_order, d.has_limit, d.has_distinct
fn parse_select(d: &mut DB) ~ Console + Process {
    d.stmt_type = 0;
    next_token(d);

    // Check for DISTINCT keyword
    if tk_is_kw(d, "DISTINCT") == 1 {
        d.has_distinct = 1;
        next_token(d);
    }

    // Parse select list: could be *, column refs, or aggregate functions
    if d.tk_type == 6 {
        // SELECT *
        d.select_star = 1;
        next_token(d);
    } else {
        let mut go = true;
        while go {
            // Check for aggregate function: COUNT(*), SUM(col), AVG(col), MIN(col), MAX(col)
            let agg = is_agg_kw(d.tk_val);
            if agg > 0 {
                next_token(d);
                expect_punct(d, "(");
                // Optional DISTINCT inside the aggregate (P23: in every aggregate;
                // the value set is taken by distinct_rows). COUNT(DISTINCT *)
                // fails closed rather than silently ignoring the keyword.
                let mut is_distinct = 0;
                if tk_is_kw(d, "DISTINCT") == 1 {
                    is_distinct = 1;
                    next_token(d);
                }
                if d.tk_type == 6 {
                    // COUNT(*)
                    if is_distinct == 1 {
                        println!("Error: COUNT(DISTINCT *) is not supported; use COUNT(*)");
                        process_exit(1);
                    }
                    let star_id = sp_add(d, "*");
                    vec_push(d.p_agg_cols, star_id);
                    next_token(d);
                } else {
                    let agg_col_name = read_col_ref(d);
                    let acid = sp_add(d, agg_col_name);
                    vec_push(d.p_agg_cols, acid);
                }
                expect_punct(d, ")");
                vec_push(d.p_agg_funcs, agg);
                vec_push(d.p_agg_distinct, is_distinct);
                d.p_agg_count = d.p_agg_count + 1;
                // Check for AS alias after aggregate
                if tk_is_kw(d, "AS") == 1 {
                    next_token(d);
                    let alias_name = d.tk_val;
                    let alias_id = sp_add(d, alias_name);
                    vec_push(d.p_aliases, alias_id);
                    next_token(d);
                } else {
                    vec_push(d.p_aliases, 0 - 1);
                }
            } else {
                // Regular column reference (possibly dotted)
                let cref = read_col_ref(d);
                let cid = sp_add(d, cref);
                vec_push(d.p_cols, cid);
                d.p_col_count = d.p_col_count + 1;
                // 0 = no aggregate
                vec_push(d.p_agg_funcs, 0);
                vec_push(d.p_agg_cols, cid);
                vec_push(d.p_agg_distinct, 0);
                d.p_agg_count = d.p_agg_count + 1;
                // Check for AS alias after plain column
                if tk_is_kw(d, "AS") == 1 {
                    next_token(d);
                    let alias_name = d.tk_val;
                    let alias_id = sp_add(d, alias_name);
                    vec_push(d.p_aliases, alias_id);
                    next_token(d);
                } else {
                    vec_push(d.p_aliases, 0 - 1);
                }
            }
            if tk_is_punct(d, ",") == 1 { next_token(d); }
            else { go = false; }
        }
    }

    expect_kw(d, "FROM");
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);

    // Check for table alias (not a keyword)
    if d.tk_type == 1 {
        if tk_is_kw(d, "WHERE") == 0 {
            if tk_is_kw(d, "JOIN") == 0 {
                if tk_is_kw(d, "ORDER") == 0 {
                    if tk_is_kw(d, "LIMIT") == 0 {
                        if tk_is_kw(d, "GROUP") == 0 {
                            d.alias1 = sp_add(d, d.tk_val);
                            next_token(d);
                        }
                    }
                }
            }
        }
    }

    // Optional join qualifier before JOIN: LEFT [OUTER] | INNER.
    // RIGHT/FULL/CROSS are recognized but not yet implemented, so fail closed
    // with a clear error rather than silently running an inner join.
    let mut saw_qualifier = false;
    if tk_is_kw(d, "LEFT") == 1 {
        d.join_type = 1;
        saw_qualifier = true;
        next_token(d);
        if tk_is_kw(d, "OUTER") == 1 { next_token(d); }
    } else if tk_is_kw(d, "INNER") == 1 {
        d.join_type = 0;
        saw_qualifier = true;
        next_token(d);
    } else if tk_is_kw(d, "RIGHT") == 1 {
        println!("Error: RIGHT JOIN is not supported");
        process_exit(1);
    } else if tk_is_kw(d, "FULL") == 1 {
        println!("Error: FULL JOIN is not supported");
        process_exit(1);
    } else if tk_is_kw(d, "CROSS") == 1 {
        println!("Error: CROSS JOIN is not supported");
        process_exit(1);
    }
    if saw_qualifier {
        if tk_is_kw(d, "JOIN") == 0 {
            println!("Error: expected JOIN after join qualifier, got '{}'", d.tk_val);
            process_exit(1);
        }
    }

    // JOIN clause
    if tk_is_kw(d, "JOIN") == 1 {
        d.has_join = 1;
        next_token(d);
        let jt_name = d.tk_val;
        d.join_table = sp_add(d, jt_name);
        next_token(d);
        // Optional alias for join table
        if d.tk_type == 1 {
            if tk_is_kw(d, "ON") == 0 {
                d.alias2 = sp_add(d, d.tk_val);
                next_token(d);
            }
        }
        expect_kw(d, "ON");
        // Parse ON left_col = right_col (dotted refs)
        let left_ref = read_col_ref(d);
        d.join_left_col = sp_add(d, left_ref);
        // Expect =
        if d.tk_type == 4 { if d.tk_val == "=" { next_token(d); } }
        let right_ref = read_col_ref(d);
        d.join_right_col = sp_add(d, right_ref);
    }

    if tk_is_kw(d, "WHERE") == 1 { parse_where(d); }
    if tk_is_kw(d, "GROUP") == 1 { parse_group_by(d); }
    if tk_is_kw(d, "HAVING") == 1 { parse_having(d); }
    if tk_is_kw(d, "ORDER") == 1 { parse_order_by(d); }
    if tk_is_kw(d, "LIMIT") == 1 { parse_limit(d); }
    if tk_is_kw(d, "OFFSET") == 1 { parse_offset(d); }

    // Fail-closed: a finished SELECT parse must leave the cursor at end of
    // input, at a trailing ';', or at a UNION keyword. A UNION hands the rest of
    // the token stream to exec_select_union, which re-enters this function per
    // branch, so this same check fails a stray token after the final branch
    // closed too. Any other leftover is unconsumed input -- a clause we do not
    // parse, or garbage after LIMIT/WHERE -- and running the query anyway would
    // silently drop it and return a plausible wrong answer.
    if tk_is_punct(d, ";") == 1 { next_token(d); }
    if d.tk_type != 7 {
        if is_compound_kw(d) == 0 {
            println!("Error: unexpected trailing input near '{}'", d.tk_val);
            process_exit(1);
        }
    }
}

// 1 when the current token starts a compound operator: UNION, INTERSECT, EXCEPT.
fn is_compound_kw(d: &DB) -> i32 {
    if tk_is_kw(d, "UNION") == 1 { return 1; }
    if tk_is_kw(d, "INTERSECT") == 1 { return 1; }
    if tk_is_kw(d, "EXCEPT") == 1 { return 1; }
    0
}

fn parse_insert(d: &mut DB) ~ Console + Process {
    d.stmt_type = 1;
    next_token(d);
    if tk_is_kw(d, "OR") == 1 {
        next_token(d);
        if tk_word(d) != "REPLACE" {
            println!("Error: only INSERT OR REPLACE is supported, got INSERT OR {}", d.tk_val);
            process_exit(1);
        }
        d.ins_replace = true;
        next_token(d);
    }
    expect_kw(d, "INTO");
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);

    // Optional column list before VALUES
    if tk_is_punct(d, "(") == 1 {
        if tk_is_kw(d, "VALUES") == 0 {
            // This is a column list, not VALUES
            next_token(d);
            let mut go = true;
            while go {
                let cname = d.tk_val;
                let cid = sp_add(d, cname);
                vec_push(d.p_cols, cid);
                d.p_col_count = d.p_col_count + 1;
                next_token(d);
                if tk_is_punct(d, ",") == 1 { next_token(d); }
                else { go = false; }
            }
            expect_punct(d, ")");
        }
    }

    // INSERT ... SELECT (P22): the expression path parses the query; exec_insert
    // runs it and inserts its rows as if they were VALUES tuples.
    if tk_is_kw(d, "SELECT") == 1 {
        d.xq_root = xp_query(d);
        if tk_is_punct(d, ";") == 1 { next_token(d); }
        if d.tk_type != 7 {
            println!("Error: unexpected trailing input near '{}'", d.tk_val);
            process_exit(1);
        }
        return;
    }

    expect_kw(d, "VALUES");
    // One or more parenthesized value tuples: (..),(..),..
    // All tuples flow into d.p_vals; d.p_row_count records how many tuples.
    let mut rowcnt = 0;
    let mut rgo = true;
    while rgo {
        expect_punct(d, "(");
        let mut vgo = true;
        while vgo {
            // Unquoted NULL keyword stores SQL NULL; quoted 'NULL' is text.
            let vtext = tok_value(d);
            let vid = sp_add(d, vtext);
            vec_push(d.p_vals, vid);
            d.p_val_count = d.p_val_count + 1;
            next_token(d);
            if tk_is_punct(d, ",") == 1 { next_token(d); }
            else { vgo = false; }
        }
        expect_punct(d, ")");
        rowcnt = rowcnt + 1;
        if tk_is_punct(d, ",") == 1 { next_token(d); }
        else { rgo = false; }
    }
    d.p_row_count = rowcnt;
}

fn parse_create_table(d: &mut DB) ~ Console + Process {
    d.stmt_type = 2;
    // TABLE keyword already consumed by parse_sql
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);
    expect_punct(d, "(");
    let mut go = true;
    while go {
        let w = tk_word(d);
        if w == "CONSTRAINT" {
            next_token(d);
            next_token(d);
        }
        let w2 = tk_word(d);
        if w2 == "PRIMARY" || w2 == "UNIQUE" {
            // Table constraint: PRIMARY KEY (a, b) or UNIQUE (a, b).
            let kind = if w2 == "PRIMARY" { 1 } else { 0 };
            next_token(d);
            if kind == 1 { expect_kw(d, "KEY"); }
            expect_punct(d, "(");
            let st = vec_len(d.p_con_names);
            let mut n = 0;
            let mut cgo = true;
            while cgo {
                if d.tk_type != 1 && d.tk_type != 0 {
                    println!("Error: expected a column name in the table constraint, got '{}'", d.tk_val);
                    process_exit(1);
                }
                vec_push(d.p_con_names, sp_add(d, d.tk_val));
                n = n + 1;
                next_token(d);
                if tk_word(d) == "ASC" || tk_word(d) == "DESC" { next_token(d); }
                if tk_is_punct(d, ",") == 1 { next_token(d); } else { cgo = false; }
            }
            expect_punct(d, ")");
            vec_push(d.p_con_kind, kind);
            vec_push(d.p_con_cs, st);
            vec_push(d.p_con_cn, n);
        } else {
            let cname = d.tk_val;
            let cid = sp_add(d, cname);
            vec_push(d.p_cols, cid);
            d.p_col_count = d.p_col_count + 1;
            next_token(d);
            let ctype = d.tk_val;
            let tid = sp_add(d, ctype);
            vec_push(d.p_types, tid);
            next_token(d);
            // Type arguments, as in VARCHAR(30) or DECIMAL(10, 2), are read and
            // dropped: the type keeps its storage class.
            if tk_is_punct(d, "(") == 1 {
                next_token(d);
                let mut targ = true;
                while targ {
                    if d.tk_type != 3 {
                        println!("Error: expected a number in the arguments of type '{}', got '{}'", ctype, d.tk_val);
                        process_exit(1);
                    }
                    next_token(d);
                    if tk_is_punct(d, ",") == 1 { next_token(d); }
                    else { targ = false; }
                }
                expect_punct(d, ")");
            }
            // Column constraints: PRIMARY KEY [ASC|DESC], UNIQUE, NOT NULL, NULL.
            let mut kgo = true;
            while kgo {
                let kw = tk_word(d);
                let mut kind = -1;
                if kw == "PRIMARY" {
                    next_token(d);
                    expect_kw(d, "KEY");
                    if tk_word(d) == "ASC" || tk_word(d) == "DESC" { next_token(d); }
                    kind = 1;
                } else if kw == "UNIQUE" {
                    next_token(d);
                    kind = 0;
                } else if kw == "NOT" {
                    next_token(d);
                    expect_kw(d, "NULL");
                    kind = 2;
                } else if kw == "NULL" {
                    next_token(d);
                } else {
                    kgo = false;
                }
                if kind >= 0 {
                    vec_push(d.p_con_kind, kind);
                    vec_push(d.p_con_cs, vec_len(d.p_con_names));
                    vec_push(d.p_con_cn, 1);
                    vec_push(d.p_con_names, cid);
                }
            }
        }
        if tk_is_punct(d, ",") == 1 { next_token(d); }
        else { go = false; }
    }
    expect_punct(d, ")");
}

fn parse_create_index(d: &mut DB) ~ Console + Process {
    d.stmt_type = 6;
    // INDEX keyword already consumed by parse_sql
    let iname = d.tk_val;
    d.idx_name = sp_add(d, iname);
    next_token(d);
    expect_kw(d, "ON");
    let tname = d.tk_val;
    d.idx_table_name = sp_add(d, tname);
    next_token(d);
    expect_punct(d, "(");
    let cname = d.tk_val;
    d.idx_col_name = sp_add(d, cname);
    next_token(d);
    expect_punct(d, ")");
}

fn parse_group_by(d: &mut DB) ~ Console + Process {
    next_token(d);
    expect_kw(d, "BY");
    d.has_group_by = 1;
    let cref = read_col_ref(d);
    d.group_col = sp_add(d, cref);
}

// Parse HAVING clause: HAVING agg_func(col) op value
// e.g. HAVING COUNT(*) > 2
fn parse_having(d: &mut DB) ~ Console + Process {
    next_token(d);
    d.has_having = 1;
    // Parse aggregate function
    let agg = is_agg_kw(d.tk_val);
    d.having_agg_func = agg;
    next_token(d);
    expect_punct(d, "(");
    if d.tk_type == 6 {
        // COUNT(*)
        let star_id = sp_add(d, "*");
        d.having_agg_col = star_id;
        next_token(d);
    } else {
        let col_ref = read_col_ref(d);
        d.having_agg_col = sp_add(d, col_ref);
    }
    expect_punct(d, ")");
    // Parse operator. op_encode returns -1 for any token that is not one of
    // = < > <= >= <> !=. eval_where treats -1 as always-false, so a HAVING with
    // an arithmetic or stray operator (COUNT(*) + 0 > 1, SUM(salary) % 2 = 0)
    // dropped every group and returned an empty result with exit 0: a silent
    // wrong answer, the same class Fork 12 closed for WHERE. Fail closed here.
    let op = d.tk_val;
    d.having_op = op_encode(op);
    if d.having_op < 0 {
        println!("Error: unsupported operator in HAVING: {}", op);
        process_exit(1);
    }
    next_token(d);
    // A doubled operator (COUNT(*) == 1) is two tokens: the first parsed as a
    // valid op above, the second now sits in the value position as an operator
    // token (type 4). Reading it as the value compared the aggregate against a
    // symbol it never equals, again silently empty. Reject it.
    if d.tk_type == 4 {
        println!("Error: expected a value after operator in HAVING, got '{}'", d.tk_val);
        process_exit(1);
    }
    // Parse value
    let val = d.tk_val;
    d.having_val = sp_add(d, val);
    next_token(d);
}

fn parse_update(d: &mut DB) ~ Console + Process {
    d.stmt_type = 3;
    next_token(d);
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);
    expect_kw(d, "SET");
    let cname = d.tk_val;
    d.set_col = sp_add(d, cname);
    next_token(d);
    if d.tk_type == 4 { if d.tk_val == "=" { next_token(d); } }
    let vtext = tok_value(d);
    d.set_val = sp_add(d, vtext);
    next_token(d);
    // Optional arithmetic RHS: SET col = <vtext> <op> <operand>. Match the
    // operator by VALUE, not token type: '*' tokenizes as the star token
    // (type 6) while '+' '-' '/' are operator tokens (type 4), so a type-only
    // guard silently misses '*', leaving it in the stream. A stray '*' then
    // drops the WHERE clause below and overwrites every row, so match all four
    // uniformly on tk_val.
    let p = d.tk_val;
    let mut opc = 0 - 1;
    if p == "+" { opc = 0; }
    else if p == "-" { opc = 1; }
    else if p == "*" { opc = 2; }
    else if p == "/" { opc = 3; }
    if opc >= 0 {
        d.set_op = opc;
        next_token(d);
        d.set_operand = sp_add(d, d.tk_val);
        next_token(d);
    }
    // Fail-closed: after the SET value (and its optional arithmetic tail), the
    // only legal continuations are WHERE, a ';' terminator, or end of input.
    // Any other leftover token means we failed to parse part of the SET clause;
    // proceeding would silently drop the WHERE clause and rewrite the whole
    // table, so abort before exec runs any mutation.
    if tk_is_kw(d, "WHERE") == 1 {
        parse_where(d);
    } else if d.tk_type == 7 {
        // end of input: whole-table UPDATE, no WHERE
    } else if tk_is_punct(d, ";") == 1 {
        // ';' terminator: also a whole-table UPDATE
    } else {
        println!("Error: unexpected token '{}' after UPDATE SET value", d.tk_val);
        process_exit(1);
    }
}

fn parse_delete(d: &mut DB) ~ Console + Process {
    d.stmt_type = 4;
    next_token(d);
    expect_kw(d, "FROM");
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);
    if tk_is_kw(d, "WHERE") == 1 { parse_where(d); }
}

fn parse_drop(d: &mut DB) ~ Console + Process {
    d.stmt_type = 5;
    next_token(d);
    expect_kw(d, "TABLE");
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);
}

// Append one non-IN condition to the DNF list under group `grp`.
// wc_in_start = -1 / wc_in_len = 0 mark it as not an IN condition.
// Append one leaf condition and return its index (its position in the wc_*
// arrays). The parser wraps that index in a tree leaf node via wn_leaf.
fn wc_push(d: &mut DB, left_id: i32, op: i32, right_id: i32, neg: i32) -> i32 {
    let ci = d.wc_count;
    vec_push(d.wc_left, left_id);
    vec_push(d.wc_op, op);
    vec_push(d.wc_right, right_id);
    vec_push(d.wc_neg, neg);
    vec_push(d.wc_in_start, -1);
    vec_push(d.wc_in_len, 0);
    d.wc_count = d.wc_count + 1;
    ci
}

// Append one IN condition (op 7) and return its index. Its value list is copied
// into the shared wc_in_pool; the slice is recorded via wc_in_start / wc_in_len
// (buildlang has no Vec<Vec<i32>>, so every IN list shares one flat pool).
fn wc_push_in(d: &mut DB, left_id: i32, neg: i32, vals: Vec<i32>, vcount: i32) -> i32 {
    let ci = d.wc_count;
    let mut start = 0;
    start = vec_len(d.wc_in_pool);
    let mut i = 0;
    while i < vcount {
        vec_push(d.wc_in_pool, vec_get(vals, i));
        i = i + 1;
    }
    vec_push(d.wc_left, left_id);
    vec_push(d.wc_op, 7);
    vec_push(d.wc_right, -1);
    vec_push(d.wc_neg, neg);
    vec_push(d.wc_in_start, start);
    vec_push(d.wc_in_len, vcount);
    d.wc_count = d.wc_count + 1;
    ci
}

// Append one boolean-tree node and return its index. kind: 0=leaf, 1=AND,
// 2=OR, 3=NOT. For a leaf, a is the condition index and b is -1; for AND/OR,
// a and b are child node indices; for NOT, a is the one child and b is -1.
fn wn_push(d: &mut DB, kind: i32, a: i32, b: i32) -> i32 {
    let n = d.wn_count;
    vec_push(d.wn_kind, kind);
    vec_push(d.wn_a, a);
    vec_push(d.wn_b, b);
    d.wn_count = d.wn_count + 1;
    n
}

// Wrap a leaf condition index in a tree leaf node.
fn wn_leaf(d: &mut DB, ci: i32) -> i32 {
    wn_push(d, 0, ci, -1)
}

// Parse one leaf WHERE predicate and return its tree-node index. A leading NOT
// is handled by parse_not_expr; this reads the infix NOT (col NOT IN / NOT LIKE
// / NOT BETWEEN) that binds to a single predicate. Comparison ops, LIKE,
// IN (value-list or SELECT subquery), IS [NOT] NULL, and scalar subqueries each
// become one leaf. BETWEEN expands to a real subtree: AND(>=lo,<=hi), or when
// negated OR(<lo,>hi), so the compound case is exact rather than an honest null.
// Mirror a comparison for swapped operands: lit < col is col > lit.
fn op_mirror(op: i32) -> i32 {
    if op == 1 { return 2; }
    if op == 2 { return 1; }
    if op == 3 { return 4; }
    if op == 4 { return 3; }
    op
}

fn parse_condition(d: &mut DB) -> i32 ~ Console + Process {
    let mut neg = 0;
    // A literal first, as in 272 = e3: read it as e3 = 272, with the
    // operator mirrored. Only a column may stand on the other side.
    if d.tk_type == 2 || d.tk_type == 3 || (d.tk_type == 0 && d.tk_val == "NULL") {
        let lit = tok_value(d);
        next_token(d);
        let lop = d.tk_val;
        let lop_code = op_encode(lop);
        if lop_code < 0 {
            println!("Error: expected a comparison after the literal '{}' in WHERE, got '{}'", disp(lit), lop);
            process_exit(1);
        }
        next_token(d);
        if d.tk_type != 1 {
            println!("Error: a comparison needs a column on one side; got '{}' {} '{}'", disp(lit), lop, d.tk_val);
            process_exit(1);
        }
        let cref = read_col_ref(d);
        let col_id = sp_add(d, cref);
        let lit_id = sp_add(d, lit);
        let ci = wc_push(d, col_id, op_mirror(lop_code), lit_id, 0);
        return wn_leaf(d, ci);
    }
    let lref = read_col_ref(d);
    let left_id = sp_add(d, lref);
    // Infix NOT: col NOT IN (...) / col NOT LIKE 'pat' / col NOT BETWEEN lo AND hi
    if tk_is_kw(d, "NOT") == 1 {
        neg = 1;
        next_token(d);
    }

    // LIKE
    if tk_is_kw(d, "LIKE") == 1 {
        next_token(d);
        let pattern = tok_value(d);
        let pat_id = sp_add(d, pattern);
        next_token(d);
        let ci = wc_push(d, left_id, 6, pat_id, neg);
        return wn_leaf(d, ci);
    }

    // IN (value-list or SELECT subquery)
    if tk_is_kw(d, "IN") == 1 {
        next_token(d);
        expect_punct(d, "(");
        if tk_is_kw(d, "SELECT") == 1 {
            // Run the subquery and take its full first-column result set as the
            // IN-list. subq_vals survives the subquery's own state restore.
            parse_and_exec_subquery(d);
            let mut sv: Vec<i32> = vec![];
            let mut svc = 0;
            let mut svi = 0;
            while svi < d.subq_count {
                vec_push(sv, vec_get(d.subq_vals, svi));
                svc = svc + 1;
                svi = svi + 1;
            }
            expect_punct(d, ")");
            let ci = wc_push_in(d, left_id, neg, sv, svc);
            return wn_leaf(d, ci);
        } else {
            let mut vals: Vec<i32> = vec![];
            let mut vcount = 0;
            let mut go = true;
            while go {
                let vtext = tok_value(d);
                let vid = sp_add(d, vtext);
                vec_push(vals, vid);
                vcount = vcount + 1;
                next_token(d);
                if tk_is_punct(d, ",") == 1 { next_token(d); }
                else { go = false; }
            }
            expect_punct(d, ")");
            let ci = wc_push_in(d, left_id, neg, vals, vcount);
            return wn_leaf(d, ci);
        }
    }

    // BETWEEN: col BETWEEN lo AND hi. Positive -> AND(col>=lo, col<=hi).
    // Negated (NOT BETWEEN) -> OR(col<lo, col>hi). Both are real subtrees, so
    // the result is exact even inside a larger AND/OR expression.
    if tk_is_kw(d, "BETWEEN") == 1 {
        next_token(d);
        let lo_val = tok_value(d);
        let lo_id = sp_add(d, lo_val);
        next_token(d);
        expect_kw(d, "AND");
        let hi_val = tok_value(d);
        let hi_id = sp_add(d, hi_val);
        next_token(d);
        if neg == 1 {
            let a = wc_push(d, left_id, 1, lo_id, 0);
            let b = wc_push(d, left_id, 2, hi_id, 0);
            let la = wn_leaf(d, a);
            let lb = wn_leaf(d, b);
            return wn_push(d, 2, la, lb);
        } else {
            let a = wc_push(d, left_id, 4, lo_id, 0);
            let b = wc_push(d, left_id, 3, hi_id, 0);
            let la = wn_leaf(d, a);
            let lb = wn_leaf(d, b);
            return wn_push(d, 1, la, lb);
        }
    }

    // IS NULL / IS NOT NULL
    if tk_is_kw(d, "IS") == 1 {
        next_token(d);
        if tk_is_kw(d, "NOT") == 1 {
            next_token(d);
            expect_kw(d, "NULL");
            let ci = wc_push(d, left_id, 9, -1, neg);
            return wn_leaf(d, ci);
        } else {
            expect_kw(d, "NULL");
            let ci = wc_push(d, left_id, 8, -1, neg);
            return wn_leaf(d, ci);
        }
    }

    // Normal operator: =, <, >, <=, >=, <>, !=
    let op = d.tk_val;
    let op_code = op_encode(op);
    // Fail closed on an unrecognized comparison operator. op_encode returns -1
    // for any token that is not one of = < > <= >= <> != . An arithmetic
    // operator (as in `salary + 10 > 100`) or a stray symbol like % lands here.
    // Before this guard the leaf was built with op -1, which eval_where treats
    // as always-false, so the query returned zero rows with no diagnostic, a
    // silent wrong answer.
    if op_code < 0 {
        println!("Error: unsupported operator '{}' in WHERE; arithmetic in a condition such as col + N is not supported", op);
        process_exit(1);
    }
    next_token(d);

    // Scalar subquery: op (SELECT ...)
    if tk_is_punct(d, "(") == 1 {
        next_token(d);
        if tk_is_kw(d, "SELECT") == 1 {
            let sub_result = parse_and_exec_subquery(d);
            let rid = sp_add(d, sub_result);
            expect_punct(d, ")");
            let ci = wc_push(d, left_id, op_code, rid, neg);
            return wn_leaf(d, ci);
        }
    }

    // Fail closed when the value position holds another operator token
    // (tk_type 4), which means a doubled operator such as the C-style `==`:
    // the first `=` parsed as the operator and the second `=` would otherwise
    // be taken as the literal value `"="`, comparing the column to a string it
    // never equals and returning zero rows silently. A negative number like -5
    // is one number token (type 3), so this does not misfire on `col > -5`.
    if d.tk_type == 4 {
        println!("Error: expected a value after operator '{}' in WHERE, got '{}' (use = not ==)", op, d.tk_val);
        process_exit(1);
    }

    // Plain value
    let rval = tok_value(d);
    let rid = sp_add(d, rval);
    next_token(d);
    let ci = wc_push(d, left_id, op_code, rid, neg);
    wn_leaf(d, ci)
}

// Recursive-descent boolean-expression parser over parse_condition leaves with
// real SQL precedence: OR lowest, then AND, then a NOT prefix, then a primary
// (a parenthesized subexpression or one condition). Each returns the root node
// index of the subtree it parsed, so parse_where can record a single wc_root.
fn parse_primary(d: &mut DB) -> i32 ~ Console + Process {
    if tk_is_punct(d, "(") == 1 {
        next_token(d);
        let n = parse_or_expr(d);
        expect_punct(d, ")");
        return n;
    }
    parse_condition(d)
}

fn parse_not_expr(d: &mut DB) -> i32 ~ Console + Process {
    if tk_is_kw(d, "NOT") == 1 {
        next_token(d);
        let child = parse_primary(d);
        return wn_push(d, 3, child, -1);
    }
    parse_primary(d)
}

fn parse_and_expr(d: &mut DB) -> i32 ~ Console + Process {
    let mut left = parse_not_expr(d);
    while tk_is_kw(d, "AND") == 1 {
        next_token(d);
        let right = parse_not_expr(d);
        left = wn_push(d, 1, left, right);
    }
    left
}

fn parse_or_expr(d: &mut DB) -> i32 ~ Console + Process {
    let mut left = parse_and_expr(d);
    while tk_is_kw(d, "OR") == 1 {
        next_token(d);
        let right = parse_and_expr(d);
        left = wn_push(d, 2, left, right);
    }
    left
}

// Parse the full WHERE clause into a boolean-expression tree rooted at wc_root.
fn parse_where(d: &mut DB) ~ Console + Process {
    next_token(d);
    d.has_where = 1;
    let root = parse_or_expr(d);
    d.wc_root = root;
}

// ALTER TABLE tname ADD COLUMN cname TYPE
fn parse_alter_table(d: &mut DB) ~ Console + Process {
    d.stmt_type = 10;
    next_token(d);
    expect_kw(d, "TABLE");
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);
    expect_kw(d, "ADD");
    // COLUMN keyword is optional
    if tk_is_kw(d, "COLUMN") == 1 { next_token(d); }
    let cname = d.tk_val;
    d.alter_col_name = sp_add(d, cname);
    next_token(d);
    let ctype = d.tk_val;
    d.alter_col_type = sp_add(d, ctype);
    next_token(d);
}

// Parse and immediately execute a scalar subquery.
// The parser is currently pointing at the SELECT keyword inside "( SELECT ... )".
// We save parser state, run the subquery, restore state, and return the scalar result.
// Parse and execute a scalar subquery found inside a WHERE clause.
// Example: WHERE age > (SELECT AVG(age) FROM users)
//
// Saves all current parser state (input, pos, token, stmt_type, etc.),
// collects the subquery SQL text by scanning tokens until the closing ')',
// executes it via exec_subquery_scalar (which captures stdout), then
// restores the original parser state so the outer query can continue.
//
// Returns: the scalar result string from the subquery.
fn parse_and_exec_subquery(d: &mut DB) -> String ~ Console + Process {
    // Capture the rest of the input from current position up to the matching ')'
    // The SELECT keyword has been recognized but not consumed yet.
    // We need to grab everything from d.pos (which is past SELECT keyword) up to
    // the closing ')'. But tk_val is "SELECT" and pos has advanced past it.
    // We need to collect the full subquery text.
    let sub_start = d.pos;
    // We know tk_val == "SELECT", so the subquery starts a bit before pos.
    // Find the SELECT keyword start: it's pos - 6 (length of "SELECT")
    // Actually, the tokenizer advanced pos past SELECT. Let's find the closing paren.
    let mut depth = 1;
    let mut scan_pos = d.pos;
    let mut sgo = true;
    while sgo {
        if scan_pos >= d.ilen { sgo = false; }
        else {
            let sc = d.input.char_at(scan_pos);
            if sc == "(" { depth = depth + 1; }
            if sc == ")" {
                depth = depth - 1;
                if depth == 0 { sgo = false; }
                else { scan_pos = scan_pos + 1; }
            } else {
                scan_pos = scan_pos + 1;
            }
        }
    }
    // The subquery SQL is "SELECT" + input[sub_start..scan_pos]
    let rest_len = scan_pos - sub_start;
    let rest_part = if rest_len > 0 { d.input.substring(sub_start, rest_len) } else { "" };
    let sub_sql = "SELECT" + rest_part;

    // Advance main parser past the closing ')'
    // Set pos to scan_pos (pointing at ')'), then call next_token to consume it
    d.pos = scan_pos;
    // The ')' will be consumed by the caller via expect_punct

    // Save main parser state
    let save_input = d.input;
    let save_ilen = d.ilen;
    let save_pos = d.pos;
    let save_tk_type = d.tk_type;
    let save_tk_val = d.tk_val;
    let save_stmt_type = d.stmt_type;
    let save_p_table = d.p_table;
    let save_p_cols = d.p_cols;
    let save_p_col_count = d.p_col_count;
    let save_p_types = d.p_types;
    let save_p_vals = d.p_vals;
    let save_p_val_count = d.p_val_count;
    let save_has_where = d.has_where;
    let save_wc_count = d.wc_count;
    let save_wc_left = d.wc_left;
    let save_wc_op = d.wc_op;
    let save_wc_right = d.wc_right;
    let save_wc_neg = d.wc_neg;
    let save_wn_kind = d.wn_kind;
    let save_wn_a = d.wn_a;
    let save_wn_b = d.wn_b;
    let save_wn_count = d.wn_count;
    let save_wc_root = d.wc_root;
    let save_wc_in_start = d.wc_in_start;
    let save_wc_in_len = d.wc_in_len;
    let save_wc_in_pool = d.wc_in_pool;
    let save_has_order = d.has_order;
    let save_order_col = d.order_col;
    let save_order_desc = d.order_desc;
    let save_order_col2 = d.order_col2;
    let save_order_desc2 = d.order_desc2;
    let save_order_agg_func = d.order_agg_func;
    let save_has_limit = d.has_limit;
    let save_limit_val = d.limit_val;
    let save_has_offset = d.has_offset;
    let save_offset_val = d.offset_val;
    let save_set_col = d.set_col;
    let save_set_val = d.set_val;
    let save_select_star = d.select_star;
    let save_p_agg_funcs = d.p_agg_funcs;
    let save_p_agg_cols = d.p_agg_cols;
    let save_p_agg_count = d.p_agg_count;
    let save_has_group_by = d.has_group_by;
    let save_group_col = d.group_col;
    let save_has_join = d.has_join;
    let save_join_table = d.join_table;
    let save_join_left_col = d.join_left_col;
    let save_join_right_col = d.join_right_col;
    let save_alias1 = d.alias1;
    let save_alias2 = d.alias2;
    let save_has_distinct = d.has_distinct;
    let save_has_having = d.has_having;
    let save_having_agg_func = d.having_agg_func;
    let save_having_agg_col = d.having_agg_col;
    let save_having_op = d.having_op;
    let save_having_val = d.having_val;
    let save_p_aliases = d.p_aliases;
    let save_p_agg_distinct = d.p_agg_distinct;

    // Execute the subquery to get a scalar result
    let result = exec_subquery_scalar(d, sub_sql);

    // Restore main parser state
    d.input = save_input;
    d.ilen = save_ilen;
    d.pos = save_pos;
    d.tk_type = save_tk_type;
    d.tk_val = save_tk_val;
    d.stmt_type = save_stmt_type;
    d.p_table = save_p_table;
    d.p_cols = save_p_cols;
    d.p_col_count = save_p_col_count;
    d.p_types = save_p_types;
    d.p_vals = save_p_vals;
    d.p_val_count = save_p_val_count;
    d.has_where = save_has_where;
    d.wc_count = save_wc_count;
    d.wc_left = save_wc_left;
    d.wc_op = save_wc_op;
    d.wc_right = save_wc_right;
    d.wc_neg = save_wc_neg;
    d.wn_kind = save_wn_kind;
    d.wn_a = save_wn_a;
    d.wn_b = save_wn_b;
    d.wn_count = save_wn_count;
    d.wc_root = save_wc_root;
    d.wc_in_start = save_wc_in_start;
    d.wc_in_len = save_wc_in_len;
    d.wc_in_pool = save_wc_in_pool;
    d.has_order = save_has_order;
    d.order_col = save_order_col;
    d.order_desc = save_order_desc;
    d.order_col2 = save_order_col2;
    d.order_desc2 = save_order_desc2;
    d.order_agg_func = save_order_agg_func;
    d.has_limit = save_has_limit;
    d.limit_val = save_limit_val;
    d.has_offset = save_has_offset;
    d.offset_val = save_offset_val;
    d.set_col = save_set_col;
    d.set_val = save_set_val;
    d.select_star = save_select_star;
    d.p_agg_funcs = save_p_agg_funcs;
    d.p_agg_cols = save_p_agg_cols;
    d.p_agg_count = save_p_agg_count;
    d.has_group_by = save_has_group_by;
    d.group_col = save_group_col;
    d.has_join = save_has_join;
    d.join_table = save_join_table;
    d.join_left_col = save_join_left_col;
    d.join_right_col = save_join_right_col;
    d.alias1 = save_alias1;
    d.alias2 = save_alias2;
    d.has_distinct = save_has_distinct;
    d.has_having = save_has_having;
    d.having_agg_func = save_having_agg_func;
    d.having_agg_col = save_having_agg_col;
    d.having_op = save_having_op;
    d.having_val = save_having_val;
    d.p_aliases = save_p_aliases;
    d.p_agg_distinct = save_p_agg_distinct;

    // Advance the token past ')'
    next_token(d);

    result
}

// Execute a subquery and return a single scalar value as a string.
// Handles aggregate queries like SELECT AVG(age) FROM users.
fn exec_subquery_scalar(d: &mut DB, sql: String) -> String ~ Console + Process {
    reset_parser(d, sql);
    parse_sql(d);

    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 { return "0"; }

    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // A subquery cannot abort just itself and let the outer query continue with
    // a correct value, so an unknown WHERE column fails the whole statement.
    if !where_cols_ok(d, cs, cc, tname, d.alias1) { process_exit(1); }
    // Same for an aggregate over an unknown column: without this the aggregate
    // read zero cells and fed 0 into the outer comparison, matching every row.
    if !agg_cols_ok(d, cs, cc, tname, d.alias1) { process_exit(1); }

    // Gather matching rows
    let mut match_rows: Vec<i32> = vec![];
    let mut match_count = 0;
    let mut r = 0;
    while r < rc {
        if eval_compound_where(d, cs, cc, rs, r, tname, d.alias1) {
            vec_push(match_rows, r);
            match_count = match_count + 1;
        }
        r = r + 1;
    }

    // If it is an aggregate query, compute and return the scalar
    if d.p_agg_count > 0 {
        if d.p_col_count == 0 {
            let af = vec_get(d.p_agg_funcs, 0);
            let ac_name = sp_get(d, vec_get(d.p_agg_cols, 0));
            if af == 1 {
                // COUNT(*)
                let cstr = int_to_str(match_count);
                vec_push(d.subq_vals, sp_add(d, cstr));
                d.subq_count = 1;
                return cstr;
            }
            // SUM/AVG/MIN/MAX
            let col_idx = resolve_col(d, cs, cc, tname, d.alias1, ac_name);
            let ct = if col_idx >= 0 { vec_get(d.col_types, cs + col_idx) } else { 0 };
            let mut sum_val = 0.0;
            let mut min_val = 999999999.0;
            let mut max_val = 0.0 - 999999999.0;
            // MIN/MAX on a TEXT column (type 2) order lexicographically via
            // compare_vals; parse_float coerces text to 0 and collapses them.
            let mut min_str = "";
            let mut max_str = "";
            let mut cnt = 0;
            let mut mi = 0;
            while mi < match_count {
                let row = vec_get(match_rows, mi);
                if col_idx >= 0 {
                    let cell_str = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
                    if !is_null(cell_str) {
                    let nv = cell_str.parse_float();
                    sum_val = sum_val + nv;
                    if cnt == 0 || nv < min_val { min_val = nv; }
                    if cnt == 0 || nv > max_val { max_val = nv; }
                    if ct == 2 {
                        if cnt == 0 { min_str = cell_str; max_str = cell_str; }
                        else {
                            if compare_vals(cell_str, min_str, ct) < 0 { min_str = cell_str; }
                            if compare_vals(cell_str, max_str, ct) > 0 { max_str = cell_str; }
                        }
                    }
                    cnt = cnt + 1;
                    }
                }
                mi = mi + 1;
            }
            let mut result_val = sum_val;
            if af == 3 {
                if cnt > 0 { result_val = sum_val / (cnt as f64); }
                else { result_val = 0.0; }
            }
            if af == 4 { result_val = min_val; }
            if af == 5 { result_val = max_val; }
            let mut rstr = float_to_str(result_val);
            if ct == 2 && af == 4 { rstr = min_str; }
            if ct == 2 && af == 5 { rstr = max_str; }
            // SUM/AVG/MIN/MAX over no non-NULL value are NULL.
            if cnt == 0 { rstr = nullv(); }
            vec_push(d.subq_vals, sp_add(d, rstr));
            d.subq_count = 1;
            return rstr;
        }
    }

    // Non-aggregate: collect the first result column across every matching row
    // into d.subq_vals (so IN (SELECT ...) sees the whole set), and return the
    // first value as the scalar contract.
    let mut result_col = 0 - 1;
    if d.p_col_count > 0 {
        let cname = sp_get(d, vec_get(d.p_cols, 0));
        result_col = resolve_col(d, cs, cc, tname, d.alias1, cname);
    } else if d.select_star == 1 {
        result_col = 0;
    }
    if result_col >= 0 {
        let mut mi = 0;
        while mi < match_count {
            let row = vec_get(match_rows, mi);
            let cid = vec_get(d.cells, rs + row * cc + result_col);
            vec_push(d.subq_vals, cid);
            d.subq_count = d.subq_count + 1;
            mi = mi + 1;
        }
    }
    if d.subq_count > 0 {
        return sp_get(d, vec_get(d.subq_vals, 0));
    }
    "0"
}

fn parse_order_by(d: &mut DB) ~ Console + Process {
    next_token(d);
    expect_kw(d, "BY");
    d.has_order = 1;
    // Primary key may be a plain column or an aggregate term (COUNT(*),
    // SUM(col), ...). An aggregate key is matched against an aggregate output
    // column in the grouped-select path; order_agg_func records which.
    let ag = is_agg_kw(d.tk_val);
    if ag > 0 {
        next_token(d);
        expect_punct(d, "(");
        if d.tk_type == 6 {
            let ostar_id = sp_add(d, "*");
            d.order_col = ostar_id;
            next_token(d);
        } else {
            let oagg_name = read_col_ref(d);
            d.order_col = sp_add(d, oagg_name);
        }
        expect_punct(d, ")");
        d.order_agg_func = ag;
    } else {
        // read_col_ref captures a dotted "table.col" ref whole; a bare column
        // reads as just the name. Taking only tk_val here dropped the ".col"
        // half of a qualified key (e.g. ORDER BY emp.name kept "emp"), which
        // the join sort needs to resolve the column.
        let cname = read_col_ref(d);
        d.order_col = sp_add(d, cname);
        d.order_agg_func = 0;
    }
    if tk_is_kw(d, "DESC") == 1 { d.order_desc = 1; next_token(d); }
    else if tk_is_kw(d, "ASC") == 1 { d.order_desc = 0; next_token(d); }
    // Optional secondary key: ORDER BY a, b [ASC|DESC]. It breaks ties on the
    // primary key. A third comma-key is not stored (honest limitation). The
    // secondary key may itself be an aggregate term (ORDER BY x, SUM(col)); read
    // the whole term, parentheses included, so no '(col)' tail is left for the
    // end-of-input check to trip on. A secondary aggregate is reachable only on
    // the grouped paths, which reject a secondary key outright, so recording the
    // inner column name is enough to mark that a secondary key is present.
    if tk_is_punct(d, ",") == 1 {
        next_token(d);
        let ag2 = is_agg_kw(d.tk_val);
        if ag2 > 0 {
            next_token(d);
            expect_punct(d, "(");
            if d.tk_type == 6 {
                let ostar2 = sp_add(d, "*");
                d.order_col2 = ostar2;
                next_token(d);
            } else {
                let oagg2 = read_col_ref(d);
                d.order_col2 = sp_add(d, oagg2);
            }
            expect_punct(d, ")");
        } else {
            let cname2 = read_col_ref(d);
            d.order_col2 = sp_add(d, cname2);
        }
        if tk_is_kw(d, "DESC") == 1 { d.order_desc2 = 1; next_token(d); }
        else if tk_is_kw(d, "ASC") == 1 { d.order_desc2 = 0; next_token(d); }
    }
}

fn parse_limit(d: &mut DB) {
    next_token(d);
    d.has_limit = 1;
    let val = d.tk_val;
    d.limit_val = parse_int_str(val);
    next_token(d);
}

fn parse_offset(d: &mut DB) {
    next_token(d);
    d.has_offset = 1;
    let val = d.tk_val;
    d.offset_val = parse_int_str(val);
    next_token(d);
}

fn parse_int_str(s: String) -> i32 {
    let slen = s.len();
    let mut num = 0;
    let mut neg = false;
    let mut i = 0;
    if slen > 0 {
        let first = s.char_at(0);
        if first == "-" { neg = true; i = 1; }
    }
    while i < slen {
        let ch = s.char_at(i);
        if ch == "0" { num = num * 10; }
        else if ch == "1" { num = num * 10 + 1; }
        else if ch == "2" { num = num * 10 + 2; }
        else if ch == "3" { num = num * 10 + 3; }
        else if ch == "4" { num = num * 10 + 4; }
        else if ch == "5" { num = num * 10 + 5; }
        else if ch == "6" { num = num * 10 + 6; }
        else if ch == "7" { num = num * 10 + 7; }
        else if ch == "8" { num = num * 10 + 8; }
        else if ch == "9" { num = num * 10 + 9; }
        i = i + 1;
    }
    if neg { 0 - num } else { num }
}

// Resolve an ORDER BY key to a table column index in [0, cc), or -1 when it
// resolves to nothing. Three key forms are accepted so the non-grouped
// single-table SELECT path can fail closed instead of silently returning
// discovery order on an unresolvable key:
//   (a) a column name, bare or dotted (table.col)  -> resolve_col
//   (b) a positional ordinal (ORDER BY 2, SQL-92)  -> the Nth output column
//   (c) a projection alias (SELECT salary AS s ... ORDER BY s)
// A positional ordinal or alias only resolves when the referenced select item
// is a plain table column; one that points at an aggregate returns -1, since
// this path never sorts by an aggregate value.
fn resolve_order_key(d: &DB, cs: i32, cc: i32, tname: String, key_id: i32) -> i32 {
    let key = sp_get(d, key_id);
    // (b) positional ordinal: a bare integer is the 1-based select-list slot.
    if is_int_str(key) {
        let n = parse_int_str(key);
        if n < 1 { return 0 - 1; }
        if d.select_star == 1 {
            // SELECT * projects every table column in order, so slot N is
            // table column N-1.
            if n <= cc { return n - 1; }
            return 0 - 1;
        }
        if n <= d.p_agg_count {
            let k = n - 1;
            if vec_get(d.p_agg_funcs, k) == 0 {
                let col_name = sp_get(d, vec_get(d.p_agg_cols, k));
                return resolve_col(d, cs, cc, tname, d.alias1, col_name);
            }
        }
        return 0 - 1;
    }
    // (a) a real column name (dotted or bare) takes precedence over an alias.
    let direct = resolve_col(d, cs, cc, tname, d.alias1, key);
    if direct >= 0 { return direct; }
    // (c) projection alias -> its underlying plain column.
    if d.select_star == 0 {
        let mut k = 0;
        while k < d.p_agg_count {
            let al = vec_get(d.p_aliases, k);
            if al >= 0 {
                if sp_get(d, al) == key {
                    if vec_get(d.p_agg_funcs, k) == 0 {
                        let col_name = sp_get(d, vec_get(d.p_agg_cols, k));
                        return resolve_col(d, cs, cc, tname, d.alias1, col_name);
                    }
                }
            }
            k = k + 1;
        }
    }
    0 - 1
}

// =========================================================================
// SECTION 6: EXECUTOR — Query Execution Engine
// =========================================================================
// Executes parsed SQL statements against the in-memory database.
// All exec_* functions read from the parser state fields (d.p_table,
// d.p_cols, d.has_where, etc.) and modify the data arrays (d.cells,
// d.tbl_row_counts, etc.) as needed.
//
// Subsections:
//   6a: DDL — exec_create (CREATE TABLE), exec_drop, exec_alter_table
//   6b: DML — exec_insert, exec_update, exec_delete
//   6c: SELECT — exec_select (basic single-table, dispatches to 6d/6e/6f)
//   6d: Aggregates without GROUP BY — exec_select_agg_no_group
//   6e: GROUP BY — exec_select_group
//   6f: JOIN — exec_select_join
// =========================================================================

// --- 6a: DDL Execution ---

// Execute CREATE TABLE. Adds a new table entry to the parallel arrays.
// Fails if a table with the same name already exists.
fn exec_create(d: &mut DB) ~ Console {
    d.schema_ver = d.schema_ver + 1;
    let tname = sp_get(d, d.p_table);
    let existing = find_table(d, tname);
    if existing >= 0 {
        d.stmt_failed = true;
        println!("Error: table '{}' already exists", tname);
        return;
    }
    // Constraint columns must name columns of this table (checked first).
    let mut cidx: Vec<i32> = vec![];
    let mut k = 0;
    while k < vec_len(d.p_con_names) {
        let nm = sp_get(d, vec_get(d.p_con_names, k));
        let mut found = -1;
        let mut j = 0;
        while j < d.p_col_count {
            if sp_get(d, vec_get(d.p_cols, j)) == nm { found = j; }
            j = j + 1;
        }
        if found < 0 {
            d.stmt_failed = true;
            println!("Error: no such column: {}", nm);
            return;
        }
        vec_push(cidx, found);
        k = k + 1;
    }
    k = 0;
    while k < vec_len(d.p_con_kind) {
        vec_push(d.con_tbl, d.tbl_count);
        vec_push(d.con_kind, vec_get(d.p_con_kind, k));
        vec_push(d.con_cs, vec_len(d.con_cols));
        let n = vec_get(d.p_con_cn, k);
        vec_push(d.con_cn, n);
        let st = vec_get(d.p_con_cs, k);
        let mut j = 0;
        while j < n { vec_push(d.con_cols, vec_get(cidx, st + j)); j = j + 1; }
        k = k + 1;
    }
    let tid = sp_add(d, tname);
    vec_push(d.tbl_names, tid);
    let col_start = vec_len(d.col_names);
    vec_push(d.tbl_col_starts, col_start);
    vec_push(d.tbl_col_counts, d.p_col_count);
    vec_push(d.tbl_row_starts, vec_len(d.cells));
    vec_push(d.tbl_row_counts, 0);
    // Add columns
    let mut i = 0;
    while i < d.p_col_count {
        let cname = sp_get(d, vec_get(d.p_cols, i));
        let cnid = sp_add(d, cname);
        vec_push(d.col_names, cnid);
        let type_str = sp_get(d, vec_get(d.p_types, i));
        let type_up = type_str.to_uppercase();
        let ct = type_code_for(type_up);
        vec_push(d.col_types, ct);
        i = i + 1;
    }
    d.tbl_count = d.tbl_count + 1;
}

// --- 6b: DML Execution ---

// Execute INSERT INTO. Inserts a new row into the target table.
// Values are read from d.p_vals. The row is inserted at the correct
// position in the flat cells array (after existing rows for this table),
// and subsequent tables' row starts are shifted. Indexes are rebuilt.
fn exec_insert(d: &mut DB) ~ Console + Process {
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        d.stmt_failed = true;
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cc = vec_get(d.tbl_col_counts, tidx);
    let cs = vec_get(d.tbl_col_starts, tidx);

    // Values per row: the named-column count when a column list was given,
    // otherwise the table's full column count. p_row_count tuples were parsed.
    let vpr = if d.p_col_count > 0 { d.p_col_count } else { cc };
    if d.xq_root >= 0 {
        // INSERT ... SELECT (P22): the query's rows become the value tuples.
        let none: Vec<i32> = vec![];
        let got = xq_run(d, d.xq_root, none, 0, -1);
        let ncol = d.x_ncol;
        if ncol != vpr {
            d.stmt_failed = true;
            println!("Error: table {} has {} columns but {} values were supplied", tname, vpr, ncol);
            return;
        }
        let nv = vec_len(got);
        if nv == 0 { return; }
        d.p_vals = got;
        d.p_val_count = nv;
        d.p_row_count = nv / ncol;
    }
    let nrows = d.p_row_count;
    if nrows < 1 {
        d.stmt_failed = true;
        println!("Error: INSERT has no values");
        return;
    }
    if d.p_val_count != vpr * nrows {
        d.stmt_failed = true;
        println!("Error: expected {} values, got {}", vpr * nrows, d.p_val_count);
        return;
    }

    // For a named-column INSERT, map each table column to the value slot that
    // fills it (src_for_col[c] = slot, or -1 to insert SQL NULL). Validate the
    // named columns exist before writing anything.
    let mut src_for_col: Vec<i32> = vec![];
    if d.p_col_count > 0 {
        let mut jv = 0;
        while jv < d.p_col_count {
            let jn = sp_get(d, vec_get(d.p_cols, jv));
            if find_col(d, cs, cc, jn) < 0 {
                d.stmt_failed = true;
                println!("Error: no such column: {}", jn);
                return;
            }
            jv = jv + 1;
        }
        let mut c = 0;
        while c < cc {
            let cn = sp_get(d, vec_get(d.col_names, cs + c));
            let mut found = 0 - 1;
            let mut j = 0;
            while j < d.p_col_count {
                let jn = sp_get(d, vec_get(d.p_cols, j));
                if jn == cn { found = j; }
                j = j + 1;
            }
            vec_push(src_for_col, found);
            c = c + 1;
        }
    }

    // Materialize every new row in table-column order into row_cells.
    let mut row_cells: Vec<i32> = vec![];
    let mut r = 0;
    while r < nrows {
        let mut c2 = 0;
        while c2 < cc {
            let mut cell_id = 0;
            if d.p_col_count > 0 {
                let src = vec_get(src_for_col, c2);
                if src < 0 { cell_id = sp_add(d, nullv()); }
                else { cell_id = vec_get(d.p_vals, r * vpr + src); }
            } else {
                cell_id = vec_get(d.p_vals, r * cc + c2);
            }
            vec_push(row_cells, cell_id);
            c2 = c2 + 1;
        }
        r = r + 1;
    }

    let mut row_cells = row_cells;
    let mut nrows = nrows;
    if d.ins_replace {
        let kept = replace_prepare(d, tidx, row_cells, nrows);
        if d.stmt_failed { return; }
        row_cells = kept;
        nrows = vec_len(kept) / cc;
    }

    // Constraints (P13), before any cell changes.
    let err = con_check_insert(d, tidx, row_cells, nrows);
    if err.len() > 0 {
        d.stmt_failed = true;
        println!("Error: {}", err);
        return;
    }

    // Splice row_cells into the flat cells array after this table's rows.
    // When this table's rows end the array (the last table, the common load
    // case) the new cells are appended in place, O(row). Otherwise the array
    // is rebuilt around the insertion point, O(all cells), as before.
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);
    let insert_at = rs + rc * cc;
    let added = nrows * cc;
    let total_cells = vec_len(d.cells);
    if insert_at == total_cells {
        let mut ai = 0;
        while ai < added {
            vec_push(d.cells, vec_get(row_cells, ai));
            ai = ai + 1;
        }
    } else {
        let mut new_cells: Vec<i32> = vec![];
        let mut ci: i64 = 0;
        while ci < insert_at {
            vec_push(new_cells, vec_get(d.cells, ci));
            ci = ci + 1;
        }
        let mut wi = 0;
        while wi < added {
            vec_push(new_cells, vec_get(row_cells, wi));
            wi = wi + 1;
        }
        while ci < total_cells {
            vec_push(new_cells, vec_get(d.cells, ci));
            ci = ci + 1;
        }
        d.cells = new_cells;
    }

    // Update row count for this table (all nrows added).
    let mut new_rc: Vec<i32> = vec![];
    let mut ri = 0;
    while ri < d.tbl_count {
        if ri == tidx { vec_push(new_rc, rc + nrows); }
        else { vec_push(new_rc, vec_get(d.tbl_row_counts, ri)); }
        ri = ri + 1;
    }
    d.tbl_row_counts = new_rc;

    // Shift row_starts for tables after this one by the cells we inserted.
    let mut new_rs: Vec<i32> = vec![];
    let mut si = 0;
    while si < d.tbl_count {
        if si > tidx {
            vec_push(new_rs, vec_get(d.tbl_row_starts, si) + added);
        } else {
            vec_push(new_rs, vec_get(d.tbl_row_starts, si));
        }
        si = si + 1;
    }
    d.tbl_row_starts = new_rs;

    // Indexes need no work here. The new rows carry the highest row ids, so
    // an index whose key count is below the table's row count is behind by
    // exactly those rows, and refresh_index folds them in on the next read.
}

// Resolve a column reference: could be "col", "table.col", or "alias.col"
// Returns the column index within the given table, or -1
fn resolve_col(d: &DB, cs: i32, cc: i32, tname: String, alias: i32, ref_str: String) -> i32 {
    let dot_pos = ref_str.index_of(".");
    if dot_pos > 0 {
        // Dotted: prefix.colname
        let prefix = ref_str.substring(0, dot_pos);
        let col_part = ref_str.substring(dot_pos + 1, ref_str.len() - dot_pos - 1);
        let alias_str = if alias >= 0 { sp_get(d, alias) } else { "" };
        if prefix == tname || prefix == alias_str {
            return find_col(d, cs, cc, col_part);
        }
        return 0 - 1;
    }
    find_col(d, cs, cc, ref_str)
}

// Fail closed when a WHERE clause names a column the target table does not
// have. Every leaf condition stores its left side as a column ref (see
// parse_condition -> read_col_ref), and resolve_col returns -1 for a ref that
// matches no column. Every single-table WHERE path below evaluated such a leaf
// as false, so `WHERE nosuchcol = 5` returned an empty result and
// `WHERE nosuchcol IS NULL` returned every row, both silent wrong answers.
// Validating once here, before the row scan, also covers an empty table, where
// no row would ever reach eval_cond_row. resolve_col is reused so a dotted
// table.col or alias.col ref resolves exactly as it does during evaluation.
// Returns false after printing the diagnostic; the caller aborts the statement.
fn where_cols_ok(d: &DB, cs: i32, cc: i32, tname: String, alias: i32) -> bool ~ Console {
    if d.has_where == 0 { return true; }
    let mut ci = 0;
    while ci < d.wc_count {
        let wl = sp_get(d, vec_get(d.wc_left, ci));
        if resolve_col(d, cs, cc, tname, alias, wl) < 0 {
            println!("Error: no such column: {}", wl);
            return false;
        }
        ci = ci + 1;
    }
    true
}

// Fail closed when an aggregate names a column the target table does not have.
// The projection's aggregate args live in p_agg_cols, parallel to p_agg_funcs;
// a plain column has func 0 (validated elsewhere) and COUNT(*) stores "*". For
// any real aggregate (func > 0) over a named column, resolve_col returns -1 for
// a name no column matches, and every compute site then read zero matching
// cells: SUM/AVG/COUNT(col) returned 0, MIN/MAX returned empty, a grouped
// aggregate returned 0 per group, and a scalar subquery fed 0 into the outer
// comparison, all silent wrong answers (SQLite errors "no such column"). A
// HAVING aggregate arg is checked the same way. Validating once here, before
// the scan, also covers an empty table. resolve_col is reused so a dotted or
// alias-qualified arg resolves exactly as it does during evaluation. Plain
// SELECT columns are out of scope: they keep their own "column not found" path.
fn agg_cols_ok(d: &DB, cs: i32, cc: i32, tname: String, alias: i32) -> bool ~ Console {
    let mut k = 0;
    while k < d.p_agg_count {
        if vec_get(d.p_agg_funcs, k) > 0 {
            let an = sp_get(d, vec_get(d.p_agg_cols, k));
            let is_star = an == "*";
            if !is_star {
                if resolve_col(d, cs, cc, tname, alias, an) < 0 {
                    println!("Error: no such column: {}", an);
                    return false;
                }
            }
        }
        k = k + 1;
    }
    if d.has_having == 1 {
        if d.having_agg_func > 0 {
            if d.having_agg_col >= 0 {
                let hn = sp_get(d, d.having_agg_col);
                let h_star = hn == "*";
                if !h_star {
                    if resolve_col(d, cs, cc, tname, alias, hn) < 0 {
                        println!("Error: no such column: {}", hn);
                        return false;
                    }
                }
            }
        }
    }
    true
}

// True if cell_val is in condition ci's IN-list (its slice of wc_in_pool).
// x IN (list): true if x equals a list value; unknown if x is NULL, or if no
// value matches and the list holds a NULL; false otherwise.
fn eval_in_pool(d: &DB, cell_val: String, start: i32, len: i32) -> i32 {
    if is_null(cell_val) { return 2; }
    let mut saw_null = false;
    let mut i = 0;
    while i < len {
        let v = sp_get(d, vec_get(d.wc_in_pool, start + i));
        if is_null(v) { saw_null = true; }
        else if cell_val == v { return 1; }
        i = i + 1;
    }
    if saw_null { return 2; }
    0
}

// Evaluate condition ci's operator against an already-resolved cell value.
// op 7 = IN (against the condition's wc_in_pool slice); all other ops go
// through eval_where. Negation is applied by the caller.
// Returns 0 false, 1 true, 2 unknown (a NULL operand outside IS [NOT] NULL).
fn eval_cond_val(d: &DB, ci: i32, op: i32, cv: String) -> i32 {
    if op == 8 { if is_null(cv) { return 1; } return 0; }
    if op == 9 { if is_null(cv) { return 0; } return 1; }
    if op == 7 {
        return eval_in_pool(d, cv, vec_get(d.wc_in_start, ci), vec_get(d.wc_in_len, ci));
    }
    let wr = sp_get(d, vec_get(d.wc_right, ci));
    if is_null(cv) || is_null(wr) { return 2; }
    if eval_where(cv, op, wr) { return 1; }
    0
}

// Evaluate DNF condition ci for a single-table row, applying its negate flag.
fn eval_cond_row(d: &DB, ci: i32, cs: i32, cc: i32, rs: i32, row: i32,
                 tname: String, alias: i32) -> i32 {
    let wl = sp_get(d, vec_get(d.wc_left, ci));
    let wcol = resolve_col(d, cs, cc, tname, alias, wl);
    let op = vec_get(d.wc_op, ci);
    let mut res = 0;
    if wcol >= 0 {
        let cv = sp_get(d, vec_get(d.cells, rs + row * cc + wcol));
        res = eval_cond_val(d, ci, op, cv);
    } else {
        // Column not found (where_cols_ok refuses these before a scan).
        if op == 8 { res = 1; }
    }
    if vec_get(d.wc_neg, ci) == 1 { res = not3(res); }
    res
}

// Recursively evaluate the WHERE boolean-expression tree for a single-table
// row. node < 0 means "no predicate" (true). Leaf (kind 0) evaluates its
// condition via eval_cond_row; NOT (3) negates its one child; AND (1) / OR (2)
// combine both children.
fn eval_where_tree(d: &DB, node: i32, cs: i32, cc: i32, rs: i32, row: i32,
                   tname: String, alias: i32) -> i32 {
    if node < 0 { return 1; }
    let k = vec_get(d.wn_kind, node);
    if k == 0 {
        return eval_cond_row(d, vec_get(d.wn_a, node), cs, cc, rs, row, tname, alias);
    }
    if k == 3 {
        return not3(eval_where_tree(d, vec_get(d.wn_a, node), cs, cc, rs, row, tname, alias));
    }
    let la = eval_where_tree(d, vec_get(d.wn_a, node), cs, cc, rs, row, tname, alias);
    let rb = eval_where_tree(d, vec_get(d.wn_b, node), cs, cc, rs, row, tname, alias);
    if k == 1 { return and3(la, rb); }
    if k == 2 { return or3(la, rb); }
    1
}

// Evaluate the full WHERE clause for a single-table row by walking the
// boolean-expression tree from wc_root. has_where==0 or an empty tree means no
// filter. AND/OR/NOT and parenthesized grouping are all exact.
fn eval_compound_where(d: &DB, cs: i32, cc: i32, rs: i32, row: i32,
                       tname: String, alias: i32) -> bool {
    if d.has_where == 0 { return true; }
    if d.wc_count == 0 { return true; }
    // A row passes only when the condition is true; unknown drops it.
    eval_where_tree(d, d.wc_root, cs, cc, rs, row, tname, alias) == 1
}

fn check_has_agg(d: &DB) -> i32 {
    let mut k = 0;
    while k < d.p_agg_count {
        if vec_get(d.p_agg_funcs, k) > 0 { return 1; }
        k = k + 1;
    }
    0
}

// --- 6c: SELECT — Single-Table Query ---

// Execute a SELECT query. This is the main SELECT dispatcher.
//
// Reads parsed state: d.p_table, d.select_star, d.p_cols, d.p_agg_funcs,
//   d.has_where, d.wc_* (DNF filter conditions), d.has_order / d.order_col /
//   d.order_desc, d.has_limit / d.limit_val, d.has_distinct
//
// Flow:
//   1. Dispatch to exec_select_join if has_join == 1
//   2. Dispatch to exec_select_group if has_group_by == 1
//   3. Handle COUNT(*) shortcut
//   4. Dispatch to exec_select_agg_no_group if aggregates present
//   5. Otherwise: scan all rows, evaluate WHERE for each, collect matches
//   6. Apply ORDER BY via sort_rows() (stable merge sort)
//   7. Apply LIMIT to truncate result set
//   8. Apply DISTINCT to remove duplicates
//   9. Print formatted table output (header + separator + rows)
//
// Calls: eval_compound_where(), sort_rows(), resolve_col(), find_index_for(),
//        index_scan(), sp_get(), pad_right(), make_dashes()
fn exec_select(d: &mut DB) ~ Console + Process {
    // Dispatch to UNION handler. parse_select stops at a trailing UNION
    // keyword, leaving it as the current token; branch 1 is already parsed into
    // d.*, so hand the whole set to the union executor. This must precede the
    // JOIN/GROUP dispatch so a UNION whose first branch joins or groups is
    // rejected by the union path rather than rendered alone.
    if is_compound_kw(d) == 1 { exec_select_union(d); return; }
    // Dispatch to JOIN handler
    if d.has_join == 1 { exec_select_join(d); return; }
    // Dispatch to GROUP BY handler
    if d.has_group_by == 1 { exec_select_group(d); return; }

    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // Reject an unknown WHERE column before any scan. This runs ahead of the
    // aggregate dispatch below, so exec_select_agg_no_group is covered too.
    if !where_cols_ok(d, cs, cc, tname, d.alias1) { return; }
    // Reject an aggregate over an unknown column before the aggregate dispatch,
    // so exec_select_agg_no_group cannot read zero cells and return a silent 0.
    if !agg_cols_ok(d, cs, cc, tname, d.alias1) { return; }

    // Check if we have any aggregate functions (mixed with columns) without GROUP BY
    // Handle aggregates: COUNT, SUM, AVG, MIN, MAX without GROUP BY
    // Aggregate check moved to dispatch:
    // If p_agg_count > 0 and p_col_count == 0, handle as aggregate
    if d.p_agg_count > 0 {
        if d.p_col_count == 0 {
            exec_select_agg_no_group(d, tidx);
            return;
        }
    }

    // Determine which columns to show
    let mut show_cols: Vec<i32> = vec![];
    let mut show_count = 0;
    if d.select_star == 1 {
        let mut ci = 0;
        while ci < cc {
            vec_push(show_cols, ci);
            show_count = show_count + 1;
            ci = ci + 1;
        }
    } else {
        let mut ci = 0;
        while ci < d.p_col_count {
            let cname = sp_get(d, vec_get(d.p_cols, ci));
            let idx = resolve_col(d, cs, cc, tname, d.alias1, cname);
            if idx < 0 {
                println!("Error: column '{}' not found", cname);
                return;
            }
            vec_push(show_cols, idx);
            show_count = show_count + 1;
            ci = ci + 1;
        }
    }

    // Filter rows (with compound WHERE and optional index acceleration)
    let mut match_rows: Vec<i32> = vec![];
    let mut match_count = 0;

    // Try index lookup for a single simple WHERE comparison on an indexed
    // column: the WHERE must be exactly one bare leaf (wc_count==1 AND
    // wn_count==1, so no NOT/AND/OR wrapper), not negated, with a comparison op
    // (0..5 — index_scan does equality by binary search and 1..5 by sorted
    // range). A NOT-wrapped leaf has wn_count>1 and must fall to the full scan,
    // as do LIKE / IN / IS NULL and any multi-condition WHERE.
    let mut used_index = false;
    if d.has_where == 1 {
        if d.wc_count == 1 {
            if d.wn_count == 1 {
                if vec_get(d.wc_neg, 0) == 0 {
                    let op0 = vec_get(d.wc_op, 0);
                    if op0 >= 0 {
                        if op0 <= 5 {
                            let wl = sp_get(d, vec_get(d.wc_left, 0));
                            let wcol = resolve_col(d, cs, cc, tname, d.alias1, wl);
                            if wcol >= 0 {
                                let ix_id = find_index_for(d, tidx, wcol);
                                if ix_id >= 0 {
                                    refresh_index(d, ix_id);
                                    let wr = sp_get(d, vec_get(d.wc_right, 0));
                                    match_rows = index_scan(d, ix_id, op0, wr);
                                    match_count = vec_len(match_rows);
                                    used_index = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if !used_index {
        let mut r = 0;
        while r < rc {
            if eval_compound_where(d, cs, cc, rs, r, tname, d.alias1) {
                vec_push(match_rows, r);
                match_count = match_count + 1;
            }
            r = r + 1;
        }
    }

    // ORDER BY. Resolve each key to a table column and FAIL CLOSED on an
    // unresolvable key rather than silently returning discovery order. A key
    // may be a column name, a positional ordinal, or a projection alias (see
    // resolve_order_key).
    if d.has_order == 1 {
        let ocol_idx = resolve_order_key(d, cs, cc, tname, d.order_col);
        if ocol_idx < 0 {
            println!("Error: ORDER BY must name a column, alias, or select position");
            process_exit(1);
        }
        let ocol_type = vec_get(d.col_types, cs + ocol_idx);
        let mut ocol2_idx = 0 - 1;
        let mut ocol2_type = 0;
        if d.order_col2 >= 0 {
            ocol2_idx = resolve_order_key(d, cs, cc, tname, d.order_col2);
            if ocol2_idx < 0 {
                println!("Error: ORDER BY must name a column, alias, or select position");
                process_exit(1);
            }
            ocol2_type = vec_get(d.col_types, cs + ocol2_idx);
        }
        match_rows = sort_rows(d, match_rows, match_count, rs, cc, ocol_idx, ocol_type, d.order_desc, ocol2_idx, ocol2_type, d.order_desc2);
    }

    // LIMIT / OFFSET
    if d.has_limit == 1 || d.has_offset == 1 {
        let mut off = 0;
        if d.has_offset == 1 { off = d.offset_val; }
        let mut lim = match_count;
        if d.has_limit == 1 { lim = d.limit_val; }
        let mut limited: Vec<i32> = vec![];
        let mut new_count = 0;
        let mut taken = 0;
        let mut li = off;
        let mut lgo = true;
        while lgo {
            if li >= match_count { lgo = false; }
            else if taken >= lim { lgo = false; }
            else {
                vec_push(limited, vec_get(match_rows, li));
                new_count = new_count + 1;
                taken = taken + 1;
                li = li + 1;
            }
        }
        match_rows = limited;
        match_count = new_count;
    }

    // DISTINCT: remove duplicate rows (compare all selected column values)
    if d.has_distinct == 1 {
        let mut deduped: Vec<i32> = vec![];
        let mut dedup_count = 0;
        let mut di = 0;
        let mut drow = 0;
        let mut dkey = "";
        let mut dci = 0;
        let mut dcol_idx = 0;
        let mut dval = "";
        let mut dup_found = false;
        let mut dj = 0;
        let mut erow = 0;
        let mut ekey = "";
        let mut eci = 0;
        let mut ecol_idx = 0;
        let mut eval2 = "";
        while di < match_count {
            drow = vec_get(match_rows, di);
            dkey = "";
            dci = 0;
            while dci < show_count {
                dcol_idx = vec_get(show_cols, dci);
                dval = sp_get(d, vec_get(d.cells, rs + drow * cc + dcol_idx));
                if dci > 0 { dkey = dkey + "|"; }
                dkey = dkey + dval;
                dci = dci + 1;
            }
            dup_found = false;
            dj = 0;
            while dj < dedup_count {
                erow = vec_get(deduped, dj);
                ekey = "";
                eci = 0;
                while eci < show_count {
                    ecol_idx = vec_get(show_cols, eci);
                    eval2 = sp_get(d, vec_get(d.cells, rs + erow * cc + ecol_idx));
                    if eci > 0 { ekey = ekey + "|"; }
                    ekey = ekey + eval2;
                    eci = eci + 1;
                }
                if dkey == ekey { dup_found = true; }
                dj = dj + 1;
            }
            if !dup_found {
                vec_push(deduped, drow);
                dedup_count = dedup_count + 1;
            }
            di = di + 1;
        }
        match_rows = deduped;
        match_count = dedup_count;
    }

    // Build header names (use alias if provided, else column name)
    let mut hdr_names: Vec<i32> = vec![];
    let mut hni = 0;
    let mut hn_col_idx = 0;
    let mut hn_base_hdr = "";
    let mut hn_use_alias = false;
    let mut hn_al = 0;
    let mut hn_hid = 0;
    while hni < show_count {
        hn_col_idx = vec_get(show_cols, hni);
        hn_base_hdr = sp_get(d, vec_get(d.col_names, cs + hn_col_idx));
        hn_use_alias = false;
        if d.select_star == 0 {
            if hni < d.p_agg_count {
                hn_al = vec_get(d.p_aliases, hni);
                if hn_al >= 0 {
                    vec_push(hdr_names, hn_al);
                    hn_use_alias = true;
                }
            }
        }
        if !hn_use_alias {
            hn_hid = sp_add(d, hn_base_hdr);
            vec_push(hdr_names, hn_hid);
        }
        hni = hni + 1;
    }

    // Calculate column widths
    let mut widths: Vec<i32> = vec![];
    let mut wi = 0;
    while wi < show_count {
        let col_idx = vec_get(show_cols, wi);
        let hdr = sp_get(d, vec_get(hdr_names, wi));
        let mut w = hdr.len();
        let mut ri = 0;
        while ri < match_count {
            let row = vec_get(match_rows, ri);
            let val = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
            let vlen = dlen(val);
            if vlen > w { w = vlen; }
            ri = ri + 1;
        }
        vec_push(widths, w);
        wi = wi + 1;
    }

    // Print header
    let mut hdr_line = "";
    let mut sep_line = "";
    let mut hi = 0;
    while hi < show_count {
        if hi > 0 { hdr_line = hdr_line + " | "; sep_line = sep_line + "-+-"; }
        let hdr = sp_get(d, vec_get(hdr_names, hi));
        rows_hdr(d, hdr);
        let w = vec_get(widths, hi);
        hdr_line = hdr_line + pad_right(hdr, w);
        sep_line = sep_line + make_dashes(w);
        hi = hi + 1;
    }
    emit_line(d, hdr_line);
    emit_line(d, sep_line);

    // Print rows
    let mut ri = 0;
    while ri < match_count {
        let row = vec_get(match_rows, ri);
        let mut row_line = "";
        let mut ci = 0;
        while ci < show_count {
            if ci > 0 { row_line = row_line + " | "; }
            let col_idx = vec_get(show_cols, ci);
            let val = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
            rows_cell(d, val);
            let w = vec_get(widths, ci);
            let col_type = vec_get(d.col_types, cs + col_idx);
            if col_type == 0 || col_type == 1 {
                row_line = row_line + pad_left(val, w);
            } else {
                row_line = row_line + pad_right(val, w);
            }
            ci = ci + 1;
        }
        emit_line(d, row_line);
        ri = ri + 1;
    }
}

// --- 6c-union: SELECT ... UNION [ALL] ... ---

// Index of the union output column whose header matches `name`, or -1. A
// trailing ORDER BY after a UNION names an output column (or its alias); a
// table qualifier (t.col) is stripped before matching, since union headers are
// stored bare.
fn union_header_index(d: &DB, name: String) -> i32 {
    let mut key = name;
    let dot_pos = name.index_of(".");
    if dot_pos > 0 {
        key = name.substring(dot_pos + 1, name.len() - dot_pos - 1);
    }
    let mut i = 0;
    while i < d.union_ncol {
        let h = sp_get(d, vec_get(d.union_headers, i));
        if h == key { return i; }
        i = i + 1;
    }
    0 - 1
}

// Resolve a UNION ORDER BY key to an output column position, or -1 if it names
// no output column. A bare integer is a 1-based positional ordinal (ORDER BY 2)
// -- the canonical way to order a union, since only the first branch's column
// names reach the output headers. Anything else is matched by header name.
fn resolve_union_order_key(d: &DB, key_id: i32) -> i32 {
    let key = sp_get(d, key_id);
    if is_int_str(key) {
        let n = parse_int_str(key);
        if n < 1 { return 0 - 1; }
        if n <= d.union_ncol { return n - 1; }
        return 0 - 1;
    }
    union_header_index(d, key)
}

// Compare two accumulator rows on a primary key, then a secondary on ties.
// Mirrors cmp_rows_2key but addresses the flat union_vals buffer (ncol wide),
// which has no per-table row-start offset.
fn cmp_union_rows(d: &DB, rowa: i32, rowb: i32, ncol: i32, k1: i32, k1_type: i32, desc: i32, k2: i32, k2_type: i32, desc2: i32) -> i64 {
    let va = sp_get(d, vec_get(d.union_vals, rowa * ncol + k1));
    let vb = sp_get(d, vec_get(d.union_vals, rowb * ncol + k1));
    let mut c = compare_vals(va, vb, k1_type);
    if desc == 1 { c = 0 - c; }
    if c < 0 { return c; }
    if c > 0 { return c; }
    if k2 >= 0 {
        let sa = sp_get(d, vec_get(d.union_vals, rowa * ncol + k2));
        let sb = sp_get(d, vec_get(d.union_vals, rowb * ncol + k2));
        let mut c2 = compare_vals(sa, sb, k2_type);
        if desc2 == 1 { c2 = 0 - c2; }
        return c2;
    }
    0
}

// Materialize the currently-parsed SELECT branch into the UNION accumulator.
// Only a basic single-table projection is supported: a branch that joins,
// groups, or aggregates cannot be laid out as flat cells here, so fail closed
// (print an error, emit nothing) rather than silently drop its rows. Returns 0
// on success, 1 on failure (the caller must abort the whole UNION).
fn gather_basic_branch(d: &mut DB) -> i32 ~ Console {
    if d.has_join == 1 {
        println!("Error: UNION does not support a JOIN in a branch");
        return 1;
    }
    if d.has_group_by == 1 {
        println!("Error: UNION does not support GROUP BY in a branch");
        return 1;
    }
    if check_has_agg(d) == 1 {
        println!("Error: UNION does not support aggregate functions in a branch");
        return 1;
    }

    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return 1;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // Columns this branch projects, in output order.
    let mut show_cols: Vec<i32> = vec![];
    let mut show_count = 0;
    if d.select_star == 1 {
        let mut ci = 0;
        while ci < cc {
            vec_push(show_cols, ci);
            show_count = show_count + 1;
            ci = ci + 1;
        }
    } else {
        let mut ci = 0;
        while ci < d.p_col_count {
            let cname = sp_get(d, vec_get(d.p_cols, ci));
            let idx = resolve_col(d, cs, cc, tname, d.alias1, cname);
            if idx < 0 {
                println!("Error: column '{}' not found", cname);
                return 1;
            }
            vec_push(show_cols, idx);
            show_count = show_count + 1;
            ci = ci + 1;
        }
    }

    // The first branch fixes the output shape: column count, header names
    // (alias wins over column name), and per-column type. Later branches must
    // match the column count — UNION pairs columns by position, not by name.
    if d.union_started == 0 {
        d.union_ncol = show_count;
        let mut hi = 0;
        while hi < show_count {
            let col_idx = vec_get(show_cols, hi);
            let mut hid = vec_get(d.col_names, cs + col_idx);
            if d.select_star == 0 {
                let al = vec_get(d.p_aliases, hi);
                if al >= 0 { hid = al; }
            }
            vec_push(d.union_headers, hid);
            vec_push(d.union_coltypes, vec_get(d.col_types, cs + col_idx));
            hi = hi + 1;
        }
        d.union_started = 1;
    } else {
        if show_count != d.union_ncol {
            println!("Error: UNION branches have different column counts");
            return 1;
        }
    }

    // Append each WHERE-matching row's projected cells (as string-pool ids) to
    // the accumulator. Full scan: union branches are small, and correctness
    // matters more than index acceleration here.
    let mut r = 0;
    while r < rc {
        if eval_compound_where(d, cs, cc, rs, r, tname, d.alias1) {
            let mut ci = 0;
            while ci < show_count {
                let col_idx = vec_get(show_cols, ci);
                vec_push(d.union_vals, vec_get(d.cells, rs + r * cc + col_idx));
                ci = ci + 1;
            }
            d.union_rows = d.union_rows + 1;
        }
        r = r + 1;
    }
    0
}

// Execute SELECT ... UNION [ALL] SELECT ... [UNION [ALL] SELECT ...].
//
// Branch 1 is already parsed into d.* (parse_select stopped at the UNION
// keyword). Each branch is validated and materialized into the accumulator by
// gather_basic_branch; then plain UNION removes duplicate rows across the whole
// result (UNION ALL keeps them), a trailing ORDER BY (which binds to the whole
// result and lands in the final branch's order fields) is applied, and the
// result renders once.
//
// Fail-closed limits: ORDER BY / LIMIT / OFFSET are honored only after the
// final branch (a non-final branch carrying them is rejected); LIMIT / OFFSET
// on a union is not supported; every branch must be a basic single-table
// projection with a matching column count.
// Row key of accumulated row r: its cells joined by U+001F, which no cell
// holds, so ('a|b', 'c') and ('a', 'b|c') stay two rows. NULL keys equal.
fn union_row_key(d: &DB, r: i32, ncol: i32) -> String {
    let mut key = "";
    let mut ci = 0;
    while ci < ncol {
        if ci > 0 { key = key + "\x1f"; }
        key = key + sp_get(d, vec_get(d.union_vals, r * ncol + ci));
        ci = ci + 1;
    }
    key
}

// Apply one compound operator to the running result cur (row indices into
// the accumulator) and the branch rows [bs, be). op: 0 UNION ALL, 1 UNION,
// 2 INTERSECT, 3 EXCEPT. UNION ALL keeps a bag; the other three return
// distinct rows, as in SQLite.
fn compound_apply(d: &DB, cur: Vec<i32>, cur_n: i32, op: i32, bs: i32, be: i32, ncol: i32) -> Vec<i32> {
    let mut out: Vec<i32> = vec![];
    if op == 0 {
        let mut i = 0;
        while i < cur_n { vec_push(out, vec_get(cur, i)); i = i + 1; }
        let mut r = bs;
        while r < be { vec_push(out, r); r = r + 1; }
        return out;
    }
    let mut cand: Vec<i32> = vec![];
    let mut cn = 0;
    let mut i = 0;
    while i < cur_n { vec_push(cand, vec_get(cur, i)); cn = cn + 1; i = i + 1; }
    if op == 1 {
        let mut r = bs;
        while r < be { vec_push(cand, r); cn = cn + 1; r = r + 1; }
    }
    let mut seen: Vec<String> = vec![];
    let mut sn = 0;
    let mut ci = 0;
    while ci < cn {
        let row = vec_get(cand, ci);
        let key = union_row_key(d, row, ncol);
        let mut dup = false;
        let mut si = 0;
        while si < sn {
            let sk: String = vec_get(seen, si);
            if sk == key { dup = true; }
            si = si + 1;
        }
        let mut take = !dup;
        if take && op >= 2 {
            let mut inb = false;
            let mut r = bs;
            while r < be {
                if union_row_key(d, r, ncol) == key { inb = true; }
                r = r + 1;
            }
            if op == 2 { take = inb; } else { take = !inb; }
        }
        if !dup {
            vec_push(seen, key);
            sn = sn + 1;
        }
        if take { vec_push(out, row); }
        ci = ci + 1;
    }
    out
}

fn exec_select_union(d: &mut DB) ~ Console + Process {

    // Branch 1 is non-final: a UNION follows it. A per-branch ORDER BY / LIMIT /
    // OFFSET before UNION does not compose here, so reject it.
    if d.has_order == 1 || d.has_limit == 1 || d.has_offset == 1 {
        println!("Error: ORDER BY / LIMIT must follow the final UNION branch");
        return;
    }
    if gather_basic_branch(d) == 1 { return; }
    // The running result, row indices into the accumulator.
    let mut keep: Vec<i32> = vec![];
    let mut keep_count = 0;
    let mut r0 = 0;
    while r0 < d.union_rows { vec_push(keep, r0); keep_count = keep_count + 1; r0 = r0 + 1; }

    let mut go = true;
    while go {
        // Current token is UNION, INTERSECT or EXCEPT. Consume it and an
        // optional ALL (UNION ALL only).
        let mut op = 1;
        if tk_is_kw(d, "INTERSECT") == 1 { op = 2; }
        if tk_is_kw(d, "EXCEPT") == 1 { op = 3; }
        let op_name = d.tk_val;
        next_token(d);
        if tk_is_kw(d, "ALL") == 1 {
            if op != 1 {
                println!("Error: {} ALL is not supported", op_name.to_uppercase());
                return;
            }
            op = 0;
            next_token(d);
        }

        // Parse the next branch. reset_select_fields clears the previous
        // branch's parse without moving the tokenizer or clearing the
        // accumulator.
        reset_select_fields(d);
        if tk_is_kw(d, "SELECT") == 0 {
            println!("Error: expected SELECT after {}, got '{}'", op_name.to_uppercase(), d.tk_val);
            return;
        }
        parse_select(d);

        // This is the final branch iff no further compound operator follows.
        let mut is_final = 0;
        if is_compound_kw(d) == 0 { is_final = 1; }
        if is_final == 1 {
            if d.has_limit == 1 || d.has_offset == 1 {
                println!("Error: LIMIT / OFFSET is not supported on a UNION");
                return;
            }
        } else {
            if d.has_order == 1 || d.has_limit == 1 || d.has_offset == 1 {
                println!("Error: ORDER BY / LIMIT must follow the final UNION branch");
                return;
            }
        }

        let bstart = d.union_rows;
        if gather_basic_branch(d) == 1 { return; }
        keep = compound_apply(d, keep, keep_count, op, bstart, d.union_rows, d.union_ncol);
        keep_count = vec_len(keep);
        if is_final == 1 { go = false; }
    }

    let ncol = d.union_ncol;

    // Trailing ORDER BY binds to the whole result. Resolve each key to an output
    // column (by ordinal or header name) and FAIL CLOSED on an unresolvable key
    // rather than silently returning accumulation order.
    if d.has_order == 1 {
        let k1 = resolve_union_order_key(d, d.order_col);
        if k1 < 0 {
            println!("Error: ORDER BY must name an output column or a select position");
            return;
        }
        let k1_type = vec_get(d.union_coltypes, k1);
        let mut k2 = 0 - 1;
        if d.order_col2 >= 0 {
            k2 = resolve_union_order_key(d, d.order_col2);
            if k2 < 0 {
                println!("Error: ORDER BY must name an output column or a select position");
                return;
            }
        }
        let mut k2_type = 0;
        if k2 >= 0 { k2_type = vec_get(d.union_coltypes, k2); }

        // Stable selection sort into a new order (mirrors sort_rows): pick the
        // leftmost minimum among unplaced rows each pass, so equal keys keep
        // their pre-sort order.
        let mut used: Vec<i32> = vec![];
        let mut ui = 0;
        while ui < keep_count { vec_push(used, 0); ui = ui + 1; }
        let mut sorted: Vec<i32> = vec![];
        let mut picked = 0;
        while picked < keep_count {
            let mut best = 0 - 1;
            let mut j = 0;
            while j < keep_count {
                if vec_get(used, j) == 0 {
                    if best < 0 {
                        best = j;
                    } else {
                        let cand = vec_get(keep, j);
                        let bestrow = vec_get(keep, best);
                        let c = cmp_union_rows(d, cand, bestrow, ncol, k1, k1_type, d.order_desc, k2, k2_type, d.order_desc2);
                        if c < 0 { best = j; }
                    }
                }
                j = j + 1;
            }
            let mut new_used: Vec<i32> = vec![];
            let mut k = 0;
            while k < keep_count {
                if k == best { vec_push(new_used, 1); }
                else { vec_push(new_used, vec_get(used, k)); }
                k = k + 1;
            }
            used = new_used;
            vec_push(sorted, vec_get(keep, best));
            picked = picked + 1;
        }
        keep = sorted;
    }

    // Column widths across headers + surviving rows.
    let mut widths: Vec<i32> = vec![];
    let mut wi = 0;
    while wi < ncol {
        let hdr = sp_get(d, vec_get(d.union_headers, wi));
        let mut w = hdr.len();
        let mut wri = 0;
        while wri < keep_count {
            let rr = vec_get(keep, wri);
            let val = sp_get(d, vec_get(d.union_vals, rr * ncol + wi));
            let vlen = dlen(val);
            if vlen > w { w = vlen; }
            wri = wri + 1;
        }
        vec_push(widths, w);
        wi = wi + 1;
    }

    // Header + separator.
    let mut hdr_line = "";
    let mut sep_line = "";
    let mut hi = 0;
    while hi < ncol {
        if hi > 0 { hdr_line = hdr_line + " | "; sep_line = sep_line + "-+-"; }
        let hdr = sp_get(d, vec_get(d.union_headers, hi));
        rows_hdr(d, hdr);
        let w = vec_get(widths, hi);
        hdr_line = hdr_line + pad_right(hdr, w);
        sep_line = sep_line + make_dashes(w);
        hi = hi + 1;
    }
    emit_line(d, hdr_line);
    emit_line(d, sep_line);

    // Rows.
    let mut ri = 0;
    while ri < keep_count {
        let rr = vec_get(keep, ri);
        let mut row_line = "";
        let mut ci = 0;
        while ci < ncol {
            if ci > 0 { row_line = row_line + " | "; }
            let val = sp_get(d, vec_get(d.union_vals, rr * ncol + ci));
            rows_cell(d, val);
            let w = vec_get(widths, ci);
            let ct = vec_get(d.union_coltypes, ci);
            if ct == 0 || ct == 1 {
                row_line = row_line + pad_left(val, w);
            } else {
                row_line = row_line + pad_right(val, w);
            }
            ci = ci + 1;
        }
        emit_line(d, row_line);
        ri = ri + 1;
    }
}

// --- 6d: SELECT with Aggregates (no GROUP BY) ---

// Execute a SELECT with aggregate functions but no GROUP BY clause.
// Example: SELECT COUNT(*), AVG(salary) FROM employees WHERE dept = 'eng'
//
// Flow:
//   1. Filter rows by WHERE into match_rows
//   2. For each aggregate in d.p_agg_funcs, compute the result over match_rows
//   3. Print a single result row with computed values
//
// Calls: eval_compound_where(), compute_single_agg(), build_agg_header(),
//        print_result_row()
fn exec_select_agg_no_group(d: &mut DB, tidx: i32) ~ Console {
    let tname = sp_get(d, d.p_table);
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);
    let agg_count = d.p_agg_count;
    let alias_val = d.alias1;

    // Declare everything before any vec!/while to avoid compiler codegen bugs
    let mut match_rows: Vec<i32> = vec![];
    let mut results: Vec<i32> = vec![];
    let mut headers: Vec<i32> = vec![];
    let mut match_count = 0;
    let mut r = 0;
    let mut af = 0;
    let mut ac_name_id = 0;
    let mut al_id = 0;
    let mut dist_r = 0;
    let mut vid = 0;
    let mut hid = 0;

    // Single while loop: gather rows, then compute aggs, all sequential in one loop scope
    // Phase 1: gather matching rows
    while r < rc {
        if eval_compound_where(d, cs, cc, rs, r, tname, alias_val) {
            vec_push(match_rows, r);
            match_count = match_count + 1;
        }
        r = r + 1;
    }

    // Phase 2: compute aggregates (second while in same function - compile workaround)
    // Use the agg_count as upper bound for a combined counter
    r = 0;
    while r < agg_count {
        af = vec_get(d.p_agg_funcs, r);
        ac_name_id = vec_get(d.p_agg_cols, r);
        al_id = if r < vec_len(d.p_aliases) { vec_get(d.p_aliases, r) } else { 0 - 1 };
        dist_r = if r < vec_len(d.p_agg_distinct) { vec_get(d.p_agg_distinct, r) } else { 0 };
        vid = compute_single_agg(d, af, ac_name_id, cs, cc, rs, tname, alias_val, match_rows, match_count, dist_r);
        vec_push(results, vid);
        hid = build_agg_header(d, af, ac_name_id, al_id, dist_r);
        vec_push(headers, hid);
        r = r + 1;
    }
    print_result_row(d, headers, results, agg_count);
}

// Compute a single aggregate value, returning its pool id
fn compute_single_agg(d: &mut DB, af: i32, ac_name_id: i32, cs: i32, cc: i32,
                       rs: i32, tname: String, alias_val: i32,
                       match_rows: Vec<i32>, match_count: i32, distinct: i32) -> i32 {
    let ac_name = sp_get(d, ac_name_id);
    if af == 0 {
        // Plain column: first row value
        let col_idx = resolve_col(d, cs, cc, tname, alias_val, ac_name);
        let mut val = "";
        if match_count > 0 {
            let row = vec_get(match_rows, 0);
            if col_idx >= 0 {
                val = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
            }
        }
        return sp_add(d, val);
    }
    if af == 1 {
        // COUNT(*) counts every matching row; COUNT(col) counts non-NULL
        // cells ('' counts); COUNT(DISTINCT col) counts the
        // distinct non-NULL values.
        if ac_name == "*" {
            return sp_add(d, int_to_str(match_count));
        }
        let col_idx = resolve_col(d, cs, cc, tname, alias_val, ac_name);
        if distinct == 1 {
            let mut seen: Vec<i32> = vec![];
            let mut dcnt = 0;
            let mut di = 0;
            while di < match_count {
                let drow = vec_get(match_rows, di);
                if col_idx >= 0 {
                    let dcell_id = vec_get(d.cells, rs + drow * cc + col_idx);
                    let dcell = sp_get(d, dcell_id);
                    if !is_null(dcell) {
                        let mut dfound = 0;
                        let mut dsi = 0;
                        while dsi < dcnt {
                            if sp_get(d, vec_get(seen, dsi)) == dcell { dfound = 1; }
                            dsi = dsi + 1;
                        }
                        if dfound == 0 {
                            vec_push(seen, dcell_id);
                            dcnt = dcnt + 1;
                        }
                    }
                }
                di = di + 1;
            }
            return sp_add(d, int_to_str(dcnt));
        }
        let mut cnt = 0;
        let mut mi = 0;
        while mi < match_count {
            let row = vec_get(match_rows, mi);
            if col_idx >= 0 {
                let cell = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
                if !is_null(cell) { cnt = cnt + 1; }
            }
            mi = mi + 1;
        }
        return sp_add(d, int_to_str(cnt));
    }
    // SUM/AVG/MIN/MAX
    let col_idx = resolve_col(d, cs, cc, tname, alias_val, ac_name);
    let ct = if col_idx >= 0 { vec_get(d.col_types, cs + col_idx) } else { 0 };
    let mut match_rows = match_rows;
    let mut match_count = match_count;
    if distinct == 1 {
        match_rows = distinct_rows(d, match_rows, match_count, rs, cc, col_idx, 0 - 1);
        match_count = vec_len(match_rows);
    }
    let mut sum_val = 0.0;
    let mut min_val = 999999999.0;
    let mut max_val = 0.0 - 999999999.0;
    // MIN/MAX on a TEXT column (type 2) order lexicographically via
    // compare_vals; parse_float coerces text to 0 and collapses them.
    let mut min_str = "";
    let mut max_str = "";
    let mut cnt = 0;
    let mut mi = 0;
    while mi < match_count {
        let row = vec_get(match_rows, mi);
        let cellv = if col_idx >= 0 { sp_get(d, vec_get(d.cells, rs + row * cc + col_idx)) } else { nullv() };
        if !is_null(cellv) {
            let nv = cellv.parse_float();
            sum_val = sum_val + nv;
            if cnt == 0 || nv < min_val { min_val = nv; }
            if cnt == 0 || nv > max_val { max_val = nv; }
            if ct == 2 {
                if cnt == 0 { min_str = cellv; max_str = cellv; }
                else {
                    if compare_vals(cellv, min_str, ct) < 0 { min_str = cellv; }
                    if compare_vals(cellv, max_str, ct) > 0 { max_str = cellv; }
                }
            }
            cnt = cnt + 1;
        }
        mi = mi + 1;
    }
    // SUM/AVG/MIN/MAX over no non-NULL value are NULL; COUNT stays 0.
    if cnt == 0 { return sp_add(d, nullv()); }
    if af == 4 && ct == 2 { return sp_add(d, min_str); }
    if af == 5 && ct == 2 { return sp_add(d, max_str); }
    let mut result_val = sum_val;
    if af == 3 {
        if cnt > 0 { result_val = sum_val / (cnt as f64); }
        else { result_val = 0.0; }
    }
    if af == 4 { result_val = min_val; }
    if af == 5 { result_val = max_val; }
    let result_str = float_to_str(result_val);
    sp_add(d, result_str)
}

// The rows of rows[0..n] that first carry each distinct non-NULL value of
// column col (cell position rs + row * cc + col), within each value of the
// group column gcol when gcol >= 0. Values compare as values, the way the
// key map compares them (con_part: 1 equals 1.0, text as is). Feeding these
// rows to SUM, AVG, MIN or MAX gives the aggregate over DISTINCT values (P23).
fn distinct_rows(d: &DB, rows: Vec<i32>, n: i32, rs: i32, cc: i32, col: i32, gcol: i32) -> Vec<i32> {
    let mut out: Vec<i32> = vec![];
    if col < 0 { return out; }
    let seen: HashMap<String, f64> = map_new();
    let mut i = 0;
    while i < n {
        let r = vec_get(rows, i);
        let v = sp_get(d, vec_get(d.cells, rs + r * cc + col));
        if !is_null(v) {
            let mut key = con_part(v);
            if gcol >= 0 {
                let g = sp_get(d, vec_get(d.cells, rs + r * cc + gcol));
                key = to_string_i32(g.len()) + ":" + g + "|" + key;
            }
            if !map_contains(seen, key) {
                map_insert(seen, key, 1.0);
                vec_push(out, r);
            }
        }
        i = i + 1;
    }
    out
}

// Build the header string pool id for an aggregate
fn build_agg_header(d: &mut DB, af: i32, ac_name_id: i32, al_id: i32, distinct: i32) -> i32 {
    if al_id >= 0 { return al_id; }
    let ac_name = sp_get(d, ac_name_id);
    if af == 0 { return sp_add(d, ac_name); }
    if af == 1 {
        if ac_name == "*" { return sp_add(d, "COUNT(*)"); }
        if distinct == 1 { return sp_add(d, "COUNT(DISTINCT " + ac_name + ")"); }
        return sp_add(d, "COUNT(" + ac_name + ")");
    }
    let mut func_name = "SUM";
    if af == 3 { func_name = "AVG"; }
    if af == 4 { func_name = "MIN"; }
    if af == 5 { func_name = "MAX"; }
    let mut hname = func_name + "(" + ac_name + ")";
    if distinct == 1 { hname = func_name + "(DISTINCT " + ac_name + ")"; }
    sp_add(d, hname)
}

// --- 6e: SELECT with GROUP BY ---

// Execute a SELECT with GROUP BY and optional HAVING clause.
// Example: SELECT dept, COUNT(*), AVG(salary) FROM emp GROUP BY dept HAVING COUNT(*) > 2
//
// Flow:
//   1. Filter rows by WHERE
//   2. Collect distinct group key values from the GROUP BY column
//   3. For each group key, compute all requested aggregates over matching rows
//   4. Apply HAVING filter to discard groups that don't match
//   5. Apply ORDER BY if present (sorts the group result rows)
//   6. Print formatted output
//
// Group keys are collected into a Vec<i32> of pool IDs. For each key,
// helper functions (group_count_rows, compute_group_numeric, group_get_plain)
// scan match_rows to compute aggregates for that group.
fn exec_select_group(d: &mut DB) ~ Console {
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    if !where_cols_ok(d, cs, cc, tname, d.alias1) { return; }
    // Reject an aggregate (projection or HAVING) over an unknown column before
    // grouping, so a group's compute never reads zero cells and returns 0.
    if !agg_cols_ok(d, cs, cc, tname, d.alias1) { return; }

    let gcol_name = sp_get(d, d.group_col);
    let gcol = resolve_col(d, cs, cc, tname, d.alias1, gcol_name);
    if gcol < 0 {
        println!("Error: GROUP BY column '{}' not found", gcol_name);
        return;
    }

    // Filter rows by WHERE
    let mut match_rows: Vec<i32> = vec![];
    let mut match_count = 0;
    let mut r = 0;
    while r < rc {
        if eval_compound_where(d, cs, cc, rs, r, tname, d.alias1) {
            vec_push(match_rows, r);
            match_count = match_count + 1;
        }
        r = r + 1;
    }

    // Collect distinct group keys
    let mut group_keys: Vec<i32> = vec![];
    let mut group_count = 0;
    let mut mi = 0;
    let mut gk_row = 0;
    let mut gk_val = "";
    let mut gk_id = 0;
    let mut gk_found = false;
    let mut gk_gi = 0;
    let mut gk_existing = "";
    while mi < match_count {
        gk_row = vec_get(match_rows, mi);
        gk_val = sp_get(d, vec_get(d.cells, rs + gk_row * cc + gcol));
        gk_id = sp_add(d, gk_val);
        gk_found = false;
        gk_gi = 0;
        while gk_gi < group_count {
            gk_existing = sp_get(d, vec_get(group_keys, gk_gi));
            if gk_existing == gk_val { gk_found = true; }
            gk_gi = gk_gi + 1;
        }
        if !gk_found {
            vec_push(group_keys, gk_id);
            group_count = group_count + 1;
        }
        mi = mi + 1;
    }

    let ncols = d.p_agg_count;

    // Compute all result rows: flat array, ncols per group
    // Inline the computation to avoid sequential-while-loop compiler issues
    let mut all_results: Vec<i32> = vec![];
    // Pre-copy agg info to avoid struct access issues across function calls
    let mut local_agg_funcs: Vec<i32> = vec![];
    let mut local_agg_cols: Vec<i32> = vec![];
    let mut local_agg_distinct: Vec<i32> = vec![];
    let mut copy_i = 0;
    let mut copy_af = 0;
    let mut copy_ac = 0;
    let mut copy_dist = 0;
    while copy_i < ncols {
        copy_af = vec_get(d.p_agg_funcs, copy_i);
        copy_ac = vec_get(d.p_agg_cols, copy_i);
        copy_dist = if copy_i < vec_len(d.p_agg_distinct) { vec_get(d.p_agg_distinct, copy_i) } else { 0 };
        vec_push(local_agg_funcs, copy_af);
        vec_push(local_agg_cols, copy_ac);
        vec_push(local_agg_distinct, copy_dist);
        copy_i = copy_i + 1;
    }
    // Now compute results for each group
    let alias1_val = d.alias1;
    let mut gi2 = 0;
    let mut gi2_gk = "";
    let mut gi2_ai = 0;
    let mut gi2_af = 0;
    let mut gi2_ac_name = "";
    let mut gi2_col_idx = 0;
    let mut gi2_val_str = "";
    let mut gi2_vid = 0;
    let mut gi2_cnt = 0;
    while gi2 < group_count {
        gi2_gk = sp_get(d, vec_get(group_keys, gi2));
        gi2_ai = 0;
        while gi2_ai < ncols {
            gi2_af = vec_get(local_agg_funcs, gi2_ai);
            gi2_ac_name = sp_get(d, vec_get(local_agg_cols, gi2_ai));
            if gi2_af == 1 {
                if gi2_ac_name == "*" {
                    gi2_cnt = group_count_rows(d, gi2_gk, rs, cc, gcol, match_rows, match_count);
                } else {
                    gi2_col_idx = resolve_col(d, cs, cc, tname, alias1_val, gi2_ac_name);
                    if vec_get(local_agg_distinct, gi2_ai) == 1 {
                        gi2_cnt = group_count_col_distinct(d, gi2_gk, gi2_col_idx, gcol, rs, cc, match_rows, match_count);
                    } else {
                        gi2_cnt = group_count_col(d, gi2_gk, gi2_col_idx, gcol, rs, cc, match_rows, match_count);
                    }
                }
                gi2_val_str = int_to_str(gi2_cnt);
                gi2_vid = sp_add(d, gi2_val_str);
                vec_push(all_results, gi2_vid);
            } else if gi2_af >= 2 {
                if vec_get(local_agg_distinct, gi2_ai) == 1 {
                    let dcol = resolve_col(d, cs, cc, tname, alias1_val, gi2_ac_name);
                    let drows = distinct_rows(d, match_rows, match_count, rs, cc, dcol, gcol);
                    gi2_val_str = compute_group_numeric(d, gi2_af, gi2_ac_name, gi2_gk, cs, cc, rs, tname, gcol,
                                                        drows, vec_len(drows));
                } else {
                    gi2_val_str = compute_group_numeric(d, gi2_af, gi2_ac_name, gi2_gk, cs, cc, rs, tname, gcol,
                                                        match_rows, match_count);
                }
                gi2_vid = sp_add(d, gi2_val_str);
                vec_push(all_results, gi2_vid);
            } else {
                gi2_col_idx = resolve_col(d, cs, cc, tname, alias1_val, gi2_ac_name);
                gi2_val_str = group_get_plain(d, gi2_gk, gi2_col_idx, gcol, rs, cc, match_rows, match_count);
                gi2_vid = sp_add(d, gi2_val_str);
                vec_push(all_results, gi2_vid);
            }
            gi2_ai = gi2_ai + 1;
        }
        gi2 = gi2 + 1;
    }

    // HAVING: filter groups after aggregation
    let mut final_results: Vec<i32> = vec![];
    let mut final_count = 0;
    if d.has_having == 1 {
        let hv_rval = sp_get(d, d.having_val);
        let mut hgi = 0;
        let mut hgk = "";
        let mut hv_agg = "";
        let mut hci = 0;
        let mut cell_id = 0;
        while hgi < group_count {
            hgk = sp_get(d, vec_get(group_keys, hgi));
            hv_agg = having_compute_agg(d, hgk, cs, cc, rs, tname, gcol, match_rows, match_count);
            if eval_where(hv_agg, d.having_op, hv_rval) {
                hci = 0;
                while hci < ncols {
                    cell_id = vec_get(all_results, hgi * ncols + hci);
                    vec_push(final_results, cell_id);
                    hci = hci + 1;
                }
                final_count = final_count + 1;
            }
            hgi = hgi + 1;
        }
    } else {
        final_results = all_results;
        final_count = group_count;
    }

    // ORDER BY on grouped output. The key may name the grouped/selected column
    // (SELECT dept, COUNT(*) ... GROUP BY dept ORDER BY dept), an aggregate term
    // (ORDER BY SUM(salary)), or a projection alias (SELECT SUM(salary) AS s ...
    // ORDER BY s). It is resolved to an output column, then a stable sort keeps
    // equal keys in group-discovery order. An unresolvable key fails closed.
    if d.has_order == 1 {
        let go_name = sp_get(d, d.order_col);
        // Resolve the order key to an output column, in order:
        //   (0) ordinal -- a bare integer is a 1-based position into the output
        //       columns (ORDER BY 2), the same rule the non-grouped and UNION
        //       paths use. Out of range fails closed.
        //   (1) same-kind match -- a plain key (order_agg_func == 0) matches a
        //       plain output column; an aggregate key matches the output column
        //       with the same func + arg (ORDER BY SUM(salary)).
        //   (2) alias match -- the key names a projection alias
        //       (SELECT SUM(salary) AS s ... ORDER BY s). An alias is a bare
        //       identifier, so it parses as a plain key but may bind to an
        //       aggregate output column; the alias binding wins.
        // go_match_af carries the matched column's aggregate func so the sort
        // type comes from the output column, not the parsed key.
        let mut go_oidx = 0 - 1;
        let mut go_match_af = 0;
        if is_int_str(go_name) {
            let go_n = parse_int_str(go_name);
            if go_n >= 1 {
                if go_n <= ncols { go_oidx = go_n - 1; }
            }
            if go_oidx < 0 {
                println!("Error: ORDER BY position {} is out of range", go_name);
                return;
            }
            go_match_af = vec_get(local_agg_funcs, go_oidx);
        }
        let mut go_ci = 0;
        while go_ci < ncols {
            if vec_get(local_agg_funcs, go_ci) == d.order_agg_func {
                let go_cn = sp_get(d, vec_get(local_agg_cols, go_ci));
                if go_cn == go_name {
                    if go_oidx < 0 {
                        go_oidx = go_ci;
                        go_match_af = d.order_agg_func;
                    }
                }
            }
            go_ci = go_ci + 1;
        }
        if go_oidx < 0 {
            let mut go_ai = 0;
            while go_ai < ncols {
                if go_ai < vec_len(d.p_aliases) {
                    let go_al = vec_get(d.p_aliases, go_ai);
                    if go_al >= 0 {
                        let go_aln = sp_get(d, go_al);
                        if go_aln == go_name {
                            if go_oidx < 0 {
                                go_oidx = go_ai;
                                go_match_af = vec_get(local_agg_funcs, go_ai);
                            }
                        }
                    }
                }
                go_ai = go_ai + 1;
            }
        }
        if go_oidx < 0 {
            // Fail closed: an ORDER BY term on a grouped result that names
            // neither the grouped/selected column, an aggregate output, nor a
            // select alias has no defined ordering. Erroring beats silently
            // emitting rows in group-discovery order (a wrong answer with no
            // signal).
            println!("Error: ORDER BY term '{}' is not a grouped column, aggregate, or alias", go_name);
            return;
        }
        if go_oidx >= 0 {
            // Aggregate results sort numerically. COUNT is an integer; SUM/AVG/
            // MIN/MAX compare as real so AVG decimals order correctly. A plain
            // key keeps the source column's declared type (TEXT default).
            let mut go_type = 2;
            if go_match_af == 1 {
                go_type = 0;
            } else if go_match_af > 1 {
                go_type = 1;
            } else {
                let go_argn = sp_get(d, vec_get(local_agg_cols, go_oidx));
                let go_real = resolve_col(d, cs, cc, tname, alias1_val, go_argn);
                if go_real >= 0 { go_type = vec_get(d.col_types, cs + go_real); }
            }
            // Stable selection sort over final_count rows, each ncols wide.
            // A strict `< 0` pick keeps equal keys in group-discovery order.
            let mut go_used: Vec<i32> = vec![];
            let mut go_u = 0;
            while go_u < final_count { vec_push(go_used, 0); go_u = go_u + 1; }
            let mut go_sorted: Vec<i32> = vec![];
            let mut go_picked = 0;
            while go_picked < final_count {
                let mut go_best = 0 - 1;
                let mut go_j = 0;
                while go_j < final_count {
                    if vec_get(go_used, go_j) == 0 {
                        if go_best < 0 {
                            go_best = go_j;
                        } else {
                            let go_va = sp_get(d, vec_get(final_results, go_j * ncols + go_oidx));
                            let go_vb = sp_get(d, vec_get(final_results, go_best * ncols + go_oidx));
                            let mut go_c = compare_vals(go_va, go_vb, go_type);
                            if d.order_desc == 1 { go_c = 0 - go_c; }
                            if go_c < 0 { go_best = go_j; }
                        }
                    }
                    go_j = go_j + 1;
                }
                let mut go_nu: Vec<i32> = vec![];
                let mut go_k = 0;
                while go_k < final_count {
                    if go_k == go_best { vec_push(go_nu, 1); }
                    else { vec_push(go_nu, vec_get(go_used, go_k)); }
                    go_k = go_k + 1;
                }
                go_used = go_nu;
                let mut go_cp = 0;
                while go_cp < ncols {
                    vec_push(go_sorted, vec_get(final_results, go_best * ncols + go_cp));
                    go_cp = go_cp + 1;
                }
                go_picked = go_picked + 1;
            }
            final_results = go_sorted;
        }
    }

    // Build headers (with alias support)
    let mut headers: Vec<i32> = vec![];
    let mut bhi = 0;
    let mut bh_used_alias = false;
    let mut bh_al = 0;
    while bhi < ncols {
        bh_used_alias = false;
        if bhi < vec_len(d.p_aliases) {
            bh_al = vec_get(d.p_aliases, bhi);
            if bh_al >= 0 {
                vec_push(headers, bh_al);
                bh_used_alias = true;
            }
        }
        if !bh_used_alias {
            push_agg_header(d, bhi, headers);
        }
        bhi = bhi + 1;
    }

    // Compute widths
    let mut widths2: Vec<i32> = vec![];
    let mut w2i = 0;
    let mut w2_hdr = "";
    while w2i < ncols {
        w2_hdr = sp_get(d, vec_get(headers, w2i));
        vec_push(widths2, w2_hdr.len());
        w2i = w2i + 1;
    }
    let mut ri2 = 0;
    let mut ci2 = 0;
    let mut w2_val = "";
    let mut w2_vlen = 0;
    let mut w2_cur = 0;
    while ri2 < final_count {
        ci2 = 0;
        while ci2 < ncols {
            w2_val = sp_get(d, vec_get(final_results, ri2 * ncols + ci2));
            w2_vlen = dlen(w2_val);
            w2_cur = vec_get(widths2, ci2);
            if w2_vlen > w2_cur { widths2 = vec_replace(widths2, ncols, ci2, w2_vlen); }
            ci2 = ci2 + 1;
        }
        ri2 = ri2 + 1;
    }
    let widths = widths2;

    // Print header
    let mut hdr_line = "";
    let mut sep_line = "";
    let mut pi = 0;
    let mut ph_hdr = "";
    let mut ph_w = 0;
    while pi < ncols {
        if pi > 0 { hdr_line = hdr_line + " | "; sep_line = sep_line + "-+-"; }
        ph_hdr = sp_get(d, vec_get(headers, pi));
        rows_hdr(d, ph_hdr);
        ph_w = vec_get(widths, pi);
        hdr_line = hdr_line + pad_right(ph_hdr, ph_w);
        sep_line = sep_line + make_dashes(ph_w);
        pi = pi + 1;
    }
    emit_line(d, hdr_line);
    emit_line(d, sep_line);

    // Print rows
    let mut ri = 0;
    let mut row_line = "";
    let mut pci = 0;
    let mut pr_val = "";
    let mut pr_w = 0;
    while ri < final_count {
        row_line = "";
        pci = 0;
        while pci < ncols {
            if pci > 0 { row_line = row_line + " | "; }
            pr_val = sp_get(d, vec_get(final_results, ri * ncols + pci));
            rows_cell(d, pr_val);
            pr_w = vec_get(widths, pci);
            row_line = row_line + pad_right(pr_val, pr_w);
            pci = pci + 1;
        }
        emit_line(d, row_line);
        ri = ri + 1;
    }
}

// Compute the HAVING aggregate value for a group key
fn having_compute_agg(d: &mut DB, gk: String, cs: i32, cc: i32, rs: i32,
                      tname: String, gcol: i32,
                      match_rows: Vec<i32>, match_count: i32) -> String {
    let haf = d.having_agg_func;
    if haf == 1 {
        // COUNT
        let cnt = group_count_rows(d, gk, rs, cc, gcol, match_rows, match_count);
        return int_to_str(cnt);
    }
    // SUM/AVG/MIN/MAX
    let hac_name = sp_get(d, d.having_agg_col);
    compute_group_numeric(d, haf, hac_name, gk, cs, cc, rs, tname, gcol, match_rows, match_count)
}

fn group_count_rows(d: &DB, gk: String, rs: i32, cc: i32, gcol: i32,
                    match_rows: Vec<i32>, match_count: i32) -> i32 {
    let mut cnt = 0;
    let mut ci = 0;
    while ci < match_count {
        let crow = vec_get(match_rows, ci);
        let cgv = sp_get(d, vec_get(d.cells, rs + crow * cc + gcol));
        if cgv == gk { cnt = cnt + 1; }
        ci = ci + 1;
    }
    cnt
}

// COUNT(col) within a group: rows in the group whose col cell is non-NULL.
fn group_count_col(d: &DB, gk: String, col_idx: i32, gcol: i32, rs: i32, cc: i32,
                   match_rows: Vec<i32>, match_count: i32) -> i32 {
    let mut cnt = 0;
    let mut ci = 0;
    while ci < match_count {
        let crow = vec_get(match_rows, ci);
        let cgv = sp_get(d, vec_get(d.cells, rs + crow * cc + gcol));
        if cgv == gk {
            if col_idx >= 0 {
                let cell = sp_get(d, vec_get(d.cells, rs + crow * cc + col_idx));
                if !is_null(cell) { cnt = cnt + 1; }
            }
        }
        ci = ci + 1;
    }
    cnt
}

// COUNT(DISTINCT col) within a group: the number of distinct non-NULL values of
// col among the rows whose group cell equals gk. Dedup is a linear scan over the
// values already seen (no hash set), which is fine for the row counts this
// teaching engine handles.
fn group_count_col_distinct(d: &DB, gk: String, col_idx: i32, gcol: i32, rs: i32, cc: i32,
                            match_rows: Vec<i32>, match_count: i32) -> i32 {
    let mut seen: Vec<i32> = vec![];
    let mut dcnt = 0;
    let mut ci = 0;
    while ci < match_count {
        let crow = vec_get(match_rows, ci);
        let cgv = sp_get(d, vec_get(d.cells, rs + crow * cc + gcol));
        if cgv == gk {
            if col_idx >= 0 {
                let cell_id = vec_get(d.cells, rs + crow * cc + col_idx);
                let cell = sp_get(d, cell_id);
                if !is_null(cell) {
                    let mut found = 0;
                    let mut si = 0;
                    while si < dcnt {
                        if sp_get(d, vec_get(seen, si)) == cell { found = 1; }
                        si = si + 1;
                    }
                    if found == 0 {
                        vec_push(seen, cell_id);
                        dcnt = dcnt + 1;
                    }
                }
            }
        }
        ci = ci + 1;
    }
    dcnt
}

fn group_get_plain(d: &DB, gk: String, col_idx: i32, gcol: i32, rs: i32, cc: i32,
                   match_rows: Vec<i32>, match_count: i32) -> String {
    if col_idx == gcol { return gk; }
    let mut fi = 0;
    while fi < match_count {
        let frow = vec_get(match_rows, fi);
        let fgv = sp_get(d, vec_get(d.cells, rs + frow * cc + gcol));
        if fgv == gk {
            if col_idx >= 0 {
                return sp_get(d, vec_get(d.cells, rs + frow * cc + col_idx));
            }
        }
        fi = fi + 1;
    }
    ""
}

fn push_agg_header(d: &mut DB, hi: i32, headers: Vec<i32>) {
    let af = vec_get(d.p_agg_funcs, hi);
    let ac_name = sp_get(d, vec_get(d.p_agg_cols, hi));
    let dist = if hi < vec_len(d.p_agg_distinct) { vec_get(d.p_agg_distinct, hi) } else { 0 };
    if af == 0 {
        let hid = sp_add(d, ac_name);
        vec_push(headers, hid);
        return;
    }
    if af == 1 {
        if ac_name == "*" {
            let hid = sp_add(d, "COUNT(*)");
            vec_push(headers, hid);
            return;
        }
        if dist == 1 {
            let hid = sp_add(d, "COUNT(DISTINCT " + ac_name + ")");
            vec_push(headers, hid);
            return;
        }
        let hid = sp_add(d, "COUNT(" + ac_name + ")");
        vec_push(headers, hid);
        return;
    }
    let mut func_name = "SUM";
    if af == 3 { func_name = "AVG"; }
    if af == 4 { func_name = "MIN"; }
    if af == 5 { func_name = "MAX"; }
    let mut hname = func_name + "(" + ac_name + ")";
    if dist == 1 { hname = func_name + "(DISTINCT " + ac_name + ")"; }
    let hid = sp_add(d, hname);
    vec_push(headers, hid);
}

fn compute_group_numeric(d: &mut DB, af: i32, ac_name: String, gk: String,
                         cs: i32, cc: i32, rs: i32, tname: String, gcol: i32,
                         match_rows: Vec<i32>, match_count: i32) -> String {
    let col_idx = resolve_col(d, cs, cc, tname, d.alias1, ac_name);
    let ct = if col_idx >= 0 { vec_get(d.col_types, cs + col_idx) } else { 0 };
    let mut sum_v = 0.0;
    let mut min_v = 999999999.0;
    let mut max_v = 0.0 - 999999999.0;
    // MIN/MAX on a TEXT column (type 2) order lexicographically via
    // compare_vals; parse_float coerces text to 0 and collapses them.
    let mut min_str = "";
    let mut max_str = "";
    let mut cnt = 0;
    let mut si = 0;
    while si < match_count {
        let srow = vec_get(match_rows, si);
        let sgv = sp_get(d, vec_get(d.cells, rs + srow * cc + gcol));
        if sgv == gk {
            if col_idx >= 0 {
                let sv = sp_get(d, vec_get(d.cells, rs + srow * cc + col_idx));
                if !is_null(sv) {
                let nv = sv.parse_float();
                sum_v = sum_v + nv;
                if cnt == 0 || nv < min_v { min_v = nv; }
                if cnt == 0 || nv > max_v { max_v = nv; }
                if ct == 2 {
                    if cnt == 0 { min_str = sv; max_str = sv; }
                    else {
                        if compare_vals(sv, min_str, ct) < 0 { min_str = sv; }
                        if compare_vals(sv, max_str, ct) > 0 { max_str = sv; }
                    }
                }
                cnt = cnt + 1;
                }
            }
        }
        si = si + 1;
    }
    // SUM/AVG/MIN/MAX over no non-NULL value are NULL; COUNT stays 0.
    if cnt == 0 { return nullv(); }
    if af == 4 && ct == 2 { return min_str; }
    if af == 5 && ct == 2 { return max_str; }
    let mut result_val = sum_v;
    if af == 3 {
        if cnt > 0 { result_val = sum_v / (cnt as f64); }
        else { result_val = 0.0; }
    }
    if af == 4 { result_val = min_v; }
    if af == 5 { result_val = max_v; }
    float_to_str(result_val)
}

// --- 6f: SELECT with JOIN (nested loop) ---

// Execute a SELECT with JOIN. Uses nested-loop join algorithm.
// Example: SELECT u.name, o.total FROM users u JOIN orders o ON u.id = o.user_id
//
// Flow:
//   1. Resolve both tables and their column schemas
//   2. Resolve ON clause columns (try both orderings)
//   3. Resolve SELECT column list against both tables
//   4. Nested loop: for each row in table1, scan all rows in table2
//   5. For matching pairs (ON condition), evaluate WHERE if present
//   6. Collect selected columns from matching row pairs
//   7. Apply ORDER BY, LIMIT, DISTINCT
//   8. Print formatted output
//
// Table aliases (u, o) are resolved via d.alias1 and d.alias2.
fn exec_select_join(d: &mut DB) ~ Console {
    let tname1 = sp_get(d, d.p_table);
    let tname2 = sp_get(d, d.join_table);
    let t1 = find_table(d, tname1);
    let t2 = find_table(d, tname2);
    if t1 < 0 { println!("Error: table '{}' not found", tname1); return; }
    if t2 < 0 { println!("Error: table '{}' not found", tname2); return; }

    let cs1 = vec_get(d.tbl_col_starts, t1);
    let cc1 = vec_get(d.tbl_col_counts, t1);
    let rs1 = vec_get(d.tbl_row_starts, t1);
    let rc1 = vec_get(d.tbl_row_counts, t1);

    let cs2 = vec_get(d.tbl_col_starts, t2);
    let cc2 = vec_get(d.tbl_col_counts, t2);
    let rs2 = vec_get(d.tbl_row_starts, t2);
    let rc2 = vec_get(d.tbl_row_counts, t2);

    // Resolve ON columns
    let jl_ref = sp_get(d, d.join_left_col);
    let jr_ref = sp_get(d, d.join_right_col);

    // Try to resolve each ref against both tables
    let mut jc1 = resolve_col(d, cs1, cc1, tname1, d.alias1, jl_ref);
    let mut jc2 = resolve_col(d, cs2, cc2, tname2, d.alias2, jr_ref);
    // If that didn't work, try swapped
    if jc1 < 0 {
        jc1 = resolve_col(d, cs1, cc1, tname1, d.alias1, jr_ref);
        jc2 = resolve_col(d, cs2, cc2, tname2, d.alias2, jl_ref);
    }
    if jc1 < 0 || jc2 < 0 {
        println!("Error: cannot resolve JOIN columns");
        return;
    }

    // p_agg_count is the count of ALL projection items, plain columns included
    // (each carries p_agg_funcs[k]==0), so a real aggregate is present only when
    // some p_agg_funcs entry is non-zero. Checking p_agg_count>0 alone would
    // treat every plain join as an aggregate.
    let mut join_has_agg = false;
    let mut join_has_distinct = false;
    let mut ai = 0;
    while ai < d.p_agg_count {
        if vec_get(d.p_agg_funcs, ai) > 0 { join_has_agg = true; }
        if ai < vec_len(d.p_agg_distinct) {
            if vec_get(d.p_agg_distinct, ai) == 1 { join_has_distinct = true; }
        }
        ai = ai + 1;
    }

    // Scalar aggregate over a JOIN with no GROUP BY. Assemble the matched
    // (r1,r2) pairs the same way the plain projection path does (honoring WHERE
    // and LEFT JOIN null-extension), then fold each aggregate over those pairs.
    // NULL and MIN/MAX/COUNT semantics mirror compute_single_agg so a join
    // aggregate returns the same answer a single-table aggregate would over the
    // same joined rows. A right-side column of a LEFT JOIN null-extended pair
    // (r2 < 0) reads as NULL (empty string), which the numeric folds coerce to
    // 0.0 exactly as the single-table path coerces an empty cell.
    if join_has_agg && d.has_group_by == 0 {
        if join_has_distinct {
            println!("Error: COUNT(DISTINCT) over a JOIN is not supported");
            return;
        }
        let mut pr1: Vec<i32> = vec![];
        let mut pr2: Vec<i32> = vec![];
        let mut pcount = 0;
        let mut q1 = 0;
        while q1 < rc1 {
            let jk1 = sp_get(d, vec_get(d.cells, rs1 + q1 * cc1 + jc1));
            let mut jmatched = false;
            let mut q2 = 0;
            while q2 < rc2 {
                let jk2 = sp_get(d, vec_get(d.cells, rs2 + q2 * cc2 + jc2));
                if jk1 == jk2 {
                    jmatched = true;
                    let mut jpass = true;
                    if d.has_where == 1 {
                        jpass = eval_join_where(d, cs1, cc1, rs1, q1, tname1, d.alias1,
                                                cs2, cc2, rs2, q2, tname2, d.alias2);
                    }
                    if jpass {
                        vec_push(pr1, q1);
                        vec_push(pr2, q2);
                        pcount = pcount + 1;
                    }
                }
                q2 = q2 + 1;
            }
            if d.join_type == 1 {
                if jmatched == false {
                    let mut lpass = true;
                    if d.has_where == 1 {
                        lpass = eval_join_where(d, cs1, cc1, rs1, q1, tname1, d.alias1,
                                                cs2, cc2, rs2, 0 - 1, tname2, d.alias2);
                    }
                    if lpass {
                        vec_push(pr1, q1);
                        vec_push(pr2, 0 - 1);
                        pcount = pcount + 1;
                    }
                }
            }
            q1 = q1 + 1;
        }

        let mut agg_headers: Vec<i32> = vec![];
        let mut agg_results: Vec<i32> = vec![];
        let mut pi = 0;
        while pi < d.p_agg_count {
            let af = vec_get(d.p_agg_funcs, pi);
            let ac_id = vec_get(d.p_agg_cols, pi);
            let ac = sp_get(d, ac_id);
            let al = if pi < vec_len(d.p_aliases) { vec_get(d.p_aliases, pi) } else { 0 - 1 };
            // Resolve the argument column against either table. COUNT(*) has no
            // column, so skip resolution for it.
            let mut atab = 0;
            let mut acol = 0 - 1;
            let mut atype = 0;
            if !(af == 1 && ac == "*") {
                let ra = resolve_col(d, cs1, cc1, tname1, d.alias1, ac);
                if ra >= 0 { atab = 1; acol = ra; atype = vec_get(d.col_types, cs1 + ra); }
                else {
                    let rb = resolve_col(d, cs2, cc2, tname2, d.alias2, ac);
                    if rb >= 0 { atab = 2; acol = rb; atype = vec_get(d.col_types, cs2 + rb); }
                    else {
                        println!("Error: column '{}' not found in either table", ac);
                        return;
                    }
                }
            }
            let mut out = "";
            if af == 0 {
                // Bare column beside aggregates: first joined row's value, as the
                // single-table path returns the first matching row's value.
                if pcount > 0 {
                    out = join_cell_str(d, atab, acol, cc1, rs1, vec_get(pr1, 0),
                                        cc2, rs2, vec_get(pr2, 0));
                }
            } else if af == 1 {
                if ac == "*" {
                    out = int_to_str(pcount);
                } else {
                    let mut cnt = 0;
                    let mut k = 0;
                    while k < pcount {
                        let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(pr1, k),
                                               cc2, rs2, vec_get(pr2, k));
                        if !is_null(cv) { cnt = cnt + 1; }
                        k = k + 1;
                    }
                    out = int_to_str(cnt);
                }
            } else {
                let mut sum_val = 0.0;
                let mut min_val = 999999999.0;
                let mut max_val = 0.0 - 999999999.0;
                let mut min_str = "";
                let mut max_str = "";
                let mut cnt = 0;
                let mut k = 0;
                while k < pcount {
                    let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(pr1, k),
                                           cc2, rs2, vec_get(pr2, k));
                    if !is_null(cv) {
                    let nv = cv.parse_float();
                    sum_val = sum_val + nv;
                    if cnt == 0 || nv < min_val { min_val = nv; }
                    if cnt == 0 || nv > max_val { max_val = nv; }
                    if atype == 2 {
                        if cnt == 0 { min_str = cv; max_str = cv; }
                        else {
                            if compare_vals(cv, min_str, atype) < 0 { min_str = cv; }
                            if compare_vals(cv, max_str, atype) > 0 { max_str = cv; }
                        }
                    }
                    cnt = cnt + 1;
                    }
                    k = k + 1;
                }
                if cnt == 0 {
                    out = nullv();
                } else if af == 4 && atype == 2 {
                    out = min_str;
                } else if af == 5 && atype == 2 {
                    out = max_str;
                } else {
                    let mut rv = sum_val;
                    if af == 3 { if cnt > 0 { rv = sum_val / (cnt as f64); } else { rv = 0.0; } }
                    if af == 4 { rv = min_val; }
                    if af == 5 { rv = max_val; }
                    out = float_to_str(rv);
                }
            }
            vec_push(agg_results, sp_add(d, out));
            let dist0 = if pi < vec_len(d.p_agg_distinct) { vec_get(d.p_agg_distinct, pi) } else { 0 };
            vec_push(agg_headers, build_agg_header(d, af, ac_id, al, dist0));
            pi = pi + 1;
        }
        print_result_row(d, agg_headers, agg_results, d.p_agg_count);
        return;
    }

    // GROUP BY over a JOIN with aggregates. Bucket the assembled (r1,r2) pairs by
    // the single group column's value, then fold each projection item over the
    // pairs in one bucket exactly as the scalar path folds over all pairs. One
    // output row per distinct group key, in group-discovery order (the left
    // table's scan order), matching the single-table grouped path. HAVING filters
    // groups, ORDER BY sorts them, and LIMIT/OFFSET truncate them. DISTINCT and
    // COUNT(DISTINCT) over a grouped join stay fail-closed so an unsupported clause
    // never silently drops or reorders group rows.
    if join_has_agg && d.has_group_by == 1 {
        if join_has_distinct {
            println!("Error: COUNT(DISTINCT) over a JOIN is not supported");
            return;
        }
        if d.has_distinct == 1 {
            println!("Error: DISTINCT over a grouped JOIN is not supported");
            return;
        }
        // Resolve the single group column against either table.
        let gref = sp_get(d, d.group_col);
        let mut gtab = 0;
        let mut gcol = 0 - 1;
        let rg1 = resolve_col(d, cs1, cc1, tname1, d.alias1, gref);
        if rg1 >= 0 { gtab = 1; gcol = rg1; }
        else {
            let rg2 = resolve_col(d, cs2, cc2, tname2, d.alias2, gref);
            if rg2 >= 0 { gtab = 2; gcol = rg2; }
            else {
                println!("Error: GROUP BY column '{}' not found in either table", gref);
                return;
            }
        }

        // Assemble matched (r1,r2) pairs honoring WHERE and LEFT JOIN
        // null-extension, identical to the scalar path above.
        let mut gpr1: Vec<i32> = vec![];
        let mut gpr2: Vec<i32> = vec![];
        let mut gpc = 0;
        let mut g1 = 0;
        while g1 < rc1 {
            let gk1 = sp_get(d, vec_get(d.cells, rs1 + g1 * cc1 + jc1));
            let mut gm = false;
            let mut g2 = 0;
            while g2 < rc2 {
                let gk2 = sp_get(d, vec_get(d.cells, rs2 + g2 * cc2 + jc2));
                if gk1 == gk2 {
                    gm = true;
                    let mut gp = true;
                    if d.has_where == 1 {
                        gp = eval_join_where(d, cs1, cc1, rs1, g1, tname1, d.alias1,
                                             cs2, cc2, rs2, g2, tname2, d.alias2);
                    }
                    if gp {
                        vec_push(gpr1, g1);
                        vec_push(gpr2, g2);
                        gpc = gpc + 1;
                    }
                }
                g2 = g2 + 1;
            }
            if d.join_type == 1 {
                if gm == false {
                    let mut glp = true;
                    if d.has_where == 1 {
                        glp = eval_join_where(d, cs1, cc1, rs1, g1, tname1, d.alias1,
                                              cs2, cc2, rs2, 0 - 1, tname2, d.alias2);
                    }
                    if glp {
                        vec_push(gpr1, g1);
                        vec_push(gpr2, 0 - 1);
                        gpc = gpc + 1;
                    }
                }
            }
            g1 = g1 + 1;
        }

        // Distinct group keys in first-seen (left-scan) order.
        let mut gkeys: Vec<i32> = vec![];
        let mut gkc = 0;
        let mut kk = 0;
        while kk < gpc {
            let gkv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, kk),
                                    cc2, rs2, vec_get(gpr2, kk));
            let mut seen = false;
            let mut si = 0;
            while si < gkc {
                if sp_get(d, vec_get(gkeys, si)) == gkv { seen = true; }
                si = si + 1;
            }
            if seen == false {
                vec_push(gkeys, sp_add(d, gkv));
                gkc = gkc + 1;
            }
            kk = kk + 1;
        }

        // HAVING: keep only group keys whose aggregate passes the test. The
        // HAVING aggregate is folded over the same bucket the projection uses, so
        // a surviving group's HAVING value matches what the row displays. The RHS
        // column, if any, is resolved against either table (COUNT(*) needs none).
        // Trimming gkeys/gkc here leaves every downstream fold, width, and render
        // loop untouched.
        if d.has_having == 1 {
            let hstar = d.having_agg_func == 1 && sp_get(d, d.having_agg_col) == "*";
            let mut hatab = 0;
            let mut hacol = 0 - 1;
            let mut hatype = 0;
            if hstar == false {
                let hname = sp_get(d, d.having_agg_col);
                let rh1 = resolve_col(d, cs1, cc1, tname1, d.alias1, hname);
                if rh1 >= 0 { hatab = 1; hacol = rh1; hatype = vec_get(d.col_types, cs1 + rh1); }
                else {
                    let rh2 = resolve_col(d, cs2, cc2, tname2, d.alias2, hname);
                    if rh2 >= 0 { hatab = 2; hacol = rh2; hatype = vec_get(d.col_types, cs2 + rh2); }
                    else {
                        println!("Error: HAVING column '{}' not found in either table", hname);
                        return;
                    }
                }
            }
            let hv_rval = sp_get(d, d.having_val);
            let mut kept: Vec<i32> = vec![];
            let mut keptc = 0;
            let mut hk = 0;
            while hk < gkc {
                let hgkey = sp_get(d, vec_get(gkeys, hk));
                let hv = join_having_agg(d, d.having_agg_func, hstar, hatab, hacol, hatype,
                                         gtab, gcol, cc1, rs1, cc2, rs2,
                                         gpr1, gpr2, gpc, hgkey);
                if eval_where(hv, d.having_op, hv_rval) {
                    vec_push(kept, vec_get(gkeys, hk));
                    keptc = keptc + 1;
                }
                hk = hk + 1;
            }
            gkeys = kept;
            gkc = keptc;
        }

        // Build headers once (alias-aware), same as the scalar path.
        let ncols = d.p_agg_count;
        let mut gheaders: Vec<i32> = vec![];
        let mut hpi = 0;
        while hpi < ncols {
            let haf = vec_get(d.p_agg_funcs, hpi);
            let hac_id = vec_get(d.p_agg_cols, hpi);
            let hal = if hpi < vec_len(d.p_aliases) { vec_get(d.p_aliases, hpi) } else { 0 - 1 };
            let hdist = if hpi < vec_len(d.p_agg_distinct) { vec_get(d.p_agg_distinct, hpi) } else { 0 };
            vec_push(gheaders, build_agg_header(d, haf, hac_id, hal, hdist));
            hpi = hpi + 1;
        }

        // One output row per group key: fold each projection item over just the
        // pairs whose group cell equals this key.
        let mut grows: Vec<i32> = vec![];
        let mut gi = 0;
        while gi < gkc {
            let gkey = sp_get(d, vec_get(gkeys, gi));
            let mut ppi = 0;
            while ppi < ncols {
                let af = vec_get(d.p_agg_funcs, ppi);
                let ac_id = vec_get(d.p_agg_cols, ppi);
                let ac = sp_get(d, ac_id);
                let mut atab = 0;
                let mut acol = 0 - 1;
                let mut atype = 0;
                if !(af == 1 && ac == "*") {
                    let ra = resolve_col(d, cs1, cc1, tname1, d.alias1, ac);
                    if ra >= 0 { atab = 1; acol = ra; atype = vec_get(d.col_types, cs1 + ra); }
                    else {
                        let rb = resolve_col(d, cs2, cc2, tname2, d.alias2, ac);
                        if rb >= 0 { atab = 2; acol = rb; atype = vec_get(d.col_types, cs2 + rb); }
                        else {
                            println!("Error: column '{}' not found in either table", ac);
                            return;
                        }
                    }
                }
                let mut out = "";
                if af == 0 {
                    // Plain column beside aggregates: the group column returns the
                    // key; any other plain column returns the first row in the
                    // group, matching group_get_plain.
                    let mut found = false;
                    let mut fk = 0;
                    while fk < gpc {
                        if found == false {
                            let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, fk),
                                                   cc2, rs2, vec_get(gpr2, fk));
                            if gv == gkey {
                                out = join_cell_str(d, atab, acol, cc1, rs1, vec_get(gpr1, fk),
                                                    cc2, rs2, vec_get(gpr2, fk));
                                found = true;
                            }
                        }
                        fk = fk + 1;
                    }
                } else if af == 1 {
                    if ac == "*" {
                        let mut cnt = 0;
                        let mut k = 0;
                        while k < gpc {
                            let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, k),
                                                   cc2, rs2, vec_get(gpr2, k));
                            if gv == gkey { cnt = cnt + 1; }
                            k = k + 1;
                        }
                        out = int_to_str(cnt);
                    } else {
                        let mut cnt = 0;
                        let mut k = 0;
                        while k < gpc {
                            let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, k),
                                                   cc2, rs2, vec_get(gpr2, k));
                            if gv == gkey {
                                let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(gpr1, k),
                                                       cc2, rs2, vec_get(gpr2, k));
                                if !is_null(cv) { cnt = cnt + 1; }
                            }
                            k = k + 1;
                        }
                        out = int_to_str(cnt);
                    }
                } else {
                    let mut sum_val = 0.0;
                    let mut min_val = 999999999.0;
                    let mut max_val = 0.0 - 999999999.0;
                    let mut min_str = "";
                    let mut max_str = "";
                    let mut cnt = 0;
                    let mut k = 0;
                    while k < gpc {
                        let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, k),
                                               cc2, rs2, vec_get(gpr2, k));
                        if gv == gkey {
                            let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(gpr1, k),
                                                   cc2, rs2, vec_get(gpr2, k));
                            if !is_null(cv) {
                            let nv = cv.parse_float();
                            sum_val = sum_val + nv;
                            if cnt == 0 || nv < min_val { min_val = nv; }
                            if cnt == 0 || nv > max_val { max_val = nv; }
                            if atype == 2 {
                                if cnt == 0 { min_str = cv; max_str = cv; }
                                else {
                                    if compare_vals(cv, min_str, atype) < 0 { min_str = cv; }
                                    if compare_vals(cv, max_str, atype) > 0 { max_str = cv; }
                                }
                            }
                            cnt = cnt + 1;
                            }
                        }
                        k = k + 1;
                    }
                    if cnt == 0 {
                        out = nullv();
                    } else if af == 4 && atype == 2 {
                        out = min_str;
                    } else if af == 5 && atype == 2 {
                        out = max_str;
                    } else {
                        let mut rv = sum_val;
                        if af == 3 { if cnt > 0 { rv = sum_val / (cnt as f64); } else { rv = 0.0; } }
                        if af == 4 { rv = min_val; }
                        if af == 5 { rv = max_val; }
                        out = float_to_str(rv);
                    }
                }
                vec_push(grows, sp_add(d, out));
                ppi = ppi + 1;
            }
            gi = gi + 1;
        }

        // ORDER BY on the grouped-join output. Mirrors the single-table grouped
        // path: the key is a 1-based ordinal into the output columns, or names the
        // grouped column, an aggregate term, or a projection alias; it resolves to
        // an output column and a stable sort keeps equal keys in group-discovery
        // order. A secondary key fails closed (honest partial); an out-of-range
        // ordinal or an unresolvable name fails closed too.
        if d.has_order == 1 {
            if d.order_col2 >= 0 {
                println!("Error: secondary ORDER BY over a grouped JOIN is not supported");
                return;
            }
            let jo_name = sp_get(d, d.order_col);
            let mut jo_oidx = 0 - 1;
            let mut jo_af = 0;
            // A bare integer key is a 1-based ordinal into the output columns, the
            // same rule the non-grouped and UNION paths use (ORDER BY 2). The
            // matched column's own aggregate func drives the sort type below.
            if is_int_str(jo_name) {
                let jo_n = parse_int_str(jo_name);
                if jo_n >= 1 {
                    if jo_n <= ncols { jo_oidx = jo_n - 1; }
                }
                if jo_oidx < 0 {
                    println!("Error: ORDER BY position {} is out of range", jo_name);
                    return;
                }
                jo_af = vec_get(d.p_agg_funcs, jo_oidx);
            }
            let mut jo_ci = 0;
            while jo_ci < ncols {
                if vec_get(d.p_agg_funcs, jo_ci) == d.order_agg_func {
                    let jo_cn = sp_get(d, vec_get(d.p_agg_cols, jo_ci));
                    if jo_cn == jo_name {
                        if jo_oidx < 0 { jo_oidx = jo_ci; jo_af = d.order_agg_func; }
                    }
                }
                jo_ci = jo_ci + 1;
            }
            if jo_oidx < 0 {
                let mut jo_ai = 0;
                while jo_ai < ncols {
                    if jo_ai < vec_len(d.p_aliases) {
                        let jo_al = vec_get(d.p_aliases, jo_ai);
                        if jo_al >= 0 {
                            let jo_aln = sp_get(d, jo_al);
                            if jo_aln == jo_name {
                                if jo_oidx < 0 { jo_oidx = jo_ai; jo_af = vec_get(d.p_agg_funcs, jo_ai); }
                            }
                        }
                    }
                    jo_ai = jo_ai + 1;
                }
            }
            if jo_oidx < 0 {
                println!("Error: ORDER BY term '{}' is not a grouped column, aggregate, or alias", jo_name);
                return;
            }
            // Aggregate outputs sort numerically (COUNT integer, SUM/AVG/MIN/MAX
            // real); a plain key keeps its source column's declared type.
            let mut jo_type = 2;
            if jo_af == 1 { jo_type = 0; }
            else if jo_af > 1 { jo_type = 1; }
            else {
                let jo_argn = sp_get(d, vec_get(d.p_agg_cols, jo_oidx));
                let jo_r1 = resolve_col(d, cs1, cc1, tname1, d.alias1, jo_argn);
                if jo_r1 >= 0 { jo_type = vec_get(d.col_types, cs1 + jo_r1); }
                else {
                    let jo_r2 = resolve_col(d, cs2, cc2, tname2, d.alias2, jo_argn);
                    if jo_r2 >= 0 { jo_type = vec_get(d.col_types, cs2 + jo_r2); }
                }
            }
            // Stable selection sort over gkc rows, each ncols wide. A strict
            // `< 0` pick keeps equal keys in group-discovery order.
            let mut jo_used: Vec<i32> = vec![];
            let mut jo_u = 0;
            while jo_u < gkc { vec_push(jo_used, 0); jo_u = jo_u + 1; }
            let mut jo_sorted: Vec<i32> = vec![];
            let mut jo_picked = 0;
            while jo_picked < gkc {
                let mut jo_best = 0 - 1;
                let mut jo_j = 0;
                while jo_j < gkc {
                    if vec_get(jo_used, jo_j) == 0 {
                        if jo_best < 0 { jo_best = jo_j; }
                        else {
                            let jo_va = sp_get(d, vec_get(grows, jo_j * ncols + jo_oidx));
                            let jo_vb = sp_get(d, vec_get(grows, jo_best * ncols + jo_oidx));
                            let mut jo_c = compare_vals(jo_va, jo_vb, jo_type);
                            if d.order_desc == 1 { jo_c = 0 - jo_c; }
                            if jo_c < 0 { jo_best = jo_j; }
                        }
                    }
                    jo_j = jo_j + 1;
                }
                let mut jo_nu: Vec<i32> = vec![];
                let mut jo_k = 0;
                while jo_k < gkc {
                    if jo_k == jo_best { vec_push(jo_nu, 1); }
                    else { vec_push(jo_nu, vec_get(jo_used, jo_k)); }
                    jo_k = jo_k + 1;
                }
                jo_used = jo_nu;
                let mut jo_cp = 0;
                while jo_cp < ncols {
                    vec_push(jo_sorted, vec_get(grows, jo_best * ncols + jo_cp));
                    jo_cp = jo_cp + 1;
                }
                jo_picked = jo_picked + 1;
            }
            grows = jo_sorted;
        }

        // LIMIT / OFFSET over the group rows. Mirrors the single-table grouped
        // path exactly: skip OFFSET whole group rows, then take up to LIMIT,
        // each row being ncols pool ids. Applied after the ORDER BY sort so
        // "ORDER BY ... LIMIT n" returns the top n groups; LIMIT without ORDER BY
        // keeps group-discovery order like every other unordered path.
        if d.has_limit == 1 || d.has_offset == 1 {
            let mut lo_off = 0;
            if d.has_offset == 1 { lo_off = d.offset_val; }
            let mut lo_lim = gkc;
            if d.has_limit == 1 { lo_lim = d.limit_val; }
            let mut lo_grows: Vec<i32> = vec![];
            let mut lo_new = 0;
            let mut lo_taken = 0;
            let mut lo_i = lo_off;
            let mut lo_go = true;
            while lo_go {
                if lo_i >= gkc { lo_go = false; }
                else if lo_taken >= lo_lim { lo_go = false; }
                else {
                    let mut lo_c = 0;
                    while lo_c < ncols {
                        vec_push(lo_grows, vec_get(grows, lo_i * ncols + lo_c));
                        lo_c = lo_c + 1;
                    }
                    lo_new = lo_new + 1;
                    lo_taken = lo_taken + 1;
                    lo_i = lo_i + 1;
                }
            }
            grows = lo_grows;
            gkc = lo_new;
        }

        // Column widths, then render header, separator, one line per group.
        let mut gwidths: Vec<i32> = vec![];
        let mut wi = 0;
        while wi < ncols {
            let wh = sp_get(d, vec_get(gheaders, wi));
            vec_push(gwidths, wh.len());
            wi = wi + 1;
        }
        let mut wr = 0;
        while wr < gkc {
            let mut wc = 0;
            while wc < ncols {
                let wv = sp_get(d, vec_get(grows, wr * ncols + wc));
                let wl = dlen(wv);
                if wl > vec_get(gwidths, wc) { gwidths = vec_replace(gwidths, ncols, wc, wl); }
                wc = wc + 1;
            }
            wr = wr + 1;
        }
        let mut ghline = "";
        let mut gsline = "";
        let mut hp = 0;
        while hp < ncols {
            if hp > 0 { ghline = ghline + " | "; gsline = gsline + "-+-"; }
            let hh = sp_get(d, vec_get(gheaders, hp));
            rows_hdr(d, hh);
            let hw = vec_get(gwidths, hp);
            ghline = ghline + pad_right(hh, hw);
            gsline = gsline + make_dashes(hw);
            hp = hp + 1;
        }
        emit_line(d, ghline);
        emit_line(d, gsline);
        let mut rr = 0;
        while rr < gkc {
            let mut rline = "";
            let mut rc = 0;
            while rc < ncols {
                if rc > 0 { rline = rline + " | "; }
                let rv = sp_get(d, vec_get(grows, rr * ncols + rc));
                rows_cell(d, rv);
                let rw = vec_get(gwidths, rc);
                rline = rline + pad_right(rv, rw);
                rc = rc + 1;
            }
            emit_line(d, rline);
            rr = rr + 1;
        }
        return;
    }

    // GROUP BY over a JOIN without an aggregate is not yet supported. Fail closed
    // rather than return ungrouped rows, which would be a silent wrong answer.
    // Grouped aggregates are handled above.
    if d.has_group_by == 1 {
        println!("Error: GROUP BY over a JOIN is not supported");
        return;
    }

    // Resolve SELECT columns: each is "table.col" or "alias.col"
    // For each, determine which table (1 or 2) and column index
    let mut sel_table: Vec<i32> = vec![];
    let mut sel_col: Vec<i32> = vec![];
    let mut sel_names: Vec<i32> = vec![];
    let mut sel_count = 0;

    if d.select_star == 1 {
        // All columns from table1 then table2
        let mut ci = 0;
        while ci < cc1 {
            vec_push(sel_table, 1);
            vec_push(sel_col, ci);
            let cn = sp_get(d, vec_get(d.col_names, cs1 + ci));
            let nid = sp_add(d, cn);
            vec_push(sel_names, nid);
            sel_count = sel_count + 1;
            ci = ci + 1;
        }
        ci = 0;
        while ci < cc2 {
            vec_push(sel_table, 2);
            vec_push(sel_col, ci);
            let cn = sp_get(d, vec_get(d.col_names, cs2 + ci));
            let nid = sp_add(d, cn);
            vec_push(sel_names, nid);
            sel_count = sel_count + 1;
            ci = ci + 1;
        }
    } else {
        let mut pi = 0;
        while pi < d.p_agg_count {
            let cref = sp_get(d, vec_get(d.p_agg_cols, pi));
            // Try table1
            let c1 = resolve_col(d, cs1, cc1, tname1, d.alias1, cref);
            if c1 >= 0 {
                vec_push(sel_table, 1);
                vec_push(sel_col, c1);
                let cn = sp_get(d, vec_get(d.col_names, cs1 + c1));
                let nid = sp_add(d, cn);
                vec_push(sel_names, nid);
                sel_count = sel_count + 1;
            } else {
                let c2 = resolve_col(d, cs2, cc2, tname2, d.alias2, cref);
                if c2 >= 0 {
                    vec_push(sel_table, 2);
                    vec_push(sel_col, c2);
                    let cn = sp_get(d, vec_get(d.col_names, cs2 + c2));
                    let nid = sp_add(d, cn);
                    vec_push(sel_names, nid);
                    sel_count = sel_count + 1;
                } else {
                    println!("Error: column '{}' not found in either table", cref);
                    return;
                }
            }
            pi = pi + 1;
        }
    }

    // Nested loop join: collect matching result rows as pool-id strings
    // Store flattened: result_vals[row * sel_count + col] = pool id
    let mut result_vals: Vec<i32> = vec![];
    // Source row indices per emitted result row, kept parallel to result_vals so
    // ORDER BY can reorder rows after assembly. src_r2 = -1 marks a LEFT JOIN
    // null-extended row (the right side is NULL for that row).
    let mut src_r1: Vec<i32> = vec![];
    let mut src_r2: Vec<i32> = vec![];
    let mut result_count = 0;

    let mut r1 = 0;
    while r1 < rc1 {
        let key1 = sp_get(d, vec_get(d.cells, rs1 + r1 * cc1 + jc1));
        let mut matched = false;
        let mut r2 = 0;
        while r2 < rc2 {
            let key2 = sp_get(d, vec_get(d.cells, rs2 + r2 * cc2 + jc2));
            if key1 == key2 {
                // ON matched (equi-join key). Record it independently of WHERE so
                // a LEFT JOIN does not null-extend a left row that matched ON but
                // was later filtered by WHERE — matching SQL outer-join semantics.
                matched = true;
                // Check WHERE if present (evaluate against combined row)
                let mut passes = true;
                if d.has_where == 1 {
                    passes = eval_join_where(d, cs1, cc1, rs1, r1, tname1, d.alias1,
                                             cs2, cc2, rs2, r2, tname2, d.alias2);
                }
                if passes {
                    // Build result row
                    let mut si = 0;
                    while si < sel_count {
                        let st = vec_get(sel_table, si);
                        let sc = vec_get(sel_col, si);
                        let val = if st == 1 {
                            sp_get(d, vec_get(d.cells, rs1 + r1 * cc1 + sc))
                        } else {
                            sp_get(d, vec_get(d.cells, rs2 + r2 * cc2 + sc))
                        };
                        let vid = sp_add(d, val);
                        vec_push(result_vals, vid);
                        si = si + 1;
                    }
                    result_count = result_count + 1;
                    vec_push(src_r1, r1);
                    vec_push(src_r2, r2);
                }
            }
            r2 = r2 + 1;
        }
        // LEFT JOIN: a left row with no ON-match is emitted once with its
        // right-table columns as NULL (empty). WHERE still applies, evaluated
        // with the right columns treated as NULL (r2 = -1).
        if d.join_type == 1 {
            if matched == false {
                let mut lpasses = true;
                if d.has_where == 1 {
                    lpasses = eval_join_where(d, cs1, cc1, rs1, r1, tname1, d.alias1,
                                              cs2, cc2, rs2, 0 - 1, tname2, d.alias2);
                }
                if lpasses {
                    let mut si2 = 0;
                    while si2 < sel_count {
                        let st2 = vec_get(sel_table, si2);
                        let sc2 = vec_get(sel_col, si2);
                        let val2 = if st2 == 1 {
                            sp_get(d, vec_get(d.cells, rs1 + r1 * cc1 + sc2))
                        } else {
                            nullv()
                        };
                        let vid2 = sp_add(d, val2);
                        vec_push(result_vals, vid2);
                        si2 = si2 + 1;
                    }
                    result_count = result_count + 1;
                    vec_push(src_r1, r1);
                    vec_push(src_r2, 0 - 1);
                }
            }
        }
        r1 = r1 + 1;
    }

    // ORDER BY: the nested loop emits rows in left-table scan order, so apply
    // the sort here (single-table SELECT sorts in exec_select; joins reach this
    // path instead). A key resolves against either joined table, or as a 1-based
    // positional ordinal into the output columns (mapped back to its source
    // table + column so the key materialization below works unchanged); a key on
    // the right side of a null-extended LEFT JOIN row sorts as NULL (empty
    // string). An unresolvable key FAILS CLOSED rather than silently returning
    // scan order.
    if d.has_order == 1 {
        let oname = sp_get(d, d.order_col);
        let mut k1_tab = 0;
        let mut k1_col = 0 - 1;
        let mut k1_type = 2;
        if is_int_str(oname) {
            let n1 = parse_int_str(oname);
            if n1 >= 1 {
                if n1 <= sel_count {
                    let s1 = n1 - 1;
                    k1_tab = vec_get(sel_table, s1);
                    k1_col = vec_get(sel_col, s1);
                    if k1_tab == 1 { k1_type = vec_get(d.col_types, cs1 + k1_col); }
                    else { k1_type = vec_get(d.col_types, cs2 + k1_col); }
                }
            }
        } else {
            let rc_a = resolve_col(d, cs1, cc1, tname1, d.alias1, oname);
            if rc_a >= 0 {
                k1_tab = 1;
                k1_col = rc_a;
                k1_type = vec_get(d.col_types, cs1 + rc_a);
            } else {
                let rc_b = resolve_col(d, cs2, cc2, tname2, d.alias2, oname);
                if rc_b >= 0 {
                    k1_tab = 2;
                    k1_col = rc_b;
                    k1_type = vec_get(d.col_types, cs2 + rc_b);
                }
            }
        }
        if k1_tab == 0 {
            println!("Error: ORDER BY must name a column or a select position");
            return;
        }
        let mut k2_tab = 0;
        let mut k2_col = 0 - 1;
        let mut k2_type = 2;
        if d.order_col2 >= 0 {
            let oname2 = sp_get(d, d.order_col2);
            if is_int_str(oname2) {
                let n2 = parse_int_str(oname2);
                if n2 >= 1 {
                    if n2 <= sel_count {
                        let s2 = n2 - 1;
                        k2_tab = vec_get(sel_table, s2);
                        k2_col = vec_get(sel_col, s2);
                        if k2_tab == 1 { k2_type = vec_get(d.col_types, cs1 + k2_col); }
                        else { k2_type = vec_get(d.col_types, cs2 + k2_col); }
                    }
                }
            } else {
                let rc2a = resolve_col(d, cs1, cc1, tname1, d.alias1, oname2);
                if rc2a >= 0 {
                    k2_tab = 1;
                    k2_col = rc2a;
                    k2_type = vec_get(d.col_types, cs1 + rc2a);
                } else {
                    let rc2b = resolve_col(d, cs2, cc2, tname2, d.alias2, oname2);
                    if rc2b >= 0 {
                        k2_tab = 2;
                        k2_col = rc2b;
                        k2_type = vec_get(d.col_types, cs2 + rc2b);
                    }
                }
            }
            if k2_tab == 0 {
                println!("Error: ORDER BY must name a column or a select position");
                return;
            }
        }
        if k1_tab > 0 {
            // Materialize each result row's key strings from its source rows.
            let mut k1_vals: Vec<i32> = vec![];
            let mut k2_vals: Vec<i32> = vec![];
            let mut kr = 0;
            while kr < result_count {
                let rr1 = vec_get(src_r1, kr);
                let rr2 = vec_get(src_r2, kr);
                let v1 = if k1_tab == 1 {
                    sp_get(d, vec_get(d.cells, rs1 + rr1 * cc1 + k1_col))
                } else {
                    if rr2 < 0 { nullv() } else { sp_get(d, vec_get(d.cells, rs2 + rr2 * cc2 + k1_col)) }
                };
                vec_push(k1_vals, sp_add(d, v1));
                let v2 = if k2_tab == 1 {
                    sp_get(d, vec_get(d.cells, rs1 + rr1 * cc1 + k2_col))
                } else {
                    if k2_tab == 2 {
                        if rr2 < 0 { nullv() } else { sp_get(d, vec_get(d.cells, rs2 + rr2 * cc2 + k2_col)) }
                    } else {
                        ""
                    }
                };
                vec_push(k2_vals, sp_add(d, v2));
                kr = kr + 1;
            }
            // Stable selection sort of a row permutation by (k1, k2): only a
            // strict `<` displaces the current best, and j scans low-to-high, so
            // equal rows keep their original emission order.
            let mut used: Vec<i32> = vec![];
            let mut ui = 0;
            while ui < result_count { vec_push(used, 0); ui = ui + 1; }
            let mut perm: Vec<i32> = vec![];
            let mut picked = 0;
            while picked < result_count {
                let mut best = 0 - 1;
                let mut j = 0;
                while j < result_count {
                    if vec_get(used, j) == 0 {
                        if best < 0 {
                            best = j;
                        } else {
                            let va = sp_get(d, vec_get(k1_vals, j));
                            let vb = sp_get(d, vec_get(k1_vals, best));
                            let mut c = compare_vals(va, vb, k1_type);
                            if d.order_desc == 1 { c = 0 - c; }
                            let mut lt = false;
                            if c < 0 {
                                lt = true;
                            } else if c > 0 {
                                lt = false;
                            } else {
                                if k2_tab > 0 {
                                    let sa = sp_get(d, vec_get(k2_vals, j));
                                    let sb = sp_get(d, vec_get(k2_vals, best));
                                    let mut c2 = compare_vals(sa, sb, k2_type);
                                    if d.order_desc2 == 1 { c2 = 0 - c2; }
                                    if c2 < 0 { lt = true; }
                                }
                            }
                            if lt { best = j; }
                        }
                    }
                    j = j + 1;
                }
                let mut new_used: Vec<i32> = vec![];
                let mut k = 0;
                while k < result_count {
                    if k == best { vec_push(new_used, 1); }
                    else { vec_push(new_used, vec_get(used, k)); }
                    k = k + 1;
                }
                used = new_used;
                vec_push(perm, best);
                picked = picked + 1;
            }
            // Rebuild result_vals row-blocks in the sorted order.
            let mut sorted_vals: Vec<i32> = vec![];
            let mut pp = 0;
            while pp < result_count {
                let srcrow = vec_get(perm, pp);
                let mut cc_i = 0;
                while cc_i < sel_count {
                    vec_push(sorted_vals, vec_get(result_vals, srcrow * sel_count + cc_i));
                    cc_i = cc_i + 1;
                }
                pp = pp + 1;
            }
            result_vals = sorted_vals;
        }
    }

    // Calculate widths
    let mut widths: Vec<i32> = vec![];
    let mut wi = 0;
    while wi < sel_count {
        let hdr = sp_get(d, vec_get(sel_names, wi));
        vec_push(widths, hdr.len());
        wi = wi + 1;
    }
    let mut ri = 0;
    while ri < result_count {
        let mut ci = 0;
        while ci < sel_count {
            let val = sp_get(d, vec_get(result_vals, ri * sel_count + ci));
            let vlen = dlen(val);
            let old_w = vec_get(widths, ci);
            if vlen > old_w { widths = vec_replace(widths, sel_count, ci, vlen); }
            ci = ci + 1;
        }
        ri = ri + 1;
    }

    // Print
    let mut hdr_line = "";
    let mut sep_line = "";
    let mut hi = 0;
    while hi < sel_count {
        if hi > 0 { hdr_line = hdr_line + " | "; sep_line = sep_line + "-+-"; }
        let hdr = sp_get(d, vec_get(sel_names, hi));
        rows_hdr(d, hdr);
        let w = vec_get(widths, hi);
        hdr_line = hdr_line + pad_right(hdr, w);
        sep_line = sep_line + make_dashes(w);
        hi = hi + 1;
    }
    emit_line(d, hdr_line);
    emit_line(d, sep_line);

    ri = 0;
    while ri < result_count {
        let mut row_line = "";
        let mut ci = 0;
        while ci < sel_count {
            if ci > 0 { row_line = row_line + " | "; }
            let val = sp_get(d, vec_get(result_vals, ri * sel_count + ci));
            rows_cell(d, val);
            let w = vec_get(widths, ci);
            row_line = row_line + pad_right(val, w);
            ci = ci + 1;
        }
        emit_line(d, row_line);
        ri = ri + 1;
    }
}

// Fetch one cell value for an assembled JOIN pair. tab selects table 1 or 2;
// col is that table's column index. A LEFT JOIN null-extended pair carries
// r2 < 0, so a table-2 column reads as NULL.
fn join_cell_str(d: &DB, tab: i32, col: i32, cc1: i32, rs1: i32, r1: i32,
                 cc2: i32, rs2: i32, r2: i32) -> String {
    if tab == 1 {
        return sp_get(d, vec_get(d.cells, rs1 + r1 * cc1 + col));
    }
    if r2 < 0 { return nullv(); }
    sp_get(d, vec_get(d.cells, rs2 + r2 * cc2 + col))
}

// Fold the HAVING aggregate over the bucket pairs whose group cell equals gkey,
// using the same numeric/text rules as the grouped-JOIN projection fold. Returns
// the aggregate as a string so eval_where can compare it against the RHS literal.
// hstar marks COUNT(*); for COUNT(col)/SUM/AVG/MIN/MAX the arg column is at
// (atab, acol) with column type atype (2 = TEXT).
fn join_having_agg(d: &DB, haf: i32, hstar: bool, atab: i32, acol: i32, atype: i32,
                   gtab: i32, gcol: i32, cc1: i32, rs1: i32, cc2: i32, rs2: i32,
                   gpr1: Vec<i32>, gpr2: Vec<i32>, gpc: i32, gkey: String) -> String {
    if haf == 1 {
        // COUNT(*) counts bucket pairs; COUNT(col) counts non-NULL cells.
        let mut cnt = 0;
        let mut k = 0;
        while k < gpc {
            let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, k),
                                   cc2, rs2, vec_get(gpr2, k));
            if gv == gkey {
                if hstar { cnt = cnt + 1; }
                else {
                    let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(gpr1, k),
                                           cc2, rs2, vec_get(gpr2, k));
                    if !is_null(cv) { cnt = cnt + 1; }
                }
            }
            k = k + 1;
        }
        return int_to_str(cnt);
    }
    // SUM/AVG/MIN/MAX, mirroring the projection fold's af>=2 branch.
    let mut sum_val = 0.0;
    let mut min_val = 999999999.0;
    let mut max_val = 0.0 - 999999999.0;
    let mut min_str = "";
    let mut max_str = "";
    let mut cnt = 0;
    let mut k = 0;
    while k < gpc {
        let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, k),
                               cc2, rs2, vec_get(gpr2, k));
        if gv == gkey {
            let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(gpr1, k),
                                   cc2, rs2, vec_get(gpr2, k));
            if !is_null(cv) {
            let nv = cv.parse_float();
            sum_val = sum_val + nv;
            if cnt == 0 || nv < min_val { min_val = nv; }
            if cnt == 0 || nv > max_val { max_val = nv; }
            if atype == 2 {
                if cnt == 0 { min_str = cv; max_str = cv; }
                else {
                    if compare_vals(cv, min_str, atype) < 0 { min_str = cv; }
                    if compare_vals(cv, max_str, atype) > 0 { max_str = cv; }
                }
            }
            cnt = cnt + 1;
            }
        }
        k = k + 1;
    }
    if cnt == 0 { return nullv(); }
    if haf == 4 && atype == 2 { return min_str; }
    if haf == 5 && atype == 2 { return max_str; }
    let mut rv = sum_val;
    if haf == 3 { if cnt > 0 { rv = sum_val / (cnt as f64); } else { rv = 0.0; } }
    if haf == 4 { rv = min_val; }
    if haf == 5 { rv = max_val; }
    float_to_str(rv)
}

// Evaluate DNF condition ci for a JOIN row: resolve its column in either
// table, evaluate the operator, then apply the negate flag.
fn eval_cond_join(d: &DB, ci: i32, cs1: i32, cc1: i32, rs1: i32, r1: i32,
                  tname1: String, alias1: i32,
                  cs2: i32, cc2: i32, rs2: i32, r2: i32,
                  tname2: String, alias2: i32) -> i32 {
    let wl = sp_get(d, vec_get(d.wc_left, ci));
    let op = vec_get(d.wc_op, ci);
    let c1 = resolve_col(d, cs1, cc1, tname1, alias1, wl);
    let c2 = resolve_col(d, cs2, cc2, tname2, alias2, wl);
    let mut res = 0;
    if c1 >= 0 {
        let cv = sp_get(d, vec_get(d.cells, rs1 + r1 * cc1 + c1));
        res = eval_cond_val(d, ci, op, cv);
    } else if c2 >= 0 {
        // r2 < 0 marks a LEFT JOIN null-extended row: the right table has no
        // matching row, so its columns evaluate as NULL.
        let cv = if r2 < 0 { nullv() } else { sp_get(d, vec_get(d.cells, rs2 + r2 * cc2 + c2)) };
        res = eval_cond_val(d, ci, op, cv);
    } else {
        if op == 8 { res = 1; }
    }
    if vec_get(d.wc_neg, ci) == 1 { res = not3(res); }
    res
}

// Recursively evaluate the WHERE boolean-expression tree for a JOIN row (either
// table). node < 0 is true; leaf (0) evaluates its condition via eval_cond_join;
// NOT (3) negates its child; AND (1) / OR (2) combine both children.
fn eval_join_tree(d: &DB, node: i32, cs1: i32, cc1: i32, rs1: i32, r1: i32,
                  tname1: String, alias1: i32,
                  cs2: i32, cc2: i32, rs2: i32, r2: i32,
                  tname2: String, alias2: i32) -> i32 {
    if node < 0 { return 1; }
    let k = vec_get(d.wn_kind, node);
    if k == 0 {
        return eval_cond_join(d, vec_get(d.wn_a, node), cs1, cc1, rs1, r1, tname1, alias1, cs2, cc2, rs2, r2, tname2, alias2);
    }
    if k == 3 {
        return not3(eval_join_tree(d, vec_get(d.wn_a, node), cs1, cc1, rs1, r1, tname1, alias1, cs2, cc2, rs2, r2, tname2, alias2));
    }
    let la = eval_join_tree(d, vec_get(d.wn_a, node), cs1, cc1, rs1, r1, tname1, alias1, cs2, cc2, rs2, r2, tname2, alias2);
    let rb = eval_join_tree(d, vec_get(d.wn_b, node), cs1, cc1, rs1, r1, tname1, alias1, cs2, cc2, rs2, r2, tname2, alias2);
    if k == 1 { return and3(la, rb); }
    if k == 2 { return or3(la, rb); }
    1
}

// Evaluate WHERE for a JOIN row (checks both tables) by walking the
// boolean-expression tree from wc_root.
fn eval_join_where(d: &DB, cs1: i32, cc1: i32, rs1: i32, r1: i32,
                   tname1: String, alias1: i32,
                   cs2: i32, cc2: i32, rs2: i32, r2: i32,
                   tname2: String, alias2: i32) -> bool {
    if d.has_where == 0 { return true; }
    if d.wc_count == 0 { return true; }
    eval_join_tree(d, d.wc_root, cs1, cc1, rs1, r1, tname1, alias1, cs2, cc2, rs2, r2, tname2, alias2) == 1
}

// Execute UPDATE. Scans all cells for the target table, replacing the
// SET column value for rows that match the WHERE condition. Rebuilds
// the entire cells array (no in-place mutation due to Vec immutability
// constraints). Rebuilds affected indexes afterward.
// The index whose sorted entries give every row an UPDATE or DELETE WHERE
// can match, or -1. Only a WHERE that is one bare equality on an indexed
// column qualifies. The index's equality search uses compare_vals, which
// on a TEXT column compares text while eval_where compares two numeric
// strings as numbers ('1' = '1.0'); so on a TEXT column a numeric right side
// does not qualify. Callers still check each candidate against the WHERE.
fn where_eq_index(d: &mut DB, tidx: i32, cs: i32, cc: i32, tname: String) -> i32 {
    if d.has_where != 1 || d.wc_count != 1 || d.wn_count != 1 { return 0 - 1; }
    if vec_get(d.wc_neg, 0) != 0 || vec_get(d.wc_op, 0) != 0 { return 0 - 1; }
    let wcol = resolve_col(d, cs, cc, tname, d.alias1, sp_get(d, vec_get(d.wc_left, 0)));
    if wcol < 0 { return 0 - 1; }
    let ix = find_index_for(d, tidx, wcol);
    if ix < 0 { return 0 - 1; }
    let ctype = vec_get(d.col_types, cs + wcol);
    let wr = sp_get(d, vec_get(d.wc_right, 0));
    if ctype != 0 && ctype != 1 && is_numeric_str(wr) { return 0 - 1; }
    refresh_index(d, ix);
    ix
}

// The rows of table tidx that the WHERE matches, in row order: through
// where_eq_index when it applies, else by a scan.
fn where_rows(d: &mut DB, tidx: i32, cs: i32, cc: i32, rs: i32, rc: i32, tname: String) -> Vec<i32> {
    let mut out: Vec<i32> = vec![];
    let ix = where_eq_index(d, tidx, cs, cc, tname);
    if ix >= 0 {
        let cand = index_scan(d, ix, 0, sp_get(d, vec_get(d.wc_right, 0)));
        let mut i = 0;
        while i < vec_len(cand) {
            let r = vec_get(cand, i);
            if eval_compound_where(d, cs, cc, rs, r, tname, d.alias1) { vec_push(out, r); }
            i = i + 1;
        }
        // Equal keys sit in row order in the index, so out is ascending.
        return out;
    }
    let mut r = 0;
    while r < rc {
        if eval_compound_where(d, cs, cc, rs, r, tname, d.alias1) { vec_push(out, r); }
        r = r + 1;
    }
    out
}

// Order of index entry e (absolute position in idx_keys) against the pair
// (key, row): by key under compare_vals, then by row id.
fn ix_cmp(d: &DB, e: i32, key: String, row: i32, col_type: i32) -> i64 {
    let c = compare_vals(sp_get(d, vec_get(d.idx_keys, e)), key, col_type);
    if c != 0 { return c; }
    vec_get(d.idx_rowids, e) - row
}

// First position in [ks, ks + kc) whose entry is not below (key, row).
fn ix_lower(d: &DB, ks: i32, kc: i32, key: String, row: i32, col_type: i32) -> i32 {
    let mut lo = ks;
    let mut hi = ks + kc;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if ix_cmp(d, mid, key, row, col_type) < 0 { lo = mid + 1; } else { hi = mid; }
    }
    lo
}

// Row `row` of index ix changed its key from old_id to new_id (pool ids):
// move its entry to the sorted place a rebuild would give it, shifting only
// the entries between the two places. Returns false when the entry is not
// where the index says (the caller then rebuilds).
fn ix_move(d: &mut DB, ix: i32, row: i32, old_id: i32, new_id: i32, col_type: i32) -> bool {
    let ks = vec_get(d.idx_key_starts, ix);
    let kc = vec_get(d.idx_key_counts, ix);
    let p = ix_lower(d, ks, kc, sp_get(d, old_id), row, col_type);
    if p >= ks + kc { return false; }
    if vec_get(d.idx_rowids, p) != row { return false; }
    let mut q = ix_lower(d, ks, kc, sp_get(d, new_id), row, col_type);
    let keys = d.idx_keys;
    let rids = d.idx_rowids;
    if q > p {
        q = q - 1;
        let mut i = p;
        while i < q {
            keys[i] = vec_get(keys, i + 1);
            rids[i] = vec_get(rids, i + 1);
            i = i + 1;
        }
    } else {
        let mut i = p;
        while i > q {
            keys[i] = vec_get(keys, i - 1);
            rids[i] = vec_get(rids, i - 1);
            i = i - 1;
        }
    }
    keys[q] = new_id;
    rids[q] = row;
    true
}

// Copy of row `base` (cell position of its first column) of cc cells with
// column scol set to new_id, for computing the row's new constraint keys.
fn row_with(d: &DB, base: i32, cc: i32, scol: i32, new_id: i32) -> Vec<i32> {
    let mut tmp: Vec<i32> = vec![];
    let mut c = 0;
    while c < cc {
        if c == scol { vec_push(tmp, new_id); } else { vec_push(tmp, vec_get(d.cells, base + c)); }
        c = c + 1;
    }
    tmp
}

// Check the constraints on column scol of table t for an UPDATE that sets
// rows[i] (table row numbers) to new_ids[i]. The rule is the one the whole-
// table check had: the table as it would be after the UPDATE must hold every
// constraint. Unique keys go through the key map: a new key fails when
// another row that keeps its key holds it, or when two changed rows share
// it. Returns the error text, or "". On success the map is brought up to
// date (or marked for a rebuild when an INTEGER PRIMARY KEY changed).
fn con_check_update(d: &mut DB, t: i32, rs: i32, cc: i32, scol: i32, rows: Vec<i32>, new_ids: Vec<i32>, n: i32) -> String {
    let mut map_fix = false;
    let mut ipk_moved = false;
    let mut k = 0;
    while k < vec_len(d.con_tbl) {
        let mut on = false;
        if vec_get(d.con_tbl, k) == t {
            let st = vec_get(d.con_cs, k);
            let mut j = 0;
            while j < vec_get(d.con_cn, k) { if vec_get(d.con_cols, st + j) == scol { on = true; } j = j + 1; }
        }
        if on {
            if vec_get(d.con_kind, k) == 2 {
                let mut i = 0;
                while i < n {
                    if is_null(sp_get(d, vec_get(new_ids, i))) { return con_fail_text(d, k, t); }
                    i = i + 1;
                }
            } else {
                if !d.con_map_ok { con_map_build(d); }
                if con_is_ipk(d, k) { ipk_moved = true; }
                let olds: HashMap<String, f64> = map_new();
                let news: HashMap<String, f64> = map_new();
                let mut i = 0;
                while i < n {
                    let ok = con_key(d, k, d.cells, rs + vec_get(rows, i) * cc);
                    if ok.len() > 0 { map_insert(olds, ok, 1.0); }
                    i = i + 1;
                }
                i = 0;
                while i < n {
                    let tmp = row_with(d, rs + vec_get(rows, i) * cc, cc, scol, vec_get(new_ids, i));
                    let nk = con_key(d, k, tmp, 0);
                    if nk.len() > 0 {
                        if map_contains(d.con_map, nk) && !map_contains(olds, nk) { return con_fail_text(d, k, t); }
                        if map_contains(news, nk) { return con_fail_text(d, k, t); }
                        map_insert(news, nk, 1.0);
                    }
                    i = i + 1;
                }
                map_fix = true;
            }
        }
        k = k + 1;
    }
    if !map_fix { return ""; }
    // The largest INTEGER PRIMARY KEY may have moved down: rebuild on next use.
    if ipk_moved { d.con_map_ok = false; return ""; }
    // Every constraint holds: swap the changed rows' old keys for the new.
    k = 0;
    while k < vec_len(d.con_tbl) {
        if vec_get(d.con_tbl, k) == t && vec_get(d.con_kind, k) != 2 {
            let mut i = 0;
            while i < n {
                let ok = con_key(d, k, d.cells, rs + vec_get(rows, i) * cc);
                if ok.len() > 0 { map_remove(d.con_map, ok); }
                i = i + 1;
            }
            i = 0;
            while i < n {
                let tmp = row_with(d, rs + vec_get(rows, i) * cc, cc, scol, vec_get(new_ids, i));
                let nk = con_key(d, k, tmp, 0);
                if nk.len() > 0 { map_insert(d.con_map, nk, 1.0); }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    ""
}

fn exec_update(d: &mut DB) ~ Console {
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        d.stmt_failed = true;
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // Validate the WHERE columns before mutating any cell, so an unknown column
    // leaves the table untouched instead of silently updating zero rows.
    if !where_cols_ok(d, cs, cc, tname, d.alias1) { return; }

    let set_col_name = sp_get(d, d.set_col);
    let set_val_text = sp_get(d, d.set_val);
    let scol = find_col(d, cs, cc, set_col_name);
    if scol < 0 {
        d.stmt_failed = true;
        println!("Error: column '{}' not found", set_col_name);
        return;
    }

    // Arithmetic RHS (SET col = col <op> literal): validate before mutating.
    let mut operand_int = 0;
    if d.set_op >= 0 {
        let left_name = sp_get(d, d.set_val);
        if left_name != set_col_name {
            d.stmt_failed = true;
            println!("Error: UPDATE arithmetic must reference column '{}'", set_col_name);
            return;
        }
        let operand_txt = sp_get(d, d.set_operand);
        if is_int_str(operand_txt) == false {
            d.stmt_failed = true;
            println!("Error: UPDATE arithmetic operand must be an integer");
            return;
        }
        operand_int = parse_int_str(operand_txt);
        if d.set_op == 3 {
            if operand_int == 0 {
                d.stmt_failed = true;
                println!("Error: UPDATE division by zero");
                return;
            }
        }
    }

    // P20: find the rows, compute every new value and check the constraints
    // before any cell changes; then write the changed cells in place and move
    // their entries in the indexes on the SET column.
    let rows = where_rows(d, tidx, cs, cc, rs, rc, tname);
    let n = vec_len(rows);
    if n == 0 { return; }
    let new_val_id = sp_add(d, set_val_text);
    let mut new_ids: Vec<i32> = vec![];
    let mut arith_err = false;
    let mut i = 0;
    while i < n {
        let mut cell_id = new_val_id;
        if d.set_op >= 0 {
            let cur = sp_get(d, vec_get(d.cells, rs + vec_get(rows, i) * cc + scol));
            if is_int_str(cur) {
                let a = parse_int_str(cur);
                let mut r = 0;
                if d.set_op == 0 { r = a + operand_int; }
                else if d.set_op == 1 { r = a - operand_int; }
                else if d.set_op == 2 { r = a * operand_int; }
                else { r = a / operand_int; }
                cell_id = sp_add(d, int_to_str(r));
            } else {
                arith_err = true;
            }
        }
        vec_push(new_ids, cell_id);
        i = i + 1;
    }
    if arith_err {
        d.stmt_failed = true;
        println!("Error: UPDATE arithmetic on a non-integer value in column '{}'", set_col_name);
        return;
    }
    update_apply(d, tidx, cs, cc, rs, scol, rows, new_ids, n as i32);
}

// The second half of an UPDATE (P20): check the constraints, write the new
// cells in place and move their entries in the indexes on the SET column.
// exec_update and a prepared UPDATE (P25) both end here.
fn update_apply(d: &mut DB, tidx: i32, cs: i32, cc: i32, rs: i32, scol: i32, rows: Vec<i32>, new_ids: Vec<i32>, n: i32) ~ Console {
    let mut i = 0;
    let err = con_check_update(d, tidx, rs, cc, scol, rows, new_ids, n);
    if err.len() > 0 {
        d.stmt_failed = true;
        println!("Error: {}", err);
        return;
    }
    let mut old_ids: Vec<i32> = vec![];
    let cells = d.cells;
    i = 0;
    while i < n {
        let pos = rs + vec_get(rows, i) * cc + scol;
        vec_push(old_ids, vec_get(cells, pos));
        cells[pos] = vec_get(new_ids, i);
        i = i + 1;
    }
    // A stale index is rebuilt from the cells on its next read, and rows past
    // an index's count are folded in from the cells by merge_new_rows; only
    // entries already in a current index move.
    if d.idx_stale { return; }
    let ctype = vec_get(d.col_types, cs + scol);
    let mut ix = 0;
    while ix < d.idx_count {
        if vec_get(d.idx_tables, ix) == tidx && vec_get(d.idx_col_indices, ix) == scol {
            let kc = vec_get(d.idx_key_counts, ix);
            if n > 64 && n * 8 > kc {
                rebuild_index(d, ix);
            } else {
                let mut ok = true;
                i = 0;
                while i < n && ok {
                    let r = vec_get(rows, i);
                    if r < kc {
                        if vec_get(old_ids, i) != vec_get(new_ids, i) {
                            ok = ix_move(d, ix, r, vec_get(old_ids, i), vec_get(new_ids, i), ctype);
                        }
                    }
                    i = i + 1;
                }
                if !ok { rebuild_index(d, ix); }
            }
        }
        ix = ix + 1;
    }
}

// REPLACE (P24), in SQLite's order: each new row in turn removes every row
// whose UNIQUE or PRIMARY KEY key equals its own (NULL keys never clash),
// then goes in. Here the batch is settled first: a row that a later row of
// the same statement clashes with is dropped, then the table rows the
// remaining rows clash with are deleted. NOT NULL is checked before anything
// is deleted, so a failing REPLACE changes nothing. Returns the kept rows.
fn replace_prepare(d: &mut DB, t: i32, rows: Vec<i32>, nrows: i32) -> Vec<i32> ~ Console {
    let cc = vec_get(d.tbl_col_counts, t);
    let mut k = 0;
    while k < vec_len(d.con_tbl) {
        if vec_get(d.con_tbl, k) == t && vec_get(d.con_kind, k) == 2 && !con_is_ipk(d, k) {
            let c0 = vec_get(d.con_cols, vec_get(d.con_cs, k));
            let mut r = 0;
            while r < nrows {
                if is_null(sp_get(d, vec_get(rows, r * cc + c0))) {
                    d.stmt_failed = true;
                    println!("Error: {}", con_fail_text(d, k, t));
                    return rows;
                }
                r = r + 1;
            }
        }
        k = k + 1;
    }
    // keys[k] of each batch row, and whether a later row clashes with it.
    let mut keep: Vec<i32> = vec![];
    let mut r = 0;
    while r < nrows { vec_push(keep, 1); r = r + 1; }
    k = 0;
    while k < vec_len(d.con_tbl) {
        if vec_get(d.con_tbl, k) == t && vec_get(d.con_kind, k) != 2 {
            let last: HashMap<String, f64> = map_new();
            r = nrows - 1;
            while r >= 0 {
                let key = con_key(d, k, rows, r * cc);
                if key.len() > 0 {
                    if map_contains(last, key) { keep[r] = 0; }
                    else { map_insert(last, key, 1.0); }
                }
                r = r - 1;
            }
        }
        k = k + 1;
    }
    let mut out: Vec<i32> = vec![];
    r = 0;
    while r < nrows {
        if vec_get(keep, r) == 1 {
            let mut c = 0;
            while c < cc { vec_push(out, vec_get(rows, r * cc + c)); c = c + 1; }
        }
        r = r + 1;
    }
    let nout = vec_len(out) / cc;
    // Table rows whose key equals a kept row's key, by one scan per constraint.
    let rs = vec_get(d.tbl_row_starts, t);
    let rc = vec_get(d.tbl_row_counts, t);
    let mut hit: Vec<i32> = vec![];
    r = 0;
    while r < rc { vec_push(hit, 0); r = r + 1; }
    let mut any = false;
    k = 0;
    while k < vec_len(d.con_tbl) {
        if vec_get(d.con_tbl, k) == t && vec_get(d.con_kind, k) != 2 {
            let want: HashMap<String, f64> = map_new();
            r = 0;
            while r < nout {
                let key = con_key(d, k, out, r * cc);
                if key.len() > 0 { map_insert(want, key, 1.0); }
                r = r + 1;
            }
            if map_len(want) > 0 {
                r = 0;
                while r < rc {
                    let key = con_key(d, k, d.cells, rs + r * cc);
                    if key.len() > 0 && map_contains(want, key) { hit[r] = 1; any = true; }
                    r = r + 1;
                }
            }
        }
        k = k + 1;
    }
    if any {
        let mut del: Vec<i32> = vec![];
        r = 0;
        while r < rc { if vec_get(hit, r) == 1 { vec_push(del, r); } r = r + 1; }
        delete_rows(d, t, del);
        // The deleted rows' keys leave the key map with a rebuild.
        d.con_map_ok = false;
    }
    out
}

// Execute DELETE FROM in place (P20): compact the table's rows and every
// later cell down over the deleted ones, truncate the array, and renumber
// the row ids in the table's indexes in one integer pass (no sort).
fn exec_delete(d: &mut DB) ~ Console {
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        d.stmt_failed = true;
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // Validate the WHERE columns before deciding which rows to drop, so an
    // unknown column deletes nothing instead of silently matching zero rows.
    if !where_cols_ok(d, cs, cc, tname, d.alias1) { return; }

    let del = where_rows(d, tidx, cs, cc, rs, rc, tname);
    delete_rows(d, tidx, del);
}

// Delete rows del (ascending row numbers) of table tidx in place: compact
// the table's rows and every later cell, truncate the array, and renumber
// the table's index row ids (P20).
fn delete_rows(d: &mut DB, tidx: i32, del: Vec<i32>) {
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);
    let deleted = vec_len(del);
    if deleted == 0 { return; }

    // newid[r]: row r's number after the delete, or -1 when it goes.
    let mut newid: Vec<i32> = vec![];
    let mut r = 0;
    let mut di = 0;
    let mut kept = 0;
    while r < rc {
        if di < deleted && vec_get(del, di) == r {
            vec_push(newid, 0 - 1);
            di = di + 1;
        } else {
            vec_push(newid, kept);
            kept = kept + 1;
        }
        r = r + 1;
    }

    // Compact: kept rows from the first deleted one on, then every later cell.
    let cells = d.cells;
    let total_cells = vec_len(cells);
    let first = vec_get(del, 0);
    let mut w: i64 = rs + first * cc;
    r = first;
    while r < rc {
        if vec_get(newid, r) >= 0 {
            let src = rs + r * cc;
            let mut c = 0;
            while c < cc { cells[w] = vec_get(cells, src + c); w = w + 1; c = c + 1; }
        }
        r = r + 1;
    }
    let mut ci: i64 = rs + rc * cc;
    while ci < total_cells { cells[w] = vec_get(cells, ci); w = w + 1; ci = ci + 1; }
    let shift = deleted * cc;
    let mut p = 0;
    while p < shift { vec_pop(cells); p = p + 1; }

    let trc = d.tbl_row_counts;
    trc[tidx] = kept;
    let trs = d.tbl_row_starts;
    let mut si = tidx + 1;
    while si < d.tbl_count {
        trs[si] = vec_get(trs, si) - shift;
        si = si + 1;
    }

    if d.idx_stale { return; }
    // Renumber the table's indexes: drop the deleted rows' entries, map the
    // rest through newid (order kept, since newid is increasing), and close
    // the gap in the flattened arrays.
    let keys = d.idx_keys;
    let rids = d.idx_rowids;
    let kcs = d.idx_key_counts;
    let kss = d.idx_key_starts;
    let mut ix = 0;
    while ix < d.idx_count {
        if vec_get(d.idx_tables, ix) == tidx {
            let ks = vec_get(kss, ix);
            let kc = vec_get(kcs, ix);
            let mut out = ks;
            let mut e = ks;
            while e < ks + kc {
                let nr = vec_get(newid, vec_get(rids, e));
                if nr >= 0 {
                    keys[out] = vec_get(keys, e);
                    rids[out] = nr;
                    out = out + 1;
                }
                e = e + 1;
            }
            let gone = ks + kc - out;
            if gone > 0 {
                let mut m = ks + kc;
                let end = vec_len(keys);
                while m < end {
                    keys[m - gone] = vec_get(keys, m);
                    rids[m - gone] = vec_get(rids, m);
                    m = m + 1;
                }
                let mut q = 0;
                while q < gone { vec_pop(keys); vec_pop(rids); q = q + 1; }
                kcs[ix] = kc - gone;
                let mut j = ix + 1;
                while j < d.idx_count {
                    kss[j] = vec_get(kss, j) - gone;
                    j = j + 1;
                }
            }
        }
        ix = ix + 1;
    }
}

fn exec_drop(d: &mut DB) ~ Console {
    d.schema_ver = d.schema_ver + 1;
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        d.stmt_failed = true;
        println!("Error: table '{}' not found", tname);
        return;
    }

    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);
    let cell_count = rc * cc;

    // Rebuild all arrays without this table

    // Remove cells
    let total_cells = vec_len(d.cells);
    let mut new_cells: Vec<i32> = vec![];
    let mut ci: i64 = 0;
    while ci < rs {
        vec_push(new_cells, vec_get(d.cells, ci));
        ci = ci + 1;
    }
    ci = rs + cell_count;
    while ci < total_cells {
        vec_push(new_cells, vec_get(d.cells, ci));
        ci = ci + 1;
    }
    d.cells = new_cells;

    // Remove column defs
    let total_cols = vec_len(d.col_names);
    let mut new_cn: Vec<i32> = vec![];
    let mut new_ct: Vec<i32> = vec![];
    let mut coi: i64 = 0;
    while coi < total_cols {
        if coi < cs || coi >= cs + cc {
            vec_push(new_cn, vec_get(d.col_names, coi));
            vec_push(new_ct, vec_get(d.col_types, coi));
        }
        coi = coi + 1;
    }
    d.col_names = new_cn;
    d.col_types = new_ct;

    // Rebuild table arrays
    let mut new_tn: Vec<i32> = vec![];
    let mut new_tcs: Vec<i32> = vec![];
    let mut new_tcc: Vec<i32> = vec![];
    let mut new_trs: Vec<i32> = vec![];
    let mut new_trc: Vec<i32> = vec![];
    let mut ti = 0;
    while ti < d.tbl_count {
        if ti != tidx {
            vec_push(new_tn, vec_get(d.tbl_names, ti));
            let old_cs = vec_get(d.tbl_col_starts, ti);
            let adj_cs = if ti > tidx { old_cs - cc } else { old_cs };
            vec_push(new_tcs, adj_cs);
            vec_push(new_tcc, vec_get(d.tbl_col_counts, ti));
            let old_rs = vec_get(d.tbl_row_starts, ti);
            let adj_rs = if ti > tidx { old_rs - cell_count } else { old_rs };
            vec_push(new_trs, adj_rs);
            vec_push(new_trc, vec_get(d.tbl_row_counts, ti));
        }
        ti = ti + 1;
    }
    d.tbl_names = new_tn;
    d.tbl_col_starts = new_tcs;
    d.tbl_col_counts = new_tcc;
    d.tbl_row_starts = new_trs;
    d.tbl_row_counts = new_trc;
    d.tbl_count = d.tbl_count - 1;
    let mut nt: Vec<i32> = vec![];
    let mut nk: Vec<i32> = vec![];
    let mut ns: Vec<i32> = vec![];
    let mut nn: Vec<i32> = vec![];
    let mut k = 0;
    while k < vec_len(d.con_tbl) {
        let t = vec_get(d.con_tbl, k);
        if t != tidx {
            vec_push(nt, if t > tidx { t - 1 } else { t });
            vec_push(nk, vec_get(d.con_kind, k));
            vec_push(ns, vec_get(d.con_cs, k));
            vec_push(nn, vec_get(d.con_cn, k));
        }
        k = k + 1;
    }
    d.con_tbl = nt;
    d.con_kind = nk;
    d.con_cs = ns;
    d.con_cn = nn;
}

// =============================================================================
// ALTER TABLE ADD COLUMN
// =============================================================================
fn exec_alter_table(d: &mut DB) ~ Console {
    d.schema_ver = d.schema_ver + 1;
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        d.stmt_failed = true;
        println!("Error: table '{}' not found", tname);
        return;
    }

    let new_col_name = sp_get(d, d.alter_col_name);
    let new_col_type_str = sp_get(d, d.alter_col_type);
    let type_up = new_col_type_str.to_uppercase();
    let ct = type_code_for(type_up);

    let cs = vec_get(d.tbl_col_starts, tidx);
    let old_cc = vec_get(d.tbl_col_counts, tidx);
    let new_cc = old_cc + 1;
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // 1. Insert the new column definition into col_names/col_types at position cs + old_cc
    let insert_col_at = cs + old_cc;
    let total_cols = vec_len(d.col_names);
    let mut new_cn: Vec<i32> = vec![];
    let mut new_ct: Vec<i32> = vec![];
    let mut ci: i64 = 0;
    while ci < insert_col_at {
        vec_push(new_cn, vec_get(d.col_names, ci));
        vec_push(new_ct, vec_get(d.col_types, ci));
        ci = ci + 1;
    }
    let cnid = sp_add(d, new_col_name);
    vec_push(new_cn, cnid);
    vec_push(new_ct, ct);
    while ci < total_cols {
        vec_push(new_cn, vec_get(d.col_names, ci));
        vec_push(new_ct, vec_get(d.col_types, ci));
        ci = ci + 1;
    }
    d.col_names = new_cn;
    d.col_types = new_ct;

    // 2. Update tbl_col_counts for this table
    d.tbl_col_counts = vec_replace(d.tbl_col_counts, d.tbl_count, tidx, new_cc);

    // 3. Shift col_starts for tables after this one (they gained 1 col def)
    let mut new_tcs: Vec<i32> = vec![];
    let mut ti = 0;
    while ti < d.tbl_count {
        if ti > tidx {
            vec_push(new_tcs, vec_get(d.tbl_col_starts, ti) + 1);
        } else {
            vec_push(new_tcs, vec_get(d.tbl_col_starts, ti));
        }
        ti = ti + 1;
    }
    d.tbl_col_starts = new_tcs;

    // 4. For each existing row, insert an empty-string cell at the end of that row's data.
    // New cells are SQL NULL.
    let null_id = sp_add(d, nullv());
    let total_cells = vec_len(d.cells);
    let mut new_cells: Vec<i32> = vec![];

    // Copy cells before this table
    let mut cell_i: i64 = 0;
    while cell_i < rs {
        vec_push(new_cells, vec_get(d.cells, cell_i));
        cell_i = cell_i + 1;
    }

    // For each row in the table, copy old_cc cells then add NULL
    let mut r = 0;
    while r < rc {
        let row_start = rs + r * old_cc;
        let mut col = 0;
        while col < old_cc {
            vec_push(new_cells, vec_get(d.cells, row_start + col));
            col = col + 1;
        }
        vec_push(new_cells, null_id);
        r = r + 1;
    }

    // Copy cells after this table
    cell_i = rs + rc * old_cc;
    while cell_i < total_cells {
        vec_push(new_cells, vec_get(d.cells, cell_i));
        cell_i = cell_i + 1;
    }
    d.cells = new_cells;

    // 5. Update row_starts for tables after this one
    // Each row grew by 1 cell, so total added = rc cells
    let shift = rc;
    let mut new_trs: Vec<i32> = vec![];
    let mut si = 0;
    while si < d.tbl_count {
        if si > tidx {
            vec_push(new_trs, vec_get(d.tbl_row_starts, si) + shift);
        } else {
            vec_push(new_trs, vec_get(d.tbl_row_starts, si));
        }
        si = si + 1;
    }
    d.tbl_row_starts = new_trs;

    // 6. Rebuild indexes for this table
    update_indexes_for_table(d, tidx);
}

// =========================================================================
// SECTION 7: HELPERS — WHERE Evaluation, Sorting, Formatting
// =========================================================================
// Pure or nearly-pure helper functions used by the executor.
//
// WHERE evaluation:
//   eval_where()          — evaluate a single comparison (op codes 0-9)
//   eval_compound_where() — evaluate the DNF WHERE (OR of AND-groups) for a row
//   eval_like()           — LIKE pattern matching (%, starts_with/ends_with/contains)
//   eval_in_pool()        — IN membership test against a condition's pool slice
//
// Sorting:
//   sort_rows()           — stable merge sort on row indices by column value
//   compare_vals()        — compare two values (numeric or string)
//
// Formatting:
//   pad_right(), pad_left(), make_dashes() — output alignment
//   print_result_row()    — print a single formatted result row
// =========================================================================

fn get_cell_float(d: &DB, rs: i32, row: i32, cc: i32, col_idx: i32) -> f64 {
    let cell_val = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
    cell_val.parse_float()
}

fn find_col(d: &DB, cs: i32, cc: i32, name: String) -> i32 {
    let mut i = 0;
    while i < cc {
        let cn = sp_get(d, vec_get(d.col_names, cs + i));
        if cn == name { return i; }
        i = i + 1;
    }
    0 - 1
}

fn eval_where(cell_val: String, op: i32, rval: String) -> bool {
    // IS [NOT] NULL test the NULL value; any other operator with a NULL
    // operand is unknown, which a filter treats as false.
    if op == 8 { return is_null(cell_val); }
    if op == 9 { return !is_null(cell_val); }
    if is_null(cell_val) || is_null(rval) { return false; }
    // Try numeric comparison first
    let cv_num = cell_val.parse_float();
    let rv_num = rval.parse_float();
    let is_num_cmp = is_numeric_str(cell_val) && is_numeric_str(rval);

    // LIKE operator (op 6)
    if op == 6 { return eval_like(cell_val, rval); }
    // IN (op 7) is handled separately in eval_compound_where

    if is_num_cmp {
        if op == 0 { return cv_num == rv_num; }
        if op == 1 { return cv_num < rv_num; }
        if op == 2 { return cv_num > rv_num; }
        if op == 3 { return cv_num <= rv_num; }
        if op == 4 { return cv_num >= rv_num; }
        if op == 5 { return cv_num != rv_num; }
    }
    // String comparison
    let cmp = cell_val.compare(rval);
    if op == 0 { return cmp == 0; }
    if op == 1 { return cmp < 0; }
    if op == 2 { return cmp > 0; }
    if op == 3 { return cmp <= 0; }
    if op == 4 { return cmp >= 0; }
    if op == 5 { return cmp != 0; }
    false
}

// LIKE pattern matching. Full SQL wildcards: '%' matches any run of characters
// (including none) at any position; '_' matches exactly one character. All other
// characters match literally. Iterative backtracking, so '%' anywhere is handled.
fn eval_like(cell_val: String, pattern: String) -> bool {
    let slen = cell_val.len();
    let plen = pattern.len();
    let mut si = 0;
    let mut pi = 0;
    let mut star = -1;   // pattern index just after the last '%' seen, or -1
    let mut star_s = 0;  // string index to resume from on backtrack
    let mut decided = false;
    let mut result = false;
    let mut go = true;
    while go {
        if si >= slen {
            go = false;
        } else if pi < plen {
            let pc = pattern.char_at(pi);
            let sc = cell_val.char_at(si);
            if pc == "_" || pc == sc {
                si = si + 1;
                pi = pi + 1;
            } else if pc == "%" {
                star = pi + 1;
                star_s = si;
                pi = pi + 1;
            } else if star >= 0 {
                pi = star;
                star_s = star_s + 1;
                si = star_s;
            } else {
                result = false;
                decided = true;
                go = false;
            }
        } else if star >= 0 {
            pi = star;
            star_s = star_s + 1;
            si = star_s;
        } else {
            result = false;
            decided = true;
            go = false;
        }
    }
    if decided { return result; }
    // All of the string consumed; any trailing pattern must be only '%'.
    let mut tgo = true;
    while tgo {
        if pi < plen {
            if pattern.char_at(pi) == "%" { pi = pi + 1; }
            else { tgo = false; }
        } else { tgo = false; }
    }
    pi == plen
}

fn is_numeric_str(s: String) -> bool {
    let slen = s.len();
    if slen == 0 { return false; }
    let mut i = 0;
    let first = s.char_at(0);
    if first == "-" { i = 1; }
    if i >= slen { return false; }
    let d0 = s.char_at(i);
    if !is_digit(d0) { return false; }
    let mut has_dot = false;
    while i < slen {
        let ch = s.char_at(i);
        if is_digit(ch) { i = i + 1; }
        else if ch == "." {
            if has_dot { return false; }
            has_dot = true;
            i = i + 1;
        }
        else { return false; }
    }
    true
}

// True only for a signed decimal integer (no dot). parse_int_str ignores a
// dot, so integer-only UPDATE arithmetic gates on this, not is_numeric_str.
fn is_int_str(s: String) -> bool {
    if is_numeric_str(s) == false { return false; }
    if s.index_of(".") >= 0 { return false; }
    true
}

// Map a declared column type name to its internal storage code:
//   0 = INTEGER, 1 = REAL, 2 = TEXT.
// Recognizes the common SQL aliases (INT, BIGINT, FLOAT, DOUBLE, ...) so an INT
// column sorts and right-justifies as a number instead of comparing
// lexicographically as text. `type_up` must already be uppercased; anything
// unrecognized is TEXT. Numeric codes 0 and 1 both drive numeric comparison in
// compare_vals, so an alias mapped to either sorts correctly.
fn type_code_for(type_up: String) -> i32 {
    if type_up == "INTEGER" { return 0; }
    if type_up == "INT" { return 0; }
    if type_up == "SMALLINT" { return 0; }
    if type_up == "BIGINT" { return 0; }
    if type_up == "TINYINT" { return 0; }
    if type_up == "MEDIUMINT" { return 0; }
    if type_up == "REAL" { return 1; }
    if type_up == "FLOAT" { return 1; }
    if type_up == "DOUBLE" { return 1; }
    if type_up == "NUMERIC" { return 1; }
    if type_up == "DECIMAL" { return 1; }
    return 2;
}

// Order two rows by the primary key, breaking ties on the secondary key
// (ocol2 < 0 means no secondary). Returns <0 if rowa should come before rowb,
// >0 if after, 0 if equal under both keys. desc flags flip each key.
fn cmp_rows_2key(d: &DB, rowa: i32, rowb: i32, rs: i32, cc: i32, ocol: i32, ocol_type: i32, desc: i32, ocol2: i32, ocol2_type: i32, desc2: i32) -> i64 {
    let va = sp_get(d, vec_get(d.cells, rs + rowa * cc + ocol));
    let vb = sp_get(d, vec_get(d.cells, rs + rowb * cc + ocol));
    let mut c = compare_vals(va, vb, ocol_type);
    if desc == 1 { c = 0 - c; }
    if c < 0 { return c; }
    if c > 0 { return c; }
    if ocol2 >= 0 {
        let sa = sp_get(d, vec_get(d.cells, rs + rowa * cc + ocol2));
        let sb = sp_get(d, vec_get(d.cells, rs + rowb * cc + ocol2));
        let mut c2 = compare_vals(sa, sb, ocol2_type);
        if desc2 == 1 { c2 = 0 - c2; }
        return c2;
    }
    0
}

fn sort_rows(d: &DB, rows: Vec<i32>, count: i32, rs: i32, cc: i32, ocol: i32, ocol_type: i32, desc: i32, ocol2: i32, ocol2_type: i32, desc2: i32) -> Vec<i32> {
    // Stable bottom-up merge sort: primary key, then secondary key on ties,
    // then input order (on equal keys the left run is taken first). Same
    // order as the selection sort it replaced, which took the first minimum
    // on each pick, at O(n log n) instead of O(n^2) (bench_qdb_sort.py).
    let mut src: Vec<i32> = vec![];
    let mut dst: Vec<i32> = vec![];
    let mut i = 0;
    while i < count {
        vec_push(src, vec_get(rows, i));
        vec_push(dst, vec_get(rows, i));
        i = i + 1;
    }
    let mut width = 1;
    while width < count {
        let mut lo = 0;
        while lo < count {
            let mid = if lo + width < count { lo + width } else { count };
            let hi = if lo + 2 * width < count { lo + 2 * width } else { count };
            let mut a = lo;
            let mut b = mid;
            let mut o = lo;
            while o < hi {
                let mut take_a = false;
                if a < mid {
                    if b >= hi { take_a = true; }
                    else {
                        let c = cmp_rows_2key(d, vec_get(src, a), vec_get(src, b), rs, cc, ocol, ocol_type, desc, ocol2, ocol2_type, desc2);
                        if c <= 0 { take_a = true; }
                    }
                }
                if take_a { dst[o] = vec_get(src, a); a = a + 1; }
                else { dst[o] = vec_get(src, b); b = b + 1; }
                o = o + 1;
            }
            lo = lo + 2 * width;
        }
        let tmp = src;
        src = dst;
        dst = tmp;
        width = width * 2;
    }
    src
}

fn compare_vals(a: String, b: String, col_type: i32) -> i64 {
    // NULL sorts before every value, as in SQLite.
    let an = is_null(a);
    let bn = is_null(b);
    if an && bn { return 0; }
    if an { return 0 - 1; }
    if bn { return 1; }
    if col_type == 0 || col_type == 1 {
        let na = a.parse_float();
        let nb = b.parse_float();
        if na < nb { return 0 - 1; }
        if na > nb { return 1; }
        return 0;
    }
    a.compare(b)
}

// Display width of a cell: NULL renders as NULL.
fn dlen(s: String) -> i64 { disp(s).len() }

fn pad_right(s0: String, w: i32) -> String {
    let s = disp(s0);
    let slen = s.len();
    let mut out = s;
    let mut i = slen;
    while i < w {
        out = out + " ";
        i = i + 1;
    }
    out
}

fn pad_left(s0: String, w: i32) -> String {
    let s = disp(s0);
    let slen = s.len();
    let mut out = "";
    let mut i = slen;
    while i < w {
        out = out + " ";
        i = i + 1;
    }
    out + s
}

fn make_dashes(w: i32) -> String {
    let mut out = "";
    let mut i = 0;
    while i < w {
        out = out + "-";
        i = i + 1;
    }
    out
}

// --- Numeric / String Conversion ---
// int_to_str and digit_char are hand-rolled; float_to_str uses the
// runtime's shortest round-trip formatter.

fn int_to_str(n: i32) -> String {
    if n == 0 { return "0"; }
    let mut val = n;
    let mut neg = false;
    if val < 0 { neg = true; val = 0 - val; }
    let mut out = "";
    let mut go = true;
    while go {
        if val == 0 { go = false; }
        else {
            let digit = val - (val / 10) * 10;
            let ch = if digit == 0 { "0" } else if digit == 1 { "1" }
                else if digit == 2 { "2" } else if digit == 3 { "3" }
                else if digit == 4 { "4" } else if digit == 5 { "5" }
                else if digit == 6 { "6" } else if digit == 7 { "7" }
                else if digit == 8 { "8" } else { "9" };
            out = ch + out;
            val = val / 10;
        }
    }
    if neg { out = "-" + out; }
    out
}

fn digit_char(d: i32) -> String {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    "9"
}

// An aggregate's number: the shortest decimal that reads back as the same
// f64 (the runtime's to_string_f64), so AVG and SUM keep every digit. An
// integral value prints without a decimal point. The divide in AVG is by the
// count as f64: an unannotated integer divisor was lowered as an integer
// division, which truncated every AVG.
fn float_to_str(f: f64) -> String {
    if f == 0.0 { return "0"; }
    to_string_f64(f)
}

// =============================================================================
// VEC HELPER: rebuild vec with one element replaced
// =============================================================================
fn vec_replace(v: Vec<i32>, vlen: i32, idx: i32, new_val: i32) -> Vec<i32> {
    let mut result: Vec<i32> = vec![];
    let mut i = 0;
    while i < vlen {
        if i == idx { vec_push(result, new_val); }
        else { vec_push(result, vec_get(v, i)); }
        i = i + 1;
    }
    result
}

// =============================================================================
// PRINT HELPERS
// =============================================================================

// A result line of a SELECT: printed, and kept for the receipt when on.
fn rows_hdr(d: &mut DB, name: String) {
    if d.rows_on { vec_push(d.row_names, name); }
}

fn rows_cell(d: &mut DB, v: String) {
    if d.rows_on { vec_push(d.row_cells, v); }
}

fn emit_line(d: &mut DB, line: String) ~ Console {
    if !d.rows_on { println!("{}", line); }
    if d.rcpt_on { vec_push(d.rcpt_parts, line + "\n"); }
}

fn print_result_row(d: &mut DB, headers: Vec<i32>, results: Vec<i32>, count: i32) ~ Console {
    // Calculate widths
    let mut widths: Vec<i32> = vec![];
    let mut wi = 0;
    while wi < count {
        let hdr = sp_get(d, vec_get(headers, wi));
        let val = sp_get(d, vec_get(results, wi));
        let hw = hdr.len();
        let vw = dlen(val);
        let w = if hw > vw { hw } else { vw };
        vec_push(widths, w);
        wi = wi + 1;
    }
    // Print header
    let mut hdr_line = "";
    let mut sep_line = "";
    let mut hi = 0;
    while hi < count {
        if hi > 0 { hdr_line = hdr_line + " | "; sep_line = sep_line + "-+-"; }
        let hdr = sp_get(d, vec_get(headers, hi));
        rows_hdr(d, hdr);
        let w = vec_get(widths, hi);
        hdr_line = hdr_line + pad_right(hdr, w);
        sep_line = sep_line + make_dashes(w);
        hi = hi + 1;
    }
    emit_line(d, hdr_line);
    emit_line(d, sep_line);
    // Print value row
    let mut row_line = "";
    let mut ri = 0;
    while ri < count {
        if ri > 0 { row_line = row_line + " | "; }
        let val = sp_get(d, vec_get(results, ri));
        rows_cell(d, val);
        let w = vec_get(widths, ri);
        row_line = row_line + pad_right(val, w);
        ri = ri + 1;
    }
    emit_line(d, row_line);
}

// =========================================================================
// SECTION 8: INDEX — Sorted-Array Indexes with Binary Search
// =========================================================================
// Each index maintains sorted (key, rowid) pairs in flattened parallel arrays.
// idx_keys[start..start+count] and idx_rowids[start..start+count] hold the
// sorted entries for one index.
//
// Key operations:
//   find_index_for()  — look up whether an index exists for a table+column
//   rebuild_index()   — reconstruct sorted pairs from table rows (merge sort)
//   refresh_index()   — bring an index up to date before a read (lazy)
//   index_scan()      — binary search (equality) or linear scan (range)
//   update_indexes_for_table() — mark indexes for rebuild after UPDATE/DELETE/ALTER
//   exec_create_index() — CREATE INDEX handler
// =========================================================================

// Find an index on table tidx, column col_idx. Returns index id or -1.
fn find_index_for(d: &DB, tidx: i32, col_idx: i32) -> i32 {
    let mut i = 0;
    while i < d.idx_count {
        if vec_get(d.idx_tables, i) == tidx {
            if vec_get(d.idx_col_indices, i) == col_idx {
                return i;
            }
        }
        i = i + 1;
    }
    0 - 1
}

// Rebuild index data from table rows. Called by db_load, CREATE INDEX, and
// refresh_index after UPDATE, DELETE, ALTER or ROLLBACK. Collects all
// (key, rowid) pairs for the indexed column, sorts them with the stable merge
// sort in sort_positions, then replaces this index's entries in the
// flattened idx_keys/idx_rowids arrays.
fn rebuild_index(d: &mut DB, ix_id: i32) {
    let tidx = vec_get(d.idx_tables, ix_id);
    let col_i = vec_get(d.idx_col_indices, ix_id);
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // Collect (key_pool_id, row_index) pairs; read each key's number now,
    // for index_eq_num (P25).
    let ct0 = vec_get(d.col_types, cs + col_i);
    let numeric = ct0 == 0 || ct0 == 1;
    let mut keys: Vec<i32> = vec![];
    let mut rowids: Vec<i32> = vec![];
    let mut r = 0;
    while r < rc {
        let cell_id = vec_get(d.cells, rs + r * cc + col_i);
        vec_push(keys, cell_id);
        vec_push(rowids, r);
        if numeric { let kw = sp_kind(d, cell_id); }
        r = r + 1;
    }

    // Sort by key value (numeric if possible, else string), stable
    let col_type = vec_get(d.col_types, cs + col_i);
    let perm = sort_positions(d, keys, rc, col_type);
    let mut sorted_keys: Vec<i32> = vec![];
    let mut sorted_rowids: Vec<i32> = vec![];
    let mut pi = 0;
    while pi < rc {
        let p = vec_get(perm, pi);
        vec_push(sorted_keys, vec_get(keys, p));
        vec_push(sorted_rowids, vec_get(rowids, p));
        pi = pi + 1;
    }
    splice_index(d, ix_id, sorted_keys, sorted_rowids, rc);
}

// Scan an index for rows matching a WHERE condition.
// For equality (op==0): binary search to find the key, then scan left/right
// for duplicates. For range queries: linear scan of the sorted array.
// Returns a Vec of row indices that match.
fn index_scan(d: &DB, ix_id: i32, op: i32, rval: String) -> Vec<i32> {
    let ks = vec_get(d.idx_key_starts, ix_id);
    let kc = vec_get(d.idx_key_counts, ix_id);
    let tidx = vec_get(d.idx_tables, ix_id);
    let col_i = vec_get(d.idx_col_indices, ix_id);
    let tcs = vec_get(d.tbl_col_starts, tidx);
    let col_type = vec_get(d.col_types, tcs + col_i);

    let mut result: Vec<i32> = vec![];

    if op == 0 {
        // Equality: binary search for the value
        let mut lo = 0;
        let mut hi = kc - 1;
        let mut found_pos = 0 - 1;
        let mut searching = true;
        while searching {
            if lo > hi { searching = false; }
            else {
                let mid = (lo + hi) / 2;
                let mval = sp_get(d, vec_get(d.idx_keys, ks + mid));
                let cmp = compare_vals(mval, rval, col_type);
                if cmp == 0 { found_pos = mid; searching = false; }
                else if cmp < 0 { lo = mid + 1; }
                else { hi = mid - 1; }
            }
        }
        if found_pos >= 0 {
            // Scan left and right for duplicates
            let mut left = found_pos;
            let mut lgo = true;
            while lgo {
                if left <= 0 { lgo = false; }
                else {
                    let lv = sp_get(d, vec_get(d.idx_keys, ks + left - 1));
                    let lc = compare_vals(lv, rval, col_type);
                    if lc == 0 { left = left - 1; }
                    else { lgo = false; }
                }
            }
            let mut right = found_pos;
            let mut rgo = true;
            while rgo {
                if right >= kc - 1 { rgo = false; }
                else {
                    let rv = sp_get(d, vec_get(d.idx_keys, ks + right + 1));
                    let rc2 = compare_vals(rv, rval, col_type);
                    if rc2 == 0 { right = right + 1; }
                    else { rgo = false; }
                }
            }
            let mut si3 = left;
            while si3 <= right {
                vec_push(result, vec_get(d.idx_rowids, ks + si3));
                si3 = si3 + 1;
            }
        }
    } else {
        // For range queries, linear scan the sorted index
        // (could be optimized with binary search to find start point)
        let mut si3 = 0;
        while si3 < kc {
            let kval = sp_get(d, vec_get(d.idx_keys, ks + si3));
            if eval_where(kval, op, rval) {
                vec_push(result, vec_get(d.idx_rowids, ks + si3));
            }
            si3 = si3 + 1;
        }
    }
    result
}

// Write x at position i of v, growing v by one when i is its length.
fn vset_i32(v: Vec<i32>, i: i32, x: i32) {
    if i < vec_len(v) { v[i] = x; } else { vec_push(v, x); }
}

fn vset_str(v: Vec<String>, i: i32, x: String) {
    if i < vec_len(v) { v[i] = x; } else { vec_push(v, x); }
}

// index_scan's equality search on a numeric column (INTEGER or REAL) for the
// number x, with each key's parse_float read once from the pool cache: the
// row ids of every key compare_vals finds equal to x, in index order, written
// to out from position 0. Returns their count.
fn index_eq_num_into(d: &mut DB, ix_id: i32, x: f64, out: Vec<i32>) -> i32 {
    let ks = vec_get(d.idx_key_starts, ix_id);
    let kc = vec_get(d.idx_key_counts, ix_id);
    let mut lo = 0;
    let mut hi = kc;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let id = vec_get(d.idx_keys, ks + mid);
        let k = sp_kind(d, id);
        if k == 2 || vec_get(d.pool_num, id) < x { lo = mid + 1; } else { hi = mid; }
    }
    let mut n = 0;
    let mut j = lo;
    let mut go = true;
    while go && j < kc {
        let id = vec_get(d.idx_keys, ks + j);
        if sp_kind(d, id) != 2 && vec_get(d.pool_num, id) == x {
            vset_i32(out, n, vec_get(d.idx_rowids, ks + j));
            n = n + 1;
            j = j + 1;
        } else { go = false; }
    }
    n
}

// index_eq_num_into into a new vector.
fn index_eq_num(d: &mut DB, ix_id: i32, x: f64) -> Vec<i32> {
    let ks = vec_get(d.idx_key_starts, ix_id);
    let kc = vec_get(d.idx_key_counts, ix_id);
    let mut lo = 0;
    let mut hi = kc;
    // The first entry not below x (NULL keys sort first).
    while lo < hi {
        let mid = (lo + hi) / 2;
        let id = vec_get(d.idx_keys, ks + mid);
        let k = sp_kind(d, id);
        if k == 2 || vec_get(d.pool_num, id) < x { lo = mid + 1; } else { hi = mid; }
    }
    let mut result: Vec<i32> = vec![];
    let mut j = lo;
    let mut go = true;
    while go && j < kc {
        let id = vec_get(d.idx_keys, ks + j);
        if sp_kind(d, id) != 2 && vec_get(d.pool_num, id) == x {
            vec_push(result, vec_get(d.idx_rowids, ks + j));
            j = j + 1;
        } else { go = false; }
    }
    result
}

// Mark indexes for a full rebuild after a mutation that moves or rewrites
// existing rows (ALTER TABLE).
// UPDATE and DELETE keep the indexes current in place instead (P20). The rebuild runs on the next index
// read, so a run of mutations pays for one rebuild, not one per statement.
// tidx is kept for the call sites; every index is invalidated, which is the
// simple safe choice because row ids are table-relative and DELETE shifts them.
fn update_indexes_for_table(d: &mut DB, tidx: i32) {
    if tidx >= 0 { d.idx_stale = true; }
}

// Bring one index up to date before a read. Two cases:
//   - d.idx_stale: some mutation moved or rewrote rows. Rebuild every index
//     from its table (O(n log n) each) and clear the flag.
//   - the index covers fewer keys than the table has rows: only INSERTs ran
//     since the last refresh, and they appended rows with the highest row
//     ids. Sort just the new rows and merge them after equal existing keys,
//     O(n + k log k). The order matches a full stable rebuild exactly.
fn refresh_index(d: &mut DB, ix_id: i32) {
    if d.idx_stale {
        let mut i = 0;
        while i < d.idx_count {
            // DROP TABLE leaves its indexes behind (a known gap); skip any
            // whose table index no longer exists instead of reading past it.
            if vec_get(d.idx_tables, i) < d.tbl_count { rebuild_index(d, i); }
            i = i + 1;
        }
        d.idx_stale = false;
        return;
    }
    let tidx = vec_get(d.idx_tables, ix_id);
    if tidx >= d.tbl_count { return; }
    let rc = vec_get(d.tbl_row_counts, tidx);
    let kc = vec_get(d.idx_key_counts, ix_id);
    if kc < rc { merge_new_rows(d, ix_id, kc); }
}

// Stable merge sort of positions 0..n by the pool strings keys[pos], using
// compare_vals. Equal keys keep their input order, which is row-id order, so
// the result equals the selection sort this replaced (it took the first
// minimum on each pick) at O(n log n) instead of O(n^2).
fn sort_positions(d: &DB, keys: Vec<i32>, n: i32, col_type: i32) -> Vec<i32> {
    let mut src: Vec<i32> = vec![];
    let mut dst: Vec<i32> = vec![];
    let mut i = 0;
    while i < n {
        vec_push(src, i);
        vec_push(dst, i);
        i = i + 1;
    }
    let mut width = 1;
    while width < n {
        let mut lo = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut a = lo;
            let mut b = mid;
            let mut o = lo;
            while o < hi {
                let mut take_a = false;
                if a < mid {
                    if b >= hi { take_a = true; }
                    else {
                        let ka = sp_get(d, vec_get(keys, vec_get(src, a)));
                        let kb = sp_get(d, vec_get(keys, vec_get(src, b)));
                        // <= keeps the left (lower row id) element first on ties
                        if compare_vals(ka, kb, col_type) <= 0 { take_a = true; }
                    }
                }
                if take_a { dst[o] = vec_get(src, a); a = a + 1; }
                else { dst[o] = vec_get(src, b); b = b + 1; }
                o = o + 1;
            }
            lo = lo + 2 * width;
        }
        let tmp = src;
        src = dst;
        dst = tmp;
        width = width * 2;
    }
    src
}

// Replace index ix_id's entries in the flattened idx_keys/idx_rowids arrays
// with new_keys/new_rowids (count entries), shifting later indexes' starts.
fn splice_index(d: &mut DB, ix_id: i32, new_keys: Vec<i32>, new_rowids: Vec<i32>, count: i32) {
    let old_start = vec_get(d.idx_key_starts, ix_id);
    let old_count = vec_get(d.idx_key_counts, ix_id);
    let total_keys = vec_len(d.idx_keys);
    let mut out_keys: Vec<i32> = vec![];
    let mut out_rowids: Vec<i32> = vec![];
    let mut ci2 = 0;
    while ci2 < old_start {
        vec_push(out_keys, vec_get(d.idx_keys, ci2));
        vec_push(out_rowids, vec_get(d.idx_rowids, ci2));
        ci2 = ci2 + 1;
    }
    let mut ni = 0;
    while ni < count {
        vec_push(out_keys, vec_get(new_keys, ni));
        vec_push(out_rowids, vec_get(new_rowids, ni));
        ni = ni + 1;
    }
    ci2 = old_start + old_count;
    while ci2 < total_keys {
        vec_push(out_keys, vec_get(d.idx_keys, ci2));
        vec_push(out_rowids, vec_get(d.idx_rowids, ci2));
        ci2 = ci2 + 1;
    }
    d.idx_keys = out_keys;
    d.idx_rowids = out_rowids;
    let size_diff = count - old_count;
    d.idx_key_counts = vec_replace(d.idx_key_counts, d.idx_count, ix_id, count);
    let mut si2 = 0;
    let mut new_starts: Vec<i32> = vec![];
    while si2 < d.idx_count {
        if si2 > ix_id {
            vec_push(new_starts, vec_get(d.idx_key_starts, si2) + size_diff);
        } else {
            vec_push(new_starts, vec_get(d.idx_key_starts, si2));
        }
        si2 = si2 + 1;
    }
    d.idx_key_starts = new_starts;
}

// Fold rows kc..rc-1 (appended since the last refresh) into index ix_id:
// sort them, then merge with the existing sorted entries. On equal keys an
// existing entry goes first, since its row id is lower.
fn merge_new_rows(d: &mut DB, ix_id: i32, kc: i32) {
    let tidx = vec_get(d.idx_tables, ix_id);
    let col_i = vec_get(d.idx_col_indices, ix_id);
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);
    let col_type = vec_get(d.col_types, cs + col_i);
    let k = rc - kc;
    let mut add_keys: Vec<i32> = vec![];
    let mut r = kc;
    let numeric = col_type == 0 || col_type == 1;
    while r < rc {
        vec_push(add_keys, vec_get(d.cells, rs + r * cc + col_i));
        // Read each new key's number now, for index_eq_num (P25).
        if numeric { let kw = sp_kind(d, vec_get(d.cells, rs + r * cc + col_i)); }
        r = r + 1;
    }
    let perm = sort_positions(d, add_keys, k, col_type);
    let ks = vec_get(d.idx_key_starts, ix_id);
    let mut m_keys: Vec<i32> = vec![];
    let mut m_rowids: Vec<i32> = vec![];
    let mut a = 0;
    let mut b = 0;
    while a < kc || b < k {
        let mut take_old = false;
        if a < kc {
            if b >= k { take_old = true; }
            else {
                let ko = sp_get(d, vec_get(d.idx_keys, ks + a));
                let kn = sp_get(d, vec_get(add_keys, vec_get(perm, b)));
                if compare_vals(ko, kn, col_type) <= 0 { take_old = true; }
            }
        }
        if take_old {
            vec_push(m_keys, vec_get(d.idx_keys, ks + a));
            vec_push(m_rowids, vec_get(d.idx_rowids, ks + a));
            a = a + 1;
        } else {
            let p = vec_get(perm, b);
            vec_push(m_keys, vec_get(add_keys, p));
            vec_push(m_rowids, kc + p);
            b = b + 1;
        }
    }
    splice_index(d, ix_id, m_keys, m_rowids, rc);
}

// Execute CREATE INDEX. Registers a new index entry and rebuilds its sorted data.
fn exec_create_index(d: &mut DB) ~ Console {
    d.schema_ver = d.schema_ver + 1;
    let iname = sp_get(d, d.idx_name);
    let tname = sp_get(d, d.idx_table_name);
    let cname = sp_get(d, d.idx_col_name);

    let tidx = find_table(d, tname);
    if tidx < 0 {
        d.stmt_failed = true;
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let col_i = find_col(d, cs, cc, cname);
    if col_i < 0 {
        d.stmt_failed = true;
        println!("Error: column '{}' not found in table '{}'", cname, tname);
        return;
    }

    // Check for existing index with same name
    let mut ei = 0;
    while ei < d.idx_count {
        let existing_name = sp_get(d, vec_get(d.idx_names, ei));
        if existing_name == iname {
            d.stmt_failed = true;
            println!("Error: index '{}' already exists", iname);
            return;
        }
        ei = ei + 1;
    }

    let inid = sp_add(d, iname);
    vec_push(d.idx_names, inid);
    vec_push(d.idx_tables, tidx);
    vec_push(d.idx_col_indices, col_i);
    vec_push(d.idx_key_starts, vec_len(d.idx_keys));
    vec_push(d.idx_key_counts, 0);
    d.idx_count = d.idx_count + 1;

    // Build index data from existing rows
    rebuild_index(d, d.idx_count - 1);
}

// =========================================================================
// SECTION 9: DISPATCH — SQL Routing
// =========================================================================
// Two entry points:
//   exec_sql()        — full execution with WAL logging (normal operation)
//   exec_sql_no_wal() — execution without WAL logging (used during WAL replay)
//
// Both call reset_parser + parse_sql, then dispatch by d.stmt_type.
// exec_sql also handles transaction keywords (BEGIN/COMMIT/ROLLBACK) as
// special cases before parsing, and routes mutations through wal_log_mutation.
// =========================================================================

// exec_sql_no_wal: used during WAL replay — executes + saves directly, no WAL logging
// =========================================================================
// SECTION 6h: EXPRESSION QUERIES (P11, P12)
// =========================================================================
// A SELECT whose select list, WHERE or ORDER BY holds an expression the
// condition parser above cannot read (arithmetic, a column compared with a
// column, CASE, a function, a correlated subquery, EXISTS) or whose FROM
// lists several tables is parsed here into an expression tree and run by
// xq_run. x_wanted decides which path a SELECT takes, before either parses,
// so a query the older path answers keeps its answer.
//
// Values are cell texts, NULL the reserved nullv(). Arithmetic follows
// SQLite: two integers give an integer (division truncates toward zero, by
// zero is NULL), anything else a real, printed with a decimal point.
//
// Expression kinds (x_kind): 0 literal (x_s), 1 column (x_s), 2 arithmetic
// (x_c: 0 + 1 - 2 * 3 / 4 %), 3 unary minus, 4 comparison (x_c as
// op_encode), 5 AND, 6 OR, 7 NOT, 8 IS [NOT] NULL (x_c 1 = NOT), 9 BETWEEN
// (args lo, hi; x_c 1 = NOT), 10 IN list (args; x_c 1 = NOT), 11 searched
// CASE (args cond, res, ...; x_b ELSE or -1), 12 simple CASE (x_a base),
// 13 function (x_s name, args), 14 scalar subquery (x_c query), 15 EXISTS
// (x_c query), 16 IN subquery (x_c query, x_b 1 = NOT), 17 LIKE (x_c 1 =
// NOT), 18 aggregate (x_s name, x_a argument or -1 for *, x_c DISTINCT).
// =========================================================================

fn xp_new(d: &mut DB, kind: i32, a: i32, b: i32, c: i32, s: i32) -> i32 {
    vec_push(d.x_kind, kind);
    vec_push(d.x_a, a);
    vec_push(d.x_b, b);
    vec_push(d.x_c, c);
    vec_push(d.x_s, s);
    vec_push(d.x_as, vec_len(d.x_args));
    vec_push(d.x_an, 0);
    d.xn = d.xn + 1;
    d.xn - 1
}

fn xp_new_args(d: &mut DB, kind: i32, a: i32, b: i32, c: i32, s: i32, args: Vec<i32>, n: i32) -> i32 {
    let start = vec_len(d.x_args);
    let mut i = 0;
    while i < n { vec_push(d.x_args, vec_get(args, i)); i = i + 1; }
    vec_push(d.x_kind, kind);
    vec_push(d.x_a, a);
    vec_push(d.x_b, b);
    vec_push(d.x_c, c);
    vec_push(d.x_s, s);
    vec_push(d.x_as, start);
    vec_push(d.x_an, n);
    d.xn = d.xn + 1;
    d.xn - 1
}

fn x_arg(d: &DB, e: i32, i: i32) -> i32 { vec_get(d.x_args, vec_get(d.x_as, e) + i) }

// The current token as an upper-case word, or "" when it is not a word.
fn tk_word(d: &DB) -> String {
    if d.tk_type == 0 || d.tk_type == 1 { return d.tk_val.to_uppercase(); }
    ""
}

fn is_agg_name(w: String) -> bool {
    w == "COUNT" || w == "SUM" || w == "AVG" || w == "MIN" || w == "MAX" || w == "TOTAL" ||
    w == "GROUP_CONCAT"
}

// Words that end an expression or a select item; never an alias.
fn x_reserved(w: String) -> bool {
    w == "FROM" || w == "WHERE" || w == "ORDER" || w == "LIMIT" || w == "OFFSET" || w == "AND" ||
    w == "OR" || w == "NOT" || w == "WHEN" || w == "THEN" || w == "ELSE" || w == "END" ||
    w == "AS" || w == "ASC" || w == "DESC" || w == "IS" || w == "IN" || w == "BETWEEN" ||
    w == "LIKE" || w == "GROUP" || w == "HAVING" || w == "UNION" || w == "INTERSECT" ||
    w == "EXCEPT" || w == "JOIN" || w == "ON" || w == "BY" || w == "INDEXED"
}

fn x_expect(d: &mut DB, p: String) ~ Console + Process {
    if tk_is_punct(d, p) == 0 {
        println!("Error: expected '{}', got '{}'", p, d.tk_val);
        process_exit(1);
    }
    next_token(d);
}

fn x_expect_word(d: &mut DB, w: String) ~ Console + Process {
    if tk_word(d) != w {
        println!("Error: expected '{}', got '{}'", w, d.tk_val);
        process_exit(1);
    }
    next_token(d);
}

fn xp_expr(d: &mut DB) -> i32 ~ Console + Process { xp_or(d) }

fn xp_or(d: &mut DB) -> i32 ~ Console + Process {
    let mut l = xp_and(d);
    while tk_word(d) == "OR" {
        next_token(d);
        let r = xp_and(d);
        l = xp_new(d, 6, l, r, 0, -1);
    }
    l
}

fn xp_and(d: &mut DB) -> i32 ~ Console + Process {
    let mut l = xp_not(d);
    while tk_word(d) == "AND" {
        next_token(d);
        let r = xp_not(d);
        l = xp_new(d, 5, l, r, 0, -1);
    }
    l
}

fn xp_not(d: &mut DB) -> i32 ~ Console + Process {
    if tk_word(d) == "NOT" {
        next_token(d);
        let a = xp_not(d);
        return xp_new(d, 7, a, -1, 0, -1);
    }
    xp_pred(d)
}

fn xp_pred(d: &mut DB) -> i32 ~ Console + Process {
    let l = xp_add(d);
    if d.tk_type == 4 {
        let mut op = op_encode(d.tk_val);
        if d.tk_val == "==" { op = 0; }
        if op >= 0 {
            next_token(d);
            let r = xp_add(d);
            return xp_new(d, 4, l, r, op, -1);
        }
    }
    if tk_word(d) == "IS" {
        next_token(d);
        let mut neg = 0;
        if tk_word(d) == "NOT" { neg = 1; next_token(d); }
        x_expect_word(d, "NULL");
        return xp_new(d, 8, l, -1, neg, -1);
    }
    if tk_word(d) == "ISNULL" { next_token(d); return xp_new(d, 8, l, -1, 0, -1); }
    if tk_word(d) == "NOTNULL" { next_token(d); return xp_new(d, 8, l, -1, 1, -1); }
    let mut neg = 0;
    if tk_word(d) == "NOT" { neg = 1; next_token(d); }
    let w = tk_word(d);
    if neg == 1 && w == "NULL" { next_token(d); return xp_new(d, 8, l, -1, 1, -1); }
    if w == "BETWEEN" {
        next_token(d);
        let lo = xp_add(d);
        x_expect_word(d, "AND");
        let hi = xp_add(d);
        let mut args: Vec<i32> = vec![];
        vec_push(args, lo);
        vec_push(args, hi);
        return xp_new_args(d, 9, l, -1, neg, -1, args, 2);
    }
    if w == "IN" {
        next_token(d);
        x_expect(d, "(");
        if tk_word(d) == "SELECT" {
            let q = xp_query(d);
            x_expect(d, ")");
            return xp_new(d, 16, l, neg, q, -1);
        }
        let mut args: Vec<i32> = vec![];
        let mut n = 0;
        if tk_is_punct(d, ")") == 0 {
            let mut go = true;
            while go {
                let a = xp_expr(d);
                vec_push(args, a);
                n = n + 1;
                if tk_is_punct(d, ",") == 1 { next_token(d); } else { go = false; }
            }
        }
        x_expect(d, ")");
        return xp_new_args(d, 10, l, -1, neg, -1, args, n);
    }
    if w == "LIKE" {
        next_token(d);
        let r = xp_add(d);
        return xp_new(d, 17, l, r, neg, -1);
    }
    if neg == 1 {
        println!("Error: expected BETWEEN, IN or LIKE after NOT, got '{}'", d.tk_val);
        process_exit(1);
    }
    l
}

fn xp_add(d: &mut DB) -> i32 ~ Console + Process {
    let mut l = xp_mul(d);
    let mut go = true;
    while go {
        if d.tk_type == 4 && (d.tk_val == "+" || d.tk_val == "-") {
            let op = if d.tk_val == "+" { 0 } else { 1 };
            next_token(d);
            let r = xp_mul(d);
            l = xp_new(d, 2, l, r, op, -1);
        } else if d.tk_type == 3 && d.tk_val.starts_with("-") {
            // `b-3` lexes as `b` and the number `-3`: a binary minus.
            let digits = d.tk_val.substring(1, d.tk_val.len() - 1);
            let lit = xp_new(d, 0, -1, -1, 0, sp_add(d, digits));
            next_token(d);
            let r = xp_mul_tail(d, lit);
            l = xp_new(d, 2, l, r, 1, -1);
        } else {
            go = false;
        }
    }
    l
}

fn xp_mul(d: &mut DB) -> i32 ~ Console + Process {
    let l = xp_unary(d);
    xp_mul_tail(d, l)
}

fn xp_mul_tail(d: &mut DB, left: i32) -> i32 ~ Console + Process {
    let mut l = left;
    let mut go = true;
    while go {
        let mut op = -1;
        if d.tk_type == 6 { op = 2; }
        if d.tk_type == 4 && d.tk_val == "/" { op = 3; }
        if d.tk_type == 1 && d.tk_val == "%" { op = 4; }
        if op >= 0 {
            next_token(d);
            let r = xp_unary(d);
            l = xp_new(d, 2, l, r, op, -1);
        } else {
            go = false;
        }
    }
    l
}

fn xp_unary(d: &mut DB) -> i32 ~ Console + Process {
    if d.tk_type == 4 && d.tk_val == "-" {
        next_token(d);
        let a = xp_unary(d);
        return xp_new(d, 3, a, -1, 0, -1);
    }
    if d.tk_type == 4 && d.tk_val == "+" {
        next_token(d);
        return xp_unary(d);
    }
    xp_primary(d)
}

fn xp_primary(d: &mut DB) -> i32 ~ Console + Process {
    if d.tk_type == 3 || d.tk_type == 2 {
        let v = tok_value(d);
        next_token(d);
        return xp_new(d, 0, -1, -1, 0, sp_add(d, v));
    }
    let w = tk_word(d);
    if w == "NULL" {
        next_token(d);
        return xp_new(d, 0, -1, -1, 0, sp_add(d, nullv()));
    }
    if tk_is_punct(d, "(") == 1 {
        next_token(d);
        if tk_word(d) == "SELECT" {
            let q = xp_query(d);
            x_expect(d, ")");
            return xp_new(d, 14, -1, -1, q, -1);
        }
        let e = xp_expr(d);
        x_expect(d, ")");
        return e;
    }
    if w == "CASE" {
        next_token(d);
        let mut base = -1;
        if tk_word(d) != "WHEN" { base = xp_expr(d); }
        let mut args: Vec<i32> = vec![];
        let mut n = 0;
        while tk_word(d) == "WHEN" {
            next_token(d);
            let c = xp_expr(d);
            x_expect_word(d, "THEN");
            let r = xp_expr(d);
            vec_push(args, c);
            vec_push(args, r);
            n = n + 2;
        }
        if n == 0 {
            println!("Error: CASE needs at least one WHEN");
            process_exit(1);
        }
        let mut els = -1;
        if tk_word(d) == "ELSE" { next_token(d); els = xp_expr(d); }
        x_expect_word(d, "END");
        if base >= 0 { return xp_new_args(d, 12, base, els, 0, -1, args, n); }
        return xp_new_args(d, 11, -1, els, 0, -1, args, n);
    }
    if w == "EXISTS" {
        next_token(d);
        x_expect(d, "(");
        let q = xp_query(d);
        x_expect(d, ")");
        return xp_new(d, 15, -1, -1, q, -1);
    }
    if d.tk_type == 0 || d.tk_type == 1 {
        let name = d.tk_val;
        let save_pos = d.pos;
        let save_type = d.tk_type;
        next_token(d);
        if tk_is_punct(d, "(") == 1 {
            next_token(d);
            let fname = name.to_uppercase();
            if is_agg_name(fname) {
                let mut dist = 0;
                if tk_word(d) == "DISTINCT" { dist = 1; next_token(d); }
                let mut arg = -1;
                if d.tk_type == 6 { next_token(d); }
                else { arg = xp_expr(d); }
                let mut sep = -1;
                if fname == "GROUP_CONCAT" && tk_is_punct(d, ",") == 1 {
                    next_token(d);
                    sep = xp_expr(d);
                    if dist == 1 {
                        println!("Error: DISTINCT aggregates must have exactly one argument");
                        process_exit(1);
                    }
                }
                x_expect(d, ")");
                return xp_new(d, 18, arg, sep, dist, sp_add(d, fname));
            }
            let mut args: Vec<i32> = vec![];
            let mut n = 0;
            if tk_is_punct(d, ")") == 0 {
                let mut go = true;
                while go {
                    let a = xp_expr(d);
                    vec_push(args, a);
                    n = n + 1;
                    if tk_is_punct(d, ",") == 1 { next_token(d); } else { go = false; }
                }
            }
            x_expect(d, ")");
            return xp_new_args(d, 13, -1, -1, 0, sp_add(d, fname), args, n);
        }
        if save_type == 0 && x_reserved(name) {
            println!("Error: expected an expression, got '{}'", name);
            process_exit(1);
        }
        if tk_is_punct(d, ".") == 1 {
            next_token(d);
            let col = d.tk_val;
            next_token(d);
            return xp_new(d, 1, -1, -1, 0, sp_add(d, name + "." + col));
        }
        return xp_new(d, 1, -1, -1, 0, sp_add(d, name));
    }
    println!("Error: expected an expression, got '{}'", d.tk_val);
    process_exit(1);
    -1
}

// Parse one SELECT (the current token is SELECT) into a query record and
// return its id. Subqueries parse their own records first.
fn xp_query(d: &mut DB) -> i32 ~ Console + Process {
    x_expect_word(d, "SELECT");
    let mut distinct = 0;
    if tk_word(d) == "DISTINCT" { distinct = 1; next_token(d); }
    else if tk_word(d) == "ALL" { next_token(d); }
    let mut sel: Vec<i32> = vec![];
    let mut names: Vec<i32> = vec![];
    let mut ns = 0;
    let mut go = true;
    while go {
        if d.tk_type == 6 {
            next_token(d);
            vec_push(sel, -1);
            vec_push(names, -1);
        } else {
            let e = xp_expr(d);
            let mut nm = -1;
            if vec_get(d.x_kind, e) == 1 { nm = vec_get(d.x_s, e); }
            if tk_word(d) == "AS" {
                next_token(d);
                nm = sp_add(d, d.tk_val);
                next_token(d);
            } else if d.tk_type == 1 && !x_reserved(tk_word(d)) {
                nm = sp_add(d, d.tk_val);
                next_token(d);
            }
            vec_push(sel, e);
            vec_push(names, nm);
        }
        ns = ns + 1;
        if tk_is_punct(d, ",") == 1 { next_token(d); } else { go = false; }
    }
    let mut ftab: Vec<i32> = vec![];
    let mut falias: Vec<i32> = vec![];
    let mut nf = 0;
    if tk_word(d) == "FROM" {
        next_token(d);
        let mut fgo = true;
        while fgo {
            let tname = d.tk_val;
            let ti = find_table(d, tname);
            if ti < 0 {
                println!("Error: table '{}' not found", tname);
                process_exit(1);
            }
            next_token(d);
            let mut al = -1;
            if tk_word(d) == "AS" {
                next_token(d);
                al = sp_add(d, d.tk_val);
                next_token(d);
            } else if d.tk_type == 1 && !x_reserved(tk_word(d)) {
                al = sp_add(d, d.tk_val);
                next_token(d);
            }
            if tk_word(d) == "NOT" {
                next_token(d);
                x_expect_word(d, "INDEXED");
            } else if tk_word(d) == "INDEXED" {
                next_token(d);
                x_expect_word(d, "BY");
                next_token(d);
            }
            vec_push(ftab, ti);
            vec_push(falias, al);
            nf = nf + 1;
            if tk_is_punct(d, ",") == 1 { next_token(d); } else { fgo = false; }
        }
    }
    let mut wh = -1;
    if tk_word(d) == "WHERE" { next_token(d); wh = xp_expr(d); }
    let mut oexp: Vec<i32> = vec![];
    let mut odesc: Vec<i32> = vec![];
    let mut no = 0;
    if tk_word(d) == "ORDER" {
        next_token(d);
        x_expect_word(d, "BY");
        let mut ogo = true;
        while ogo {
            let e = xp_expr(d);
            let mut ds = 0;
            if tk_word(d) == "DESC" { ds = 1; next_token(d); }
            else if tk_word(d) == "ASC" { next_token(d); }
            vec_push(oexp, e);
            vec_push(odesc, ds);
            no = no + 1;
            if tk_is_punct(d, ",") == 1 { next_token(d); } else { ogo = false; }
        }
    }
    let mut lim = -1;
    let mut off = 0;
    if tk_word(d) == "LIMIT" {
        next_token(d);
        lim = parse_int_str(d.tk_val);
        next_token(d);
        if tk_word(d) == "OFFSET" {
            next_token(d);
            off = parse_int_str(d.tk_val);
            next_token(d);
        }
    }
    // Push the record: lists first, then the per-query fields.
    let fs = vec_len(d.qf_tbl);
    let mut i = 0;
    while i < nf { vec_push(d.qf_tbl, vec_get(ftab, i)); vec_push(d.qf_alias, vec_get(falias, i)); i = i + 1; }
    let ss = vec_len(d.qs_expr);
    i = 0;
    while i < ns { vec_push(d.qs_expr, vec_get(sel, i)); vec_push(d.qs_name, vec_get(names, i)); i = i + 1; }
    let os = vec_len(d.qo_expr);
    i = 0;
    while i < no { vec_push(d.qo_expr, vec_get(oexp, i)); vec_push(d.qo_desc, vec_get(odesc, i)); i = i + 1; }
    vec_push(d.q_fs, fs);
    vec_push(d.q_fn, nf);
    vec_push(d.q_ss, ss);
    vec_push(d.q_sn, ns);
    vec_push(d.q_where, wh);
    vec_push(d.q_os, os);
    vec_push(d.q_on, no);
    vec_push(d.q_limit, lim);
    vec_push(d.q_offset, off);
    vec_push(d.q_distinct, distinct);
    d.xq_n = d.xq_n + 1;
    d.xq_n - 1
}

fn parse_xselect(d: &mut DB) ~ Console + Process {
    d.stmt_type = 20;
    d.xq_root = xp_query(d);
    if tk_is_punct(d, ";") == 1 { next_token(d); }
    if d.tk_type != 7 {
        println!("Error: unexpected trailing input near '{}'", d.tk_val);
        process_exit(1);
    }
}

// Which path a SELECT takes: the expression path when the statement uses a
// form only it reads and nothing only the older path reads (GROUP BY,
// HAVING, JOIN, a compound operator, at the top level). Scans the tokens and
// puts the tokenizer back at the start.
// SQLite reads `x IN t`, with a table name and no parenthesis, as
// `x IN (SELECT * FROM t)`. Rewrite the input that way before either path
// parses it (P18), and leave the tokenizer at the first token.
fn x_in_table_rewrite(d: &mut DB) {
    let src = d.input;
    d.pos = 0;
    d.tk_type = 7;
    let mut out = "";
    let mut copied: i64 = 0;
    let mut prev_in = false;
    next_token(d);
    while d.tk_type != 7 {
        let end = d.pos;
        let n = d.tk_val.len();
        if prev_in && d.tk_type == 1 && end >= n && src.substring(end - n, n) == d.tk_val {
            out = out + src.substring(copied, end - n - copied) + "(SELECT * FROM " + d.tk_val + ")";
            copied = end;
        }
        prev_in = tk_word(d) == "IN";
        next_token(d);
    }
    if copied > 0 { reset_parser(d, out + src.substring(copied, src.len() - copied)); }
    x_rewind(d);
}

fn x_wanted(d: &mut DB) -> bool {
    d.pos = 0;
    next_token(d);
    if tk_word(d) != "SELECT" { x_rewind(d); return false; }
    let mut feature = false;
    let mut legacy = false;
    let mut depth = 0;
    let mut section = 0;     // 0 select list, 1 FROM, 2 WHERE, 3 ORDER BY, 4 after
    let mut order_commas = 0;
    let mut prev_type = 3;   // previous token: 1 operand, 2 comparison, 3 other
    let mut prev_word = "SELECT";
    let mut prev_ident = false;
    let mut prev_comma = false;
    // P18: whether the previous token, and the one before it, was a literal
    // or NULL; the older path reads no IN with a literal on its left.
    let mut prev_lit = false;
    let mut prev2_lit = false;
    let mut agg_open = false;
    let mut prev2_word = "";
    let mut total_next = false;
    next_token(d);
    while d.tk_type != 7 && !legacy {
        if total_next && tk_is_punct(d, "(") == 1 { feature = true; }
        total_next = false;
        let w = tk_word(d);
        if w == "IN" && depth == 0 {
            if section == 0 || prev_lit || (prev_word == "NOT" && prev2_lit) { feature = true; }
        }
        if depth == 0 {
            if w == "GROUP" || w == "HAVING" || w == "JOIN" || w == "UNION" || w == "INTERSECT" ||
               w == "EXCEPT" || w == "LEFT" || w == "INNER" || w == "CROSS" {
                legacy = true;
            }
            if w == "FROM" { section = 1; }
            if w == "WHERE" { section = 2; }
            if w == "ORDER" { section = 3; }
            if w == "LIMIT" { section = 4; }
            if section == 1 && tk_is_punct(d, ",") == 1 { feature = true; }
            if section == 3 && tk_is_punct(d, ",") == 1 { order_commas = order_commas + 1; }
        }
        if w == "CASE" || w == "EXISTS" { feature = true; }
        // P23: TOTAL() and DISTINCT inside an aggregate other than COUNT.
        if w == "TOTAL" && tk_is_punct(d, "(") == 0 { total_next = true; }
        if w == "DISTINCT" && agg_open { feature = true; }
        if w == "GROUP_CONCAT" || w == "INDEXED" || w == "ISNULL" || w == "NOTNULL" { feature = true; }
        if w == "NULL" && prev_word == "NOT" && prev2_word != "IS" { feature = true; }
        agg_open = tk_is_punct(d, "(") == 1 && is_agg_name(prev_word) && prev_word != "COUNT";
        if d.tk_type == 4 && (d.tk_val == "+" || d.tk_val == "/" || d.tk_val == "-") { feature = true; }
        if d.tk_type == 1 && d.tk_val == "%" { feature = true; }
        if d.tk_type == 3 && d.tk_val.starts_with("-") && prev_type == 1 { feature = true; }
        if d.tk_type == 6 && prev_type == 1 { feature = true; }
        if tk_is_punct(d, "(") == 1 {
            // SELECT (expr, a function call, or `, (expr` in the select list;
            // an aggregate, IN ( and a grouping parenthesis are the older path's.
            if prev_word == "SELECT" { feature = true; }
            if prev_ident && !is_agg_name(prev_word) && !x_reserved(prev_word) { feature = true; }
            if prev_comma && section == 0 { feature = true; }
            depth = depth + 1;
        }
        if tk_is_punct(d, ")") == 1 { depth = depth - 1; }
        // A comparison whose right side is a column, an expression or a
        // parenthesis: the condition parser reads only a literal there.
        if prev_type == 2 && (d.tk_type == 1 || tk_is_punct(d, "(") == 1) && !x_reserved(w) && w != "NULL" {
            if w != "SELECT" { feature = true; }
        }
        let is_operand = d.tk_type == 1 || d.tk_type == 2 || d.tk_type == 3 || tk_is_punct(d, ")") == 1;
        let is_cmp = d.tk_type == 4 && op_encode(d.tk_val) >= 0;
        if is_operand && !(d.tk_type == 1 && x_reserved(w)) { prev_type = 1; }
        else if is_cmp { prev_type = 2; }
        else { prev_type = 3; }
        prev2_lit = prev_lit;
        prev_lit = d.tk_type == 2 || d.tk_type == 3 || w == "NULL";
        prev2_word = prev_word;
        prev_word = w;
        prev_ident = d.tk_type == 1;
        prev_comma = tk_is_punct(d, ",") == 1;
        next_token(d);
    }
    if order_commas >= 2 { feature = true; }
    x_rewind(d);
    feature && !legacy
}

// Put the tokenizer back on the first token of the statement.
fn x_rewind(d: &mut DB) {
    d.pos = 0;
    d.tk_type = 7;
    d.tk_val = "";
    next_token(d);
}

// ---- values ----

fn xv_isnum(s: String) -> bool { is_numeric_str(s) }

fn xv_num(s: String) -> f64 { if is_numeric_str(s) { s.parse_float() } else { 0.0 } }

fn x_trunc(f: f64) -> f64 { if f < 0.0 { 0.0 - floor(0.0 - f) } else { floor(f) } }

fn xv_int(f: f64) -> String {
    let t = x_trunc(f);
    if t == 0.0 { return "0"; }
    to_string_f64(t)
}

fn xv_real(f: f64) -> String {
    if f == 0.0 { return "0.0"; }
    let s = to_string_f64(f);
    if s.index_of(".") < 0 && s.index_of("e") < 0 && s.index_of("n") < 0 { return s + ".0"; }
    s
}

// An integer value: a signed decimal integer, or non-numeric text (SQLite
// reads text with no number in it as 0).
fn xv_is_intlike(s: String) -> bool { is_int_str(s) || !is_numeric_str(s) }

fn xv_arith(a: String, b: String, op: i32) -> String {
    if is_null(a) || is_null(b) { return nullv(); }
    let x = xv_num(a);
    let y = xv_num(b);
    if xv_is_intlike(a) && xv_is_intlike(b) {
        if op == 0 { return xv_int(x + y); }
        if op == 1 { return xv_int(x - y); }
        if op == 2 { return xv_int(x * y); }
        if y == 0.0 { return nullv(); }
        if op == 3 { return xv_int(x_trunc(x / y)); }
        return xv_int(x - x_trunc(x / y) * y);
    }
    if op == 0 { return xv_real(x + y); }
    if op == 1 { return xv_real(x - y); }
    if op == 2 { return xv_real(x * y); }
    if y == 0.0 { return nullv(); }
    if op == 3 { return xv_real(x / y); }
    xv_real(x - x_trunc(x / y) * y)
}

// Order two non-NULL values: numbers before text, numbers by value.
fn xv_cmp_nn(a: String, b: String) -> i64 {
    let an = is_numeric_str(a);
    let bn = is_numeric_str(b);
    if an && bn {
        let x = a.parse_float();
        let y = b.parse_float();
        if x < y { return 0 - 1; }
        if x > y { return 1; }
        return 0;
    }
    if an { return 0 - 1; }
    if bn { return 1; }
    a.compare(b)
}

// Sort order: NULL first, then as xv_cmp_nn.
fn xv_cmp(a: String, b: String) -> i64 {
    let an = is_null(a);
    let bn = is_null(b);
    if an && bn { return 0; }
    if an { return 0 - 1; }
    if bn { return 1; }
    xv_cmp_nn(a, b)
}

fn xv_bool(t: i32) -> String {
    if t == 2 { return nullv(); }
    if t == 1 { return "1"; }
    "0"
}

// Truth of a value: 1 true, 0 false, 2 unknown (NULL).
fn xv_truth(s: String) -> i32 {
    if is_null(s) { return 2; }
    if xv_num(s) != 0.0 { return 1; }
    0
}

fn xv_compare_op(a: String, b: String, op: i32) -> i32 {
    if is_null(a) || is_null(b) { return 2; }
    let c = xv_cmp_nn(a, b);
    let r = if op == 0 { c == 0 } else if op == 1 { c < 0 } else if op == 2 { c > 0 }
            else if op == 3 { c <= 0 } else if op == 4 { c >= 0 } else { c != 0 };
    if r { 1 } else { 0 }
}

// ---- evaluation ----
// A scope is a Vec<i32> of triples (table, alias id or -1, row), outermost
// first. ag is the aggregate context of the innermost query: [base frame,
// width, count, then count tuples of width rows], or [-1] outside one.

fn x_frame_col(d: &DB, fs: Vec<i32>, k: i32, col: String) -> i32 {
    let t = vec_get(fs, k * 3);
    let cs = vec_get(d.tbl_col_starts, t);
    let cc = vec_get(d.tbl_col_counts, t);
    find_col(d, cs, cc, col)
}

fn x_frame_val(d: &DB, fs: Vec<i32>, k: i32, ci: i32) -> String {
    let t = vec_get(fs, k * 3);
    let row = vec_get(fs, k * 3 + 2);
    if row < 0 { return nullv(); }
    let cc = vec_get(d.tbl_col_counts, t);
    let rs = vec_get(d.tbl_row_starts, t);
    sp_get(d, vec_get(d.cells, rs + row * cc + ci))
}

// Frame and column of a column reference, innermost frame first; -1 if none.
// A table with an alias answers only to the alias, as in SQLite.
fn x_resolve(d: &DB, name: String, fs: Vec<i32>, nf: i32) -> Vec<i32> {
    let mut out: Vec<i32> = vec![];
    let dot = name.index_of(".");
    let mut k = nf - 1;
    while k >= 0 {
        let t = vec_get(fs, k * 3);
        let al = vec_get(fs, k * 3 + 1);
        if dot > 0 {
            let q = name.substring(0, dot);
            let col = name.substring(dot + 1, name.len() - dot - 1);
            let label = if al >= 0 { sp_get(d, al) } else { sp_get(d, vec_get(d.tbl_names, t)) };
            if label == q {
                let ci = x_frame_col(d, fs, k, col);
                if ci >= 0 { vec_push(out, k); vec_push(out, ci); return out; }
            }
        } else {
            let ci = x_frame_col(d, fs, k, name);
            if ci >= 0 { vec_push(out, k); vec_push(out, ci); return out; }
        }
        k = k - 1;
    }
    vec_push(out, -1);
    vec_push(out, -1);
    out
}

fn x_col(d: &DB, e: i32, fs: Vec<i32>, nf: i32) -> String ~ Console + Process {
    let name = sp_get(d, vec_get(d.x_s, e));
    let r = x_resolve(d, name, fs, nf);
    let k = vec_get(r, 0);
    if k < 0 {
        println!("Error: no such column: {}", name);
        process_exit(1);
    }
    x_frame_val(d, fs, k, vec_get(r, 1))
}

fn x_no_agg() -> Vec<i32> {
    let mut v: Vec<i32> = vec![];
    vec_push(v, -1);
    v
}

fn x_eval(d: &mut DB, e: i32, fs: Vec<i32>, nf: i32, ag: Vec<i32>) -> String ~ Console + Process {
    let k = vec_get(d.x_kind, e);
    if k == 0 { return sp_get(d, vec_get(d.x_s, e)); }
    if k == 1 { return x_col(d, e, fs, nf); }
    if k == 2 {
        let a = x_eval(d, vec_get(d.x_a, e), fs, nf, ag);
        let b = x_eval(d, vec_get(d.x_b, e), fs, nf, ag);
        return xv_arith(a, b, vec_get(d.x_c, e));
    }
    if k == 3 {
        let a = x_eval(d, vec_get(d.x_a, e), fs, nf, ag);
        return xv_arith("0", a, 1);
    }
    if k == 4 {
        let a = x_eval(d, vec_get(d.x_a, e), fs, nf, ag);
        let b = x_eval(d, vec_get(d.x_b, e), fs, nf, ag);
        return xv_bool(xv_compare_op(a, b, vec_get(d.x_c, e)));
    }
    if k == 5 || k == 6 {
        let a = xv_truth(x_eval(d, vec_get(d.x_a, e), fs, nf, ag));
        if k == 5 && a == 0 { return "0"; }
        if k == 6 && a == 1 { return "1"; }
        let b = xv_truth(x_eval(d, vec_get(d.x_b, e), fs, nf, ag));
        if k == 5 { return xv_bool(and3(a, b)); }
        return xv_bool(or3(a, b));
    }
    if k == 7 {
        let a = xv_truth(x_eval(d, vec_get(d.x_a, e), fs, nf, ag));
        return xv_bool(not3(a));
    }
    if k == 8 {
        let a = x_eval(d, vec_get(d.x_a, e), fs, nf, ag);
        let r = if is_null(a) { 1 } else { 0 };
        if vec_get(d.x_c, e) == 1 { return xv_bool(1 - r); }
        return xv_bool(r);
    }
    if k == 9 {
        let a = x_eval(d, vec_get(d.x_a, e), fs, nf, ag);
        let lo = x_eval(d, x_arg(d, e, 0), fs, nf, ag);
        let hi = x_eval(d, x_arg(d, e, 1), fs, nf, ag);
        let r = and3(xv_compare_op(a, lo, 4), xv_compare_op(a, hi, 3));
        if vec_get(d.x_c, e) == 1 { return xv_bool(not3(r)); }
        return xv_bool(r);
    }
    if k == 10 {
        let a = x_eval(d, vec_get(d.x_a, e), fs, nf, ag);
        let n = vec_get(d.x_an, e);
        let mut r = 0;
        // x IN () is false and x NOT IN () true, NULL included (P18).
        if is_null(a) && n > 0 { r = 2; }
        let mut i = 0;
        while i < n && r != 1 && !is_null(a) {
            let v = x_eval(d, x_arg(d, e, i), fs, nf, ag);
            let c = xv_compare_op(a, v, 0);
            if c == 1 { r = 1; } else if c == 2 { r = 2; }
            i = i + 1;
        }
        if vec_get(d.x_c, e) == 1 { return xv_bool(not3(r)); }
        return xv_bool(r);
    }
    if k == 11 || k == 12 {
        let n = vec_get(d.x_an, e);
        let mut base = "";
        if k == 12 { base = x_eval(d, vec_get(d.x_a, e), fs, nf, ag); }
        let mut i = 0;
        while i < n {
            let c = x_eval(d, x_arg(d, e, i), fs, nf, ag);
            let hit = if k == 11 { xv_truth(c) == 1 } else { xv_compare_op(base, c, 0) == 1 };
            if hit { return x_eval(d, x_arg(d, e, i + 1), fs, nf, ag); }
            i = i + 2;
        }
        let els = vec_get(d.x_b, e);
        if els >= 0 { return x_eval(d, els, fs, nf, ag); }
        return nullv();
    }
    if k == 13 { return x_func(d, e, fs, nf, ag); }
    if k == 14 {
        let rows = xq_run(d, vec_get(d.x_c, e), fs, nf, 1);
        if vec_len(rows) == 0 { return nullv(); }
        return sp_get(d, vec_get(rows, 0));
    }
    if k == 15 {
        let rows = xq_run(d, vec_get(d.x_c, e), fs, nf, 1);
        if vec_len(rows) > 0 { return "1"; }
        return "0";
    }
    if k == 16 {
        let a = x_eval(d, vec_get(d.x_a, e), fs, nf, ag);
        let rows = xq_run(d, vec_get(d.x_c, e), fs, nf, -1);
        let w = d.x_ncol;
        if w != 1 {
            println!("Error: sub-select returns {} columns - expected 1", w);
            process_exit(1);
        }
        let nr = if w > 0 { vec_len(rows) / w } else { 0 };
        let mut r = 0;
        if is_null(a) && nr > 0 { r = 2; }
        let mut i = 0;
        while i < nr && r != 1 && !is_null(a) {
            let c = xv_compare_op(a, sp_get(d, vec_get(rows, i * w)), 0);
            if c == 1 { r = 1; } else if c == 2 { r = 2; }
            i = i + 1;
        }
        if vec_get(d.x_b, e) == 1 { return xv_bool(not3(r)); }
        return xv_bool(r);
    }
    if k == 17 {
        let a = x_eval(d, vec_get(d.x_a, e), fs, nf, ag);
        let p = x_eval(d, vec_get(d.x_b, e), fs, nf, ag);
        if is_null(a) || is_null(p) { return nullv(); }
        let r = if eval_like(a, p) { 1 } else { 0 };
        if vec_get(d.x_c, e) == 1 { return xv_bool(1 - r); }
        return xv_bool(r);
    }
    if k == 18 { return x_agg(d, e, fs, nf, ag); }
    nullv()
}

fn x_func(d: &mut DB, e: i32, fs: Vec<i32>, nf: i32, ag: Vec<i32>) -> String ~ Console + Process {
    let name = sp_get(d, vec_get(d.x_s, e));
    let n = vec_get(d.x_an, e);
    if name == "ABS" && n == 1 {
        let a = x_eval(d, x_arg(d, e, 0), fs, nf, ag);
        if is_null(a) { return a; }
        let x = xv_num(a);
        let y = if x < 0.0 { 0.0 - x } else { x };
        if xv_is_intlike(a) { return xv_int(y); }
        return xv_real(y);
    }
    if (name == "COALESCE" && n >= 2) || (name == "IFNULL" && n == 2) {
        let mut i = 0;
        while i < n {
            let v = x_eval(d, x_arg(d, e, i), fs, nf, ag);
            if !is_null(v) { return v; }
            i = i + 1;
        }
        return nullv();
    }
    if name == "NULLIF" && n == 2 {
        let a = x_eval(d, x_arg(d, e, 0), fs, nf, ag);
        let b = x_eval(d, x_arg(d, e, 1), fs, nf, ag);
        if xv_compare_op(a, b, 0) == 1 { return nullv(); }
        return a;
    }
    println!("Error: no such function: {}", name.to_lowercase());
    process_exit(1);
    nullv()
}

// An aggregate over the tuples of the innermost query's aggregate context.
fn x_agg(d: &mut DB, e: i32, fs: Vec<i32>, nf: i32, ag: Vec<i32>) -> String ~ Console + Process {
    if vec_get(ag, 0) < 0 {
        println!("Error: misuse of aggregate function {}()", sp_get(d, vec_get(d.x_s, e)).to_lowercase());
        process_exit(1);
    }
    let name = sp_get(d, vec_get(d.x_s, e));
    let arg = vec_get(d.x_a, e);
    let dist = vec_get(d.x_c, e);
    let base = vec_get(ag, 0);
    let width = vec_get(ag, 1);
    let count = vec_get(ag, 2);
    let mut cnt = 0;
    let mut all_int = true;
    let mut sum = 0.0;
    let mut best = nullv();
    let sepx = vec_get(d.x_b, e);
    let mut gc: Vec<String> = vec![];
    let seen: HashMap<String, f64> = map_new();
    let none = x_no_agg();
    let mut t = 0;
    while t < count {
        let mut f2: Vec<i32> = vec![];
        let mut i = 0;
        while i < nf * 3 { vec_push(f2, vec_get(fs, i)); i = i + 1; }
        let mut j = 0;
        while j < width {
            f2[(base + j) * 3 + 2] = vec_get(ag, 3 + t * width + j);
            j = j + 1;
        }
        if arg < 0 {
            cnt = cnt + 1;
        } else {
            let v = x_eval(d, arg, f2, nf, none);
            let mut take = !is_null(v);
            if take && dist == 1 {
                let key = con_part(v);
                if map_contains(seen, key) { take = false; }
                else { map_insert(seen, key, 1.0); }
            }
            if take {
                cnt = cnt + 1;
                sum = sum + xv_num(v);
                if !xv_is_intlike(v) { all_int = false; }
                if name == "MIN" { if is_null(best) || xv_cmp_nn(v, best) < 0 { best = v; } }
                if name == "MAX" { if is_null(best) || xv_cmp_nn(v, best) > 0 { best = v; } }
                if name == "GROUP_CONCAT" {
                    // SQLite puts the row's separator before every value but the first.
                    if cnt > 1 {
                        let mut sv = ",";
                        if sepx >= 0 { sv = disp_or_empty(x_eval(d, sepx, f2, nf, none)); }
                        vec_push(gc, sv);
                    }
                    vec_push(gc, v);
                }
            }
        }
        t = t + 1;
    }
    if name == "COUNT" { return xv_int(cnt as f64); }
    if name == "MIN" || name == "MAX" { return best; }
    if name == "TOTAL" { return xv_real(sum); }
    if name == "GROUP_CONCAT" {
        if cnt == 0 { return nullv(); }
        return concat_parts(gc);
    }
    if cnt == 0 { return nullv(); }
    if name == "SUM" { if all_int { return xv_int(sum); } return xv_real(sum); }
    xv_real(sum / (cnt as f64))
}

// A NULL separator joins with nothing, as in SQLite.
fn disp_or_empty(v: String) -> String {
    if is_null(v) { return ""; }
    v
}

fn x_has_agg(d: &DB, e: i32) -> bool {
    if e < 0 { return false; }
    let k = vec_get(d.x_kind, e);
    if k == 18 { return true; }
    if k == 14 || k == 15 { return false; }
    if x_has_agg(d, vec_get(d.x_a, e)) { return true; }
    if k != 16 && k != 8 && k != 17 && x_has_agg(d, vec_get(d.x_b, e)) { return true; }
    if k == 17 && x_has_agg(d, vec_get(d.x_b, e)) { return true; }
    let n = vec_get(d.x_an, e);
    let mut i = 0;
    while i < n {
        if x_has_agg(d, x_arg(d, e, i)) { return true; }
        i = i + 1;
    }
    false
}

// Run query q in the scope (outer, onf) and return its rows as pool ids,
// row-major; d.x_ncol is the column count. want > 0 stops after that many
// rows when there is no ORDER BY, DISTINCT or aggregate.
fn xq_run(d: &mut DB, q: i32, outer: Vec<i32>, onf: i32, want: i32) -> Vec<i32> ~ Console + Process {
    let fs0 = vec_get(d.q_fs, q);
    let nloc = vec_get(d.q_fn, q);
    let ss = vec_get(d.q_ss, q);
    let ns = vec_get(d.q_sn, q);
    let wh = vec_get(d.q_where, q);
    let os = vec_get(d.q_os, q);
    let no = vec_get(d.q_on, q);
    let distinct = vec_get(d.q_distinct, q);
    let nf = onf + nloc;
    let mut fs: Vec<i32> = vec![];
    let mut i = 0;
    while i < onf * 3 { vec_push(fs, vec_get(outer, i)); i = i + 1; }
    i = 0;
    while i < nloc {
        vec_push(fs, vec_get(d.qf_tbl, fs0 + i));
        vec_push(fs, vec_get(d.qf_alias, fs0 + i));
        vec_push(fs, -1);
        i = i + 1;
    }
    let mut is_agg = false;
    i = 0;
    while i < ns {
        if x_has_agg(d, vec_get(d.qs_expr, ss + i)) { is_agg = true; }
        i = i + 1;
    }
    // Output columns: a star expands to every column of every FROM table.
    let mut ncol = 0;
    i = 0;
    while i < ns {
        if vec_get(d.qs_expr, ss + i) < 0 {
            let mut t = 0;
            while t < nloc { ncol = ncol + vec_get(d.tbl_col_counts, vec_get(d.qf_tbl, fs0 + t)); t = t + 1; }
        } else { ncol = ncol + 1; }
        i = i + 1;
    }
    let early = want > 0 && no == 0 && distinct == 0 && !is_agg;
    let none = x_no_agg();
    let mut out: Vec<i32> = vec![];
    let mut keys: Vec<i32> = vec![];
    let mut nrows = 0;
    let mut tuples: Vec<i32> = vec![];
    let mut ntup = 0;
    let mut first_rows: Vec<i32> = vec![];
    // The conjuncts of WHERE, each checked at the shallowest FROM depth
    // where every column it names is bound (P12): a filter on t1 alone is
    // not re-checked for every row of t2 .. t8.
    let mut conj: Vec<i32> = vec![];
    let mut cdepth: Vec<i32> = vec![];
    let mut nc = 0;
    if wh >= 0 {
        x_collect_conj(d, wh, conj);
        nc = vec_len(conj);
    }
    // The FROM tables each conjunct names (P12): crefs[cs[ci] .. + cn[ci]],
    // positions among this query's tables; -2 stands for all of them.
    let mut crefs: Vec<i32> = vec![];
    let mut cs: Vec<i32> = vec![];
    let mut cn: Vec<i32> = vec![];
    let mut ci0 = 0;
    while ci0 < nc {
        let st = vec_len(crefs);
        x_refs(d, vec_get(conj, ci0), fs, nf, onf, crefs);
        vec_push(cs, st);
        vec_push(cn, vec_len(crefs) - st);
        ci0 = ci0 + 1;
    }
    let perm = x_join_order(d, conj, nc, crefs, cs, cn, nloc);
    let mut pos_of: Vec<i32> = vec![];
    i = 0;
    while i < nloc { vec_push(pos_of, 0); i = i + 1; }
    i = 0;
    while i < nloc { pos_of[vec_get(perm, i)] = i; i = i + 1; }
    // A conjunct is checked at the step that binds the last table it names.
    ci0 = 0;
    while ci0 < nc {
        let mut dmax = -1;
        let mut j = 0;
        while j < vec_get(cn, ci0) {
            let r = vec_get(crefs, vec_get(cs, ci0) + j);
            let p = if r == -2 { nloc - 1 } else { vec_get(pos_of, r) };
            if p > dmax { dmax = p; }
            j = j + 1;
        }
        vec_push(cdepth, dmax);
        ci0 = ci0 + 1;
    }
    // Odometer over the FROM tables in join order; level is the step being
    // advanced, slot the table's place in the frames.
    let mut rows_of: Vec<i32> = vec![];
    let mut slot_of: Vec<i32> = vec![];
    i = 0;
    while i < nloc {
        let t = vec_get(perm, i);
        vec_push(rows_of, vec_get(d.tbl_row_counts, vec_get(d.qf_tbl, fs0 + t)));
        vec_push(slot_of, onf + t);
        i = i + 1;
    }
    let mut level = 0;
    let mut done = false;
    if nloc == 0 {
        // SELECT with no FROM: one tuple of no rows.
        level = 0;
    }
    let mut stop = false;
    while !done && !stop {
        let mut full = false;
        if nloc == 0 {
            full = true;
            done = true;
        } else {
            let slot = vec_get(slot_of, level);
            let cur = vec_get(fs, slot * 3 + 2) + 1;
            if cur >= vec_get(rows_of, level) {
                fs[slot * 3 + 2] = -1;
                if level == 0 { done = true; } else { level = level - 1; }
            } else {
                fs[slot * 3 + 2] = cur;
                // Conjuncts whose deepest table is this one.
                let mut ok = true;
                let mut ci = 0;
                while ci < nc && ok {
                    if vec_get(cdepth, ci) == level {
                        if xv_truth(x_eval(d, vec_get(conj, ci), fs, nf, none)) != 1 { ok = false; }
                    }
                    ci = ci + 1;
                }
                if ok {
                    if level == nloc - 1 { full = true; } else { level = level + 1; }
                }
            }
        }
        if full {
            // Conjuncts that name no FROM table of this query (outer columns
            // or constants) are checked here, once per tuple.
            let mut ok = true;
            let mut ci = 0;
            while ci < nc && ok {
                if vec_get(cdepth, ci) < 0 || nloc == 0 {
                    if xv_truth(x_eval(d, vec_get(conj, ci), fs, nf, none)) != 1 { ok = false; }
                }
                ci = ci + 1;
            }
            if ok {
                if is_agg {
                    let mut j = 0;
                    while j < nloc { vec_push(tuples, vec_get(fs, (onf + j) * 3 + 2)); j = j + 1; }
                    if ntup == 0 {
                        j = 0;
                        while j < nloc { vec_push(first_rows, vec_get(fs, (onf + j) * 3 + 2)); j = j + 1; }
                    }
                    ntup = ntup + 1;
                } else {
                    x_emit(d, q, fs, nf, nloc, onf, none, out, keys);
                    nrows = nrows + 1;
                    if early && nrows >= want { stop = true; }
                }
            }
        }
    }
    if is_agg {
        let mut ag: Vec<i32> = vec![];
        vec_push(ag, onf);
        vec_push(ag, nloc);
        vec_push(ag, ntup);
        i = 0;
        while i < ntup * nloc { vec_push(ag, vec_get(tuples, i)); i = i + 1; }
        i = 0;
        while i < nloc {
            fs[(onf + i) * 3 + 2] = if ntup > 0 { vec_get(first_rows, i) } else { -1 };
            i = i + 1;
        }
        x_emit(d, q, fs, nf, nloc, onf, ag, out, keys);
        nrows = 1;
    }
    // DISTINCT, then ORDER BY, then OFFSET and LIMIT.
    let mut idx: Vec<i32> = vec![];
    let mut nidx = 0;
    if distinct == 1 {
        let mut seen: Vec<String> = vec![];
        let mut r = 0;
        while r < nrows {
            let mut key = "";
            let mut c = 0;
            while c < ncol {
                if c > 0 { key = key + "\x1f"; }
                key = key + sp_get(d, vec_get(out, r * ncol + c));
                c = c + 1;
            }
            let mut dup = false;
            let mut si = 0;
            while si < nidx {
                let sk: String = vec_get(seen, si);
                if sk == key { dup = true; }
                si = si + 1;
            }
            if !dup { vec_push(seen, key); vec_push(idx, r); nidx = nidx + 1; }
            r = r + 1;
        }
    } else {
        let mut r = 0;
        while r < nrows { vec_push(idx, r); nidx = nidx + 1; r = r + 1; }
    }
    if no > 0 { idx = x_sort(d, idx, nidx, keys, no, os); }
    let lim = vec_get(d.q_limit, q);
    let off = vec_get(d.q_offset, q);
    let mut res: Vec<i32> = vec![];
    let mut r = off;
    let mut taken = 0;
    while r < nidx && (lim < 0 || taken < lim) {
        let src = vec_get(idx, r);
        let mut c = 0;
        while c < ncol { vec_push(res, vec_get(out, src * ncol + c)); c = c + 1; }
        taken = taken + 1;
        r = r + 1;
    }
    d.x_ncol = ncol;
    res
}

// Split an AND chain into its conjuncts, in order.
fn x_collect_conj(d: &DB, e: i32, conj: Vec<i32>) {
    if vec_get(d.x_kind, e) == 5 {
        x_collect_conj(d, vec_get(d.x_a, e), conj);
        x_collect_conj(d, vec_get(d.x_b, e), conj);
        return;
    }
    vec_push(conj, e);
}

// Push the positions (among this query's FROM tables) of the tables that
// expression e names; -2 for a subquery, which may name any of them.
fn x_refs(d: &DB, e: i32, fs: Vec<i32>, nf: i32, onf: i32, out: Vec<i32>) {
    if e < 0 { return; }
    let k = vec_get(d.x_kind, e);
    if k == 1 {
        let r = x_resolve(d, sp_get(d, vec_get(d.x_s, e)), fs, nf);
        let f = vec_get(r, 0);
        if f >= onf { vec_push(out, f - onf); }
        return;
    }
    if k == 14 || k == 15 || k == 16 { vec_push(out, -2); }
    if k == 14 || k == 15 { return; }
    x_refs(d, vec_get(d.x_a, e), fs, nf, onf, out);
    if k != 8 && k != 16 { x_refs(d, vec_get(d.x_b, e), fs, nf, onf, out); }
    let n = vec_get(d.x_an, e);
    let mut i = 0;
    while i < n { x_refs(d, x_arg(d, e, i), fs, nf, onf, out); i = i + 1; }
}

// Greedy join order (P12): each step takes the unplaced table with the best
// score, the lowest FROM position on a tie. 4: an equality conjunct links it
// to a placed table; 2: a conjunct names it alone; 1: another conjunct links
// it to a placed table; 0: none. A conjunct naming a subquery links nothing.
fn x_join_order(d: &DB, conj: Vec<i32>, nc: i32, crefs: Vec<i32>, cs: Vec<i32>, cn: Vec<i32>, nloc: i32) -> Vec<i32> {
    let mut placed: Vec<i32> = vec![];
    let mut i = 0;
    while i < nloc { vec_push(placed, 0); i = i + 1; }
    let mut perm: Vec<i32> = vec![];
    let mut step = 0;
    while step < nloc {
        let mut best = -1;
        let mut best_score = -1;
        let mut t = 0;
        while t < nloc {
            if vec_get(placed, t) == 0 {
                let mut score = 0;
                let mut ci = 0;
                while ci < nc {
                    let n = vec_get(cn, ci);
                    let st = vec_get(cs, ci);
                    let mut names_t = false;
                    let mut others_placed = true;
                    let mut has_other = false;
                    let mut sub = false;
                    let mut j = 0;
                    while j < n {
                        let r = vec_get(crefs, st + j);
                        if r == -2 { sub = true; }
                        else if r == t { names_t = true; }
                        else {
                            has_other = true;
                            if vec_get(placed, r) == 0 { others_placed = false; }
                        }
                        j = j + 1;
                    }
                    if names_t && !sub && others_placed {
                        let c = vec_get(conj, ci);
                        let eq = vec_get(d.x_kind, c) == 4 && vec_get(d.x_c, c) == 0;
                        let sc = if has_other { if eq { 4 } else { 1 } } else { 2 };
                        if sc > score { score = sc; }
                    }
                    ci = ci + 1;
                }
                if score > best_score { best_score = score; best = t; }
            }
            t = t + 1;
        }
        placed[best] = 1;
        vec_push(perm, best);
        step = step + 1;
    }
    perm
}

// Evaluate the select list (and the ORDER BY keys) for the bound tuple.
fn x_emit(d: &mut DB, q: i32, fs: Vec<i32>, nf: i32, nloc: i32, onf: i32, ag: Vec<i32>,
          out: Vec<i32>, keys: Vec<i32>) ~ Console + Process {
    let ss = vec_get(d.q_ss, q);
    let ns = vec_get(d.q_sn, q);
    let fs0 = vec_get(d.q_fs, q);
    let mut row: Vec<i32> = vec![];
    let mut i = 0;
    while i < ns {
        let e = vec_get(d.qs_expr, ss + i);
        if e < 0 {
            let mut t = 0;
            while t < nloc {
                let cc = vec_get(d.tbl_col_counts, vec_get(d.qf_tbl, fs0 + t));
                let mut c = 0;
                while c < cc {
                    let v = x_frame_val(d, fs, onf + t, c);
                    vec_push(out, sp_add(d, v));
                    vec_push(row, vec_len(out) - 1);
                    c = c + 1;
                }
                t = t + 1;
            }
        } else {
            let v = x_eval(d, e, fs, nf, ag);
            vec_push(out, sp_add(d, v));
            vec_push(row, vec_len(out) - 1);
        }
        i = i + 1;
    }
    let os = vec_get(d.q_os, q);
    let no = vec_get(d.q_on, q);
    let mut j = 0;
    while j < no {
        let e = vec_get(d.qo_expr, os + j);
        let mut v = "";
        let mut done = false;
        // ORDER BY 2 names the second output column; a name that is an
        // output alias names that column.
        if vec_get(d.x_kind, e) == 0 {
            let lit = sp_get(d, vec_get(d.x_s, e));
            if is_int_str(lit) {
                let pos = parse_int_str(lit);
                if pos < 1 || pos > vec_len(row) {
                    println!("Error: ORDER BY term out of range: {}", lit);
                    process_exit(1);
                }
                v = sp_get(d, vec_get(out, vec_get(row, pos - 1)));
                done = true;
            }
        }
        if !done && vec_get(d.x_kind, e) == 1 {
            let nm = sp_get(d, vec_get(d.x_s, e));
            let r = x_resolve(d, nm, fs, nf);
            if vec_get(r, 0) < 0 {
                let mut si = 0;
                while si < ns && !done {
                    let an = vec_get(d.qs_name, ss + si);
                    if an >= 0 && sp_get(d, an) == nm && vec_get(d.qs_expr, ss + si) >= 0 {
                        v = sp_get(d, vec_get(out, vec_get(row, si)));
                        done = true;
                    }
                    si = si + 1;
                }
            }
        }
        if !done { v = x_eval(d, e, fs, nf, ag); }
        vec_push(keys, sp_add(d, v));
        j = j + 1;
    }
}

// Stable merge sort of the row positions idx by the ORDER BY keys.
fn x_sort(d: &DB, idx: Vec<i32>, n: i32, keys: Vec<i32>, no: i32, os: i32) -> Vec<i32> {
    let mut src: Vec<i32> = vec![];
    let mut dst: Vec<i32> = vec![];
    let mut i = 0;
    while i < n { vec_push(src, vec_get(idx, i)); vec_push(dst, vec_get(idx, i)); i = i + 1; }
    let mut width = 1;
    while width < n {
        let mut lo = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut a = lo;
            let mut b = mid;
            let mut o = lo;
            while o < hi {
                let mut take_a = false;
                if a < mid {
                    if b >= hi { take_a = true; }
                    else {
                        let ra = vec_get(src, a);
                        let rb = vec_get(src, b);
                        let mut c = 0;
                        let mut k = 0;
                        while k < no && c == 0 {
                            c = xv_cmp(sp_get(d, vec_get(keys, ra * no + k)), sp_get(d, vec_get(keys, rb * no + k)));
                            if vec_get(d.qo_desc, os + k) == 1 { c = 0 - c; }
                            k = k + 1;
                        }
                        if c <= 0 { take_a = true; }
                    }
                }
                if take_a { dst[o] = vec_get(src, a); a = a + 1; }
                else { dst[o] = vec_get(src, b); b = b + 1; }
                o = o + 1;
            }
            lo = lo + 2 * width;
        }
        let tmp = src;
        src = dst;
        dst = tmp;
        width = width * 2;
    }
    src
}

fn exec_xselect(d: &mut DB) ~ Console + Process {
    let q = d.xq_root;
    let none: Vec<i32> = vec![];
    let rows = xq_run(d, q, none, 0, -1);
    let ncol = d.x_ncol;
    let nrows = if ncol > 0 { vec_len(rows) / ncol } else { 0 };
    // Header names: the alias, the column name, or the column's position.
    let ss = vec_get(d.q_ss, q);
    let ns = vec_get(d.q_sn, q);
    let fs0 = vec_get(d.q_fs, q);
    let nloc = vec_get(d.q_fn, q);
    let mut hdr: Vec<String> = vec![];
    let mut i = 0;
    while i < ns {
        let e = vec_get(d.qs_expr, ss + i);
        if e < 0 {
            let mut t = 0;
            while t < nloc {
                let ti = vec_get(d.qf_tbl, fs0 + t);
                let cs = vec_get(d.tbl_col_starts, ti);
                let cc = vec_get(d.tbl_col_counts, ti);
                let mut c = 0;
                while c < cc { vec_push(hdr, sp_get(d, vec_get(d.col_names, cs + c))); c = c + 1; }
                t = t + 1;
            }
        } else {
            let nm = vec_get(d.qs_name, ss + i);
            if nm >= 0 { vec_push(hdr, sp_get(d, nm)); }
            else { vec_push(hdr, "col" + int_to_str(vec_len(hdr) + 1)); }
        }
        i = i + 1;
    }
    let mut widths: Vec<i32> = vec![];
    let mut c = 0;
    while c < ncol {
        let h: String = vec_get(hdr, c);
        let mut w = h.len();
        let mut r = 0;
        while r < nrows {
            let vl = dlen(sp_get(d, vec_get(rows, r * ncol + c)));
            if vl > w { w = vl; }
            r = r + 1;
        }
        vec_push(widths, w);
        c = c + 1;
    }
    let mut hl = "";
    let mut sl = "";
    c = 0;
    while c < ncol {
        if c > 0 { hl = hl + " | "; sl = sl + "-+-"; }
        let h: String = vec_get(hdr, c);
        rows_hdr(d, h);
        hl = hl + pad_right(h, vec_get(widths, c));
        sl = sl + make_dashes(vec_get(widths, c));
        c = c + 1;
    }
    emit_line(d, hl);
    emit_line(d, sl);
    let mut r = 0;
    while r < nrows {
        let mut line = "";
        c = 0;
        while c < ncol {
            if c > 0 { line = line + " | "; }
            let v = sp_get(d, vec_get(rows, r * ncol + c));
            rows_cell(d, v);
            if is_numeric_str(v) { line = line + pad_left(v, vec_get(widths, c)); }
            else { line = line + pad_right(v, vec_get(widths, c)); }
            c = c + 1;
        }
        emit_line(d, line);
        r = r + 1;
    }
}


// =========================================================================
// SECTION 6i: CONSTRAINTS (P13)
// =========================================================================
// UNIQUE, PRIMARY KEY and NOT NULL, checked by INSERT and UPDATE before a
// cell changes. NULLs in a UNIQUE or PRIMARY KEY column never collide, as in
// SQLite; a NULL in a single INTEGER PRIMARY KEY column takes the largest key
// plus one (SQLite's rowid alias). Keys compare as values (1 equals 1.0).

fn con_kind_name(k: i32) -> String {
    if k == 1 { return "PRIMARY KEY"; }
    if k == 2 { return "NOT NULL"; }
    "UNIQUE"
}

// The constraint lines of table t for the .db file.
fn con_text(d: &DB, t: i32, cs: i32) -> String {
    let mut out = "";
    let mut k = 0;
    while k < vec_len(d.con_tbl) {
        if vec_get(d.con_tbl, k) == t {
            let mut line = con_kind_name(vec_get(d.con_kind, k)) + " ";
            let n = vec_get(d.con_cn, k);
            let st = vec_get(d.con_cs, k);
            let mut j = 0;
            while j < n {
                if j > 0 { line = line + ","; }
                line = line + sp_get(d, vec_get(d.col_names, cs + vec_get(d.con_cols, st + j)));
                j = j + 1;
            }
            out = out + line + "\n";
        }
        k = k + 1;
    }
    out
}

// Load one constraint line for the table being read (the last one).
fn con_load_line(d: &mut DB, line: String) {
    let mut kind = 0;
    let mut rest = "";
    if line.starts_with("UNIQUE ") { kind = 0; rest = line.substring(7, line.len() - 7); }
    else if line.starts_with("PRIMARY KEY ") { kind = 1; rest = line.substring(12, line.len() - 12); }
    else { kind = 2; rest = line.substring(9, line.len() - 9); }
    let t = d.tbl_count - 1;
    if t < 0 { return; }
    let cs = vec_get(d.tbl_col_starts, t);
    let cc = vec_get(d.tbl_col_counts, t);
    let st = vec_len(d.con_cols);
    let mut n = 0;
    let mut cur = "";
    let mut i: i64 = 0;
    let len = rest.len();
    while i <= len {
        let c = if i < len { rest.char_at(i) } else { "," };
        if c == "," {
            let ci = find_col(d, cs, cc, cur.trim());
            if ci >= 0 { vec_push(d.con_cols, ci); n = n + 1; }
            cur = "";
        } else { cur = cur + c; }
        i = i + 1;
    }
    if n == 0 { return; }
    vec_push(d.con_tbl, t);
    d.con_map_ok = false;
    vec_push(d.con_kind, kind);
    vec_push(d.con_cs, st);
    vec_push(d.con_cn, n);
}

fn con_fail_text(d: &DB, k: i32, t: i32) -> String {
    let cs = vec_get(d.tbl_col_starts, t);
    let tn = sp_get(d, vec_get(d.tbl_names, t));
    let kind = vec_get(d.con_kind, k);
    let mut out = if kind == 2 { "NOT NULL constraint failed: " } else { "UNIQUE constraint failed: " };
    let n = vec_get(d.con_cn, k);
    let st = vec_get(d.con_cs, k);
    let mut j = 0;
    while j < n {
        if j > 0 { out = out + ", "; }
        out = out + tn + "." + sp_get(d, vec_get(d.col_names, cs + vec_get(d.con_cols, st + j)));
        j = j + 1;
    }
    out
}

// Do rows a and b (cell positions of their first column) have equal,
// non-NULL keys under constraint k?
fn con_same_key(d: &DB, k: i32, ca: Vec<i32>, a: i32, cb: Vec<i32>, b: i32) -> bool {
    let n = vec_get(d.con_cn, k);
    let st = vec_get(d.con_cs, k);
    let mut j = 0;
    while j < n {
        let c = vec_get(d.con_cols, st + j);
        let va = sp_get(d, vec_get(ca, a + c));
        let vb = sp_get(d, vec_get(cb, b + c));
        if is_null(va) || is_null(vb) { return false; }
        if xv_cmp_nn(va, vb) != 0 { return false; }
        j = j + 1;
    }
    true
}

// Digits of an integral value below 1e15 in magnitude, exactly.
fn con_int_digits(f: f64) -> String {
    let digits = "0123456789";
    let neg = f < 0.0;
    let mut v = if neg { 0.0 - f } else { f };
    let mut out = "";
    while v >= 1.0 {
        let q = x_trunc(v / 10.0);
        let r = v - q * 10.0;
        let mut i: i64 = 0;
        while (i as f64) < r { i = i + 1; }
        out = digits.char_at(i) + out;
        v = q;
    }
    if neg { return "-" + out; }
    out
}

// One key cell as text that is equal for two cells exactly when xv_cmp_nn
// calls them equal: a number by its value (so 1 and 1.0 match), text as is.
fn con_part(v: String) -> String {
    if is_numeric_str(v) {
        let f = v.parse_float();
        if f == 0.0 { return "N0"; }
        if f == x_trunc(f) && f < 1000000000000000.0 && f > 0.0 - 1000000000000000.0 {
            return "N" + con_int_digits(f);
        }
        return "N" + to_string_f64(f);
    }
    "T" + v
}

// The map key of row `base` (cell position of its first column) under
// constraint k, or "" when a key cell is NULL (NULL keys are distinct).
fn con_key(d: &DB, k: i32, cells: Vec<i32>, base: i32) -> String {
    let n = vec_get(d.con_cn, k);
    let st = vec_get(d.con_cs, k);
    let mut key = to_string_i32(k);
    let mut j = 0;
    while j < n {
        let v = sp_get(d, vec_get(cells, base + vec_get(d.con_cols, st + j)));
        if is_null(v) { return ""; }
        let part = con_part(v);
        key = key + "|" + to_string_i32(part.len()) + ":" + part;
        j = j + 1;
    }
    key
}

fn con_is_ipk(d: &DB, k: i32) -> bool {
    let t = vec_get(d.con_tbl, k);
    let cs = vec_get(d.tbl_col_starts, t);
    let c0 = vec_get(d.con_cols, vec_get(d.con_cs, k));
    vec_get(d.con_kind, k) == 1 && vec_get(d.con_cn, k) == 1 && vec_get(d.col_types, cs + c0) == 0
}

// Add rows (row-major in cells from base, nrows of them, cc columns) of
// table t to the key map.
fn con_map_add(d: &mut DB, t: i32, cells: Vec<i32>, base: i32, nrows: i32, cc: i32) {
    let mut k = 0;
    while k < vec_len(d.con_tbl) {
        if vec_get(d.con_tbl, k) == t && vec_get(d.con_kind, k) != 2 {
            let ipk = con_is_ipk(d, k);
            let mk = "M" + to_string_i32(k);
            let c0 = vec_get(d.con_cols, vec_get(d.con_cs, k));
            let mut mx = 0.0;
            if map_contains(d.con_map, mk) { mx = map_get(d.con_map, mk); }
            let mut r = 0;
            while r < nrows {
                let key = con_key(d, k, cells, base + r * cc);
                if key.len() > 0 { map_insert(d.con_map, key, 1.0); }
                if ipk {
                    let v = sp_get(d, vec_get(cells, base + r * cc + c0));
                    if is_numeric_str(v) && v.parse_float() > mx { mx = v.parse_float(); }
                }
                r = r + 1;
            }
            if ipk { map_insert(d.con_map, mk, mx); }
        }
        k = k + 1;
    }
}

// Rebuild the key map from every constrained table, in one pass each.
fn con_map_build(d: &mut DB) {
    d.con_map = map_new();
    let mut t = 0;
    while t < d.tbl_count {
        let cc = vec_get(d.tbl_col_counts, t);
        con_map_add(d, t, d.cells, vec_get(d.tbl_row_starts, t), vec_get(d.tbl_row_counts, t), cc);
        t = t + 1;
    }
    d.con_map_ok = true;
}

// Check nrows new rows (row-major in rows) against table t and each other.
// Fills a NULL single INTEGER PRIMARY KEY with the largest key plus one.
// Returns the error text, or "" when every constraint holds.
fn con_check_insert(d: &mut DB, t: i32, rows: Vec<i32>, nrows: i32) -> String {
    let cs = vec_get(d.tbl_col_starts, t);
    let cc = vec_get(d.tbl_col_counts, t);
    if !d.con_map_ok { con_map_build(d); }
    let mut k = 0;
    while k < vec_len(d.con_tbl) {
        if vec_get(d.con_tbl, k) == t {
            let kind = vec_get(d.con_kind, k);
            let st = vec_get(d.con_cs, k);
            let c0 = vec_get(d.con_cols, st);
            if con_is_ipk(d, k) {
                // INTEGER PRIMARY KEY: number NULLs after the largest key.
                let mk = "M" + to_string_i32(k);
                let mut mx = 0.0;
                if map_contains(d.con_map, mk) { mx = map_get(d.con_map, mk); }
                let mut r = 0;
                while r < nrows {
                    let v = sp_get(d, vec_get(rows, r * cc + c0));
                    if is_numeric_str(v) && v.parse_float() > mx { mx = v.parse_float(); }
                    r = r + 1;
                }
                r = 0;
                while r < nrows {
                    let v = sp_get(d, vec_get(rows, r * cc + c0));
                    if is_null(v) {
                        mx = mx + 1.0;
                        rows[r * cc + c0] = sp_add(d, xv_int(mx));
                    }
                    r = r + 1;
                }
            }
            if kind == 2 {
                let mut r = 0;
                while r < nrows {
                    if is_null(sp_get(d, vec_get(rows, r * cc + c0))) { return con_fail_text(d, k, t); }
                    r = r + 1;
                }
            } else {
                let batch: HashMap<String, f64> = map_new();
                let mut r = 0;
                while r < nrows {
                    let key = con_key(d, k, rows, r * cc);
                    if key.len() > 0 {
                        if map_contains(d.con_map, key) || map_contains(batch, key) { return con_fail_text(d, k, t); }
                        map_insert(batch, key, 1.0);
                    }
                    r = r + 1;
                }
            }
        }
        k = k + 1;
    }
    // Every constraint holds: the rows go in, and so do their keys.
    con_map_add(d, t, rows, 0, nrows, cc);
    ""
}

fn exec_sql_no_wal(d: &mut DB, input: String) ~ Console + FileSystem + Process {
    reset_parser(d, input);
    parse_sql(d);
    let st = d.stmt_type;
    // INSERT and UPDATE keep the key map current themselves (P17, P20).
    if st != 0 && st != 20 && st != 1 && st != 3 { d.con_map_ok = false; }
    if st == 0 { exec_select(d); }
    else if st == 20 { exec_xselect(d); }
    else if st == 1 { exec_insert(d); }
    else if st == 2 { exec_create(d); }
    else if st == 3 { exec_update(d); }
    else if st == 4 { exec_delete(d); }
    else if st == 5 { exec_drop(d); }
    else if st == 6 { exec_create_index(d); }
    else if st == 7 { wal_begin(d); }
    else if st == 8 { wal_commit(d); }
    else if st == 9 { wal_rollback(d); }
    else if st == 10 { exec_alter_table(d); }
}

// =========================================================================
// History, AS OF and receipts (bdb/COMPLETE.md P16)
// =========================================================================
// <db>.hist holds "BASE <txid>" and then every committed transaction as the
// WAL wrote it (TXID, OP lines, COMMIT <hash>). <db>.hist.base is the state
// at that txid when the database already held tables. A record whose hash
// does not match is skipped, and the first whole record of a txid wins, so a
// record lost from the history's cache and appended again by WAL replay
// leaves one copy in effect.

// Position of a trailing "AS OF <digits>" (the space before AS), or -1.
fn as_of_pos(s: String) -> i64 {
    let digits = "0123456789";
    let n = s.len();
    let mut i = n;
    while i > 0 && digits.index_of(s.char_at(i - 1)) >= 0 { i = i - 1; }
    if i == n { return 0 - 1; }
    let mut j = i;
    while j > 0 && s.char_at(j - 1) == " " { j = j - 1; }
    if j == i || j < 2 { return 0 - 1; }
    if s.substring(j - 2, 2).to_uppercase() != "OF" { return 0 - 1; }
    j = j - 2;
    let k = j;
    while j > 0 && s.char_at(j - 1) == " " { j = j - 1; }
    if j == k || j < 3 { return 0 - 1; }
    if s.substring(j - 2, 2).to_uppercase() != "AS" { return 0 - 1; }
    j = j - 2;
    if s.char_at(j - 1) != " " { return 0 - 1; }
    j - 1
}

// The txid of the history's BASE line (0 for a history without one).
fn hist_base(d: &DB) -> i32 ~ FileSystem {
    let content = read_file(d.hist_path);
    let nl = content.index_of("\n");
    let first = if nl >= 0 { content.substring(0, nl) } else { content };
    let f = strip_cr(first);
    if f.starts_with("BASE ") { return parse_int_str(f.substring(5, f.len() - 5)); }
    0
}

// The state after every committed transaction with txid <= n, rebuilt in a
// separate in-memory database from the base and the history. Nothing is
// written: replay goes through exec_sql_no_wal.
fn hist_state(d: &DB, n: i32) -> DB ~ Console + FileSystem + Process {
    let mut d2 = db_new(d.hist_path + ".base");
    db_load(&mut d2);
    let base = hist_base(d);
    let content = read_file(d.hist_path);
    let lines: Vec<String> = content.lines();
    let nl = vec_len(lines);
    let mut rec_id: Vec<i32> = vec![];
    let mut rec_start: Vec<i64> = vec![];
    let mut rec_end: Vec<i64> = vec![];
    let mut max_id = base;
    let mut txn_start: i64 = 0 - 1;
    let mut txn_id = 0;
    let mut txn_h = fnv_init();
    let mut li: i64 = 0;
    while li < nl {
        let wl = strip_cr(vec_get(lines, li));
        if wl.starts_with("TXID ") {
            txn_h = fnv_extend(fnv_init(), wl + "\n");
            txn_id = parse_int_str(wl.substring(5, wl.len() - 5));
            txn_start = li + 1;
        } else if wl.starts_with("OP ") || wl.starts_with("OPX ") {
            txn_h = fnv_extend(txn_h, wl + "\n");
        } else if wl.starts_with("COMMIT") {
            if txn_start >= 0 && wl == commit_line(txn_h) {
                vec_push(rec_id, txn_id);
                vec_push(rec_start, txn_start);
                vec_push(rec_end, li);
                if txn_id > max_id { max_id = txn_id; }
            }
            txn_start = 0 - 1;
        }
        li = li + 1;
    }
    // slot[t - base] = the first whole record of txid t, or -1.
    let mut slot: Vec<i32> = vec![];
    let mut t = base;
    while t <= max_id { vec_push(slot, 0 - 1); t = t + 1; }
    let mut r = 0;
    while r < vec_len(rec_id) {
        let id = vec_get(rec_id, r);
        if id > base && vec_get(slot, id - base) < 0 { slot[id - base] = r; }
        r = r + 1;
    }
    t = base + 1;
    while t <= n && t <= max_id {
        let ri = vec_get(slot, t - base);
        if ri >= 0 {
            let mut j = vec_get(rec_start, ri);
            let e = vec_get(rec_end, ri);
            while j < e {
                let sql = wal_op_sql(strip_cr(vec_get(lines, j)));
                if sql.len() > 0 { exec_sql_no_wal(&mut d2, sql); }
                j = j + 1;
            }
        }
        t = t + 1;
    }
    d2.txn_id = n;
    d2
}

// Start a history for this database (QDB_HISTORY=1 and no <db>.hist yet).
fn hist_init(d: &mut DB) ~ Console + FileSystem + Process {
    let base = d.hist_path + ".base";
    if d.tbl_count > 0 {
        durable_write(d, base, db_text(d), false, "hist_base");
        durable_sync(d, base, "hist_base_sync");
    } else if file_exists(base) {
        durable_write(d, base, "", false, "hist_base");
    }
    durable_write(d, d.hist_path, "BASE " + to_string_i32(d.txn_id) + "\n", false, "hist_init");
    durable_sync(d, d.hist_path, "hist_init_sync");
    d.hist_on = true;
}

// SHA-256 of the state: the .db text without its header line, so the same
// rows, schema and indexes hash the same whichever txid wrote them.
fn state_sha(d: &mut DB) -> String {
    if d.state_sha.len() == 0 {
        let all = db_text(d);
        let nl = all.index_of("\n");
        d.state_sha = sha256_hex(all.substring(nl + 1, all.len() - nl - 1));
    }
    d.state_sha
}

// RECEIPT <txid> <state> <query> <result>, after a SELECT's result lines.
fn print_receipt(d: &mut DB, txid: i32, query: String) ~ Console {
    if d.in_transaction {
        println!("RECEIPT - open transaction");
        return;
    }
    let st = state_sha(d);
    let res = sha256_hex(concat_parts(d.rcpt_parts));
    // One string, one write: a formatted print with several arguments costs
    // several writes on an unbuffered stdout.
    let line = "RECEIPT " + to_string_i32(txid) + " " + st + " " + sha256_hex(query) + " " + res;
    println!("{}", line);
}

fn exec_as_of(d: &mut DB, input: String, pos: i64) ~ Console + FileSystem + Process {
    let q = input.substring(0, pos).trim();
    let tail = input.substring(pos, input.len() - pos).trim();
    let sp = tail.len() - 1;
    let mut k = sp;
    while k > 0 && tail.char_at(k - 1) != " " { k = k - 1; }
    let n = parse_int_str(tail.substring(k, tail.len() - k));
    if !file_exists(d.hist_path) {
        println!("Error: AS OF needs a history; start qdb with QDB_HISTORY=1");
        return;
    }
    let base = hist_base(d);
    if n < base {
        println!("Error: AS OF {}: the history starts at txid {}", n, base);
        return;
    }
    if n > d.txn_id {
        println!("Error: AS OF {}: the latest txid is {}", n, d.txn_id);
        return;
    }
    let mut d2 = hist_state(d, n);
    d2.rcpt_on = d.rcpt_on;
    reset_parser(&mut d2, q);
    parse_sql(&mut d2);
    let st = d2.stmt_type;
    if st == 0 { exec_select(&mut d2); }
    else if st == 20 { exec_xselect(&mut d2); }
    else {
        println!("Error: AS OF applies to SELECT only");
        return;
    }
    if d2.rcpt_on { print_receipt(&mut d2, n, q); }
}

fn exec_sql(d: &mut DB, input: String) ~ Console + FileSystem + Process {
    let aspos = as_of_pos(input);
    if aspos >= 0 {
        exec_as_of(d, input, aspos);
        return;
    }
    // Handle transaction control keywords before parsing
    let trimmed_upper = input.to_uppercase();
    if trimmed_upper == "BEGIN" {
        wal_begin(d);
        return;
    }
    if trimmed_upper == "COMMIT" {
        wal_commit(d);
        return;
    }
    if trimmed_upper == "ROLLBACK" {
        d.state_sha = "";
        wal_rollback(d);
        return;
    }

    reset_parser(d, input);
    parse_sql(d);

    let st = d.stmt_type;

    // Fail-closed backstop for mutations: after a complete parse the token
    // cursor must sit at end of input. A live token means the mutation parser
    // stopped early and left the statement half-specified; executing anyway
    // could apply a partial write. SELECT is guarded inside parse_select, which
    // also re-enters per UNION branch, so it is exempt here. Tolerate one
    // trailing ';' -- main() and run_repl() strip one, a direct caller may leave
    // one -- then refuse any other leftover. This runs before the WAL write, so
    // a rejected statement mutates nothing.
    if st != 0 && st != 20 {
        if tk_is_punct(d, ";") == 1 { next_token(d); }
        if d.tk_type != 7 {
            println!("Error: unexpected trailing input near '{}'", d.tk_val);
            process_exit(1);
        }
    }

    // Read-only: SELECT — no WAL
    if st == 0 || st == 20 {
        let fresh: Vec<String> = vec![];
        d.rcpt_parts = fresh;
        if st == 0 { exec_select(d); } else { exec_xselect(d); }
        if d.rcpt_on { print_receipt(d, d.txn_id, input); }
        return;
    }

    // Mutations: execute in memory, then log to the WAL unless the statement
    // printed an error and changed nothing (P16).
    d.state_sha = "";
    d.stmt_failed = false;
    // INSERT and UPDATE keep the key map current themselves (P17, P20).
    if st != 1 && st != 3 { d.con_map_ok = false; }
    if st == 1 { exec_insert(d); }
    else if st == 2 { exec_create(d); }
    else if st == 3 { exec_update(d); }
    else if st == 4 { exec_delete(d); }
    else if st == 5 { exec_drop(d); }
    else if st == 6 { exec_create_index(d); }
    else if st == 10 { exec_alter_table(d); }
    else { return; }
    if !d.stmt_failed { wal_log_mutation(d, input); }
}

// =========================================================================
// SECTION 10: REPL — Interactive Shell and Dot-Commands
// =========================================================================
// The REPL reads one line at a time, strips newlines and semicolons, and
// either handles a dot-command (.tables, .schema, .wal, .quit) or passes
// the input to exec_sql() as a SQL statement.
// =========================================================================

fn cmd_tables(d: &DB) ~ Console {
    let mut i = 0;
    while i < d.tbl_count {
        let tn = sp_get(d, vec_get(d.tbl_names, i));
        println!("{}", tn);
        i = i + 1;
    }
}

fn cmd_schema(d: &DB, tname: String) ~ Console {
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let tn = sp_get(d, vec_get(d.tbl_names, tidx));
    let mut out = "CREATE TABLE " + tn + " (";
    let mut ci = 0;
    while ci < cc {
        if ci > 0 { out = out + ", "; }
        let cname = sp_get(d, vec_get(d.col_names, cs + ci));
        let ct = vec_get(d.col_types, cs + ci);
        let tstr = if ct == 0 { "INTEGER" } else if ct == 1 { "REAL" } else { "TEXT" };
        out = out + cname + " " + tstr;
        ci = ci + 1;
    }
    out = out + ");";
    println!("{}", out);
}

fn run_repl(d: &mut DB) ~ Console + FileSystem + Process {
    let mut go = true;
    while go {
        print!("qdb> ");
        let line = read_line();
        let llen = line.len();
        // Strip trailing \n and \r
        let mut clean = line;
        let clen = clean.len();
        if clen > 0 {
            let last = clean.char_at(clen - 1);
            if last == "\n" { clean = clean.substring(0, clen - 1); }
        }
        let clen2 = clean.len();
        if clen2 > 0 {
            let last2 = clean.char_at(clen2 - 1);
            if last2 == "\r" { clean = clean.substring(0, clen2 - 1); }
        }

        let trimmed = clean.trim();
        let tlen = trimmed.len();
        if tlen == 0 {
            // skip
        } else if trimmed == ".quit" || trimmed == ".exit" {
            go = false;
        } else if trimmed == ".tables" {
            cmd_tables(d);
        } else if trimmed == ".wal" {
            cmd_wal(d);
        } else if trimmed.starts_with(".schema") {
            if tlen > 8 {
                let tname = trimmed.substring(8, tlen - 8);
                cmd_schema(d, tname.trim());
            } else {
                // Show all tables
                let mut ti = 0;
                while ti < d.tbl_count {
                    let tn = sp_get(d, vec_get(d.tbl_names, ti));
                    cmd_schema(d, tn);
                    ti = ti + 1;
                }
            }
        } else {
            // Strip trailing semicolon
            let mut sql = trimmed;
            let sql_len = sql.len();
            if sql_len > 0 {
                let last_ch = sql.char_at(sql_len - 1);
                if last_ch == ";" {
                    sql = sql.substring(0, sql_len - 1);
                }
            }
            let sql_trimmed = sql.trim();
            if sql_trimmed.len() > 0 {
                exec_sql(d, sql_trimmed);
            }
        }
    }
}

// =========================================================================
// SECTION 10b: PREPARED STATEMENTS AND THE ROW API (bdb/lib, COMPLETE.md P25)
// =========================================================================
// A prepared statement is SQL text with `?` placeholders, planned once.
// Each step binds the parameters and runs one of three paths:
//
//   plan 1  point select: SELECT cols FROM t WHERE c = ? on an indexed c,
//           read straight from the index (the path exec_select takes for
//           the same statement, without the parse and the formatting)
//   plan 2  update: UPDATE ... SET ... WHERE c = ? (one equality); the
//           parse fields are set from the plan and exec_update runs as for
//           the same text, then the WAL gets the same text
//   plan 0  anything else: the parameters are written into the text as SQL
//           literals and exec_sql runs it with its rows captured
//
// Plans 1 and 2 need every parameter bound to an integer; with a text or
// NULL parameter, or with receipts on, the step takes plan 0. A schema
// change (d.schema_ver) re-plans the statement at its next step.

struct QStmt {
    sql: String,
    parts: Vec<String>,
    nparam: i32,
    bind: Vec<String>,
    bkind: Vec<i32>,
    // An integer parameter's value; its text in bind is made when needed.
    bint: Vec<i64>,
    plan: i32,
    ver: i32,
    tidx: i32,
    ix: i32,
    wparam: i32,
    show: Vec<i32>,
    names: Vec<String>,
    // plan 2 with u_fast: the UPDATE runs without exec_update's lookups
    // (see stmt_update_fast); u_ix is the index on the WHERE column.
    u_tidx: i32,
    u_scol: i32,
    u_ix: i32,
    u_fast: bool,
    // A literal operand read at plan time (u_op_lit), and the OP line of
    // the WAL in two pieces around the one parameter (u_wal_ok).
    u_op_lit: bool,
    u_op_ok: bool,
    u_op_int: i32,
    u_wal_ok: bool,
    u_wal_head: String,
    u_wal_tail: String,
    // Second reused buffer of the fast UPDATE (new cell ids).
    ids2: Vec<i32>,
    u_table: i32,
    u_alias: i32,
    u_set_col: i32,
    u_set_val: i32,
    u_set_op: i32,
    u_operand: i32,
    u_left: i32,
    u_right: i32,
    u_in_start: i32,
    u_in_len: i32,
    out_names: Vec<String>,
    cells: Vec<String>,
    // Row ids of the fast paths, reused from step to step.
    rowids: Vec<i32>,
    ncol: i32,
    nrows: i32,
    cur: i32,
    done: bool,
}

// Parameter k of a plan field: -1000 - k (pool ids are >= 0, -1 is "none").
fn stmt_pref(k: i32) -> i32 { 0 - 1000 - k }

// The text before, between and after the `?` placeholders outside quotes.
fn stmt_split(sql: String) -> Vec<String> {
    let mut parts: Vec<String> = vec![];
    let n = sql.len();
    let mut start: i64 = 0;
    let mut i: i64 = 0;
    let mut q = "";
    while i < n {
        let c = sql.char_at(i);
        if q.len() > 0 {
            if c == q { q = ""; }
        } else if c == "'" || c == "\"" {
            q = c;
        } else if c == "?" {
            vec_push(parts, sql.substring(start, i - start));
            start = i + 1;
        }
        i = i + 1;
    }
    vec_push(parts, sql.substring(start, n - start));
    parts
}

// A SQL literal for a text value: quoted, with each quote doubled.
fn sql_quote(s: String) -> String {
    if s.index_of("'") < 0 { return "'" + s + "'"; }
    let mut out = "'";
    let n = s.len();
    let mut i: i64 = 0;
    while i < n {
        let c = s.char_at(i);
        if c == "'" { out = out + "''"; } else { out = out + c; }
        i = i + 1;
    }
    out + "'"
}

fn i64_text(v: i64) -> String {
    if v == 0 { return "0"; }
    let digits = "0123456789";
    let mut out = "";
    let mut x = v;
    let neg = x < 0;
    while x != 0 {
        let r = x % 10;
        let dg = if r < 0 { 0 - r } else { r };
        out = digits.char_at(dg) + out;
        x = x / 10;
    }
    if neg { out = "-" + out; }
    out
}

// The SQL literal of parameter k. An integer's text is made on first use.
fn stmt_lit(st: &mut QStmt, k: i32) -> String {
    let t = vec_get(st.bind, k);
    if t.len() > 0 { return t; }
    let v = vec_get(st.bint, k);
    let mut lit = "";
    if v >= 0 - 2147483647 && v <= 2147483647 { lit = to_string_i32(v as i32); }
    else { lit = i64_text(v); }
    let b = st.bind;
    b[k] = lit;
    lit
}

// The text of a statement with literals for its parameters.
fn stmt_text(st: &mut QStmt) -> String {
    if st.nparam == 0 { return st.sql; }
    let mut out = vec_get(st.parts, 0);
    let mut k = 0;
    while k < st.nparam {
        out = out + stmt_lit(st, k);
        let tail = vec_get(st.parts, k + 1);
        if tail.len() > 0 { out = out + tail; }
        k = k + 1;
    }
    out
}

fn stmt_new(d: &mut DB, sql: String) -> QStmt ~ Console + Process {
    let parts = stmt_split(sql);
    let np = vec_len(parts) - 1;
    let mut bind: Vec<String> = vec![];
    let mut bkind: Vec<i32> = vec![];
    let mut bint: Vec<i64> = vec![];
    let mut k = 0;
    while k < np {
        vec_push(bind, "NULL");
        vec_push(bkind, 0);
        vec_push(bint, 0);
        k = k + 1;
    }
    let names0: Vec<String> = vec![];
    let onames0: Vec<String> = vec![];
    let cells0: Vec<String> = vec![];
    let mut st = QStmt {
        sql: sql, parts: parts, nparam: np as i32, bind: bind, bkind: bkind, bint: bint,
        plan: 0, ver: 0 - 1, tidx: 0 - 1, ix: 0 - 1, wparam: 0 - 1, show: vec![], names: names0,
        u_tidx: 0 - 1, u_scol: 0 - 1, u_ix: 0 - 1, u_fast: false,
        u_op_lit: false, u_op_ok: false, u_op_int: 0, u_wal_ok: false, u_wal_head: "", u_wal_tail: "",
        ids2: vec![],
        u_table: 0 - 1, u_alias: 0 - 1, u_set_col: 0 - 1, u_set_val: 0 - 1, u_set_op: 0 - 1,
        u_operand: 0 - 1, u_left: 0 - 1, u_right: 0 - 1, u_in_start: 0 - 1, u_in_len: 0,
        out_names: onames0, cells: cells0, rowids: vec![], ncol: 0, nrows: 0, cur: 0, done: false,
    };
    stmt_plan(d, &mut st);
    st
}

// A field of the parse made from the sentinel text: a parameter reference
// when it names one of the sentinel literals, else the field unchanged.
fn stmt_field(d: &DB, v: i32, p0: i32, base: i32, np: i32) -> i32 {
    if v < p0 { return v; }
    let t = sp_get(d, v);
    let mut k = 0;
    while k < np {
        if t == to_string_i32(base + k) { return stmt_pref(k); }
        k = k + 1;
    }
    v
}

// Choose plan 1, 2 or 0 for the statement at the current schema.
fn stmt_plan(d: &mut DB, st: &mut QStmt) ~ Console + Process {
    st.plan = 0;
    st.ver = d.schema_ver;
    // A statement without parameters runs as text.
    if st.nparam == 0 { return; }
    let up = st.sql.to_uppercase();
    let is_sel = up.starts_with("SELECT ");
    let is_upd = up.starts_with("UPDATE ");
    if !is_sel && !is_upd { return; }
    if st.sql.index_of("(") >= 0 { return; }
    // Sentinel literals stand in for the parameters during this parse.
    let base = 734001;
    let mut text = vec_get(st.parts, 0);
    let mut k = 0;
    while k < st.nparam {
        let sv = to_string_i32(base + k);
        if st.sql.index_of(sv) >= 0 { return; }
        text = text + sv + vec_get(st.parts, k + 1);
        k = k + 1;
    }
    if as_of_pos(text) >= 0 { return; }
    let p0 = d.pn;
    reset_parser(d, text);
    parse_sql(d);
    if d.tk_type != 7 { return; }
    if d.has_where != 1 || d.wc_count != 1 || d.wn_count != 1 { return; }
    if vec_get(d.wc_neg, 0) != 0 || vec_get(d.wc_op, 0) != 0 { return; }
    let np = st.nparam;
    let left = stmt_field(d, vec_get(d.wc_left, 0), p0, base, np);
    let right = stmt_field(d, vec_get(d.wc_right, 0), p0, base, np);
    if left < 0 { return; }
    if d.stmt_type == 3 && is_upd {
        if vec_len(d.wc_in_pool) > 0 { return; }
        st.u_table = d.p_table;
        st.u_alias = d.alias1;
        st.u_set_col = d.set_col;
        st.u_set_val = stmt_field(d, d.set_val, p0, base, np);
        st.u_set_op = d.set_op;
        st.u_operand = stmt_field(d, d.set_operand, p0, base, np);
        st.u_left = left;
        st.u_right = right;
        st.u_in_start = if vec_len(d.wc_in_start) > 0 { vec_get(d.wc_in_start, 0) } else { 0 - 1 };
        st.u_in_len = if vec_len(d.wc_in_len) > 0 { vec_get(d.wc_in_len, 0) } else { 0 };
        st.plan = 2;
        stmt_plan_fast_update(d, st);
        return;
    }
    if d.stmt_type != 0 || !is_sel || right > 0 - 1000 { return; }
    if d.has_join != 0 || d.has_group_by != 0 || d.has_order != 0 || d.has_limit != 0 { return; }
    if d.has_offset != 0 || d.has_distinct != 0 || d.has_having != 0 { return; }
    if d.p_agg_count > 0 && d.p_col_count == 0 { return; }
    let mut ai = 0;
    while ai < d.p_agg_count {
        if vec_get(d.p_agg_funcs, ai) != 0 { return; }
        ai = ai + 1;
    }
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 { return; }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let wcol = resolve_col(d, cs, cc, tname, d.alias1, sp_get(d, left));
    if wcol < 0 { return; }
    let ix = find_index_for(d, tidx, wcol);
    if ix < 0 { return; }
    let mut show: Vec<i32> = vec![];
    let mut names: Vec<String> = vec![];
    if d.select_star == 1 {
        let mut ci = 0;
        while ci < cc {
            vec_push(show, ci);
            vec_push(names, sp_get(d, vec_get(d.col_names, cs + ci)));
            ci = ci + 1;
        }
    } else {
        let mut ci = 0;
        while ci < d.p_col_count {
            let idx = resolve_col(d, cs, cc, tname, d.alias1, sp_get(d, vec_get(d.p_cols, ci)));
            if idx < 0 { return; }
            vec_push(show, idx);
            let mut nm = sp_get(d, vec_get(d.col_names, cs + idx));
            if ci < d.p_agg_count {
                let al = vec_get(d.p_aliases, ci);
                if al >= 0 { nm = sp_get(d, al); }
            }
            vec_push(names, nm);
            ci = ci + 1;
        }
    }
    st.tidx = tidx;
    st.ix = ix;
    st.wparam = 0 - 1000 - right;
    st.show = show;
    st.names = names;
    st.plan = 1;
}

// A plan field as a pool id for this step: a parameter becomes a new pool
// entry holding its value, as the parser makes one for each literal.
fn stmt_val(d: &mut DB, st: &mut QStmt, v: i32) -> i32 {
    if v > 0 - 1000 { return v; }
    let k = 0 - 1000 - v;
    let lit = stmt_lit(st, k);
    sp_add(d, lit)
}

fn stmt_all_int(st: &QStmt) -> bool {
    let mut k = 0;
    while k < st.nparam {
        if vec_get(st.bkind, k) != 1 { return false; }
        k = k + 1;
    }
    true
}

fn stmt_point_select(d: &mut DB, st: &mut QStmt) {
    let t = st.tidx;
    let cc = vec_get(d.tbl_col_counts, t);
    refresh_index(d, st.ix);
    let rs = vec_get(d.tbl_row_starts, t);
    let cs = vec_get(d.tbl_col_starts, t);
    let wcol = vec_get(d.idx_col_indices, st.ix);
    let ct = vec_get(d.col_types, cs + wcol);
    let ns = vec_len(st.show) as i32;
    let cells = st.cells;
    let mut k = 0;
    let mut n = 0;
    if ct == 0 || ct == 1 {
        n = index_eq_num_into(d, st.ix, vec_get(st.bint, st.wparam) as f64, st.rowids);
        let mut i = 0;
        while i < n {
            let base = rs + vec_get(st.rowids, i) * cc;
            let mut j = 0;
            while j < ns {
                vset_str(cells, k, sp_get(d, vec_get(d.cells, base + vec_get(st.show, j))));
                k = k + 1;
                j = j + 1;
            }
            i = i + 1;
        }
    } else {
        let rows = index_scan(d, st.ix, 0, stmt_lit(st, st.wparam));
        n = vec_len(rows) as i32;
        let mut i = 0;
        while i < n {
            let base = rs + vec_get(rows, i) * cc;
            let mut j = 0;
            while j < ns {
                vset_str(cells, k, sp_get(d, vec_get(d.cells, base + vec_get(st.show, j))));
                k = k + 1;
                j = j + 1;
            }
            i = i + 1;
        }
    }
    st.out_names = st.names;
    st.ncol = ns;
    st.nrows = n;
}

fn stmt_update(d: &mut DB, st: &mut QStmt) ~ Console + FileSystem + Process {
    let text = stmt_text(st);
    reset_parser(d, text);
    d.stmt_type = 3;
    d.p_table = st.u_table;
    d.alias1 = st.u_alias;
    d.set_col = st.u_set_col;
    d.set_val = stmt_val(d, st, st.u_set_val);
    d.set_op = st.u_set_op;
    d.set_operand = stmt_val(d, st, st.u_operand);
    d.has_where = 1;
    d.wc_count = 1;
    vec_push(d.wc_left, stmt_val(d, st, st.u_left));
    vec_push(d.wc_op, 0);
    vec_push(d.wc_right, stmt_val(d, st, st.u_right));
    vec_push(d.wc_neg, 0);
    vec_push(d.wc_in_start, st.u_in_start);
    vec_push(d.wc_in_len, st.u_in_len);
    vec_push(d.wn_kind, 0);
    vec_push(d.wn_a, 0);
    vec_push(d.wn_b, 0 - 1);
    d.wn_count = 1;
    d.wc_root = 0;
    // As exec_sql runs a mutation.
    d.state_sha = "";
    d.stmt_failed = false;
    exec_update(d);
    if !d.stmt_failed { wal_log_mutation(d, text); }
    st.ncol = 0;
    st.nrows = 0;
}

// Plan 0: the text with literals, through exec_sql, rows captured.
fn stmt_text_run(d: &mut DB, st: &mut QStmt) ~ Console + FileSystem + Process {
    let text = stmt_text(st);
    let rn: Vec<String> = vec![];
    let rc: Vec<String> = vec![];
    d.rows_on = true;
    d.row_names = rn;
    d.row_cells = rc;
    exec_sql(d, text);
    d.rows_on = false;
    st.out_names = d.row_names;
    st.cells = d.row_cells;
    let nc = vec_len(d.row_names);
    st.ncol = nc as i32;
    st.nrows = if nc > 0 { (vec_len(d.row_cells) / nc) as i32 } else { 0 };
}

// Plan 2 runs without exec_update's lookups when: the table, the SET column
// and the WHERE column exist; the WHERE column has an index and a numeric type
// (INTEGER or REAL), its right side is a parameter; no index is on the SET
// column; and the SET is a parameter or literal, or the SET column itself
// with + - * and a parameter or literal.
fn stmt_plan_fast_update(d: &mut DB, st: &mut QStmt) {
    st.u_fast = false;
    if st.u_right > 0 - 1000 || st.u_alias >= 0 { return; }
    let tname = sp_get(d, st.u_table);
    let t = find_table(d, tname);
    if t < 0 { return; }
    let cs = vec_get(d.tbl_col_starts, t);
    let cc = vec_get(d.tbl_col_counts, t);
    let scol = find_col(d, cs, cc, sp_get(d, st.u_set_col));
    if scol < 0 { return; }
    let wcol = resolve_col(d, cs, cc, tname, st.u_alias, sp_get(d, st.u_left));
    if wcol < 0 { return; }
    let ct = vec_get(d.col_types, cs + wcol);
    if ct != 0 && ct != 1 { return; }
    let ix = find_index_for(d, t, wcol);
    if ix < 0 { return; }
    if find_index_for(d, t, scol) >= 0 { return; }
    if st.u_set_op > 2 { return; }
    if st.u_set_op >= 0 {
        if st.u_set_val < 0 { return; }
        if sp_get(d, st.u_set_val) != sp_get(d, st.u_set_col) { return; }
    }
    st.u_op_lit = st.u_set_op >= 0 && st.u_operand > 0 - 1000;
    if st.u_op_lit {
        st.u_op_ok = st.u_operand >= 0 && is_int_str(sp_get(d, st.u_operand));
        if st.u_op_ok { st.u_op_int = parse_int_str(sp_get(d, st.u_operand)); }
    }
    // With one parameter and no character the WAL escapes, the OP line is
    // "OP " + text + line feed, built from two fixed pieces and the number.
    st.u_wal_ok = st.nparam == 1 && !needs_escape(st.sql, false);
    if st.u_wal_ok {
        st.u_wal_head = "OP " + vec_get(st.parts, 0);
        st.u_wal_tail = vec_get(st.parts, 1) + "\n";
    }
    st.u_tidx = t;
    st.u_scol = scol;
    st.u_ix = ix;
    st.u_fast = true;
}

// The operand of a fast UPDATE as an integer, or false when it is not one
// that exec_update would take (then the step runs exec_update instead).
fn stmt_operand_ok(d: &mut DB, st: &mut QStmt) -> bool {
    if st.u_set_op < 0 { return true; }
    if st.u_op_lit { return st.u_op_ok; }
    let v = st.u_operand;
    if v <= 0 - 1000 {
        let x = vec_get(st.bint, 0 - 1000 - v);
        return x >= 0 - 2147483647 && x <= 2147483647;
    }
    if v < 0 { return false; }
    is_int_str(sp_get(d, v))
}

fn stmt_operand_int(d: &mut DB, st: &mut QStmt) -> i32 {
    if st.u_op_lit { return st.u_op_int; }
    let v = st.u_operand;
    if v <= 0 - 1000 { return vec_get(st.bint, 0 - 1000 - v) as i32; }
    parse_int_str(sp_get(d, v))
}

// A prepared UPDATE with u_fast: the rows exec_update would change, from the
// numeric index search plus the check eval_where makes on each candidate
// (an equal number, written as a number); the new values as exec_update
// computes them; then update_apply and the WAL line, as exec_sql does.
// Returns false, having changed nothing, when exec_update must run instead.
fn stmt_update_fast(d: &mut DB, st: &mut QStmt) -> bool ~ Console + FileSystem + Process {
    if !stmt_operand_ok(d, st) { return false; }
    let t = st.u_tidx;
    let cs = vec_get(d.tbl_col_starts, t);
    let cc = vec_get(d.tbl_col_counts, t);
    let scol = st.u_scol;
    refresh_index(d, st.u_ix);
    let rs = vec_get(d.tbl_row_starts, t);
    let wcol = vec_get(d.idx_col_indices, st.u_ix);
    let rows = st.rowids;
    let new_ids = st.ids2;
    let nc = index_eq_num_into(d, st.u_ix, vec_get(st.bint, 0 - 1000 - st.u_right) as f64, rows);
    // Keep the candidates eval_where accepts, in place.
    let mut n = 0;
    let mut i = 0;
    while i < nc {
        let r = vec_get(rows, i);
        let kd = sp_kind(d, vec_get(d.cells, rs + r * cc + wcol));
        if kd == 1 || kd == 4 {
            rows[n] = r;
            n = n + 1;
        }
        i = i + 1;
    }
    if n > 0 {
        if st.u_set_op < 0 {
            let nv = sp_add(d, sp_get(d, stmt_val(d, st, st.u_set_val)));
            i = 0;
            while i < n { vset_i32(new_ids, i, nv); i = i + 1; }
        } else {
            let opnd = stmt_operand_int(d, st);
            i = 0;
            while i < n {
                let cid = vec_get(d.cells, rs + vec_get(rows, i) * cc + scol);
                if sp_kind(d, cid) != 1 { return false; }
                let af = vec_get(d.pool_num, cid);
                if af < 0.0 - 2147483647.0 || af > 2147483647.0 { return false; }
                let a = af as i32;
                let mut r = 0;
                if st.u_set_op == 0 { r = a + opnd; }
                else if st.u_set_op == 1 { r = a - opnd; }
                else { r = a * opnd; }
                vset_i32(new_ids, i, sp_add(d, to_string_i32(r)));
                i = i + 1;
            }
        }
    }
    d.state_sha = "";
    d.stmt_failed = false;
    if n > 0 { update_apply(d, t, cs, cc, rs, scol, rows, new_ids, n); }
    if !d.stmt_failed {
        if st.u_wal_ok && d.in_transaction {
            wal_hold_op(d, st.u_wal_head + stmt_lit(st, 0) + st.u_wal_tail);
        } else {
            wal_log_mutation(d, stmt_text(st));
        }
    }
    st.ncol = 0;
    st.nrows = 0;
    true
}

// 100 when a row is ready (SQLite's SQLITE_ROW), 101 when there are no more.
fn stmt_step(d: &mut DB, st: &mut QStmt) -> i32 ~ Console + FileSystem + Process {
    if !st.done {
        st.done = true;
        st.cur = 0;
        if st.ver != d.schema_ver { stmt_plan(d, st); }
        if st.plan == 1 && !d.rcpt_on && vec_get(st.bkind, st.wparam) == 1 {
            stmt_point_select(d, st);
        } else if st.plan == 2 && stmt_all_int(st) {
            let mut ran = false;
            if st.u_fast { ran = stmt_update_fast(d, st); }
            if !ran { stmt_update(d, st); }
        } else {
            stmt_text_run(d, st);
        }
    }
    if st.cur < st.nrows {
        st.cur = st.cur + 1;
        return 100;
    }
    101
}

fn stmt_bind_int(st: &mut QStmt, i: i32, v: i64) -> i32 {
    if i < 1 || i > st.nparam { return 1; }
    let b = st.bind;
    b[i - 1] = "";
    let bk = st.bkind;
    bk[i - 1] = 1;
    let bi = st.bint;
    bi[i - 1] = v;
    0
}

fn stmt_bind(st: &mut QStmt, i: i32, lit: String, kind: i32) -> i32 {
    if i < 1 || i > st.nparam { return 1; }
    let b = st.bind;
    b[i - 1] = lit;
    let bk = st.bkind;
    bk[i - 1] = kind;
    0
}

// Cell i of the current row, or "" before the first step or past the end.
fn stmt_cell(st: &QStmt, i: i32) -> String {
    if st.cur < 1 || st.cur > st.nrows || i < 0 || i >= st.ncol { return ""; }
    vec_get(st.cells, (st.cur - 1) * st.ncol + i)
}

fn text_i64(s: String) -> i64 {
    let b = s.as_bytes();
    let n = s.len();
    let mut i: i64 = 0;
    let mut neg = false;
    if n > 0 && b[0] == 45 { neg = true; i = 1; }
    let mut v: i64 = 0;
    while i < n && b[i] >= 48 && b[i] <= 57 {
        v = v * 10 + ((b[i] - 48) as i64);
        i = i + 1;
    }
    if neg { 0 - v } else { v }
}


// =========================================================================
// SECTION 11: MAIN — Entry Point
// =========================================================================
// Usage: qdb <database> [sql]
//   With sql argument: execute single statement and exit
//   Without sql argument: enter interactive REPL
//
// Startup sequence:
//   1. Parse args, handle --help
//   2. db_new() — create empty DB struct
//   3. db_load() — load from .db file
//   4. wal_replay() — recover committed WAL transactions
//   5. Execute SQL or enter REPL
// =========================================================================

fn main() ~ Console + Environment + FileSystem + Process {
    let nargs = args_count();
    if nargs < 2 {
        println!("Usage: qdb <database> [sql]");
        println!("       qdb <database>          — interactive REPL mode");
        process_exit(0);
    }

    let arg1 = args_get(1);
    if arg1 == "--help" || arg1 == "-h" {
        println!("Usage: qdb <database> [sql]");
        println!("       qdb mydb.db                    — interactive REPL");
        println!("       qdb mydb.db \"SELECT * FROM t\"  — execute SQL");
        println!("");
        println!("SQL support:");
        println!("  CREATE TABLE, INSERT, SELECT, UPDATE, DELETE, DROP TABLE");
        println!("  ALTER TABLE ADD COLUMN");
        println!("  WHERE (AND/OR, LIKE, IN, IS NULL, BETWEEN, subqueries)");
        println!("  JOIN, GROUP BY, HAVING, DISTINCT, ORDER BY, LIMIT");
        println!("  CREATE INDEX, BEGIN/COMMIT/ROLLBACK, WAL recovery");
        println!("");
        println!("REPL commands:");
        println!("  .tables    — list all tables");
        println!("  .schema    — show table schemas");
        println!("  .wal       — show WAL status");
        println!("  .quit      — exit REPL");
        process_exit(0);
    }

    let db_path = arg1;
    let mut d = db_new(db_path);
    let crash_at = getenv("QDB_CRASH_AT");
    if crash_at.len() > 0 { d.crash_at = parse_int_str(crash_at); }
    d.crash_torn = getenv("QDB_CRASH_MODE") == "torn";
    d.sync_on = getenv("QDB_SYNC") != "off";
    d.trace_writes = getenv("QDB_TRACE_WRITES") == "1";
    d.hist_on = file_exists(d.hist_path);
    d.rcpt_on = getenv("QDB_RECEIPTS") == "1";
    db_load(&mut d);
    // Replay any committed transactions from WAL (crash recovery)
    wal_replay(&mut d);
    if !d.hist_on && getenv("QDB_HISTORY") == "1" { hist_init(&mut d); }

    if nargs >= 3 {
        // Single command mode
        let sql = args_get(2);
        // Strip trailing semicolon
        let slen = sql.len();
        let mut clean_sql = sql;
        if slen > 0 {
            let last = sql.char_at(slen - 1);
            if last == ";" {
                clean_sql = sql.substring(0, slen - 1);
            }
        }
        let trimmed = clean_sql.trim();
        if trimmed.len() > 0 {
            exec_sql(&mut d, trimmed);
        }
    } else {
        // REPL mode
        run_repl(&mut d);
    }
    // Clean exit: fold the WAL into the .db (skipped inside an open BEGIN).
    wal_close(&mut d);
}
