// =============================================================================
// qdb — SQL Database Engine written in BuildLang
// =============================================================================
//
// Architecture (sections in order of appearance):
//
//   SECTION 0: PRIMITIVES     (lines ~55-65)    — Character classification helpers
//   SECTION 1: DATA MODEL     (lines ~69-276)   — struct DB, constructor, string pool
//   SECTION 2: STORAGE        (lines ~278-523)  — File persistence (save/load)
//   SECTION 3: WAL            (lines ~525-850)   — Write-ahead log, snapshots, transactions
//   SECTION 4: TOKENIZER      (lines ~854-1027) — SQL lexical analysis
//   SECTION 5: PARSER         (lines ~1067-1920)— SQL statement parsing
//   SECTION 6: EXECUTOR       (lines ~1948-3384)— Query execution engine
//     6a: DDL execution (CREATE TABLE, DROP, ALTER)
//     6b: DML execution (INSERT, UPDATE, DELETE)
//     6c: SELECT — basic single-table queries
//     6d: SELECT — aggregate functions (no GROUP BY)
//     6e: SELECT — GROUP BY with aggregates + HAVING
//     6f: SELECT — JOIN (nested loop)
//     6g: Subquery execution
//   SECTION 7: HELPERS        (lines ~3386-3781)— WHERE eval, LIKE, sorting, formatting
//   SECTION 8: INDEX          (lines ~3783-4038)— Sorted-array indexes, binary search
//   SECTION 9: DISPATCH       (lines ~4040-4092)— SQL routing (exec_sql, exec_sql_no_wal)
//   SECTION 10: REPL          (lines ~4094-4192)— Interactive shell, dot-commands
//   SECTION 11: MAIN          (lines ~4194-end) — Entry point, argument handling
//
// Design Decisions:
//
//   - Single file: BuildLang does not support multi-file compilation or
//     `use` imports between .bld files. All code must live in one file.
//     Sections are separated by banner comments to maintain logical modularity.
//
//   - Single flat struct (DB): BuildLang's C codegen does not reliably emit
//     struct field assignments on local variables. All state passes through
//     &mut DB references to a single top-level struct.
//
//   - String pool: every string is interned once in `pool`, a Vec<String>,
//     and referred to by its integer id. sp_add and sp_get are O(1). A
//     Vec<String> must be created from a typed local (`let v: Vec<String> =
//     vec![];`); a bare vec![] in a struct literal is built as Vec<i32>.
//
//   - Text-based file format: Each line is a DDL statement or pipe-delimited
//     data row. Simple and human-readable. Not page-based like SQLite.
//
//   - Sorted-array indexes with binary search: Simpler than B-trees. Each
//     index maintains sorted key+rowid pairs. Equality uses binary search;
//     range queries scan the sorted array. Indexes are brought up to date
//     lazily, on the next index read: rows appended by INSERT are sorted and
//     merged in, and any other mutation triggers one full merge-sort rebuild.
//
//   - Selection sort for ORDER BY: O(n^2) but simple and correct. Index
//     builds use a stable merge sort (sort_positions), O(n log n).
//
//   - WAL for crash recovery: Append-only log of mutations, written with
//     append_file. On startup, committed transactions are replayed. The .db
//     is rewritten at a checkpoint, which runs when the WAL outgrows the .db
//     and at a clean exit. ROLLBACK restores from snapshot. See SECTION 3.
//
// SQL Support:
//   CREATE TABLE, INSERT, SELECT, UPDATE, DELETE, DROP TABLE
//   ALTER TABLE ADD COLUMN
//   WHERE (AND/OR, LIKE, IN, IS NULL, IS NOT NULL, BETWEEN, subqueries)
//   JOIN (nested-loop with aliases), GROUP BY, HAVING, DISTINCT
//   ORDER BY (ASC/DESC), LIMIT, column aliases (AS)
//   Aggregates: COUNT(*), SUM, AVG, MIN, MAX
//   CREATE INDEX, BEGIN/COMMIT/ROLLBACK
//
// Usage:
//   qdb test.db "CREATE TABLE users (id INTEGER, name TEXT, age INTEGER)"
//   qdb test.db "SELECT * FROM users WHERE age > 24 AND name = 'Zain'"
//   qdb test.db "SELECT u.name, o.total FROM users u JOIN orders o ON u.id = o.user_id"
//   qdb test.db "SELECT dept, AVG(salary) FROM employees GROUP BY dept"
//   qdb test.db "CREATE INDEX idx_age ON users (age)"
//   qdb test.db                         — interactive REPL mode
//
// Storage format:
//   TABLE users
//   SCHEMA id:INTEGER name:TEXT age:INTEGER
//   ROW 1|Zain|25
//   ROW 2|Harper|30
//   END
//   INDEX idx_age ON users (age)
// =============================================================================

// =========================================================================
// SECTION 0: PRIMITIVES — Character Classification
// =========================================================================
// Pure functions for character-class tests. Used by both the SQL tokenizer
// and the file-format parser. BuildLang has no char type; single-char
// strings are compared by value.
// =========================================================================
fn is_ws(c: String) -> bool { c == " " || c == "\n" || c == "\r" || c == "\t" }
fn is_digit(c: String) -> bool { c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" }
fn is_lower(c: String) -> bool { c == "a" || c == "b" || c == "c" || c == "d" || c == "e" || c == "f" || c == "g" || c == "h" || c == "i" || c == "j" || c == "k" || c == "l" || c == "m" || c == "n" || c == "o" || c == "p" || c == "q" || c == "r" || c == "s" || c == "t" || c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z" }
fn is_upper(c: String) -> bool { c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" || c == "G" || c == "H" || c == "I" || c == "J" || c == "K" || c == "L" || c == "M" || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R" || c == "S" || c == "T" || c == "U" || c == "V" || c == "W" || c == "X" || c == "Y" || c == "Z" }
fn is_alpha(c: String) -> bool { is_lower(c) || is_upper(c) }
fn is_alnum(c: String) -> bool { is_alpha(c) || is_digit(c) || c == "_" }

// Token type codes (used by the tokenizer in Section 4):
//   0=Keyword, 1=Ident, 2=String literal, 3=Number literal
//   4=Operator, 5=Punctuation, 6=Star, 7=EOF

// =========================================================================
// SECTION 1: DATA MODEL — struct DB, Constructor, String Pool
// =========================================================================
// ALL engine state lives in one flat struct. This is not a design preference
// but a constraint: BuildLang's C codegen cannot reliably emit struct field
// assignments on local variables, so we pass &mut DB everywhere.
//
// The struct is organized into logical groups:
//   - File path and string pool (the interning mechanism)
//   - Table metadata (names, column schema, row data)
//   - Index metadata (sorted-array indexes)
//   - SQL parser state (tokenizer position, parsed AST fields)
//   - WAL/transaction state (log path, snapshot for rollback)
// =========================================================================
struct DB {
    // Database file path
    db_path: String,

    // String pool: one entry per interned string, id = position.
    pool: Vec<String>,
    pn: i32,

    // Tables: parallel arrays indexed by table index
    tbl_names: Vec<i32>,
    tbl_count: i32,

    // Per-table column schema (flattened)
    col_names: Vec<i32>,
    col_types: Vec<i32>,
    tbl_col_starts: Vec<i32>,
    tbl_col_counts: Vec<i32>,

    // Per-table row data: cells stored as pool indices
    cells: Vec<i32>,
    tbl_row_starts: Vec<i32>,
    tbl_row_counts: Vec<i32>,

    // Indexes: parallel arrays indexed by index number
    // Each index stores: name, table index, column index, sorted key+rowid pairs
    idx_names: Vec<i32>,
    idx_tables: Vec<i32>,
    idx_col_indices: Vec<i32>,
    idx_count: i32,
    // Flattened sorted pairs: for index i, keys start at idx_key_starts[i]
    // and run for idx_key_counts[i] entries.
    // idx_keys[start+j] = pool id of key value, idx_rowids[start+j] = row index
    idx_keys: Vec<i32>,
    idx_rowids: Vec<i32>,
    idx_key_starts: Vec<i32>,
    idx_key_counts: Vec<i32>,

    // SQL parser state
    input: String,
    ilen: i32,
    pos: i32,
    tk_type: i32,
    tk_val: String,

    // Parsed statement
    stmt_type: i32,
    p_table: i32,
    p_cols: Vec<i32>,
    p_col_count: i32,
    p_types: Vec<i32>,
    p_vals: Vec<i32>,
    p_val_count: i32,
    p_row_count: i32,
    has_where: i32,
    // WHERE leaf conditions. Each entry is one comparison / LIKE / IN /
    // IS [NOT] NULL predicate; the boolean structure over them lives in the
    // wn_* node tree below, so these arrays carry no grouping of their own.
    wc_count: i32,
    wc_left: Vec<i32>,     // left column-ref string id, per condition
    wc_op: Vec<i32>,       // op code 0..9, per condition
    wc_right: Vec<i32>,    // right value string id (-1 for IN / IS [NOT] NULL)
    wc_neg: Vec<i32>,      // 1 = negate this condition (NOT IN / NOT LIKE)
    // WHERE as a boolean-expression tree over the leaf conditions above.
    // Node i has kind wn_kind[i] (0=leaf, 1=AND, 2=OR, 3=NOT). A leaf's wn_a
    // is its condition index into the wc_* arrays (wn_b unused). AND/OR read
    // both children (wn_a, wn_b); NOT reads its one child (wn_a). Nodes are
    // emitted post-order, so a parent's child indices already exist. wc_root
    // is the root node index, or -1 when there is no WHERE. This expresses
    // arbitrary parenthesized grouping, NOT of a group, and NOT BETWEEN with
    // full SQL precedence (OR binds loosest, then AND, then NOT).
    wn_kind: Vec<i32>,
    wn_a: Vec<i32>,
    wn_b: Vec<i32>,
    wn_count: i32,
    wc_root: i32,
    has_order: i32,
    order_col: i32,
    order_desc: i32,
    // Optional secondary ORDER BY key (a comma-separated second column).
    // order_col2 = -1 when the query gives only one key.
    order_col2: i32,
    order_desc2: i32,
    // Aggregate order key: 0 = order_col names a plain column (the common
    // case); 1..5 = COUNT/SUM/AVG/MIN/MAX, with order_col holding the arg
    // name ("*" for COUNT(*)). Lets ORDER BY match an aggregate output column.
    order_agg_func: i32,
    has_limit: i32,
    limit_val: i32,
    has_offset: i32,
    offset_val: i32,
    set_col: i32,
    set_val: i32,        // RHS: literal text, or left operand of an arithmetic RHS
    set_op: i32,         // UPDATE arithmetic op: 0=+ 1=- 2=* 3=/ ; -1 = plain literal
    set_operand: i32,    // right operand string id for arithmetic RHS (-1 if none)
    select_star: i32,
    // Aggregate functions for GROUP BY: 0=none, 1=COUNT, 2=SUM, 3=AVG, 4=MIN, 5=MAX
    p_agg_funcs: Vec<i32>,
    p_agg_cols: Vec<i32>,
    p_agg_count: i32,
    has_group_by: i32,
    group_col: i32,
    // JOIN state
    has_join: i32,
    // 0 = INNER (default), 1 = LEFT [OUTER]
    join_type: i32,
    join_table: i32,
    join_left_col: i32,
    join_right_col: i32,
    // Table aliases: alias pool ids for table1 and table2
    alias1: i32,
    alias2: i32,
    // CREATE INDEX state
    idx_name: i32,
    idx_table_name: i32,
    idx_col_name: i32,

    // IN operator: value lists for WHERE col IN (...). All conditions' IN
    // values are concatenated into one flat pool; each IN condition records
    // its slice via wc_in_start / wc_in_len (buildlang has no Vec<Vec<i32>>).
    wc_in_start: Vec<i32>,
    wc_in_len: Vec<i32>,
    wc_in_pool: Vec<i32>,

    // Scratch: the first result column of the most recent subquery, collected
    // across all matching rows. Turns IN (SELECT ...) into a real IN-list.
    subq_vals: Vec<i32>,
    subq_count: i32,

    // DISTINCT flag
    has_distinct: i32,

    // HAVING clause: agg func code, op code, comparison value
    has_having: i32,
    having_agg_func: i32,
    having_agg_col: i32,
    having_op: i32,
    having_val: i32,

    // Column aliases: parallel to p_agg_cols, -1 means no alias
    p_aliases: Vec<i32>,

    // DISTINCT flag per projection item, parallel to p_agg_funcs/p_agg_cols:
    // 1 = COUNT(DISTINCT col), 0 = plain aggregate or column.
    p_agg_distinct: Vec<i32>,

    // ALTER TABLE state
    alter_col_name: i32,
    alter_col_type: i32,

    // WAL state
    wal_path: String,
    in_transaction: bool,
    txn_id: i32,
    wal_buf: String,
    // Bytes appended to the WAL since the last checkpoint, and the size of
    // the .db file that checkpoint wrote. maybe_checkpoint compares the two.
    wal_bytes: i64,
    db_bytes: i64,
    // Fault injection for the crash tests (bdb/tests/test_qdb_crash.py),
    // read once from the environment in main. QDB_CRASH_AT=k stops the
    // process at its k-th durable write with exit code 77; with
    // QDB_CRASH_MODE=torn the first half of that write lands first,
    // otherwise none of it does. QDB_TRACE_WRITES=1 prints one line per
    // durable write to stderr. Unset, every write goes straight through.
    crash_at: i32,
    crash_torn: bool,
    trace_writes: bool,
    write_seq: i32,
    // Set by any mutation that moves or rewrites existing rows (UPDATE,
    // DELETE, DROP, ALTER, ROLLBACK). The next index read then rebuilds
    // every index from scratch. INSERT leaves it alone: appended rows are
    // folded into each index incrementally by refresh_index.
    idx_stale: bool,
    // Snapshot for rollback (saved at BEGIN)
    snap_cells: Vec<i32>,
    snap_row_starts: Vec<i32>,
    snap_row_counts: Vec<i32>,
    snap_tbl_names: Vec<i32>,
    snap_tbl_count: i32,
    snap_col_names: Vec<i32>,
    snap_col_types: Vec<i32>,
    snap_col_starts: Vec<i32>,
    snap_col_counts: Vec<i32>,
    snap_idx_names: Vec<i32>,
    snap_idx_tables: Vec<i32>,
    snap_idx_col_indices: Vec<i32>,
    snap_idx_count: i32,
    snap_idx_keys: Vec<i32>,
    snap_idx_rowids: Vec<i32>,
    snap_idx_key_starts: Vec<i32>,
    snap_idx_key_counts: Vec<i32>,

    // UNION accumulator: rows materialized across all branches of a UNION.
    // union_vals is row-major, union_ncol wide, each cell a string-pool id
    // (the same ids the source table cells already hold). Headers and per-
    // output-column types come from the first branch. union_started guards
    // one-time first-branch setup.
    union_vals: Vec<i32>,
    union_headers: Vec<i32>,
    union_coltypes: Vec<i32>,
    union_ncol: i32,
    union_rows: i32,
    union_started: i32,
}

// Initialize a new empty DB. All parallel arrays start empty; pn (pool next
// id) starts at 0. The WAL path is derived by appending ".wal" to the db path.
fn db_new(db_path: String) -> DB {
    let wp = db_path + ".wal";
    // Typed local: a bare vec![] in the struct literal is built as a Vec<i32>
    // by the C backend, and pushing strings into that corrupts memory.
    let pool0: Vec<String> = vec![];
    DB {
        db_path: db_path,
        pool: pool0, pn: 0,
        tbl_names: vec![], tbl_count: 0,
        col_names: vec![], col_types: vec![],
        tbl_col_starts: vec![], tbl_col_counts: vec![],
        cells: vec![],
        tbl_row_starts: vec![], tbl_row_counts: vec![],
        idx_names: vec![], idx_tables: vec![], idx_col_indices: vec![], idx_count: 0,
        idx_keys: vec![], idx_rowids: vec![], idx_key_starts: vec![], idx_key_counts: vec![],
        input: "", ilen: 0, pos: 0,
        tk_type: 7, tk_val: "",
        stmt_type: 0, p_table: -1,
        p_cols: vec![], p_col_count: 0,
        p_types: vec![],
        p_vals: vec![], p_val_count: 0, p_row_count: 0,
        has_where: 0, wc_count: 0,
        wc_left: vec![], wc_op: vec![], wc_right: vec![],
        wc_neg: vec![],
        wn_kind: vec![], wn_a: vec![], wn_b: vec![], wn_count: 0, wc_root: -1,
        has_order: 0, order_col: -1, order_desc: 0,
        order_col2: -1, order_desc2: 0, order_agg_func: 0,
        has_limit: 0, limit_val: 0,
        has_offset: 0, offset_val: 0,
        set_col: -1, set_val: -1, set_op: -1, set_operand: -1,
        select_star: 0,
        p_agg_funcs: vec![], p_agg_cols: vec![], p_agg_count: 0,
        has_group_by: 0, group_col: -1,
        has_join: 0, join_type: 0, join_table: -1, join_left_col: -1, join_right_col: -1,
        alias1: -1, alias2: -1,
        idx_name: -1, idx_table_name: -1, idx_col_name: -1,
        wc_in_start: vec![], wc_in_len: vec![], wc_in_pool: vec![],
        subq_vals: vec![], subq_count: 0,
        has_distinct: 0,
        has_having: 0, having_agg_func: 0, having_agg_col: -1, having_op: -1, having_val: -1,
        p_aliases: vec![],
        p_agg_distinct: vec![],
        alter_col_name: -1, alter_col_type: -1,
        wal_path: wp,
        in_transaction: false,
        txn_id: 0,
        wal_buf: "",
        wal_bytes: 0, db_bytes: 0,
        crash_at: 0, crash_torn: false, trace_writes: false, write_seq: 0,
        idx_stale: false,
        snap_cells: vec![], snap_row_starts: vec![], snap_row_counts: vec![],
        snap_tbl_names: vec![], snap_tbl_count: 0,
        snap_col_names: vec![], snap_col_types: vec![],
        snap_col_starts: vec![], snap_col_counts: vec![],
        snap_idx_names: vec![], snap_idx_tables: vec![], snap_idx_col_indices: vec![], snap_idx_count: 0,
        snap_idx_keys: vec![], snap_idx_rowids: vec![], snap_idx_key_starts: vec![], snap_idx_key_counts: vec![],
        union_vals: vec![], union_headers: vec![], union_coltypes: vec![],
        union_ncol: -1, union_rows: 0, union_started: 0,
    }
}

// --- String Pool ---
// All strings in the engine are interned in d.pool, a Vec<String>. sp_add
// pushes the text and returns its integer ID; sp_get returns the text by ID.
// Pool IDs are used everywhere: table names, column names, cell values,
// parsed tokens. Both calls are O(1). The pool used to be one contiguous
// String grown by concatenation, which copied the whole pool on every
// sp_add, so loading N rows cost O(N^2) time and memory.
fn sp_add(d: &mut DB, text: String) -> i32 {
    let id = d.pn;
    vec_push(d.pool, text);
    d.pn = d.pn + 1;
    id
}

fn sp_get(d: &DB, id: i32) -> String {
    if id < 0 { return ""; }
    vec_get(d.pool, id)
}

// =========================================================================
// SECTION 2: STORAGE — File Persistence (Save / Load)
// =========================================================================
// The database file uses a simple line-oriented text format:
//
//   TABLE <name>
//   SCHEMA <col1>:<TYPE> <col2>:<TYPE> ...
//   ROW <val1>|<val2>|...
//   ROW ...
//   END
//
//   INDEX <name> ON <table> (<column>)
//
// db_save serializes the entire in-memory state to this format.
// db_load parses the file back into the parallel-array structures.
// There is no incremental I/O; the full file is read/written each time.
// =========================================================================

// Join strings pairwise, round by round, so each byte is copied O(log parts)
// times. Appending every line to one growing String copied the whole output
// per line, O(size^2) per save.
fn concat_parts(parts: Vec<String>) -> String {
    let mut cur: Vec<String> = parts;
    let mut n = vec_len(cur);
    if n == 0 { return ""; }
    while n > 1 {
        let mut next: Vec<String> = vec![];
        let mut i = 0;
        while i < n {
            let a: String = vec_get(cur, i);
            if i + 1 < n {
                let b: String = vec_get(cur, i + 1);
                vec_push(next, a + b);
            } else {
                vec_push(next, a);
            }
            i = i + 2;
        }
        cur = next;
        n = vec_len(cur);
    }
    vec_get(cur, 0)
}

// Serialize the entire database (all tables, rows, and index declarations)
// to the text-based file format and write to d.db_path. Returns the number
// of bytes written, which the checkpoint policy compares the WAL against.
// Does NOT write WAL — this is the "clean" checkpoint format.
// Output is built in chunks of about 64 KB, joined once by concat_parts.
fn db_text(d: &DB) -> String {
    let mut parts: Vec<String> = vec![];
    let mut out = "";
    let mut t = 0;
    while t < d.tbl_count {
        let tname = sp_get(d, vec_get(d.tbl_names, t));
        out = out + "TABLE " + tname + "\n";
        // Schema line
        let cs = vec_get(d.tbl_col_starts, t);
        let cc = vec_get(d.tbl_col_counts, t);
        let mut schema = "SCHEMA";
        let mut c = 0;
        while c < cc {
            let cname = sp_get(d, vec_get(d.col_names, cs + c));
            let ctype = vec_get(d.col_types, cs + c);
            let tstr = if ctype == 0 { "INTEGER" } else if ctype == 1 { "REAL" } else { "TEXT" };
            schema = schema + " " + cname + ":" + tstr;
            c = c + 1;
        }
        out = out + schema + "\n";
        // Rows
        let rs = vec_get(d.tbl_row_starts, t);
        let rc = vec_get(d.tbl_row_counts, t);
        let mut r = 0;
        while r < rc {
            let mut row_str = "ROW ";
            let mut ci = 0;
            while ci < cc {
                if ci > 0 { row_str = row_str + "|"; }
                let cell = sp_get(d, vec_get(d.cells, rs + r * cc + ci));
                row_str = row_str + cell;
                ci = ci + 1;
            }
            out = out + row_str + "\n";
            if out.len() > 65536 {
                vec_push(parts, out);
                out = "";
            }
            r = r + 1;
        }
        out = out + "END\n";
        if t + 1 < d.tbl_count {
            out = out + "\n";
        }
        t = t + 1;
    }
    // Save indexes
    let mut ix = 0;
    while ix < d.idx_count {
        let iname = sp_get(d, vec_get(d.idx_names, ix));
        let tbl_idx = vec_get(d.idx_tables, ix);
        let tname = sp_get(d, vec_get(d.tbl_names, tbl_idx));
        let col_i = vec_get(d.idx_col_indices, ix);
        let tcs = vec_get(d.tbl_col_starts, tbl_idx);
        let cname = sp_get(d, vec_get(d.col_names, tcs + col_i));
        out = out + "\nINDEX " + iname + " ON " + tname + " (" + cname + ")\n";
        ix = ix + 1;
    }
    vec_push(parts, out);
    concat_parts(parts)
}

// Rewrite the .db from memory. Returns the bytes written, which the
// checkpoint policy compares the WAL against.
fn db_save(d: &mut DB) -> i64 ~ Console + FileSystem + Process {
    let all = db_text(d);
    durable_write(d, d.db_path, all, false, "db");
    all.len()
}

// Load the database from the text file at d.db_path.
// Parses TABLE/SCHEMA/ROW/END/INDEX lines and populates all parallel arrays.
// If the file doesn't exist or is empty, returns immediately (empty database).
// After loading, the caller should also call wal_replay() to recover any
// committed transactions from the WAL that haven't been checkpointed.
fn db_load(d: &mut DB) ~ FileSystem {
    if !file_exists(d.db_path) { return; }
    let content = read_file(d.db_path);
    let clen = content.len();
    if clen == 0 { return; }

    d.db_bytes = clen;
    // Split once. Slicing off the rest of the content for every line copied
    // the remainder of the file per line, O(size^2) for a large .db.
    let lines: Vec<String> = content.lines();
    let nlines = vec_len(lines);
    let mut li: i64 = 0;
    let mut go = true;
    while go {
        if li >= nlines { go = false; }
        else {
            let line: String = vec_get(lines, li);
            li = li + 1;

            // Strip \r
            let llen = line.len();
            let clean = if llen > 0 {
                let last = line.char_at(llen - 1);
                if last == "\r" { line.substring(0, llen - 1) } else { line }
            } else { line };

            let clen2 = clean.len();
            if clen2 == 0 {
                // skip empty
            } else if clean.starts_with("TABLE ") {
                let tname = clean.substring(6, clen2 - 6);
                let tid = sp_add(d, tname);
                vec_push(d.tbl_names, tid);
                vec_push(d.tbl_col_starts, vec_len(d.col_names));
                vec_push(d.tbl_col_counts, 0);
                vec_push(d.tbl_row_starts, vec_len(d.cells));
                vec_push(d.tbl_row_counts, 0);
                d.tbl_count = d.tbl_count + 1;
            } else if clean.starts_with("SCHEMA ") {
                let schema_str = clean.substring(7, clen2 - 7);
                let slen = schema_str.len();
                let mut sp: i64 = 0;
                let mut col_c = 0;
                let mut sgo = true;
                while sgo {
                    if sp >= slen { sgo = false; }
                    else {
                        // Skip spaces
                        let mut skip = true;
                        while skip {
                            if sp >= slen { skip = false; }
                            else {
                                let sc = schema_str.char_at(sp);
                                if sc == " " { sp = sp + 1; } else { skip = false; }
                            }
                        }
                        if sp >= slen { sgo = false; }
                        else {
                            // Read col_name:type token
                            let tok_start = sp;
                            let mut tgo = true;
                            while tgo {
                                if sp >= slen { tgo = false; }
                                else {
                                    let tc = schema_str.char_at(sp);
                                    if tc == " " { tgo = false; }
                                    else { sp = sp + 1; }
                                }
                            }
                            let tok = schema_str.substring(tok_start, sp - tok_start);
                            // Split on ':'
                            let colon = tok.index_of(":");
                            if colon > 0 {
                                let tlen = tok.len();
                                let cname = tok.substring(0, colon);
                                let ctype_str = tok.substring(colon + 1, tlen - colon - 1);
                                let ctype_up = ctype_str.to_uppercase();
                                let cnid = sp_add(d, cname);
                                vec_push(d.col_names, cnid);
                                let ct = type_code_for(ctype_up);
                                vec_push(d.col_types, ct);
                                col_c = col_c + 1;
                            }
                        }
                    }
                }
                // Update col count for current table
                let tidx = d.tbl_count - 1;
                let mut new_cc: Vec<i32> = vec![];
                let mut ci = 0;
                while ci < d.tbl_count {
                    if ci == tidx { vec_push(new_cc, col_c); }
                    else { vec_push(new_cc, vec_get(d.tbl_col_counts, ci)); }
                    ci = ci + 1;
                }
                d.tbl_col_counts = new_cc;
            } else if clean.starts_with("ROW ") {
                let row_str = clean.substring(4, clen2 - 4);
                let rlen = row_str.len();
                let mut rp: i64 = 0;
                let mut cell_count_in_row = 0;
                let mut rgo = true;
                while rgo {
                    if rp >= rlen { rgo = false; }
                    else {
                        let mut cell_val = "";
                        let mut cgo = true;
                        while cgo {
                            if rp >= rlen { cgo = false; }
                            else {
                                let rc = row_str.char_at(rp);
                                if rc == "|" { rp = rp + 1; cgo = false; }
                                else { cell_val = cell_val + rc; rp = rp + 1; }
                            }
                        }
                        let cid = sp_add(d, cell_val);
                        vec_push(d.cells, cid);
                        cell_count_in_row = cell_count_in_row + 1;
                    }
                }
                // Pad with empty cells if row has fewer cells than schema columns
                // (handles trailing pipe for NULL/empty values)
                let tidx = d.tbl_count - 1;
                let expected_cc = vec_get(d.tbl_col_counts, tidx);
                let mut pad_i = cell_count_in_row;
                while pad_i < expected_cc {
                    let empty_id = sp_add(d, "");
                    vec_push(d.cells, empty_id);
                    pad_i = pad_i + 1;
                }
                // Increment row count for current table
                let tidx = d.tbl_count - 1;
                let old_rc = vec_get(d.tbl_row_counts, tidx);
                let mut new_rc: Vec<i32> = vec![];
                let mut ri = 0;
                while ri < d.tbl_count {
                    if ri == tidx { vec_push(new_rc, old_rc + 1); }
                    else { vec_push(new_rc, vec_get(d.tbl_row_counts, ri)); }
                    ri = ri + 1;
                }
                d.tbl_row_counts = new_rc;
            // Parse INDEX lines: INDEX idx_name ON table_name (col_name)
            } else if clean.starts_with("INDEX ") {
                let idx_rest = clean.substring(6, clen2 - 6);
                // Parse: idx_name ON table_name (col_name)
                let sp1 = idx_rest.index_of(" ");
                if sp1 > 0 {
                    let iname = idx_rest.substring(0, sp1);
                    let after_name = idx_rest.substring(sp1 + 1, idx_rest.len() - sp1 - 1);
                    // skip "ON "
                    let trimmed_an = after_name.trim();
                    if trimmed_an.starts_with("ON ") {
                        let after_on = trimmed_an.substring(3, trimmed_an.len() - 3);
                        let trimmed_ao = after_on.trim();
                        let sp2 = trimmed_ao.index_of(" ");
                        if sp2 > 0 {
                            let tname_idx = trimmed_ao.substring(0, sp2);
                            let paren_part = trimmed_ao.substring(sp2 + 1, trimmed_ao.len() - sp2 - 1).trim();
                            // Extract col name from (col_name)
                            if paren_part.starts_with("(") {
                                let pp_len = paren_part.len();
                                let col_name_idx = paren_part.substring(1, pp_len - 2);
                                // Build the index
                                let tidx = find_table(d, tname_idx);
                                if tidx >= 0 {
                                    let ics = vec_get(d.tbl_col_starts, tidx);
                                    let icc = vec_get(d.tbl_col_counts, tidx);
                                    let icol = find_col(d, ics, icc, col_name_idx);
                                    if icol >= 0 {
                                        let inid = sp_add(d, iname);
                                        vec_push(d.idx_names, inid);
                                        vec_push(d.idx_tables, tidx);
                                        vec_push(d.idx_col_indices, icol);
                                        vec_push(d.idx_key_starts, vec_len(d.idx_keys));
                                        vec_push(d.idx_key_counts, 0);
                                        d.idx_count = d.idx_count + 1;
                                        // Rebuild index data from table rows
                                        rebuild_index(d, d.idx_count - 1);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // END and unknown lines are skipped
        }
    }
}

// =========================================================================
// SECTION 3: WAL — Write-Ahead Log, Snapshots, Transactions
// =========================================================================
// The WAL provides crash recovery and transaction support.
//
// WAL file format (append-only; every write opens the file in append mode):
//   TXID <n>        — start of transaction n
//   OP <sql>        — a mutation SQL statement within the transaction
//   COMMIT          — marks transaction n as committed
//
// Recovery flow (wal_replay):
//   1. Read the WAL in one pass. A TXID line opens a transaction; a COMMIT
//      line replays that transaction's OP lines via exec_sql_no_wal.
//      A transaction with no COMMIT (a crash mid-transaction, a torn final
//      record, a ROLLBACK, or a process that exited inside BEGIN) is skipped.
//   2. Checkpoint (save + clear WAL)
//
// Transaction flow:
//   BEGIN    -> take_snapshot() + append TXID
//   mutations-> each appends "OP <sql>"
//   COMMIT   -> append COMMIT, then maybe_checkpoint()
//   ROLLBACK -> restore_snapshot() + checkpoint (discards WAL entries)
//
// Auto-commit: a mutation outside an explicit transaction appends one
// record "TXID n / OP sql / COMMIT" in a single append, then calls
// maybe_checkpoint().
//
// Durability contract. A statement is durable once its COMMIT line is in the
// WAL: the next startup replays it whether or not a checkpoint ran. The
// engine has always relied on that point. Before this change the WAL was
// rewritten in full for every line and the .db after every statement; both
// writes truncate and refill a file, so a crash during either could lose
// committed data. An append never touches bytes already written, so a crash
// can at worst tear the last record, and a torn record lacks its COMMIT and
// is skipped. The .db rewrite in db_save is still truncate-and-write, as
// before; it now runs far less often. No write calls fsync, before or after:
// durability is to the OS file cache.
//
// Checkpoint policy. maybe_checkpoint rewrites the .db only once the WAL
// holds more bytes than the .db plus wal_checkpoint_slack(), and never inside
// an open transaction. A checkpoint then costs at most the bytes appended
// since the previous one, so the save cost of a load grows linearly with its
// size. A clean exit (end of a single statement, or the REPL's .quit) also
// checkpoints, so the .db on disk is current between processes, as before.
// =========================================================================

fn wal_checkpoint_slack() -> i64 { 65536 }

// Every write that changes durable state goes through here: WAL appends,
// the .db rewrite and the WAL clear. `tag` names the write in the trace.
fn durable_write(d: &mut DB, path: String, text: String, append: bool, tag: String) ~ Console + FileSystem + Process {
    d.write_seq = d.write_seq + 1;
    if d.trace_writes {
        eprintln!("QDB_WRITE {} {} {}", d.write_seq, tag, text.len());
    }
    if d.crash_at > 0 && d.write_seq == d.crash_at {
        if d.crash_torn {
            let half = text.substring(0, text.len() / 2);
            if append { append_file(path, half); } else { write_file(path, half); }
        }
        process_exit(77);
    }
    if append { append_file(path, text); } else { write_file(path, text); }
}

// Append newline-terminated text to the WAL in a single write.
fn wal_append(d: &mut DB, text: String, tag: String) ~ Console + FileSystem + Process {
    durable_write(d, d.wal_path, text, true, tag);
    d.wal_bytes = d.wal_bytes + text.len();
}

// Append a line to the WAL file
fn wal_write(d: &mut DB, line: String, tag: String) ~ Console + FileSystem + Process {
    wal_append(d, line + "\n", tag);
}

// Checkpoint: merge WAL into main .db file, then clear WAL
fn wal_checkpoint(d: &mut DB) ~ Console + FileSystem + Process {
    d.db_bytes = db_save(d);
    // Clear the WAL file
    if file_exists(d.wal_path) {
        durable_write(d, d.wal_path, "", false, "wal_clear");
    }
    d.wal_bytes = 0;
}

// Checkpoint once the WAL has grown past the .db it would be merged into.
// Never inside an explicit transaction: db_save would persist uncommitted
// in-memory changes.
fn maybe_checkpoint(d: &mut DB) ~ Console + FileSystem + Process {
    if d.in_transaction { return; }
    if d.wal_bytes > d.db_bytes + wal_checkpoint_slack() {
        wal_checkpoint(d);
    }
}

// Checkpoint at a clean exit so the .db file is current between processes.
// Skipped inside an open transaction, which stays uncommitted as before.
fn wal_close(d: &mut DB) ~ Console + FileSystem + Process {
    if d.in_transaction { return; }
    if d.wal_bytes > 0 { wal_checkpoint(d); }
}

// Strip one trailing carriage return (a WAL or .db written on Windows).
fn strip_cr(line: String) -> String {
    let llen = line.len();
    if llen > 0 {
        let last = line.char_at(llen - 1);
        if last == "\r" { return line.substring(0, llen - 1); }
    }
    line
}

// Replay committed transactions from WAL into a freshly-loaded DB.
//
// Called once at startup after db_load(). One pass over the lines:
//   TXID   opens a transaction at the next line;
//   COMMIT replays the open transaction's OP lines, in order, through
//          exec_sql_no_wal (no re-logging), then closes it;
//   a later TXID before any COMMIT abandons the open transaction.
// An OP line outside any TXID, and every OP line of a transaction that never
// reached COMMIT, is skipped. Within one process transaction ids only grow,
// and every replay ends by clearing the WAL, so on any WAL the engine writes
// this replays exactly what the older two-pass rule did ("replay an OP if its
// TXID has a COMMIT"), in time linear in the WAL instead of quadratic.
// After replay, checkpoints to merge into the .db file and clears the WAL.
//
// Assumes: DB is already loaded from the .db file. WAL contains only
// mutations that happened after the last checkpoint.
fn wal_replay(d: &mut DB) ~ Console + FileSystem + Process {
    if !file_exists(d.wal_path) { return; }
    let content = read_file(d.wal_path);
    let clen = content.len();
    if clen == 0 { return; }

    let lines: Vec<String> = content.lines();
    let n = vec_len(lines);
    let mut txn_start: i64 = 0 - 1;
    let mut li: i64 = 0;
    while li < n {
        let wl = strip_cr(vec_get(lines, li));
        if wl.starts_with("TXID ") {
            txn_start = li + 1;
        } else if wl.starts_with("COMMIT") {
            if txn_start >= 0 {
                let mut j = txn_start;
                while j < li {
                    let rl = strip_cr(vec_get(lines, j));
                    if rl.starts_with("OP ") {
                        let rlen = rl.len();
                        let sql: String = rl.substring(3, rlen - 3);
                        exec_sql_no_wal(d, sql);
                    }
                    j = j + 1;
                }
                txn_start = 0 - 1;
            }
        }
        li = li + 1;
    }

    // After replay, checkpoint to merge into .db and clear WAL
    wal_checkpoint(d);
}

// Take a deep copy of all mutable DB state into snap_* fields.
// Called at BEGIN to enable ROLLBACK. Copies: cells, row starts/counts,
// table names/count, column names/types/starts/counts, and all index arrays.
fn take_snapshot(d: &mut DB) {
    // Copy cells
    d.snap_cells = vec![];
    let nc = vec_len(d.cells);
    let mut i: i64 = 0;
    while i < nc {
        vec_push(d.snap_cells, vec_get(d.cells, i));
        i = i + 1;
    }
    // Copy row starts
    d.snap_row_starts = vec![];
    i = 0;
    while i < d.tbl_count {
        vec_push(d.snap_row_starts, vec_get(d.tbl_row_starts, i));
        i = i + 1;
    }
    // Copy row counts
    d.snap_row_counts = vec![];
    i = 0;
    while i < d.tbl_count {
        vec_push(d.snap_row_counts, vec_get(d.tbl_row_counts, i));
        i = i + 1;
    }
    // Copy table names
    d.snap_tbl_names = vec![];
    i = 0;
    while i < d.tbl_count {
        vec_push(d.snap_tbl_names, vec_get(d.tbl_names, i));
        i = i + 1;
    }
    d.snap_tbl_count = d.tbl_count;
    // Copy col names
    d.snap_col_names = vec![];
    let ncn = vec_len(d.col_names);
    i = 0;
    while i < ncn {
        vec_push(d.snap_col_names, vec_get(d.col_names, i));
        i = i + 1;
    }
    // Copy col types
    d.snap_col_types = vec![];
    i = 0;
    while i < ncn {
        vec_push(d.snap_col_types, vec_get(d.col_types, i));
        i = i + 1;
    }
    // Copy col starts
    d.snap_col_starts = vec![];
    i = 0;
    while i < d.tbl_count {
        vec_push(d.snap_col_starts, vec_get(d.tbl_col_starts, i));
        i = i + 1;
    }
    // Copy col counts
    d.snap_col_counts = vec![];
    i = 0;
    while i < d.tbl_count {
        vec_push(d.snap_col_counts, vec_get(d.tbl_col_counts, i));
        i = i + 1;
    }
    // Copy index state
    d.snap_idx_names = vec![];
    d.snap_idx_tables = vec![];
    d.snap_idx_col_indices = vec![];
    i = 0;
    while i < d.idx_count {
        vec_push(d.snap_idx_names, vec_get(d.idx_names, i));
        vec_push(d.snap_idx_tables, vec_get(d.idx_tables, i));
        vec_push(d.snap_idx_col_indices, vec_get(d.idx_col_indices, i));
        i = i + 1;
    }
    d.snap_idx_count = d.idx_count;
    d.snap_idx_keys = vec![];
    let nk = vec_len(d.idx_keys);
    i = 0;
    while i < nk {
        vec_push(d.snap_idx_keys, vec_get(d.idx_keys, i));
        i = i + 1;
    }
    d.snap_idx_rowids = vec![];
    let nr = vec_len(d.idx_rowids);
    i = 0;
    while i < nr {
        vec_push(d.snap_idx_rowids, vec_get(d.idx_rowids, i));
        i = i + 1;
    }
    d.snap_idx_key_starts = vec![];
    i = 0;
    while i < d.idx_count {
        vec_push(d.snap_idx_key_starts, vec_get(d.idx_key_starts, i));
        i = i + 1;
    }
    d.snap_idx_key_counts = vec![];
    i = 0;
    while i < d.idx_count {
        vec_push(d.snap_idx_key_counts, vec_get(d.idx_key_counts, i));
        i = i + 1;
    }
}

// Restore state from snapshot (for ROLLBACK)
fn restore_snapshot(d: &mut DB) {
    d.cells = d.snap_cells;
    d.tbl_row_starts = d.snap_row_starts;
    d.tbl_row_counts = d.snap_row_counts;
    d.tbl_names = d.snap_tbl_names;
    d.tbl_count = d.snap_tbl_count;
    d.col_names = d.snap_col_names;
    d.col_types = d.snap_col_types;
    d.tbl_col_starts = d.snap_col_starts;
    d.tbl_col_counts = d.snap_col_counts;
    d.idx_names = d.snap_idx_names;
    d.idx_tables = d.snap_idx_tables;
    d.idx_col_indices = d.snap_idx_col_indices;
    d.idx_count = d.snap_idx_count;
    d.idx_keys = d.snap_idx_keys;
    d.idx_rowids = d.snap_idx_rowids;
    d.idx_key_starts = d.snap_idx_key_starts;
    d.idx_key_counts = d.snap_idx_key_counts;
    // The snapshot's index entries may predate rows that were appended and
    // not yet folded in; rebuild from the restored rows on the next read.
    d.idx_stale = true;
}

// BEGIN — start a new explicit transaction
fn wal_begin(d: &mut DB) ~ Console + FileSystem + Process {
    if d.in_transaction {
        println!("Error: transaction already in progress");
        return;
    }
    d.in_transaction = true;
    d.txn_id = d.txn_id + 1;
    take_snapshot(d);
    wal_write(d, "TXID " + to_string_i32(d.txn_id), "wal_begin");
}

// COMMIT — finalize the current transaction
fn wal_commit(d: &mut DB) ~ Console + FileSystem + Process {
    if !d.in_transaction {
        println!("Error: no transaction in progress");
        return;
    }
    wal_write(d, "COMMIT", "wal_commit");
    d.in_transaction = false;
    maybe_checkpoint(d);
}

// ROLLBACK — discard changes since BEGIN
fn wal_rollback(d: &mut DB) ~ Console + FileSystem + Process {
    if !d.in_transaction {
        println!("Error: no transaction in progress");
        return;
    }
    restore_snapshot(d);
    d.in_transaction = false;
    // Discard WAL entries for this txn by checkpointing restored state
    wal_checkpoint(d);
}

// Write a mutation to WAL and optionally auto-commit
fn wal_log_mutation(d: &mut DB, sql: String) ~ Console + FileSystem + Process {
    if d.in_transaction {
        // In explicit transaction — just append OP to WAL
        wal_write(d, "OP " + sql, "wal_op");
    } else {
        // Auto-commit: wrap in a single-statement transaction, written as one
        // append so a torn write cannot leave a COMMIT without its OP.
        d.txn_id = d.txn_id + 1;
        wal_append(d, "TXID " + to_string_i32(d.txn_id) + "\nOP " + sql + "\nCOMMIT\n", "wal_auto");
        maybe_checkpoint(d);
    }
}

// Count WAL entries and pending status (for .wal command)
fn cmd_wal(d: &DB) ~ Console + FileSystem {
    if !file_exists(d.wal_path) {
        println!("WAL status: empty (no WAL file)");
        return;
    }
    let content = read_file(d.wal_path);
    let clen = content.len();
    if clen == 0 {
        println!("WAL status: empty");
        return;
    }
    let mut op_count = 0;
    let mut pending = 0;
    let mut in_txn = false;
    let lines: Vec<String> = content.lines();
    let n = vec_len(lines);
    let mut li: i64 = 0;
    while li < n {
        let clean = strip_cr(vec_get(lines, li));
        if clean.starts_with("OP ") { op_count = op_count + 1; }
        if clean.starts_with("TXID ") { in_txn = true; }
        if clean == "COMMIT" { in_txn = false; }
        li = li + 1;
    }
    if in_txn { pending = 1; }
    println!("WAL status: {} entries, {} pending transaction", op_count, pending);
}

// --- Table Lookup ---
// Linear scan of tbl_names to find a table by name. Returns table index or -1.
fn find_table(d: &DB, name: String) -> i32 {
    let mut i = 0;
    while i < d.tbl_count {
        let tn = sp_get(d, vec_get(d.tbl_names, i));
        if tn == name { return i; }
        i = i + 1;
    }
    0 - 1
}

// =========================================================================
// SECTION 4: TOKENIZER — SQL Lexical Analysis
// =========================================================================
// Converts the raw SQL input string into a stream of tokens. The tokenizer
// is stateful: d.pos tracks position in d.input, d.tk_type and d.tk_val
// hold the current token. Calling next_token() advances to the next token.
//
// Token types:
//   0 = Keyword (SELECT, FROM, WHERE, etc. — uppercased)
//   1 = Identifier (table/column names — preserved case)
//   2 = String literal (single-quoted, '' for escaped quotes)
//   3 = Number literal (integer or decimal, optional leading minus)
//   4 = Operator (=, <, >, <=, >=, <>, !=, +, -, /)
//   5 = Punctuation ((, ), ,, ;, .)
//   6 = Star (*)
//   7 = EOF
//
// The tokenizer recognizes all SQL keywords via is_keyword() and
// automatically uppercases them. Identifiers are NOT uppercased.
// =========================================================================
fn skip_ws_sql(d: &mut DB) {
    let mut go = true;
    while go {
        if d.pos >= d.ilen { go = false; }
        else {
            let c = d.input.char_at(d.pos);
            if is_ws(c) { d.pos = d.pos + 1; } else { go = false; }
        }
    }
}

fn is_keyword(word: String) -> i32 {
    let u = word.to_uppercase();
    if u == "SELECT" { return 1; }
    if u == "FROM" { return 1; }
    if u == "WHERE" { return 1; }
    if u == "INSERT" { return 1; }
    if u == "INTO" { return 1; }
    if u == "VALUES" { return 1; }
    if u == "CREATE" { return 1; }
    if u == "TABLE" { return 1; }
    if u == "UPDATE" { return 1; }
    if u == "SET" { return 1; }
    if u == "DELETE" { return 1; }
    if u == "DROP" { return 1; }
    if u == "ORDER" { return 1; }
    if u == "BY" { return 1; }
    if u == "ASC" { return 1; }
    if u == "DESC" { return 1; }
    if u == "LIMIT" { return 1; }
    if u == "OFFSET" { return 1; }
    if u == "AND" { return 1; }
    if u == "OR" { return 1; }
    if u == "NOT" { return 1; }
    if u == "NULL" { return 1; }
    if u == "INTEGER" { return 1; }
    if u == "REAL" { return 1; }
    if u == "TEXT" { return 1; }
    if u == "BLOB" { return 1; }
    if u == "PRIMARY" { return 1; }
    if u == "KEY" { return 1; }
    if u == "COUNT" { return 1; }
    if u == "INDEX" { return 1; }
    if u == "ON" { return 1; }
    if u == "JOIN" { return 1; }
    if u == "LEFT" { return 1; }
    if u == "RIGHT" { return 1; }
    if u == "INNER" { return 1; }
    if u == "OUTER" { return 1; }
    if u == "FULL" { return 1; }
    if u == "CROSS" { return 1; }
    if u == "GROUP" { return 1; }
    if u == "SUM" { return 1; }
    if u == "AVG" { return 1; }
    if u == "MIN" { return 1; }
    if u == "MAX" { return 1; }
    if u == "AS" { return 1; }
    if u == "BEGIN" { return 1; }
    if u == "COMMIT" { return 1; }
    if u == "ROLLBACK" { return 1; }
    if u == "LIKE" { return 1; }
    if u == "IN" { return 1; }
    if u == "IS" { return 1; }
    if u == "ALTER" { return 1; }
    if u == "ADD" { return 1; }
    if u == "COLUMN" { return 1; }
    if u == "DISTINCT" { return 1; }
    if u == "HAVING" { return 1; }
    if u == "BETWEEN" { return 1; }
    if u == "UNION" { return 1; }
    if u == "ALL" { return 1; }
    0
}

fn next_token(d: &mut DB) {
    skip_ws_sql(d);
    if d.pos >= d.ilen {
        d.tk_type = 7; d.tk_val = ""; return;
    }
    let c = d.input.char_at(d.pos);

    // String literal
    if c == "'" {
        d.pos = d.pos + 1;
        let mut val = "";
        let mut go = true;
        while go {
            if d.pos >= d.ilen { go = false; }
            else {
                let qc = d.input.char_at(d.pos);
                if qc == "'" {
                    if d.pos + 1 < d.ilen {
                        let nx = d.input.char_at(d.pos + 1);
                        if nx == "'" { val = val + "'"; d.pos = d.pos + 2; }
                        else { d.pos = d.pos + 1; go = false; }
                    } else { d.pos = d.pos + 1; go = false; }
                } else { val = val + qc; d.pos = d.pos + 1; }
            }
        }
        d.tk_type = 2; d.tk_val = val; return;
    }

    // Number literal
    if is_digit(c) || (c == "-" && d.pos + 1 < d.ilen) {
        let mut is_neg = false;
        if c == "-" {
            let nx = d.input.char_at(d.pos + 1);
            if is_digit(nx) { is_neg = true; }
        }
        if is_digit(c) || is_neg {
            let mut val = "";
            if is_neg { val = "-"; d.pos = d.pos + 1; }
            let mut ngo = true;
            while ngo {
                if d.pos >= d.ilen { ngo = false; }
                else {
                    let nc = d.input.char_at(d.pos);
                    if is_digit(nc) { val = val + nc; d.pos = d.pos + 1; }
                    else if nc == "." { val = val + nc; d.pos = d.pos + 1; }
                    else { ngo = false; }
                }
            }
            d.tk_type = 3; d.tk_val = val; return;
        }
    }

    // Identifier or keyword
    if is_alpha(c) || c == "_" {
        let mut val = "";
        let mut go = true;
        while go {
            if d.pos >= d.ilen { go = false; }
            else {
                let ic = d.input.char_at(d.pos);
                if is_alnum(ic) { val = val + ic; d.pos = d.pos + 1; }
                else { go = false; }
            }
        }
        let kw = is_keyword(val);
        if kw == 1 { d.tk_type = 0; d.tk_val = val.to_uppercase(); }
        else { d.tk_type = 1; d.tk_val = val; }
        return;
    }

    // Operators
    if c == "<" {
        d.pos = d.pos + 1;
        if d.pos < d.ilen {
            let nx = d.input.char_at(d.pos);
            if nx == "=" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "<="; return; }
            if nx == ">" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "<>"; return; }
        }
        d.tk_type = 4; d.tk_val = "<"; return;
    }
    if c == ">" {
        d.pos = d.pos + 1;
        if d.pos < d.ilen {
            let nx = d.input.char_at(d.pos);
            if nx == "=" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = ">="; return; }
        }
        d.tk_type = 4; d.tk_val = ">"; return;
    }
    if c == "!" {
        d.pos = d.pos + 1;
        if d.pos < d.ilen {
            let nx = d.input.char_at(d.pos);
            if nx == "=" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "!="; return; }
        }
        d.tk_type = 4; d.tk_val = "!"; return;
    }
    if c == "=" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "="; return; }
    if c == "+" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "+"; return; }
    if c == "-" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "-"; return; }
    if c == "/" { d.pos = d.pos + 1; d.tk_type = 4; d.tk_val = "/"; return; }
    if c == "*" { d.pos = d.pos + 1; d.tk_type = 6; d.tk_val = "*"; return; }
    if c == "(" { d.pos = d.pos + 1; d.tk_type = 5; d.tk_val = "("; return; }
    if c == ")" { d.pos = d.pos + 1; d.tk_type = 5; d.tk_val = ")"; return; }
    if c == "," { d.pos = d.pos + 1; d.tk_type = 5; d.tk_val = ","; return; }
    if c == ";" { d.pos = d.pos + 1; d.tk_type = 5; d.tk_val = ";"; return; }
    if c == "." { d.pos = d.pos + 1; d.tk_type = 5; d.tk_val = "."; return; }

    d.pos = d.pos + 1; d.tk_type = 1; d.tk_val = c;
}

fn tk_is_kw(d: &DB, kw: String) -> i32 {
    if d.tk_type == 0 { if d.tk_val == kw { return 1; } }
    0
}

fn tk_is_punct(d: &DB, p: String) -> i32 {
    if d.tk_type == 5 { if d.tk_val == p { return 1; } }
    0
}

fn expect_kw(d: &mut DB, kw: String) ~ Console + Process {
    if tk_is_kw(d, kw) == 0 {
        println!("Error: expected keyword '{}', got '{}'", kw, d.tk_val);
        process_exit(1);
    }
    next_token(d);
}

fn expect_punct(d: &mut DB, p: String) ~ Console + Process {
    if tk_is_punct(d, p) == 0 {
        println!("Error: expected '{}', got '{}'", p, d.tk_val);
        process_exit(1);
    }
    next_token(d);
}

fn op_encode(op: String) -> i32 {
    if op == "=" { return 0; }
    if op == "<" { return 1; }
    if op == ">" { return 2; }
    if op == "<=" { return 3; }
    if op == ">=" { return 4; }
    if op == "<>" { return 5; }
    if op == "!=" { return 5; }
    // 6=LIKE, 7=IN, 8=IS_NULL, 9=IS_NOT_NULL (set directly by parser)
    0 - 1
}

// =========================================================================
// SECTION 5: PARSER — SQL Statement Parsing
// =========================================================================
// Parses tokenized SQL into the "AST" fields of the DB struct. There is no
// separate AST data structure; parsed state is written directly into d.p_*,
// d.has_*, d.wc_* fields. The parser is recursive-descent.
//
// Statement types (d.stmt_type):
//   0 = SELECT    1 = INSERT     2 = CREATE TABLE
//   3 = UPDATE    4 = DELETE     5 = DROP TABLE
//   6 = CREATE INDEX  7 = BEGIN  8 = COMMIT  9 = ROLLBACK
//   10 = ALTER TABLE
//
// parse_sql() is the top-level dispatcher. It peeks at the first keyword
// and delegates to parse_select, parse_insert, parse_create_table, etc.
//
// reset_parser() must be called before each new statement to clear all
// parsed state back to defaults.
// =========================================================================

// Clear the per-statement parse fields to defaults, WITHOUT touching the
// tokenizer position or the UNION accumulator. reset_parser calls this after
// setting up the tokenizer; the UNION executor calls it between branches to
// clear branch 1's parse before parsing branch 2 while keeping the tokenizer
// where it stopped (just past UNION) and the accumulated rows intact.
fn reset_select_fields(d: &mut DB) {
    d.stmt_type = 0;
    d.p_table = -1;
    d.p_cols = vec![];
    d.p_col_count = 0;
    d.p_types = vec![];
    d.p_vals = vec![];
    d.p_val_count = 0;
    d.p_row_count = 0;
    d.has_where = 0;
    d.wc_count = 0;
    d.wc_left = vec![];
    d.wc_op = vec![];
    d.wc_right = vec![];
    d.wc_neg = vec![];
    d.wn_kind = vec![];
    d.wn_a = vec![];
    d.wn_b = vec![];
    d.wn_count = 0;
    d.wc_root = -1;
    d.has_order = 0;
    d.order_col = -1;
    d.order_desc = 0;
    d.order_col2 = -1;
    d.order_desc2 = 0;
    d.order_agg_func = 0;
    d.has_limit = 0;
    d.limit_val = 0;
    d.has_offset = 0;
    d.offset_val = 0;
    d.set_col = -1;
    d.set_val = -1;
    d.set_op = -1;
    d.set_operand = -1;
    d.select_star = 0;
    d.p_agg_funcs = vec![];
    d.p_agg_cols = vec![];
    d.p_agg_count = 0;
    d.has_group_by = 0;
    d.group_col = -1;
    d.has_join = 0;
    d.join_type = 0;
    d.join_table = -1;
    d.join_left_col = -1;
    d.join_right_col = -1;
    d.alias1 = -1;
    d.alias2 = -1;
    d.idx_name = -1;
    d.idx_table_name = -1;
    d.idx_col_name = -1;
    d.wc_in_start = vec![];
    d.wc_in_len = vec![];
    d.wc_in_pool = vec![];
    d.subq_vals = vec![];
    d.subq_count = 0;
    d.has_distinct = 0;
    d.has_having = 0;
    d.having_agg_func = 0;
    d.having_agg_col = -1;
    d.having_op = -1;
    d.having_val = -1;
    d.p_aliases = vec![];
    d.p_agg_distinct = vec![];
    d.alter_col_name = -1;
    d.alter_col_type = -1;
}

// Clear all parser state fields to defaults. Must be called before parsing
// each new SQL statement to avoid stale values from previous parses. This is
// the top-level entry, so it also clears the UNION accumulator.
fn reset_parser(d: &mut DB, input: String) {
    d.input = input;
    d.ilen = input.len();
    d.pos = 0;
    d.tk_type = 7;
    d.tk_val = "";
    reset_select_fields(d);
    d.union_vals = vec![];
    d.union_headers = vec![];
    d.union_coltypes = vec![];
    d.union_ncol = -1;
    d.union_rows = 0;
    d.union_started = 0;
}

fn parse_sql(d: &mut DB) ~ Console + Process {
    next_token(d);
    if tk_is_kw(d, "SELECT") == 1 { parse_select(d); return; }
    if tk_is_kw(d, "INSERT") == 1 { parse_insert(d); return; }
    if tk_is_kw(d, "CREATE") == 1 {
        // Peek: CREATE TABLE or CREATE INDEX?
        next_token(d);
        if tk_is_kw(d, "INDEX") == 1 { next_token(d); parse_create_index(d); return; }
        if tk_is_kw(d, "TABLE") == 1 { next_token(d); parse_create_table(d); return; }
        println!("Error: expected TABLE or INDEX after CREATE, got '{}'", d.tk_val);
        process_exit(1);
    }
    if tk_is_kw(d, "UPDATE") == 1 { parse_update(d); return; }
    if tk_is_kw(d, "DELETE") == 1 { parse_delete(d); return; }
    if tk_is_kw(d, "DROP") == 1 { parse_drop(d); return; }
    if tk_is_kw(d, "ALTER") == 1 { parse_alter_table(d); return; }
    println!("Error: unrecognized statement starting with '{}'", d.tk_val);
    process_exit(1);
}

// Helper: read a possibly dotted identifier (table.col or just col).
// Returns the full string including the dot.
fn read_col_ref(d: &mut DB) -> String {
    let first = d.tk_val;
    next_token(d);
    if tk_is_punct(d, ".") == 1 {
        next_token(d);
        let second = d.tk_val;
        next_token(d);
        return first + "." + second;
    }
    first
}

// Helper: check if a string is an aggregate keyword
fn is_agg_kw(val: String) -> i32 {
    let u = val.to_uppercase();
    if u == "COUNT" { return 1; }
    if u == "SUM" { return 2; }
    if u == "AVG" { return 3; }
    if u == "MIN" { return 4; }
    if u == "MAX" { return 5; }
    0
}

// Parse a SELECT statement.
//
// Grammar (simplified):
//   SELECT [DISTINCT] <select_list> FROM <table> [alias]
//     [JOIN <table2> [alias2] ON <col> = <col>]
//     [WHERE <conditions>]
//     [GROUP BY <col>]
//     [HAVING <agg_condition>]
//     [ORDER BY <col> [ASC|DESC]]
//     [LIMIT <n>]
//
// Populates: d.select_star, d.p_cols, d.p_agg_funcs, d.p_agg_cols,
//   d.p_aliases, d.p_table, d.alias1, d.has_join, d.join_table, d.alias2,
//   d.join_left_col, d.join_right_col, d.has_where, d.has_group_by,
//   d.has_having, d.has_order, d.has_limit, d.has_distinct
fn parse_select(d: &mut DB) ~ Console + Process {
    d.stmt_type = 0;
    next_token(d);

    // Check for DISTINCT keyword
    if tk_is_kw(d, "DISTINCT") == 1 {
        d.has_distinct = 1;
        next_token(d);
    }

    // Parse select list: could be *, column refs, or aggregate functions
    if d.tk_type == 6 {
        // SELECT *
        d.select_star = 1;
        next_token(d);
    } else {
        let mut go = true;
        while go {
            // Check for aggregate function: COUNT(*), SUM(col), AVG(col), MIN(col), MAX(col)
            let agg = is_agg_kw(d.tk_val);
            if agg > 0 {
                next_token(d);
                expect_punct(d, "(");
                // Optional DISTINCT inside the aggregate. Only COUNT(DISTINCT col)
                // is supported; DISTINCT in any other aggregate, or COUNT(DISTINCT *),
                // fails closed rather than silently ignoring the keyword.
                let mut is_distinct = 0;
                if tk_is_kw(d, "DISTINCT") == 1 {
                    is_distinct = 1;
                    next_token(d);
                    if agg != 1 {
                        println!("Error: DISTINCT is only supported inside COUNT");
                        process_exit(1);
                    }
                }
                if d.tk_type == 6 {
                    // COUNT(*)
                    if is_distinct == 1 {
                        println!("Error: COUNT(DISTINCT *) is not supported; use COUNT(*)");
                        process_exit(1);
                    }
                    let star_id = sp_add(d, "*");
                    vec_push(d.p_agg_cols, star_id);
                    next_token(d);
                } else {
                    let agg_col_name = read_col_ref(d);
                    let acid = sp_add(d, agg_col_name);
                    vec_push(d.p_agg_cols, acid);
                }
                expect_punct(d, ")");
                vec_push(d.p_agg_funcs, agg);
                vec_push(d.p_agg_distinct, is_distinct);
                d.p_agg_count = d.p_agg_count + 1;
                // Check for AS alias after aggregate
                if tk_is_kw(d, "AS") == 1 {
                    next_token(d);
                    let alias_name = d.tk_val;
                    let alias_id = sp_add(d, alias_name);
                    vec_push(d.p_aliases, alias_id);
                    next_token(d);
                } else {
                    vec_push(d.p_aliases, 0 - 1);
                }
            } else {
                // Regular column reference (possibly dotted)
                let cref = read_col_ref(d);
                let cid = sp_add(d, cref);
                vec_push(d.p_cols, cid);
                d.p_col_count = d.p_col_count + 1;
                // 0 = no aggregate
                vec_push(d.p_agg_funcs, 0);
                vec_push(d.p_agg_cols, cid);
                vec_push(d.p_agg_distinct, 0);
                d.p_agg_count = d.p_agg_count + 1;
                // Check for AS alias after plain column
                if tk_is_kw(d, "AS") == 1 {
                    next_token(d);
                    let alias_name = d.tk_val;
                    let alias_id = sp_add(d, alias_name);
                    vec_push(d.p_aliases, alias_id);
                    next_token(d);
                } else {
                    vec_push(d.p_aliases, 0 - 1);
                }
            }
            if tk_is_punct(d, ",") == 1 { next_token(d); }
            else { go = false; }
        }
    }

    expect_kw(d, "FROM");
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);

    // Check for table alias (not a keyword)
    if d.tk_type == 1 {
        if tk_is_kw(d, "WHERE") == 0 {
            if tk_is_kw(d, "JOIN") == 0 {
                if tk_is_kw(d, "ORDER") == 0 {
                    if tk_is_kw(d, "LIMIT") == 0 {
                        if tk_is_kw(d, "GROUP") == 0 {
                            d.alias1 = sp_add(d, d.tk_val);
                            next_token(d);
                        }
                    }
                }
            }
        }
    }

    // Optional join qualifier before JOIN: LEFT [OUTER] | INNER.
    // RIGHT/FULL/CROSS are recognized but not yet implemented, so fail closed
    // with a clear error rather than silently running an inner join.
    let mut saw_qualifier = false;
    if tk_is_kw(d, "LEFT") == 1 {
        d.join_type = 1;
        saw_qualifier = true;
        next_token(d);
        if tk_is_kw(d, "OUTER") == 1 { next_token(d); }
    } else if tk_is_kw(d, "INNER") == 1 {
        d.join_type = 0;
        saw_qualifier = true;
        next_token(d);
    } else if tk_is_kw(d, "RIGHT") == 1 {
        println!("Error: RIGHT JOIN is not supported");
        process_exit(1);
    } else if tk_is_kw(d, "FULL") == 1 {
        println!("Error: FULL JOIN is not supported");
        process_exit(1);
    } else if tk_is_kw(d, "CROSS") == 1 {
        println!("Error: CROSS JOIN is not supported");
        process_exit(1);
    }
    if saw_qualifier {
        if tk_is_kw(d, "JOIN") == 0 {
            println!("Error: expected JOIN after join qualifier, got '{}'", d.tk_val);
            process_exit(1);
        }
    }

    // JOIN clause
    if tk_is_kw(d, "JOIN") == 1 {
        d.has_join = 1;
        next_token(d);
        let jt_name = d.tk_val;
        d.join_table = sp_add(d, jt_name);
        next_token(d);
        // Optional alias for join table
        if d.tk_type == 1 {
            if tk_is_kw(d, "ON") == 0 {
                d.alias2 = sp_add(d, d.tk_val);
                next_token(d);
            }
        }
        expect_kw(d, "ON");
        // Parse ON left_col = right_col (dotted refs)
        let left_ref = read_col_ref(d);
        d.join_left_col = sp_add(d, left_ref);
        // Expect =
        if d.tk_type == 4 { if d.tk_val == "=" { next_token(d); } }
        let right_ref = read_col_ref(d);
        d.join_right_col = sp_add(d, right_ref);
    }

    if tk_is_kw(d, "WHERE") == 1 { parse_where(d); }
    if tk_is_kw(d, "GROUP") == 1 { parse_group_by(d); }
    if tk_is_kw(d, "HAVING") == 1 { parse_having(d); }
    if tk_is_kw(d, "ORDER") == 1 { parse_order_by(d); }
    if tk_is_kw(d, "LIMIT") == 1 { parse_limit(d); }
    if tk_is_kw(d, "OFFSET") == 1 { parse_offset(d); }

    // Fail-closed: a finished SELECT parse must leave the cursor at end of
    // input, at a trailing ';', or at a UNION keyword. A UNION hands the rest of
    // the token stream to exec_select_union, which re-enters this function per
    // branch, so this same check fails a stray token after the final branch
    // closed too. Any other leftover is unconsumed input -- a clause we do not
    // parse, or garbage after LIMIT/WHERE -- and running the query anyway would
    // silently drop it and return a plausible wrong answer.
    if tk_is_punct(d, ";") == 1 { next_token(d); }
    if d.tk_type != 7 {
        if tk_is_kw(d, "UNION") == 0 {
            println!("Error: unexpected trailing input near '{}'", d.tk_val);
            process_exit(1);
        }
    }
}

fn parse_insert(d: &mut DB) ~ Console + Process {
    d.stmt_type = 1;
    next_token(d);
    expect_kw(d, "INTO");
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);

    // Optional column list before VALUES
    if tk_is_punct(d, "(") == 1 {
        if tk_is_kw(d, "VALUES") == 0 {
            // This is a column list, not VALUES
            next_token(d);
            let mut go = true;
            while go {
                let cname = d.tk_val;
                let cid = sp_add(d, cname);
                vec_push(d.p_cols, cid);
                d.p_col_count = d.p_col_count + 1;
                next_token(d);
                if tk_is_punct(d, ",") == 1 { next_token(d); }
                else { go = false; }
            }
            expect_punct(d, ")");
        }
    }

    expect_kw(d, "VALUES");
    // One or more parenthesized value tuples: (..),(..),..
    // All tuples flow into d.p_vals; d.p_row_count records how many tuples.
    let mut rowcnt = 0;
    let mut rgo = true;
    while rgo {
        expect_punct(d, "(");
        let mut vgo = true;
        while vgo {
            // Unquoted NULL keyword stores SQL NULL (empty cell); quoted 'NULL' is text.
            let vtext = if d.tk_type == 0 && d.tk_val == "NULL" { "" } else { d.tk_val };
            let vid = sp_add(d, vtext);
            vec_push(d.p_vals, vid);
            d.p_val_count = d.p_val_count + 1;
            next_token(d);
            if tk_is_punct(d, ",") == 1 { next_token(d); }
            else { vgo = false; }
        }
        expect_punct(d, ")");
        rowcnt = rowcnt + 1;
        if tk_is_punct(d, ",") == 1 { next_token(d); }
        else { rgo = false; }
    }
    d.p_row_count = rowcnt;
}

fn parse_create_table(d: &mut DB) ~ Console + Process {
    d.stmt_type = 2;
    // TABLE keyword already consumed by parse_sql
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);
    expect_punct(d, "(");
    let mut go = true;
    while go {
        let cname = d.tk_val;
        let cid = sp_add(d, cname);
        vec_push(d.p_cols, cid);
        d.p_col_count = d.p_col_count + 1;
        next_token(d);
        let ctype = d.tk_val;
        let tid = sp_add(d, ctype);
        vec_push(d.p_types, tid);
        next_token(d);
        // Skip optional PRIMARY KEY
        if tk_is_kw(d, "PRIMARY") == 1 {
            next_token(d);
            expect_kw(d, "KEY");
        }
        if tk_is_punct(d, ",") == 1 { next_token(d); }
        else { go = false; }
    }
    expect_punct(d, ")");
}

fn parse_create_index(d: &mut DB) ~ Console + Process {
    d.stmt_type = 6;
    // INDEX keyword already consumed by parse_sql
    let iname = d.tk_val;
    d.idx_name = sp_add(d, iname);
    next_token(d);
    expect_kw(d, "ON");
    let tname = d.tk_val;
    d.idx_table_name = sp_add(d, tname);
    next_token(d);
    expect_punct(d, "(");
    let cname = d.tk_val;
    d.idx_col_name = sp_add(d, cname);
    next_token(d);
    expect_punct(d, ")");
}

fn parse_group_by(d: &mut DB) ~ Console + Process {
    next_token(d);
    expect_kw(d, "BY");
    d.has_group_by = 1;
    let cref = read_col_ref(d);
    d.group_col = sp_add(d, cref);
}

// Parse HAVING clause: HAVING agg_func(col) op value
// e.g. HAVING COUNT(*) > 2
fn parse_having(d: &mut DB) ~ Console + Process {
    next_token(d);
    d.has_having = 1;
    // Parse aggregate function
    let agg = is_agg_kw(d.tk_val);
    d.having_agg_func = agg;
    next_token(d);
    expect_punct(d, "(");
    if d.tk_type == 6 {
        // COUNT(*)
        let star_id = sp_add(d, "*");
        d.having_agg_col = star_id;
        next_token(d);
    } else {
        let col_ref = read_col_ref(d);
        d.having_agg_col = sp_add(d, col_ref);
    }
    expect_punct(d, ")");
    // Parse operator. op_encode returns -1 for any token that is not one of
    // = < > <= >= <> !=. eval_where treats -1 as always-false, so a HAVING with
    // an arithmetic or stray operator (COUNT(*) + 0 > 1, SUM(salary) % 2 = 0)
    // dropped every group and returned an empty result with exit 0: a silent
    // wrong answer, the same class Fork 12 closed for WHERE. Fail closed here.
    let op = d.tk_val;
    d.having_op = op_encode(op);
    if d.having_op < 0 {
        println!("Error: unsupported operator in HAVING: {}", op);
        process_exit(1);
    }
    next_token(d);
    // A doubled operator (COUNT(*) == 1) is two tokens: the first parsed as a
    // valid op above, the second now sits in the value position as an operator
    // token (type 4). Reading it as the value compared the aggregate against a
    // symbol it never equals, again silently empty. Reject it.
    if d.tk_type == 4 {
        println!("Error: expected a value after operator in HAVING, got '{}'", d.tk_val);
        process_exit(1);
    }
    // Parse value
    let val = d.tk_val;
    d.having_val = sp_add(d, val);
    next_token(d);
}

fn parse_update(d: &mut DB) ~ Console + Process {
    d.stmt_type = 3;
    next_token(d);
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);
    expect_kw(d, "SET");
    let cname = d.tk_val;
    d.set_col = sp_add(d, cname);
    next_token(d);
    if d.tk_type == 4 { if d.tk_val == "=" { next_token(d); } }
    let vtext = d.tk_val;
    d.set_val = sp_add(d, vtext);
    next_token(d);
    // Optional arithmetic RHS: SET col = <vtext> <op> <operand>. Match the
    // operator by VALUE, not token type: '*' tokenizes as the star token
    // (type 6) while '+' '-' '/' are operator tokens (type 4), so a type-only
    // guard silently misses '*', leaving it in the stream. A stray '*' then
    // drops the WHERE clause below and overwrites every row, so match all four
    // uniformly on tk_val.
    let p = d.tk_val;
    let mut opc = 0 - 1;
    if p == "+" { opc = 0; }
    else if p == "-" { opc = 1; }
    else if p == "*" { opc = 2; }
    else if p == "/" { opc = 3; }
    if opc >= 0 {
        d.set_op = opc;
        next_token(d);
        d.set_operand = sp_add(d, d.tk_val);
        next_token(d);
    }
    // Fail-closed: after the SET value (and its optional arithmetic tail), the
    // only legal continuations are WHERE, a ';' terminator, or end of input.
    // Any other leftover token means we failed to parse part of the SET clause;
    // proceeding would silently drop the WHERE clause and rewrite the whole
    // table, so abort before exec runs any mutation.
    if tk_is_kw(d, "WHERE") == 1 {
        parse_where(d);
    } else if d.tk_type == 7 {
        // end of input: whole-table UPDATE, no WHERE
    } else if tk_is_punct(d, ";") == 1 {
        // ';' terminator: also a whole-table UPDATE
    } else {
        println!("Error: unexpected token '{}' after UPDATE SET value", d.tk_val);
        process_exit(1);
    }
}

fn parse_delete(d: &mut DB) ~ Console + Process {
    d.stmt_type = 4;
    next_token(d);
    expect_kw(d, "FROM");
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);
    if tk_is_kw(d, "WHERE") == 1 { parse_where(d); }
}

fn parse_drop(d: &mut DB) ~ Console + Process {
    d.stmt_type = 5;
    next_token(d);
    expect_kw(d, "TABLE");
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);
}

// Append one non-IN condition to the DNF list under group `grp`.
// wc_in_start = -1 / wc_in_len = 0 mark it as not an IN condition.
// Append one leaf condition and return its index (its position in the wc_*
// arrays). The parser wraps that index in a tree leaf node via wn_leaf.
fn wc_push(d: &mut DB, left_id: i32, op: i32, right_id: i32, neg: i32) -> i32 {
    let ci = d.wc_count;
    vec_push(d.wc_left, left_id);
    vec_push(d.wc_op, op);
    vec_push(d.wc_right, right_id);
    vec_push(d.wc_neg, neg);
    vec_push(d.wc_in_start, -1);
    vec_push(d.wc_in_len, 0);
    d.wc_count = d.wc_count + 1;
    ci
}

// Append one IN condition (op 7) and return its index. Its value list is copied
// into the shared wc_in_pool; the slice is recorded via wc_in_start / wc_in_len
// (buildlang has no Vec<Vec<i32>>, so every IN list shares one flat pool).
fn wc_push_in(d: &mut DB, left_id: i32, neg: i32, vals: Vec<i32>, vcount: i32) -> i32 {
    let ci = d.wc_count;
    let mut start = 0;
    start = vec_len(d.wc_in_pool);
    let mut i = 0;
    while i < vcount {
        vec_push(d.wc_in_pool, vec_get(vals, i));
        i = i + 1;
    }
    vec_push(d.wc_left, left_id);
    vec_push(d.wc_op, 7);
    vec_push(d.wc_right, -1);
    vec_push(d.wc_neg, neg);
    vec_push(d.wc_in_start, start);
    vec_push(d.wc_in_len, vcount);
    d.wc_count = d.wc_count + 1;
    ci
}

// Append one boolean-tree node and return its index. kind: 0=leaf, 1=AND,
// 2=OR, 3=NOT. For a leaf, a is the condition index and b is -1; for AND/OR,
// a and b are child node indices; for NOT, a is the one child and b is -1.
fn wn_push(d: &mut DB, kind: i32, a: i32, b: i32) -> i32 {
    let n = d.wn_count;
    vec_push(d.wn_kind, kind);
    vec_push(d.wn_a, a);
    vec_push(d.wn_b, b);
    d.wn_count = d.wn_count + 1;
    n
}

// Wrap a leaf condition index in a tree leaf node.
fn wn_leaf(d: &mut DB, ci: i32) -> i32 {
    wn_push(d, 0, ci, -1)
}

// Parse one leaf WHERE predicate and return its tree-node index. A leading NOT
// is handled by parse_not_expr; this reads the infix NOT (col NOT IN / NOT LIKE
// / NOT BETWEEN) that binds to a single predicate. Comparison ops, LIKE,
// IN (value-list or SELECT subquery), IS [NOT] NULL, and scalar subqueries each
// become one leaf. BETWEEN expands to a real subtree: AND(>=lo,<=hi), or when
// negated OR(<lo,>hi), so the compound case is exact rather than an honest null.
fn parse_condition(d: &mut DB) -> i32 ~ Console + Process {
    let mut neg = 0;
    let lref = read_col_ref(d);
    let left_id = sp_add(d, lref);
    // Infix NOT: col NOT IN (...) / col NOT LIKE 'pat' / col NOT BETWEEN lo AND hi
    if tk_is_kw(d, "NOT") == 1 {
        neg = 1;
        next_token(d);
    }

    // LIKE
    if tk_is_kw(d, "LIKE") == 1 {
        next_token(d);
        let pattern = d.tk_val;
        let pat_id = sp_add(d, pattern);
        next_token(d);
        let ci = wc_push(d, left_id, 6, pat_id, neg);
        return wn_leaf(d, ci);
    }

    // IN (value-list or SELECT subquery)
    if tk_is_kw(d, "IN") == 1 {
        next_token(d);
        expect_punct(d, "(");
        if tk_is_kw(d, "SELECT") == 1 {
            // Run the subquery and take its full first-column result set as the
            // IN-list. subq_vals survives the subquery's own state restore.
            parse_and_exec_subquery(d);
            let mut sv: Vec<i32> = vec![];
            let mut svc = 0;
            let mut svi = 0;
            while svi < d.subq_count {
                vec_push(sv, vec_get(d.subq_vals, svi));
                svc = svc + 1;
                svi = svi + 1;
            }
            expect_punct(d, ")");
            let ci = wc_push_in(d, left_id, neg, sv, svc);
            return wn_leaf(d, ci);
        } else {
            let mut vals: Vec<i32> = vec![];
            let mut vcount = 0;
            let mut go = true;
            while go {
                let vtext = d.tk_val;
                let vid = sp_add(d, vtext);
                vec_push(vals, vid);
                vcount = vcount + 1;
                next_token(d);
                if tk_is_punct(d, ",") == 1 { next_token(d); }
                else { go = false; }
            }
            expect_punct(d, ")");
            let ci = wc_push_in(d, left_id, neg, vals, vcount);
            return wn_leaf(d, ci);
        }
    }

    // BETWEEN: col BETWEEN lo AND hi. Positive -> AND(col>=lo, col<=hi).
    // Negated (NOT BETWEEN) -> OR(col<lo, col>hi). Both are real subtrees, so
    // the result is exact even inside a larger AND/OR expression.
    if tk_is_kw(d, "BETWEEN") == 1 {
        next_token(d);
        let lo_val = d.tk_val;
        let lo_id = sp_add(d, lo_val);
        next_token(d);
        expect_kw(d, "AND");
        let hi_val = d.tk_val;
        let hi_id = sp_add(d, hi_val);
        next_token(d);
        if neg == 1 {
            let a = wc_push(d, left_id, 1, lo_id, 0);
            let b = wc_push(d, left_id, 2, hi_id, 0);
            let la = wn_leaf(d, a);
            let lb = wn_leaf(d, b);
            return wn_push(d, 2, la, lb);
        } else {
            let a = wc_push(d, left_id, 4, lo_id, 0);
            let b = wc_push(d, left_id, 3, hi_id, 0);
            let la = wn_leaf(d, a);
            let lb = wn_leaf(d, b);
            return wn_push(d, 1, la, lb);
        }
    }

    // IS NULL / IS NOT NULL
    if tk_is_kw(d, "IS") == 1 {
        next_token(d);
        if tk_is_kw(d, "NOT") == 1 {
            next_token(d);
            expect_kw(d, "NULL");
            let ci = wc_push(d, left_id, 9, -1, neg);
            return wn_leaf(d, ci);
        } else {
            expect_kw(d, "NULL");
            let ci = wc_push(d, left_id, 8, -1, neg);
            return wn_leaf(d, ci);
        }
    }

    // Normal operator: =, <, >, <=, >=, <>, !=
    let op = d.tk_val;
    let op_code = op_encode(op);
    // Fail closed on an unrecognized comparison operator. op_encode returns -1
    // for any token that is not one of = < > <= >= <> != . An arithmetic
    // operator (as in `salary + 10 > 100`) or a stray symbol like % lands here.
    // Before this guard the leaf was built with op -1, which eval_where treats
    // as always-false, so the query returned zero rows with no diagnostic, a
    // silent wrong answer.
    if op_code < 0 {
        println!("Error: unsupported operator '{}' in WHERE; arithmetic in a condition such as col + N is not supported", op);
        process_exit(1);
    }
    next_token(d);

    // Scalar subquery: op (SELECT ...)
    if tk_is_punct(d, "(") == 1 {
        next_token(d);
        if tk_is_kw(d, "SELECT") == 1 {
            let sub_result = parse_and_exec_subquery(d);
            let rid = sp_add(d, sub_result);
            expect_punct(d, ")");
            let ci = wc_push(d, left_id, op_code, rid, neg);
            return wn_leaf(d, ci);
        }
    }

    // Fail closed when the value position holds another operator token
    // (tk_type 4), which means a doubled operator such as the C-style `==`:
    // the first `=` parsed as the operator and the second `=` would otherwise
    // be taken as the literal value `"="`, comparing the column to a string it
    // never equals and returning zero rows silently. A negative number like -5
    // is one number token (type 3), so this does not misfire on `col > -5`.
    if d.tk_type == 4 {
        println!("Error: expected a value after operator '{}' in WHERE, got '{}' (use = not ==)", op, d.tk_val);
        process_exit(1);
    }

    // Plain value
    let rval = d.tk_val;
    let rid = sp_add(d, rval);
    next_token(d);
    let ci = wc_push(d, left_id, op_code, rid, neg);
    wn_leaf(d, ci)
}

// Recursive-descent boolean-expression parser over parse_condition leaves with
// real SQL precedence: OR lowest, then AND, then a NOT prefix, then a primary
// (a parenthesized subexpression or one condition). Each returns the root node
// index of the subtree it parsed, so parse_where can record a single wc_root.
fn parse_primary(d: &mut DB) -> i32 ~ Console + Process {
    if tk_is_punct(d, "(") == 1 {
        next_token(d);
        let n = parse_or_expr(d);
        expect_punct(d, ")");
        return n;
    }
    parse_condition(d)
}

fn parse_not_expr(d: &mut DB) -> i32 ~ Console + Process {
    if tk_is_kw(d, "NOT") == 1 {
        next_token(d);
        let child = parse_primary(d);
        return wn_push(d, 3, child, -1);
    }
    parse_primary(d)
}

fn parse_and_expr(d: &mut DB) -> i32 ~ Console + Process {
    let mut left = parse_not_expr(d);
    while tk_is_kw(d, "AND") == 1 {
        next_token(d);
        let right = parse_not_expr(d);
        left = wn_push(d, 1, left, right);
    }
    left
}

fn parse_or_expr(d: &mut DB) -> i32 ~ Console + Process {
    let mut left = parse_and_expr(d);
    while tk_is_kw(d, "OR") == 1 {
        next_token(d);
        let right = parse_and_expr(d);
        left = wn_push(d, 2, left, right);
    }
    left
}

// Parse the full WHERE clause into a boolean-expression tree rooted at wc_root.
fn parse_where(d: &mut DB) ~ Console + Process {
    next_token(d);
    d.has_where = 1;
    let root = parse_or_expr(d);
    d.wc_root = root;
}

// ALTER TABLE tname ADD COLUMN cname TYPE
fn parse_alter_table(d: &mut DB) ~ Console + Process {
    d.stmt_type = 10;
    next_token(d);
    expect_kw(d, "TABLE");
    let tname = d.tk_val;
    d.p_table = sp_add(d, tname);
    next_token(d);
    expect_kw(d, "ADD");
    // COLUMN keyword is optional
    if tk_is_kw(d, "COLUMN") == 1 { next_token(d); }
    let cname = d.tk_val;
    d.alter_col_name = sp_add(d, cname);
    next_token(d);
    let ctype = d.tk_val;
    d.alter_col_type = sp_add(d, ctype);
    next_token(d);
}

// Parse and immediately execute a scalar subquery.
// The parser is currently pointing at the SELECT keyword inside "( SELECT ... )".
// We save parser state, run the subquery, restore state, and return the scalar result.
// Parse and execute a scalar subquery found inside a WHERE clause.
// Example: WHERE age > (SELECT AVG(age) FROM users)
//
// Saves all current parser state (input, pos, token, stmt_type, etc.),
// collects the subquery SQL text by scanning tokens until the closing ')',
// executes it via exec_subquery_scalar (which captures stdout), then
// restores the original parser state so the outer query can continue.
//
// Returns: the scalar result string from the subquery.
fn parse_and_exec_subquery(d: &mut DB) -> String ~ Console + Process {
    // Capture the rest of the input from current position up to the matching ')'
    // The SELECT keyword has been recognized but not consumed yet.
    // We need to grab everything from d.pos (which is past SELECT keyword) up to
    // the closing ')'. But tk_val is "SELECT" and pos has advanced past it.
    // We need to collect the full subquery text.
    let sub_start = d.pos;
    // We know tk_val == "SELECT", so the subquery starts a bit before pos.
    // Find the SELECT keyword start: it's pos - 6 (length of "SELECT")
    // Actually, the tokenizer advanced pos past SELECT. Let's find the closing paren.
    let mut depth = 1;
    let mut scan_pos = d.pos;
    let mut sgo = true;
    while sgo {
        if scan_pos >= d.ilen { sgo = false; }
        else {
            let sc = d.input.char_at(scan_pos);
            if sc == "(" { depth = depth + 1; }
            if sc == ")" {
                depth = depth - 1;
                if depth == 0 { sgo = false; }
                else { scan_pos = scan_pos + 1; }
            } else {
                scan_pos = scan_pos + 1;
            }
        }
    }
    // The subquery SQL is "SELECT" + input[sub_start..scan_pos]
    let rest_len = scan_pos - sub_start;
    let rest_part = if rest_len > 0 { d.input.substring(sub_start, rest_len) } else { "" };
    let sub_sql = "SELECT" + rest_part;

    // Advance main parser past the closing ')'
    // Set pos to scan_pos (pointing at ')'), then call next_token to consume it
    d.pos = scan_pos;
    // The ')' will be consumed by the caller via expect_punct

    // Save main parser state
    let save_input = d.input;
    let save_ilen = d.ilen;
    let save_pos = d.pos;
    let save_tk_type = d.tk_type;
    let save_tk_val = d.tk_val;
    let save_stmt_type = d.stmt_type;
    let save_p_table = d.p_table;
    let save_p_cols = d.p_cols;
    let save_p_col_count = d.p_col_count;
    let save_p_types = d.p_types;
    let save_p_vals = d.p_vals;
    let save_p_val_count = d.p_val_count;
    let save_has_where = d.has_where;
    let save_wc_count = d.wc_count;
    let save_wc_left = d.wc_left;
    let save_wc_op = d.wc_op;
    let save_wc_right = d.wc_right;
    let save_wc_neg = d.wc_neg;
    let save_wn_kind = d.wn_kind;
    let save_wn_a = d.wn_a;
    let save_wn_b = d.wn_b;
    let save_wn_count = d.wn_count;
    let save_wc_root = d.wc_root;
    let save_wc_in_start = d.wc_in_start;
    let save_wc_in_len = d.wc_in_len;
    let save_wc_in_pool = d.wc_in_pool;
    let save_has_order = d.has_order;
    let save_order_col = d.order_col;
    let save_order_desc = d.order_desc;
    let save_order_col2 = d.order_col2;
    let save_order_desc2 = d.order_desc2;
    let save_order_agg_func = d.order_agg_func;
    let save_has_limit = d.has_limit;
    let save_limit_val = d.limit_val;
    let save_has_offset = d.has_offset;
    let save_offset_val = d.offset_val;
    let save_set_col = d.set_col;
    let save_set_val = d.set_val;
    let save_select_star = d.select_star;
    let save_p_agg_funcs = d.p_agg_funcs;
    let save_p_agg_cols = d.p_agg_cols;
    let save_p_agg_count = d.p_agg_count;
    let save_has_group_by = d.has_group_by;
    let save_group_col = d.group_col;
    let save_has_join = d.has_join;
    let save_join_table = d.join_table;
    let save_join_left_col = d.join_left_col;
    let save_join_right_col = d.join_right_col;
    let save_alias1 = d.alias1;
    let save_alias2 = d.alias2;
    let save_has_distinct = d.has_distinct;
    let save_has_having = d.has_having;
    let save_having_agg_func = d.having_agg_func;
    let save_having_agg_col = d.having_agg_col;
    let save_having_op = d.having_op;
    let save_having_val = d.having_val;
    let save_p_aliases = d.p_aliases;
    let save_p_agg_distinct = d.p_agg_distinct;

    // Execute the subquery to get a scalar result
    let result = exec_subquery_scalar(d, sub_sql);

    // Restore main parser state
    d.input = save_input;
    d.ilen = save_ilen;
    d.pos = save_pos;
    d.tk_type = save_tk_type;
    d.tk_val = save_tk_val;
    d.stmt_type = save_stmt_type;
    d.p_table = save_p_table;
    d.p_cols = save_p_cols;
    d.p_col_count = save_p_col_count;
    d.p_types = save_p_types;
    d.p_vals = save_p_vals;
    d.p_val_count = save_p_val_count;
    d.has_where = save_has_where;
    d.wc_count = save_wc_count;
    d.wc_left = save_wc_left;
    d.wc_op = save_wc_op;
    d.wc_right = save_wc_right;
    d.wc_neg = save_wc_neg;
    d.wn_kind = save_wn_kind;
    d.wn_a = save_wn_a;
    d.wn_b = save_wn_b;
    d.wn_count = save_wn_count;
    d.wc_root = save_wc_root;
    d.wc_in_start = save_wc_in_start;
    d.wc_in_len = save_wc_in_len;
    d.wc_in_pool = save_wc_in_pool;
    d.has_order = save_has_order;
    d.order_col = save_order_col;
    d.order_desc = save_order_desc;
    d.order_col2 = save_order_col2;
    d.order_desc2 = save_order_desc2;
    d.order_agg_func = save_order_agg_func;
    d.has_limit = save_has_limit;
    d.limit_val = save_limit_val;
    d.has_offset = save_has_offset;
    d.offset_val = save_offset_val;
    d.set_col = save_set_col;
    d.set_val = save_set_val;
    d.select_star = save_select_star;
    d.p_agg_funcs = save_p_agg_funcs;
    d.p_agg_cols = save_p_agg_cols;
    d.p_agg_count = save_p_agg_count;
    d.has_group_by = save_has_group_by;
    d.group_col = save_group_col;
    d.has_join = save_has_join;
    d.join_table = save_join_table;
    d.join_left_col = save_join_left_col;
    d.join_right_col = save_join_right_col;
    d.alias1 = save_alias1;
    d.alias2 = save_alias2;
    d.has_distinct = save_has_distinct;
    d.has_having = save_has_having;
    d.having_agg_func = save_having_agg_func;
    d.having_agg_col = save_having_agg_col;
    d.having_op = save_having_op;
    d.having_val = save_having_val;
    d.p_aliases = save_p_aliases;
    d.p_agg_distinct = save_p_agg_distinct;

    // Advance the token past ')'
    next_token(d);

    result
}

// Execute a subquery and return a single scalar value as a string.
// Handles aggregate queries like SELECT AVG(age) FROM users.
fn exec_subquery_scalar(d: &mut DB, sql: String) -> String ~ Console + Process {
    reset_parser(d, sql);
    parse_sql(d);

    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 { return "0"; }

    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // A subquery cannot abort just itself and let the outer query continue with
    // a correct value, so an unknown WHERE column fails the whole statement.
    if !where_cols_ok(d, cs, cc, tname, d.alias1) { process_exit(1); }
    // Same for an aggregate over an unknown column: without this the aggregate
    // read zero cells and fed 0 into the outer comparison, matching every row.
    if !agg_cols_ok(d, cs, cc, tname, d.alias1) { process_exit(1); }

    // Gather matching rows
    let mut match_rows: Vec<i32> = vec![];
    let mut match_count = 0;
    let mut r = 0;
    while r < rc {
        if eval_compound_where(d, cs, cc, rs, r, tname, d.alias1) {
            vec_push(match_rows, r);
            match_count = match_count + 1;
        }
        r = r + 1;
    }

    // If it is an aggregate query, compute and return the scalar
    if d.p_agg_count > 0 {
        if d.p_col_count == 0 {
            let af = vec_get(d.p_agg_funcs, 0);
            let ac_name = sp_get(d, vec_get(d.p_agg_cols, 0));
            if af == 1 {
                // COUNT(*)
                let cstr = int_to_str(match_count);
                vec_push(d.subq_vals, sp_add(d, cstr));
                d.subq_count = 1;
                return cstr;
            }
            // SUM/AVG/MIN/MAX
            let col_idx = resolve_col(d, cs, cc, tname, d.alias1, ac_name);
            let ct = if col_idx >= 0 { vec_get(d.col_types, cs + col_idx) } else { 0 };
            let mut sum_val = 0.0;
            let mut min_val = 999999999.0;
            let mut max_val = 0.0 - 999999999.0;
            // MIN/MAX on a TEXT column (type 2) order lexicographically via
            // compare_vals; parse_float coerces text to 0 and collapses them.
            let mut min_str = "";
            let mut max_str = "";
            let mut cnt = 0;
            let mut mi = 0;
            while mi < match_count {
                let row = vec_get(match_rows, mi);
                if col_idx >= 0 {
                    let cell_str = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
                    let nv = cell_str.parse_float();
                    sum_val = sum_val + nv;
                    if nv < min_val { min_val = nv; }
                    if nv > max_val { max_val = nv; }
                    if ct == 2 {
                        if cnt == 0 { min_str = cell_str; max_str = cell_str; }
                        else {
                            if compare_vals(cell_str, min_str, ct) < 0 { min_str = cell_str; }
                            if compare_vals(cell_str, max_str, ct) > 0 { max_str = cell_str; }
                        }
                    }
                    cnt = cnt + 1;
                }
                mi = mi + 1;
            }
            let mut result_val = sum_val;
            if af == 3 {
                if cnt > 0 { result_val = sum_val / cnt; }
                else { result_val = 0.0; }
            }
            if af == 4 { result_val = min_val; }
            if af == 5 { result_val = max_val; }
            let mut rstr = float_to_str(result_val);
            if ct == 2 && af == 4 { rstr = min_str; }
            if ct == 2 && af == 5 { rstr = max_str; }
            // MIN/MAX over zero matching rows is SQL NULL (rendered empty), not
            // the numeric sentinel. COUNT stays 0; SUM/AVG keep their 0 result.
            if cnt == 0 && (af == 4 || af == 5) { rstr = ""; }
            vec_push(d.subq_vals, sp_add(d, rstr));
            d.subq_count = 1;
            return rstr;
        }
    }

    // Non-aggregate: collect the first result column across every matching row
    // into d.subq_vals (so IN (SELECT ...) sees the whole set), and return the
    // first value as the scalar contract.
    let mut result_col = 0 - 1;
    if d.p_col_count > 0 {
        let cname = sp_get(d, vec_get(d.p_cols, 0));
        result_col = resolve_col(d, cs, cc, tname, d.alias1, cname);
    } else if d.select_star == 1 {
        result_col = 0;
    }
    if result_col >= 0 {
        let mut mi = 0;
        while mi < match_count {
            let row = vec_get(match_rows, mi);
            let cid = vec_get(d.cells, rs + row * cc + result_col);
            vec_push(d.subq_vals, cid);
            d.subq_count = d.subq_count + 1;
            mi = mi + 1;
        }
    }
    if d.subq_count > 0 {
        return sp_get(d, vec_get(d.subq_vals, 0));
    }
    "0"
}

fn parse_order_by(d: &mut DB) ~ Console + Process {
    next_token(d);
    expect_kw(d, "BY");
    d.has_order = 1;
    // Primary key may be a plain column or an aggregate term (COUNT(*),
    // SUM(col), ...). An aggregate key is matched against an aggregate output
    // column in the grouped-select path; order_agg_func records which.
    let ag = is_agg_kw(d.tk_val);
    if ag > 0 {
        next_token(d);
        expect_punct(d, "(");
        if d.tk_type == 6 {
            let ostar_id = sp_add(d, "*");
            d.order_col = ostar_id;
            next_token(d);
        } else {
            let oagg_name = read_col_ref(d);
            d.order_col = sp_add(d, oagg_name);
        }
        expect_punct(d, ")");
        d.order_agg_func = ag;
    } else {
        // read_col_ref captures a dotted "table.col" ref whole; a bare column
        // reads as just the name. Taking only tk_val here dropped the ".col"
        // half of a qualified key (e.g. ORDER BY emp.name kept "emp"), which
        // the join sort needs to resolve the column.
        let cname = read_col_ref(d);
        d.order_col = sp_add(d, cname);
        d.order_agg_func = 0;
    }
    if tk_is_kw(d, "DESC") == 1 { d.order_desc = 1; next_token(d); }
    else if tk_is_kw(d, "ASC") == 1 { d.order_desc = 0; next_token(d); }
    // Optional secondary key: ORDER BY a, b [ASC|DESC]. It breaks ties on the
    // primary key. A third comma-key is not stored (honest limitation). The
    // secondary key may itself be an aggregate term (ORDER BY x, SUM(col)); read
    // the whole term, parentheses included, so no '(col)' tail is left for the
    // end-of-input check to trip on. A secondary aggregate is reachable only on
    // the grouped paths, which reject a secondary key outright, so recording the
    // inner column name is enough to mark that a secondary key is present.
    if tk_is_punct(d, ",") == 1 {
        next_token(d);
        let ag2 = is_agg_kw(d.tk_val);
        if ag2 > 0 {
            next_token(d);
            expect_punct(d, "(");
            if d.tk_type == 6 {
                let ostar2 = sp_add(d, "*");
                d.order_col2 = ostar2;
                next_token(d);
            } else {
                let oagg2 = read_col_ref(d);
                d.order_col2 = sp_add(d, oagg2);
            }
            expect_punct(d, ")");
        } else {
            let cname2 = read_col_ref(d);
            d.order_col2 = sp_add(d, cname2);
        }
        if tk_is_kw(d, "DESC") == 1 { d.order_desc2 = 1; next_token(d); }
        else if tk_is_kw(d, "ASC") == 1 { d.order_desc2 = 0; next_token(d); }
    }
}

fn parse_limit(d: &mut DB) {
    next_token(d);
    d.has_limit = 1;
    let val = d.tk_val;
    d.limit_val = parse_int_str(val);
    next_token(d);
}

fn parse_offset(d: &mut DB) {
    next_token(d);
    d.has_offset = 1;
    let val = d.tk_val;
    d.offset_val = parse_int_str(val);
    next_token(d);
}

fn parse_int_str(s: String) -> i32 {
    let slen = s.len();
    let mut num = 0;
    let mut neg = false;
    let mut i = 0;
    if slen > 0 {
        let first = s.char_at(0);
        if first == "-" { neg = true; i = 1; }
    }
    while i < slen {
        let ch = s.char_at(i);
        if ch == "0" { num = num * 10; }
        else if ch == "1" { num = num * 10 + 1; }
        else if ch == "2" { num = num * 10 + 2; }
        else if ch == "3" { num = num * 10 + 3; }
        else if ch == "4" { num = num * 10 + 4; }
        else if ch == "5" { num = num * 10 + 5; }
        else if ch == "6" { num = num * 10 + 6; }
        else if ch == "7" { num = num * 10 + 7; }
        else if ch == "8" { num = num * 10 + 8; }
        else if ch == "9" { num = num * 10 + 9; }
        i = i + 1;
    }
    if neg { 0 - num } else { num }
}

// Resolve an ORDER BY key to a table column index in [0, cc), or -1 when it
// resolves to nothing. Three key forms are accepted so the non-grouped
// single-table SELECT path can fail closed instead of silently returning
// discovery order on an unresolvable key:
//   (a) a column name, bare or dotted (table.col)  -> resolve_col
//   (b) a positional ordinal (ORDER BY 2, SQL-92)  -> the Nth output column
//   (c) a projection alias (SELECT salary AS s ... ORDER BY s)
// A positional ordinal or alias only resolves when the referenced select item
// is a plain table column; one that points at an aggregate returns -1, since
// this path never sorts by an aggregate value.
fn resolve_order_key(d: &DB, cs: i32, cc: i32, tname: String, key_id: i32) -> i32 {
    let key = sp_get(d, key_id);
    // (b) positional ordinal: a bare integer is the 1-based select-list slot.
    if is_int_str(key) {
        let n = parse_int_str(key);
        if n < 1 { return 0 - 1; }
        if d.select_star == 1 {
            // SELECT * projects every table column in order, so slot N is
            // table column N-1.
            if n <= cc { return n - 1; }
            return 0 - 1;
        }
        if n <= d.p_agg_count {
            let k = n - 1;
            if vec_get(d.p_agg_funcs, k) == 0 {
                let col_name = sp_get(d, vec_get(d.p_agg_cols, k));
                return resolve_col(d, cs, cc, tname, d.alias1, col_name);
            }
        }
        return 0 - 1;
    }
    // (a) a real column name (dotted or bare) takes precedence over an alias.
    let direct = resolve_col(d, cs, cc, tname, d.alias1, key);
    if direct >= 0 { return direct; }
    // (c) projection alias -> its underlying plain column.
    if d.select_star == 0 {
        let mut k = 0;
        while k < d.p_agg_count {
            let al = vec_get(d.p_aliases, k);
            if al >= 0 {
                if sp_get(d, al) == key {
                    if vec_get(d.p_agg_funcs, k) == 0 {
                        let col_name = sp_get(d, vec_get(d.p_agg_cols, k));
                        return resolve_col(d, cs, cc, tname, d.alias1, col_name);
                    }
                }
            }
            k = k + 1;
        }
    }
    0 - 1
}

// =========================================================================
// SECTION 6: EXECUTOR — Query Execution Engine
// =========================================================================
// Executes parsed SQL statements against the in-memory database.
// All exec_* functions read from the parser state fields (d.p_table,
// d.p_cols, d.has_where, etc.) and modify the data arrays (d.cells,
// d.tbl_row_counts, etc.) as needed.
//
// Subsections:
//   6a: DDL — exec_create (CREATE TABLE), exec_drop, exec_alter_table
//   6b: DML — exec_insert, exec_update, exec_delete
//   6c: SELECT — exec_select (basic single-table, dispatches to 6d/6e/6f)
//   6d: Aggregates without GROUP BY — exec_select_agg_no_group
//   6e: GROUP BY — exec_select_group
//   6f: JOIN — exec_select_join
// =========================================================================

// --- 6a: DDL Execution ---

// Execute CREATE TABLE. Adds a new table entry to the parallel arrays.
// Fails if a table with the same name already exists.
fn exec_create(d: &mut DB) ~ Console {
    let tname = sp_get(d, d.p_table);
    let existing = find_table(d, tname);
    if existing >= 0 {
        println!("Error: table '{}' already exists", tname);
        return;
    }
    let tid = sp_add(d, tname);
    vec_push(d.tbl_names, tid);
    let col_start = vec_len(d.col_names);
    vec_push(d.tbl_col_starts, col_start);
    vec_push(d.tbl_col_counts, d.p_col_count);
    vec_push(d.tbl_row_starts, vec_len(d.cells));
    vec_push(d.tbl_row_counts, 0);
    // Add columns
    let mut i = 0;
    while i < d.p_col_count {
        let cname = sp_get(d, vec_get(d.p_cols, i));
        let cnid = sp_add(d, cname);
        vec_push(d.col_names, cnid);
        let type_str = sp_get(d, vec_get(d.p_types, i));
        let type_up = type_str.to_uppercase();
        let ct = type_code_for(type_up);
        vec_push(d.col_types, ct);
        i = i + 1;
    }
    d.tbl_count = d.tbl_count + 1;
}

// --- 6b: DML Execution ---

// Execute INSERT INTO. Inserts a new row into the target table.
// Values are read from d.p_vals. The row is inserted at the correct
// position in the flat cells array (after existing rows for this table),
// and subsequent tables' row starts are shifted. Indexes are rebuilt.
fn exec_insert(d: &mut DB) ~ Console {
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cc = vec_get(d.tbl_col_counts, tidx);
    let cs = vec_get(d.tbl_col_starts, tidx);

    // Values per row: the named-column count when a column list was given,
    // otherwise the table's full column count. p_row_count tuples were parsed.
    let vpr = if d.p_col_count > 0 { d.p_col_count } else { cc };
    let nrows = d.p_row_count;
    if nrows < 1 {
        println!("Error: INSERT has no values");
        return;
    }
    if d.p_val_count != vpr * nrows {
        println!("Error: expected {} values, got {}", vpr * nrows, d.p_val_count);
        return;
    }

    // For a named-column INSERT, map each table column to the value slot that
    // fills it (src_for_col[c] = slot, or -1 to insert SQL NULL). Validate the
    // named columns exist before writing anything.
    let mut src_for_col: Vec<i32> = vec![];
    if d.p_col_count > 0 {
        let mut jv = 0;
        while jv < d.p_col_count {
            let jn = sp_get(d, vec_get(d.p_cols, jv));
            if find_col(d, cs, cc, jn) < 0 {
                println!("Error: no such column: {}", jn);
                return;
            }
            jv = jv + 1;
        }
        let mut c = 0;
        while c < cc {
            let cn = sp_get(d, vec_get(d.col_names, cs + c));
            let mut found = 0 - 1;
            let mut j = 0;
            while j < d.p_col_count {
                let jn = sp_get(d, vec_get(d.p_cols, j));
                if jn == cn { found = j; }
                j = j + 1;
            }
            vec_push(src_for_col, found);
            c = c + 1;
        }
    }

    // Materialize every new row in table-column order into row_cells.
    let mut row_cells: Vec<i32> = vec![];
    let mut r = 0;
    while r < nrows {
        let mut c2 = 0;
        while c2 < cc {
            let mut cell_id = 0;
            if d.p_col_count > 0 {
                let src = vec_get(src_for_col, c2);
                if src < 0 { cell_id = sp_add(d, ""); }
                else { cell_id = vec_get(d.p_vals, r * vpr + src); }
            } else {
                cell_id = vec_get(d.p_vals, r * cc + c2);
            }
            vec_push(row_cells, cell_id);
            c2 = c2 + 1;
        }
        r = r + 1;
    }

    // Splice row_cells into the flat cells array after this table's rows.
    // When this table's rows end the array (the last table, the common load
    // case) the new cells are appended in place, O(row). Otherwise the array
    // is rebuilt around the insertion point, O(all cells), as before.
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);
    let insert_at = rs + rc * cc;
    let added = nrows * cc;
    let total_cells = vec_len(d.cells);
    if insert_at == total_cells {
        let mut ai = 0;
        while ai < added {
            vec_push(d.cells, vec_get(row_cells, ai));
            ai = ai + 1;
        }
    } else {
        let mut new_cells: Vec<i32> = vec![];
        let mut ci: i64 = 0;
        while ci < insert_at {
            vec_push(new_cells, vec_get(d.cells, ci));
            ci = ci + 1;
        }
        let mut wi = 0;
        while wi < added {
            vec_push(new_cells, vec_get(row_cells, wi));
            wi = wi + 1;
        }
        while ci < total_cells {
            vec_push(new_cells, vec_get(d.cells, ci));
            ci = ci + 1;
        }
        d.cells = new_cells;
    }

    // Update row count for this table (all nrows added).
    let mut new_rc: Vec<i32> = vec![];
    let mut ri = 0;
    while ri < d.tbl_count {
        if ri == tidx { vec_push(new_rc, rc + nrows); }
        else { vec_push(new_rc, vec_get(d.tbl_row_counts, ri)); }
        ri = ri + 1;
    }
    d.tbl_row_counts = new_rc;

    // Shift row_starts for tables after this one by the cells we inserted.
    let mut new_rs: Vec<i32> = vec![];
    let mut si = 0;
    while si < d.tbl_count {
        if si > tidx {
            vec_push(new_rs, vec_get(d.tbl_row_starts, si) + added);
        } else {
            vec_push(new_rs, vec_get(d.tbl_row_starts, si));
        }
        si = si + 1;
    }
    d.tbl_row_starts = new_rs;

    // Indexes need no work here. The new rows carry the highest row ids, so
    // an index whose key count is below the table's row count is behind by
    // exactly those rows, and refresh_index folds them in on the next read.
}

// Resolve a column reference: could be "col", "table.col", or "alias.col"
// Returns the column index within the given table, or -1
fn resolve_col(d: &DB, cs: i32, cc: i32, tname: String, alias: i32, ref_str: String) -> i32 {
    let dot_pos = ref_str.index_of(".");
    if dot_pos > 0 {
        // Dotted: prefix.colname
        let prefix = ref_str.substring(0, dot_pos);
        let col_part = ref_str.substring(dot_pos + 1, ref_str.len() - dot_pos - 1);
        let alias_str = if alias >= 0 { sp_get(d, alias) } else { "" };
        if prefix == tname || prefix == alias_str {
            return find_col(d, cs, cc, col_part);
        }
        return 0 - 1;
    }
    find_col(d, cs, cc, ref_str)
}

// Fail closed when a WHERE clause names a column the target table does not
// have. Every leaf condition stores its left side as a column ref (see
// parse_condition -> read_col_ref), and resolve_col returns -1 for a ref that
// matches no column. Every single-table WHERE path below evaluated such a leaf
// as false, so `WHERE nosuchcol = 5` returned an empty result and
// `WHERE nosuchcol IS NULL` returned every row, both silent wrong answers.
// Validating once here, before the row scan, also covers an empty table, where
// no row would ever reach eval_cond_row. resolve_col is reused so a dotted
// table.col or alias.col ref resolves exactly as it does during evaluation.
// Returns false after printing the diagnostic; the caller aborts the statement.
fn where_cols_ok(d: &DB, cs: i32, cc: i32, tname: String, alias: i32) -> bool ~ Console {
    if d.has_where == 0 { return true; }
    let mut ci = 0;
    while ci < d.wc_count {
        let wl = sp_get(d, vec_get(d.wc_left, ci));
        if resolve_col(d, cs, cc, tname, alias, wl) < 0 {
            println!("Error: no such column: {}", wl);
            return false;
        }
        ci = ci + 1;
    }
    true
}

// Fail closed when an aggregate names a column the target table does not have.
// The projection's aggregate args live in p_agg_cols, parallel to p_agg_funcs;
// a plain column has func 0 (validated elsewhere) and COUNT(*) stores "*". For
// any real aggregate (func > 0) over a named column, resolve_col returns -1 for
// a name no column matches, and every compute site then read zero matching
// cells: SUM/AVG/COUNT(col) returned 0, MIN/MAX returned empty, a grouped
// aggregate returned 0 per group, and a scalar subquery fed 0 into the outer
// comparison, all silent wrong answers (SQLite errors "no such column"). A
// HAVING aggregate arg is checked the same way. Validating once here, before
// the scan, also covers an empty table. resolve_col is reused so a dotted or
// alias-qualified arg resolves exactly as it does during evaluation. Plain
// SELECT columns are out of scope: they keep their own "column not found" path.
fn agg_cols_ok(d: &DB, cs: i32, cc: i32, tname: String, alias: i32) -> bool ~ Console {
    let mut k = 0;
    while k < d.p_agg_count {
        if vec_get(d.p_agg_funcs, k) > 0 {
            let an = sp_get(d, vec_get(d.p_agg_cols, k));
            let is_star = an == "*";
            if !is_star {
                if resolve_col(d, cs, cc, tname, alias, an) < 0 {
                    println!("Error: no such column: {}", an);
                    return false;
                }
            }
        }
        k = k + 1;
    }
    if d.has_having == 1 {
        if d.having_agg_func > 0 {
            if d.having_agg_col >= 0 {
                let hn = sp_get(d, d.having_agg_col);
                let h_star = hn == "*";
                if !h_star {
                    if resolve_col(d, cs, cc, tname, alias, hn) < 0 {
                        println!("Error: no such column: {}", hn);
                        return false;
                    }
                }
            }
        }
    }
    true
}

// True if cell_val is in condition ci's IN-list (its slice of wc_in_pool).
fn eval_in_pool(d: &DB, cell_val: String, start: i32, len: i32) -> bool {
    let mut i = 0;
    while i < len {
        let v = sp_get(d, vec_get(d.wc_in_pool, start + i));
        if cell_val == v { return true; }
        i = i + 1;
    }
    false
}

// Evaluate condition ci's operator against an already-resolved cell value.
// op 7 = IN (against the condition's wc_in_pool slice); all other ops go
// through eval_where. Negation is applied by the caller.
fn eval_cond_val(d: &DB, ci: i32, op: i32, cv: String) -> bool {
    if op == 7 {
        return eval_in_pool(d, cv, vec_get(d.wc_in_start, ci), vec_get(d.wc_in_len, ci));
    }
    let wr = sp_get(d, vec_get(d.wc_right, ci));
    eval_where(cv, op, wr)
}

// Evaluate DNF condition ci for a single-table row, applying its negate flag.
fn eval_cond_row(d: &DB, ci: i32, cs: i32, cc: i32, rs: i32, row: i32,
                 tname: String, alias: i32) -> bool {
    let wl = sp_get(d, vec_get(d.wc_left, ci));
    let wcol = resolve_col(d, cs, cc, tname, alias, wl);
    let op = vec_get(d.wc_op, ci);
    let mut res = false;
    if wcol >= 0 {
        let cv = sp_get(d, vec_get(d.cells, rs + row * cc + wcol));
        res = eval_cond_val(d, ci, op, cv);
    } else {
        // Column not found — for IS NULL on missing cols, treat as NULL.
        if op == 8 { res = true; }
    }
    if vec_get(d.wc_neg, ci) == 1 { res = !res; }
    res
}

// Recursively evaluate the WHERE boolean-expression tree for a single-table
// row. node < 0 means "no predicate" (true). Leaf (kind 0) evaluates its
// condition via eval_cond_row; NOT (3) negates its one child; AND (1) / OR (2)
// combine both children.
fn eval_where_tree(d: &DB, node: i32, cs: i32, cc: i32, rs: i32, row: i32,
                   tname: String, alias: i32) -> bool {
    if node < 0 { return true; }
    let k = vec_get(d.wn_kind, node);
    if k == 0 {
        return eval_cond_row(d, vec_get(d.wn_a, node), cs, cc, rs, row, tname, alias);
    }
    if k == 3 {
        return !eval_where_tree(d, vec_get(d.wn_a, node), cs, cc, rs, row, tname, alias);
    }
    let la = eval_where_tree(d, vec_get(d.wn_a, node), cs, cc, rs, row, tname, alias);
    let rb = eval_where_tree(d, vec_get(d.wn_b, node), cs, cc, rs, row, tname, alias);
    if k == 1 { return la && rb; }
    if k == 2 { return la || rb; }
    true
}

// Evaluate the full WHERE clause for a single-table row by walking the
// boolean-expression tree from wc_root. has_where==0 or an empty tree means no
// filter. AND/OR/NOT and parenthesized grouping are all exact.
fn eval_compound_where(d: &DB, cs: i32, cc: i32, rs: i32, row: i32,
                       tname: String, alias: i32) -> bool {
    if d.has_where == 0 { return true; }
    if d.wc_count == 0 { return true; }
    eval_where_tree(d, d.wc_root, cs, cc, rs, row, tname, alias)
}

fn check_has_agg(d: &DB) -> i32 {
    let mut k = 0;
    while k < d.p_agg_count {
        if vec_get(d.p_agg_funcs, k) > 0 { return 1; }
        k = k + 1;
    }
    0
}

// --- 6c: SELECT — Single-Table Query ---

// Execute a SELECT query. This is the main SELECT dispatcher.
//
// Reads parsed state: d.p_table, d.select_star, d.p_cols, d.p_agg_funcs,
//   d.has_where, d.wc_* (DNF filter conditions), d.has_order / d.order_col /
//   d.order_desc, d.has_limit / d.limit_val, d.has_distinct
//
// Flow:
//   1. Dispatch to exec_select_join if has_join == 1
//   2. Dispatch to exec_select_group if has_group_by == 1
//   3. Handle COUNT(*) shortcut
//   4. Dispatch to exec_select_agg_no_group if aggregates present
//   5. Otherwise: scan all rows, evaluate WHERE for each, collect matches
//   6. Apply ORDER BY via sort_rows() (selection sort)
//   7. Apply LIMIT to truncate result set
//   8. Apply DISTINCT to remove duplicates
//   9. Print formatted table output (header + separator + rows)
//
// Calls: eval_compound_where(), sort_rows(), resolve_col(), find_index_for(),
//        index_scan(), sp_get(), pad_right(), make_dashes()
fn exec_select(d: &mut DB) ~ Console + Process {
    // Dispatch to UNION handler. parse_select stops at a trailing UNION
    // keyword, leaving it as the current token; branch 1 is already parsed into
    // d.*, so hand the whole set to the union executor. This must precede the
    // JOIN/GROUP dispatch so a UNION whose first branch joins or groups is
    // rejected by the union path rather than rendered alone.
    if tk_is_kw(d, "UNION") == 1 { exec_select_union(d); return; }
    // Dispatch to JOIN handler
    if d.has_join == 1 { exec_select_join(d); return; }
    // Dispatch to GROUP BY handler
    if d.has_group_by == 1 { exec_select_group(d); return; }

    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // Reject an unknown WHERE column before any scan. This runs ahead of the
    // aggregate dispatch below, so exec_select_agg_no_group is covered too.
    if !where_cols_ok(d, cs, cc, tname, d.alias1) { return; }
    // Reject an aggregate over an unknown column before the aggregate dispatch,
    // so exec_select_agg_no_group cannot read zero cells and return a silent 0.
    if !agg_cols_ok(d, cs, cc, tname, d.alias1) { return; }

    // Check if we have any aggregate functions (mixed with columns) without GROUP BY
    // Handle aggregates: COUNT, SUM, AVG, MIN, MAX without GROUP BY
    // Aggregate check moved to dispatch:
    // If p_agg_count > 0 and p_col_count == 0, handle as aggregate
    if d.p_agg_count > 0 {
        if d.p_col_count == 0 {
            exec_select_agg_no_group(d, tidx);
            return;
        }
    }

    // Determine which columns to show
    let mut show_cols: Vec<i32> = vec![];
    let mut show_count = 0;
    if d.select_star == 1 {
        let mut ci = 0;
        while ci < cc {
            vec_push(show_cols, ci);
            show_count = show_count + 1;
            ci = ci + 1;
        }
    } else {
        let mut ci = 0;
        while ci < d.p_col_count {
            let cname = sp_get(d, vec_get(d.p_cols, ci));
            let idx = resolve_col(d, cs, cc, tname, d.alias1, cname);
            if idx < 0 {
                println!("Error: column '{}' not found", cname);
                return;
            }
            vec_push(show_cols, idx);
            show_count = show_count + 1;
            ci = ci + 1;
        }
    }

    // Filter rows (with compound WHERE and optional index acceleration)
    let mut match_rows: Vec<i32> = vec![];
    let mut match_count = 0;

    // Try index lookup for a single simple WHERE comparison on an indexed
    // column: the WHERE must be exactly one bare leaf (wc_count==1 AND
    // wn_count==1, so no NOT/AND/OR wrapper), not negated, with a comparison op
    // (0..5 — index_scan does equality by binary search and 1..5 by sorted
    // range). A NOT-wrapped leaf has wn_count>1 and must fall to the full scan,
    // as do LIKE / IN / IS NULL and any multi-condition WHERE.
    let mut used_index = false;
    if d.has_where == 1 {
        if d.wc_count == 1 {
            if d.wn_count == 1 {
                if vec_get(d.wc_neg, 0) == 0 {
                    let op0 = vec_get(d.wc_op, 0);
                    if op0 >= 0 {
                        if op0 <= 5 {
                            let wl = sp_get(d, vec_get(d.wc_left, 0));
                            let wcol = resolve_col(d, cs, cc, tname, d.alias1, wl);
                            if wcol >= 0 {
                                let ix_id = find_index_for(d, tidx, wcol);
                                if ix_id >= 0 {
                                    refresh_index(d, ix_id);
                                    let wr = sp_get(d, vec_get(d.wc_right, 0));
                                    match_rows = index_scan(d, ix_id, op0, wr);
                                    match_count = vec_len(match_rows);
                                    used_index = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if !used_index {
        let mut r = 0;
        while r < rc {
            if eval_compound_where(d, cs, cc, rs, r, tname, d.alias1) {
                vec_push(match_rows, r);
                match_count = match_count + 1;
            }
            r = r + 1;
        }
    }

    // ORDER BY. Resolve each key to a table column and FAIL CLOSED on an
    // unresolvable key rather than silently returning discovery order. A key
    // may be a column name, a positional ordinal, or a projection alias (see
    // resolve_order_key).
    if d.has_order == 1 {
        let ocol_idx = resolve_order_key(d, cs, cc, tname, d.order_col);
        if ocol_idx < 0 {
            println!("Error: ORDER BY must name a column, alias, or select position");
            process_exit(1);
        }
        let ocol_type = vec_get(d.col_types, cs + ocol_idx);
        let mut ocol2_idx = 0 - 1;
        let mut ocol2_type = 0;
        if d.order_col2 >= 0 {
            ocol2_idx = resolve_order_key(d, cs, cc, tname, d.order_col2);
            if ocol2_idx < 0 {
                println!("Error: ORDER BY must name a column, alias, or select position");
                process_exit(1);
            }
            ocol2_type = vec_get(d.col_types, cs + ocol2_idx);
        }
        match_rows = sort_rows(d, match_rows, match_count, rs, cc, ocol_idx, ocol_type, d.order_desc, ocol2_idx, ocol2_type, d.order_desc2);
    }

    // LIMIT / OFFSET
    if d.has_limit == 1 || d.has_offset == 1 {
        let mut off = 0;
        if d.has_offset == 1 { off = d.offset_val; }
        let mut lim = match_count;
        if d.has_limit == 1 { lim = d.limit_val; }
        let mut limited: Vec<i32> = vec![];
        let mut new_count = 0;
        let mut taken = 0;
        let mut li = off;
        let mut lgo = true;
        while lgo {
            if li >= match_count { lgo = false; }
            else if taken >= lim { lgo = false; }
            else {
                vec_push(limited, vec_get(match_rows, li));
                new_count = new_count + 1;
                taken = taken + 1;
                li = li + 1;
            }
        }
        match_rows = limited;
        match_count = new_count;
    }

    // DISTINCT: remove duplicate rows (compare all selected column values)
    if d.has_distinct == 1 {
        let mut deduped: Vec<i32> = vec![];
        let mut dedup_count = 0;
        let mut di = 0;
        let mut drow = 0;
        let mut dkey = "";
        let mut dci = 0;
        let mut dcol_idx = 0;
        let mut dval = "";
        let mut dup_found = false;
        let mut dj = 0;
        let mut erow = 0;
        let mut ekey = "";
        let mut eci = 0;
        let mut ecol_idx = 0;
        let mut eval2 = "";
        while di < match_count {
            drow = vec_get(match_rows, di);
            dkey = "";
            dci = 0;
            while dci < show_count {
                dcol_idx = vec_get(show_cols, dci);
                dval = sp_get(d, vec_get(d.cells, rs + drow * cc + dcol_idx));
                if dci > 0 { dkey = dkey + "|"; }
                dkey = dkey + dval;
                dci = dci + 1;
            }
            dup_found = false;
            dj = 0;
            while dj < dedup_count {
                erow = vec_get(deduped, dj);
                ekey = "";
                eci = 0;
                while eci < show_count {
                    ecol_idx = vec_get(show_cols, eci);
                    eval2 = sp_get(d, vec_get(d.cells, rs + erow * cc + ecol_idx));
                    if eci > 0 { ekey = ekey + "|"; }
                    ekey = ekey + eval2;
                    eci = eci + 1;
                }
                if dkey == ekey { dup_found = true; }
                dj = dj + 1;
            }
            if !dup_found {
                vec_push(deduped, drow);
                dedup_count = dedup_count + 1;
            }
            di = di + 1;
        }
        match_rows = deduped;
        match_count = dedup_count;
    }

    // Build header names (use alias if provided, else column name)
    let mut hdr_names: Vec<i32> = vec![];
    let mut hni = 0;
    let mut hn_col_idx = 0;
    let mut hn_base_hdr = "";
    let mut hn_use_alias = false;
    let mut hn_al = 0;
    let mut hn_hid = 0;
    while hni < show_count {
        hn_col_idx = vec_get(show_cols, hni);
        hn_base_hdr = sp_get(d, vec_get(d.col_names, cs + hn_col_idx));
        hn_use_alias = false;
        if d.select_star == 0 {
            if hni < d.p_agg_count {
                hn_al = vec_get(d.p_aliases, hni);
                if hn_al >= 0 {
                    vec_push(hdr_names, hn_al);
                    hn_use_alias = true;
                }
            }
        }
        if !hn_use_alias {
            hn_hid = sp_add(d, hn_base_hdr);
            vec_push(hdr_names, hn_hid);
        }
        hni = hni + 1;
    }

    // Calculate column widths
    let mut widths: Vec<i32> = vec![];
    let mut wi = 0;
    while wi < show_count {
        let col_idx = vec_get(show_cols, wi);
        let hdr = sp_get(d, vec_get(hdr_names, wi));
        let mut w = hdr.len();
        let mut ri = 0;
        while ri < match_count {
            let row = vec_get(match_rows, ri);
            let val = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
            let vlen = val.len();
            if vlen > w { w = vlen; }
            ri = ri + 1;
        }
        vec_push(widths, w);
        wi = wi + 1;
    }

    // Print header
    let mut hdr_line = "";
    let mut sep_line = "";
    let mut hi = 0;
    while hi < show_count {
        if hi > 0 { hdr_line = hdr_line + " | "; sep_line = sep_line + "-+-"; }
        let hdr = sp_get(d, vec_get(hdr_names, hi));
        let w = vec_get(widths, hi);
        hdr_line = hdr_line + pad_right(hdr, w);
        sep_line = sep_line + make_dashes(w);
        hi = hi + 1;
    }
    println!("{}", hdr_line);
    println!("{}", sep_line);

    // Print rows
    let mut ri = 0;
    while ri < match_count {
        let row = vec_get(match_rows, ri);
        let mut row_line = "";
        let mut ci = 0;
        while ci < show_count {
            if ci > 0 { row_line = row_line + " | "; }
            let col_idx = vec_get(show_cols, ci);
            let val = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
            let w = vec_get(widths, ci);
            let col_type = vec_get(d.col_types, cs + col_idx);
            if col_type == 0 || col_type == 1 {
                row_line = row_line + pad_left(val, w);
            } else {
                row_line = row_line + pad_right(val, w);
            }
            ci = ci + 1;
        }
        println!("{}", row_line);
        ri = ri + 1;
    }
}

// --- 6c-union: SELECT ... UNION [ALL] ... ---

// Index of the union output column whose header matches `name`, or -1. A
// trailing ORDER BY after a UNION names an output column (or its alias); a
// table qualifier (t.col) is stripped before matching, since union headers are
// stored bare.
fn union_header_index(d: &DB, name: String) -> i32 {
    let mut key = name;
    let dot_pos = name.index_of(".");
    if dot_pos > 0 {
        key = name.substring(dot_pos + 1, name.len() - dot_pos - 1);
    }
    let mut i = 0;
    while i < d.union_ncol {
        let h = sp_get(d, vec_get(d.union_headers, i));
        if h == key { return i; }
        i = i + 1;
    }
    0 - 1
}

// Resolve a UNION ORDER BY key to an output column position, or -1 if it names
// no output column. A bare integer is a 1-based positional ordinal (ORDER BY 2)
// -- the canonical way to order a union, since only the first branch's column
// names reach the output headers. Anything else is matched by header name.
fn resolve_union_order_key(d: &DB, key_id: i32) -> i32 {
    let key = sp_get(d, key_id);
    if is_int_str(key) {
        let n = parse_int_str(key);
        if n < 1 { return 0 - 1; }
        if n <= d.union_ncol { return n - 1; }
        return 0 - 1;
    }
    union_header_index(d, key)
}

// Compare two accumulator rows on a primary key, then a secondary on ties.
// Mirrors cmp_rows_2key but addresses the flat union_vals buffer (ncol wide),
// which has no per-table row-start offset.
fn cmp_union_rows(d: &DB, rowa: i32, rowb: i32, ncol: i32, k1: i32, k1_type: i32, desc: i32, k2: i32, k2_type: i32, desc2: i32) -> i64 {
    let va = sp_get(d, vec_get(d.union_vals, rowa * ncol + k1));
    let vb = sp_get(d, vec_get(d.union_vals, rowb * ncol + k1));
    let mut c = compare_vals(va, vb, k1_type);
    if desc == 1 { c = 0 - c; }
    if c < 0 { return c; }
    if c > 0 { return c; }
    if k2 >= 0 {
        let sa = sp_get(d, vec_get(d.union_vals, rowa * ncol + k2));
        let sb = sp_get(d, vec_get(d.union_vals, rowb * ncol + k2));
        let mut c2 = compare_vals(sa, sb, k2_type);
        if desc2 == 1 { c2 = 0 - c2; }
        return c2;
    }
    0
}

// Materialize the currently-parsed SELECT branch into the UNION accumulator.
// Only a basic single-table projection is supported: a branch that joins,
// groups, or aggregates cannot be laid out as flat cells here, so fail closed
// (print an error, emit nothing) rather than silently drop its rows. Returns 0
// on success, 1 on failure (the caller must abort the whole UNION).
fn gather_basic_branch(d: &mut DB) -> i32 ~ Console {
    if d.has_join == 1 {
        println!("Error: UNION does not support a JOIN in a branch");
        return 1;
    }
    if d.has_group_by == 1 {
        println!("Error: UNION does not support GROUP BY in a branch");
        return 1;
    }
    if check_has_agg(d) == 1 {
        println!("Error: UNION does not support aggregate functions in a branch");
        return 1;
    }

    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return 1;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // Columns this branch projects, in output order.
    let mut show_cols: Vec<i32> = vec![];
    let mut show_count = 0;
    if d.select_star == 1 {
        let mut ci = 0;
        while ci < cc {
            vec_push(show_cols, ci);
            show_count = show_count + 1;
            ci = ci + 1;
        }
    } else {
        let mut ci = 0;
        while ci < d.p_col_count {
            let cname = sp_get(d, vec_get(d.p_cols, ci));
            let idx = resolve_col(d, cs, cc, tname, d.alias1, cname);
            if idx < 0 {
                println!("Error: column '{}' not found", cname);
                return 1;
            }
            vec_push(show_cols, idx);
            show_count = show_count + 1;
            ci = ci + 1;
        }
    }

    // The first branch fixes the output shape: column count, header names
    // (alias wins over column name), and per-column type. Later branches must
    // match the column count — UNION pairs columns by position, not by name.
    if d.union_started == 0 {
        d.union_ncol = show_count;
        let mut hi = 0;
        while hi < show_count {
            let col_idx = vec_get(show_cols, hi);
            let mut hid = vec_get(d.col_names, cs + col_idx);
            if d.select_star == 0 {
                let al = vec_get(d.p_aliases, hi);
                if al >= 0 { hid = al; }
            }
            vec_push(d.union_headers, hid);
            vec_push(d.union_coltypes, vec_get(d.col_types, cs + col_idx));
            hi = hi + 1;
        }
        d.union_started = 1;
    } else {
        if show_count != d.union_ncol {
            println!("Error: UNION branches have different column counts");
            return 1;
        }
    }

    // Append each WHERE-matching row's projected cells (as string-pool ids) to
    // the accumulator. Full scan: union branches are small, and correctness
    // matters more than index acceleration here.
    let mut r = 0;
    while r < rc {
        if eval_compound_where(d, cs, cc, rs, r, tname, d.alias1) {
            let mut ci = 0;
            while ci < show_count {
                let col_idx = vec_get(show_cols, ci);
                vec_push(d.union_vals, vec_get(d.cells, rs + r * cc + col_idx));
                ci = ci + 1;
            }
            d.union_rows = d.union_rows + 1;
        }
        r = r + 1;
    }
    0
}

// Execute SELECT ... UNION [ALL] SELECT ... [UNION [ALL] SELECT ...].
//
// Branch 1 is already parsed into d.* (parse_select stopped at the UNION
// keyword). Each branch is validated and materialized into the accumulator by
// gather_basic_branch; then plain UNION removes duplicate rows across the whole
// result (UNION ALL keeps them), a trailing ORDER BY (which binds to the whole
// result and lands in the final branch's order fields) is applied, and the
// result renders once.
//
// Fail-closed limits: ORDER BY / LIMIT / OFFSET are honored only after the
// final branch (a non-final branch carrying them is rejected); LIMIT / OFFSET
// on a union is not supported; every branch must be a basic single-table
// projection with a matching column count.
fn exec_select_union(d: &mut DB) ~ Console + Process {
    let mut all_flag = 1;   // 1 while every branch seen so far is UNION ALL

    // Branch 1 is non-final: a UNION follows it. A per-branch ORDER BY / LIMIT /
    // OFFSET before UNION does not compose here, so reject it.
    if d.has_order == 1 || d.has_limit == 1 || d.has_offset == 1 {
        println!("Error: ORDER BY / LIMIT must follow the final UNION branch");
        return;
    }
    if gather_basic_branch(d) == 1 { return; }

    let mut go = true;
    while go {
        // Current token is UNION. Consume it and an optional ALL.
        next_token(d);
        if tk_is_kw(d, "ALL") == 1 {
            next_token(d);
        } else {
            all_flag = 0;
        }

        // Parse the next branch. reset_select_fields clears the previous
        // branch's parse without moving the tokenizer or clearing the
        // accumulator.
        reset_select_fields(d);
        if tk_is_kw(d, "SELECT") == 0 {
            println!("Error: expected SELECT after UNION, got '{}'", d.tk_val);
            return;
        }
        parse_select(d);

        // This is the final branch iff no further UNION follows.
        let mut is_final = 0;
        if tk_is_kw(d, "UNION") == 0 { is_final = 1; }
        if is_final == 1 {
            if d.has_limit == 1 || d.has_offset == 1 {
                println!("Error: LIMIT / OFFSET is not supported on a UNION");
                return;
            }
        } else {
            if d.has_order == 1 || d.has_limit == 1 || d.has_offset == 1 {
                println!("Error: ORDER BY / LIMIT must follow the final UNION branch");
                return;
            }
        }

        if gather_basic_branch(d) == 1 { return; }
        if is_final == 1 { go = false; }
    }

    let ncol = d.union_ncol;

    // Surviving row indices. UNION ALL keeps every row; plain UNION drops a row
    // whose full projection equals an earlier kept row.
    let mut keep: Vec<i32> = vec![];
    let mut keep_count = 0;
    if all_flag == 1 {
        let mut r = 0;
        while r < d.union_rows {
            vec_push(keep, r);
            keep_count = keep_count + 1;
            r = r + 1;
        }
    } else {
        let mut r = 0;
        while r < d.union_rows {
            let mut rkey = "";
            let mut ci = 0;
            while ci < ncol {
                let v = sp_get(d, vec_get(d.union_vals, r * ncol + ci));
                if ci > 0 { rkey = rkey + "|"; }
                rkey = rkey + v;
                ci = ci + 1;
            }
            let mut dup = false;
            let mut kj = 0;
            while kj < keep_count {
                let kr = vec_get(keep, kj);
                let mut ekey = "";
                let mut eci = 0;
                while eci < ncol {
                    let ev = sp_get(d, vec_get(d.union_vals, kr * ncol + eci));
                    if eci > 0 { ekey = ekey + "|"; }
                    ekey = ekey + ev;
                    eci = eci + 1;
                }
                if rkey == ekey { dup = true; }
                kj = kj + 1;
            }
            if !dup {
                vec_push(keep, r);
                keep_count = keep_count + 1;
            }
            r = r + 1;
        }
    }

    // Trailing ORDER BY binds to the whole result. Resolve each key to an output
    // column (by ordinal or header name) and FAIL CLOSED on an unresolvable key
    // rather than silently returning accumulation order.
    if d.has_order == 1 {
        let k1 = resolve_union_order_key(d, d.order_col);
        if k1 < 0 {
            println!("Error: ORDER BY must name an output column or a select position");
            return;
        }
        let k1_type = vec_get(d.union_coltypes, k1);
        let mut k2 = 0 - 1;
        if d.order_col2 >= 0 {
            k2 = resolve_union_order_key(d, d.order_col2);
            if k2 < 0 {
                println!("Error: ORDER BY must name an output column or a select position");
                return;
            }
        }
        let mut k2_type = 0;
        if k2 >= 0 { k2_type = vec_get(d.union_coltypes, k2); }

        // Stable selection sort into a new order (mirrors sort_rows): pick the
        // leftmost minimum among unplaced rows each pass, so equal keys keep
        // their pre-sort order.
        let mut used: Vec<i32> = vec![];
        let mut ui = 0;
        while ui < keep_count { vec_push(used, 0); ui = ui + 1; }
        let mut sorted: Vec<i32> = vec![];
        let mut picked = 0;
        while picked < keep_count {
            let mut best = 0 - 1;
            let mut j = 0;
            while j < keep_count {
                if vec_get(used, j) == 0 {
                    if best < 0 {
                        best = j;
                    } else {
                        let cand = vec_get(keep, j);
                        let bestrow = vec_get(keep, best);
                        let c = cmp_union_rows(d, cand, bestrow, ncol, k1, k1_type, d.order_desc, k2, k2_type, d.order_desc2);
                        if c < 0 { best = j; }
                    }
                }
                j = j + 1;
            }
            let mut new_used: Vec<i32> = vec![];
            let mut k = 0;
            while k < keep_count {
                if k == best { vec_push(new_used, 1); }
                else { vec_push(new_used, vec_get(used, k)); }
                k = k + 1;
            }
            used = new_used;
            vec_push(sorted, vec_get(keep, best));
            picked = picked + 1;
        }
        keep = sorted;
    }

    // Column widths across headers + surviving rows.
    let mut widths: Vec<i32> = vec![];
    let mut wi = 0;
    while wi < ncol {
        let hdr = sp_get(d, vec_get(d.union_headers, wi));
        let mut w = hdr.len();
        let mut wri = 0;
        while wri < keep_count {
            let rr = vec_get(keep, wri);
            let val = sp_get(d, vec_get(d.union_vals, rr * ncol + wi));
            let vlen = val.len();
            if vlen > w { w = vlen; }
            wri = wri + 1;
        }
        vec_push(widths, w);
        wi = wi + 1;
    }

    // Header + separator.
    let mut hdr_line = "";
    let mut sep_line = "";
    let mut hi = 0;
    while hi < ncol {
        if hi > 0 { hdr_line = hdr_line + " | "; sep_line = sep_line + "-+-"; }
        let hdr = sp_get(d, vec_get(d.union_headers, hi));
        let w = vec_get(widths, hi);
        hdr_line = hdr_line + pad_right(hdr, w);
        sep_line = sep_line + make_dashes(w);
        hi = hi + 1;
    }
    println!("{}", hdr_line);
    println!("{}", sep_line);

    // Rows.
    let mut ri = 0;
    while ri < keep_count {
        let rr = vec_get(keep, ri);
        let mut row_line = "";
        let mut ci = 0;
        while ci < ncol {
            if ci > 0 { row_line = row_line + " | "; }
            let val = sp_get(d, vec_get(d.union_vals, rr * ncol + ci));
            let w = vec_get(widths, ci);
            let ct = vec_get(d.union_coltypes, ci);
            if ct == 0 || ct == 1 {
                row_line = row_line + pad_left(val, w);
            } else {
                row_line = row_line + pad_right(val, w);
            }
            ci = ci + 1;
        }
        println!("{}", row_line);
        ri = ri + 1;
    }
}

// --- 6d: SELECT with Aggregates (no GROUP BY) ---

// Execute a SELECT with aggregate functions but no GROUP BY clause.
// Example: SELECT COUNT(*), AVG(salary) FROM employees WHERE dept = 'eng'
//
// Flow:
//   1. Filter rows by WHERE into match_rows
//   2. For each aggregate in d.p_agg_funcs, compute the result over match_rows
//   3. Print a single result row with computed values
//
// Calls: eval_compound_where(), compute_single_agg(), build_agg_header(),
//        print_result_row()
fn exec_select_agg_no_group(d: &mut DB, tidx: i32) ~ Console {
    let tname = sp_get(d, d.p_table);
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);
    let agg_count = d.p_agg_count;
    let alias_val = d.alias1;

    // Declare everything before any vec!/while to avoid compiler codegen bugs
    let mut match_rows: Vec<i32> = vec![];
    let mut results: Vec<i32> = vec![];
    let mut headers: Vec<i32> = vec![];
    let mut match_count = 0;
    let mut r = 0;
    let mut af = 0;
    let mut ac_name_id = 0;
    let mut al_id = 0;
    let mut dist_r = 0;
    let mut vid = 0;
    let mut hid = 0;

    // Single while loop: gather rows, then compute aggs, all sequential in one loop scope
    // Phase 1: gather matching rows
    while r < rc {
        if eval_compound_where(d, cs, cc, rs, r, tname, alias_val) {
            vec_push(match_rows, r);
            match_count = match_count + 1;
        }
        r = r + 1;
    }

    // Phase 2: compute aggregates (second while in same function - compile workaround)
    // Use the agg_count as upper bound for a combined counter
    r = 0;
    while r < agg_count {
        af = vec_get(d.p_agg_funcs, r);
        ac_name_id = vec_get(d.p_agg_cols, r);
        al_id = if r < vec_len(d.p_aliases) { vec_get(d.p_aliases, r) } else { 0 - 1 };
        dist_r = if r < vec_len(d.p_agg_distinct) { vec_get(d.p_agg_distinct, r) } else { 0 };
        vid = compute_single_agg(d, af, ac_name_id, cs, cc, rs, tname, alias_val, match_rows, match_count, dist_r);
        vec_push(results, vid);
        hid = build_agg_header(d, af, ac_name_id, al_id, dist_r);
        vec_push(headers, hid);
        r = r + 1;
    }
    print_result_row(d, headers, results, agg_count);
}

// Compute a single aggregate value, returning its pool id
fn compute_single_agg(d: &mut DB, af: i32, ac_name_id: i32, cs: i32, cc: i32,
                       rs: i32, tname: String, alias_val: i32,
                       match_rows: Vec<i32>, match_count: i32, distinct: i32) -> i32 {
    let ac_name = sp_get(d, ac_name_id);
    if af == 0 {
        // Plain column: first row value
        let col_idx = resolve_col(d, cs, cc, tname, alias_val, ac_name);
        let mut val = "";
        if match_count > 0 {
            let row = vec_get(match_rows, 0);
            if col_idx >= 0 {
                val = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
            }
        }
        return sp_add(d, val);
    }
    if af == 1 {
        // COUNT(*) counts every matching row; COUNT(col) counts non-NULL
        // cells (NULL is the empty string); COUNT(DISTINCT col) counts the
        // distinct non-NULL values.
        if ac_name == "*" {
            return sp_add(d, int_to_str(match_count));
        }
        let col_idx = resolve_col(d, cs, cc, tname, alias_val, ac_name);
        if distinct == 1 {
            let mut seen: Vec<i32> = vec![];
            let mut dcnt = 0;
            let mut di = 0;
            while di < match_count {
                let drow = vec_get(match_rows, di);
                if col_idx >= 0 {
                    let dcell_id = vec_get(d.cells, rs + drow * cc + col_idx);
                    let dcell = sp_get(d, dcell_id);
                    if dcell.len() > 0 {
                        let mut dfound = 0;
                        let mut dsi = 0;
                        while dsi < dcnt {
                            if sp_get(d, vec_get(seen, dsi)) == dcell { dfound = 1; }
                            dsi = dsi + 1;
                        }
                        if dfound == 0 {
                            vec_push(seen, dcell_id);
                            dcnt = dcnt + 1;
                        }
                    }
                }
                di = di + 1;
            }
            return sp_add(d, int_to_str(dcnt));
        }
        let mut cnt = 0;
        let mut mi = 0;
        while mi < match_count {
            let row = vec_get(match_rows, mi);
            if col_idx >= 0 {
                let cell = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
                if cell.len() > 0 { cnt = cnt + 1; }
            }
            mi = mi + 1;
        }
        return sp_add(d, int_to_str(cnt));
    }
    // SUM/AVG/MIN/MAX
    let col_idx = resolve_col(d, cs, cc, tname, alias_val, ac_name);
    let ct = if col_idx >= 0 { vec_get(d.col_types, cs + col_idx) } else { 0 };
    let mut sum_val = 0.0;
    let mut min_val = 999999999.0;
    let mut max_val = 0.0 - 999999999.0;
    // MIN/MAX on a TEXT column (type 2) order lexicographically via
    // compare_vals; parse_float coerces text to 0 and collapses them.
    let mut min_str = "";
    let mut max_str = "";
    let mut cnt = 0;
    let mut mi = 0;
    while mi < match_count {
        let row = vec_get(match_rows, mi);
        if col_idx >= 0 {
            let nv = get_cell_float(d, rs, row, cc, col_idx);
            sum_val = sum_val + nv;
            if nv < min_val { min_val = nv; }
            if nv > max_val { max_val = nv; }
            if ct == 2 {
                let cellv = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
                if cnt == 0 { min_str = cellv; max_str = cellv; }
                else {
                    if compare_vals(cellv, min_str, ct) < 0 { min_str = cellv; }
                    if compare_vals(cellv, max_str, ct) > 0 { max_str = cellv; }
                }
            }
            cnt = cnt + 1;
        }
        mi = mi + 1;
    }
    // MIN/MAX over zero matching rows is SQL NULL (rendered empty), not the
    // numeric sentinel. COUNT stays 0; SUM/AVG keep their 0 result.
    if cnt == 0 && (af == 4 || af == 5) { return sp_add(d, ""); }
    if af == 4 && ct == 2 { return sp_add(d, min_str); }
    if af == 5 && ct == 2 { return sp_add(d, max_str); }
    let mut result_val = sum_val;
    if af == 3 {
        if cnt > 0 { result_val = sum_val / cnt; }
        else { result_val = 0.0; }
    }
    if af == 4 { result_val = min_val; }
    if af == 5 { result_val = max_val; }
    let result_str = float_to_str(result_val);
    sp_add(d, result_str)
}

// Build the header string pool id for an aggregate
fn build_agg_header(d: &mut DB, af: i32, ac_name_id: i32, al_id: i32, distinct: i32) -> i32 {
    if al_id >= 0 { return al_id; }
    let ac_name = sp_get(d, ac_name_id);
    if af == 0 { return sp_add(d, ac_name); }
    if af == 1 {
        if ac_name == "*" { return sp_add(d, "COUNT(*)"); }
        if distinct == 1 { return sp_add(d, "COUNT(DISTINCT " + ac_name + ")"); }
        return sp_add(d, "COUNT(" + ac_name + ")");
    }
    let mut func_name = "SUM";
    if af == 3 { func_name = "AVG"; }
    if af == 4 { func_name = "MIN"; }
    if af == 5 { func_name = "MAX"; }
    let hname = func_name + "(" + ac_name + ")";
    sp_add(d, hname)
}

// --- 6e: SELECT with GROUP BY ---

// Execute a SELECT with GROUP BY and optional HAVING clause.
// Example: SELECT dept, COUNT(*), AVG(salary) FROM emp GROUP BY dept HAVING COUNT(*) > 2
//
// Flow:
//   1. Filter rows by WHERE
//   2. Collect distinct group key values from the GROUP BY column
//   3. For each group key, compute all requested aggregates over matching rows
//   4. Apply HAVING filter to discard groups that don't match
//   5. Apply ORDER BY if present (sorts the group result rows)
//   6. Print formatted output
//
// Group keys are collected into a Vec<i32> of pool IDs. For each key,
// helper functions (group_count_rows, compute_group_numeric, group_get_plain)
// scan match_rows to compute aggregates for that group.
fn exec_select_group(d: &mut DB) ~ Console {
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    if !where_cols_ok(d, cs, cc, tname, d.alias1) { return; }
    // Reject an aggregate (projection or HAVING) over an unknown column before
    // grouping, so a group's compute never reads zero cells and returns 0.
    if !agg_cols_ok(d, cs, cc, tname, d.alias1) { return; }

    let gcol_name = sp_get(d, d.group_col);
    let gcol = resolve_col(d, cs, cc, tname, d.alias1, gcol_name);
    if gcol < 0 {
        println!("Error: GROUP BY column '{}' not found", gcol_name);
        return;
    }

    // Filter rows by WHERE
    let mut match_rows: Vec<i32> = vec![];
    let mut match_count = 0;
    let mut r = 0;
    while r < rc {
        if eval_compound_where(d, cs, cc, rs, r, tname, d.alias1) {
            vec_push(match_rows, r);
            match_count = match_count + 1;
        }
        r = r + 1;
    }

    // Collect distinct group keys
    let mut group_keys: Vec<i32> = vec![];
    let mut group_count = 0;
    let mut mi = 0;
    let mut gk_row = 0;
    let mut gk_val = "";
    let mut gk_id = 0;
    let mut gk_found = false;
    let mut gk_gi = 0;
    let mut gk_existing = "";
    while mi < match_count {
        gk_row = vec_get(match_rows, mi);
        gk_val = sp_get(d, vec_get(d.cells, rs + gk_row * cc + gcol));
        gk_id = sp_add(d, gk_val);
        gk_found = false;
        gk_gi = 0;
        while gk_gi < group_count {
            gk_existing = sp_get(d, vec_get(group_keys, gk_gi));
            if gk_existing == gk_val { gk_found = true; }
            gk_gi = gk_gi + 1;
        }
        if !gk_found {
            vec_push(group_keys, gk_id);
            group_count = group_count + 1;
        }
        mi = mi + 1;
    }

    let ncols = d.p_agg_count;

    // Compute all result rows: flat array, ncols per group
    // Inline the computation to avoid sequential-while-loop compiler issues
    let mut all_results: Vec<i32> = vec![];
    // Pre-copy agg info to avoid struct access issues across function calls
    let mut local_agg_funcs: Vec<i32> = vec![];
    let mut local_agg_cols: Vec<i32> = vec![];
    let mut local_agg_distinct: Vec<i32> = vec![];
    let mut copy_i = 0;
    let mut copy_af = 0;
    let mut copy_ac = 0;
    let mut copy_dist = 0;
    while copy_i < ncols {
        copy_af = vec_get(d.p_agg_funcs, copy_i);
        copy_ac = vec_get(d.p_agg_cols, copy_i);
        copy_dist = if copy_i < vec_len(d.p_agg_distinct) { vec_get(d.p_agg_distinct, copy_i) } else { 0 };
        vec_push(local_agg_funcs, copy_af);
        vec_push(local_agg_cols, copy_ac);
        vec_push(local_agg_distinct, copy_dist);
        copy_i = copy_i + 1;
    }
    // Now compute results for each group
    let alias1_val = d.alias1;
    let mut gi2 = 0;
    let mut gi2_gk = "";
    let mut gi2_ai = 0;
    let mut gi2_af = 0;
    let mut gi2_ac_name = "";
    let mut gi2_col_idx = 0;
    let mut gi2_val_str = "";
    let mut gi2_vid = 0;
    let mut gi2_cnt = 0;
    while gi2 < group_count {
        gi2_gk = sp_get(d, vec_get(group_keys, gi2));
        gi2_ai = 0;
        while gi2_ai < ncols {
            gi2_af = vec_get(local_agg_funcs, gi2_ai);
            gi2_ac_name = sp_get(d, vec_get(local_agg_cols, gi2_ai));
            if gi2_af == 1 {
                if gi2_ac_name == "*" {
                    gi2_cnt = group_count_rows(d, gi2_gk, rs, cc, gcol, match_rows, match_count);
                } else {
                    gi2_col_idx = resolve_col(d, cs, cc, tname, alias1_val, gi2_ac_name);
                    if vec_get(local_agg_distinct, gi2_ai) == 1 {
                        gi2_cnt = group_count_col_distinct(d, gi2_gk, gi2_col_idx, gcol, rs, cc, match_rows, match_count);
                    } else {
                        gi2_cnt = group_count_col(d, gi2_gk, gi2_col_idx, gcol, rs, cc, match_rows, match_count);
                    }
                }
                gi2_val_str = int_to_str(gi2_cnt);
                gi2_vid = sp_add(d, gi2_val_str);
                vec_push(all_results, gi2_vid);
            } else if gi2_af >= 2 {
                gi2_val_str = compute_group_numeric(d, gi2_af, gi2_ac_name, gi2_gk, cs, cc, rs, tname, gcol,
                                                    match_rows, match_count);
                gi2_vid = sp_add(d, gi2_val_str);
                vec_push(all_results, gi2_vid);
            } else {
                gi2_col_idx = resolve_col(d, cs, cc, tname, alias1_val, gi2_ac_name);
                gi2_val_str = group_get_plain(d, gi2_gk, gi2_col_idx, gcol, rs, cc, match_rows, match_count);
                gi2_vid = sp_add(d, gi2_val_str);
                vec_push(all_results, gi2_vid);
            }
            gi2_ai = gi2_ai + 1;
        }
        gi2 = gi2 + 1;
    }

    // HAVING: filter groups after aggregation
    let mut final_results: Vec<i32> = vec![];
    let mut final_count = 0;
    if d.has_having == 1 {
        let hv_rval = sp_get(d, d.having_val);
        let mut hgi = 0;
        let mut hgk = "";
        let mut hv_agg = "";
        let mut hci = 0;
        let mut cell_id = 0;
        while hgi < group_count {
            hgk = sp_get(d, vec_get(group_keys, hgi));
            hv_agg = having_compute_agg(d, hgk, cs, cc, rs, tname, gcol, match_rows, match_count);
            if eval_where(hv_agg, d.having_op, hv_rval) {
                hci = 0;
                while hci < ncols {
                    cell_id = vec_get(all_results, hgi * ncols + hci);
                    vec_push(final_results, cell_id);
                    hci = hci + 1;
                }
                final_count = final_count + 1;
            }
            hgi = hgi + 1;
        }
    } else {
        final_results = all_results;
        final_count = group_count;
    }

    // ORDER BY on grouped output. The key may name the grouped/selected column
    // (SELECT dept, COUNT(*) ... GROUP BY dept ORDER BY dept), an aggregate term
    // (ORDER BY SUM(salary)), or a projection alias (SELECT SUM(salary) AS s ...
    // ORDER BY s). It is resolved to an output column, then a stable sort keeps
    // equal keys in group-discovery order. An unresolvable key fails closed.
    if d.has_order == 1 {
        let go_name = sp_get(d, d.order_col);
        // Resolve the order key to an output column, in order:
        //   (0) ordinal -- a bare integer is a 1-based position into the output
        //       columns (ORDER BY 2), the same rule the non-grouped and UNION
        //       paths use. Out of range fails closed.
        //   (1) same-kind match -- a plain key (order_agg_func == 0) matches a
        //       plain output column; an aggregate key matches the output column
        //       with the same func + arg (ORDER BY SUM(salary)).
        //   (2) alias match -- the key names a projection alias
        //       (SELECT SUM(salary) AS s ... ORDER BY s). An alias is a bare
        //       identifier, so it parses as a plain key but may bind to an
        //       aggregate output column; the alias binding wins.
        // go_match_af carries the matched column's aggregate func so the sort
        // type comes from the output column, not the parsed key.
        let mut go_oidx = 0 - 1;
        let mut go_match_af = 0;
        if is_int_str(go_name) {
            let go_n = parse_int_str(go_name);
            if go_n >= 1 {
                if go_n <= ncols { go_oidx = go_n - 1; }
            }
            if go_oidx < 0 {
                println!("Error: ORDER BY position {} is out of range", go_name);
                return;
            }
            go_match_af = vec_get(local_agg_funcs, go_oidx);
        }
        let mut go_ci = 0;
        while go_ci < ncols {
            if vec_get(local_agg_funcs, go_ci) == d.order_agg_func {
                let go_cn = sp_get(d, vec_get(local_agg_cols, go_ci));
                if go_cn == go_name {
                    if go_oidx < 0 {
                        go_oidx = go_ci;
                        go_match_af = d.order_agg_func;
                    }
                }
            }
            go_ci = go_ci + 1;
        }
        if go_oidx < 0 {
            let mut go_ai = 0;
            while go_ai < ncols {
                if go_ai < vec_len(d.p_aliases) {
                    let go_al = vec_get(d.p_aliases, go_ai);
                    if go_al >= 0 {
                        let go_aln = sp_get(d, go_al);
                        if go_aln == go_name {
                            if go_oidx < 0 {
                                go_oidx = go_ai;
                                go_match_af = vec_get(local_agg_funcs, go_ai);
                            }
                        }
                    }
                }
                go_ai = go_ai + 1;
            }
        }
        if go_oidx < 0 {
            // Fail closed: an ORDER BY term on a grouped result that names
            // neither the grouped/selected column, an aggregate output, nor a
            // select alias has no defined ordering. Erroring beats silently
            // emitting rows in group-discovery order (a wrong answer with no
            // signal).
            println!("Error: ORDER BY term '{}' is not a grouped column, aggregate, or alias", go_name);
            return;
        }
        if go_oidx >= 0 {
            // Aggregate results sort numerically. COUNT is an integer; SUM/AVG/
            // MIN/MAX compare as real so AVG decimals order correctly. A plain
            // key keeps the source column's declared type (TEXT default).
            let mut go_type = 2;
            if go_match_af == 1 {
                go_type = 0;
            } else if go_match_af > 1 {
                go_type = 1;
            } else {
                let go_argn = sp_get(d, vec_get(local_agg_cols, go_oidx));
                let go_real = resolve_col(d, cs, cc, tname, alias1_val, go_argn);
                if go_real >= 0 { go_type = vec_get(d.col_types, cs + go_real); }
            }
            // Stable selection sort over final_count rows, each ncols wide.
            // A strict `< 0` pick keeps equal keys in group-discovery order.
            let mut go_used: Vec<i32> = vec![];
            let mut go_u = 0;
            while go_u < final_count { vec_push(go_used, 0); go_u = go_u + 1; }
            let mut go_sorted: Vec<i32> = vec![];
            let mut go_picked = 0;
            while go_picked < final_count {
                let mut go_best = 0 - 1;
                let mut go_j = 0;
                while go_j < final_count {
                    if vec_get(go_used, go_j) == 0 {
                        if go_best < 0 {
                            go_best = go_j;
                        } else {
                            let go_va = sp_get(d, vec_get(final_results, go_j * ncols + go_oidx));
                            let go_vb = sp_get(d, vec_get(final_results, go_best * ncols + go_oidx));
                            let mut go_c = compare_vals(go_va, go_vb, go_type);
                            if d.order_desc == 1 { go_c = 0 - go_c; }
                            if go_c < 0 { go_best = go_j; }
                        }
                    }
                    go_j = go_j + 1;
                }
                let mut go_nu: Vec<i32> = vec![];
                let mut go_k = 0;
                while go_k < final_count {
                    if go_k == go_best { vec_push(go_nu, 1); }
                    else { vec_push(go_nu, vec_get(go_used, go_k)); }
                    go_k = go_k + 1;
                }
                go_used = go_nu;
                let mut go_cp = 0;
                while go_cp < ncols {
                    vec_push(go_sorted, vec_get(final_results, go_best * ncols + go_cp));
                    go_cp = go_cp + 1;
                }
                go_picked = go_picked + 1;
            }
            final_results = go_sorted;
        }
    }

    // Build headers (with alias support)
    let mut headers: Vec<i32> = vec![];
    let mut bhi = 0;
    let mut bh_used_alias = false;
    let mut bh_al = 0;
    while bhi < ncols {
        bh_used_alias = false;
        if bhi < vec_len(d.p_aliases) {
            bh_al = vec_get(d.p_aliases, bhi);
            if bh_al >= 0 {
                vec_push(headers, bh_al);
                bh_used_alias = true;
            }
        }
        if !bh_used_alias {
            push_agg_header(d, bhi, headers);
        }
        bhi = bhi + 1;
    }

    // Compute widths
    let mut widths2: Vec<i32> = vec![];
    let mut w2i = 0;
    let mut w2_hdr = "";
    while w2i < ncols {
        w2_hdr = sp_get(d, vec_get(headers, w2i));
        vec_push(widths2, w2_hdr.len());
        w2i = w2i + 1;
    }
    let mut ri2 = 0;
    let mut ci2 = 0;
    let mut w2_val = "";
    let mut w2_vlen = 0;
    let mut w2_cur = 0;
    while ri2 < final_count {
        ci2 = 0;
        while ci2 < ncols {
            w2_val = sp_get(d, vec_get(final_results, ri2 * ncols + ci2));
            w2_vlen = w2_val.len();
            w2_cur = vec_get(widths2, ci2);
            if w2_vlen > w2_cur { widths2 = vec_replace(widths2, ncols, ci2, w2_vlen); }
            ci2 = ci2 + 1;
        }
        ri2 = ri2 + 1;
    }
    let widths = widths2;

    // Print header
    let mut hdr_line = "";
    let mut sep_line = "";
    let mut pi = 0;
    let mut ph_hdr = "";
    let mut ph_w = 0;
    while pi < ncols {
        if pi > 0 { hdr_line = hdr_line + " | "; sep_line = sep_line + "-+-"; }
        ph_hdr = sp_get(d, vec_get(headers, pi));
        ph_w = vec_get(widths, pi);
        hdr_line = hdr_line + pad_right(ph_hdr, ph_w);
        sep_line = sep_line + make_dashes(ph_w);
        pi = pi + 1;
    }
    println!("{}", hdr_line);
    println!("{}", sep_line);

    // Print rows
    let mut ri = 0;
    let mut row_line = "";
    let mut pci = 0;
    let mut pr_val = "";
    let mut pr_w = 0;
    while ri < final_count {
        row_line = "";
        pci = 0;
        while pci < ncols {
            if pci > 0 { row_line = row_line + " | "; }
            pr_val = sp_get(d, vec_get(final_results, ri * ncols + pci));
            pr_w = vec_get(widths, pci);
            row_line = row_line + pad_right(pr_val, pr_w);
            pci = pci + 1;
        }
        println!("{}", row_line);
        ri = ri + 1;
    }
}

// Compute the HAVING aggregate value for a group key
fn having_compute_agg(d: &mut DB, gk: String, cs: i32, cc: i32, rs: i32,
                      tname: String, gcol: i32,
                      match_rows: Vec<i32>, match_count: i32) -> String {
    let haf = d.having_agg_func;
    if haf == 1 {
        // COUNT
        let cnt = group_count_rows(d, gk, rs, cc, gcol, match_rows, match_count);
        return int_to_str(cnt);
    }
    // SUM/AVG/MIN/MAX
    let hac_name = sp_get(d, d.having_agg_col);
    compute_group_numeric(d, haf, hac_name, gk, cs, cc, rs, tname, gcol, match_rows, match_count)
}

fn group_count_rows(d: &DB, gk: String, rs: i32, cc: i32, gcol: i32,
                    match_rows: Vec<i32>, match_count: i32) -> i32 {
    let mut cnt = 0;
    let mut ci = 0;
    while ci < match_count {
        let crow = vec_get(match_rows, ci);
        let cgv = sp_get(d, vec_get(d.cells, rs + crow * cc + gcol));
        if cgv == gk { cnt = cnt + 1; }
        ci = ci + 1;
    }
    cnt
}

// COUNT(col) within a group: rows in the group whose col cell is non-NULL
// (NULL is the empty string).
fn group_count_col(d: &DB, gk: String, col_idx: i32, gcol: i32, rs: i32, cc: i32,
                   match_rows: Vec<i32>, match_count: i32) -> i32 {
    let mut cnt = 0;
    let mut ci = 0;
    while ci < match_count {
        let crow = vec_get(match_rows, ci);
        let cgv = sp_get(d, vec_get(d.cells, rs + crow * cc + gcol));
        if cgv == gk {
            if col_idx >= 0 {
                let cell = sp_get(d, vec_get(d.cells, rs + crow * cc + col_idx));
                if cell.len() > 0 { cnt = cnt + 1; }
            }
        }
        ci = ci + 1;
    }
    cnt
}

// COUNT(DISTINCT col) within a group: the number of distinct non-NULL values of
// col among the rows whose group cell equals gk. Dedup is a linear scan over the
// values already seen (no hash set), which is fine for the row counts this
// teaching engine handles.
fn group_count_col_distinct(d: &DB, gk: String, col_idx: i32, gcol: i32, rs: i32, cc: i32,
                            match_rows: Vec<i32>, match_count: i32) -> i32 {
    let mut seen: Vec<i32> = vec![];
    let mut dcnt = 0;
    let mut ci = 0;
    while ci < match_count {
        let crow = vec_get(match_rows, ci);
        let cgv = sp_get(d, vec_get(d.cells, rs + crow * cc + gcol));
        if cgv == gk {
            if col_idx >= 0 {
                let cell_id = vec_get(d.cells, rs + crow * cc + col_idx);
                let cell = sp_get(d, cell_id);
                if cell.len() > 0 {
                    let mut found = 0;
                    let mut si = 0;
                    while si < dcnt {
                        if sp_get(d, vec_get(seen, si)) == cell { found = 1; }
                        si = si + 1;
                    }
                    if found == 0 {
                        vec_push(seen, cell_id);
                        dcnt = dcnt + 1;
                    }
                }
            }
        }
        ci = ci + 1;
    }
    dcnt
}

fn group_get_plain(d: &DB, gk: String, col_idx: i32, gcol: i32, rs: i32, cc: i32,
                   match_rows: Vec<i32>, match_count: i32) -> String {
    if col_idx == gcol { return gk; }
    let mut fi = 0;
    while fi < match_count {
        let frow = vec_get(match_rows, fi);
        let fgv = sp_get(d, vec_get(d.cells, rs + frow * cc + gcol));
        if fgv == gk {
            if col_idx >= 0 {
                return sp_get(d, vec_get(d.cells, rs + frow * cc + col_idx));
            }
        }
        fi = fi + 1;
    }
    ""
}

fn push_agg_header(d: &mut DB, hi: i32, headers: Vec<i32>) {
    let af = vec_get(d.p_agg_funcs, hi);
    let ac_name = sp_get(d, vec_get(d.p_agg_cols, hi));
    let dist = if hi < vec_len(d.p_agg_distinct) { vec_get(d.p_agg_distinct, hi) } else { 0 };
    if af == 0 {
        let hid = sp_add(d, ac_name);
        vec_push(headers, hid);
        return;
    }
    if af == 1 {
        if ac_name == "*" {
            let hid = sp_add(d, "COUNT(*)");
            vec_push(headers, hid);
            return;
        }
        if dist == 1 {
            let hid = sp_add(d, "COUNT(DISTINCT " + ac_name + ")");
            vec_push(headers, hid);
            return;
        }
        let hid = sp_add(d, "COUNT(" + ac_name + ")");
        vec_push(headers, hid);
        return;
    }
    let mut func_name = "SUM";
    if af == 3 { func_name = "AVG"; }
    if af == 4 { func_name = "MIN"; }
    if af == 5 { func_name = "MAX"; }
    let hname = func_name + "(" + ac_name + ")";
    let hid = sp_add(d, hname);
    vec_push(headers, hid);
}

fn compute_group_numeric(d: &mut DB, af: i32, ac_name: String, gk: String,
                         cs: i32, cc: i32, rs: i32, tname: String, gcol: i32,
                         match_rows: Vec<i32>, match_count: i32) -> String {
    let col_idx = resolve_col(d, cs, cc, tname, d.alias1, ac_name);
    let ct = if col_idx >= 0 { vec_get(d.col_types, cs + col_idx) } else { 0 };
    let mut sum_v = 0.0;
    let mut min_v = 999999999.0;
    let mut max_v = 0.0 - 999999999.0;
    // MIN/MAX on a TEXT column (type 2) order lexicographically via
    // compare_vals; parse_float coerces text to 0 and collapses them.
    let mut min_str = "";
    let mut max_str = "";
    let mut cnt = 0;
    let mut si = 0;
    while si < match_count {
        let srow = vec_get(match_rows, si);
        let sgv = sp_get(d, vec_get(d.cells, rs + srow * cc + gcol));
        if sgv == gk {
            if col_idx >= 0 {
                let sv = sp_get(d, vec_get(d.cells, rs + srow * cc + col_idx));
                let nv = sv.parse_float();
                sum_v = sum_v + nv;
                if nv < min_v { min_v = nv; }
                if nv > max_v { max_v = nv; }
                if ct == 2 {
                    if cnt == 0 { min_str = sv; max_str = sv; }
                    else {
                        if compare_vals(sv, min_str, ct) < 0 { min_str = sv; }
                        if compare_vals(sv, max_str, ct) > 0 { max_str = sv; }
                    }
                }
                cnt = cnt + 1;
            }
        }
        si = si + 1;
    }
    // MIN/MAX over zero matching rows is SQL NULL (rendered empty), not the
    // numeric sentinel. COUNT stays 0; SUM/AVG keep their 0 result.
    if cnt == 0 && (af == 4 || af == 5) { return ""; }
    if af == 4 && ct == 2 { return min_str; }
    if af == 5 && ct == 2 { return max_str; }
    let mut result_val = sum_v;
    if af == 3 {
        if cnt > 0 { result_val = sum_v / cnt; }
        else { result_val = 0.0; }
    }
    if af == 4 { result_val = min_v; }
    if af == 5 { result_val = max_v; }
    float_to_str(result_val)
}

// --- 6f: SELECT with JOIN (nested loop) ---

// Execute a SELECT with JOIN. Uses nested-loop join algorithm.
// Example: SELECT u.name, o.total FROM users u JOIN orders o ON u.id = o.user_id
//
// Flow:
//   1. Resolve both tables and their column schemas
//   2. Resolve ON clause columns (try both orderings)
//   3. Resolve SELECT column list against both tables
//   4. Nested loop: for each row in table1, scan all rows in table2
//   5. For matching pairs (ON condition), evaluate WHERE if present
//   6. Collect selected columns from matching row pairs
//   7. Apply ORDER BY, LIMIT, DISTINCT
//   8. Print formatted output
//
// Table aliases (u, o) are resolved via d.alias1 and d.alias2.
fn exec_select_join(d: &mut DB) ~ Console {
    let tname1 = sp_get(d, d.p_table);
    let tname2 = sp_get(d, d.join_table);
    let t1 = find_table(d, tname1);
    let t2 = find_table(d, tname2);
    if t1 < 0 { println!("Error: table '{}' not found", tname1); return; }
    if t2 < 0 { println!("Error: table '{}' not found", tname2); return; }

    let cs1 = vec_get(d.tbl_col_starts, t1);
    let cc1 = vec_get(d.tbl_col_counts, t1);
    let rs1 = vec_get(d.tbl_row_starts, t1);
    let rc1 = vec_get(d.tbl_row_counts, t1);

    let cs2 = vec_get(d.tbl_col_starts, t2);
    let cc2 = vec_get(d.tbl_col_counts, t2);
    let rs2 = vec_get(d.tbl_row_starts, t2);
    let rc2 = vec_get(d.tbl_row_counts, t2);

    // Resolve ON columns
    let jl_ref = sp_get(d, d.join_left_col);
    let jr_ref = sp_get(d, d.join_right_col);

    // Try to resolve each ref against both tables
    let mut jc1 = resolve_col(d, cs1, cc1, tname1, d.alias1, jl_ref);
    let mut jc2 = resolve_col(d, cs2, cc2, tname2, d.alias2, jr_ref);
    // If that didn't work, try swapped
    if jc1 < 0 {
        jc1 = resolve_col(d, cs1, cc1, tname1, d.alias1, jr_ref);
        jc2 = resolve_col(d, cs2, cc2, tname2, d.alias2, jl_ref);
    }
    if jc1 < 0 || jc2 < 0 {
        println!("Error: cannot resolve JOIN columns");
        return;
    }

    // p_agg_count is the count of ALL projection items, plain columns included
    // (each carries p_agg_funcs[k]==0), so a real aggregate is present only when
    // some p_agg_funcs entry is non-zero. Checking p_agg_count>0 alone would
    // treat every plain join as an aggregate.
    let mut join_has_agg = false;
    let mut join_has_distinct = false;
    let mut ai = 0;
    while ai < d.p_agg_count {
        if vec_get(d.p_agg_funcs, ai) > 0 { join_has_agg = true; }
        if ai < vec_len(d.p_agg_distinct) {
            if vec_get(d.p_agg_distinct, ai) == 1 { join_has_distinct = true; }
        }
        ai = ai + 1;
    }

    // Scalar aggregate over a JOIN with no GROUP BY. Assemble the matched
    // (r1,r2) pairs the same way the plain projection path does (honoring WHERE
    // and LEFT JOIN null-extension), then fold each aggregate over those pairs.
    // NULL and MIN/MAX/COUNT semantics mirror compute_single_agg so a join
    // aggregate returns the same answer a single-table aggregate would over the
    // same joined rows. A right-side column of a LEFT JOIN null-extended pair
    // (r2 < 0) reads as NULL (empty string), which the numeric folds coerce to
    // 0.0 exactly as the single-table path coerces an empty cell.
    if join_has_agg && d.has_group_by == 0 {
        if join_has_distinct {
            println!("Error: COUNT(DISTINCT) over a JOIN is not supported");
            return;
        }
        let mut pr1: Vec<i32> = vec![];
        let mut pr2: Vec<i32> = vec![];
        let mut pcount = 0;
        let mut q1 = 0;
        while q1 < rc1 {
            let jk1 = sp_get(d, vec_get(d.cells, rs1 + q1 * cc1 + jc1));
            let mut jmatched = false;
            let mut q2 = 0;
            while q2 < rc2 {
                let jk2 = sp_get(d, vec_get(d.cells, rs2 + q2 * cc2 + jc2));
                if jk1 == jk2 {
                    jmatched = true;
                    let mut jpass = true;
                    if d.has_where == 1 {
                        jpass = eval_join_where(d, cs1, cc1, rs1, q1, tname1, d.alias1,
                                                cs2, cc2, rs2, q2, tname2, d.alias2);
                    }
                    if jpass {
                        vec_push(pr1, q1);
                        vec_push(pr2, q2);
                        pcount = pcount + 1;
                    }
                }
                q2 = q2 + 1;
            }
            if d.join_type == 1 {
                if jmatched == false {
                    let mut lpass = true;
                    if d.has_where == 1 {
                        lpass = eval_join_where(d, cs1, cc1, rs1, q1, tname1, d.alias1,
                                                cs2, cc2, rs2, 0 - 1, tname2, d.alias2);
                    }
                    if lpass {
                        vec_push(pr1, q1);
                        vec_push(pr2, 0 - 1);
                        pcount = pcount + 1;
                    }
                }
            }
            q1 = q1 + 1;
        }

        let mut agg_headers: Vec<i32> = vec![];
        let mut agg_results: Vec<i32> = vec![];
        let mut pi = 0;
        while pi < d.p_agg_count {
            let af = vec_get(d.p_agg_funcs, pi);
            let ac_id = vec_get(d.p_agg_cols, pi);
            let ac = sp_get(d, ac_id);
            let al = if pi < vec_len(d.p_aliases) { vec_get(d.p_aliases, pi) } else { 0 - 1 };
            // Resolve the argument column against either table. COUNT(*) has no
            // column, so skip resolution for it.
            let mut atab = 0;
            let mut acol = 0 - 1;
            let mut atype = 0;
            if !(af == 1 && ac == "*") {
                let ra = resolve_col(d, cs1, cc1, tname1, d.alias1, ac);
                if ra >= 0 { atab = 1; acol = ra; atype = vec_get(d.col_types, cs1 + ra); }
                else {
                    let rb = resolve_col(d, cs2, cc2, tname2, d.alias2, ac);
                    if rb >= 0 { atab = 2; acol = rb; atype = vec_get(d.col_types, cs2 + rb); }
                    else {
                        println!("Error: column '{}' not found in either table", ac);
                        return;
                    }
                }
            }
            let mut out = "";
            if af == 0 {
                // Bare column beside aggregates: first joined row's value, as the
                // single-table path returns the first matching row's value.
                if pcount > 0 {
                    out = join_cell_str(d, atab, acol, cc1, rs1, vec_get(pr1, 0),
                                        cc2, rs2, vec_get(pr2, 0));
                }
            } else if af == 1 {
                if ac == "*" {
                    out = int_to_str(pcount);
                } else {
                    let mut cnt = 0;
                    let mut k = 0;
                    while k < pcount {
                        let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(pr1, k),
                                               cc2, rs2, vec_get(pr2, k));
                        if cv.len() > 0 { cnt = cnt + 1; }
                        k = k + 1;
                    }
                    out = int_to_str(cnt);
                }
            } else {
                let mut sum_val = 0.0;
                let mut min_val = 999999999.0;
                let mut max_val = 0.0 - 999999999.0;
                let mut min_str = "";
                let mut max_str = "";
                let mut cnt = 0;
                let mut k = 0;
                while k < pcount {
                    let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(pr1, k),
                                           cc2, rs2, vec_get(pr2, k));
                    let nv = cv.parse_float();
                    sum_val = sum_val + nv;
                    if nv < min_val { min_val = nv; }
                    if nv > max_val { max_val = nv; }
                    if atype == 2 {
                        if cnt == 0 { min_str = cv; max_str = cv; }
                        else {
                            if compare_vals(cv, min_str, atype) < 0 { min_str = cv; }
                            if compare_vals(cv, max_str, atype) > 0 { max_str = cv; }
                        }
                    }
                    cnt = cnt + 1;
                    k = k + 1;
                }
                if cnt == 0 && (af == 4 || af == 5) {
                    out = "";
                } else if af == 4 && atype == 2 {
                    out = min_str;
                } else if af == 5 && atype == 2 {
                    out = max_str;
                } else {
                    let mut rv = sum_val;
                    if af == 3 { if cnt > 0 { rv = sum_val / cnt; } else { rv = 0.0; } }
                    if af == 4 { rv = min_val; }
                    if af == 5 { rv = max_val; }
                    out = float_to_str(rv);
                }
            }
            vec_push(agg_results, sp_add(d, out));
            let dist0 = if pi < vec_len(d.p_agg_distinct) { vec_get(d.p_agg_distinct, pi) } else { 0 };
            vec_push(agg_headers, build_agg_header(d, af, ac_id, al, dist0));
            pi = pi + 1;
        }
        print_result_row(d, agg_headers, agg_results, d.p_agg_count);
        return;
    }

    // GROUP BY over a JOIN with aggregates. Bucket the assembled (r1,r2) pairs by
    // the single group column's value, then fold each projection item over the
    // pairs in one bucket exactly as the scalar path folds over all pairs. One
    // output row per distinct group key, in group-discovery order (the left
    // table's scan order), matching the single-table grouped path. HAVING filters
    // groups, ORDER BY sorts them, and LIMIT/OFFSET truncate them. DISTINCT and
    // COUNT(DISTINCT) over a grouped join stay fail-closed so an unsupported clause
    // never silently drops or reorders group rows.
    if join_has_agg && d.has_group_by == 1 {
        if join_has_distinct {
            println!("Error: COUNT(DISTINCT) over a JOIN is not supported");
            return;
        }
        if d.has_distinct == 1 {
            println!("Error: DISTINCT over a grouped JOIN is not supported");
            return;
        }
        // Resolve the single group column against either table.
        let gref = sp_get(d, d.group_col);
        let mut gtab = 0;
        let mut gcol = 0 - 1;
        let rg1 = resolve_col(d, cs1, cc1, tname1, d.alias1, gref);
        if rg1 >= 0 { gtab = 1; gcol = rg1; }
        else {
            let rg2 = resolve_col(d, cs2, cc2, tname2, d.alias2, gref);
            if rg2 >= 0 { gtab = 2; gcol = rg2; }
            else {
                println!("Error: GROUP BY column '{}' not found in either table", gref);
                return;
            }
        }

        // Assemble matched (r1,r2) pairs honoring WHERE and LEFT JOIN
        // null-extension, identical to the scalar path above.
        let mut gpr1: Vec<i32> = vec![];
        let mut gpr2: Vec<i32> = vec![];
        let mut gpc = 0;
        let mut g1 = 0;
        while g1 < rc1 {
            let gk1 = sp_get(d, vec_get(d.cells, rs1 + g1 * cc1 + jc1));
            let mut gm = false;
            let mut g2 = 0;
            while g2 < rc2 {
                let gk2 = sp_get(d, vec_get(d.cells, rs2 + g2 * cc2 + jc2));
                if gk1 == gk2 {
                    gm = true;
                    let mut gp = true;
                    if d.has_where == 1 {
                        gp = eval_join_where(d, cs1, cc1, rs1, g1, tname1, d.alias1,
                                             cs2, cc2, rs2, g2, tname2, d.alias2);
                    }
                    if gp {
                        vec_push(gpr1, g1);
                        vec_push(gpr2, g2);
                        gpc = gpc + 1;
                    }
                }
                g2 = g2 + 1;
            }
            if d.join_type == 1 {
                if gm == false {
                    let mut glp = true;
                    if d.has_where == 1 {
                        glp = eval_join_where(d, cs1, cc1, rs1, g1, tname1, d.alias1,
                                              cs2, cc2, rs2, 0 - 1, tname2, d.alias2);
                    }
                    if glp {
                        vec_push(gpr1, g1);
                        vec_push(gpr2, 0 - 1);
                        gpc = gpc + 1;
                    }
                }
            }
            g1 = g1 + 1;
        }

        // Distinct group keys in first-seen (left-scan) order.
        let mut gkeys: Vec<i32> = vec![];
        let mut gkc = 0;
        let mut kk = 0;
        while kk < gpc {
            let gkv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, kk),
                                    cc2, rs2, vec_get(gpr2, kk));
            let mut seen = false;
            let mut si = 0;
            while si < gkc {
                if sp_get(d, vec_get(gkeys, si)) == gkv { seen = true; }
                si = si + 1;
            }
            if seen == false {
                vec_push(gkeys, sp_add(d, gkv));
                gkc = gkc + 1;
            }
            kk = kk + 1;
        }

        // HAVING: keep only group keys whose aggregate passes the test. The
        // HAVING aggregate is folded over the same bucket the projection uses, so
        // a surviving group's HAVING value matches what the row displays. The RHS
        // column, if any, is resolved against either table (COUNT(*) needs none).
        // Trimming gkeys/gkc here leaves every downstream fold, width, and render
        // loop untouched.
        if d.has_having == 1 {
            let hstar = d.having_agg_func == 1 && sp_get(d, d.having_agg_col) == "*";
            let mut hatab = 0;
            let mut hacol = 0 - 1;
            let mut hatype = 0;
            if hstar == false {
                let hname = sp_get(d, d.having_agg_col);
                let rh1 = resolve_col(d, cs1, cc1, tname1, d.alias1, hname);
                if rh1 >= 0 { hatab = 1; hacol = rh1; hatype = vec_get(d.col_types, cs1 + rh1); }
                else {
                    let rh2 = resolve_col(d, cs2, cc2, tname2, d.alias2, hname);
                    if rh2 >= 0 { hatab = 2; hacol = rh2; hatype = vec_get(d.col_types, cs2 + rh2); }
                    else {
                        println!("Error: HAVING column '{}' not found in either table", hname);
                        return;
                    }
                }
            }
            let hv_rval = sp_get(d, d.having_val);
            let mut kept: Vec<i32> = vec![];
            let mut keptc = 0;
            let mut hk = 0;
            while hk < gkc {
                let hgkey = sp_get(d, vec_get(gkeys, hk));
                let hv = join_having_agg(d, d.having_agg_func, hstar, hatab, hacol, hatype,
                                         gtab, gcol, cc1, rs1, cc2, rs2,
                                         gpr1, gpr2, gpc, hgkey);
                if eval_where(hv, d.having_op, hv_rval) {
                    vec_push(kept, vec_get(gkeys, hk));
                    keptc = keptc + 1;
                }
                hk = hk + 1;
            }
            gkeys = kept;
            gkc = keptc;
        }

        // Build headers once (alias-aware), same as the scalar path.
        let ncols = d.p_agg_count;
        let mut gheaders: Vec<i32> = vec![];
        let mut hpi = 0;
        while hpi < ncols {
            let haf = vec_get(d.p_agg_funcs, hpi);
            let hac_id = vec_get(d.p_agg_cols, hpi);
            let hal = if hpi < vec_len(d.p_aliases) { vec_get(d.p_aliases, hpi) } else { 0 - 1 };
            let hdist = if hpi < vec_len(d.p_agg_distinct) { vec_get(d.p_agg_distinct, hpi) } else { 0 };
            vec_push(gheaders, build_agg_header(d, haf, hac_id, hal, hdist));
            hpi = hpi + 1;
        }

        // One output row per group key: fold each projection item over just the
        // pairs whose group cell equals this key.
        let mut grows: Vec<i32> = vec![];
        let mut gi = 0;
        while gi < gkc {
            let gkey = sp_get(d, vec_get(gkeys, gi));
            let mut ppi = 0;
            while ppi < ncols {
                let af = vec_get(d.p_agg_funcs, ppi);
                let ac_id = vec_get(d.p_agg_cols, ppi);
                let ac = sp_get(d, ac_id);
                let mut atab = 0;
                let mut acol = 0 - 1;
                let mut atype = 0;
                if !(af == 1 && ac == "*") {
                    let ra = resolve_col(d, cs1, cc1, tname1, d.alias1, ac);
                    if ra >= 0 { atab = 1; acol = ra; atype = vec_get(d.col_types, cs1 + ra); }
                    else {
                        let rb = resolve_col(d, cs2, cc2, tname2, d.alias2, ac);
                        if rb >= 0 { atab = 2; acol = rb; atype = vec_get(d.col_types, cs2 + rb); }
                        else {
                            println!("Error: column '{}' not found in either table", ac);
                            return;
                        }
                    }
                }
                let mut out = "";
                if af == 0 {
                    // Plain column beside aggregates: the group column returns the
                    // key; any other plain column returns the first row in the
                    // group, matching group_get_plain.
                    let mut found = false;
                    let mut fk = 0;
                    while fk < gpc {
                        if found == false {
                            let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, fk),
                                                   cc2, rs2, vec_get(gpr2, fk));
                            if gv == gkey {
                                out = join_cell_str(d, atab, acol, cc1, rs1, vec_get(gpr1, fk),
                                                    cc2, rs2, vec_get(gpr2, fk));
                                found = true;
                            }
                        }
                        fk = fk + 1;
                    }
                } else if af == 1 {
                    if ac == "*" {
                        let mut cnt = 0;
                        let mut k = 0;
                        while k < gpc {
                            let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, k),
                                                   cc2, rs2, vec_get(gpr2, k));
                            if gv == gkey { cnt = cnt + 1; }
                            k = k + 1;
                        }
                        out = int_to_str(cnt);
                    } else {
                        let mut cnt = 0;
                        let mut k = 0;
                        while k < gpc {
                            let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, k),
                                                   cc2, rs2, vec_get(gpr2, k));
                            if gv == gkey {
                                let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(gpr1, k),
                                                       cc2, rs2, vec_get(gpr2, k));
                                if cv.len() > 0 { cnt = cnt + 1; }
                            }
                            k = k + 1;
                        }
                        out = int_to_str(cnt);
                    }
                } else {
                    let mut sum_val = 0.0;
                    let mut min_val = 999999999.0;
                    let mut max_val = 0.0 - 999999999.0;
                    let mut min_str = "";
                    let mut max_str = "";
                    let mut cnt = 0;
                    let mut k = 0;
                    while k < gpc {
                        let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, k),
                                               cc2, rs2, vec_get(gpr2, k));
                        if gv == gkey {
                            let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(gpr1, k),
                                                   cc2, rs2, vec_get(gpr2, k));
                            let nv = cv.parse_float();
                            sum_val = sum_val + nv;
                            if nv < min_val { min_val = nv; }
                            if nv > max_val { max_val = nv; }
                            if atype == 2 {
                                if cnt == 0 { min_str = cv; max_str = cv; }
                                else {
                                    if compare_vals(cv, min_str, atype) < 0 { min_str = cv; }
                                    if compare_vals(cv, max_str, atype) > 0 { max_str = cv; }
                                }
                            }
                            cnt = cnt + 1;
                        }
                        k = k + 1;
                    }
                    if cnt == 0 && (af == 4 || af == 5) {
                        out = "";
                    } else if af == 4 && atype == 2 {
                        out = min_str;
                    } else if af == 5 && atype == 2 {
                        out = max_str;
                    } else {
                        let mut rv = sum_val;
                        if af == 3 { if cnt > 0 { rv = sum_val / cnt; } else { rv = 0.0; } }
                        if af == 4 { rv = min_val; }
                        if af == 5 { rv = max_val; }
                        out = float_to_str(rv);
                    }
                }
                vec_push(grows, sp_add(d, out));
                ppi = ppi + 1;
            }
            gi = gi + 1;
        }

        // ORDER BY on the grouped-join output. Mirrors the single-table grouped
        // path: the key is a 1-based ordinal into the output columns, or names the
        // grouped column, an aggregate term, or a projection alias; it resolves to
        // an output column and a stable sort keeps equal keys in group-discovery
        // order. A secondary key fails closed (honest partial); an out-of-range
        // ordinal or an unresolvable name fails closed too.
        if d.has_order == 1 {
            if d.order_col2 >= 0 {
                println!("Error: secondary ORDER BY over a grouped JOIN is not supported");
                return;
            }
            let jo_name = sp_get(d, d.order_col);
            let mut jo_oidx = 0 - 1;
            let mut jo_af = 0;
            // A bare integer key is a 1-based ordinal into the output columns, the
            // same rule the non-grouped and UNION paths use (ORDER BY 2). The
            // matched column's own aggregate func drives the sort type below.
            if is_int_str(jo_name) {
                let jo_n = parse_int_str(jo_name);
                if jo_n >= 1 {
                    if jo_n <= ncols { jo_oidx = jo_n - 1; }
                }
                if jo_oidx < 0 {
                    println!("Error: ORDER BY position {} is out of range", jo_name);
                    return;
                }
                jo_af = vec_get(d.p_agg_funcs, jo_oidx);
            }
            let mut jo_ci = 0;
            while jo_ci < ncols {
                if vec_get(d.p_agg_funcs, jo_ci) == d.order_agg_func {
                    let jo_cn = sp_get(d, vec_get(d.p_agg_cols, jo_ci));
                    if jo_cn == jo_name {
                        if jo_oidx < 0 { jo_oidx = jo_ci; jo_af = d.order_agg_func; }
                    }
                }
                jo_ci = jo_ci + 1;
            }
            if jo_oidx < 0 {
                let mut jo_ai = 0;
                while jo_ai < ncols {
                    if jo_ai < vec_len(d.p_aliases) {
                        let jo_al = vec_get(d.p_aliases, jo_ai);
                        if jo_al >= 0 {
                            let jo_aln = sp_get(d, jo_al);
                            if jo_aln == jo_name {
                                if jo_oidx < 0 { jo_oidx = jo_ai; jo_af = vec_get(d.p_agg_funcs, jo_ai); }
                            }
                        }
                    }
                    jo_ai = jo_ai + 1;
                }
            }
            if jo_oidx < 0 {
                println!("Error: ORDER BY term '{}' is not a grouped column, aggregate, or alias", jo_name);
                return;
            }
            // Aggregate outputs sort numerically (COUNT integer, SUM/AVG/MIN/MAX
            // real); a plain key keeps its source column's declared type.
            let mut jo_type = 2;
            if jo_af == 1 { jo_type = 0; }
            else if jo_af > 1 { jo_type = 1; }
            else {
                let jo_argn = sp_get(d, vec_get(d.p_agg_cols, jo_oidx));
                let jo_r1 = resolve_col(d, cs1, cc1, tname1, d.alias1, jo_argn);
                if jo_r1 >= 0 { jo_type = vec_get(d.col_types, cs1 + jo_r1); }
                else {
                    let jo_r2 = resolve_col(d, cs2, cc2, tname2, d.alias2, jo_argn);
                    if jo_r2 >= 0 { jo_type = vec_get(d.col_types, cs2 + jo_r2); }
                }
            }
            // Stable selection sort over gkc rows, each ncols wide. A strict
            // `< 0` pick keeps equal keys in group-discovery order.
            let mut jo_used: Vec<i32> = vec![];
            let mut jo_u = 0;
            while jo_u < gkc { vec_push(jo_used, 0); jo_u = jo_u + 1; }
            let mut jo_sorted: Vec<i32> = vec![];
            let mut jo_picked = 0;
            while jo_picked < gkc {
                let mut jo_best = 0 - 1;
                let mut jo_j = 0;
                while jo_j < gkc {
                    if vec_get(jo_used, jo_j) == 0 {
                        if jo_best < 0 { jo_best = jo_j; }
                        else {
                            let jo_va = sp_get(d, vec_get(grows, jo_j * ncols + jo_oidx));
                            let jo_vb = sp_get(d, vec_get(grows, jo_best * ncols + jo_oidx));
                            let mut jo_c = compare_vals(jo_va, jo_vb, jo_type);
                            if d.order_desc == 1 { jo_c = 0 - jo_c; }
                            if jo_c < 0 { jo_best = jo_j; }
                        }
                    }
                    jo_j = jo_j + 1;
                }
                let mut jo_nu: Vec<i32> = vec![];
                let mut jo_k = 0;
                while jo_k < gkc {
                    if jo_k == jo_best { vec_push(jo_nu, 1); }
                    else { vec_push(jo_nu, vec_get(jo_used, jo_k)); }
                    jo_k = jo_k + 1;
                }
                jo_used = jo_nu;
                let mut jo_cp = 0;
                while jo_cp < ncols {
                    vec_push(jo_sorted, vec_get(grows, jo_best * ncols + jo_cp));
                    jo_cp = jo_cp + 1;
                }
                jo_picked = jo_picked + 1;
            }
            grows = jo_sorted;
        }

        // LIMIT / OFFSET over the group rows. Mirrors the single-table grouped
        // path exactly: skip OFFSET whole group rows, then take up to LIMIT,
        // each row being ncols pool ids. Applied after the ORDER BY sort so
        // "ORDER BY ... LIMIT n" returns the top n groups; LIMIT without ORDER BY
        // keeps group-discovery order like every other unordered path.
        if d.has_limit == 1 || d.has_offset == 1 {
            let mut lo_off = 0;
            if d.has_offset == 1 { lo_off = d.offset_val; }
            let mut lo_lim = gkc;
            if d.has_limit == 1 { lo_lim = d.limit_val; }
            let mut lo_grows: Vec<i32> = vec![];
            let mut lo_new = 0;
            let mut lo_taken = 0;
            let mut lo_i = lo_off;
            let mut lo_go = true;
            while lo_go {
                if lo_i >= gkc { lo_go = false; }
                else if lo_taken >= lo_lim { lo_go = false; }
                else {
                    let mut lo_c = 0;
                    while lo_c < ncols {
                        vec_push(lo_grows, vec_get(grows, lo_i * ncols + lo_c));
                        lo_c = lo_c + 1;
                    }
                    lo_new = lo_new + 1;
                    lo_taken = lo_taken + 1;
                    lo_i = lo_i + 1;
                }
            }
            grows = lo_grows;
            gkc = lo_new;
        }

        // Column widths, then render header, separator, one line per group.
        let mut gwidths: Vec<i32> = vec![];
        let mut wi = 0;
        while wi < ncols {
            let wh = sp_get(d, vec_get(gheaders, wi));
            vec_push(gwidths, wh.len());
            wi = wi + 1;
        }
        let mut wr = 0;
        while wr < gkc {
            let mut wc = 0;
            while wc < ncols {
                let wv = sp_get(d, vec_get(grows, wr * ncols + wc));
                let wl = wv.len();
                if wl > vec_get(gwidths, wc) { gwidths = vec_replace(gwidths, ncols, wc, wl); }
                wc = wc + 1;
            }
            wr = wr + 1;
        }
        let mut ghline = "";
        let mut gsline = "";
        let mut hp = 0;
        while hp < ncols {
            if hp > 0 { ghline = ghline + " | "; gsline = gsline + "-+-"; }
            let hh = sp_get(d, vec_get(gheaders, hp));
            let hw = vec_get(gwidths, hp);
            ghline = ghline + pad_right(hh, hw);
            gsline = gsline + make_dashes(hw);
            hp = hp + 1;
        }
        println!("{}", ghline);
        println!("{}", gsline);
        let mut rr = 0;
        while rr < gkc {
            let mut rline = "";
            let mut rc = 0;
            while rc < ncols {
                if rc > 0 { rline = rline + " | "; }
                let rv = sp_get(d, vec_get(grows, rr * ncols + rc));
                let rw = vec_get(gwidths, rc);
                rline = rline + pad_right(rv, rw);
                rc = rc + 1;
            }
            println!("{}", rline);
            rr = rr + 1;
        }
        return;
    }

    // GROUP BY over a JOIN without an aggregate is not yet supported. Fail closed
    // rather than return ungrouped rows, which would be a silent wrong answer.
    // Grouped aggregates are handled above.
    if d.has_group_by == 1 {
        println!("Error: GROUP BY over a JOIN is not supported");
        return;
    }

    // Resolve SELECT columns: each is "table.col" or "alias.col"
    // For each, determine which table (1 or 2) and column index
    let mut sel_table: Vec<i32> = vec![];
    let mut sel_col: Vec<i32> = vec![];
    let mut sel_names: Vec<i32> = vec![];
    let mut sel_count = 0;

    if d.select_star == 1 {
        // All columns from table1 then table2
        let mut ci = 0;
        while ci < cc1 {
            vec_push(sel_table, 1);
            vec_push(sel_col, ci);
            let cn = sp_get(d, vec_get(d.col_names, cs1 + ci));
            let nid = sp_add(d, cn);
            vec_push(sel_names, nid);
            sel_count = sel_count + 1;
            ci = ci + 1;
        }
        ci = 0;
        while ci < cc2 {
            vec_push(sel_table, 2);
            vec_push(sel_col, ci);
            let cn = sp_get(d, vec_get(d.col_names, cs2 + ci));
            let nid = sp_add(d, cn);
            vec_push(sel_names, nid);
            sel_count = sel_count + 1;
            ci = ci + 1;
        }
    } else {
        let mut pi = 0;
        while pi < d.p_agg_count {
            let cref = sp_get(d, vec_get(d.p_agg_cols, pi));
            // Try table1
            let c1 = resolve_col(d, cs1, cc1, tname1, d.alias1, cref);
            if c1 >= 0 {
                vec_push(sel_table, 1);
                vec_push(sel_col, c1);
                let cn = sp_get(d, vec_get(d.col_names, cs1 + c1));
                let nid = sp_add(d, cn);
                vec_push(sel_names, nid);
                sel_count = sel_count + 1;
            } else {
                let c2 = resolve_col(d, cs2, cc2, tname2, d.alias2, cref);
                if c2 >= 0 {
                    vec_push(sel_table, 2);
                    vec_push(sel_col, c2);
                    let cn = sp_get(d, vec_get(d.col_names, cs2 + c2));
                    let nid = sp_add(d, cn);
                    vec_push(sel_names, nid);
                    sel_count = sel_count + 1;
                } else {
                    println!("Error: column '{}' not found in either table", cref);
                    return;
                }
            }
            pi = pi + 1;
        }
    }

    // Nested loop join: collect matching result rows as pool-id strings
    // Store flattened: result_vals[row * sel_count + col] = pool id
    let mut result_vals: Vec<i32> = vec![];
    // Source row indices per emitted result row, kept parallel to result_vals so
    // ORDER BY can reorder rows after assembly. src_r2 = -1 marks a LEFT JOIN
    // null-extended row (the right side is NULL for that row).
    let mut src_r1: Vec<i32> = vec![];
    let mut src_r2: Vec<i32> = vec![];
    let mut result_count = 0;

    let mut r1 = 0;
    while r1 < rc1 {
        let key1 = sp_get(d, vec_get(d.cells, rs1 + r1 * cc1 + jc1));
        let mut matched = false;
        let mut r2 = 0;
        while r2 < rc2 {
            let key2 = sp_get(d, vec_get(d.cells, rs2 + r2 * cc2 + jc2));
            if key1 == key2 {
                // ON matched (equi-join key). Record it independently of WHERE so
                // a LEFT JOIN does not null-extend a left row that matched ON but
                // was later filtered by WHERE — matching SQL outer-join semantics.
                matched = true;
                // Check WHERE if present (evaluate against combined row)
                let mut passes = true;
                if d.has_where == 1 {
                    passes = eval_join_where(d, cs1, cc1, rs1, r1, tname1, d.alias1,
                                             cs2, cc2, rs2, r2, tname2, d.alias2);
                }
                if passes {
                    // Build result row
                    let mut si = 0;
                    while si < sel_count {
                        let st = vec_get(sel_table, si);
                        let sc = vec_get(sel_col, si);
                        let val = if st == 1 {
                            sp_get(d, vec_get(d.cells, rs1 + r1 * cc1 + sc))
                        } else {
                            sp_get(d, vec_get(d.cells, rs2 + r2 * cc2 + sc))
                        };
                        let vid = sp_add(d, val);
                        vec_push(result_vals, vid);
                        si = si + 1;
                    }
                    result_count = result_count + 1;
                    vec_push(src_r1, r1);
                    vec_push(src_r2, r2);
                }
            }
            r2 = r2 + 1;
        }
        // LEFT JOIN: a left row with no ON-match is emitted once with its
        // right-table columns as NULL (empty). WHERE still applies, evaluated
        // with the right columns treated as NULL (r2 = -1).
        if d.join_type == 1 {
            if matched == false {
                let mut lpasses = true;
                if d.has_where == 1 {
                    lpasses = eval_join_where(d, cs1, cc1, rs1, r1, tname1, d.alias1,
                                              cs2, cc2, rs2, 0 - 1, tname2, d.alias2);
                }
                if lpasses {
                    let mut si2 = 0;
                    while si2 < sel_count {
                        let st2 = vec_get(sel_table, si2);
                        let sc2 = vec_get(sel_col, si2);
                        let val2 = if st2 == 1 {
                            sp_get(d, vec_get(d.cells, rs1 + r1 * cc1 + sc2))
                        } else {
                            ""
                        };
                        let vid2 = sp_add(d, val2);
                        vec_push(result_vals, vid2);
                        si2 = si2 + 1;
                    }
                    result_count = result_count + 1;
                    vec_push(src_r1, r1);
                    vec_push(src_r2, 0 - 1);
                }
            }
        }
        r1 = r1 + 1;
    }

    // ORDER BY: the nested loop emits rows in left-table scan order, so apply
    // the sort here (single-table SELECT sorts in exec_select; joins reach this
    // path instead). A key resolves against either joined table, or as a 1-based
    // positional ordinal into the output columns (mapped back to its source
    // table + column so the key materialization below works unchanged); a key on
    // the right side of a null-extended LEFT JOIN row sorts as NULL (empty
    // string). An unresolvable key FAILS CLOSED rather than silently returning
    // scan order.
    if d.has_order == 1 {
        let oname = sp_get(d, d.order_col);
        let mut k1_tab = 0;
        let mut k1_col = 0 - 1;
        let mut k1_type = 2;
        if is_int_str(oname) {
            let n1 = parse_int_str(oname);
            if n1 >= 1 {
                if n1 <= sel_count {
                    let s1 = n1 - 1;
                    k1_tab = vec_get(sel_table, s1);
                    k1_col = vec_get(sel_col, s1);
                    if k1_tab == 1 { k1_type = vec_get(d.col_types, cs1 + k1_col); }
                    else { k1_type = vec_get(d.col_types, cs2 + k1_col); }
                }
            }
        } else {
            let rc_a = resolve_col(d, cs1, cc1, tname1, d.alias1, oname);
            if rc_a >= 0 {
                k1_tab = 1;
                k1_col = rc_a;
                k1_type = vec_get(d.col_types, cs1 + rc_a);
            } else {
                let rc_b = resolve_col(d, cs2, cc2, tname2, d.alias2, oname);
                if rc_b >= 0 {
                    k1_tab = 2;
                    k1_col = rc_b;
                    k1_type = vec_get(d.col_types, cs2 + rc_b);
                }
            }
        }
        if k1_tab == 0 {
            println!("Error: ORDER BY must name a column or a select position");
            return;
        }
        let mut k2_tab = 0;
        let mut k2_col = 0 - 1;
        let mut k2_type = 2;
        if d.order_col2 >= 0 {
            let oname2 = sp_get(d, d.order_col2);
            if is_int_str(oname2) {
                let n2 = parse_int_str(oname2);
                if n2 >= 1 {
                    if n2 <= sel_count {
                        let s2 = n2 - 1;
                        k2_tab = vec_get(sel_table, s2);
                        k2_col = vec_get(sel_col, s2);
                        if k2_tab == 1 { k2_type = vec_get(d.col_types, cs1 + k2_col); }
                        else { k2_type = vec_get(d.col_types, cs2 + k2_col); }
                    }
                }
            } else {
                let rc2a = resolve_col(d, cs1, cc1, tname1, d.alias1, oname2);
                if rc2a >= 0 {
                    k2_tab = 1;
                    k2_col = rc2a;
                    k2_type = vec_get(d.col_types, cs1 + rc2a);
                } else {
                    let rc2b = resolve_col(d, cs2, cc2, tname2, d.alias2, oname2);
                    if rc2b >= 0 {
                        k2_tab = 2;
                        k2_col = rc2b;
                        k2_type = vec_get(d.col_types, cs2 + rc2b);
                    }
                }
            }
            if k2_tab == 0 {
                println!("Error: ORDER BY must name a column or a select position");
                return;
            }
        }
        if k1_tab > 0 {
            // Materialize each result row's key strings from its source rows.
            let mut k1_vals: Vec<i32> = vec![];
            let mut k2_vals: Vec<i32> = vec![];
            let mut kr = 0;
            while kr < result_count {
                let rr1 = vec_get(src_r1, kr);
                let rr2 = vec_get(src_r2, kr);
                let v1 = if k1_tab == 1 {
                    sp_get(d, vec_get(d.cells, rs1 + rr1 * cc1 + k1_col))
                } else {
                    if rr2 < 0 { "" } else { sp_get(d, vec_get(d.cells, rs2 + rr2 * cc2 + k1_col)) }
                };
                vec_push(k1_vals, sp_add(d, v1));
                let v2 = if k2_tab == 1 {
                    sp_get(d, vec_get(d.cells, rs1 + rr1 * cc1 + k2_col))
                } else {
                    if k2_tab == 2 {
                        if rr2 < 0 { "" } else { sp_get(d, vec_get(d.cells, rs2 + rr2 * cc2 + k2_col)) }
                    } else {
                        ""
                    }
                };
                vec_push(k2_vals, sp_add(d, v2));
                kr = kr + 1;
            }
            // Stable selection sort of a row permutation by (k1, k2): only a
            // strict `<` displaces the current best, and j scans low-to-high, so
            // equal rows keep their original emission order.
            let mut used: Vec<i32> = vec![];
            let mut ui = 0;
            while ui < result_count { vec_push(used, 0); ui = ui + 1; }
            let mut perm: Vec<i32> = vec![];
            let mut picked = 0;
            while picked < result_count {
                let mut best = 0 - 1;
                let mut j = 0;
                while j < result_count {
                    if vec_get(used, j) == 0 {
                        if best < 0 {
                            best = j;
                        } else {
                            let va = sp_get(d, vec_get(k1_vals, j));
                            let vb = sp_get(d, vec_get(k1_vals, best));
                            let mut c = compare_vals(va, vb, k1_type);
                            if d.order_desc == 1 { c = 0 - c; }
                            let mut lt = false;
                            if c < 0 {
                                lt = true;
                            } else if c > 0 {
                                lt = false;
                            } else {
                                if k2_tab > 0 {
                                    let sa = sp_get(d, vec_get(k2_vals, j));
                                    let sb = sp_get(d, vec_get(k2_vals, best));
                                    let mut c2 = compare_vals(sa, sb, k2_type);
                                    if d.order_desc2 == 1 { c2 = 0 - c2; }
                                    if c2 < 0 { lt = true; }
                                }
                            }
                            if lt { best = j; }
                        }
                    }
                    j = j + 1;
                }
                let mut new_used: Vec<i32> = vec![];
                let mut k = 0;
                while k < result_count {
                    if k == best { vec_push(new_used, 1); }
                    else { vec_push(new_used, vec_get(used, k)); }
                    k = k + 1;
                }
                used = new_used;
                vec_push(perm, best);
                picked = picked + 1;
            }
            // Rebuild result_vals row-blocks in the sorted order.
            let mut sorted_vals: Vec<i32> = vec![];
            let mut pp = 0;
            while pp < result_count {
                let srcrow = vec_get(perm, pp);
                let mut cc_i = 0;
                while cc_i < sel_count {
                    vec_push(sorted_vals, vec_get(result_vals, srcrow * sel_count + cc_i));
                    cc_i = cc_i + 1;
                }
                pp = pp + 1;
            }
            result_vals = sorted_vals;
        }
    }

    // Calculate widths
    let mut widths: Vec<i32> = vec![];
    let mut wi = 0;
    while wi < sel_count {
        let hdr = sp_get(d, vec_get(sel_names, wi));
        vec_push(widths, hdr.len());
        wi = wi + 1;
    }
    let mut ri = 0;
    while ri < result_count {
        let mut ci = 0;
        while ci < sel_count {
            let val = sp_get(d, vec_get(result_vals, ri * sel_count + ci));
            let vlen = val.len();
            let old_w = vec_get(widths, ci);
            if vlen > old_w { widths = vec_replace(widths, sel_count, ci, vlen); }
            ci = ci + 1;
        }
        ri = ri + 1;
    }

    // Print
    let mut hdr_line = "";
    let mut sep_line = "";
    let mut hi = 0;
    while hi < sel_count {
        if hi > 0 { hdr_line = hdr_line + " | "; sep_line = sep_line + "-+-"; }
        let hdr = sp_get(d, vec_get(sel_names, hi));
        let w = vec_get(widths, hi);
        hdr_line = hdr_line + pad_right(hdr, w);
        sep_line = sep_line + make_dashes(w);
        hi = hi + 1;
    }
    println!("{}", hdr_line);
    println!("{}", sep_line);

    ri = 0;
    while ri < result_count {
        let mut row_line = "";
        let mut ci = 0;
        while ci < sel_count {
            if ci > 0 { row_line = row_line + " | "; }
            let val = sp_get(d, vec_get(result_vals, ri * sel_count + ci));
            let w = vec_get(widths, ci);
            row_line = row_line + pad_right(val, w);
            ci = ci + 1;
        }
        println!("{}", row_line);
        ri = ri + 1;
    }
}

// Fetch one cell value for an assembled JOIN pair. tab selects table 1 or 2;
// col is that table's column index. A LEFT JOIN null-extended pair carries
// r2 < 0, so a table-2 column reads as NULL (empty string).
fn join_cell_str(d: &DB, tab: i32, col: i32, cc1: i32, rs1: i32, r1: i32,
                 cc2: i32, rs2: i32, r2: i32) -> String {
    if tab == 1 {
        return sp_get(d, vec_get(d.cells, rs1 + r1 * cc1 + col));
    }
    if r2 < 0 { return ""; }
    sp_get(d, vec_get(d.cells, rs2 + r2 * cc2 + col))
}

// Fold the HAVING aggregate over the bucket pairs whose group cell equals gkey,
// using the same numeric/text rules as the grouped-JOIN projection fold. Returns
// the aggregate as a string so eval_where can compare it against the RHS literal.
// hstar marks COUNT(*); for COUNT(col)/SUM/AVG/MIN/MAX the arg column is at
// (atab, acol) with column type atype (2 = TEXT).
fn join_having_agg(d: &DB, haf: i32, hstar: bool, atab: i32, acol: i32, atype: i32,
                   gtab: i32, gcol: i32, cc1: i32, rs1: i32, cc2: i32, rs2: i32,
                   gpr1: Vec<i32>, gpr2: Vec<i32>, gpc: i32, gkey: String) -> String {
    if haf == 1 {
        // COUNT(*) counts bucket pairs; COUNT(col) counts non-empty cells.
        let mut cnt = 0;
        let mut k = 0;
        while k < gpc {
            let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, k),
                                   cc2, rs2, vec_get(gpr2, k));
            if gv == gkey {
                if hstar { cnt = cnt + 1; }
                else {
                    let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(gpr1, k),
                                           cc2, rs2, vec_get(gpr2, k));
                    if cv.len() > 0 { cnt = cnt + 1; }
                }
            }
            k = k + 1;
        }
        return int_to_str(cnt);
    }
    // SUM/AVG/MIN/MAX, mirroring the projection fold's af>=2 branch.
    let mut sum_val = 0.0;
    let mut min_val = 999999999.0;
    let mut max_val = 0.0 - 999999999.0;
    let mut min_str = "";
    let mut max_str = "";
    let mut cnt = 0;
    let mut k = 0;
    while k < gpc {
        let gv = join_cell_str(d, gtab, gcol, cc1, rs1, vec_get(gpr1, k),
                               cc2, rs2, vec_get(gpr2, k));
        if gv == gkey {
            let cv = join_cell_str(d, atab, acol, cc1, rs1, vec_get(gpr1, k),
                                   cc2, rs2, vec_get(gpr2, k));
            let nv = cv.parse_float();
            sum_val = sum_val + nv;
            if nv < min_val { min_val = nv; }
            if nv > max_val { max_val = nv; }
            if atype == 2 {
                if cnt == 0 { min_str = cv; max_str = cv; }
                else {
                    if compare_vals(cv, min_str, atype) < 0 { min_str = cv; }
                    if compare_vals(cv, max_str, atype) > 0 { max_str = cv; }
                }
            }
            cnt = cnt + 1;
        }
        k = k + 1;
    }
    if cnt == 0 && (haf == 4 || haf == 5) { return ""; }
    if haf == 4 && atype == 2 { return min_str; }
    if haf == 5 && atype == 2 { return max_str; }
    let mut rv = sum_val;
    if haf == 3 { if cnt > 0 { rv = sum_val / cnt; } else { rv = 0.0; } }
    if haf == 4 { rv = min_val; }
    if haf == 5 { rv = max_val; }
    float_to_str(rv)
}

// Evaluate DNF condition ci for a JOIN row: resolve its column in either
// table, evaluate the operator, then apply the negate flag.
fn eval_cond_join(d: &DB, ci: i32, cs1: i32, cc1: i32, rs1: i32, r1: i32,
                  tname1: String, alias1: i32,
                  cs2: i32, cc2: i32, rs2: i32, r2: i32,
                  tname2: String, alias2: i32) -> bool {
    let wl = sp_get(d, vec_get(d.wc_left, ci));
    let op = vec_get(d.wc_op, ci);
    let c1 = resolve_col(d, cs1, cc1, tname1, alias1, wl);
    let c2 = resolve_col(d, cs2, cc2, tname2, alias2, wl);
    let mut res = false;
    if c1 >= 0 {
        let cv = sp_get(d, vec_get(d.cells, rs1 + r1 * cc1 + c1));
        res = eval_cond_val(d, ci, op, cv);
    } else if c2 >= 0 {
        // r2 < 0 marks a LEFT JOIN null-extended row: the right table has no
        // matching row, so its columns evaluate as NULL (empty string).
        let cv = if r2 < 0 { "" } else { sp_get(d, vec_get(d.cells, rs2 + r2 * cc2 + c2)) };
        res = eval_cond_val(d, ci, op, cv);
    } else {
        if op == 8 { res = true; }
    }
    if vec_get(d.wc_neg, ci) == 1 { res = !res; }
    res
}

// Recursively evaluate the WHERE boolean-expression tree for a JOIN row (either
// table). node < 0 is true; leaf (0) evaluates its condition via eval_cond_join;
// NOT (3) negates its child; AND (1) / OR (2) combine both children.
fn eval_join_tree(d: &DB, node: i32, cs1: i32, cc1: i32, rs1: i32, r1: i32,
                  tname1: String, alias1: i32,
                  cs2: i32, cc2: i32, rs2: i32, r2: i32,
                  tname2: String, alias2: i32) -> bool {
    if node < 0 { return true; }
    let k = vec_get(d.wn_kind, node);
    if k == 0 {
        return eval_cond_join(d, vec_get(d.wn_a, node), cs1, cc1, rs1, r1, tname1, alias1, cs2, cc2, rs2, r2, tname2, alias2);
    }
    if k == 3 {
        return !eval_join_tree(d, vec_get(d.wn_a, node), cs1, cc1, rs1, r1, tname1, alias1, cs2, cc2, rs2, r2, tname2, alias2);
    }
    let la = eval_join_tree(d, vec_get(d.wn_a, node), cs1, cc1, rs1, r1, tname1, alias1, cs2, cc2, rs2, r2, tname2, alias2);
    let rb = eval_join_tree(d, vec_get(d.wn_b, node), cs1, cc1, rs1, r1, tname1, alias1, cs2, cc2, rs2, r2, tname2, alias2);
    if k == 1 { return la && rb; }
    if k == 2 { return la || rb; }
    true
}

// Evaluate WHERE for a JOIN row (checks both tables) by walking the
// boolean-expression tree from wc_root.
fn eval_join_where(d: &DB, cs1: i32, cc1: i32, rs1: i32, r1: i32,
                   tname1: String, alias1: i32,
                   cs2: i32, cc2: i32, rs2: i32, r2: i32,
                   tname2: String, alias2: i32) -> bool {
    if d.has_where == 0 { return true; }
    if d.wc_count == 0 { return true; }
    eval_join_tree(d, d.wc_root, cs1, cc1, rs1, r1, tname1, alias1, cs2, cc2, rs2, r2, tname2, alias2)
}

// Execute UPDATE. Scans all cells for the target table, replacing the
// SET column value for rows that match the WHERE condition. Rebuilds
// the entire cells array (no in-place mutation due to Vec immutability
// constraints). Rebuilds affected indexes afterward.
fn exec_update(d: &mut DB) ~ Console {
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // Validate the WHERE columns before mutating any cell, so an unknown column
    // leaves the table untouched instead of silently updating zero rows.
    if !where_cols_ok(d, cs, cc, tname, d.alias1) { return; }

    let set_col_name = sp_get(d, d.set_col);
    let set_val_text = sp_get(d, d.set_val);
    let scol = find_col(d, cs, cc, set_col_name);
    if scol < 0 {
        println!("Error: column '{}' not found", set_col_name);
        return;
    }

    // Arithmetic RHS (SET col = col <op> literal): validate before mutating.
    let mut operand_int = 0;
    if d.set_op >= 0 {
        let left_name = sp_get(d, d.set_val);
        if left_name != set_col_name {
            println!("Error: UPDATE arithmetic must reference column '{}'", set_col_name);
            return;
        }
        let operand_txt = sp_get(d, d.set_operand);
        if is_int_str(operand_txt) == false {
            println!("Error: UPDATE arithmetic operand must be an integer");
            return;
        }
        operand_int = parse_int_str(operand_txt);
        if d.set_op == 3 {
            if operand_int == 0 {
                println!("Error: UPDATE division by zero");
                return;
            }
        }
    }

    let new_val_id = sp_add(d, set_val_text);
    let total_cells = vec_len(d.cells);
    let mut new_cells: Vec<i32> = vec![];
    let mut updated = 0;
    let mut arith_err = false;
    let mut ci: i64 = 0;
    while ci < total_cells {
        let mut cell_id = vec_get(d.cells, ci);
        if ci >= rs {
            let offset = ci - rs;
            if offset < rc * cc {
                let row_in_tbl = offset / cc;
                let col_in_row = offset - row_in_tbl * cc;
                if col_in_row == scol {
                    let do_update = eval_compound_where(d, cs, cc, rs, row_in_tbl, tname, d.alias1);
                    if do_update {
                        if d.set_op >= 0 {
                            let cur = sp_get(d, cell_id);
                            if is_int_str(cur) {
                                let a = parse_int_str(cur);
                                let mut r = 0;
                                if d.set_op == 0 { r = a + operand_int; }
                                else if d.set_op == 1 { r = a - operand_int; }
                                else if d.set_op == 2 { r = a * operand_int; }
                                else { r = a / operand_int; }
                                cell_id = sp_add(d, int_to_str(r));
                            } else {
                                arith_err = true;
                            }
                        } else {
                            cell_id = new_val_id;
                        }
                        updated = updated + 1;
                    }
                }
            }
        }
        vec_push(new_cells, cell_id);
        ci = ci + 1;
    }
    if arith_err {
        println!("Error: UPDATE arithmetic on a non-integer value in column '{}'", set_col_name);
        return;
    }
    d.cells = new_cells;
    update_indexes_for_table(d, tidx);
}

// Execute DELETE FROM. Rebuilds the cells array, skipping rows that match
// the WHERE condition. Adjusts row counts and row starts for all tables.
// Rebuilds affected indexes afterward.
fn exec_delete(d: &mut DB) ~ Console {
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // Validate the WHERE columns before deciding which rows to drop, so an
    // unknown column deletes nothing instead of silently matching zero rows.
    if !where_cols_ok(d, cs, cc, tname, d.alias1) { return; }

    // Find rows to keep using compound WHERE
    let mut keep_rows: Vec<i32> = vec![];
    let mut keep_count = 0;
    let mut r = 0;
    while r < rc {
        let should_delete = eval_compound_where(d, cs, cc, rs, r, tname, d.alias1);
        if !should_delete {
            vec_push(keep_rows, r);
            keep_count = keep_count + 1;
        }
        r = r + 1;
    }

    let deleted = rc - keep_count;
    if deleted == 0 { return; }

    // Rebuild cells: copy non-table cells, then kept rows, then rest
    let total_cells = vec_len(d.cells);
    let mut new_cells: Vec<i32> = vec![];

    // Copy cells before this table's rows
    let mut ci: i64 = 0;
    while ci < rs {
        vec_push(new_cells, vec_get(d.cells, ci));
        ci = ci + 1;
    }

    // Copy kept rows
    let mut ki = 0;
    while ki < keep_count {
        let row = vec_get(keep_rows, ki);
        let mut col = 0;
        while col < cc {
            vec_push(new_cells, vec_get(d.cells, rs + row * cc + col));
            col = col + 1;
        }
        ki = ki + 1;
    }

    // Copy cells after this table's rows
    let after = rs + rc * cc;
    ci = after;
    while ci < total_cells {
        vec_push(new_cells, vec_get(d.cells, ci));
        ci = ci + 1;
    }
    d.cells = new_cells;

    // Update row count
    let mut new_rc: Vec<i32> = vec![];
    let mut ri = 0;
    while ri < d.tbl_count {
        if ri == tidx { vec_push(new_rc, keep_count); }
        else { vec_push(new_rc, vec_get(d.tbl_row_counts, ri)); }
        ri = ri + 1;
    }
    d.tbl_row_counts = new_rc;

    // Update row_starts for tables after this one
    let shift = deleted * cc;
    let mut new_rs: Vec<i32> = vec![];
    let mut si = 0;
    while si < d.tbl_count {
        if si > tidx {
            vec_push(new_rs, vec_get(d.tbl_row_starts, si) - shift);
        } else {
            vec_push(new_rs, vec_get(d.tbl_row_starts, si));
        }
        si = si + 1;
    }
    d.tbl_row_starts = new_rs;

    update_indexes_for_table(d, tidx);
}

fn exec_drop(d: &mut DB) ~ Console {
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }

    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);
    let cell_count = rc * cc;

    // Rebuild all arrays without this table

    // Remove cells
    let total_cells = vec_len(d.cells);
    let mut new_cells: Vec<i32> = vec![];
    let mut ci: i64 = 0;
    while ci < rs {
        vec_push(new_cells, vec_get(d.cells, ci));
        ci = ci + 1;
    }
    ci = rs + cell_count;
    while ci < total_cells {
        vec_push(new_cells, vec_get(d.cells, ci));
        ci = ci + 1;
    }
    d.cells = new_cells;

    // Remove column defs
    let total_cols = vec_len(d.col_names);
    let mut new_cn: Vec<i32> = vec![];
    let mut new_ct: Vec<i32> = vec![];
    let mut coi: i64 = 0;
    while coi < total_cols {
        if coi < cs || coi >= cs + cc {
            vec_push(new_cn, vec_get(d.col_names, coi));
            vec_push(new_ct, vec_get(d.col_types, coi));
        }
        coi = coi + 1;
    }
    d.col_names = new_cn;
    d.col_types = new_ct;

    // Rebuild table arrays
    let mut new_tn: Vec<i32> = vec![];
    let mut new_tcs: Vec<i32> = vec![];
    let mut new_tcc: Vec<i32> = vec![];
    let mut new_trs: Vec<i32> = vec![];
    let mut new_trc: Vec<i32> = vec![];
    let mut ti = 0;
    while ti < d.tbl_count {
        if ti != tidx {
            vec_push(new_tn, vec_get(d.tbl_names, ti));
            let old_cs = vec_get(d.tbl_col_starts, ti);
            let adj_cs = if ti > tidx { old_cs - cc } else { old_cs };
            vec_push(new_tcs, adj_cs);
            vec_push(new_tcc, vec_get(d.tbl_col_counts, ti));
            let old_rs = vec_get(d.tbl_row_starts, ti);
            let adj_rs = if ti > tidx { old_rs - cell_count } else { old_rs };
            vec_push(new_trs, adj_rs);
            vec_push(new_trc, vec_get(d.tbl_row_counts, ti));
        }
        ti = ti + 1;
    }
    d.tbl_names = new_tn;
    d.tbl_col_starts = new_tcs;
    d.tbl_col_counts = new_tcc;
    d.tbl_row_starts = new_trs;
    d.tbl_row_counts = new_trc;
    d.tbl_count = d.tbl_count - 1;
}

// =============================================================================
// ALTER TABLE ADD COLUMN
// =============================================================================
fn exec_alter_table(d: &mut DB) ~ Console {
    let tname = sp_get(d, d.p_table);
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }

    let new_col_name = sp_get(d, d.alter_col_name);
    let new_col_type_str = sp_get(d, d.alter_col_type);
    let type_up = new_col_type_str.to_uppercase();
    let ct = type_code_for(type_up);

    let cs = vec_get(d.tbl_col_starts, tidx);
    let old_cc = vec_get(d.tbl_col_counts, tidx);
    let new_cc = old_cc + 1;
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // 1. Insert the new column definition into col_names/col_types at position cs + old_cc
    let insert_col_at = cs + old_cc;
    let total_cols = vec_len(d.col_names);
    let mut new_cn: Vec<i32> = vec![];
    let mut new_ct: Vec<i32> = vec![];
    let mut ci: i64 = 0;
    while ci < insert_col_at {
        vec_push(new_cn, vec_get(d.col_names, ci));
        vec_push(new_ct, vec_get(d.col_types, ci));
        ci = ci + 1;
    }
    let cnid = sp_add(d, new_col_name);
    vec_push(new_cn, cnid);
    vec_push(new_ct, ct);
    while ci < total_cols {
        vec_push(new_cn, vec_get(d.col_names, ci));
        vec_push(new_ct, vec_get(d.col_types, ci));
        ci = ci + 1;
    }
    d.col_names = new_cn;
    d.col_types = new_ct;

    // 2. Update tbl_col_counts for this table
    d.tbl_col_counts = vec_replace(d.tbl_col_counts, d.tbl_count, tidx, new_cc);

    // 3. Shift col_starts for tables after this one (they gained 1 col def)
    let mut new_tcs: Vec<i32> = vec![];
    let mut ti = 0;
    while ti < d.tbl_count {
        if ti > tidx {
            vec_push(new_tcs, vec_get(d.tbl_col_starts, ti) + 1);
        } else {
            vec_push(new_tcs, vec_get(d.tbl_col_starts, ti));
        }
        ti = ti + 1;
    }
    d.tbl_col_starts = new_tcs;

    // 4. For each existing row, insert an empty-string cell at the end of that row's data.
    // The NULL sentinel is an empty string "".
    let null_id = sp_add(d, "");
    let total_cells = vec_len(d.cells);
    let mut new_cells: Vec<i32> = vec![];

    // Copy cells before this table
    let mut cell_i: i64 = 0;
    while cell_i < rs {
        vec_push(new_cells, vec_get(d.cells, cell_i));
        cell_i = cell_i + 1;
    }

    // For each row in the table, copy old_cc cells then add NULL
    let mut r = 0;
    while r < rc {
        let row_start = rs + r * old_cc;
        let mut col = 0;
        while col < old_cc {
            vec_push(new_cells, vec_get(d.cells, row_start + col));
            col = col + 1;
        }
        vec_push(new_cells, null_id);
        r = r + 1;
    }

    // Copy cells after this table
    cell_i = rs + rc * old_cc;
    while cell_i < total_cells {
        vec_push(new_cells, vec_get(d.cells, cell_i));
        cell_i = cell_i + 1;
    }
    d.cells = new_cells;

    // 5. Update row_starts for tables after this one
    // Each row grew by 1 cell, so total added = rc cells
    let shift = rc;
    let mut new_trs: Vec<i32> = vec![];
    let mut si = 0;
    while si < d.tbl_count {
        if si > tidx {
            vec_push(new_trs, vec_get(d.tbl_row_starts, si) + shift);
        } else {
            vec_push(new_trs, vec_get(d.tbl_row_starts, si));
        }
        si = si + 1;
    }
    d.tbl_row_starts = new_trs;

    // 6. Rebuild indexes for this table
    update_indexes_for_table(d, tidx);
}

// =========================================================================
// SECTION 7: HELPERS — WHERE Evaluation, Sorting, Formatting
// =========================================================================
// Pure or nearly-pure helper functions used by the executor.
//
// WHERE evaluation:
//   eval_where()          — evaluate a single comparison (op codes 0-9)
//   eval_compound_where() — evaluate the DNF WHERE (OR of AND-groups) for a row
//   eval_like()           — LIKE pattern matching (%, starts_with/ends_with/contains)
//   eval_in_pool()        — IN membership test against a condition's pool slice
//
// Sorting:
//   sort_rows()           — selection sort on row indices by column value
//   compare_vals()        — compare two values (numeric or string)
//
// Formatting:
//   pad_right(), pad_left(), make_dashes() — output alignment
//   print_result_row()    — print a single formatted result row
// =========================================================================

fn get_cell_float(d: &DB, rs: i32, row: i32, cc: i32, col_idx: i32) -> f64 {
    let cell_val = sp_get(d, vec_get(d.cells, rs + row * cc + col_idx));
    cell_val.parse_float()
}

fn find_col(d: &DB, cs: i32, cc: i32, name: String) -> i32 {
    let mut i = 0;
    while i < cc {
        let cn = sp_get(d, vec_get(d.col_names, cs + i));
        if cn == name { return i; }
        i = i + 1;
    }
    0 - 1
}

fn eval_where(cell_val: String, op: i32, rval: String) -> bool {
    // Try numeric comparison first
    let cv_num = cell_val.parse_float();
    let rv_num = rval.parse_float();
    let is_num_cmp = is_numeric_str(cell_val) && is_numeric_str(rval);

    // LIKE operator (op 6)
    if op == 6 { return eval_like(cell_val, rval); }
    // IS NULL (op 8): cell is empty string
    if op == 8 {
        let clen = cell_val.len();
        return clen == 0;
    }
    // IS NOT NULL (op 9): cell is not empty
    if op == 9 {
        let clen = cell_val.len();
        return clen > 0;
    }
    // IN (op 7) is handled separately in eval_compound_where

    if is_num_cmp {
        if op == 0 { return cv_num == rv_num; }
        if op == 1 { return cv_num < rv_num; }
        if op == 2 { return cv_num > rv_num; }
        if op == 3 { return cv_num <= rv_num; }
        if op == 4 { return cv_num >= rv_num; }
        if op == 5 { return cv_num != rv_num; }
    }
    // String comparison
    let cmp = cell_val.compare(rval);
    if op == 0 { return cmp == 0; }
    if op == 1 { return cmp < 0; }
    if op == 2 { return cmp > 0; }
    if op == 3 { return cmp <= 0; }
    if op == 4 { return cmp >= 0; }
    if op == 5 { return cmp != 0; }
    false
}

// LIKE pattern matching. Full SQL wildcards: '%' matches any run of characters
// (including none) at any position; '_' matches exactly one character. All other
// characters match literally. Iterative backtracking, so '%' anywhere is handled.
fn eval_like(cell_val: String, pattern: String) -> bool {
    let slen = cell_val.len();
    let plen = pattern.len();
    let mut si = 0;
    let mut pi = 0;
    let mut star = -1;   // pattern index just after the last '%' seen, or -1
    let mut star_s = 0;  // string index to resume from on backtrack
    let mut decided = false;
    let mut result = false;
    let mut go = true;
    while go {
        if si >= slen {
            go = false;
        } else if pi < plen {
            let pc = pattern.char_at(pi);
            let sc = cell_val.char_at(si);
            if pc == "_" || pc == sc {
                si = si + 1;
                pi = pi + 1;
            } else if pc == "%" {
                star = pi + 1;
                star_s = si;
                pi = pi + 1;
            } else if star >= 0 {
                pi = star;
                star_s = star_s + 1;
                si = star_s;
            } else {
                result = false;
                decided = true;
                go = false;
            }
        } else if star >= 0 {
            pi = star;
            star_s = star_s + 1;
            si = star_s;
        } else {
            result = false;
            decided = true;
            go = false;
        }
    }
    if decided { return result; }
    // All of the string consumed; any trailing pattern must be only '%'.
    let mut tgo = true;
    while tgo {
        if pi < plen {
            if pattern.char_at(pi) == "%" { pi = pi + 1; }
            else { tgo = false; }
        } else { tgo = false; }
    }
    pi == plen
}

fn is_numeric_str(s: String) -> bool {
    let slen = s.len();
    if slen == 0 { return false; }
    let mut i = 0;
    let first = s.char_at(0);
    if first == "-" { i = 1; }
    if i >= slen { return false; }
    let d0 = s.char_at(i);
    if !is_digit(d0) { return false; }
    let mut has_dot = false;
    while i < slen {
        let ch = s.char_at(i);
        if is_digit(ch) { i = i + 1; }
        else if ch == "." {
            if has_dot { return false; }
            has_dot = true;
            i = i + 1;
        }
        else { return false; }
    }
    true
}

// True only for a signed decimal integer (no dot). parse_int_str ignores a
// dot, so integer-only UPDATE arithmetic gates on this, not is_numeric_str.
fn is_int_str(s: String) -> bool {
    if is_numeric_str(s) == false { return false; }
    if s.index_of(".") >= 0 { return false; }
    true
}

// Map a declared column type name to its internal storage code:
//   0 = INTEGER, 1 = REAL, 2 = TEXT.
// Recognizes the common SQL aliases (INT, BIGINT, FLOAT, DOUBLE, ...) so an INT
// column sorts and right-justifies as a number instead of comparing
// lexicographically as text. `type_up` must already be uppercased; anything
// unrecognized is TEXT. Numeric codes 0 and 1 both drive numeric comparison in
// compare_vals, so an alias mapped to either sorts correctly.
fn type_code_for(type_up: String) -> i32 {
    if type_up == "INTEGER" { return 0; }
    if type_up == "INT" { return 0; }
    if type_up == "SMALLINT" { return 0; }
    if type_up == "BIGINT" { return 0; }
    if type_up == "TINYINT" { return 0; }
    if type_up == "MEDIUMINT" { return 0; }
    if type_up == "REAL" { return 1; }
    if type_up == "FLOAT" { return 1; }
    if type_up == "DOUBLE" { return 1; }
    if type_up == "NUMERIC" { return 1; }
    if type_up == "DECIMAL" { return 1; }
    return 2;
}

// Order two rows by the primary key, breaking ties on the secondary key
// (ocol2 < 0 means no secondary). Returns <0 if rowa should come before rowb,
// >0 if after, 0 if equal under both keys. desc flags flip each key.
fn cmp_rows_2key(d: &DB, rowa: i32, rowb: i32, rs: i32, cc: i32, ocol: i32, ocol_type: i32, desc: i32, ocol2: i32, ocol2_type: i32, desc2: i32) -> i64 {
    let va = sp_get(d, vec_get(d.cells, rs + rowa * cc + ocol));
    let vb = sp_get(d, vec_get(d.cells, rs + rowb * cc + ocol));
    let mut c = compare_vals(va, vb, ocol_type);
    if desc == 1 { c = 0 - c; }
    if c < 0 { return c; }
    if c > 0 { return c; }
    if ocol2 >= 0 {
        let sa = sp_get(d, vec_get(d.cells, rs + rowa * cc + ocol2));
        let sb = sp_get(d, vec_get(d.cells, rs + rowb * cc + ocol2));
        let mut c2 = compare_vals(sa, sb, ocol2_type);
        if desc2 == 1 { c2 = 0 - c2; }
        return c2;
    }
    0
}

fn sort_rows(d: &DB, rows: Vec<i32>, count: i32, rs: i32, cc: i32, ocol: i32, ocol_type: i32, desc: i32, ocol2: i32, ocol2_type: i32, desc2: i32) -> Vec<i32> {
    // Selection sort, stable: primary key, then secondary key on ties, then
    // original insertion order (a strict `< 0` pick never displaces an equal).
    let mut used: Vec<i32> = vec![];
    let mut i = 0;
    while i < count {
        vec_push(used, 0);
        i = i + 1;
    }

    let mut result: Vec<i32> = vec![];
    let mut picked = 0;
    while picked < count {
        let mut best = 0 - 1;
        let mut j = 0;
        while j < count {
            if vec_get(used, j) == 0 {
                if best < 0 {
                    best = j;
                } else {
                    let cand_row = vec_get(rows, j);
                    let best_row = vec_get(rows, best);
                    let c = cmp_rows_2key(d, cand_row, best_row, rs, cc, ocol, ocol_type, desc, ocol2, ocol2_type, desc2);
                    if c < 0 { best = j; }
                }
            }
            j = j + 1;
        }
        // Mark used
        let mut new_used: Vec<i32> = vec![];
        let mut k = 0;
        while k < count {
            if k == best { vec_push(new_used, 1); }
            else { vec_push(new_used, vec_get(used, k)); }
            k = k + 1;
        }
        used = new_used;
        vec_push(result, vec_get(rows, best));
        picked = picked + 1;
    }
    result
}

fn compare_vals(a: String, b: String, col_type: i32) -> i64 {
    if col_type == 0 || col_type == 1 {
        let na = a.parse_float();
        let nb = b.parse_float();
        if na < nb { return 0 - 1; }
        if na > nb { return 1; }
        return 0;
    }
    a.compare(b)
}

fn pad_right(s: String, w: i32) -> String {
    let slen = s.len();
    let mut out = s;
    let mut i = slen;
    while i < w {
        out = out + " ";
        i = i + 1;
    }
    out
}

fn pad_left(s: String, w: i32) -> String {
    let slen = s.len();
    let mut out = "";
    let mut i = slen;
    while i < w {
        out = out + " ";
        i = i + 1;
    }
    out + s
}

fn make_dashes(w: i32) -> String {
    let mut out = "";
    let mut i = 0;
    while i < w {
        out = out + "-";
        i = i + 1;
    }
    out
}

// --- Numeric / String Conversion ---
// BuildLang has limited stdlib for number formatting, so these are
// hand-rolled: int_to_str, float_to_str, digit_char, int_part_str.

fn int_to_str(n: i32) -> String {
    if n == 0 { return "0"; }
    let mut val = n;
    let mut neg = false;
    if val < 0 { neg = true; val = 0 - val; }
    let mut out = "";
    let mut go = true;
    while go {
        if val == 0 { go = false; }
        else {
            let digit = val - (val / 10) * 10;
            let ch = if digit == 0 { "0" } else if digit == 1 { "1" }
                else if digit == 2 { "2" } else if digit == 3 { "3" }
                else if digit == 4 { "4" } else if digit == 5 { "5" }
                else if digit == 6 { "6" } else if digit == 7 { "7" }
                else if digit == 8 { "8" } else { "9" };
            out = ch + out;
            val = val / 10;
        }
    }
    if neg { out = "-" + out; }
    out
}

fn digit_char(d: i32) -> String {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    "9"
}

fn float_to_str(f: f64) -> String {
    // Handle zero
    if f == 0.0 { return "0"; }
    let neg = f < 0.0;
    let abs_f = if neg { 0.0 - f } else { f };
    // Multiply by 100, round to integer, then extract int and decimal parts
    // Use i32 cast via parse trick: format as int
    let scaled = abs_f * 100.0 + 0.5;
    // Floor to integer by subtracting 0.5 and comparing
    let int_val = parse_int_str(int_part_str(scaled));
    let int_portion = int_val / 100;
    let rem = int_val - int_portion * 100;
    let d1 = rem / 10;
    let d0 = rem - d1 * 10;
    let int_str = int_to_str(int_portion);
    let prefix = if neg { "-" + int_str } else { int_str };
    if d1 == 0 && d0 == 0 { return prefix; }
    if d0 == 0 { return prefix + "." + digit_char(d1); }
    prefix + "." + digit_char(d1) + digit_char(d0)
}

// Extract integer part of a float as a string (manual floor)
fn int_part_str(f: f64) -> String {
    // Build string by extracting digits from the integer portion
    if f < 1.0 { return "0"; }
    let mut result = "";
    let mut remaining = f;
    // Find the largest power of 10
    let mut pow10 = 1.0;
    let mut going = true;
    while going {
        if pow10 * 10.0 > remaining { going = false; }
        else { pow10 = pow10 * 10.0; }
    }
    // Extract digits
    let mut extracting = true;
    while extracting {
        if pow10 < 1.0 { extracting = false; }
        else {
            let mut digit = 0;
            let mut sub = true;
            while sub {
                if remaining >= pow10 {
                    remaining = remaining - pow10;
                    digit = digit + 1;
                } else { sub = false; }
            }
            result = result + digit_char(digit);
            pow10 = pow10 / 10.0;
        }
    }
    if result == "" { return "0"; }
    result
}

// =============================================================================
// VEC HELPER: rebuild vec with one element replaced
// =============================================================================
fn vec_replace(v: Vec<i32>, vlen: i32, idx: i32, new_val: i32) -> Vec<i32> {
    let mut result: Vec<i32> = vec![];
    let mut i = 0;
    while i < vlen {
        if i == idx { vec_push(result, new_val); }
        else { vec_push(result, vec_get(v, i)); }
        i = i + 1;
    }
    result
}

// =============================================================================
// PRINT HELPERS
// =============================================================================

fn print_result_row(d: &DB, headers: Vec<i32>, results: Vec<i32>, count: i32) ~ Console {
    // Calculate widths
    let mut widths: Vec<i32> = vec![];
    let mut wi = 0;
    while wi < count {
        let hdr = sp_get(d, vec_get(headers, wi));
        let val = sp_get(d, vec_get(results, wi));
        let hw = hdr.len();
        let vw = val.len();
        let w = if hw > vw { hw } else { vw };
        vec_push(widths, w);
        wi = wi + 1;
    }
    // Print header
    let mut hdr_line = "";
    let mut sep_line = "";
    let mut hi = 0;
    while hi < count {
        if hi > 0 { hdr_line = hdr_line + " | "; sep_line = sep_line + "-+-"; }
        let hdr = sp_get(d, vec_get(headers, hi));
        let w = vec_get(widths, hi);
        hdr_line = hdr_line + pad_right(hdr, w);
        sep_line = sep_line + make_dashes(w);
        hi = hi + 1;
    }
    println!("{}", hdr_line);
    println!("{}", sep_line);
    // Print value row
    let mut row_line = "";
    let mut ri = 0;
    while ri < count {
        if ri > 0 { row_line = row_line + " | "; }
        let val = sp_get(d, vec_get(results, ri));
        let w = vec_get(widths, ri);
        row_line = row_line + pad_right(val, w);
        ri = ri + 1;
    }
    println!("{}", row_line);
}

// =========================================================================
// SECTION 8: INDEX — Sorted-Array Indexes with Binary Search
// =========================================================================
// Each index maintains sorted (key, rowid) pairs in flattened parallel arrays.
// idx_keys[start..start+count] and idx_rowids[start..start+count] hold the
// sorted entries for one index.
//
// Key operations:
//   find_index_for()  — look up whether an index exists for a table+column
//   rebuild_index()   — reconstruct sorted pairs from table rows (merge sort)
//   refresh_index()   — bring an index up to date before a read (lazy)
//   index_scan()      — binary search (equality) or linear scan (range)
//   update_indexes_for_table() — mark indexes for rebuild after UPDATE/DELETE/ALTER
//   exec_create_index() — CREATE INDEX handler
// =========================================================================

// Find an index on table tidx, column col_idx. Returns index id or -1.
fn find_index_for(d: &DB, tidx: i32, col_idx: i32) -> i32 {
    let mut i = 0;
    while i < d.idx_count {
        if vec_get(d.idx_tables, i) == tidx {
            if vec_get(d.idx_col_indices, i) == col_idx {
                return i;
            }
        }
        i = i + 1;
    }
    0 - 1
}

// Rebuild index data from table rows. Called by db_load, CREATE INDEX, and
// refresh_index after UPDATE, DELETE, ALTER or ROLLBACK. Collects all
// (key, rowid) pairs for the indexed column, sorts them with the stable merge
// sort in sort_positions, then replaces this index's entries in the
// flattened idx_keys/idx_rowids arrays.
fn rebuild_index(d: &mut DB, ix_id: i32) {
    let tidx = vec_get(d.idx_tables, ix_id);
    let col_i = vec_get(d.idx_col_indices, ix_id);
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);

    // Collect (key_pool_id, row_index) pairs
    let mut keys: Vec<i32> = vec![];
    let mut rowids: Vec<i32> = vec![];
    let mut r = 0;
    while r < rc {
        let cell_id = vec_get(d.cells, rs + r * cc + col_i);
        vec_push(keys, cell_id);
        vec_push(rowids, r);
        r = r + 1;
    }

    // Sort by key value (numeric if possible, else string), stable
    let col_type = vec_get(d.col_types, cs + col_i);
    let perm = sort_positions(d, keys, rc, col_type);
    let mut sorted_keys: Vec<i32> = vec![];
    let mut sorted_rowids: Vec<i32> = vec![];
    let mut pi = 0;
    while pi < rc {
        let p = vec_get(perm, pi);
        vec_push(sorted_keys, vec_get(keys, p));
        vec_push(sorted_rowids, vec_get(rowids, p));
        pi = pi + 1;
    }
    splice_index(d, ix_id, sorted_keys, sorted_rowids, rc);
}

// Scan an index for rows matching a WHERE condition.
// For equality (op==0): binary search to find the key, then scan left/right
// for duplicates. For range queries: linear scan of the sorted array.
// Returns a Vec of row indices that match.
fn index_scan(d: &DB, ix_id: i32, op: i32, rval: String) -> Vec<i32> {
    let ks = vec_get(d.idx_key_starts, ix_id);
    let kc = vec_get(d.idx_key_counts, ix_id);
    let tidx = vec_get(d.idx_tables, ix_id);
    let col_i = vec_get(d.idx_col_indices, ix_id);
    let tcs = vec_get(d.tbl_col_starts, tidx);
    let col_type = vec_get(d.col_types, tcs + col_i);

    let mut result: Vec<i32> = vec![];

    if op == 0 {
        // Equality: binary search for the value
        let mut lo = 0;
        let mut hi = kc - 1;
        let mut found_pos = 0 - 1;
        let mut searching = true;
        while searching {
            if lo > hi { searching = false; }
            else {
                let mid = (lo + hi) / 2;
                let mval = sp_get(d, vec_get(d.idx_keys, ks + mid));
                let cmp = compare_vals(mval, rval, col_type);
                if cmp == 0 { found_pos = mid; searching = false; }
                else if cmp < 0 { lo = mid + 1; }
                else { hi = mid - 1; }
            }
        }
        if found_pos >= 0 {
            // Scan left and right for duplicates
            let mut left = found_pos;
            let mut lgo = true;
            while lgo {
                if left <= 0 { lgo = false; }
                else {
                    let lv = sp_get(d, vec_get(d.idx_keys, ks + left - 1));
                    let lc = compare_vals(lv, rval, col_type);
                    if lc == 0 { left = left - 1; }
                    else { lgo = false; }
                }
            }
            let mut right = found_pos;
            let mut rgo = true;
            while rgo {
                if right >= kc - 1 { rgo = false; }
                else {
                    let rv = sp_get(d, vec_get(d.idx_keys, ks + right + 1));
                    let rc2 = compare_vals(rv, rval, col_type);
                    if rc2 == 0 { right = right + 1; }
                    else { rgo = false; }
                }
            }
            let mut si3 = left;
            while si3 <= right {
                vec_push(result, vec_get(d.idx_rowids, ks + si3));
                si3 = si3 + 1;
            }
        }
    } else {
        // For range queries, linear scan the sorted index
        // (could be optimized with binary search to find start point)
        let mut si3 = 0;
        while si3 < kc {
            let kval = sp_get(d, vec_get(d.idx_keys, ks + si3));
            if eval_where(kval, op, rval) {
                vec_push(result, vec_get(d.idx_rowids, ks + si3));
            }
            si3 = si3 + 1;
        }
    }
    result
}

// Mark indexes for a full rebuild after a mutation that moves or rewrites
// existing rows (UPDATE, DELETE, ALTER). The rebuild runs on the next index
// read, so a run of mutations pays for one rebuild, not one per statement.
// tidx is kept for the call sites; every index is invalidated, which is the
// simple safe choice because row ids are table-relative and DELETE shifts them.
fn update_indexes_for_table(d: &mut DB, tidx: i32) {
    if tidx >= 0 { d.idx_stale = true; }
}

// Bring one index up to date before a read. Two cases:
//   - d.idx_stale: some mutation moved or rewrote rows. Rebuild every index
//     from its table (O(n log n) each) and clear the flag.
//   - the index covers fewer keys than the table has rows: only INSERTs ran
//     since the last refresh, and they appended rows with the highest row
//     ids. Sort just the new rows and merge them after equal existing keys,
//     O(n + k log k). The order matches a full stable rebuild exactly.
fn refresh_index(d: &mut DB, ix_id: i32) {
    if d.idx_stale {
        let mut i = 0;
        while i < d.idx_count {
            // DROP TABLE leaves its indexes behind (a known gap); skip any
            // whose table index no longer exists instead of reading past it.
            if vec_get(d.idx_tables, i) < d.tbl_count { rebuild_index(d, i); }
            i = i + 1;
        }
        d.idx_stale = false;
        return;
    }
    let tidx = vec_get(d.idx_tables, ix_id);
    if tidx >= d.tbl_count { return; }
    let rc = vec_get(d.tbl_row_counts, tidx);
    let kc = vec_get(d.idx_key_counts, ix_id);
    if kc < rc { merge_new_rows(d, ix_id, kc); }
}

// Stable merge sort of positions 0..n by the pool strings keys[pos], using
// compare_vals. Equal keys keep their input order, which is row-id order, so
// the result equals the selection sort this replaced (it took the first
// minimum on each pick) at O(n log n) instead of O(n^2).
fn sort_positions(d: &DB, keys: Vec<i32>, n: i32, col_type: i32) -> Vec<i32> {
    let mut src: Vec<i32> = vec![];
    let mut dst: Vec<i32> = vec![];
    let mut i = 0;
    while i < n {
        vec_push(src, i);
        vec_push(dst, i);
        i = i + 1;
    }
    let mut width = 1;
    while width < n {
        let mut lo = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut a = lo;
            let mut b = mid;
            let mut o = lo;
            while o < hi {
                let mut take_a = false;
                if a < mid {
                    if b >= hi { take_a = true; }
                    else {
                        let ka = sp_get(d, vec_get(keys, vec_get(src, a)));
                        let kb = sp_get(d, vec_get(keys, vec_get(src, b)));
                        // <= keeps the left (lower row id) element first on ties
                        if compare_vals(ka, kb, col_type) <= 0 { take_a = true; }
                    }
                }
                if take_a { dst[o] = vec_get(src, a); a = a + 1; }
                else { dst[o] = vec_get(src, b); b = b + 1; }
                o = o + 1;
            }
            lo = lo + 2 * width;
        }
        let tmp = src;
        src = dst;
        dst = tmp;
        width = width * 2;
    }
    src
}

// Replace index ix_id's entries in the flattened idx_keys/idx_rowids arrays
// with new_keys/new_rowids (count entries), shifting later indexes' starts.
fn splice_index(d: &mut DB, ix_id: i32, new_keys: Vec<i32>, new_rowids: Vec<i32>, count: i32) {
    let old_start = vec_get(d.idx_key_starts, ix_id);
    let old_count = vec_get(d.idx_key_counts, ix_id);
    let total_keys = vec_len(d.idx_keys);
    let mut out_keys: Vec<i32> = vec![];
    let mut out_rowids: Vec<i32> = vec![];
    let mut ci2 = 0;
    while ci2 < old_start {
        vec_push(out_keys, vec_get(d.idx_keys, ci2));
        vec_push(out_rowids, vec_get(d.idx_rowids, ci2));
        ci2 = ci2 + 1;
    }
    let mut ni = 0;
    while ni < count {
        vec_push(out_keys, vec_get(new_keys, ni));
        vec_push(out_rowids, vec_get(new_rowids, ni));
        ni = ni + 1;
    }
    ci2 = old_start + old_count;
    while ci2 < total_keys {
        vec_push(out_keys, vec_get(d.idx_keys, ci2));
        vec_push(out_rowids, vec_get(d.idx_rowids, ci2));
        ci2 = ci2 + 1;
    }
    d.idx_keys = out_keys;
    d.idx_rowids = out_rowids;
    let size_diff = count - old_count;
    d.idx_key_counts = vec_replace(d.idx_key_counts, d.idx_count, ix_id, count);
    let mut si2 = 0;
    let mut new_starts: Vec<i32> = vec![];
    while si2 < d.idx_count {
        if si2 > ix_id {
            vec_push(new_starts, vec_get(d.idx_key_starts, si2) + size_diff);
        } else {
            vec_push(new_starts, vec_get(d.idx_key_starts, si2));
        }
        si2 = si2 + 1;
    }
    d.idx_key_starts = new_starts;
}

// Fold rows kc..rc-1 (appended since the last refresh) into index ix_id:
// sort them, then merge with the existing sorted entries. On equal keys an
// existing entry goes first, since its row id is lower.
fn merge_new_rows(d: &mut DB, ix_id: i32, kc: i32) {
    let tidx = vec_get(d.idx_tables, ix_id);
    let col_i = vec_get(d.idx_col_indices, ix_id);
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let rs = vec_get(d.tbl_row_starts, tidx);
    let rc = vec_get(d.tbl_row_counts, tidx);
    let col_type = vec_get(d.col_types, cs + col_i);
    let k = rc - kc;
    let mut add_keys: Vec<i32> = vec![];
    let mut r = kc;
    while r < rc {
        vec_push(add_keys, vec_get(d.cells, rs + r * cc + col_i));
        r = r + 1;
    }
    let perm = sort_positions(d, add_keys, k, col_type);
    let ks = vec_get(d.idx_key_starts, ix_id);
    let mut m_keys: Vec<i32> = vec![];
    let mut m_rowids: Vec<i32> = vec![];
    let mut a = 0;
    let mut b = 0;
    while a < kc || b < k {
        let mut take_old = false;
        if a < kc {
            if b >= k { take_old = true; }
            else {
                let ko = sp_get(d, vec_get(d.idx_keys, ks + a));
                let kn = sp_get(d, vec_get(add_keys, vec_get(perm, b)));
                if compare_vals(ko, kn, col_type) <= 0 { take_old = true; }
            }
        }
        if take_old {
            vec_push(m_keys, vec_get(d.idx_keys, ks + a));
            vec_push(m_rowids, vec_get(d.idx_rowids, ks + a));
            a = a + 1;
        } else {
            let p = vec_get(perm, b);
            vec_push(m_keys, vec_get(add_keys, p));
            vec_push(m_rowids, kc + p);
            b = b + 1;
        }
    }
    splice_index(d, ix_id, m_keys, m_rowids, rc);
}

// Execute CREATE INDEX. Registers a new index entry and rebuilds its sorted data.
fn exec_create_index(d: &mut DB) ~ Console {
    let iname = sp_get(d, d.idx_name);
    let tname = sp_get(d, d.idx_table_name);
    let cname = sp_get(d, d.idx_col_name);

    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let col_i = find_col(d, cs, cc, cname);
    if col_i < 0 {
        println!("Error: column '{}' not found in table '{}'", cname, tname);
        return;
    }

    // Check for existing index with same name
    let mut ei = 0;
    while ei < d.idx_count {
        let existing_name = sp_get(d, vec_get(d.idx_names, ei));
        if existing_name == iname {
            println!("Error: index '{}' already exists", iname);
            return;
        }
        ei = ei + 1;
    }

    let inid = sp_add(d, iname);
    vec_push(d.idx_names, inid);
    vec_push(d.idx_tables, tidx);
    vec_push(d.idx_col_indices, col_i);
    vec_push(d.idx_key_starts, vec_len(d.idx_keys));
    vec_push(d.idx_key_counts, 0);
    d.idx_count = d.idx_count + 1;

    // Build index data from existing rows
    rebuild_index(d, d.idx_count - 1);
}

// =========================================================================
// SECTION 9: DISPATCH — SQL Routing
// =========================================================================
// Two entry points:
//   exec_sql()        — full execution with WAL logging (normal operation)
//   exec_sql_no_wal() — execution without WAL logging (used during WAL replay)
//
// Both call reset_parser + parse_sql, then dispatch by d.stmt_type.
// exec_sql also handles transaction keywords (BEGIN/COMMIT/ROLLBACK) as
// special cases before parsing, and routes mutations through wal_log_mutation.
// =========================================================================

// exec_sql_no_wal: used during WAL replay — executes + saves directly, no WAL logging
fn exec_sql_no_wal(d: &mut DB, input: String) ~ Console + FileSystem + Process {
    reset_parser(d, input);
    parse_sql(d);
    let st = d.stmt_type;
    if st == 0 { exec_select(d); }
    else if st == 1 { exec_insert(d); }
    else if st == 2 { exec_create(d); }
    else if st == 3 { exec_update(d); }
    else if st == 4 { exec_delete(d); }
    else if st == 5 { exec_drop(d); }
    else if st == 6 { exec_create_index(d); }
    else if st == 7 { wal_begin(d); }
    else if st == 8 { wal_commit(d); }
    else if st == 9 { wal_rollback(d); }
    else if st == 10 { exec_alter_table(d); }
}

fn exec_sql(d: &mut DB, input: String) ~ Console + FileSystem + Process {
    // Handle transaction control keywords before parsing
    let trimmed_upper = input.to_uppercase();
    if trimmed_upper == "BEGIN" {
        wal_begin(d);
        return;
    }
    if trimmed_upper == "COMMIT" {
        wal_commit(d);
        return;
    }
    if trimmed_upper == "ROLLBACK" {
        wal_rollback(d);
        return;
    }

    reset_parser(d, input);
    parse_sql(d);

    let st = d.stmt_type;

    // Fail-closed backstop for mutations: after a complete parse the token
    // cursor must sit at end of input. A live token means the mutation parser
    // stopped early and left the statement half-specified; executing anyway
    // could apply a partial write. SELECT is guarded inside parse_select, which
    // also re-enters per UNION branch, so it is exempt here. Tolerate one
    // trailing ';' -- main() and run_repl() strip one, a direct caller may leave
    // one -- then refuse any other leftover. This runs before the WAL write, so
    // a rejected statement mutates nothing.
    if st != 0 {
        if tk_is_punct(d, ";") == 1 { next_token(d); }
        if d.tk_type != 7 {
            println!("Error: unexpected trailing input near '{}'", d.tk_val);
            process_exit(1);
        }
    }

    // Read-only: SELECT — no WAL
    if st == 0 { exec_select(d); return; }

    // Mutations: log to WAL, then execute in memory
    if st == 1 { exec_insert(d); wal_log_mutation(d, input); }
    else if st == 2 { exec_create(d); wal_log_mutation(d, input); }
    else if st == 3 { exec_update(d); wal_log_mutation(d, input); }
    else if st == 4 { exec_delete(d); wal_log_mutation(d, input); }
    else if st == 5 { exec_drop(d); wal_log_mutation(d, input); }
    else if st == 6 { exec_create_index(d); wal_log_mutation(d, input); }
    else if st == 10 { exec_alter_table(d); wal_log_mutation(d, input); }
}

// =========================================================================
// SECTION 10: REPL — Interactive Shell and Dot-Commands
// =========================================================================
// The REPL reads one line at a time, strips newlines and semicolons, and
// either handles a dot-command (.tables, .schema, .wal, .quit) or passes
// the input to exec_sql() as a SQL statement.
// =========================================================================

fn cmd_tables(d: &DB) ~ Console {
    let mut i = 0;
    while i < d.tbl_count {
        let tn = sp_get(d, vec_get(d.tbl_names, i));
        println!("{}", tn);
        i = i + 1;
    }
}

fn cmd_schema(d: &DB, tname: String) ~ Console {
    let tidx = find_table(d, tname);
    if tidx < 0 {
        println!("Error: table '{}' not found", tname);
        return;
    }
    let cs = vec_get(d.tbl_col_starts, tidx);
    let cc = vec_get(d.tbl_col_counts, tidx);
    let tn = sp_get(d, vec_get(d.tbl_names, tidx));
    let mut out = "CREATE TABLE " + tn + " (";
    let mut ci = 0;
    while ci < cc {
        if ci > 0 { out = out + ", "; }
        let cname = sp_get(d, vec_get(d.col_names, cs + ci));
        let ct = vec_get(d.col_types, cs + ci);
        let tstr = if ct == 0 { "INTEGER" } else if ct == 1 { "REAL" } else { "TEXT" };
        out = out + cname + " " + tstr;
        ci = ci + 1;
    }
    out = out + ");";
    println!("{}", out);
}

fn run_repl(d: &mut DB) ~ Console + FileSystem + Process {
    let mut go = true;
    while go {
        print!("qdb> ");
        let line = read_line();
        let llen = line.len();
        // Strip trailing \n and \r
        let mut clean = line;
        let clen = clean.len();
        if clen > 0 {
            let last = clean.char_at(clen - 1);
            if last == "\n" { clean = clean.substring(0, clen - 1); }
        }
        let clen2 = clean.len();
        if clen2 > 0 {
            let last2 = clean.char_at(clen2 - 1);
            if last2 == "\r" { clean = clean.substring(0, clen2 - 1); }
        }

        let trimmed = clean.trim();
        let tlen = trimmed.len();
        if tlen == 0 {
            // skip
        } else if trimmed == ".quit" || trimmed == ".exit" {
            go = false;
        } else if trimmed == ".tables" {
            cmd_tables(d);
        } else if trimmed == ".wal" {
            cmd_wal(d);
        } else if trimmed.starts_with(".schema") {
            if tlen > 8 {
                let tname = trimmed.substring(8, tlen - 8);
                cmd_schema(d, tname.trim());
            } else {
                // Show all tables
                let mut ti = 0;
                while ti < d.tbl_count {
                    let tn = sp_get(d, vec_get(d.tbl_names, ti));
                    cmd_schema(d, tn);
                    ti = ti + 1;
                }
            }
        } else {
            // Strip trailing semicolon
            let mut sql = trimmed;
            let sql_len = sql.len();
            if sql_len > 0 {
                let last_ch = sql.char_at(sql_len - 1);
                if last_ch == ";" {
                    sql = sql.substring(0, sql_len - 1);
                }
            }
            let sql_trimmed = sql.trim();
            if sql_trimmed.len() > 0 {
                exec_sql(d, sql_trimmed);
            }
        }
    }
}

// =========================================================================
// SECTION 11: MAIN — Entry Point
// =========================================================================
// Usage: qdb <database> [sql]
//   With sql argument: execute single statement and exit
//   Without sql argument: enter interactive REPL
//
// Startup sequence:
//   1. Parse args, handle --help
//   2. db_new() — create empty DB struct
//   3. db_load() — load from .db file
//   4. wal_replay() — recover committed WAL transactions
//   5. Execute SQL or enter REPL
// =========================================================================

fn main() ~ Console + Environment + FileSystem + Process {
    let nargs = args_count();
    if nargs < 2 {
        println!("Usage: qdb <database> [sql]");
        println!("       qdb <database>          — interactive REPL mode");
        process_exit(0);
    }

    let arg1 = args_get(1);
    if arg1 == "--help" || arg1 == "-h" {
        println!("Usage: qdb <database> [sql]");
        println!("       qdb mydb.db                    — interactive REPL");
        println!("       qdb mydb.db \"SELECT * FROM t\"  — execute SQL");
        println!("");
        println!("SQL support:");
        println!("  CREATE TABLE, INSERT, SELECT, UPDATE, DELETE, DROP TABLE");
        println!("  ALTER TABLE ADD COLUMN");
        println!("  WHERE (AND/OR, LIKE, IN, IS NULL, BETWEEN, subqueries)");
        println!("  JOIN, GROUP BY, HAVING, DISTINCT, ORDER BY, LIMIT");
        println!("  CREATE INDEX, BEGIN/COMMIT/ROLLBACK, WAL recovery");
        println!("");
        println!("REPL commands:");
        println!("  .tables    — list all tables");
        println!("  .schema    — show table schemas");
        println!("  .wal       — show WAL status");
        println!("  .quit      — exit REPL");
        process_exit(0);
    }

    let db_path = arg1;
    let mut d = db_new(db_path);
    let crash_at = getenv("QDB_CRASH_AT");
    if crash_at.len() > 0 { d.crash_at = parse_int_str(crash_at); }
    d.crash_torn = getenv("QDB_CRASH_MODE") == "torn";
    d.trace_writes = getenv("QDB_TRACE_WRITES") == "1";
    db_load(&mut d);
    // Replay any committed transactions from WAL (crash recovery)
    wal_replay(&mut d);

    if nargs >= 3 {
        // Single command mode
        let sql = args_get(2);
        // Strip trailing semicolon
        let slen = sql.len();
        let mut clean_sql = sql;
        if slen > 0 {
            let last = sql.char_at(slen - 1);
            if last == ";" {
                clean_sql = sql.substring(0, slen - 1);
            }
        }
        let trimmed = clean_sql.trim();
        if trimmed.len() > 0 {
            exec_sql(&mut d, trimmed);
        }
    } else {
        // REPL mode
        run_repl(&mut d);
    }
    // Clean exit: fold the WAL into the .db (skipped inside an open BEGIN).
    wal_close(&mut d);
}
