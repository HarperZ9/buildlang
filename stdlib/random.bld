// BuildLang Standard Library - Seeded random streams
//
// `xmur3-mulberry32/1`: a text seed hashed by bryc's xmur3 over its UTF-16
// code units (public domain, github.com/bryc/code), then Tommy Ettinger's
// mulberry32 (CC0 1.0, 2017). The same rule is written in Python,
// JavaScript and C++ in the engine's superstack package; this one gives the
// same numbers for the same seed.
//
// All arithmetic is on u32: `wrapping_mul` is JavaScript's Math.imul,
// `wrapping_add` is `(a + b) | 0` read unsigned, and `>>` on a u32 is the
// logical shift (`>>>`).

/// One step of xmur3 over a UTF-16 code unit.
fn xmur3_step(h: u32, unit: u32) -> u32 {
    let m = (h ^ unit).wrapping_mul(3432918353);
    (m << 13) | (m >> 19)
}

/// The number of UTF-16 code units of `s`.
pub fn utf16_len(s: &str) -> u32 {
    let mut n: u32 = 0;
    for c in s.chars() {
        let code = c as u32;
        if code >= 65536 {
            n = n + 2;
        } else {
            n = n + 1;
        }
    }
    n
}

/// bryc's xmur3 over the UTF-16 code units of `s`: the first output of the
/// function it returns. A character above U+FFFF counts as its surrogate pair.
pub fn xmur3(s: &str) -> u32 {
    let mut h: u32 = 1779033703 ^ utf16_len(s);
    for c in s.chars() {
        let code = c as u32;
        if code >= 65536 {
            let v = code - 65536;
            h = xmur3_step(h, 55296 + (v >> 10));
            h = xmur3_step(h, 56320 + (v & 1023));
        } else {
            h = xmur3_step(h, code);
        }
    }
    h = (h ^ (h >> 16)).wrapping_mul(2246822507);
    h = (h ^ (h >> 13)).wrapping_mul(3266489909);
    h ^ (h >> 16)
}

/// Tommy Ettinger's mulberry32: 32 bits of state, period 2^32.
#[derive(Clone, Copy)]
pub struct Mulberry32 {
    pub state: u32,
}

impl Mulberry32 {
    /// A stream that starts from the 32-bit `seed`.
    pub fn new(seed: u32) -> Mulberry32 {
        Mulberry32 { state: seed }
    }

    /// The stream of the text seed `seed` under `xmur3-mulberry32/1`.
    pub fn from_seed(seed: &str) -> Mulberry32 {
        Mulberry32 { state: xmur3(seed) }
    }

    /// The next 32-bit draw.
    pub fn next_u32(&mut self) -> u32 {
        self.state = self.state.wrapping_add(1831565813);
        let mut t = self.state;
        t = (t ^ (t >> 15)).wrapping_mul(t | 1);
        t = t.wrapping_add((t ^ (t >> 7)).wrapping_mul(t | 61)) ^ t;
        t ^ (t >> 14)
    }

    /// The next draw as a float in [0, 1): the 32-bit draw over 2^32.
    pub fn next_f64(&mut self) -> f64 {
        (self.next_u32() as f64) / 4294967296.0
    }

    /// An index in [0, n): floor(u n) with u from `next_f64`.
    pub fn next_index(&mut self, n: u64) -> u64 {
        ((self.next_f64() * (n as f64)) as u64)
    }
}
