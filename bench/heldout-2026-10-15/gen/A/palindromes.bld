fn is_palindrome(w: str) -> bool {
    let mut codes: Vec<i64> = vec_new();
    let mut n: i64 = 0;
    for c in w.chars() {
        codes.push(c as i64);
        n = n + 1;
    }
    let mut ok = true;
    let mut i: i64 = 0;
    while i < n / 2 {
        if codes[i as usize] != codes[(n - 1 - i) as usize] {
            ok = false;
        }
        i = i + 1;
    }
    ok
}

fn main() ~ Console {
    for w in "racecar level buildlang noon ab a".split(" ") {
        if is_palindrome(w) {
            println!("{} yes", w);
        } else {
            println!("{} no", w);
        }
    }
}
