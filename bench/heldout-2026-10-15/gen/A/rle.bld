fn letter(i: i64) -> str {
    let mut out = "";
    let mut k: i64 = 0;
    for w in "a b c d e f g h i j k l m n o p q r s t u v w x y z".split(" ") {
        if k == i {
            out = w;
        }
        k = k + 1;
    }
    out
}

fn encode(s: str) -> str {
    let mut out = "";
    let mut prev: i64 = -1;
    let mut count: i64 = 0;
    for c in s.chars() {
        let code = c as i64;
        if code == prev {
            count = count + 1;
        } else {
            if count > 0 {
                out = format!("{}{}{}", out, letter(prev - 97), count);
            }
            prev = code;
            count = 1;
        }
    }
    if count > 0 {
        out = format!("{}{}{}", out, letter(prev - 97), count);
    }
    out
}

fn main() ~ Console {
    println!("{}", encode("aaabccddddde"));
    println!("{}", encode("z"));
}
