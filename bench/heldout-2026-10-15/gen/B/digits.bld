fn digit_sum(x: i32) -> i32 {
    let mut n: i32 = x;
    let mut s: i32 = 0;
    while n > 0 {
        s = s + n % 10;
        n = n / 10;
    }
    s
}

fn main() ~ Console {
    let mut p: i32 = 1;
    for k in 0..20 {
        p = p * 2;
    }
    println!("{}", p);
    let s = digit_sum(p);
    println!("{}", s);
    let mut r: i32 = s;
    while r >= 10 {
        r = digit_sum(r);
    }
    println!("{}", r);
}
