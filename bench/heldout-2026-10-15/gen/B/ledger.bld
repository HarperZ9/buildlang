struct Account {
    id: i32,
    balance: i32,
}

enum Txn {
    Deposit(i32, i32),
    Withdraw(i32, i32),
    Transfer(i32, i32, i32),
}

struct Bank {
    a1: Account,
    a2: Account,
    a3: Account,
    rejected: i32,
}

impl Bank {
    fn get(&self, id: i32) -> i32 {
        if id == 1 {
            self.a1.balance
        } else if id == 2 {
            self.a2.balance
        } else {
            self.a3.balance
        }
    }

    fn set(&mut self, id: i32, v: i32) {
        if id == 1 {
            self.a1.balance = v;
        } else if id == 2 {
            self.a2.balance = v;
        } else {
            self.a3.balance = v;
        }
    }

    fn apply(&mut self, t: Txn) {
        match t {
            Txn::Deposit(a, amt) => {
                let b = self.get(a);
                self.set(a, b + amt);
            },
            Txn::Withdraw(a, amt) => {
                let b = self.get(a);
                if amt > b {
                    self.rejected = self.rejected + 1;
                } else {
                    self.set(a, b - amt);
                }
            },
            Txn::Transfer(from, to, amt) => {
                let bf = self.get(from);
                if amt > bf {
                    self.rejected = self.rejected + 1;
                } else {
                    self.set(from, bf - amt);
                    let bt = self.get(to);
                    self.set(to, bt + amt);
                }
            },
        }
    }
}

fn main() ~ Console {
    let mut bank = Bank {
        a1: Account { id: 1, balance: 100 },
        a2: Account { id: 2, balance: 50 },
        a3: Account { id: 3, balance: 0 },
        rejected: 0,
    };
    let mut txns: Vec<Txn> = vec_new();
    txns.push(Txn::Deposit(3, 25));
    txns.push(Txn::Withdraw(2, 80));
    txns.push(Txn::Transfer(1, 3, 60));
    txns.push(Txn::Withdraw(1, 50));
    txns.push(Txn::Transfer(2, 1, 50));
    txns.push(Txn::Deposit(2, 5));
    for t in txns {
        bank.apply(t);
    }
    println!("{} {}", bank.a1.id, bank.a1.balance);
    println!("{} {}", bank.a2.id, bank.a2.balance);
    println!("{} {}", bank.a3.id, bank.a3.balance);
    println!("rejected {}", bank.rejected);
}
