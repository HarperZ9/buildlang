struct Account {
    id: i64,
    balance: i64,
}

enum Tx {
    Deposit(i64, i64),
    Withdraw(i64, i64),
    Transfer(i64, i64, i64),
}

fn main() ~ Console {
    let mut acc1 = Account { id: 1, balance: 100 };
    let mut acc2 = Account { id: 2, balance: 50 };
    let mut acc3 = Account { id: 3, balance: 0 };

    let mut txs: Vec<Tx> = vec_new();
    txs.push(Tx::Deposit(3, 25));
    txs.push(Tx::Withdraw(2, 80));
    txs.push(Tx::Transfer(1, 3, 60));
    txs.push(Tx::Withdraw(1, 50));
    txs.push(Tx::Transfer(2, 1, 50));
    txs.push(Tx::Deposit(2, 5));

    let mut rejected: i64 = 0;
    for tx in txs {
        // from = 0 means no source account; to = 0 means no target account.
        let mut from: i64 = 0;
        let mut to: i64 = 0;
        let mut amt: i64 = 0;
        match tx {
            Tx::Deposit(a, m) => {
                to = a;
                amt = m;
            },
            Tx::Withdraw(a, m) => {
                from = a;
                amt = m;
            },
            Tx::Transfer(f, t, m) => {
                from = f;
                to = t;
                amt = m;
            },
        }

        let mut source: i64 = 0;
        if from == 1 {
            source = acc1.balance;
        } else if from == 2 {
            source = acc2.balance;
        } else if from == 3 {
            source = acc3.balance;
        }

        if from != 0 && amt > source {
            rejected = rejected + 1;
        } else {
            if from == 1 {
                acc1.balance = acc1.balance - amt;
            } else if from == 2 {
                acc2.balance = acc2.balance - amt;
            } else if from == 3 {
                acc3.balance = acc3.balance - amt;
            }
            if to == 1 {
                acc1.balance = acc1.balance + amt;
            } else if to == 2 {
                acc2.balance = acc2.balance + amt;
            } else if to == 3 {
                acc3.balance = acc3.balance + amt;
            }
        }
    }

    println!("{} {}", acc1.id, acc1.balance);
    println!("{} {}", acc2.id, acc2.balance);
    println!("{} {}", acc3.id, acc3.balance);
    println!("rejected {}", rejected);
}
