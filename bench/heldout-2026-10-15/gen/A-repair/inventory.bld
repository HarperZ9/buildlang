struct Item {
    name: str,
    price: i64,
    qty: i64,
}

fn lookup(query: str) -> Option<Item> {
    let mut stock: Vec<Item> = vec_new();
    stock.push(Item { name: "apple", price: 120, qty: 3 });
    stock.push(Item { name: "pear", price: 95, qty: 0 });
    stock.push(Item { name: "plum", price: 40, qty: 12 });
    for it in stock {
        if it.name == query {
            return Some(it);
        }
    }
    None
}

fn report(query: str) ~ Console {
    let mut found = false;
    let mut name = query;
    let mut price: i64 = 0;
    let mut qty: i64 = 0;
    match lookup(query) {
        Some(it) => {
            found = true;
            name = it.name;
            price = it.price;
            qty = it.qty;
        },
        None => {
            found = false;
        },
    }
    if !found {
        println!("{} missing", query);
    } else if qty > 0 {
        println!("{} {} x{}", name, price, qty);
    } else {
        println!("{} out of stock", name);
    }
}

fn main() ~ Console {
    report("plum");
    report("kiwi");
    report("pear");
}
