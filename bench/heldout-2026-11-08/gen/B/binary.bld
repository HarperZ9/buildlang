fn to_binary(n: i64) -> str {
    if n == 0 {
        return "0";
    }
    let mut bits: Vec<i64> = vec_new();
    let mut x: i64 = n;
    while x > 0 {
        bits.push(x % 2);
        x = x / 2;
    }
    let mut out: str = "";
    let mut i: i64 = bits.len() as i64 - 1;
    while i >= 0 {
        if bits[i as usize] == 1 {
            out.push_str("1");
        } else {
            out.push_str("0");
        }
        i = i - 1;
    }
    out
}

fn main() ~ Console {
    println!("{}", to_binary(37));
    println!("{}", to_binary(255));
    println!("{}", to_binary(1024));
    println!("{}", to_binary(0));
}
