fn clean(s: str) -> str {
    let mut out: str = "";
    for c in s.chars() {
        let x: i64 = c as i64;
        if x != 13 && x != 32 && x != 9 {
            out.push(c);
        }
    }
    out
}

fn parse_int(s: str) -> i64 {
    let mut n: i64 = 0;
    let mut neg = false;
    for c in s.chars() {
        let x: i64 = c as i64;
        if x == 45 {
            neg = true;
        } else if x >= 48 && x <= 57 {
            n = n * 10 + (x - 48);
        }
    }
    if neg {
        0 - n
    } else {
        n
    }
}

fn hits_needed(atk: i64, def: i64, hp: i64) -> i64 {
    let mut dmg: i64 = atk - def;
    if dmg < 1 {
        dmg = 1;
    }
    (hp + dmg - 1) / dmg
}

fn main() ~ Console + FileSystem {
    let text = read_file("units.csv");
    let mut names: Vec<str> = vec_new();
    let mut hp: Vec<i64> = vec_new();
    let mut atk: Vec<i64> = vec_new();
    let mut def: Vec<i64> = vec_new();
    let mut header = true;
    for raw in text.split("\n") {
        let line = clean(raw);
        if line.len() > 0 {
            if header {
                header = false;
            } else {
                let mut fields: Vec<str> = vec_new();
                for f in line.split(",") {
                    fields.push(f);
                }
                if fields.len() as i64 >= 4 {
                    names.push(fields[0]);
                    hp.push(parse_int(fields[1]));
                    atk.push(parse_int(fields[2]));
                    def.push(parse_int(fields[3]));
                }
            }
        }
    }
    let n: i64 = names.len() as i64;
    let mut i: i64 = 0;
    while i < n {
        let mut best: i64 = -1;
        let mut best_hits: i64 = 0;
        let mut j: i64 = 0;
        while j < n {
            if j != i {
                let h: i64 = hits_needed(atk[i as usize], def[j as usize], hp[j as usize]);
                let mut take = false;
                if best < 0 || h < best_hits {
                    take = true;
                } else if h == best_hits && names[j as usize] < names[best as usize] {
                    take = true;
                }
                if take {
                    best = j;
                    best_hits = h;
                }
            }
            j = j + 1;
        }
        if best >= 0 {
            println!("{} {} {}", names[i as usize], names[best as usize], best_hits);
        }
        i = i + 1;
    }
}
