fn hex_value(s: str) -> i64 {
    let mut n: i64 = 0;
    for c in s.chars() {
        let x: i64 = c as i64;
        let mut d: i64 = 0;
        if x >= 48 && x <= 57 {
            d = x - 48;
        } else if x >= 97 && x <= 102 {
            d = x - 87;
        } else if x >= 65 && x <= 70 {
            d = x - 55;
        }
        n = n * 16 + d;
    }
    n
}

fn main() ~ Console {
    println!("{}", hex_value("ff"));
    println!("{}", hex_value("1A3"));
    println!("{}", hex_value("0"));
    println!("{}", hex_value("7fff"));
}
