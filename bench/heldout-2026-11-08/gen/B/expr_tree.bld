enum Expr {
    Num(i64),
    Add(Box<Expr>, Box<Expr>),
    Sub(Box<Expr>, Box<Expr>),
    Mul(Box<Expr>, Box<Expr>),
}

fn build() -> Expr {
    let left = Expr::Add(Box::new(Expr::Num(2)), Box::new(Expr::Num(3)));
    let right = Expr::Sub(Box::new(Expr::Num(4)), Box::new(Expr::Num(1)));
    let prod = Expr::Mul(Box::new(left), Box::new(right));
    Expr::Add(Box::new(prod), Box::new(Expr::Num(10)))
}

fn eval(e: Expr) -> i64 {
    match e {
        Expr::Num(n) => n,
        Expr::Add(a, b) => eval(*a) + eval(*b),
        Expr::Sub(a, b) => eval(*a) - eval(*b),
        Expr::Mul(a, b) => eval(*a) * eval(*b),
    }
}

fn join(a: str, op: str, b: str) -> str {
    let mut out: str = "(";
    out.push_str(a);
    out.push_str(" ");
    out.push_str(op);
    out.push_str(" ");
    out.push_str(b);
    out.push_str(")");
    out
}

fn show(e: Expr) -> str {
    match e {
        Expr::Num(n) => format!("{}", n),
        Expr::Add(a, b) => {
            let l = show(*a);
            let r = show(*b);
            join(l, "+", r)
        },
        Expr::Sub(a, b) => {
            let l = show(*a);
            let r = show(*b);
            join(l, "-", r)
        },
        Expr::Mul(a, b) => {
            let l = show(*a);
            let r = show(*b);
            join(l, "*", r)
        },
    }
}

fn main() ~ Console {
    let value: i64 = eval(build());
    println!("{}", value);
    let text = show(build());
    println!("{}", text);
}
