fn main() ~ Console {
    let mut pos: Vec<i64> = vec_new();
    let mut vel: Vec<i64> = vec_new();
    pos.push(5);
    pos.push(20);
    pos.push(50);
    pos.push(77);
    pos.push(95);
    vel.push(7);
    vel.push(-9);
    vel.push(13);
    vel.push(4);
    vel.push(-6);
    let n: i64 = 5;
    let mut bounces: i64 = 0;
    let mut step: i64 = 0;
    while step < 50 {
        let mut i: i64 = 0;
        while i < n {
            let mut p: i64 = pos[i as usize] + vel[i as usize];
            let mut v: i64 = vel[i as usize];
            if p < 0 {
                p = 0 - p;
                v = 0 - v;
                bounces = bounces + 1;
            } else if p > 100 {
                p = 200 - p;
                v = 0 - v;
                bounces = bounces + 1;
            }
            pos[i as usize] = p;
            vel[i as usize] = v;
            i = i + 1;
        }
        step = step + 1;
    }
    let mut line: str = "";
    let mut j: i64 = 0;
    while j < n {
        if j > 0 {
            line.push_str(" ");
        }
        line.push_str(format!("{}", pos[j as usize]));
        j = j + 1;
    }
    println!("{}", line);
    println!("bounces {}", bounces);
}
