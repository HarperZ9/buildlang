fn reverse_word(w: str) -> str {
    let mut cs: Vec<char> = vec_new();
    for c in w.chars() {
        cs.push(c);
    }
    let mut out: str = "";
    let mut i: i64 = cs.len() as i64 - 1;
    while i >= 0 {
        out.push(cs[i as usize]);
        i = i - 1;
    }
    out
}

fn main() ~ Console {
    let text = "one two three four five";
    let mut words: Vec<str> = vec_new();
    for w in text.split(" ") {
        words.push(w);
    }
    let n: i64 = words.len() as i64;

    let mut first: str = "";
    let mut i: i64 = n - 1;
    while i >= 0 {
        if i < n - 1 {
            first.push_str(" ");
        }
        first.push_str(words[i as usize]);
        i = i - 1;
    }
    println!("{}", first);

    let mut second: str = "";
    let mut j: i64 = 0;
    while j < n {
        if j > 0 {
            second.push_str(" ");
        }
        second.push_str(reverse_word(words[j as usize]));
        j = j + 1;
    }
    println!("{}", second);
}
