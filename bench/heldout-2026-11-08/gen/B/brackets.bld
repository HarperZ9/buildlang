fn code_of(c: char) -> i64 {
    let x: i64 = c as i64;
    if x == 40 || x == 41 {
        return 1;
    }
    if x == 91 || x == 93 {
        return 2;
    }
    if x == 123 || x == 125 {
        return 3;
    }
    0
}

fn is_open(c: char) -> bool {
    let x: i64 = c as i64;
    x == 40 || x == 91 || x == 123
}

fn balanced(s: str) -> bool {
    let mut stack: Vec<i64> = vec_new();
    let mut sp: i64 = 0;
    for c in s.chars() {
        let k: i64 = code_of(c);
        if k > 0 {
            if is_open(c) {
                if sp < stack.len() as i64 {
                    stack[sp as usize] = k;
                } else {
                    stack.push(k);
                }
                sp = sp + 1;
            } else {
                if sp == 0 {
                    return false;
                }
                if stack[(sp - 1) as usize] != k {
                    return false;
                }
                sp = sp - 1;
            }
        }
    }
    sp == 0
}

fn answer(s: str) ~ Console {
    if balanced(s) {
        println!("yes");
    } else {
        println!("no");
    }
}

fn main() ~ Console {
    answer("([]{})");
    answer("([)]");
    answer("((");
    answer("{[()()]}");
    answer("");
}
