fn valid(s: str) -> bool {
    let mut cs: Vec<char> = vec_new();
    for c in s.chars() {
        cs.push(c);
    }
    if cs.len() as i64 != 10 {
        return false;
    }
    let mut sum: i64 = 0;
    let mut i: i64 = 0;
    while i < 10 {
        let x: i64 = cs[i as usize] as i64;
        let mut d: i64 = 0;
        if x >= 48 && x <= 57 {
            d = x - 48;
        } else if i == 9 && x == 88 {
            d = 10;
        } else {
            return false;
        }
        sum = sum + d * (10 - i);
        i = i + 1;
    }
    sum % 11 == 0
}

fn check(s: str) ~ Console {
    if valid(s) {
        println!("{} valid", s);
    } else {
        println!("{} invalid", s);
    }
}

fn main() ~ Console {
    check("0306406152");
    check("0306406153");
    check("080442957X");
    check("12345");
}
