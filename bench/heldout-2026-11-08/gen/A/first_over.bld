fn first_over(v: &Vec<i64>, limit: i64) -> Option<i64> {
    let mut i: usize = 0;
    while i < v.len() {
        if v[i] > limit {
            return Some(v[i]);
        }
        i = i + 1;
    }
    None
}

fn show(o: Option<i64>) ~ Console {
    match o {
        Some(x) => println!("{}", x),
        None => println!("none"),
    }
}

fn main() ~ Console {
    let mut v: Vec<i64> = vec_new();
    v.push(12);
    v.push(7);
    v.push(33);
    v.push(51);
    v.push(8);
    v.push(77);
    v.push(64);
    show(first_over(&v, 50));
    show(first_over(&v, 100));
}
