fn main() ~ Console {
    let mut height: i64 = 0;
    let mut speed: i64 = 1000;
    let mut steps: i64 = 0;
    let mut peak: i64 = 0;
    let mut first = true;
    loop {
        speed = speed - 98;
        height = height + speed;
        steps = steps + 1;
        if first || height > peak {
            peak = height;
        }
        first = false;
        if height < 0 {
            break;
        }
    }
    println!("landed {}", steps);
    println!("peak {}", peak);
}
