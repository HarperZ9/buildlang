fn fib(n: i64) -> i64 {
    let mut a: i64 = 1;
    let mut b: i64 = 1;
    let mut k: i64 = 3;
    while k <= n {
        let c = a + b;
        a = b;
        b = c;
        k = k + 1;
    }
    if n <= 2 {
        1
    } else {
        b
    }
}

fn main() ~ Console {
    println!("{}", fib(90));
    let mut sum: i64 = 0;
    let mut i: i64 = 1;
    while i <= 20 {
        sum = sum + fib(i);
        i = i + 1;
    }
    println!("{}", sum);
}
