fn alive_at(g: &Vec<i64>, r: i64, c: i64) -> i64 {
    if r < 0 || r >= 8 || c < 0 || c >= 8 {
        0
    } else {
        g[(r * 8 + c) as usize]
    }
}

fn step(g: &Vec<i64>) -> Vec<i64> {
    let mut next: Vec<i64> = vec_new();
    let mut r: i64 = 0;
    while r < 8 {
        let mut c: i64 = 0;
        while c < 8 {
            let mut n: i64 = 0;
            let mut dr: i64 = -1;
            while dr <= 1 {
                let mut dc: i64 = -1;
                while dc <= 1 {
                    if dr != 0 || dc != 0 {
                        n = n + alive_at(g, r + dr, c + dc);
                    }
                    dc = dc + 1;
                }
                dr = dr + 1;
            }
            let me = alive_at(g, r, c);
            if (me == 1 && (n == 2 || n == 3)) || (me == 0 && n == 3) {
                next.push(1);
            } else {
                next.push(0);
            }
            c = c + 1;
        }
        r = r + 1;
    }
    next
}

fn main() ~ Console {
    let mut grid: Vec<i64> = vec_new();
    let mut i: i64 = 0;
    while i < 64 {
        grid.push(0);
        i = i + 1;
    }
    grid[1] = 1;
    grid[10] = 1;
    grid[16] = 1;
    grid[17] = 1;
    grid[18] = 1;
    let mut gen: i64 = 0;
    while gen < 4 {
        grid = step(&grid);
        gen = gen + 1;
    }
    let mut count: i64 = 0;
    let mut r: i64 = 0;
    while r < 8 {
        let mut line = "";
        let mut c: i64 = 0;
        while c < 8 {
            if grid[(r * 8 + c) as usize] == 1 {
                line.push_str("#");
                count = count + 1;
            } else {
                line.push_str(".");
            }
            c = c + 1;
        }
        println!("{}", line);
        r = r + 1;
    }
    println!("alive {}", count);
}
