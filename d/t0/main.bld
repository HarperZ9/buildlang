
struct Ops {
    loader: (fn(str) -> str) with FileSystem
}

struct Outer {
    ops: Ops
}

fn load_config(path: str) -> str ~ FileSystem {
    read_file(path)
}

fn main() ~ FileSystem {
    let defaults = Outer { ops: Ops { loader: load_config } };
    let outer = Outer { ..defaults };
    let Outer { ops } = outer;
    (ops.loader)("ops.txt");
}
