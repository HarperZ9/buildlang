// Amanatides and Woo voxel traversal (1987), checked against a brute-force
// reference that tests the ray against every cell (registry row GEO-023).
//
// Checks, one per line for compiler/tests/shared_video_kernels.rs:
//   visits     on 2000 seeded rays through a 16-cubed grid, the ordered list
//              of cells the traversal visits equals the list of every cell
//              whose box the ray segment crosses with positive length, sorted
//              by entry distance
//   hits       the first occupied cell equals the reference's first occupied
//   layout     the same rays over a Morton-ordered copy of the grid give the
//              same first hits as the row-major grid
//   control    a traversal that steps two axes at once when their next
//              crossings are within 0.01 (the corner skip of a plain DDA) must
//              disagree with the reference on at least one ray

const N: i64 = 16;

fn row_major(x: i64, y: i64, z: i64, n: i64) -> i64 {
    x + n * (y + n * z)
}

fn spread3(v: i64) -> i64 {
    // insert two zero bits between each of the low 10 bits of v
    let mut x = v & 1023;
    x = (x | (x << 16)) & 50331903;
    x = (x | (x << 8)) & 50393103;
    x = (x | (x << 4)) & 51130563;
    x = (x | (x << 2)) & 153391689;
    x
}

fn morton(x: i64, y: i64, z: i64) -> i64 {
    spread3(x) | (spread3(y) << 1) | (spread3(z) << 2)
}

fn cell_index(x: i64, y: i64, z: i64, n: i64, use_morton: bool) -> i64 {
    if use_morton { morton(x, y, z) } else { row_major(x, y, z, n) }
}

struct Ray {
    ox: f64, oy: f64, oz: f64,
    dx: f64, dy: f64, dz: f64,
}

struct Span {
    t0: f64,
    t1: f64,
}

fn slab(o: f64, d: f64, lo: f64, hi: f64, s: Span) -> Span {
    if d == 0.0 {
        if o < lo || o > hi { Span { t0: 1.0, t1: 0.0 } } else { s }
    } else {
        let a = (lo - o) / d;
        let b = (hi - o) / d;
        let near = if a < b { a } else { b };
        let far = if a < b { b } else { a };
        Span {
            t0: if near > s.t0 { near } else { s.t0 },
            t1: if far < s.t1 { far } else { s.t1 },
        }
    }
}

fn box_span(r: &Ray, x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64) -> Span {
    let s = Span { t0: -1.0e300, t1: 1.0e300 };
    let s = slab(r.ox, r.dx, x0, x1, s);
    let s = slab(r.oy, r.dy, y0, y1, s);
    slab(r.oz, r.dz, z0, z1, s)
}

fn clampi(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

fn first_cross(o: f64, d: f64, i: i64) -> f64 {
    if d > 0.0 { ((i + 1) as f64 - o) / d } else if d < 0.0 { ((i as f64) - o) / d } else { 1.0e300 }
}

fn step_of(d: f64) -> i64 {
    if d > 0.0 { 1 } else if d < 0.0 { -1 } else { 0 }
}

fn delta_of(d: f64) -> f64 {
    if d == 0.0 { 1.0e300 } else { (1.0 / d).abs() }
}

// Visits cells in order into `out` (row-major ids) and returns the first
// occupied cell's row-major id, or -1. corner_skip plants the bug.
fn traverse(r: &Ray, grid: &Vec<i64>, n: i64, use_morton: bool, corner_skip: bool, out: &mut Vec<i64>) -> i64 {
    let nf = n as f64;
    let s = box_span(r, 0.0, 0.0, 0.0, nf, nf, nf);
    let t_start = if s.t0 > 0.0 { s.t0 } else { 0.0 };
    if t_start > s.t1 {
        return -1;
    }
    let mut x = clampi((r.ox + r.dx * t_start).floor() as i64, 0, n - 1);
    let mut y = clampi((r.oy + r.dy * t_start).floor() as i64, 0, n - 1);
    let mut z = clampi((r.oz + r.dz * t_start).floor() as i64, 0, n - 1);
    let sx = step_of(r.dx);
    let sy = step_of(r.dy);
    let sz = step_of(r.dz);
    let ddx = delta_of(r.dx);
    let ddy = delta_of(r.dy);
    let ddz = delta_of(r.dz);
    let mut tx = first_cross(r.ox, r.dx, x);
    let mut ty = first_cross(r.oy, r.dy, y);
    let mut tz = first_cross(r.oz, r.dz, z);
    let mut hit: i64 = -1;
    loop {
        let id = row_major(x, y, z, n);
        out.push(id);
        if hit < 0 && grid[cell_index(x, y, z, n, use_morton) as usize] != 0 {
            hit = id;
        }
        if corner_skip && (tx - ty).abs() < 0.01 && tx <= tz && ty <= tz {
            x = x + sx;
            y = y + sy;
            tx = tx + ddx;
            ty = ty + ddy;
        } else if tx <= ty && tx <= tz {
            x = x + sx;
            tx = tx + ddx;
        } else if ty <= tz {
            y = y + sy;
            ty = ty + ddy;
        } else {
            z = z + sz;
            tz = tz + ddz;
        }
        if x < 0 || x >= n || y < 0 || y >= n || z < 0 || z >= n {
            break;
        }
    }
    hit
}

// Every cell the segment crosses with positive length, in order of entry.
fn reference(r: &Ray, grid: &Vec<i64>, n: i64, out: &mut Vec<i64>) -> i64 {
    let nf = n as f64;
    let s = box_span(r, 0.0, 0.0, 0.0, nf, nf, nf);
    let t_start = if s.t0 > 0.0 { s.t0 } else { 0.0 };
    let mut ts: Vec<f64> = Vec::new();
    if t_start <= s.t1 {
        let mut z: i64 = 0;
        while z < n {
            let mut y: i64 = 0;
            while y < n {
                let mut x: i64 = 0;
                while x < n {
                    let c = box_span(r, x as f64, y as f64, z as f64, (x + 1) as f64, (y + 1) as f64, (z + 1) as f64);
                    let enter = if c.t0 > t_start { c.t0 } else { t_start };
                    if c.t1 - enter > 1.0e-12 {
                        // insertion sort by entry distance
                        out.push(row_major(x, y, z, n));
                        ts.push(enter);
                        let mut k = ts.len() - 1;
                        while k > 0 && ts[k - 1] > ts[k] {
                            let tt = ts[k];
                            ts[k] = ts[k - 1];
                            ts[k - 1] = tt;
                            let ii = out[k];
                            out[k] = out[k - 1];
                            out[k - 1] = ii;
                            k = k - 1;
                        }
                    }
                    x = x + 1;
                }
                y = y + 1;
            }
            z = z + 1;
        }
    }
    let mut hit: i64 = -1;
    let mut k: usize = 0;
    while k < out.len() {
        if hit < 0 && grid[out[k] as usize] != 0 {
            hit = out[k];
        }
        k = k + 1;
    }
    hit
}

fn same_list(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

struct Rng {
    s: u64,
}

fn next_unit(g: &mut Rng) -> f64 {
    // splitmix64, top 53 bits as a double in [0, 1)
    g.s = g.s.wrapping_add(11400714819323198485);
    let mut z = g.s;
    z = (z ^ (z >> 30)).wrapping_mul(13787848793156543929);
    z = (z ^ (z >> 27)).wrapping_mul(10723151780598845931);
    z = z ^ (z >> 31);
    ((z >> 11) as f64) / 9007199254740992.0
}

fn make_ray(g: &mut Rng, n: i64) -> Ray {
    let nf = n as f64;
    let inside = next_unit(g) < 0.2;
    let ox = if inside { next_unit(g) * nf } else { (next_unit(g) * 2.0 - 0.5) * nf };
    let oy = if inside { next_unit(g) * nf } else { (next_unit(g) * 2.0 - 0.5) * nf };
    let oz = if inside { next_unit(g) * nf } else { (next_unit(g) * 2.0 - 0.5) * nf };
    let tx = next_unit(g) * nf;
    let ty = next_unit(g) * nf;
    let tz = next_unit(g) * nf;
    let dx = tx - ox;
    let dy = ty - oy;
    let dz = tz - oz;
    let len = (dx * dx + dy * dy + dz * dz).sqrt();
    Ray { ox: ox, oy: oy, oz: oz, dx: dx / len, dy: dy / len, dz: dz / len }
}

fn main() ~ Console {
    let n = N;
    let mut g = Rng { s: 20261118 };
    let mut grid: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < n * n * n {
        grid.push(if next_unit(&mut g) < 0.04 { 1 } else { 0 });
        i = i + 1;
    }
    // the same occupancy stored in Morton order
    let mut mgrid: Vec<i64> = Vec::new();
    i = 0;
    while i < n * n * n {
        mgrid.push(0);
        i = i + 1;
    }
    let mut z: i64 = 0;
    while z < n {
        let mut y: i64 = 0;
        while y < n {
            let mut x: i64 = 0;
            while x < n {
                mgrid[morton(x, y, z) as usize] = grid[row_major(x, y, z, n) as usize];
                x = x + 1;
            }
            y = y + 1;
        }
        z = z + 1;
    }
    let rays: i64 = 2000;
    let mut visit_bad: i64 = 0;
    let mut hit_bad: i64 = 0;
    let mut layout_bad: i64 = 0;
    let mut skip_visit_bad: i64 = 0;
    let mut skip_hit_bad: i64 = 0;
    let mut cells: i64 = 0;
    let mut hits: i64 = 0;
    let mut k: i64 = 0;
    while k < rays {
        let r = make_ray(&mut g, n);
        let mut want: Vec<i64> = Vec::new();
        let want_hit = reference(&r, &grid, n, &mut want);
        let mut got: Vec<i64> = Vec::new();
        let got_hit = traverse(&r, &grid, n, false, false, &mut got);
        let mut gotm: Vec<i64> = Vec::new();
        let got_hit_m = traverse(&r, &mgrid, n, true, false, &mut gotm);
        let mut bad: Vec<i64> = Vec::new();
        let bad_hit = traverse(&r, &grid, n, false, true, &mut bad);
        // a ray that misses the box visits nothing in either
        let got_cells = if want.len() == 0 { want.len() } else { got.len() };
        cells = cells + (got_cells as i64);
        if want_hit >= 0 { hits = hits + 1; }
        if want.len() > 0 && !same_list(&want, &got) { visit_bad = visit_bad + 1; }
        if want_hit != got_hit { hit_bad = hit_bad + 1; }
        if got_hit_m != got_hit { layout_bad = layout_bad + 1; }
        if want.len() > 0 && !same_list(&want, &bad) { skip_visit_bad = skip_visit_bad + 1; }
        if want_hit != bad_hit { skip_hit_bad = skip_hit_bad + 1; }
        k = k + 1;
    }
    println!("rays {} cells {} rays_with_hit {}", rays, cells, hits);
    println!("visits {} mismatched {}", if visit_bad == 0 { "ok" } else { "FAIL" }, visit_bad);
    println!("hits {} mismatched {}", if hit_bad == 0 { "ok" } else { "FAIL" }, hit_bad);
    println!("layout {} mismatched {}", if layout_bad == 0 { "ok" } else { "FAIL" }, layout_bad);
    if skip_visit_bad > 0 {
        println!("control caught: corner skip differs on {} rays, first hit on {}", skip_visit_bad, skip_hit_bad);
    } else {
        println!("control MISSED: corner skip matched the reference");
    }
}
