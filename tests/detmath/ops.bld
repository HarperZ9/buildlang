// DETMATH section 1: the allowed operations beyond + - * / are sqrt, floor,
// abs, min and max, each correctly rounded or exact. Each line prints a bit
// pattern; ops.expected was written by JS (Math.sqrt, Math.floor, Math.abs,
// Math.min, Math.max) with tools/detmath_ops_expected.mjs.
fn bits(label: str, v: f64) ~ Console {
    println!("{} {:016x}", label, v.to_bits());
}

fn main() ~ Console {
    let nan = 0.0 / 0.0;
    let pz = 0.0;
    let nz = -0.0;
    bits("sqrt(2)", (2.0).sqrt());
    bits("sqrt(3)", sqrt(3.0));
    bits("sqrt(1e-300)", (1e-300).sqrt());
    bits("floor(-0.5)", (-0.5).floor());
    bits("floor(2.999999999999999)", floor(2.999999999999999));
    bits("floor(-1e300)", (-1e300).floor());
    bits("abs(-0)", nz.abs());
    bits("abs(-2.75)", abs(-2.75));
    bits("min(0,-0)", pz.min(nz));
    bits("min(-0,0)", nz.min(pz));
    bits("max(0,-0)", pz.max(nz));
    bits("max(-0,0)", nz.max(pz));
    bits("min(1,NaN) is NaN", if (1.0).min(nan) != (1.0).min(nan) { 1.0 } else { 0.0 });
    bits("max(NaN,1) is NaN", if nan.max(1.0) != nan.max(1.0) { 1.0 } else { 0.0 });
    bits("min(2.5,-1.25)", min(2.5, -1.25));
    bits("max(2.5,-1.25)", max(2.5, -1.25));
    bits("max(0.1,0.30000000000000004)", max(0.1, 0.30000000000000004));
    bits("1/3", 1.0 / 3.0);
    bits("0.1+0.2", 0.1 + 0.2);
}
