// `Vec::as_ptr` and `Vec::as_mut_ptr` hand a vector's buffer to C.

extern "C" {
    fn memcmp(a: *const u8, b: *const u8, n: usize) -> i32;
    fn memcpy(dst: *mut u8, src: *const u8, n: usize) -> *mut u8;
}

fn main() ~ Console + Foreign {
    let mut a: Vec<u8> = Vec::new();
    let mut b: Vec<u8> = Vec::new();
    let mut i: u32 = 0;
    while i < 8 {
        a.push((i * 31 + 7) as u8);
        b.push(0);
        i = i + 1;
    }
    // memcpy writes through as_mut_ptr; the vector sees the bytes.
    unsafe { memcpy(b.as_mut_ptr(), a.as_ptr(), 8); }
    println!("copied {} {} {}", b[0], b[3], b[7]);
    println!("equal {}", unsafe { memcmp(a.as_ptr(), b.as_ptr(), 8) } == 0);
    // A slice over the raw pointer reads the same elements (5 * 31 + 7 = 162).
    let view = unsafe { slice::from_raw_parts(a.as_ptr(), 8) };
    println!("view {} {}", view[5], view.len());
    // A Vec<u32>'s buffer is four bytes per element, low byte first on the
    // little-endian hosts the C backend targets.
    let mut w: Vec<u32> = Vec::new();
    w.push(258);
    let bytes = unsafe { slice::from_raw_parts(w.as_ptr() as *const u8, 4) };
    println!("u32 bytes {} {} {} {}", bytes[0], bytes[1], bytes[2], bytes[3]);
}
