struct G { v: i32 }
impl Drop for G { fn drop(&mut self) ~ Console { println!("drop {}", self.v); } }
impl G { fn consume(self) -> i32 ~ Console { println!("consume {}", self.v); self.v } }
struct Holder { g: G, n: i32 }
struct Pair { a: G, b: G }
fn extras() ~ Console {
    let g: G = G { v: 30 };
    let h: Holder = Holder { g, n: 1 };
    println!("holder {}", h.n);
    let p: Pair = Pair { a: G { v: 31 }, b: G { v: 32 } };
    println!("pair {}", p.a.v + p.b.v);
    let c: G = G { v: 33 };
    println!("consumed {}", c.consume());
    let m: G = G { v: 34 };
    match m { G { v } => println!("matched {}", v) }
    println!("extras end");
}
fn loops() ~ Console {
    let mut i: i32 = 0;
    while i < 3 {
        let a: G = G { v: 40 + i };
        if i == 1 {
            let b: G = G { v: 50 };
            println!("breaking");
            break;
        }
        i = i + 1;
    }
    let mut j: i32 = 0;
    while j < 2 {
        j = j + 1;
        let c: G = G { v: 60 + j };
        if j == 1 { continue; }
        let d: G = G { v: 70 + j };
        println!("tail {}", d.v);
    }
    println!("loops end");
}
fn check(ok: bool) -> Result<i32, str> { if ok { Ok(5) } else { Err("no") } }
fn step(ok: bool) -> Result<i32, str> ~ Console {
    let a: G = G { v: 80 };
    let b: G = G { v: 81 };
    let n: i32 = check(ok)?;
    println!("after ? {}", n);
    Ok(n + a.v + b.v)
}
fn take(g: G) ~ Console { println!("take {}", g.v); }
fn make(v: i32) -> G { G { v: v } }
fn early(flag: bool) -> i32 ~ Console {
    let a: G = G { v: 10 };
    if flag {
        let b: G = G { v: 11 };
        return b.v;
    }
    let c: G = G { v: 12 };
    c.v
}
fn pass_through(v: i32) -> G ~ Console {
    let g: G = G { v: v };
    let h: G = G { v: v + 100 };
    println!("built {}", h.v);
    g
}
fn main() ~ Console {
    {
        let a: G = G { v: 1 };
        let b: G = G { v: 2 };
        let c: G = G { v: 3 };
        println!("in {} {} {}", a.v, b.v, c.v);
    }
    println!("after block");
    {
        let m: G = G { v: 4 };
        take(m);
        println!("moved");
    }
    println!("{}", early(true));
    println!("{}", early(false));
    let mut r: G = make(5);
    r = make(6);
    println!("reassigned {}", r.v);
    let k: G = pass_through(7);
    println!("got {}", k.v);
    let n: G = k;
    println!("n {}", n.v);
    let mut i: i32 = 0;
    while i < 2 {
        let w: G = G { v: 20 + i };
        println!("loop {}", w.v);
        i = i + 1;
    }
    loops();
    match step(false) { Ok(v) => println!("ok {}", v), Err(e) => println!("err {}", e) }
    match step(true) { Ok(v) => println!("ok {}", v), Err(e) => println!("err {}", e) }
    extras();
    println!("end");
}
