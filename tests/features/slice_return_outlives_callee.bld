fn mid(v: &Vec<i32>) -> &[i32] { &v[1..3] }
fn tail(v: &Vec<i32>) -> &[i32] { &v[2..] }
fn deep(n: i32) -> i32 { let pad = [n, n, n, n, n, n, n, n]; if n == 0 { 0 } else { deep(n - 1) + pad[3] - n + 1 } }
fn total(s: &[i32]) -> i32 { let mut t: i32 = 0; for x in s { t = t + *x; } t }
fn main() ~ Console {
    let v: Vec<i32> = vec![10, 20, 30, 40, 50];
    let a = mid(&v);
    let b = tail(&v);
    println!("{}", deep(500));
    println!("{} {} {}", a.len(), a[0], a[1]);
    println!("{} {} {}", b.len(), b[0], total(b));
    println!("{}", total(a));
}
