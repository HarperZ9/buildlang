fn total(s: &[i32]) -> i32 { let mut t: i32 = 0; for x in s { t = t + *x; } t }
fn main() ~ Console {
    let v = vec!["c", "a", "b", "d"];
    let s = &v[1..3];
    println!("{} {} {}", s.len(), s[0], s[1]);
    let n: Vec<i32> = vec![10, 20, 30, 40, 50];
    let mid = &n[1..4];
    println!("{} {}", mid.len(), total(mid));
    let head = &n[..2];
    let tail = &n[3..];
    let all = &n[..];
    println!("{} {} {}", head.len(), tail.len(), all.len());
    let inc = &n[1..=3];
    println!("{} {}", inc.len(), inc[2]);
    let empty = &n[2..2];
    println!("{}", empty.len());
    let mut sum: i32 = 0;
    let rest = &n[2..];
    for x in rest { sum = sum + *x; }
    println!("{}", sum);
    let mut direct: i32 = 0;
    for x in &n[1..3] { direct = direct + *x; }
    println!("{}", direct);
    for w in &v[2..] { println!("{}", w); }
}
