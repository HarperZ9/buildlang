fn main() ~ Console {
    let s = "the quick brown fox";
    let mut words: Vec<str> = vec_new();
    for w in s.split(" ") {
        vec_push(words, w);
    }
    let n = vec_len(words);
    let mut i = n;
    while i > 0 {
        i -= 1;
        if i < n - 1 {
            print!(" ");
        }
        let w: str = vec_get(words, i);
        print!("{}", w);
    }
    println!("");
}
