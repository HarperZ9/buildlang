fn main() ~ Console {
    let mut a = [5, 3, 8, 1, 9, 2];
    let n = 6;
    let mut i = 0;
    while i < n {
        let mut j = 0;
        while j + 1 < n - i {
            if a[j] > a[j + 1] {
                let t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
            }
            j += 1;
        }
        i += 1;
    }
    let mut k = 0;
    while k < n {
        if k > 0 {
            print!(" ");
        }
        print!("{}", a[k]);
        k += 1;
    }
    println!("");
}
