fn safe_div(a: i32, b: i32) -> Option<i32> {
    if b == 0 {
        None
    } else {
        Some(a / b)
    }
}

fn main() ~ Console {
    let divisors = [2, 0, 5];
    let mut i = 0;
    while i < 3 {
        match safe_div(10, divisors[i]) {
            Some(q) => println!("{}", q),
            None => println!("error"),
        }
        i += 1;
    }
}
