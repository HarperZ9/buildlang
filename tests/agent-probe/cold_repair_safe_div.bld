fn safe_div(a: i32, b: i32) -> Option<i32> {
    if b == 0 {
        None
    } else {
        Some(a / b)
    }
}

fn main() ~ Console {
    let divisors = vec![2, 0, 5];
    let mut i = 0;
    while i < divisors.len() {
        let d = divisors[i];
        match safe_div(10, d) {
            Some(q) => println!("{}", q),
            None => println!("{}", "error"),
        }
        i = i + 1;
    }
}
