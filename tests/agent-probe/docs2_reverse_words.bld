fn main() ~ Console {
    let s = "the quick brown fox";
    let mut words = vec_new();
    for w in s.split(" ") {
        vec_push(&mut words, w);
    }
    let n = vec_len(&words) as i32;
    let mut i = n - 1;
    while i >= 0 {
        print!("{}", vec_get(&words, i));
        if i > 0 {
            print!(" ");
        }
        i = i - 1;
    }
    println!("");
}
