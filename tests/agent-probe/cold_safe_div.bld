fn safe_div(a: i32, b: i32) -> Option<i32> {
    if b == 0 {
        None
    } else {
        Some(a / b)
    }
}

fn main() ~ Console {
    let divisors = vec![2, 0, 5];
    for d in divisors.iter() {
        match safe_div(10, *d) {
            Some(q) => println!("{}", q),
            None => println!("{}", "error"),
        }
    }
}
