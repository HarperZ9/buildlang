fn main() ~ Console {
    let mut a = vec![5, 3, 8, 1, 9, 2];
    let n = a.len();
    let mut i = 1;
    while i < n {
        let key = a[i];
        let mut j = i;
        while j > 0 && a[j - 1] > key {
            a[j] = a[j - 1];
            j = j - 1;
        }
        a[j] = key;
        i = i + 1;
    }
    let mut out = String::new();
    let mut k = 0;
    while k < n {
        if k > 0 {
            out = out + " ";
        }
        let piece: String = a[k].to_string();
        out = out + piece;
        k = k + 1;
    }
    println!("{}", out);
}
