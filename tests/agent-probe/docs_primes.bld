fn is_prime(n: i32) -> bool {
    if n < 2 {
        return false;
    }
    let mut d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d += 1;
    }
    true
}

fn main() ~ Console {
    let mut sum = 0;
    for n in 2..100 {
        if is_prime(n) {
            sum += n;
        }
    }
    println!("{}", sum);
}
