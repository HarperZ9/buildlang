enum Shape {
    Square(i32),
    Rect(i32, i32),
    Tri(i32, i32),
}

fn area(s: &Shape) -> i32 {
    match s {
        Shape::Square(side) => side * side,
        Shape::Rect(w, h) => w * h,
        Shape::Tri(b, h) => b * h / 2,
    }
}

fn main() ~ Console {
    let shapes = vec![Shape::Square(3), Shape::Rect(2, 5), Shape::Tri(4, 6)];
    let mut total = 0;
    for s in shapes.iter() {
        total = total + area(s);
    }
    println!("{}", total);
}
