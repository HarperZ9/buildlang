// The C runtime without a 128-bit integer type (MSVC has none). The test compiles
// this program's C twice, once as it is and once with __int128 hidden from the
// compiler, and the two must print the same lines.
fn main() ~ Console {
    let a: u64 = 14695981039346656037;
    println!("{}", a.wrapping_mul(1099511628211));
    let b: i64 = 9223372036854775807;
    println!("{}", b.wrapping_add(1));
    println!("{}", b.wrapping_mul(3));
    let c: usize = 18446744073709551615;
    println!("{}", c.wrapping_add(2));
    println!("{}", "-9223372036854775808".parse_int());
    println!("{}", "9223372036854775807".parse_int());
    println!("{}", "123".parse_int() + 1);
    let z: f64 = 0.0;
    println!("{}", 1.0 / z);
    println!("{}", -1.0 / z);
    let x: f64 = 2.5;
    println!("{}", x.to_bits());
}
