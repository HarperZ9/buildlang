// The Low Water rules module (checks, skills, sheet, meters) behind a plain C
// ABI, in BuildLang. It implements raw-native's `raw/game/lowwater/rules_c.h`:
// the C++ host links this static library in place of the C++ module and runs
// the same test. The state is one opaque handle; strings cross as
// NUL-terminated UTF-8; a returned string stays valid until the next call on
// the same handle.
//
// Ported from raw-native `src/game/lowwater_ruleset.cpp`, `lowwater_rules.cpp`
// and the meter part of `lowwater_host.cpp`. Not ported: the story expression
// language. A record that needs it (a skill `base:`, an item `requires:`, a
// mod with `? cond`, a modifier `when:`) makes `lw_rules_create` fail with an
// error that names the record, rather than reading the expression as absent.

extern "C" {
    fn strlen(p: *const u8) -> usize;
    fn malloc(n: usize) -> *mut u8;
    fn free(p: *mut u8);
    fn strtod(p: *const u8, end: *mut *mut u8) -> f64;
}

struct Rec {
    kind: str,
    id: str,
    keys: Vec<str>,
    vals: Vec<str>,
}

struct Rule {
    key: str,
    is_num: bool,
    num: f64,
    text: str,
}

struct ModDef {
    target: str,
    amount: f64,
}

struct ItemDef {
    id: str,
    slot: str,
    mods: Vec<ModDef>,
}

struct SkillDef {
    id: str,
    attr: str,
}

struct ArchDef {
    id: str,
    attr_k: Vec<str>,
    attr_v: Vec<f64>,
    skill_k: Vec<str>,
    skill_v: Vec<f64>,
    item_k: Vec<str>,
    item_v: Vec<f64>,
}

struct ModifierDef {
    skills: Vec<str>,
    amount: f64,
}

struct MeterDef {
    id: str,
    full: str,
    min: f64,
    max: f64,
    start: f64,
}

struct LwRules {
    rules: Vec<Rule>,
    attr_order: Vec<str>,
    skills: Vec<SkillDef>,
    items: Vec<ItemDef>,
    archetypes: Vec<ArchDef>,
    modifiers: Vec<ModifierDef>,
    meters: Vec<MeterDef>,
    nodes: Vec<str>,
    errors: Vec<str>,
    // the sheet
    attr_k: Vec<str>,
    attr_v: Vec<f64>,
    rank_k: Vec<str>,
    rank_v: Vec<f64>,
    item_k: Vec<str>,
    item_v: Vec<f64>,
    slot_k: Vec<str>,
    slot_v: Vec<str>,
    archetype: str,
    // meters
    meter_k: Vec<str>,
    meter_v: Vec<f64>,
    full_ids: Vec<str>,
    queue: Vec<str>,
    // strings handed to the host, freed on the next call that hands one out
    scratch: *mut u8,
    scratch2: *mut u8,
}

static mut LAST_ERROR: *mut u8 = 0 as *mut u8;

// ---------------------------------------------------------------------------
// C strings

fn rl_from_c(p: *const u8) -> str ~ Foreign {
    let mut out = String::new();
    if p as usize == 0 {
        return out;
    }
    let n = unsafe { strlen(p) };
    let bytes = unsafe { slice::from_raw_parts(p, n) };
    let mut i: usize = 0;
    while i < n {
        out.push(bytes[i] as char);
        i = i + 1;
    }
    out
}

// A fresh NUL-terminated copy of `s`, owned by the caller.
fn rl_to_c(s: str) -> *mut u8 ~ Foreign {
    let n = s.len();
    let p = unsafe { malloc(n + 1) };
    let buf = unsafe { slice::from_raw_parts_mut(p, n + 1) };
    let mut i: usize = 0;
    for c in s.chars() {
        buf[i] = c as u8;
        i = i + 1;
    }
    buf[n] = 0;
    p
}

fn rl_set_error(msg: str) ~ Foreign {
    unsafe {
        if LAST_ERROR as usize != 0 {
            free(LAST_ERROR);
        }
        LAST_ERROR = rl_to_c(msg);
    }
}

// ---------------------------------------------------------------------------
// Text helpers

fn rl_is_space(c: str) -> bool {
    c == " " || c == "\t" || c == "\r" || c == "\n"
}

fn rl_trim(s: str) -> str {
    let n = s.len() as i64;
    let mut a: i64 = 0;
    while a < n && rl_is_space(s.char_at(a as usize)) {
        a = a + 1;
    }
    let mut b: i64 = n;
    while b > a && rl_is_space(s.char_at((b - 1) as usize)) {
        b = b - 1;
    }
    s.substring(a as usize, (b - a) as usize)
}

// strtod over the whole of `t`: Some(x) when every byte is consumed.
fn rl_strtod_all(t: str) -> Option<f64> ~ Foreign {
    if t.len() == 0 {
        return None;
    }
    let c = rl_to_c(t);
    let mut end: *mut u8 = 0 as *mut u8;
    let x = unsafe { strtod(c as *const u8, &mut end as *mut *mut u8) };
    let used = end as usize - c as usize;
    unsafe { free(c) };
    if used == t.len() {
        Some(x)
    } else {
        None
    }
}

// JS `isNaN(+v) ? v.trim() : +v` as the C++ port reads it; empty is 0.
fn rl_rule(key: str, v: str) -> Rule ~ Foreign {
    let t = rl_trim(v);
    if t.len() == 0 {
        return Rule { key: key, is_num: true, num: 0.0, text: "" };
    }
    let has_xn = t.contains("x") || t.contains("X") || t.contains("n") || t.contains("N");
    match rl_strtod_all(t) {
        Some(x) => {
            if has_xn {
                Rule { key: key, is_num: false, num: 0.0, text: t }
            } else {
                Rule { key: key, is_num: true, num: x, text: t }
            }
        },
        None => Rule { key: key, is_num: false, num: 0.0, text: t },
    }
}

fn rl_num_or(v: str, d: f64) -> f64 ~ Foreign {
    let t = rl_trim(v);
    match rl_strtod_all(t) {
        Some(x) => x,
        None => d,
    }
}

fn rl_one(r: &Rec, k: str) -> str {
    let mut i: usize = 0;
    while i < r.keys.len() {
        if r.keys[i] == k {
            return rl_trim(r.vals[i]);
        }
        i = i + 1;
    }
    ""
}

fn rl_has(r: &Rec, k: str) -> bool {
    let mut i: usize = 0;
    while i < r.keys.len() {
        if r.keys[i] == k {
            return true;
        }
        i = i + 1;
    }
    false
}

// "name n" -> (name, n); n is 1 when absent or unreadable.
fn rl_count_name(v: str) -> str {
    let t = rl_trim(v);
    let mut i: usize = 0;
    while i < t.len() {
        let c = t.char_at(i);
        if c == " " || c == "\t" {
            return t.substring(0, i);
        }
        i = i + 1;
    }
    t
}

fn rl_count_n(v: str) -> f64 ~ Foreign {
    let t = rl_trim(v);
    let mut i: usize = 0;
    while i < t.len() {
        let c = t.char_at(i);
        if c == " " || c == "\t" {
            return rl_num_or(t.substring(i, t.len() - i), 1.0);
        }
        i = i + 1;
    }
    1.0
}

// ---------------------------------------------------------------------------
// LWD/1 records (raw-native src/story/book.cpp parse_records)

fn rl_parse_records(text: str, errors: &mut Vec<str>) -> Vec<Rec> {
    let mut recs: Vec<Rec> = Vec::new();
    let lines = text.split("\n");
    let mut n: usize = 0;
    while n < lines.len() {
        let mut line = lines[n];
        if line.ends_with("\r") {
            line = line.substring(0, line.len() - 1);
        }
        let t = rl_trim(line);
        if t.len() == 0 || t.starts_with("#") {
            n = n + 1;
            continue;
        }
        if line.starts_with("@") {
            let rest = rl_trim(line.substring(1, line.len() - 1));
            let kind = rl_count_name(rest);
            let id = rl_count_name(rl_trim(rest.substring(kind.len(), rest.len() - kind.len())));
            recs.push(Rec { kind: kind, id: id, keys: Vec::new(), vals: Vec::new() });
            n = n + 1;
            continue;
        }
        if recs.len() == 0 {
            errors.push(format!("rules.lwd:{} content before any record", n + 1));
            n = n + 1;
            continue;
        }
        let k = line.index_of(":");
        if k < 0 {
            errors.push(format!("rules.lwd:{} expected \"key: value\"", n + 1));
            n = n + 1;
            continue;
        }
        let ku = k as usize;
        let mut v = line.substring(ku + 1, line.len() - ku - 1);
        if v.starts_with(" ") {
            v = v.substring(1, v.len() - 1);
        }
        let last = recs.len() - 1;
        recs[last].keys.push(rl_trim(line.substring(0, ku)));
        recs[last].vals.push(v);
        n = n + 1;
    }
    recs
}

// "target +n" (raw-native parse_mod); a "? cond" tail is refused, not dropped.
fn rl_parse_mod(text: str, err: &mut Vec<str>) -> ModDef ~ Foreign {
    let t = rl_trim(text);
    if t.contains("?") {
        err.push(format!("mod conditions are not ported: {}", t));
        return ModDef { target: "", amount: 0.0 };
    }
    let mut i: usize = 0;
    while i < t.len() {
        let c = t.char_at(i);
        if c == "+" || c == "-" || c == " " || c == "\t" {
            break;
        }
        i = i + 1;
    }
    let target = t.substring(0, i);
    let mut num = String::new();
    let mut j = i;
    while j < t.len() {
        let c = t.char_at(j);
        if c != " " && c != "\t" {
            num.push_str(c);
        }
        j = j + 1;
    }
    let ok = target.len() > 0 && (num.starts_with("+") || num.starts_with("-")) && num.len() > 1;
    if !ok {
        err.push(format!("mod: expected \"target +n [? cond]\", got {}", text));
        return ModDef { target: "", amount: 0.0 };
    }
    ModDef { target: target, amount: rl_num_or(num, 0.0) }
}

fn rl_refuse_expr(r: &Rec, key: str, errs: &mut Vec<str>) {
    if rl_one(r, key).len() > 0 {
        errs.push(format!("{} {}: `{}` needs the story expression language, which is not ported", r.kind, r.id, key));
    }
}

fn rl_load(text: str) -> LwRules ~ Foreign {
    let mut errors: Vec<str> = Vec::new();
    let recs = rl_parse_records(text, &mut errors);
    let mut rules: Vec<Rule> = Vec::new();
    rules.push(Rule { key: "xp-per-level", is_num: true, num: 100.0, text: "" });
    rules.push(Rule { key: "points-per-level", is_num: true, num: 1.0, text: "" });
    rules.push(Rule { key: "skill-cap", is_num: true, num: 4.0, text: "" });
    rules.push(Rule { key: "attr-min", is_num: true, num: 1.0, text: "" });
    rules.push(Rule { key: "strain-max", is_num: true, num: 3.0, text: "" });
    rules.push(Rule { key: "rep-min", is_num: true, num: -100.0, text: "" });
    rules.push(Rule { key: "check-mode", is_num: false, num: 0.0, text: "dice" });
    let mut st = LwRules {
        rules: rules,
        attr_order: Vec::new(),
        skills: Vec::new(),
        items: Vec::new(),
        archetypes: Vec::new(),
        modifiers: Vec::new(),
        meters: Vec::new(),
        nodes: Vec::new(),
        errors: Vec::new(),
        attr_k: Vec::new(),
        attr_v: Vec::new(),
        rank_k: Vec::new(),
        rank_v: Vec::new(),
        item_k: Vec::new(),
        item_v: Vec::new(),
        slot_k: Vec::new(),
        slot_v: Vec::new(),
        archetype: "",
        meter_k: Vec::new(),
        meter_v: Vec::new(),
        full_ids: Vec::new(),
        queue: Vec::new(),
        scratch: 0 as *mut u8,
        scratch2: 0 as *mut u8,
    };
    let mut ri: usize = 0;
    while ri < recs.len() {
        let r = &recs[ri];
        let mut errs: Vec<str> = Vec::new();
        if r.kind == "node" {
            st.nodes.push(r.id);
        } else if r.kind == "rules" {
            let mut i: usize = 0;
            while i < r.keys.len() {
                let rule = rl_rule(r.keys[i], r.vals[i]);
                let mut found = false;
                let mut j: usize = 0;
                while j < st.rules.len() {
                    if st.rules[j].key == r.keys[i] {
                        st.rules[j] = rule;
                        found = true;
                        break;
                    }
                    j = j + 1;
                }
                if !found {
                    st.rules.push(rl_rule(r.keys[i], r.vals[i]));
                }
                i = i + 1;
            }
        } else if r.kind == "attr" {
            st.attr_order.push(r.id);
        } else if r.kind == "skill" {
            let attr = rl_one(r, "attr");
            if attr.len() > 0 && rl_index(&st.attr_order, attr) < 0 {
                errs.push(format!("skill {}: attr {} is not defined", r.id, attr));
            }
            rl_refuse_expr(r, "base", &mut errs);
            st.skills.push(SkillDef { id: r.id, attr: attr });
        } else if r.kind == "item" {
            let mut mods: Vec<ModDef> = Vec::new();
            let mut i: usize = 0;
            while i < r.keys.len() {
                if r.keys[i] == "mod" {
                    mods.push(rl_parse_mod(r.vals[i], &mut errs));
                }
                i = i + 1;
            }
            rl_refuse_expr(r, "requires", &mut errs);
            st.items.push(ItemDef { id: r.id, slot: rl_one(r, "slot"), mods: mods });
        } else if r.kind == "modifier" {
            let mut skills: Vec<str> = Vec::new();
            let list = rl_one(r, "skill");
            if rl_has(r, "skill") && list.len() > 0 {
                let parts = list.split(",");
                let mut i: usize = 0;
                while i < parts.len() {
                    let p = rl_trim(parts[i]);
                    if p.len() > 0 {
                        skills.push(p);
                    }
                    i = i + 1;
                }
            } else {
                skills.push("*");
            }
            rl_refuse_expr(r, "when", &mut errs);
            st.modifiers.push(ModifierDef { skills: skills, amount: rl_num_or(rl_one(r, "mod"), 0.0) });
        } else if r.kind == "archetype" {
            let mut a = ArchDef {
                id: r.id,
                attr_k: Vec::new(),
                attr_v: Vec::new(),
                skill_k: Vec::new(),
                skill_v: Vec::new(),
                item_k: Vec::new(),
                item_v: Vec::new(),
            };
            let mut i: usize = 0;
            while i < r.keys.len() {
                let k = r.keys[i];
                let v = r.vals[i];
                if k == "attr" {
                    a.attr_k.push(rl_count_name(v));
                    a.attr_v.push(rl_count_n(v));
                } else if k == "skill" {
                    a.skill_k.push(rl_count_name(v));
                    a.skill_v.push(rl_count_n(v));
                } else if k == "item" {
                    a.item_k.push(rl_count_name(v));
                    a.item_v.push(rl_count_n(v));
                }
                i = i + 1;
            }
            st.archetypes.push(a);
        } else if r.kind == "meter" {
            st.meters.push(MeterDef {
                id: r.id,
                full: rl_one(r, "full"),
                min: rl_num_or(rl_one(r, "min"), 0.0),
                max: rl_num_or(rl_one(r, "max"), 1.0),
                start: rl_num_or(rl_one(r, "start"), 0.0),
            });
        }
        let mut e: usize = 0;
        while e < errs.len() {
            st.errors.push(format!("{} {}: {}", r.kind, r.id, errs[e]));
            e = e + 1;
        }
        ri = ri + 1;
    }
    let mut e: usize = 0;
    while e < errors.len() {
        st.errors.push(errors[e]);
        e = e + 1;
    }
    let amin = rl_rule_num(&st, "attr-min", 1.0);
    let mut i: usize = 0;
    while i < st.attr_order.len() {
        st.attr_k.push(st.attr_order[i]);
        st.attr_v.push(amin);
        i = i + 1;
    }
    st
}

// ---------------------------------------------------------------------------
// Lookups

fn rl_index(v: &Vec<str>, k: str) -> i64 {
    let mut i: usize = 0;
    while i < v.len() {
        if v[i] == k {
            return i as i64;
        }
        i = i + 1;
    }
    -1
}

fn rl_rule_num(st: &LwRules, k: str, d: f64) -> f64 {
    let mut i: usize = 0;
    while i < st.rules.len() {
        if st.rules[i].key == k {
            if st.rules[i].is_num {
                return st.rules[i].num;
            }
            return d;
        }
        i = i + 1;
    }
    d
}

fn rl_rule_str(st: &LwRules, k: str) -> str {
    let mut i: usize = 0;
    while i < st.rules.len() {
        if st.rules[i].key == k {
            return st.rules[i].text;
        }
        i = i + 1;
    }
    ""
}

fn rl_item_at(st: &LwRules, id: str) -> i64 {
    let mut i: usize = 0;
    while i < st.items.len() {
        if st.items[i].id == id {
            return i as i64;
        }
        i = i + 1;
    }
    -1
}

fn rl_meter_at(st: &LwRules, id: str) -> i64 {
    let mut i: usize = 0;
    while i < st.meters.len() {
        if st.meters[i].id == id {
            return i as i64;
        }
        i = i + 1;
    }
    -1
}

// key -> value in a parallel pair, `d` when absent.
fn rl_get(k: &Vec<str>, v: &Vec<f64>, key: str, d: f64) -> f64 {
    let i = rl_index(k, key);
    if i < 0 {
        return d;
    }
    v[i as usize]
}

// ---------------------------------------------------------------------------
// The sheet (raw-native lowwater_rules.cpp)

fn rl_worn(st: &LwRules, id: str) -> bool {
    let it = rl_item_at(st, id);
    if it < 0 {
        return false;
    }
    let slot = st.items[it as usize].slot;
    if slot.len() == 0 {
        return false;
    }
    let e = rl_index(&st.slot_k, slot);
    e >= 0 && st.slot_v[e as usize] == id
}

fn rl_give(st: &mut LwRules, id: str, n: f64) {
    let i = rl_index(&st.item_k, id);
    if i < 0 {
        // std::map order: insert sorted by id
        let mut at: usize = 0;
        while at < st.item_k.len() && st.item_k[at] < id {
            at = at + 1;
        }
        st.item_k.insert(at, id);
        st.item_v.insert(at, n);
    } else {
        let u = i as usize;
        st.item_v[u] = st.item_v[u] + n;
    }
}

fn rl_equip(st: &mut LwRules, id: str) -> bool {
    let it = rl_item_at(st, id);
    if it < 0 {
        return false;
    }
    let slot = st.items[it as usize].slot;
    if slot.len() == 0 {
        return false;
    }
    if rl_get(&st.item_k, &st.item_v, id, 0.0) == 0.0 {
        return false;
    }
    let e = rl_index(&st.slot_k, slot);
    if e < 0 {
        st.slot_k.push(slot);
        st.slot_v.push(id);
    } else {
        st.slot_v[e as usize] = id;
    }
    true
}

// Sum of the amounts of every active item mod on `target`, in item-id order.
fn rl_active(st: &LwRules, target: str, parts: &mut Vec<f64>) {
    let mut i: usize = 0;
    while i < st.item_k.len() {
        let id = st.item_k[i];
        let it = rl_item_at(st, id);
        if it >= 0 && st.item_v[i] != 0.0 {
            let def = &st.items[it as usize];
            if def.slot.len() == 0 || rl_worn(st, id) {
                let mut m: usize = 0;
                while m < def.mods.len() {
                    if def.mods[m].target == target {
                        parts.push(def.mods[m].amount);
                    }
                    m = m + 1;
                }
            }
        }
        i = i + 1;
    }
}

fn rl_attr(st: &LwRules, id: str) -> f64 {
    let mut v = rl_get(&st.attr_k, &st.attr_v, id, 0.0);
    let mut parts: Vec<f64> = Vec::new();
    rl_active(st, format!("attr.{}", id), &mut parts);
    let mut i: usize = 0;
    while i < parts.len() {
        v = v + parts[i];
        i = i + 1;
    }
    v
}

fn rl_skill(st: &LwRules, id: str) -> f64 {
    let mut parts: Vec<f64> = Vec::new();
    let mut base = 0.0;
    let mut s: usize = 0;
    while s < st.skills.len() {
        if st.skills[s].id == id {
            if st.skills[s].attr.len() > 0 {
                base = rl_attr(st, st.skills[s].attr);
            }
            break;
        }
        s = s + 1;
    }
    parts.push(base);
    let r = rl_get(&st.rank_k, &st.rank_v, id, 0.0);
    if r != 0.0 {
        parts.push(r);
    }
    rl_active(st, format!("skill.{}", id), &mut parts);
    let mut m: usize = 0;
    while m < st.modifiers.len() {
        let mut hit = false;
        let mut k: usize = 0;
        while k < st.modifiers[m].skills.len() {
            let sk = st.modifiers[m].skills[k];
            if sk == "*" || sk == id {
                hit = true;
            }
            k = k + 1;
        }
        if hit {
            parts.push(st.modifiers[m].amount);
        }
        m = m + 1;
    }
    let mut t = 0.0;
    let mut i: usize = 0;
    while i < parts.len() {
        t = t + parts[i];
        i = i + 1;
    }
    t
}

fn rl_label(st: &LwRules, dc: f64) -> str ~ Foreign {
    let spec = rl_rule_str(st, "dc-labels");
    let mut l = "";
    if spec.len() == 0 {
        let at: Vec<f64> = vec![0.0, 8.0, 10.0, 12.0, 14.0, 16.0, 18.0, 20.0];
        let names: Vec<str> = vec!["Trivial", "Easy", "Medium", "Challenging", "Formidable", "Legendary", "Heroic", "Impossible"];
        let mut i: usize = 0;
        while i < at.len() {
            if dc >= at[i] {
                l = names[i];
            }
            i = i + 1;
        }
        return l;
    }
    let ents = spec.split(",");
    let mut i: usize = 0;
    while i < ents.len() {
        let e = rl_trim(ents[i]);
        if e.len() > 0 {
            let first = rl_count_name(e);
            let rest = rl_trim(e.substring(first.len(), e.len() - first.len()));
            if dc >= rl_num_or(first, 0.0) {
                l = rest;
            }
        }
        i = i + 1;
    }
    l
}

fn rl_become(st: &mut LwRules, id: str) -> i32 ~ Foreign {
    let mut a: i64 = -1;
    let mut i: usize = 0;
    while i < st.archetypes.len() {
        if st.archetypes[i].id == id {
            a = i as i64;
        }
        i = i + 1;
    }
    if a < 0 {
        rl_set_error(format!("become: no archetype {}", id));
        return -1;
    }
    if st.archetype == id {
        return 0;
    }
    let amin = rl_rule_num(st, "attr-min", 1.0);
    let mut k: usize = 0;
    while k < st.attr_v.len() {
        if rl_index(&st.attr_order, st.attr_k[k]) >= 0 {
            st.attr_v[k] = amin;
        }
        k = k + 1;
    }
    let au = a as usize;
    let mut j: usize = 0;
    while j < st.archetypes[au].attr_k.len() {
        let key = st.archetypes[au].attr_k[j];
        let val = st.archetypes[au].attr_v[j];
        let e = rl_index(&st.attr_k, key);
        if e < 0 {
            st.attr_k.push(key);
            st.attr_v.push(val);
        } else {
            st.attr_v[e as usize] = val;
        }
        j = j + 1;
    }
    st.rank_k = Vec::new();
    st.rank_v = Vec::new();
    j = 0;
    while j < st.archetypes[au].skill_k.len() {
        let key = st.archetypes[au].skill_k[j];
        let val = st.archetypes[au].skill_v[j];
        let e = rl_index(&st.rank_k, key);
        if e < 0 {
            st.rank_k.push(key);
            st.rank_v.push(val);
        } else {
            st.rank_v[e as usize] = val;
        }
        j = j + 1;
    }
    st.archetype = id;
    j = 0;
    while j < st.archetypes[au].item_k.len() {
        let it = st.archetypes[au].item_k[j];
        let n = st.archetypes[au].item_v[j];
        rl_give(st, it, n);
        let d = rl_item_at(st, it);
        if d >= 0 && st.items[d as usize].slot.len() > 0 {
            rl_equip(st, it);
        }
        j = j + 1;
    }
    0
}

// ---------------------------------------------------------------------------
// Meters (raw-native lowwater_host.cpp)

fn rl_meter(st: &LwRules, id: str) -> f64 {
    let m = rl_meter_at(st, id);
    if m < 0 {
        return 0.0;
    }
    rl_get(&st.meter_k, &st.meter_v, id, st.meters[m as usize].start)
}

fn rl_meter_add(st: &mut LwRules, id: str, n: f64) -> i32 ~ Foreign {
    let m = rl_meter_at(st, id);
    if m < 0 {
        rl_set_error(format!("no meter {}", id));
        return -1;
    }
    let mu = m as usize;
    let lo = st.meters[mu].min;
    let hi = st.meters[mu].max;
    let full = st.meters[mu].full;
    let before = rl_meter(st, id);
    let after = lo.max(hi.min(before + n));
    let e = rl_index(&st.meter_k, id);
    if e < 0 {
        st.meter_k.push(id);
        st.meter_v.push(after);
    } else {
        st.meter_v[e as usize] = after;
    }
    let f = rl_index(&st.full_ids, id);
    if after >= hi && f < 0 && full.len() > 0 {
        st.full_ids.push(id);
        st.queue.push(id);
    } else if after < hi && f >= 0 {
        st.full_ids.remove(f as usize);
    }
    0
}

fn rl_full_node(st: &LwRules, id: str) -> str {
    let m = rl_meter_at(st, id);
    if m < 0 {
        return "";
    }
    let f = st.meters[m as usize].full;
    if f.len() == 0 {
        return "";
    }
    let g = f.replace("$trait", "default").replace("$district", "");
    if rl_index(&st.nodes, g) >= 0 {
        return g;
    }
    let cut = f.index_of(".$");
    let bare = if cut < 0 { f } else { f.substring(0, cut as usize) };
    if rl_index(&st.nodes, bare) >= 0 {
        return bare;
    }
    ""
}

// ---------------------------------------------------------------------------
// The C ABI (raw-native raw/game/lowwater/rules_c.h)

extern "C" fn lw_rules_create(lwd_text: *const u8, seed: u32) -> *mut LwRules ~ Foreign {
    let text = rl_from_c(lwd_text);
    let st = rl_load(text);
    if st.errors.len() > 0 {
        rl_set_error(st.errors[0]);
        return 0 as *mut LwRules;
    }
    let b = Box::new(st);
    b as *mut LwRules
}

extern "C" fn lw_rules_destroy(r: *mut LwRules) ~ Foreign {
    if r as usize == 0 {
        return;
    }
    unsafe {
        if (*r).scratch as usize != 0 {
            free((*r).scratch);
        }
        if (*r).scratch2 as usize != 0 {
            free((*r).scratch2);
        }
        free(r as *mut u8);
    }
}

extern "C" fn lw_rules_last_error() -> *const u8 ~ Foreign {
    unsafe {
        if LAST_ERROR as usize == 0 {
            LAST_ERROR = rl_to_c("");
        }
        LAST_ERROR as *const u8
    }
}

extern "C" fn lw_rules_become(r: *mut LwRules, archetype: *const u8) -> i32 ~ Foreign {
    let id = rl_from_c(archetype);
    unsafe { rl_become(&mut *r, id) }
}

extern "C" fn lw_rules_skill(r: *mut LwRules, skill: *const u8) -> f64 ~ Foreign {
    let id = rl_from_c(skill);
    unsafe { rl_skill(&*r, id) }
}

extern "C" fn lw_rules_attr(r: *mut LwRules, attr: *const u8) -> f64 ~ Foreign {
    let id = rl_from_c(attr);
    unsafe { rl_attr(&*r, id) }
}

extern "C" fn lw_rules_passive(r: *mut LwRules, skill: *const u8, dc: f64, label: *mut *const u8) -> i32 ~ Foreign {
    let id = rl_from_c(skill);
    let total = unsafe { rl_skill(&*r, id) };
    if label as usize != 0 {
        let l = unsafe { rl_label(&*r, dc) };
        unsafe {
            if (*r).scratch as usize != 0 {
                free((*r).scratch);
            }
            (*r).scratch = rl_to_c(l);
            *label = (*r).scratch as *const u8;
        }
    }
    if total >= dc {
        1
    } else {
        0
    }
}

extern "C" fn lw_rules_meter(r: *const LwRules, id: *const u8) -> f64 ~ Foreign {
    let k = rl_from_c(id);
    unsafe { rl_meter(&*r, k) }
}

extern "C" fn lw_rules_meter_add(r: *mut LwRules, id: *const u8, amount: f64) -> i32 ~ Foreign {
    let k = rl_from_c(id);
    unsafe { rl_meter_add(&mut *r, k, amount) }
}

extern "C" fn lw_rules_take_full(r: *mut LwRules, meter: *mut *const u8) -> *const u8 ~ Foreign {
    unsafe {
        while (*r).queue.len() > 0 {
            let id = (*r).queue[0];
            (*r).queue.remove(0);
            let node = rl_full_node(&*r, id);
            if node.len() > 0 {
                if (*r).scratch as usize != 0 {
                    free((*r).scratch);
                }
                if (*r).scratch2 as usize != 0 {
                    free((*r).scratch2);
                }
                (*r).scratch = rl_to_c(node);
                (*r).scratch2 = rl_to_c(id);
                if meter as usize != 0 {
                    *meter = (*r).scratch2 as *const u8;
                }
                return (*r).scratch as *const u8;
            }
        }
    }
    0 as *const u8
}
