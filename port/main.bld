// SPDX-License-Identifier: MIT
//
// port: move a program from another language into BuildLang in one step.
//
//   port c input.c output.bld
//
// This first slice reads a C subset: functions over int, long, unsigned, char, float and double,
// local variables and fixed arrays, if, while, do, for, break, continue, return, the ternary,
// casts, the math.h functions BuildLang has, and printf with a literal format. Anything outside
// the subset is listed with its line and nothing is written, so a port is whole or it is refused.
//
// The translation is syntax directed: one pass collects every function's signature and whether it
// prints, a second pass writes BuildLang. C converts between number types silently; BuildLang
// does not, so every conversion C makes is written out as a cast.
//
// Exit status: 0 written, 2 refused (constructs listed), 1 bad arguments.

// ------------------------------------------------------------------ type codes
// 0 void, 1 i32, 2 i64, 3 f64, 4 f32, 5 u8, 6 u32, 7 bool. An array of T is 100 + T.

fn tname(t: i32) -> String {
    if t == 1 { return String::from("i32"); }
    if t == 2 { return String::from("i64"); }
    if t == 3 { return String::from("f64"); }
    if t == 4 { return String::from("f32"); }
    if t == 5 { return String::from("u8"); }
    if t == 6 { return String::from("u32"); }
    if t == 7 { return String::from("bool"); }
    String::from("()")
}

fn zero_of(t: i32) -> String {
    if t == 3 || t == 4 { return String::from("0.0"); }
    if t == 7 { return String::from("false"); }
    String::from("0")
}

// C's usual arithmetic conversions, as a rank: the wider type wins.
fn rank(t: i32) -> i32 {
    if t == 3 { return 6; }
    if t == 4 { return 5; }
    if t == 2 { return 4; }
    if t == 6 { return 3; }
    2
}

fn of_rank(r: i32) -> i32 {
    if r == 6 { return 3; }
    if r == 5 { return 4; }
    if r == 4 { return 2; }
    if r == 3 { return 6; }
    1
}

fn conv(text: String, from: i32, to: i32) -> String {
    if from == to { return text; }
    if to == 7 { return "(" + text + " != " + zero_of(from) + ")"; }
    "((" + text + ") as " + tname(to) + ")"
}

// ------------------------------------------------------------------ the lexer
// Token kinds: 0 end, 1 name, 2 integer, 3 float, 4 string, 5 character, 6 punctuation,
// 7 preprocessor line.

fn is_alpha(c: u8) -> bool { (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 }
fn is_digit(c: u8) -> bool { c >= 48 && c <= 57 }

fn lex(src: String, kind: Vec<i32>, text: Vec<String>, line: Vec<i32>) {
    let b = src.as_bytes();
    let n: usize = src.len();
    let mut i: usize = 0;
    let mut ln: i32 = 1;
    while i < n {
        let c: u8 = b[i];
        if c == 10 { ln = ln + 1; i = i + 1; continue; }
        if c == 32 || c == 9 || c == 13 { i = i + 1; continue; }
        if c == 47 && i + 1 < n && b[i + 1] == 47 {
            while i < n && b[i] != 10 { i = i + 1; }
            continue;
        }
        if c == 47 && i + 1 < n && b[i + 1] == 42 {
            i = i + 2;
            while i + 1 < n && !(b[i] == 42 && b[i + 1] == 47) {
                if b[i] == 10 { ln = ln + 1; }
                i = i + 1;
            }
            i = i + 2;
            continue;
        }
        let start: usize = i;
        if c == 35 {
            while i < n && b[i] != 10 { i = i + 1; }
            kind.push(7); text.push(src.substring(start, i - start).trim()); line.push(ln);
            continue;
        }
        if is_alpha(c) {
            while i < n && (is_alpha(b[i]) || is_digit(b[i])) { i = i + 1; }
            kind.push(1); text.push(src.substring(start, i - start)); line.push(ln);
            continue;
        }
        if is_digit(c) || (c == 46 && i + 1 < n && is_digit(b[i + 1])) {
            let mut is_float: bool = false;
            let hex: bool = c == 48 && i + 1 < n && (b[i + 1] == 120 || b[i + 1] == 88);
            if hex { i = i + 2; }
            while i < n {
                let d: u8 = b[i];
                if is_digit(d) || (hex && is_alpha(d)) { i = i + 1; continue; }
                if !hex && d == 46 { is_float = true; i = i + 1; continue; }
                if !hex && (d == 101 || d == 69) {
                    is_float = true;
                    i = i + 1;
                    if i < n && (b[i] == 43 || b[i] == 45) { i = i + 1; }
                    continue;
                }
                break;
            }
            let mut body: String = src.substring(start, i - start);
            // suffixes decide the literal's type: f is float, l is long, u is unsigned
            let mut sf: bool = false;
            let mut sl: bool = false;
            let mut su: bool = false;
            while i < n && (b[i] == 102 || b[i] == 70 || b[i] == 108 || b[i] == 76 || b[i] == 117 || b[i] == 85) {
                if b[i] == 102 || b[i] == 70 { sf = true; }
                if b[i] == 108 || b[i] == 76 { sl = true; }
                if b[i] == 117 || b[i] == 85 { su = true; }
                i = i + 1;
            }
            if is_float {
                if body.starts_with(".") { body = "0" + body; }
                if body.ends_with(".") { body = body + "0"; }
                if !body.contains(".") { body = "((" + body + ") as f64)"; }
                if sf { body = "((" + body + ") as f32)"; kind.push(10); } else { kind.push(3); }
            } else if sl {
                body = "((" + body + ") as i64)"; kind.push(8);
            } else if su {
                body = "((" + body + ") as u32)"; kind.push(9);
            } else {
                kind.push(2);
            }
            text.push(body); line.push(ln);
            continue;
        }
        if c == 34 || c == 39 {
            i = i + 1;
            while i < n && b[i] != c {
                if b[i] == 92 { i = i + 1; }
                i = i + 1;
            }
            i = i + 1;
            if c == 34 { kind.push(4); } else { kind.push(5); }
            text.push(src.substring(start, i - start)); line.push(ln);
            continue;
        }
        // punctuation, longest first
        let mut len: usize = 1;
        if i + 1 < n {
            let d: u8 = b[i + 1];
            let two: bool = (d == 61 && (c == 61 || c == 33 || c == 60 || c == 62 || c == 43 || c == 45 || c == 42 || c == 47 || c == 37))
                || (c == 43 && d == 43) || (c == 45 && d == 45) || (c == 38 && d == 38) || (c == 124 && d == 124)
                || (c == 60 && d == 60) || (c == 62 && d == 62) || (c == 45 && d == 62);
            if two { len = 2; }
        }
        i = i + len;
        kind.push(6); text.push(src.substring(start, len)); line.push(ln);
    }
    kind.push(0); text.push(String::from("")); line.push(ln);
}

// ------------------------------------------------------------------ parser state
// st[0] position, st[1] type of the last expression, st[2] refusals, st[3] indent,
// st[4] return type of the function being written, st[5] 1 inside main,
// st[6] live symbols (Vec<String> has no pop yet, so the count is kept here), st[7] loop depth.

struct Toks { kind: Vec<i32>, text: Vec<String>, line: Vec<i32> }
struct Syms { names: Vec<String>, types: Vec<i32> }
struct Fns { names: Vec<String>, ret: Vec<i32>, first: Vec<i32>, count: Vec<i32>, ptypes: Vec<i32>, prints: Vec<i32>, callers: Vec<i32>, callees: Vec<String> }

fn cur(t: Toks, st: Vec<i32>) -> String { t.text[st[0] as usize] }
fn cur_kind(t: Toks, st: Vec<i32>) -> i32 { t.kind[st[0] as usize] }
fn peek(t: Toks, st: Vec<i32>, k: i32) -> String {
    let p: usize = (st[0] + k) as usize;
    if p >= t.text.len() { return String::from(""); }
    t.text[p]
}
fn advance(st: Vec<i32>) { st[0] = st[0] + 1; }

// One refusal a source line: the first thing wrong on a line is the useful one, and what
// follows it on that line is the parser recovering.
fn refuse(t: Toks, st: Vec<i32>, why: String) ~ Console {
    let ln: i32 = t.line[st[0] as usize];
    if ln == st[8] { return; }
    st[8] = ln;
    println!("  line {}: {} (at `{}`)", ln, why, cur(t, st));
    st[2] = st[2] + 1;
}

// Skips to the end of the construct at the cursor: past its `;`, or past its `{ ... }` block.
fn skip_construct(t: Toks, st: Vec<i32>) {
    let mut depth: i32 = 0;
    while cur_kind(t, st) != 0 {
        let w: String = cur(t, st);
        advance(st);
        if w == "{" { depth = depth + 1; }
        if w == "}" { depth = depth - 1; if depth <= 0 { if cur(t, st) == ";" { advance(st); } return; } }
        if w == ";" && depth == 0 { return; }
    }
}

fn expect(t: Toks, st: Vec<i32>, p: String) ~ Console {
    if cur(t, st) == p { advance(st); return; }
    refuse(t, st, "expected `" + p + "`");
    advance(st);
}

fn is_type_word(w: String) -> bool {
    w == "int" || w == "long" || w == "double" || w == "float" || w == "char" || w == "void"
        || w == "unsigned" || w == "signed" || w == "short" || w == "const" || w == "static"
}

// Reads a type at the cursor. -1 when the type is outside the subset.
fn parse_type(t: Toks, st: Vec<i32>) -> i32 {
    let mut unsigned: bool = false;
    let mut longs: i32 = 0;
    let mut base: i32 = -2;
    while cur_kind(t, st) == 1 && is_type_word(cur(t, st)) {
        let w: String = cur(t, st);
        if w == "unsigned" { unsigned = true; }
        if w == "long" { longs = longs + 1; }
        if w == "int" || w == "short" || w == "signed" { if base == -2 { base = 1; } }
        if w == "double" { base = 3; }
        if w == "float" { base = 4; }
        if w == "char" { base = 5; }
        if w == "void" { base = 0; }
        advance(st);
    }
    if cur(t, st) == "*" { return -1; }
    if base == 3 || base == 4 || base == 5 || base == 0 { return base; }
    if longs > 0 { return 2; }
    if unsigned { return 6; }
    1
}

fn find_var(sy: Syms, st: Vec<i32>, name: String) -> i32 {
    let mut i: i32 = st[6] - 1;
    while i >= 0 {
        if sy.names[i as usize] == name { return sy.types[i as usize]; }
        i = i - 1;
    }
    -1
}

fn add_sym(sy: Syms, st: Vec<i32>, name: String, ty: i32) {
    let at: usize = st[6] as usize;
    if at < sy.names.len() { sy.names[at] = name; sy.types[at] = ty; } else { sy.names.push(name); sy.types.push(ty); }
    st[6] = st[6] + 1;
}

fn push_step(steps: Vec<String>, st: Vec<i32>, step: String) {
    let at: usize = st[7] as usize;
    if at < steps.len() { steps[at] = step; } else { steps.push(step); }
    st[7] = st[7] + 1;
}

fn find_fn(f: Fns, name: String) -> i32 {
    let mut i: usize = 0;
    while i < f.names.len() {
        if f.names[i] == name { return i as i32; }
        i = i + 1;
    }
    -1
}

// ------------------------------------------------------------------ pass one: signatures

fn collect(t: Toks, f: Fns) {
    let st: Vec<i32> = vec![0, 0, 0, 0, 0, 0, 0, 0, 0];
    while cur_kind(t, st) != 0 {
        if cur_kind(t, st) == 1 && is_type_word(cur(t, st)) {
            let ret: i32 = parse_type(t, st);
            if cur_kind(t, st) == 1 && peek(t, st, 1) == "(" && ret >= 0 {
                let name: String = cur(t, st);
                advance(st); advance(st);
                let first: i32 = f.ptypes.len() as i32;
                let mut count: i32 = 0;
                while cur(t, st) != ")" && cur_kind(t, st) != 0 {
                    if cur_kind(t, st) == 1 && is_type_word(cur(t, st)) {
                        let pt: i32 = parse_type(t, st);
                        if pt > 0 { f.ptypes.push(pt); count = count + 1; }
                        if pt < 0 { f.ptypes.push(-1); count = count + 1; }
                    } else {
                        advance(st);
                    }
                }
                advance(st);
                let known: i32 = find_fn(f, name);
                let mut idx: i32 = known;
                if known < 0 {
                    idx = f.names.len() as i32;
                    f.names.push(name); f.ret.push(ret); f.first.push(first); f.count.push(count); f.prints.push(0);
                }
                if cur(t, st) == "{" {
                    let mut depth: i32 = 0;
                    loop {
                        let w: String = cur(t, st);
                        if w == "{" { depth = depth + 1; }
                        if w == "}" { depth = depth - 1; if depth == 0 { advance(st); break; } }
                        if cur_kind(t, st) == 0 { break; }
                        if cur_kind(t, st) == 1 && peek(t, st, 1) == "(" {
                            if w == "printf" || w == "puts" || w == "putchar" { f.prints[idx as usize] = 1; }
                            f.callers.push(idx); f.callees.push(w);
                        }
                        advance(st);
                    }
                }
                continue;
            }
        }
        advance(st);
    }
    // a function prints when anything it calls prints
    let mut changed: bool = true;
    while changed {
        changed = false;
        let mut i: usize = 0;
        while i < f.callers.len() {
            let callee: i32 = find_fn(f, f.callees[i]);
            let caller: usize = f.callers[i] as usize;
            if callee >= 0 && f.prints[callee as usize] == 1 && f.prints[caller] == 0 {
                f.prints[caller] = 1;
                changed = true;
            }
            i = i + 1;
        }
    }
}

// ------------------------------------------------------------------ expressions

fn char_code(lit: String) -> String {
    let b = lit.as_bytes();
    if b[1] != 92 { return (b[1] as i32).to_string(); }
    let e: u8 = b[2];
    if e == 110 { return String::from("10"); }
    if e == 116 { return String::from("9"); }
    if e == 48 { return String::from("0"); }
    if e == 114 { return String::from("13"); }
    (e as i32).to_string()
}

fn binary(l: String, lt: i32, op: String, r: String, rt: i32, st: Vec<i32>) -> String {
    if op == "&&" || op == "||" {
        st[1] = 7;
        return "(" + conv(l, lt, 7) + " " + op + " " + conv(r, rt, 7) + ")";
    }
    let mut a: i32 = lt;
    let mut c: i32 = rt;
    if a == 7 || a == 5 { a = 1; }
    if c == 7 || c == 5 { c = 1; }
    let mut r1: i32 = rank(a);
    if rank(c) > r1 { r1 = rank(c); }
    let ty: i32 = of_rank(r1);
    let body: String = "(" + conv(l, lt, ty) + " " + op + " " + conv(r, rt, ty) + ")";
    if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" { st[1] = 7; } else { st[1] = ty; }
    body
}

fn prec(op: String) -> i32 {
    if op == "||" { return 1; }
    if op == "&&" { return 2; }
    if op == "|" { return 3; }
    if op == "^" { return 4; }
    if op == "&" { return 5; }
    if op == "==" || op == "!=" { return 6; }
    if op == "<" || op == ">" || op == "<=" || op == ">=" { return 7; }
    if op == "<<" || op == ">>" { return 8; }
    if op == "+" || op == "-" { return 9; }
    if op == "*" || op == "/" || op == "%" { return 10; }
    0
}

fn call(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, name: String) -> String ~ Console {
    // the cursor is just past `(`
    let args: Vec<String> = Vec::new();
    let types: Vec<i32> = Vec::new();
    while cur(t, st) != ")" && cur_kind(t, st) != 0 {
        args.push(expr(t, st, sy, f, 0));
        types.push(st[1]);
        if cur(t, st) == "," { advance(st); }
    }
    advance(st);
    let one: bool = args.len() == 1;
    if one && (name == "sqrt" || name == "sin" || name == "cos" || name == "tan" || name == "exp" || name == "floor" || name == "log") {
        st[1] = 3;
        let mut n2: String = name;
        if name == "log" { n2 = String::from("ln"); }
        if name == "floor" || name == "log" { return "(" + conv(args[0], types[0], 3) + ")." + n2 + "()"; }
        return n2 + "(" + conv(args[0], types[0], 3) + ")";
    }
    if one && (name == "fabs" || name == "ceil") {
        st[1] = 3;
        let mut m: String = String::from("abs");
        if name == "ceil" { m = String::from("ceil"); }
        return "(" + conv(args[0], types[0], 3) + ")." + m + "()";
    }
    if one && name == "abs" { st[1] = 1; return "(" + conv(args[0], types[0], 1) + ").abs()"; }
    if args.len() == 2 && name == "pow" {
        st[1] = 3;
        return "pow(" + conv(args[0], types[0], 3) + ", " + conv(args[1], types[1], 3) + ")";
    }
    let idx: i32 = find_fn(f, name);
    if idx < 0 {
        refuse(t, st, "call to `" + name + "`, which this file does not define and the subset does not know");
        st[1] = 1;
        return String::from("0");
    }
    let u: usize = idx as usize;
    let mut out: String = name + "(";
    let mut i: usize = 0;
    while i < args.len() {
        if i > 0 { out = out + ", "; }
        let mut want: i32 = types[i];
        if (i as i32) < f.count[u] { want = f.ptypes[(f.first[u] + (i as i32)) as usize]; }
        out = out + conv(args[i], types[i], want);
        i = i + 1;
    }
    st[1] = f.ret[u];
    out + ")"
}

fn primary(t: Toks, st: Vec<i32>, sy: Syms, f: Fns) -> String ~ Console {
    let k: i32 = cur_kind(t, st);
    let w: String = cur(t, st);
    if k == 2 { advance(st); st[1] = 1; return w; }
    if k == 8 { advance(st); st[1] = 2; return w; }
    if k == 9 { advance(st); st[1] = 6; return w; }
    if k == 10 { advance(st); st[1] = 4; return w; }
    if k == 3 { advance(st); st[1] = 3; return w; }
    if k == 5 { advance(st); st[1] = 1; return char_code(w); }
    if w == "(" {
        advance(st);
        if cur_kind(t, st) == 1 && is_type_word(cur(t, st)) {
            let to: i32 = parse_type(t, st);
            expect(t, st, String::from(")"));
            let inner: String = unary(t, st, sy, f);
            if to <= 0 { refuse(t, st, String::from("a cast to a type outside the subset")); return inner; }
            let from: i32 = st[1];
            st[1] = to;
            return conv(inner, from, to);
        }
        let inner: String = expr(t, st, sy, f, 0);
        expect(t, st, String::from(")"));
        return "(" + inner + ")";
    }
    if k == 1 {
        advance(st);
        if cur(t, st) == "(" { advance(st); return call(t, st, sy, f, w); }
        let ty: i32 = find_var(sy, st, w);
        if ty < 0 { refuse(t, st, "the name `" + w + "` is not a local, a parameter or a constant of this file"); st[1] = 1; return w; }
        if cur(t, st) == "[" {
            advance(st);
            let ix: String = expr(t, st, sy, f, 0);
            let it: i32 = st[1];
            expect(t, st, String::from("]"));
            st[1] = ty - 100;
            return w + "[" + conv(ix, it, 1) + " as usize]";
        }
        st[1] = ty;
        return w;
    }
    refuse(t, st, String::from("an expression form outside the subset"));
    advance(st);
    st[1] = 1;
    String::from("0")
}

fn unary(t: Toks, st: Vec<i32>, sy: Syms, f: Fns) -> String ~ Console {
    let w: String = cur(t, st);
    if cur_kind(t, st) == 6 && w == "-" {
        advance(st);
        let v: String = unary(t, st, sy, f);
        if st[1] == 7 || st[1] == 5 { let from: i32 = st[1]; st[1] = 1; return "(-" + conv(v, from, 1) + ")"; }
        return "(-" + v + ")";
    }
    if cur_kind(t, st) == 6 && w == "+" { advance(st); return unary(t, st, sy, f); }
    if cur_kind(t, st) == 6 && w == "!" {
        advance(st);
        let v: String = unary(t, st, sy, f);
        let from: i32 = st[1];
        st[1] = 7;
        return "(!" + conv(v, from, 7) + ")";
    }
    if cur_kind(t, st) == 6 && w == "~" { advance(st); let v: String = unary(t, st, sy, f); return "(!" + v + ")"; }
    if cur_kind(t, st) == 6 && (w == "&" || w == "*") { refuse(t, st, String::from("pointers are outside the subset")); advance(st); }
    primary(t, st, sy, f)
}

fn expr(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, min: i32) -> String ~ Console {
    let mut left: String = unary(t, st, sy, f);
    let mut lt: i32 = st[1];
    loop {
        let op: String = cur(t, st);
        let p: i32 = prec(op);
        if cur_kind(t, st) != 6 || p == 0 || p < min { break; }
        advance(st);
        let right: String = expr(t, st, sy, f, p + 1);
        let rt: i32 = st[1];
        left = binary(left, lt, op, right, rt, st);
        lt = st[1];
    }
    if min == 0 && cur(t, st) == "?" {
        advance(st);
        let a: String = expr(t, st, sy, f, 0);
        let at: i32 = st[1];
        expect(t, st, String::from(":"));
        let b: String = expr(t, st, sy, f, 0);
        let bt: i32 = st[1];
        let mut r1: i32 = rank(at);
        if rank(bt) > r1 { r1 = rank(bt); }
        let ty: i32 = of_rank(r1);
        left = "(if " + conv(left, lt, 7) + " { " + conv(a, at, ty) + " } else { " + conv(b, bt, ty) + " })";
        lt = ty;
    }
    st[1] = lt;
    left
}

// ------------------------------------------------------------------ printf

fn c_printf(t: Toks, st: Vec<i32>, sy: Syms, f: Fns) -> String ~ Console {
    // the cursor is on the format string
    if cur_kind(t, st) != 4 { refuse(t, st, String::from("printf with a format that is not a string literal")); }
    let lit: String = cur(t, st);
    advance(st);
    let b = lit.as_bytes();
    let n: usize = lit.len() - 1;
    let mut fmt: String = String::new();
    let wants: Vec<i32> = Vec::new();
    let mut i: usize = 1;
    let mut newline: bool = false;
    while i < n {
        let c: u8 = b[i];
        if c == 92 && i + 2 == n && b[i + 1] == 110 { newline = true; i = i + 2; continue; }
        if c == 123 { fmt = fmt + "{{"; i = i + 1; continue; }
        if c == 125 { fmt = fmt + "}}"; i = i + 1; continue; }
        if c != 37 { fmt.push(c as char); i = i + 1; continue; }
        i = i + 1;
        if b[i] == 37 { fmt.push(37 as char); i = i + 1; continue; }
        let mut precision: String = String::new();
        if b[i] == 46 {
            i = i + 1;
            while is_digit(b[i]) { precision.push(b[i] as char); i = i + 1; }
        }
        let mut longs: i32 = 0;
        while b[i] == 108 { longs = longs + 1; i = i + 1; }
        let d: u8 = b[i];
        i = i + 1;
        if d == 100 || d == 105 { fmt = fmt + "{}"; if longs > 0 { wants.push(2); } else { wants.push(1); } continue; }
        if d == 117 { fmt = fmt + "{}"; if longs > 0 { wants.push(2); } else { wants.push(6); } continue; }
        if d == 102 {
            if precision.len() == 0 { precision = String::from("6"); }
            fmt = fmt + "{:." + precision + "}";
            wants.push(3);
            continue;
        }
        if d == 99 { fmt = fmt + "{}"; wants.push(5); continue; }
        if d == 115 { fmt = fmt + "{}"; wants.push(-4); continue; }
        refuse(t, st, String::from("a printf conversion outside the subset (d, i, u, ld, f, .Nf, c, s, %)"));
    }
    let mut out: String = String::from("print!(\"");
    if newline { out = String::from("println!(\""); }
    out = out + fmt + "\"";
    let mut k: usize = 0;
    while cur(t, st) == "," {
        advance(st);
        let mut want: i32 = 1;
        if k < wants.len() { want = wants[k]; }
        if want == -4 {
            if cur_kind(t, st) != 4 { refuse(t, st, String::from("%s with an argument that is not a string literal")); }
            out = out + ", " + cur(t, st);
            advance(st);
        } else {
            let a: String = expr(t, st, sy, f, 0);
            let at: i32 = st[1];
            if want == 5 { out = out + ", (" + conv(a, at, 5) + " as char)"; } else { out = out + ", " + conv(a, at, want); }
        }
        k = k + 1;
    }
    expect(t, st, String::from(")"));
    out + ")"
}

// ------------------------------------------------------------------ statements

fn emit(out: Vec<String>, st: Vec<i32>, s: String) {
    let mut pad: String = String::new();
    let mut i: i32 = 0;
    while i < st[3] { pad = pad + "    "; i = i + 1; }
    out.push(pad + s);
}

// An assignment, an increment or a call, without its semicolon.
fn simple(t: Toks, st: Vec<i32>, sy: Syms, f: Fns) -> String ~ Console {
    let mut w: String = cur(t, st);
    let mut pre: String = String::new();
    if w == "++" || w == "--" { pre = w; advance(st); w = cur(t, st); }
    if cur_kind(t, st) != 1 { refuse(t, st, String::from("a statement form outside the subset")); advance(st); return String::new(); }
    if peek(t, st, 1) == "(" {
        advance(st); advance(st);
        if w == "printf" { return c_printf(t, st, sy, f); }
        let c: String = call(t, st, sy, f, w);
        if st[1] == 0 { return c; }
        return "let _ = " + c;
    }
    advance(st);
    let mut ty: i32 = find_var(sy, st, w);
    if ty < 0 { refuse(t, st, "assignment to `" + w + "`, which is not a local or a parameter"); ty = 1; }
    let mut lv: String = w;
    if cur(t, st) == "[" {
        advance(st);
        let ix: String = expr(t, st, sy, f, 0);
        let it: i32 = st[1];
        expect(t, st, String::from("]"));
        lv = w + "[" + conv(ix, it, 1) + " as usize]";
        ty = ty - 100;
    }
    let mut op: String = cur(t, st);
    if pre.len() > 0 { op = pre; } else { advance(st); }
    if op == "++" { return lv + " = " + lv + " + " + conv(String::from("1"), 1, ty); }
    if op == "--" { return lv + " = " + lv + " - " + conv(String::from("1"), 1, ty); }
    let rhs: String = expr(t, st, sy, f, 0);
    let rt: i32 = st[1];
    if op == "=" { return lv + " = " + conv(rhs, rt, ty); }
    if op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" {
        let bop: String = op.substring(0, 1);
        let both: String = binary(lv, ty, bop, rhs, rt, st);
        return lv + " = " + conv(both, st[1], ty);
    }
    refuse(t, st, "the operator `" + op + "` as a statement");
    String::new()
}

fn declaration(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, out: Vec<String>) ~ Console {
    let ty: i32 = parse_type(t, st);
    if ty <= 0 { refuse(t, st, String::from("a declaration with a type outside the subset")); }
    loop {
        let name: String = cur(t, st);
        advance(st);
        if cur(t, st) == "[" {
            advance(st);
            let size: String = cur(t, st);
            advance(st);
            expect(t, st, String::from("]"));
            let mut init: String = "[" + zero_of(ty) + "; " + size + "]";
            if cur(t, st) == "=" {
                advance(st);
                expect(t, st, String::from("{"));
                init = String::from("[");
                let mut count: i32 = 0;
                while cur(t, st) != "}" && cur_kind(t, st) != 0 {
                    if count > 0 { init = init + ", "; }
                    let e: String = expr(t, st, sy, f, 0);
                    init = init + conv(e, st[1], ty);
                    count = count + 1;
                    if cur(t, st) == "," { advance(st); }
                }
                advance(st);
                if count.to_string() != size { refuse(t, st, String::from("an array initialiser shorter than the array")); }
                init = init + "]";
            }
            emit(out, st, "let mut " + name + ": [" + tname(ty) + "; " + size + "] = " + init + ";");
            add_sym(sy, st, name, 100 + ty);
        } else {
            let mut init: String = zero_of(ty);
            if cur(t, st) == "=" {
                advance(st);
                let e: String = expr(t, st, sy, f, 0);
                init = conv(e, st[1], ty);
            }
            emit(out, st, "let mut " + name + ": " + tname(ty) + " = " + init + ";");
            add_sym(sy, st, name, ty);
        }
        if cur(t, st) == "," { advance(st); continue; }
        break;
    }
    expect(t, st, String::from(";"));
}

// `steps` holds the step of each enclosing loop, so `continue` in a `for` runs it first.
fn body(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, out: Vec<String>, steps: Vec<String>) ~ Console {
    st[3] = st[3] + 1;
    if cur(t, st) == "{" {
        advance(st);
        while cur(t, st) != "}" && cur_kind(t, st) != 0 { statement(t, st, sy, f, out, steps); }
        advance(st);
    } else {
        statement(t, st, sy, f, out, steps);
    }
    st[3] = st[3] - 1;
}

fn statement(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, out: Vec<String>, steps: Vec<String>) ~ Console {
    let w: String = cur(t, st);
    let k: i32 = cur_kind(t, st);
    if w == ";" { advance(st); return; }
    if w == "{" {
        emit(out, st, String::from("{"));
        body(t, st, sy, f, out, steps);
        emit(out, st, String::from("}"));
        return;
    }
    if k == 1 && is_type_word(w) { declaration(t, st, sy, f, out); return; }
    if w == "if" {
        advance(st); expect(t, st, String::from("("));
        let c: String = expr(t, st, sy, f, 0);
        let ct: i32 = st[1];
        expect(t, st, String::from(")"));
        emit(out, st, "if " + conv(c, ct, 7) + " {");
        body(t, st, sy, f, out, steps);
        if cur(t, st) == "else" {
            advance(st);
            emit(out, st, String::from("} else {"));
            body(t, st, sy, f, out, steps);
        }
        emit(out, st, String::from("}"));
        return;
    }
    if w == "while" {
        advance(st); expect(t, st, String::from("("));
        let c: String = expr(t, st, sy, f, 0);
        let ct: i32 = st[1];
        expect(t, st, String::from(")"));
        emit(out, st, "while " + conv(c, ct, 7) + " {");
        push_step(steps, st, String::new());
        body(t, st, sy, f, out, steps);
        st[7] = st[7] - 1;
        emit(out, st, String::from("}"));
        return;
    }
    if w == "do" {
        advance(st);
        emit(out, st, String::from("loop {"));
        push_step(steps, st, String::from("?"));
        body(t, st, sy, f, out, steps);
        st[7] = st[7] - 1;
        expect(t, st, String::from("while")); expect(t, st, String::from("("));
        let c: String = expr(t, st, sy, f, 0);
        let ct: i32 = st[1];
        expect(t, st, String::from(")")); expect(t, st, String::from(";"));
        st[3] = st[3] + 1;
        emit(out, st, "if !" + conv(c, ct, 7) + " { break; }");
        st[3] = st[3] - 1;
        emit(out, st, String::from("}"));
        return;
    }
    if w == "for" {
        advance(st); expect(t, st, String::from("("));
        emit(out, st, String::from("{"));
        st[3] = st[3] + 1;
        if cur(t, st) == ";" { advance(st); }
        else if cur_kind(t, st) == 1 && is_type_word(cur(t, st)) { declaration(t, st, sy, f, out); }
        else { let s: String = simple(t, st, sy, f); emit(out, st, s + ";"); expect(t, st, String::from(";")); }
        let mut c: String = String::from("true");
        if cur(t, st) != ";" { let e: String = expr(t, st, sy, f, 0); c = conv(e, st[1], 7); }
        expect(t, st, String::from(";"));
        let mut step: String = String::new();
        if cur(t, st) != ")" { step = simple(t, st, sy, f); }
        expect(t, st, String::from(")"));
        emit(out, st, "while " + c + " {");
        push_step(steps, st, step);
        body(t, st, sy, f, out, steps);
        st[7] = st[7] - 1;
        if step.len() > 0 { st[3] = st[3] + 1; emit(out, st, step + ";"); st[3] = st[3] - 1; }
        emit(out, st, String::from("}"));
        st[3] = st[3] - 1;
        emit(out, st, String::from("}"));
        return;
    }
    if w == "return" {
        advance(st);
        if cur(t, st) == ";" { advance(st); emit(out, st, String::from("return;")); return; }
        let e: String = expr(t, st, sy, f, 0);
        let et: i32 = st[1];
        expect(t, st, String::from(";"));
        if st[5] == 1 {
            if e == "0" { emit(out, st, String::from("return;")); } else { refuse(t, st, String::from("main returning a status other than 0")); }
            return;
        }
        emit(out, st, "return " + conv(e, et, st[4]) + ";");
        return;
    }
    if w == "break" { advance(st); expect(t, st, String::from(";")); emit(out, st, String::from("break;")); return; }
    if w == "continue" {
        advance(st); expect(t, st, String::from(";"));
        if st[7] > 0 {
            let s: String = steps[(st[7] - 1) as usize];
            if s == "?" { refuse(t, st, String::from("continue inside do-while")); }
            else if s.len() > 0 { emit(out, st, s + ";"); }
        }
        emit(out, st, String::from("continue;"));
        return;
    }
    if w == "switch" || w == "goto" || w == "struct" || w == "typedef" || w == "union" || w == "enum" || w == "sizeof" {
        refuse(t, st, "`" + w + "` is outside the subset");
        skip_construct(t, st);
        return;
    }
    let s: String = simple(t, st, sy, f);
    expect(t, st, String::from(";"));
    if s.len() > 0 { emit(out, st, s + ";"); }
}

// ------------------------------------------------------------------ the file

fn translate(t: Toks, f: Fns, out: Vec<String>) -> i32 ~ Console {
    let st: Vec<i32> = vec![0, 0, 0, 0, 0, 0, 0, 0, 0];
    let sy: Syms = Syms { names: Vec::new(), types: Vec::new() };
    while cur_kind(t, st) != 0 {
        let w: String = cur(t, st);
        if cur_kind(t, st) == 7 {
            if w.starts_with("#include") { advance(st); continue; }
            refuse(t, st, String::from("a preprocessor line other than #include"));
            advance(st);
            continue;
        }
        if !(cur_kind(t, st) == 1 && is_type_word(w)) {
            refuse(t, st, "`" + w + "` at file level is outside the subset");
            skip_construct(t, st);
            continue;
        }
        let ret: i32 = parse_type(t, st);
        let name: String = cur(t, st);
        advance(st);
        if cur(t, st) != "(" {
            // a file-level constant: `const int N = 10;`
            if cur(t, st) == "=" && ret > 0 && cur_kind(t, st) != 0 {
                advance(st);
                let e: String = expr(t, st, sy, f, 0);
                emit(out, st, "const " + name + ": " + tname(ret) + " = " + conv(e, st[1], ret) + ";");
                add_sym(sy, st, name, ret);
                expect(t, st, String::from(";"));
                continue;
            }
            refuse(t, st, String::from("a file-level variable without a constant value"));
            while cur(t, st) != ";" && cur_kind(t, st) != 0 { advance(st); }
            advance(st);
            continue;
        }
        if ret < 0 { refuse(t, st, String::from("a function returning a type outside the subset")); }
        advance(st);
        let base: i32 = st[6];
        let before: i32 = st[2];
        let mut sig: String = String::new();
        let shadow: Vec<String> = Vec::new();
        while cur(t, st) != ")" && cur_kind(t, st) != 0 {
            let pt: i32 = parse_type(t, st);
            if pt == 0 && cur(t, st) == ")" { break; }
            if pt <= 0 { refuse(t, st, String::from("a parameter with a type outside the subset")); }
            let pn: String = cur(t, st);
            advance(st);
            if cur(t, st) == "[" { refuse(t, st, String::from("an array parameter")); }
            if sig.len() > 0 { sig = sig + ", "; }
            sig = sig + pn + ": " + tname(pt);
            shadow.push("let mut " + pn + ": " + tname(pt) + " = " + pn + ";");
            add_sym(sy, st, pn, pt);
            if cur(t, st) == "," { advance(st); }
        }
        advance(st);
        if st[2] > before { skip_construct(t, st); st[6] = base; continue; }
        if cur(t, st) == ";" { advance(st); st[6] = base; continue; }
        let idx: i32 = find_fn(f, name);
        let mut head: String = "fn " + name + "(" + sig + ")";
        if name == "main" { head = String::from("fn main()"); st[5] = 1; } else { st[5] = 0; }
        if ret > 0 && name != "main" { head = head + " -> " + tname(ret); }
        if idx >= 0 && f.prints[idx as usize] == 1 { head = head + " ~ Console"; }
        st[4] = ret;
        emit(out, st, head + " {");
        st[3] = 1;
        let mut i: usize = 0;
        while i < shadow.len() { emit(out, st, shadow[i]); i = i + 1; }
        st[3] = 0;
        let steps: Vec<String> = Vec::new();
        body(t, st, sy, f, out, steps);
        emit(out, st, String::from("}"));
        emit(out, st, String::new());
        // the function's locals go out of scope; file-level constants stay
        st[6] = base;
    }
    st[2]
}

fn main() ~ Console + FileSystem + Environment + Process {
    if args_count() != 4 || args_get(1) != "c" {
        println!("usage: port c input.c output.bld");
        exit(1);
    }
    let src: String = read_file(args_get(2));
    let t: Toks = Toks { kind: Vec::new(), text: Vec::new(), line: Vec::new() };
    lex(src, t.kind, t.text, t.line);
    let f: Fns = Fns { names: Vec::new(), ret: Vec::new(), first: Vec::new(), count: Vec::new(), ptypes: Vec::new(), prints: Vec::new(), callers: Vec::new(), callees: Vec::new() };
    collect(t, f);
    let out: Vec<String> = Vec::new();
    out.push("// Ported from C by `port`. Every conversion C made silently is written as a cast.");
    println!("port: {}", args_get(2));
    let refused: i32 = translate(t, f, out);
    if refused > 0 {
        println!("refused: {} construct(s) outside the subset; nothing written", refused);
        exit(2);
    }
    let mut text: String = String::new();
    let mut i: usize = 0;
    while i < out.len() { text = text + out[i] + "\n"; i = i + 1; }
    write_file(args_get(3), text);
    println!("written: {} ({} lines)", args_get(3), out.len());
}
