//
// port/stmts.bld: Statements and declarations.

use types::*;
use state::*;
use exprs::*;

// ------------------------------------------------------------------ statements

pub fn emit(out: Vec<String>, st: Vec<i32>, s: String) {
    let mut pad: String = String::new();
    let mut i: i32 = 0;
    while i < st[3] { pad = pad + "    "; i = i + 1; }
    out.push(pad + s);
}

// An assignment, an increment or a call, without its semicolon.
pub fn simple(t: Toks, st: Vec<i32>, sy: Syms, f: Fns) -> String ~ Console {
    let mut w: String = cur(t, st);
    let mut pre: String = String::new();
    if w == "++" || w == "--" { pre = w; advance(st); w = cur(t, st); }
    if cur_kind(t, st) != 1 { refuse(t, st, String::from("a statement form outside the subset")); advance(st); return String::new(); }
    if peek(t, st, 1) == "(" {
        advance(st); advance(st);
        if w == "printf" { return c_printf(t, st, sy, f); }
        let c: String = call(t, st, sy, f, w);
        if st[1] == 0 { return c; }
        return "let _ = " + c;
    }
    advance(st);
    let mut ty: i32 = find_var(sy, st, w);
    if ty < 0 { refuse(t, st, "assignment to `" + w + "`, which is not a local or a parameter"); ty = 1; }
    let mut lv: String = w;
    if cur(t, st) == "[" {
        advance(st);
        let ix: String = expr(t, st, sy, f, 0);
        let it: i32 = st[1];
        expect(t, st, String::from("]"));
        lv = w + "[" + conv(ix, it, 1) + " as usize]";
        ty = ty - 100;
    }
    let mut op: String = cur(t, st);
    if pre.len() > 0 { op = pre; } else { advance(st); }
    if op == "++" { return lv + " = " + lv + " + " + conv(String::from("1"), 1, ty); }
    if op == "--" { return lv + " = " + lv + " - " + conv(String::from("1"), 1, ty); }
    let rhs: String = expr(t, st, sy, f, 0);
    let rt: i32 = st[1];
    if op == "=" { return lv + " = " + conv(rhs, rt, ty); }
    if op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" {
        let bop: String = op.substring(0, 1);
        let both: String = binary(lv, ty, bop, rhs, rt, st);
        return lv + " = " + conv(both, st[1], ty);
    }
    refuse(t, st, "the operator `" + op + "` as a statement");
    String::new()
}

pub fn declaration(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, out: Vec<String>) ~ Console {
    let ty: i32 = parse_type(t, st);
    if ty <= 0 { refuse(t, st, String::from("a declaration with a type outside the subset")); }
    loop {
        let name: String = cur(t, st);
        advance(st);
        if cur(t, st) == "[" {
            advance(st);
            let size: String = cur(t, st);
            advance(st);
            expect(t, st, String::from("]"));
            let mut init: String = "[" + zero_of(ty) + "; " + size + "]";
            if cur(t, st) == "=" {
                advance(st);
                expect(t, st, String::from("{"));
                init = String::from("[");
                let mut count: i32 = 0;
                while cur(t, st) != "}" && cur_kind(t, st) != 0 {
                    if count > 0 { init = init + ", "; }
                    let e: String = expr(t, st, sy, f, 0);
                    init = init + conv(e, st[1], ty);
                    count = count + 1;
                    if cur(t, st) == "," { advance(st); }
                }
                advance(st);
                if count.to_string() != size { refuse(t, st, String::from("an array initialiser shorter than the array")); }
                init = init + "]";
            }
            emit(out, st, "let mut " + name + ": [" + tname(ty) + "; " + size + "] = " + init + ";");
            add_sym(sy, st, name, 100 + ty);
        } else {
            let mut init: String = zero_of(ty);
            if cur(t, st) == "=" {
                advance(st);
                let e: String = expr(t, st, sy, f, 0);
                init = conv(e, st[1], ty);
            }
            emit(out, st, "let mut " + name + ": " + tname(ty) + " = " + init + ";");
            add_sym(sy, st, name, ty);
        }
        if cur(t, st) == "," { advance(st); continue; }
        break;
    }
    expect(t, st, String::from(";"));
}

// `steps` holds the step of each enclosing loop, so `continue` in a `for` runs it first.
pub fn body(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, out: Vec<String>, steps: Vec<String>) ~ Console {
    st[3] = st[3] + 1;
    if cur(t, st) == "{" {
        advance(st);
        while cur(t, st) != "}" && cur_kind(t, st) != 0 { statement(t, st, sy, f, out, steps); }
        advance(st);
    } else {
        statement(t, st, sy, f, out, steps);
    }
    st[3] = st[3] - 1;
}

pub fn statement(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, out: Vec<String>, steps: Vec<String>) ~ Console {
    let w: String = cur(t, st);
    let k: i32 = cur_kind(t, st);
    if w == ";" { advance(st); return; }
    if w == "{" {
        emit(out, st, String::from("{"));
        body(t, st, sy, f, out, steps);
        emit(out, st, String::from("}"));
        return;
    }
    if k == 1 && is_type_word(w) { declaration(t, st, sy, f, out); return; }
    if w == "if" {
        advance(st); expect(t, st, String::from("("));
        let c: String = expr(t, st, sy, f, 0);
        let ct: i32 = st[1];
        expect(t, st, String::from(")"));
        emit(out, st, "if " + conv(c, ct, 7) + " {");
        body(t, st, sy, f, out, steps);
        if cur(t, st) == "else" {
            advance(st);
            emit(out, st, String::from("} else {"));
            body(t, st, sy, f, out, steps);
        }
        emit(out, st, String::from("}"));
        return;
    }
    if w == "while" {
        advance(st); expect(t, st, String::from("("));
        let c: String = expr(t, st, sy, f, 0);
        let ct: i32 = st[1];
        expect(t, st, String::from(")"));
        emit(out, st, "while " + conv(c, ct, 7) + " {");
        push_step(steps, st, String::new());
        body(t, st, sy, f, out, steps);
        st[7] = st[7] - 1;
        emit(out, st, String::from("}"));
        return;
    }
    if w == "do" {
        advance(st);
        emit(out, st, String::from("loop {"));
        push_step(steps, st, String::from("?"));
        body(t, st, sy, f, out, steps);
        st[7] = st[7] - 1;
        expect(t, st, String::from("while")); expect(t, st, String::from("("));
        let c: String = expr(t, st, sy, f, 0);
        let ct: i32 = st[1];
        expect(t, st, String::from(")")); expect(t, st, String::from(";"));
        st[3] = st[3] + 1;
        emit(out, st, "if !" + conv(c, ct, 7) + " { break; }");
        st[3] = st[3] - 1;
        emit(out, st, String::from("}"));
        return;
    }
    if w == "for" {
        advance(st); expect(t, st, String::from("("));
        emit(out, st, String::from("{"));
        st[3] = st[3] + 1;
        if cur(t, st) == ";" { advance(st); }
        else if cur_kind(t, st) == 1 && is_type_word(cur(t, st)) { declaration(t, st, sy, f, out); }
        else { let s: String = simple(t, st, sy, f); emit(out, st, s + ";"); expect(t, st, String::from(";")); }
        let mut c: String = String::from("true");
        if cur(t, st) != ";" { let e: String = expr(t, st, sy, f, 0); c = conv(e, st[1], 7); }
        expect(t, st, String::from(";"));
        let mut step: String = String::new();
        if cur(t, st) != ")" { step = simple(t, st, sy, f); }
        expect(t, st, String::from(")"));
        emit(out, st, "while " + c + " {");
        push_step(steps, st, step);
        body(t, st, sy, f, out, steps);
        st[7] = st[7] - 1;
        if step.len() > 0 { st[3] = st[3] + 1; emit(out, st, step + ";"); st[3] = st[3] - 1; }
        emit(out, st, String::from("}"));
        st[3] = st[3] - 1;
        emit(out, st, String::from("}"));
        return;
    }
    if w == "return" {
        advance(st);
        if cur(t, st) == ";" { advance(st); emit(out, st, String::from("return;")); return; }
        let e: String = expr(t, st, sy, f, 0);
        let et: i32 = st[1];
        expect(t, st, String::from(";"));
        if st[5] == 1 {
            if e == "0" { emit(out, st, String::from("return;")); } else { refuse(t, st, String::from("main returning a status other than 0")); }
            return;
        }
        emit(out, st, "return " + conv(e, et, st[4]) + ";");
        return;
    }
    if w == "break" { advance(st); expect(t, st, String::from(";")); emit(out, st, String::from("break;")); return; }
    if w == "continue" {
        advance(st); expect(t, st, String::from(";"));
        if st[7] > 0 {
            let s: String = steps[(st[7] - 1) as usize];
            if s == "?" { refuse(t, st, String::from("continue inside do-while")); }
            else if s.len() > 0 { emit(out, st, s + ";"); }
        }
        emit(out, st, String::from("continue;"));
        return;
    }
    if w == "switch" || w == "goto" || w == "struct" || w == "typedef" || w == "union" || w == "enum" || w == "sizeof" {
        refuse(t, st, "`" + w + "` is outside the subset");
        skip_construct(t, st);
        return;
    }
    let s: String = simple(t, st, sy, f);
    expect(t, st, String::from(";"));
    if s.len() > 0 { emit(out, st, s + ";"); }
}
