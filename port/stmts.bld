//
// port/stmts.bld: Statements: blocks, branches, loops and switch.

use types::*;
use state::*;
use exprs::*;
use decls::*;

// ------------------------------------------------------------------ statements

// `steps` holds the step of each enclosing loop, so `continue` in a `for` runs it first.
pub fn body(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, out: Vec<String>, steps: Vec<String>) ~ Console {
    st[3] = st[3] + 1;
    if cur(t, st) == "{" {
        advance(st);
        while cur(t, st) != "}" && cur_kind(t, st) != 0 { statement(t, st, sy, f, out, steps); }
        advance(st);
    } else {
        statement(t, st, sy, f, out, steps);
    }
    st[3] = st[3] - 1;
}

// True when the `{ ... }` block at the cursor ends in a `break` or `return` statement.
fn block_ends(t: Toks, st: Vec<i32>) -> bool {
    let mut m: usize = st[0] as usize + 1;
    let mut depth: i32 = 1;
    while m < t.text.len() && depth > 0 {
        if t.text[m] == "{" { depth = depth + 1; }
        if t.text[m] == "}" { depth = depth - 1; }
        if depth > 0 { m = m + 1; }
    }
    if m < 3 || m >= t.text.len() || t.text[m - 1] != ";" { return false; }
    let mut j: usize = m - 2;
    while j > 0 && t.text[j] != ";" && t.text[j] != "{" && t.text[j] != "}" { j = j - 1; }
    t.text[j + 1] == "break" || t.text[j + 1] == "return"
}

// `switch` becomes a `loop` that runs once, so `break` keeps its meaning, with one `if` for
// each group of labels. Every group has to end in `break` or `return`: a case that falls through
// into the next is refused, and so is `continue` inside a switch (it would restart the `loop`).
pub fn c_switch(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, out: Vec<String>, steps: Vec<String>) ~ Console {
    advance(st); expect(t, st, String::from("("));
    let e: String = expr(t, st, sy, f, 0);
    let et: i32 = st[1];
    expect(t, st, String::from(")"));
    if !(et == 1 || et == 2 || et == 5 || et == 6) { refuse(t, st, String::from("a switch on a value that is not an integer")); }
    expect(t, st, String::from("{"));
    st[9] = st[9] + 1;
    let v: String = "sw_" + st[9].to_string();
    emit(out, st, String::from("{"));
    st[3] = st[3] + 1;
    emit(out, st, "let " + v + ": " + tname(et) + " = " + e + ";");
    emit(out, st, String::from("loop {"));
    push_step(steps, st, String::from("!"));
    st[3] = st[3] + 1;
    let mut seen_default: bool = false;
    while cur(t, st) != "}" && cur_kind(t, st) != 0 {
        if !(cur(t, st) == "case" || cur(t, st) == "default") {
            refuse(t, st, String::from("a statement in a switch before its first case"));
            skip_construct(t, st);
            continue;
        }
        let mut cond: String = String::new();
        let mut is_default: bool = false;
        while cur(t, st) == "case" || cur(t, st) == "default" {
            if seen_default { refuse(t, st, String::from("a case after default")); }
            if cur(t, st) == "default" {
                advance(st);
                is_default = true;
            } else {
                advance(st);
                let c: String = expr(t, st, sy, f, 0);
                if cond.len() > 0 { cond = cond + " || "; }
                cond = cond + v + " == " + conv(c, st[1], et);
            }
            expect(t, st, String::from(":"));
        }
        if is_default { seen_default = true; emit(out, st, String::from("{")); } else { emit(out, st, "if " + cond + " {"); }
        st[3] = st[3] + 1;
        let mut ends: bool = false;
        while cur(t, st) != "case" && cur(t, st) != "default" && cur(t, st) != "}" && cur_kind(t, st) != 0 {
            ends = cur(t, st) == "break" || cur(t, st) == "return" || (cur(t, st) == "{" && block_ends(t, st));
            statement(t, st, sy, f, out, steps);
        }
        st[3] = st[3] - 1;
        emit(out, st, String::from("}"));
        if !ends && cur(t, st) != "}" { refuse(t, st, String::from("a case that falls through into the next")); }
    }
    advance(st);
    emit(out, st, String::from("break;"));
    st[3] = st[3] - 1;
    st[7] = st[7] - 1;
    emit(out, st, String::from("}"));
    st[3] = st[3] - 1;
    emit(out, st, String::from("}"));
}

pub fn statement(t: Toks, st: Vec<i32>, sy: Syms, f: Fns, out: Vec<String>, steps: Vec<String>) ~ Console {
    let w: String = cur(t, st);
    let k: i32 = cur_kind(t, st);
    if w == ";" { advance(st); return; }
    if w == "{" {
        emit(out, st, String::from("{"));
        body(t, st, sy, f, out, steps);
        emit(out, st, String::from("}"));
        return;
    }
    if k == 1 && is_type_word(w) { declaration(t, st, sy, f, out); return; }
    if w == "if" {
        advance(st); expect(t, st, String::from("("));
        let c: String = expr(t, st, sy, f, 0);
        let ct: i32 = st[1];
        expect(t, st, String::from(")"));
        emit(out, st, "if " + conv(c, ct, 7) + " {");
        body(t, st, sy, f, out, steps);
        if cur(t, st) == "else" {
            advance(st);
            emit(out, st, String::from("} else {"));
            body(t, st, sy, f, out, steps);
        }
        emit(out, st, String::from("}"));
        return;
    }
    if w == "while" {
        advance(st); expect(t, st, String::from("("));
        let c: String = expr(t, st, sy, f, 0);
        let ct: i32 = st[1];
        expect(t, st, String::from(")"));
        emit(out, st, "while " + conv(c, ct, 7) + " {");
        push_step(steps, st, String::new());
        body(t, st, sy, f, out, steps);
        st[7] = st[7] - 1;
        emit(out, st, String::from("}"));
        return;
    }
    if w == "do" {
        advance(st);
        emit(out, st, String::from("loop {"));
        push_step(steps, st, String::from("?"));
        body(t, st, sy, f, out, steps);
        st[7] = st[7] - 1;
        expect(t, st, String::from("while")); expect(t, st, String::from("("));
        let c: String = expr(t, st, sy, f, 0);
        let ct: i32 = st[1];
        expect(t, st, String::from(")")); expect(t, st, String::from(";"));
        st[3] = st[3] + 1;
        emit(out, st, "if !" + conv(c, ct, 7) + " { break; }");
        st[3] = st[3] - 1;
        emit(out, st, String::from("}"));
        return;
    }
    if w == "for" {
        advance(st); expect(t, st, String::from("("));
        emit(out, st, String::from("{"));
        st[3] = st[3] + 1;
        if cur(t, st) == ";" { advance(st); }
        else if cur_kind(t, st) == 1 && is_type_word(cur(t, st)) { declaration(t, st, sy, f, out); }
        else { let s: String = simple(t, st, sy, f); emit(out, st, s + ";"); expect(t, st, String::from(";")); }
        let mut c: String = String::from("true");
        if cur(t, st) != ";" { let e: String = expr(t, st, sy, f, 0); c = conv(e, st[1], 7); }
        expect(t, st, String::from(";"));
        let mut step: String = String::new();
        if cur(t, st) != ")" { step = simple(t, st, sy, f); }
        expect(t, st, String::from(")"));
        emit(out, st, "while " + c + " {");
        push_step(steps, st, step);
        body(t, st, sy, f, out, steps);
        st[7] = st[7] - 1;
        if step.len() > 0 { st[3] = st[3] + 1; emit(out, st, step + ";"); st[3] = st[3] - 1; }
        emit(out, st, String::from("}"));
        st[3] = st[3] - 1;
        emit(out, st, String::from("}"));
        return;
    }
    if w == "return" {
        advance(st);
        if cur(t, st) == ";" { advance(st); emit(out, st, String::from("return;")); return; }
        let e: String = expr(t, st, sy, f, 0);
        let et: i32 = st[1];
        expect(t, st, String::from(";"));
        if st[5] == 1 {
            if e == "0" { emit(out, st, String::from("return;")); } else { refuse(t, st, String::from("main returning a status other than 0")); }
            return;
        }
        emit(out, st, "return " + conv(e, et, st[4]) + ";");
        return;
    }
    if w == "break" { advance(st); expect(t, st, String::from(";")); emit(out, st, String::from("break;")); return; }
    if w == "continue" {
        if st[7] > 0 && steps[(st[7] - 1) as usize] == "!" { refuse(t, st, String::from("continue inside switch")); }
        advance(st); expect(t, st, String::from(";"));
        if st[7] > 0 {
            let s: String = steps[(st[7] - 1) as usize];
            if s == "?" { refuse(t, st, String::from("continue inside do-while")); }
            else if s == "!" { }
            else if s.len() > 0 { emit(out, st, s + ";"); }
        }
        emit(out, st, String::from("continue;"));
        return;
    }
    if w == "switch" { c_switch(t, st, sy, f, out, steps); return; }
    if w == "goto" || w == "struct" || w == "typedef" || w == "union" || w == "enum" || w == "sizeof" {
        refuse(t, st, "`" + w + "` is outside the subset");
        skip_construct(t, st);
        return;
    }
    let s: String = simple(t, st, sy, f);
    expect(t, st, String::from(";"));
    if s.len() > 0 { emit(out, st, s + ";"); }
}
