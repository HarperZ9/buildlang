# Build Engine local environment template.
# Copy to .env only for local use. Never commit .env.

# Live mode requires this exact acknowledgement plus broker credentials.
BUILD_ENGINE_LIVE_ACK=I_UNDERSTAND_LIVE_RISK

# Placeholders only. Use paper credentials for testing where possible.
APCA_API_KEY_ID=<your-alpaca-key-id>
APCA_API_SECRET_KEY=<your-alpaca-secret-key>
