// Wave 146B (Slice 34: F1/AC1/N11/N49/N53): Pure-BuildLang Zero-C Curve25519
// Pedersen Commitment, Fiat-Shamir Schnorr Zero-Knowledge Conservation Proof &
// RFC 6962 Merkle Membership Verifier (buildos_zk_pedersen_merkle_zeroc.bld).
// Compiled directly by untouched Stage-2 buildc_crypto_stage2.exe (ZERO C compiler,
// ZERO Rust, ZERO external linker) across ALL FIVE zero-C ISAs.
//
// Modes:
//   0 = Clean Pedersen opening + homomorphic balance + Schnorr ZK + RFC 6962 (status=1)
//   1 = Planted attack (a): 1-bit forged Schnorr response scalar s -> status=-101
//   2 = Planted attack (b): Value-inflation breach (v_out2=376) -> status=-201
//   3 = Planted attack (c): Mismatched commitment opening blinding r_in -> status=-301
//   4 = Planted attack (d): 1-bit forged RFC 6962 Merkle sibling hash -> status=-401

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn r64_hi(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((hi >> n) | (lo << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((lo >> m) | (hi << (32 - m))) & 4294967295;
}

fn r64_lo(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((lo >> n) | (hi << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((hi >> m) | (lo << (32 - m))) & 4294967295;
}

fn bswap32(x: i64) -> i64 {
    return ((x & 255) << 24) | (((x >> 8) & 255) << 16) | (((x >> 16) & 255) << 8) | ((x >> 24) & 255);
}

