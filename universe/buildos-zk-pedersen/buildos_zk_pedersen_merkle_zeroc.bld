// =============================================================================
// STAGE 1: RFC 6962 Merkle Membership Inclusion Proof for Commitment C_in (Leaf 1)
// Stack arrays: w[64]+hv[8]+pair[16] = 704 B + scalars < 1,000 B < 2,048 B RV64!
// =============================================================================
fn zk_stage1_merkle_inclusion(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut pair: [i64; 16] = [0; 16];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut step: i64 = 0; let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;

    // Step A: L1 = SHA256(0x00 || C_in)
    i = 0; while i < 8 { hv[i] = zk_cin_be(i); i = i + 1; }
    i = 0; while i < 16 { w[i] = 0; i = i + 1; }
    w[0] = hv[0] >> 8;
    i = 1; while i < 8 { w[i] = (((hv[i - 1] & 255) << 24) | (hv[i] >> 8)) & m32; i = i + 1; }
    w[8] = (((hv[7] & 255) << 24) | 8388608) & m32; w[15] = 264;
    i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
    i = 16;
    while i < 64 {
        s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
        s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
    }
    a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
    i = 0;
    while i < 64 {
        s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
        t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
        s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
        t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
        h = g; g = f; f = e; e = (d + t1) & m32;
        d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
    }
    hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
    hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;

    // Step B: step=0 -> N01 = H(0x01 || sib_L0 || L1); step=1 -> ROOT = H(0x01 || N01 || sib_N23)
    step = 0;
    while step < 2 {
        if step == 0 {
            i = 0; while i < 8 { pair[i] = zk_sib_l0_be(i); pair[8 + i] = hv[i]; i = i + 1; }
            // Planted attack (d): 1-bit forged Merkle inclusion sibling hash sib_L0[0]
            if mode == 4 { pair[0] = pair[0] ^ 1; }
        } else {
            i = 0; while i < 8 { pair[i] = hv[i]; pair[8 + i] = zk_sib_n23_be(i); i = i + 1; }
        }
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p1 = 0;
        while p1 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p1 == 0 {
                w[0] = (16777216 | (pair[0] >> 8)) & m32;
                i = 1; while i < 8 { w[i] = (((pair[i - 1] & 255) << 24) | (pair[i] >> 8)) & m32; i = i + 1; }
                w[8] = (((pair[7] & 255) << 24) | (pair[8] >> 8)) & m32;
                i = 1;
                while i < 8 {
                    w[8 + i] = (((pair[8 + i - 1] & 255) << 24) | (pair[8 + i] >> 8)) & m32; i = i + 1;
                }
            } else { w[0] = (((pair[15] & 255) << 24) | 8388608) & m32; w[15] = 520; }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p1 = p1 + 1;
        }
        step = step + 1;
    }

    j = 1; i = 0; while i < 8 { if hv[i] != zk_mroot_be(i) { j = 0; } i = i + 1; }
    if j == 0 { println("{}", -401); println("{}", 0); return -401; }
    return 1;
}

fn zk_pedersen_run(mode: i64) -> i64 ~ Console {
    // 1. RFC 6962 Merkle membership inclusion proof of C_in (Attack d: mode==4 -> -401)
    let rm: i64 = zk_stage1_merkle_inclusion(mode);
    if rm != 1 { return rm; }

    // 2. Pedersen commitment opening: r_in * H == C_in + (L - v_in) * G (Attack c: mode==3 -> -301)
    let mut t_open: i64 = 0;
    if mode == 3 { t_open = 1; }
    let w_open: i64 = zk_ed25519_eq(0, 0, t_open, -301);
    if w_open < 0 { return w_open; }

    // 3. Homomorphic output sum & excess conservation: C_out1 + C_out2 == C_out_sum, C_in == C_out_sum + D
    let w_sum: i64 = zk_ed25519_eq(1, 0, 0, -202);
    if w_sum < 0 { return w_sum; }
    let w_cin: i64 = zk_ed25519_eq(2, 0, 0, -203);
    if w_cin < 0 { return w_cin; }

    // 4. Fiat-Shamir non-interactive Schnorr ZK proof: s * H == R + SHA512(R || D || merkle_root) * D
    //    Attack (a) mode==1: forged response scalar s -> -101
    //    Attack (b) mode==2: value-inflation balance breach (Slot 4: D_infl = -G + delta_r*H) -> -201
    let mut zk_slot: i64 = 3;
    let mut t_zk: i64 = 0;
    let mut zk_err: i64 = -101;
    if mode == 1 { t_zk = 1; zk_err = -101; }
    else if mode == 2 { zk_slot = 4; zk_err = -201; }
    let w_zk: i64 = zk_ed25519_eq(zk_slot, 1, t_zk, zk_err);
    if w_zk < 0 { return w_zk; }

    // Clean commit: status=1, verified=1, h_ctr, v_in=1000, v_out1=625, v_out2=375, 4 witnesses, D, root
    println("{}", 1);
    println("{}", 1);
    println("{}", 0);
    println("{}", 1000);
    println("{}", 625);
    println("{}", 375);
    println("{}", w_open);
    println("{}", w_sum);
    println("{}", w_cin);
    println("{}", w_zk);
    let mut i: i64 = 0;
    while i < 8 { println("{}", zk_d_be(i)); i = i + 1; }
    i = 0;
    while i < 8 { println("{}", zk_mroot_be(i)); i = i + 1; }
    return 1;
}

fn main() ~ Console {
    let _ = zk_pedersen_run(0);
}
