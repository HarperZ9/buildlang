}

fn parse_match_stmt(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>) -> i64 {
    adv(tk, st);
    let mid: i64 = st[8];
    st[8] = mid + 1;
    emit_chunk(out, 29590585746661408);
    emit_chunk(out, 9135151501440110);
    emit_chunk(out, 7167839);
    emit_int_dec(out, mid);
    emit_chunk(out, 2112800);
    let _ = parse_expr(src, tk, out, st, sym);
    emit_chunk(out, 2619);
    let _ = expect(tk, st, 22, 430);
    let mut first: i64 = 1;
    while cur_k(tk, st) != 23 && cur_k(tk, st) != 0 && st[1] == 0 {
        let mut is_wild: i64 = 0;
        if cur_k(tk, st) == 1 && cur_l(tk, st) == 1 && (src[cur_s(tk, st) as usize] as i64) == 95 {
            is_wild = 1;
            adv(tk, st);
        }
        if is_wild != 0 {
            if first == 0 {
                emit_chunk(out, 28464694429753376);
                emit_chunk(out, 11523940774764);
            } else {
                emit_chunk(out, 11523936231456);
            }
        } else {
            if first == 0 {
                emit_chunk(out, 28464694429753376);
                emit_chunk(out, 9119800955859820);
                emit_chunk(out, 1834966824);
            } else {
                emit_chunk(out, 9119800951316512);
                emit_chunk(out, 1834966824);
            }
            emit_int_dec(out, mid);
            emit_chunk(out, 540884256);
            let _ = parse_primary(src, tk, out, st, sym);
            emit_chunk(out, 175841321);
        }
        first = 0;
        let _ = expect(tk, st, 57, 431);
        parse_block(src, tk, out, st, sym);
        if cur_k(tk, st) == 24 { adv(tk, st); }
    }
    if first == 0 {
        emit_chunk(out, 11532526166048);
    }
    let _ = expect(tk, st, 23, 432);
    emit_chunk(out, 11532526166048);
    return 0;
}

