fn run_gemv_block(rounds: i64) -> i64 {
    let mut x: [i64; 16] = [0; 16];
    let mut y: [i64; 16] = [0; 16];
    let mut i: i64 = 0;
    while i < 16 {
        x[i] = ((i * 7 + 3) % 19) - 9;
        i = i + 1;
    }
    let mut r: i64 = 0;
    let mut checksum: i64 = 0;
    while r < rounds {
        let mut row: i64 = 0;
        while row < 16 {
            let mut acc: i64 = 0;
            let mut col: i64 = 0;
            while col < 16 {
                let w: i64 = ((row * 13 + col * 7 + r * 3 + 5) % 31) - 15;
                acc = acc + w * x[col];
                col = col + 1;
            }
            let mut q: i64 = acc / 16;
            if q < 0 { q = 0; }
            if q > 127 { q = 127; }
            y[row] = q;
            checksum = (checksum * 131 + q) % 1000000007;
            row = row + 1;
        }
        let mut k: i64 = 0;
        while k < 16 {
            x[k] = ((x[k] + y[k] + k) % 31) - 15;
            k = k + 1;
        }
        r = r + 1;
    }
    return checksum;
}

fn main() ~ Console {
    let c1: i64 = run_gemv_block(256);
    println("{}", c1);
}
