// Wave 55D (P1 AC3): Table-Driven Cross-OS BuildLang Compiler (buildc_selfhost_cross.bld).
// Adds a direct zero-C binary WebAssembly (.wasm v1) encoder (LEB128, Type/Function/Memory/
// Export/Code sections, i64 arithmetic, if/else, while/block/loop, function calls, recursion,
// linear-memory println capture) while preserving exact Stage-2 == Stage-3 C fixed-point
// self-compilation!

fn is_alpha(b: i64) -> i64 {
    if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 { return 1; }
    return 0;
}

fn is_digit(b: i64) -> i64 {
    if b >= 48 && b <= 57 { return 1; }
    return 0;
}

fn is_alnum(b: i64) -> i64 {
    if is_alpha(b) != 0 || is_digit(b) != 0 { return 1; }
    return 0;
}

fn emit_chunk(out: &mut Vec<u8>, val: i64) -> i64 {
    let mut x: i64 = val;
    while x > 0 {
        let ch: i64 = x % 256;
        out.push(ch as u8);
        x = x / 256;
    }
    return 0;
}

fn emit_slice(out: &mut Vec<u8>, src: &Vec<u8>, start: i64, len: i64) -> i64 {
    let mut i: i64 = 0;
    while i < len {
        let b: i64 = src[(start + i) as usize] as i64;
        out.push(b as u8);
        i = i + 1;
    }
    return 0;
}

fn emit_int_dec(out: &mut Vec<u8>, n: i64) -> i64 {
    if n == 0 {
        out.push(48 as u8);
        return 0;
    }
    let mut digs: Vec<i64> = Vec::new();
    let mut x: i64 = n;
    while x > 0 {
        digs.push(x % 10);
        x = x / 10;
    }
    let mut i: i64 = (digs.len() as i64) - 1;
    while i >= 0 {
        out.push((48 + digs[i as usize]) as u8);
        i = i - 1;
    }
    return 0;
}

fn parse_int_val(src: &Vec<u8>, start: i64, len: i64) -> i64 {
    let mut val: i64 = 0;
    let mut i: i64 = 0;
    while i < len {
        let d: i64 = (src[(start + i) as usize] as i64) - 48;
        val = val * 10 + d;
        i = i + 1;
    }
    return val;
}

fn bytes_eq(src: &Vec<u8>, s1: i64, l1: i64, s2: i64, l2: i64) -> i64 {
    if l1 != l2 { return 0; }
    let mut i: i64 = 0;
    while i < l1 {
        if (src[(s1 + i) as usize] as i64) != (src[(s2 + i) as usize] as i64) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn kw_fn(src: &Vec<u8>, start: i64, len: i64) -> i64 {
    if len != 2 { return 0; }
    if (src[(start + 0) as usize] as i64) != 102 { return 0; }
    if (src[(start + 1) as usize] as i64) != 110 { return 0; }
    return 1;
}

