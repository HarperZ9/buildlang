fn emit_call_name(src: &Vec<u8>, out: &mut Vec<u8>, start: i64, len: i64) -> i64 {
    if bi_args_count(src, start, len) != 0 {
        emit_chunk(out, 32483363279301730);
        emit_chunk(out, 128017765458783);
        return 1;
    }
    if bi_args_get(src, start, len) != 0 {
        emit_chunk(out, 32483363279301730);
        emit_chunk(out, 1952802655);
        return 4;
    }
    if bi_read_file_bytes(src, start, len) != 0 {
        emit_chunk(out, 28254586009513058);
        emit_chunk(out, 27689436932826719);
        emit_chunk(out, 1936028793);
        return 3;
    }
    if bi_write_file_bytes(src, start, len) != 0 {
        emit_chunk(out, 32767037648366690);
        emit_chunk(out, 26851639086702437);
        emit_chunk(out, 495623371106);
        return 2;
    }
    if bi_exit(src, start, len) != 0 {
        emit_chunk(out, 32767063116180578);
        return 0;
    }
    emit_chunk(out, 6253666);
    emit_slice(out, src, start, len);
    return -1;
}

fn builtin_arity(src: &Vec<u8>, start: i64, len: i64) -> i64 {
    if bi_args_count(src, start, len) != 0 { return 0; }
    if bi_args_get(src, start, len) != 0 { return 1; }
    if bi_read_file_bytes(src, start, len) != 0 { return 1; }
    if bi_write_file_bytes(src, start, len) != 0 { return 2; }
    if bi_exit(src, start, len) != 0 { return 1; }
    return -1;
}

fn parse_primary(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    if st[1] != 0 { return 0; }
    let k: i64 = cur_k(tk, st);
    if k == 2 {
        let s: i64 = cur_s(tk, st);
        let l: i64 = cur_l(tk, st);
        adv(tk, st);
        emit_chunk(out, 14696572485445672);
        emit_chunk(out, 2716767);
        emit_slice(out, src, s, l);
        emit_chunk(out, 2706508);
        return 1;
    }
    if k == 3 {
        let s: i64 = cur_s(tk, st);
        let l: i64 = cur_l(tk, st);
        adv(tk, st);
        out.push(34 as u8);
        emit_slice(out, src, s, l);
        out.push(34 as u8);
        return 4;
    }
    if k == 17 {
        adv(tk, st);
        emit_chunk(out, 14696572485445672);
        emit_chunk(out, 11624364171162719);
        return 2;
    }
    if k == 18 {
        adv(tk, st);
        emit_chunk(out, 14696572485445672);
        emit_chunk(out, 11624364154385503);
        return 2;
    }
    if k == 20 {
        adv(tk, st);
        out.push(40 as u8);
        let ty: i64 = parse_expr(src, tk, out, st, sym);
        let _ = expect(tk, st, 21, 301);
        out.push(41 as u8);
        return ty;
    }
    if k == 48 {
        adv(tk, st);
        if cur_k(tk, st) == 12 { adv(tk, st); }
        return parse_postfix(src, tk, out, st, sym);
    }
    if k == 1 {
        let ln: i64 = cur_ln(tk, st);
        let s: i64 = cur_s(tk, st);
        let l: i64 = cur_l(tk, st);
        adv(tk, st);
        if kw_vec(src, s, l) != 0 && cur_k(tk, st) == 47 {
            adv(tk, st);
            let mi: i64 = expect(tk, st, 1, 302);
            if m_new(src, tk_start(tk, mi), tk_len(tk, mi)) == 0 { set_err(st, tk_line(tk, mi), 303); }
            let _ = expect(tk, st, 20, 304);
            let _ = expect(tk, st, 21, 305);
            emit_chunk(out, 11390276595578466);
            emit_chunk(out, 41);
            return 3;
        }
        let eid: i64 = find_enum(src, sym, s, l);
        if eid >= 0 && cur_k(tk, st) == 47 {
            adv(tk, st);
            let vi: i64 = expect(tk, st, 1, 319);
            let vs: i64 = tk_start(tk, vi);
            let vl: i64 = tk_len(tk, vi);
            let vv: i64 = find_enum_variant(src, sym, eid, vs, vl);
            if vv < 0 {
                set_err(st, tk_line(tk, vi), 605);
                return 0;
            }
            emit_chunk(out, 6254181);
            emit_slice(out, src, s, l);
            out.push(95 as u8);
            emit_slice(out, src, vs, vl);
            return 200 + eid;
        }
        let sid: i64 = find_struct(src, sym, s, l);
        if sid >= 0 && cur_k(tk, st) == 22 {
            adv(tk, st);
            emit_chunk(out, 409975597096);
            emit_slice(out, src, s, l);
            emit_chunk(out, 2128681);
            let mut first: i64 = 1;
            while cur_k(tk, st) != 23 && cur_k(tk, st) != 0 && st[1] == 0 {
                if first == 0 {
                    emit_chunk(out, 8236);
                }
                first = 0;
                let fi: i64 = expect(tk, st, 1, 320);
                let fs: i64 = tk_start(tk, fi);
                let fl: i64 = tk_len(tk, fi);
                let exp_fty: i64 = find_struct_field_ty(src, sym, sid, fs, fl);
                if exp_fty < 0 {
                    set_err(st, tk_line(tk, fi), 604);
                    return 0;
                }
                let _ = expect(tk, st, 26, 321);
                emit_chunk(out, 6252078);
                emit_slice(out, src, fs, fl);
                emit_chunk(out, 673201440);
                let got_fty: i64 = parse_expr(src, tk, out, st, sym);
                out.push(41 as u8);
                if got_fty != 0 && exp_fty != 0 && got_fty != exp_fty {
                    set_err(st, tk_line(tk, fi), 601);
                    return 0;
                }
                if cur_k(tk, st) == 24 { adv(tk, st); }
            }
            let _ = expect(tk, st, 23, 322);
            emit_chunk(out, 2719008);
            return 100 + sid;
        }
        if cur_k(tk, st) == 20 {
            adv(tk, st);
            let bi_ret: i64 = emit_call_name(src, out, s, l);
            let bi_ar: i64 = builtin_arity(src, s, l);
            let fidx: i64 = find_fn_idx(src, sym, s, l);
            out.push(40 as u8);
            let mut argc: i64 = 0;
            while cur_k(tk, st) != 21 && cur_k(tk, st) != 0 && st[1] == 0 {
                if argc > 0 {
                    let _ = expect(tk, st, 24, 306);
                    emit_chunk(out, 8236);
                }
                let _ = parse_expr(src, tk, out, st, sym);
                argc = argc + 1;
            }
            let _ = expect(tk, st, 21, 307);
            out.push(41 as u8);
            if bi_ar >= 0 {
                if argc != bi_ar { set_err(st, ln, 603); }
                return bi_ret;
            }
            if fidx >= 0 {
                let exp_ar: i64 = sym[(fidx * 6 + 4) as usize];
                if argc != exp_ar { set_err(st, ln, 603); }
                return sym[(fidx * 6 + 5) as usize];
            }
            set_err(st, ln, 607);
            return 0;
        }
        emit_chunk(out, 24438);
        emit_slice(out, src, s, l);
        return find_local_ty(src, sym, st[6], s, l);
    }
    set_err(st, cur_ln(tk, st), 308);
    return 0;
}

fn parse_postfix(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut buf: Vec<u8> = Vec::new();
    let mut ty: i64 = parse_primary(src, tk, &mut buf, st, sym);
    while st[1] == 0 {
        let k: i64 = cur_k(tk, st);
        if k == 29 {
            adv(tk, st);
            let mut next_b: Vec<u8> = Vec::new();
            emit_chunk(&mut next_b, 11386977943254626);
            emit_slice(&mut next_b, &buf, 0, buf.len() as i64);
            emit_chunk(&mut next_b, 8236);
            let _ = parse_expr(src, tk, &mut next_b, st, sym);
            let _ = expect(tk, st, 45, 310);
            next_b.push(41 as u8);
            buf = next_b;
            ty = 1;
        } else if k == 46 {
            adv(tk, st);
            let mi: i64 = expect(tk, st, 1, 311);
            let ms: i64 = tk_start(tk, mi);
            let ml: i64 = tk_len(tk, mi);
            if cur_k(tk, st) == 20 {
                adv(tk, st);
                let mut next_b: Vec<u8> = Vec::new();
                if m_len(src, ms, ml) != 0 {
                    let _ = expect(tk, st, 21, 313);
                    emit_chunk(&mut next_b, 11380380957374050);
                    emit_slice(&mut next_b, &buf, 0, buf.len() as i64);
                    next_b.push(41 as u8);
                    ty = 1;
                } else if m_push(src, ms, ml) != 0 {
                    emit_chunk(&mut next_b, 29400345811580514);
                    emit_chunk(&mut next_b, 40);
                    emit_slice(&mut next_b, &buf, 0, buf.len() as i64);
                    emit_chunk(&mut next_b, 8236);
                    let _ = parse_expr(src, tk, &mut next_b, st, sym);
                    let _ = expect(tk, st, 21, 314);
                    next_b.push(41 as u8);
                    ty = 0;
                } else {
                    set_err(st, tk_line(tk, mi), 315);
                }
                buf = next_b;
            } else {
                if ty < 100 || ty >= 200 {
                    set_err(st, tk_line(tk, mi), 604);
                    return 0;
                }
                let fty: i64 = find_struct_field_ty(src, sym, ty - 100, ms, ml);
                if fty < 0 {
                    set_err(st, tk_line(tk, mi), 604);
                    return 0;
                }
                let mut next_b: Vec<u8> = Vec::new();
                next_b.push(40 as u8);
                emit_slice(&mut next_b, &buf, 0, buf.len() as i64);
                emit_chunk(&mut next_b, 1600532009);
                emit_slice(&mut next_b, src, ms, ml);
                buf = next_b;
                ty = fty;
            }
        } else if k == 51 {
            adv(tk, st);
            let ti: i64 = expect(tk, st, 1, 316);
            let mut next_b: Vec<u8> = Vec::new();
            emit_chunk(&mut next_b, 14696572485445672);
            emit_chunk(&mut next_b, 673805407);
            emit_slice(&mut next_b, &buf, 0, buf.len() as i64);
            emit_chunk(&mut next_b, 10537);
            buf = next_b;
            ty = resolve_type_name(src, sym, tk_start(tk, ti), tk_len(tk, ti));
        } else {
            break;
        }
    }
    emit_slice(out, &buf, 0, buf.len() as i64);
    return ty;
}

fn parse_unary(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    if cur_k(tk, st) == 31 {
        adv(tk, st);
        emit_chunk(out, 2633000);
        let _ = parse_unary(src, tk, out, st, sym);
        emit_chunk(out, 10537);
        return 1;
    }
    if cur_k(tk, st) == 44 {
        adv(tk, st);
        emit_chunk(out, 14696572485445672);
        emit_chunk(out, 44122872837215);
        let _ = parse_unary(src, tk, out, st, sym);
        emit_chunk(out, 2697513);
        return 2;
    }
    return parse_postfix(src, tk, out, st, sym);
}

fn parse_mul(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut lhs: Vec<u8> = Vec::new();
    let mut ty: i64 = parse_unary(src, tk, &mut lhs, st, sym);
    while st[1] == 0 && (cur_k(tk, st) == 32 || cur_k(tk, st) == 33 || cur_k(tk, st) == 34) {
        let op_s: i64 = cur_s(tk, st);
        let op_l: i64 = cur_l(tk, st);
        adv(tk, st);
        let mut next_b: Vec<u8> = Vec::new();
        next_b.push(40 as u8);
        emit_slice(&mut next_b, &lhs, 0, lhs.len() as i64);
        next_b.push(32 as u8);
        emit_slice(&mut next_b, src, op_s, op_l);
        next_b.push(32 as u8);
        let _ = parse_unary(src, tk, &mut next_b, st, sym);
        next_b.push(41 as u8);
        lhs = next_b;
        ty = 1;
    }
    emit_slice(out, &lhs, 0, lhs.len() as i64);
    return ty;
}

