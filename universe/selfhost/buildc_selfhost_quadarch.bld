fn parse_cmp(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut lhs: Vec<u8> = Vec::new();
