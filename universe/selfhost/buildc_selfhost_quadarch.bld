fn parse_eq(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut lhs: Vec<u8> = Vec::new();
    let mut ty: i64 = parse_cmp(src, tk, &mut lhs, st, sym);
    while st[1] == 0 && (cur_k(tk, st) == 36 || cur_k(tk, st) == 37) {
        let op_k: i64 = cur_k(tk, st);
        let op_s: i64 = cur_s(tk, st);
        let op_l: i64 = cur_l(tk, st);
        adv(tk, st);
        let mut rhs: Vec<u8> = Vec::new();
        let rty: i64 = parse_cmp(src, tk, &mut rhs, st, sym);
        let mut next_b: Vec<u8> = Vec::new();
        if ty == 4 || rty == 4 {
            if op_k == 36 {
                emit_chunk(&mut next_b, 26865967264918626);
                emit_chunk(&mut next_b, 2650469);
            } else {
                emit_chunk(&mut next_b, 32777950975893800);
                emit_chunk(&mut next_b, 173701160818);
            }
            emit_slice(&mut next_b, &lhs, 0, lhs.len() as i64);
            emit_chunk(&mut next_b, 8236);
            emit_slice(&mut next_b, &rhs, 0, rhs.len() as i64);
            if op_k == 36 {
                next_b.push(41 as u8);
            } else {
                emit_chunk(&mut next_b, 10537);
            }
        } else {
            emit_chunk(&mut next_b, 14696572485445672);
            emit_chunk(&mut next_b, 673805407);
            emit_slice(&mut next_b, &lhs, 0, lhs.len() as i64);
            next_b.push(32 as u8);
            emit_slice(&mut next_b, src, op_s, op_l);
            next_b.push(32 as u8);
            emit_slice(&mut next_b, &rhs, 0, rhs.len() as i64);
            emit_chunk(&mut next_b, 10537);
        }
        lhs = next_b;
        ty = 2;
    }
    emit_slice(out, &lhs, 0, lhs.len() as i64);
    return ty;
}

fn parse_and(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut lhs: Vec<u8> = Vec::new();
