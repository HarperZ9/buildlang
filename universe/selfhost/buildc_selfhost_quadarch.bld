fn parse_println(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    adv(tk, st);
    let _ = expect(tk, st, 20, 401);
    let fi: i64 = expect(tk, st, 3, 402);
    let fs: i64 = tk_start(tk, fi);
    let fl: i64 = tk_len(tk, fi);
    emit_chunk(out, 29680698455498784);
    emit_chunk(out, 146706691182);
    let mut k: i64 = 0;
    while k < fl {
        let b: i64 = src[(fs + k) as usize] as i64;
        if b == 123 && k + 1 < fl && (src[(fs + k + 1) as usize] as i64) == 125 {
            emit_chunk(out, 1684827173);
            k = k + 2;
        } else {
            out.push(b as u8);
            k = k + 1;
        }
    }
    emit_chunk(out, 2256476);
    while cur_k(tk, st) == 24 && st[1] == 0 {
        adv(tk, st);
        emit_chunk(out, 29113347436191788);
        emit_chunk(out, 11304523279592480);
        let _ = parse_expr(src, tk, out, st, sym);
        out.push(41 as u8);
    }
    let _ = expect(tk, st, 21, 403);
    let _ = expect(tk, st, 25, 404);
    emit_chunk(out, 670505);
    return 0;
}

fn parse_match_stmt(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>) -> i64 {
    adv(tk, st);
    let mid: i64 = st[8];
    st[8] = mid + 1;
    emit_chunk(out, 29590585746661408);
    emit_chunk(out, 9135151501440110);
    emit_chunk(out, 7167839);
    emit_int_dec(out, mid);
    emit_chunk(out, 2112800);
    let _ = parse_expr(src, tk, out, st, sym);
    emit_chunk(out, 2619);
    let _ = expect(tk, st, 22, 430);
    let mut first: i64 = 1;
    while cur_k(tk, st) != 23 && cur_k(tk, st) != 0 && st[1] == 0 {
        let mut is_wild: i64 = 0;
        if cur_k(tk, st) == 1 && cur_l(tk, st) == 1 && (src[cur_s(tk, st) as usize] as i64) == 95 {
            is_wild = 1;
            adv(tk, st);
        }
        if is_wild != 0 {
            if first == 0 {
                emit_chunk(out, 28464694429753376);
                emit_chunk(out, 11523940774764);
            } else {
                emit_chunk(out, 11523936231456);
            }
        } else {
            if first == 0 {
                emit_chunk(out, 28464694429753376);
                emit_chunk(out, 9119800955859820);
                emit_chunk(out, 1834966824);
            } else {
                emit_chunk(out, 9119800951316512);
                emit_chunk(out, 1834966824);
            }
            emit_int_dec(out, mid);
            emit_chunk(out, 540884256);
            let _ = parse_primary(src, tk, out, st, sym);
            emit_chunk(out, 175841321);
        }
        first = 0;
        let _ = expect(tk, st, 57, 431);
        parse_block(src, tk, out, st, sym);
        if cur_k(tk, st) == 24 { adv(tk, st); }
    }
    if first == 0 {
        emit_chunk(out, 11532526166048);
    }
    let _ = expect(tk, st, 23, 432);
    emit_chunk(out, 11532526166048);
    return 0;
}

fn parse_block(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>) -> i64 {
    let _ = expect(tk, st, 22, 410);
    while cur_k(tk, st) != 23 && cur_k(tk, st) != 0 && st[1] == 0 {
        parse_stmt(src, tk, out, st, sym);
    }
    let _ = expect(tk, st, 23, 411);
    return 0;
}

fn parse_stmt(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>) -> i64 {
    if st[1] != 0 { return 0; }
    let k: i64 = cur_k(tk, st);
    if k == 11 {
        let ln: i64 = cur_ln(tk, st);
        adv(tk, st);
        if cur_k(tk, st) == 12 { adv(tk, st); }
        let ni: i64 = expect(tk, st, 1, 420);
        let ns: i64 = tk_start(tk, ni);
        let nl: i64 = tk_len(tk, ni);
        let mut decl_ty: i64 = 0;
        if cur_k(tk, st) == 26 {
            adv(tk, st);
            decl_ty = parse_type_id(src, tk, st, sym);
        }
        let _ = expect(tk, st, 35, 421);
        if nl == 1 && (src[ns as usize] as i64) == 95 {
            emit_chunk(out, 31373637124628512);
            emit_chunk(out, 673801321);
            let _ = parse_expr(src, tk, out, st, sym);
            let _ = expect(tk, st, 25, 422);
            emit_chunk(out, 670505);
            return 0;
        }
        let mut rhs_b: Vec<u8> = Vec::new();
        let rhs_ty: i64 = parse_expr(src, tk, &mut rhs_b, st, sym);
        let _ = expect(tk, st, 25, 423);
        if decl_ty != 0 && rhs_ty != 0 && decl_ty != rhs_ty {
            set_err(st, ln, 601);
            return 0;
        }
        let mut final_ty: i64 = decl_ty;
        if final_ty == 0 { final_ty = rhs_ty; }
        if final_ty == 0 { final_ty = 1; }
        sym_push(sym, 6, st[6], ns, nl, final_ty, 0);
        emit_chunk(out, 538976288);
        emit_c_type_from_id(src, sym, out, final_ty);
        emit_chunk(out, 6256160);
        emit_slice(out, src, ns, nl);
        emit_chunk(out, 2112800);
        emit_slice(out, &rhs_b, 0, rhs_b.len() as i64);
        emit_chunk(out, 2619);
        return 0;
    }
    if k == 13 {
        adv(tk, st);
        emit_chunk(out, 9119800951316512);
        emit_chunk(out, 40);
        let _ = parse_expr(src, tk, out, st, sym);
        emit_chunk(out, 175841321);
        parse_block(src, tk, out, st, sym);
        if cur_k(tk, st) == 14 {
            adv(tk, st);
            if cur_k(tk, st) == 13 {
                emit_chunk(out, 28464694429753376);
                emit_chunk(out, 11523940774764);
                parse_stmt(src, tk, out, st, sym);
                emit_chunk(out, 11532526166048);
                return 0;
            }
            emit_chunk(out, 28464694429753376);
            emit_chunk(out, 11523940774764);
            parse_block(src, tk, out, st, sym);
        }
        emit_chunk(out, 11532526166048);
        return 0;
    }
    if k == 15 {
        adv(tk, st);
        emit_chunk(out, 29669733403992096);
        emit_chunk(out, 673211756);
        let _ = parse_expr(src, tk, out, st, sym);
        emit_chunk(out, 175841321);
        parse_block(src, tk, out, st, sym);
        emit_chunk(out, 11532526166048);
        return 0;
    }
    if k == 56 {
        parse_match_stmt(src, tk, out, st, sym);
        return 0;
    }
    if k == 50 {
        adv(tk, st);
        let _ = expect(tk, st, 25, 424);
        emit_chunk(out, 28554738419114016);
        emit_chunk(out, 171666273);
        return 0;
    }
    if k == 16 {
        let ln: i64 = cur_ln(tk, st);
        adv(tk, st);
        if cur_k(tk, st) == 25 {
            adv(tk, st);
            emit_chunk(out, 32762638138089504);
            emit_chunk(out, 43946766965);
            return 0;
        }
        emit_chunk(out, 32762638138089504);
        emit_chunk(out, 544109173);
        let rty: i64 = parse_expr(src, tk, out, st, sym);
        let _ = expect(tk, st, 25, 425);
        if st[7] != 0 && rty != 0 && st[7] != rty {
            set_err(st, ln, 606);
            return 0;
        }
        emit_chunk(out, 2619);
        return 0;
    }
    if k == 19 {
        parse_println(src, tk, out, st, sym);
        return 0;
    }
    if k == 1 && tk_kind(tk, st[0] + 1) == 35 {
        let ln: i64 = cur_ln(tk, st);
        let ns: i64 = cur_s(tk, st);
        let nl: i64 = cur_l(tk, st);
        let lhs_ty: i64 = find_local_ty(src, sym, st[6], ns, nl);
        adv(tk, st);
        adv(tk, st);
        emit_chunk(out, 104960949755936);
        emit_slice(out, src, ns, nl);
        emit_chunk(out, 2112800);
        let rhs_ty: i64 = parse_expr(src, tk, out, st, sym);
        let _ = expect(tk, st, 25, 426);
        if lhs_ty != 0 && rhs_ty != 0 && lhs_ty != rhs_ty {
            set_err(st, ln, 602);
            return 0;
        }
        emit_chunk(out, 2619);
        return 0;
    }
    if k == 1 && tk_kind(tk, st[0] + 1) == 29 {
        let saved: i64 = st[0];
        let ns: i64 = cur_s(tk, st);
        let nl: i64 = cur_l(tk, st);
        adv(tk, st);
        adv(tk, st);
        let mut idx_b: Vec<u8> = Vec::new();
        let _ = parse_expr(src, tk, &mut idx_b, st, sym);
        if cur_k(tk, st) == 45 && tk_kind(tk, st[0] + 1) == 35 {
            adv(tk, st);
            adv(tk, st);
            emit_chunk(out, 26870286605361184);
            emit_chunk(out, 104961089496435);
            emit_slice(out, src, ns, nl);
            emit_chunk(out, 8236);
            emit_slice(out, &idx_b, 0, idx_b.len() as i64);
            emit_chunk(out, 8236);
            let _ = parse_expr(src, tk, out, st, sym);
            let _ = expect(tk, st, 25, 427);
            emit_chunk(out, 670505);
            return 0;
        }
        st[0] = saved;
    }
    let mut ebuf: Vec<u8> = Vec::new();
    let _ = parse_expr(src, tk, &mut ebuf, st, sym);
    if cur_k(tk, st) == 25 {
        adv(tk, st);
        emit_chunk(out, 538976288);
        emit_slice(out, &ebuf, 0, ebuf.len() as i64);
        emit_chunk(out, 2619);
        return 0;
    }
    set_err(st, cur_ln(tk, st), 428);
    return 0;
}

fn parse_struct_decl(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>) -> i64 {
    let _ = expect(tk, st, 54, 520);
    let si: i64 = expect(tk, st, 1, 521);
    let ss: i64 = tk_start(tk, si);
    let sl: i64 = tk_len(tk, si);
    let sid: i64 = st[9];
    st[9] = sid + 1;
    sym_push(sym, 1, sid, ss, sl, 0, 0);
    let _ = expect(tk, st, 22, 522);
    emit_chunk(out, 28821929497491828);
    emit_chunk(out, 32760453380993824);
    emit_chunk(out, 2128672);
    while cur_k(tk, st) != 23 && cur_k(tk, st) != 0 && st[1] == 0 {
        let fi: i64 = expect(tk, st, 1, 523);
        let fs: i64 = tk_start(tk, fi);
        let fl: i64 = tk_len(tk, fi);
        let _ = expect(tk, st, 26, 524);
        let fty: i64 = parse_type_id(src, tk, st, sym);
        sym_push(sym, 2, sid, fs, fl, fty, 0);
        emit_c_type_from_id(src, sym, out, fty);
        emit_chunk(out, 6252064);
        emit_slice(out, src, fs, fl);
        emit_chunk(out, 8251);
        if cur_k(tk, st) == 24 { adv(tk, st); }
    }
    let _ = expect(tk, st, 23, 525);
    emit_chunk(out, 409975595133);
    emit_slice(out, src, ss, sl);
    emit_chunk(out, 2619);
    return 0;
}

fn parse_enum_decl(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>) -> i64 {
    let _ = expect(tk, st, 55, 530);
    let ei: i64 = expect(tk, st, 1, 531);
    let es: i64 = tk_start(tk, ei);
    let el: i64 = tk_len(tk, ei);
    let eid: i64 = st[10];
    st[10] = eid + 1;
    sym_push(sym, 3, eid, es, el, 0, 0);
    let _ = expect(tk, st, 22, 532);
    let mut vidx: i64 = 0;
    while cur_k(tk, st) != 23 && cur_k(tk, st) != 0 && st[1] == 0 {
        let vi: i64 = expect(tk, st, 1, 533);
        let vs: i64 = tk_start(tk, vi);
        let vl: i64 = tk_len(tk, vi);
        sym_push(sym, 4, eid, vs, vl, vidx, 0);
        emit_chunk(out, 28550371616318499);
        emit_chunk(out, 1601070368);
        emit_slice(out, src, es, el);
        out.push(95 as u8);
        emit_slice(out, src, vs, vl);
        emit_chunk(out, 15327666301839392);
        emit_chunk(out, 695492404);
        emit_int_dec(out, vidx);
        emit_chunk(out, 170478668);
        vidx = vidx + 1;
        if cur_k(tk, st) == 24 { adv(tk, st); }
    }
    let _ = expect(tk, st, 23, 534);
    return 0;
}

fn emit_fn_sig(src: &Vec<u8>, tk: &Vec<i64>, out: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>, is_proto: i64) -> i64 {
    let _ = expect(tk, st, 10, 501);
    let fi: i64 = expect(tk, st, 1, 502);
    let fs: i64 = tk_start(tk, fi);
    let fl: i64 = tk_len(tk, fi);
    let is_m: i64 = kw_main(src, fs, fl);
    let _ = expect(tk, st, 20, 503);
    if is_proto == 0 { st[6] = st[6] + 1; }
    let mut pbuf: Vec<u8> = Vec::new();
    let mut pcount: i64 = 0;
    while cur_k(tk, st) != 21 && cur_k(tk, st) != 0 && st[1] == 0 {
        if pcount > 0 {
            let _ = expect(tk, st, 24, 504);
            emit_chunk(&mut pbuf, 8236);
        }
        let pi: i64 = expect(tk, st, 1, 505);
        let _ = expect(tk, st, 26, 506);
        let pty: i64 = parse_type_id(src, tk, st, sym);
        if is_proto == 0 {
            sym_push(sym, 6, st[6], tk_start(tk, pi), tk_len(tk, pi), pty, 0);
        }
        emit_c_type_from_id(src, sym, &mut pbuf, pty);
        emit_chunk(&mut pbuf, 6256160);
        emit_slice(&mut pbuf, src, tk_start(tk, pi), tk_len(tk, pi));
        pcount = pcount + 1;
    }
    let _ = expect(tk, st, 21, 507);
    let mut ret_ty: i64 = 0;
    if cur_k(tk, st) == 27 {
        adv(tk, st);
        ret_ty = parse_type_id(src, tk, st, sym);
    }
    if cur_k(tk, st) == 28 {
        adv(tk, st);
        let _ = expect(tk, st, 1, 508);
        while cur_k(tk, st) == 30 && st[1] == 0 {
            adv(tk, st);
            let _ = expect(tk, st, 1, 509);
        }
    }
    if is_proto != 0 && is_m == 0 {
        sym_push(sym, 5, 0, fs, fl, pcount, ret_ty);
    }
    if is_m != 0 {
        if is_proto == 0 {
            st[4] = 1;
            st[5] = 0;
            st[7] = 0;
            emit_chunk(out, 29661993878449769);
            emit_chunk(out, 27338757181614190);
            emit_chunk(out, 29382387412723570);
            emit_chunk(out, 32194938119287393);
            emit_chunk(out, 9018723191584359);
            emit_chunk(out, 32195209724960800);
            emit_chunk(out, 32194938437395303);
            emit_chunk(out, 27407969267966823);
            emit_chunk(out, 27338519650658162);
            emit_chunk(out, 43947288434);
        }
        return 1;
    }
    st[4] = 0;
    st[7] = ret_ty;
    if ret_ty == 0 {
        st[5] = 1;
        emit_chunk(out, 9116503830000755);
        emit_chunk(out, 30507188747857782);
        emit_chunk(out, 95);
    } else {
        st[5] = 0;
        emit_chunk(out, 9116503830000755);
        emit_c_type_from_id(src, sym, out, ret_ty);
        emit_chunk(out, 1600938528);
    }
    emit_slice(out, src, fs, fl);
    out.push(40 as u8);
    if pcount == 0 {
        emit_chunk(out, 1684631414);
    } else {
        emit_slice(out, &pbuf, 0, pbuf.len() as i64);
    }
    out.push(41 as u8);
    if is_proto != 0 {
        emit_chunk(out, 2619);
    } else {
        emit_chunk(out, 686880);
    }
    return 0;
}

fn skip_block(tk: &Vec<i64>, st: &mut Vec<i64>) -> i64 {
    let _ = expect(tk, st, 22, 510);
    let mut depth: i64 = 1;
    while depth > 0 && cur_k(tk, st) != 0 && st[1] == 0 {
        let k: i64 = cur_k(tk, st);
        if k == 22 { depth = depth + 1; }
        else if k == 23 { depth = depth - 1; }
        adv(tk, st);
    }
    if depth != 0 { set_err(st, cur_ln(tk, st), 511); }
    return 0;
}

fn skip_decl_block(tk: &Vec<i64>, st: &mut Vec<i64>) -> i64 {
    adv(tk, st);
    let _ = expect(tk, st, 1, 512);
    skip_block(tk, st);
    return 0;
}

fn compile_c(src: &Vec<u8>, out: &mut Vec<u8>, st: &mut Vec<i64>) -> i64 {
    let mut tk: Vec<i64> = Vec::new();
    let mut sym: Vec<i64> = Vec::new();
    lex_source(src, &mut tk, st);
    if st[1] != 0 { return 0; }
    if cur_k(&tk, st) == 0 {
        set_err(st, 1, 100);
        return 0;
    }
    emit_runtime_header(out);
    st[0] = 0;
    while cur_k(&tk, st) != 0 && st[1] == 0 {
        let k: i64 = cur_k(&tk, st);
        if k == 54 {
            parse_struct_decl(src, &tk, out, st, &mut sym);
        } else if k == 55 {
            parse_enum_decl(src, &tk, out, st, &mut sym);
        } else {
            let _ = emit_fn_sig(src, &tk, out, st, &mut sym, 1);
            skip_block(&tk, st);
        }
    }
    out.push(10 as u8);
    if st[1] != 0 { return 0; }
    st[0] = 0;
    while cur_k(&tk, st) != 0 && st[1] == 0 {
        let k: i64 = cur_k(&tk, st);
        if k == 54 || k == 55 {
            skip_decl_block(&tk, st);
        } else {
            let is_m: i64 = emit_fn_sig(src, &tk, out, st, &mut sym, 0);
            parse_block(src, &tk, out, st, &mut sym);
            if is_m != 0 {
                emit_chunk(out, 30511886296424480);
                emit_chunk(out, 28275535619060597);
                emit_chunk(out, 9018448469587311);
                emit_chunk(out, 33060551330373664);
                emit_chunk(out, 35195621415612018);
                emit_chunk(out, 2570);
            } else if st[5] != 0 {
                emit_chunk(out, 658045);
            } else if st[7] >= 100 && st[7] < 200 {
                emit_chunk(out, 538976288);
                emit_c_type_from_id(src, &sym, out, st[7]);
                emit_chunk(out, 9074408956059424);
                emit_chunk(out, 28554455410356347);
                emit_chunk(out, 26844715684099444);
                emit_chunk(out, 11040163773306);
            } else {
                emit_chunk(out, 32762638138089504);
                emit_chunk(out, 2879827655684725);
                emit_chunk(out, 658045);
            }
        }
    }
    return tk_count(&tk);
}

// =========================================================================
// PART B: DIRECT ZERO-C BINARY WEBASSEMBLY (.wasm v1) ENCODER
// =========================================================================

fn emit_uleb(out: &mut Vec<u8>, val: i64) -> i64 {
    let mut v: i64 = val;
    let mut more: i64 = 1;
    while more != 0 {
        let mut b: i64 = v % 128;
        v = v / 128;
        if v != 0 {
            b = b + 128;
        } else {
            more = 0;
        }
        out.push(b as u8);
    }
    return 0;
}

fn emit_sleb(out: &mut Vec<u8>, val: i64) -> i64 {
    let mut v: i64 = val;
    let mut more: i64 = 1;
    while more != 0 {
        let mut rem: i64 = v % 128;
        let mut q: i64 = v / 128;
        if rem < 0 {
            rem = rem + 128;
            q = q - 1;
        }
        let mut sign: i64 = 0;
        if rem >= 64 {
            sign = 1;
        }
        if (q == 0 && sign == 0) || (q == -1 && sign == 1) {
            out.push(rem as u8);
            more = 0;
        } else {
            out.push((rem + 128) as u8);
            v = q;
        }
    }
    return 0;
}

fn emit_wasm_section(out: &mut Vec<u8>, sec_id: i64, payload: &Vec<u8>) -> i64 {
    out.push(sec_id as u8);
    emit_uleb(out, payload.len() as i64);
    emit_slice(out, payload, 0, payload.len() as i64);
    return 0;
}

fn w_find_array_base(src: &Vec<u8>, sym: &Vec<i64>, fidx: i64, s: i64, l: i64) -> i64 {
    let n: i64 = (sym.len() as i64) / 6;
    let mut i: i64 = n - 1;
    while i >= 0 {
        if sym[(i * 6) as usize] == 10 && sym[(i * 6 + 1) as usize] == fidx {
            if bytes_eq(src, sym[(i * 6 + 2) as usize], sym[(i * 6 + 3) as usize], s, l) != 0 {
                return sym[(i * 6 + 4) as usize];
            }
        }
        i = i - 1;
    }
    return 0;
}

fn w_alloc_local(st: &mut Vec<i64>) -> i64 {
    let idx: i64 = st[12];
    st[12] = idx + 1;
    return idx;
}

fn w_parse_primary(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    if st[1] != 0 { return 0; }
    let k: i64 = cur_k(tk, st);
    if k == 2 {
        let v: i64 = parse_int_val(src, cur_s(tk, st), cur_l(tk, st));
        adv(tk, st);
        code.push(66 as u8); // 0x42 i64.const
        emit_sleb(code, v);
        return 1;
    }
    if k == 17 {
        adv(tk, st);
        code.push(66 as u8);
        code.push(1 as u8);
        return 2;
    }
    if k == 18 {
        adv(tk, st);
        code.push(66 as u8);
        code.push(0 as u8);
        return 2;
    }
    if k == 20 {
        adv(tk, st);
        let ty: i64 = w_parse_expr(src, tk, code, st, sym);
        let _ = expect(tk, st, 21, 301);
        return ty;
    }
    if k == 1 {
        let ln: i64 = cur_ln(tk, st);
        let s: i64 = cur_s(tk, st);
        let l: i64 = cur_l(tk, st);
        adv(tk, st);
        if cur_k(tk, st) == 20 {
            adv(tk, st);
            let fentry: i64 = find_fn_idx(src, sym, s, l);
            let mut argc: i64 = 0;
            while cur_k(tk, st) != 21 && cur_k(tk, st) != 0 && st[1] == 0 {
                if argc > 0 {
                    let _ = expect(tk, st, 24, 306);
                }
                let _ = w_parse_expr(src, tk, code, st, sym);
                argc = argc + 1;
            }
            let _ = expect(tk, st, 21, 307);
            if fentry < 0 {
                set_err(st, ln, 607);
                return 0;
            }
            let fidx: i64 = sym[(fentry * 6 + 1) as usize];
            let exp_ar: i64 = sym[(fentry * 6 + 4) as usize];
            if argc != exp_ar {
                set_err(st, ln, 603);
                return 0;
            }
            code.push(16 as u8); // 0x10 call
            emit_uleb(code, fidx);
            return sym[(fentry * 6 + 5) as usize];
        }
        if cur_k(tk, st) == 29 {
            adv(tk, st);
            let mbase: i64 = w_find_array_base(src, sym, st[6], s, l);
            if mbase == 0 { set_err(st, ln, 608); return 0; }
            let _ = w_parse_expr(src, tk, code, st, sym);
            let _ = expect(tk, st, 45, 310);
            code.push(66 as u8); code.push(8 as u8); // i64.const 8
            code.push(126 as u8);                   // i64.mul
            code.push(66 as u8); emit_sleb(code, mbase);
            code.push(124 as u8);                   // i64.add
            code.push(167 as u8);                   // i32.wrap_i64
            code.push(41 as u8); code.push(3 as u8); code.push(0 as u8); // i64.load
            return 1;
        }
        let lidx: i64 = w_find_local(src, sym, st[6], s, l);
        if lidx < 0 {
            set_err(st, ln, 608);
            return 0;
        }
        code.push(32 as u8); // 0x20 local.get
        emit_uleb(code, lidx);
        return 1;
    }
    set_err(st, cur_ln(tk, st), 308);
    return 0;
}

fn w_parse_unary(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    if cur_k(tk, st) == 31 {
        adv(tk, st);
        if cur_k(tk, st) == 2 {
            let v: i64 = parse_int_val(src, cur_s(tk, st), cur_l(tk, st));
            adv(tk, st);
            code.push(66 as u8); // 0x42 i64.const -v (exercises negative SLEB128!)
            emit_sleb(code, 0 - v);
            return 1;
        }
        code.push(66 as u8); // 0x42 i64.const 0
        code.push(0 as u8);
        let _ = w_parse_unary(src, tk, code, st, sym);
        code.push(125 as u8); // 0x7D i64.sub
        return 1;
    }
    if cur_k(tk, st) == 44 {
        adv(tk, st);
        let _ = w_parse_unary(src, tk, code, st, sym);
        code.push(80 as u8);  // 0x50 i64.eqz
        code.push(173 as u8); // 0xAD i64.extend_i32_u
        return 2;
    }
    let ty: i64 = w_parse_primary(src, tk, code, st, sym);
    while cur_k(tk, st) == 51 && st[1] == 0 {
        adv(tk, st);
        let _ = expect(tk, st, 1, 316);
    }
    return ty;
}

fn w_parse_mul(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut ty: i64 = w_parse_unary(src, tk, code, st, sym);
    while st[1] == 0 && (cur_k(tk, st) == 32 || cur_k(tk, st) == 33 || cur_k(tk, st) == 34) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        let _ = w_parse_unary(src, tk, code, st, sym);
        if op == 32 { code.push(126 as u8); }      // 0x7E i64.mul
        else if op == 33 { code.push(127 as u8); } // 0x7F i64.div_s
        else { code.push(129 as u8); }             // 0x81 i64.rem_s
        ty = 1;
    }
    return ty;
}

fn w_parse_add(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut ty: i64 = w_parse_mul(src, tk, code, st, sym);
    while st[1] == 0 && (cur_k(tk, st) == 30 || cur_k(tk, st) == 31) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        let _ = w_parse_mul(src, tk, code, st, sym);
        if op == 30 { code.push(124 as u8); } // 0x7C i64.add
        else { code.push(125 as u8); }        // 0x7D i64.sub
        ty = 1;
    }
    return ty;
}

fn w_parse_cmp(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut ty: i64 = w_parse_add(src, tk, code, st, sym);
    while st[1] == 0 && (cur_k(tk, st) == 38 || cur_k(tk, st) == 39 || cur_k(tk, st) == 40 || cur_k(tk, st) == 41) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        let _ = w_parse_add(src, tk, code, st, sym);
        if op == 38 { code.push(83 as u8); }       // 0x53 i64.lt_s
        else if op == 39 { code.push(87 as u8); }  // 0x57 i64.le_s
        else if op == 40 { code.push(85 as u8); }  // 0x55 i64.gt_s
        else { code.push(89 as u8); }              // 0x59 i64.ge_s
        code.push(173 as u8);                        // 0xAD i64.extend_i32_u
        ty = 2;
    }
    return ty;
}

fn w_parse_eq(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut ty: i64 = w_parse_cmp(src, tk, code, st, sym);
    while st[1] == 0 && (cur_k(tk, st) == 36 || cur_k(tk, st) == 37) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        let _ = w_parse_cmp(src, tk, code, st, sym);
        if op == 36 { code.push(81 as u8); } // 0x51 i64.eq
        else { code.push(82 as u8); }        // 0x52 i64.ne
        code.push(173 as u8);                  // 0xAD i64.extend_i32_u
        ty = 2;
    }
    return ty;
}

fn w_parse_and(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut ty: i64 = w_parse_eq(src, tk, code, st, sym);
    while st[1] == 0 && cur_k(tk, st) == 42 {
        adv(tk, st);
        code.push(80 as u8);  // 0x50 i64.eqz
        code.push(69 as u8);  // 0x45 i32.eqz (lhs != 0)
        code.push(4 as u8);   // 0x04 if
        code.push(126 as u8); // 0x7E (result i64)
        let _ = w_parse_eq(src, tk, code, st, sym);
        code.push(80 as u8);  // 0x50 i64.eqz
        code.push(69 as u8);  // 0x45 i32.eqz
        code.push(173 as u8); // 0xAD i64.extend_i32_u
        code.push(5 as u8);   // 0x05 else
        code.push(66 as u8);  // 0x42 i64.const 0
        code.push(0 as u8);
        code.push(11 as u8);  // 0x0B end
        ty = 2;
    }
    return ty;
}

fn w_parse_expr(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    let mut ty: i64 = w_parse_and(src, tk, code, st, sym);
    while st[1] == 0 && cur_k(tk, st) == 43 {
        adv(tk, st);
        code.push(80 as u8);  // 0x50 i64.eqz
        code.push(69 as u8);  // 0x45 i32.eqz (lhs != 0)
        code.push(4 as u8);   // 0x04 if
        code.push(126 as u8); // 0x7E (result i64)
        code.push(66 as u8);  // 0x42 i64.const 1
        code.push(1 as u8);
        code.push(5 as u8);   // 0x05 else
        let _ = w_parse_and(src, tk, code, st, sym);
        code.push(80 as u8);  // 0x50 i64.eqz
        code.push(69 as u8);  // 0x45 i32.eqz
        code.push(173 as u8); // 0xAD i64.extend_i32_u
        code.push(11 as u8);  // 0x0B end
        ty = 2;
    }
    return ty;
}

fn w_emit_log_i64(code: &mut Vec<u8>, scratch_local: i64) -> i64 {
    // Stack has i64 value on top; store to mem[(mem[0] + 1) * 8] and increment mem[0]
    code.push(33 as u8); // 0x21 local.set scratch
    emit_uleb(code, scratch_local);
    // addr = ((i64.load(0) + 1) * 8) as i32
    code.push(65 as u8); code.push(0 as u8); // i32.const 0
    code.push(41 as u8); code.push(3 as u8); code.push(0 as u8); // i64.load align=8 offset=0
    code.push(66 as u8); code.push(1 as u8); // i64.const 1
    code.push(124 as u8); // i64.add
    code.push(66 as u8); code.push(8 as u8); // i64.const 8
    code.push(126 as u8); // i64.mul
    code.push(167 as u8); // 0xA7 i32.wrap_i64
    code.push(32 as u8);  // 0x20 local.get scratch
    emit_uleb(code, scratch_local);
    code.push(55 as u8); code.push(3 as u8); code.push(0 as u8); // 0x37 i64.store align=8 offset=0
    // mem[0] = mem[0] + 1
    code.push(65 as u8); code.push(0 as u8); // i32.const 0
    code.push(65 as u8); code.push(0 as u8); // i32.const 0
    code.push(41 as u8); code.push(3 as u8); code.push(0 as u8); // i64.load
    code.push(66 as u8); code.push(1 as u8); // i64.const 1
    code.push(124 as u8); // i64.add
    code.push(55 as u8); code.push(3 as u8); code.push(0 as u8); // i64.store
    return 0;
}

fn w_parse_println(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>) -> i64 {
    adv(tk, st);
    let _ = expect(tk, st, 20, 401);
    let _ = expect(tk, st, 3, 402);
    let scratch: i64 = w_alloc_local(st);
    while cur_k(tk, st) == 24 && st[1] == 0 {
        adv(tk, st);
        let _ = w_parse_expr(src, tk, code, st, sym);
        w_emit_log_i64(code, scratch);
    }
    let _ = expect(tk, st, 21, 403);
    let _ = expect(tk, st, 25, 404);
    return 0;
}

fn w_parse_block(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>) -> i64 {
    let _ = expect(tk, st, 22, 410);
    while cur_k(tk, st) != 23 && cur_k(tk, st) != 0 && st[1] == 0 {
        w_parse_stmt(src, tk, code, st, sym);
    }
    let _ = expect(tk, st, 23, 411);
    return 0;
}

fn w_parse_stmt(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>) -> i64 {
    if st[1] != 0 { return 0; }
    let k: i64 = cur_k(tk, st);
    if k == 11 {
        let ln: i64 = cur_ln(tk, st);
        adv(tk, st);
        if cur_k(tk, st) == 12 { adv(tk, st); }
        let ni: i64 = expect(tk, st, 1, 420);
        let ns: i64 = tk_start(tk, ni);
        let nl: i64 = tk_len(tk, ni);
        let mut is_arr: i64 = 0;
        let mut arr_len: i64 = 0;
        let mut decl_ty: i64 = 0;
        if cur_k(tk, st) == 26 {
            adv(tk, st);
            if cur_k(tk, st) == 29 {
                adv(tk, st);
                let _ = parse_type_id(src, tk, st, sym);
                let _ = expect(tk, st, 25, 440);
                let li: i64 = expect(tk, st, 2, 441);
                arr_len = parse_int_val(src, tk_start(tk, li), tk_len(tk, li));
                let _ = expect(tk, st, 45, 442);
                is_arr = 1;
            } else {
                decl_ty = parse_type_id(src, tk, st, sym);
            }
        }
        let _ = expect(tk, st, 35, 421);
        if is_arr != 0 {
            let _ = expect(tk, st, 29, 443);
            let init_l: i64 = w_alloc_local(st);
            let idx_l: i64 = w_alloc_local(st);
            let _ = w_parse_expr(src, tk, code, st, sym);
            code.push(33 as u8); emit_uleb(code, init_l);
            let _ = expect(tk, st, 25, 444);
            let li2: i64 = expect(tk, st, 2, 445);
            let init_len: i64 = parse_int_val(src, tk_start(tk, li2), tk_len(tk, li2));
            let _ = expect(tk, st, 45, 446);
            let _ = expect(tk, st, 25, 447);
            if init_len != arr_len || arr_len <= 0 { set_err(st, ln, 609); return 0; }
            let mbase: i64 = 4096 + st[16] * 8;
            st[16] = st[16] + arr_len;
            sym_push(sym, 10, st[6], ns, nl, mbase, arr_len);
            // idx_l = 0; loop { if idx_l >= arr_len break; mem[mbase + idx_l*8] = init_l; idx_l += 1; }
            code.push(66 as u8); code.push(0 as u8);
            code.push(33 as u8); emit_uleb(code, idx_l);
            code.push(2 as u8); code.push(64 as u8);
            code.push(3 as u8); code.push(64 as u8);
            code.push(32 as u8); emit_uleb(code, idx_l);
            code.push(66 as u8); emit_sleb(code, arr_len);
            code.push(89 as u8); // i64.ge_s
            code.push(13 as u8); code.push(1 as u8); // br_if 1
            code.push(32 as u8); emit_uleb(code, idx_l);
            code.push(66 as u8); code.push(8 as u8); code.push(126 as u8);
            code.push(66 as u8); emit_sleb(code, mbase); code.push(124 as u8);
            code.push(167 as u8);
            code.push(32 as u8); emit_uleb(code, init_l);
            code.push(55 as u8); code.push(3 as u8); code.push(0 as u8); // i64.store
            code.push(32 as u8); emit_uleb(code, idx_l);
            code.push(66 as u8); code.push(1 as u8); code.push(124 as u8);
            code.push(33 as u8); emit_uleb(code, idx_l);
            code.push(12 as u8); code.push(0 as u8);
            code.push(11 as u8); code.push(11 as u8);
            return 0;
        }
        let rhs_ty: i64 = w_parse_expr(src, tk, code, st, sym);
        let _ = expect(tk, st, 25, 423);
        if decl_ty != 0 && rhs_ty != 0 && decl_ty != rhs_ty {
            set_err(st, ln, 601);
            return 0;
        }
        if nl == 1 && (src[ns as usize] as i64) == 95 {
            code.push(26 as u8); // 0x1A drop
            return 0;
        }
        let lidx: i64 = w_alloc_local(st);
        let mut final_ty: i64 = decl_ty;
        if final_ty == 0 { final_ty = rhs_ty; }
        if final_ty == 0 { final_ty = 1; }
        sym_push(sym, 7, st[6], ns, nl, lidx, final_ty);
        code.push(33 as u8); // 0x21 local.set
        emit_uleb(code, lidx);
        return 0;
    }
    if k == 13 {
        adv(tk, st);
        let _ = w_parse_expr(src, tk, code, st, sym);
        code.push(80 as u8); // 0x50 i64.eqz
        code.push(69 as u8); // 0x45 i32.eqz
        code.push(4 as u8);  // 0x04 if
        code.push(64 as u8); // 0x40 void block
        let saved_ld: i64 = st[11];
        if saved_ld > 0 { st[11] = saved_ld + 1; }
        w_parse_block(src, tk, code, st, sym);
        if cur_k(tk, st) == 14 {
            adv(tk, st);
            code.push(5 as u8); // 0x05 else
            if cur_k(tk, st) == 13 {
                w_parse_stmt(src, tk, code, st, sym);
            } else {
                w_parse_block(src, tk, code, st, sym);
            }
        }
        st[11] = saved_ld;
        code.push(11 as u8); // 0x0B end
        return 0;
    }
    if k == 15 {
        adv(tk, st);
        code.push(2 as u8);  // 0x02 block (break target)
        code.push(64 as u8); // 0x40 void
        code.push(3 as u8);  // 0x03 loop (continue target)
        code.push(64 as u8); // 0x40 void
        let _ = w_parse_expr(src, tk, code, st, sym);
        code.push(80 as u8); // 0x50 i64.eqz (1 if cond false)
        code.push(13 as u8); // 0x0D br_if 1 (exit block)
        code.push(1 as u8);
        let saved_ld: i64 = st[11];
        st[11] = 1;
        w_parse_block(src, tk, code, st, sym);
        st[11] = saved_ld;
        code.push(12 as u8); // 0x0C br 0 (repeat loop)
        code.push(0 as u8);
        code.push(11 as u8); // 0x0B end loop
        code.push(11 as u8); // 0x0B end block
        return 0;
    }
    if k == 50 {
        let ln: i64 = cur_ln(tk, st);
        adv(tk, st);
        let _ = expect(tk, st, 25, 424);
        if st[11] <= 0 {
            set_err(st, ln, 435);
            return 0;
        }
        code.push(12 as u8); // 0x0C br loop_break_depth
        emit_uleb(code, st[11]);
        return 0;
    }
    if k == 16 {
        adv(tk, st);
        if cur_k(tk, st) == 25 {
            adv(tk, st);
            code.push(66 as u8); code.push(0 as u8);
            code.push(15 as u8); // 0x0F return
            return 0;
        }
        let _ = w_parse_expr(src, tk, code, st, sym);
        let _ = expect(tk, st, 25, 425);
        code.push(15 as u8); // 0x0F return
        return 0;
    }
    if k == 19 {
        w_parse_println(src, tk, code, st, sym);
        return 0;
    }
    if k == 1 && tk_kind(tk, st[0] + 1) == 35 {
        let ln: i64 = cur_ln(tk, st);
        let ns: i64 = cur_s(tk, st);
        let nl: i64 = cur_l(tk, st);
        let lidx: i64 = w_find_local(src, sym, st[6], ns, nl);
        if lidx < 0 {
            set_err(st, ln, 608);
            return 0;
        }
        adv(tk, st);
        adv(tk, st);
        let _ = w_parse_expr(src, tk, code, st, sym);
        let _ = expect(tk, st, 25, 426);
        code.push(33 as u8); // 0x21 local.set
        emit_uleb(code, lidx);
        return 0;
    }
    if k == 1 && tk_kind(tk, st[0] + 1) == 29 {
        let ln: i64 = cur_ln(tk, st);
        let ns: i64 = cur_s(tk, st);
        let nl: i64 = cur_l(tk, st);
        let mbase: i64 = w_find_array_base(src, sym, st[6], ns, nl);
        if mbase == 0 { set_err(st, ln, 608); return 0; }
        adv(tk, st);
        adv(tk, st);
        let _ = w_parse_expr(src, tk, code, st, sym);
        let _ = expect(tk, st, 45, 448);
        let _ = expect(tk, st, 35, 449);
        code.push(66 as u8); code.push(8 as u8); code.push(126 as u8);
        code.push(66 as u8); emit_sleb(code, mbase); code.push(124 as u8);
        code.push(167 as u8); // addr: i32
        let _ = w_parse_expr(src, tk, code, st, sym); // val: i64
        let _ = expect(tk, st, 25, 427);
        code.push(55 as u8); code.push(3 as u8); code.push(0 as u8); // i64.store
        return 0;
    }
    let _ = w_parse_expr(src, tk, code, st, sym);
    if cur_k(tk, st) == 25 {
        adv(tk, st);
        code.push(26 as u8); // 0x1A drop
        return 0;
    }
    set_err(st, cur_ln(tk, st), 428);
    return 0;
}

fn w_parse_fn_header(src: &Vec<u8>, tk: &Vec<i64>, st: &mut Vec<i64>, sym: &mut Vec<i64>, fidx: i64, is_pass1: i64, t_items: &mut Vec<u8>, e_items: &mut Vec<u8>) -> i64 {
    let _ = expect(tk, st, 10, 501);
    let fi: i64 = expect(tk, st, 1, 502);
    let fs: i64 = tk_start(tk, fi);
    let fl: i64 = tk_len(tk, fi);
    let is_m: i64 = kw_main(src, fs, fl);
    let _ = expect(tk, st, 20, 503);
    let mut pcount: i64 = 0;
    while cur_k(tk, st) != 21 && cur_k(tk, st) != 0 && st[1] == 0 {
        if pcount > 0 {
            let _ = expect(tk, st, 24, 504);
        }
        let pi: i64 = expect(tk, st, 1, 505);
        let _ = expect(tk, st, 26, 506);
        let pty: i64 = parse_type_id(src, tk, st, sym);
        if is_pass1 == 0 {
            sym_push(sym, 7, fidx, tk_start(tk, pi), tk_len(tk, pi), pcount, pty);
        }
        pcount = pcount + 1;
    }
    let _ = expect(tk, st, 21, 507);
    let mut ret_ty: i64 = 1;
    if cur_k(tk, st) == 27 {
        adv(tk, st);
        ret_ty = parse_type_id(src, tk, st, sym);
    }
    if cur_k(tk, st) == 28 {
        adv(tk, st);
        let _ = expect(tk, st, 1, 508);
        while cur_k(tk, st) == 30 && st[1] == 0 {
            adv(tk, st);
            let _ = expect(tk, st, 1, 509);
        }
    }
    if is_pass1 != 0 {
        sym_push(sym, 5, fidx, fs, fl, pcount, ret_ty);
        // Type entry: 0x60 (func) + params (pcount x i64) + 1 result (i64)
        t_items.push(96 as u8);
        emit_uleb(t_items, pcount);
        let mut pi2: i64 = 0;
        while pi2 < pcount {
            t_items.push(126 as u8); // 0x7E i64
            pi2 = pi2 + 1;
        }
        t_items.push(1 as u8);
        t_items.push(126 as u8); // 0x7E i64
        // Export entry: name + kind=0 (func) + fidx
        emit_uleb(e_items, fl);
        emit_slice(e_items, src, fs, fl);
        e_items.push(0 as u8);
        emit_uleb(e_items, fidx);
    } else {
        st[4] = is_m;
        st[6] = fidx;
        st[11] = 0;
        st[12] = pcount;
        st[13] = pcount;
    }
    return is_m;
}

fn compile_wasm(src: &Vec<u8>, out: &mut Vec<u8>, st: &mut Vec<i64>) -> i64 {
    let mut tk: Vec<i64> = Vec::new();
    let mut sym: Vec<i64> = Vec::new();
    lex_source(src, &mut tk, st);
    if st[1] != 0 { return 0; }
    if cur_k(&tk, st) == 0 {
        set_err(st, 1, 100);
        return 0;
    }
    let mut t_items: Vec<u8> = Vec::new();
    let mut e_items: Vec<u8> = Vec::new();
    let mut n_funcs: i64 = 0;
    st[0] = 0;
    while cur_k(&tk, st) != 0 && st[1] == 0 {
        let _ = w_parse_fn_header(src, &tk, st, &mut sym, n_funcs, 1, &mut t_items, &mut e_items);
        skip_block(&tk, st);
        n_funcs = n_funcs + 1;
    }
    if st[1] != 0 { return 0; }

    let mut code_items: Vec<u8> = Vec::new();
    let mut dummy_t: Vec<u8> = Vec::new();
    let mut dummy_e: Vec<u8> = Vec::new();
    let mut fidx: i64 = 0;
    st[0] = 0;
    while cur_k(&tk, st) != 0 && st[1] == 0 {
        let is_m: i64 = w_parse_fn_header(src, &tk, st, &mut sym, fidx, 0, &mut dummy_t, &mut dummy_e);
        let mut instrs: Vec<u8> = Vec::new();
        w_parse_block(src, &tk, &mut instrs, st, &mut sym);
        if is_m != 0 {
            // main returns mem[0] (count of logged println i64 values)
            instrs.push(65 as u8); instrs.push(0 as u8); // i32.const 0
            instrs.push(41 as u8); instrs.push(3 as u8); instrs.push(0 as u8); // i64.load
        } else {
            instrs.push(66 as u8); instrs.push(0 as u8); // fallback i64.const 0
        }
        instrs.push(11 as u8); // 0x0B end
        let mut fbody: Vec<u8> = Vec::new();
        let extra_locals: i64 = st[12] - st[13];
        if extra_locals <= 0 {
            fbody.push(0 as u8);
        } else {
            fbody.push(1 as u8);
            emit_uleb(&mut fbody, extra_locals);
            fbody.push(126 as u8); // 0x7E i64
        }
        emit_slice(&mut fbody, &instrs, 0, instrs.len() as i64);
        emit_uleb(&mut code_items, fbody.len() as i64);
        emit_slice(&mut code_items, &fbody, 0, fbody.len() as i64);
        fidx = fidx + 1;
    }
    if st[1] != 0 { return 0; }

    // 1. Magic "␀asm" + Version 1
    out.push(0 as u8); out.push(97 as u8); out.push(115 as u8); out.push(109 as u8);
    out.push(1 as u8); out.push(0 as u8); out.push(0 as u8); out.push(0 as u8);

    // 2. Type section (id = 1)
    let mut sec1: Vec<u8> = Vec::new();
    emit_uleb(&mut sec1, n_funcs);
    emit_slice(&mut sec1, &t_items, 0, t_items.len() as i64);
    emit_wasm_section(out, 1, &sec1);

    // 3. Function section (id = 3)
    let mut sec3: Vec<u8> = Vec::new();
    emit_uleb(&mut sec3, n_funcs);
    let mut fi3: i64 = 0;
    while fi3 < n_funcs {
        emit_uleb(&mut sec3, fi3);
        fi3 = fi3 + 1;
    }
    emit_wasm_section(out, 3, &sec3);

    // 4. Memory section (id = 5): 1 memory, min 1 page (64 KiB)
    let mut sec5: Vec<u8> = Vec::new();
    sec5.push(1 as u8); sec5.push(0 as u8); sec5.push(1 as u8);
    emit_wasm_section(out, 5, &sec5);

    // 5. Export section (id = 7): all functions + linear memory "memory"
    let mut sec7: Vec<u8> = Vec::new();
    emit_uleb(&mut sec7, n_funcs + 1);
    emit_slice(&mut sec7, &e_items, 0, e_items.len() as i64);
    sec7.push(6 as u8);
    emit_chunk(&mut sec7, 133532402673005);
    sec7.push(2 as u8); // export kind = memory
    sec7.push(0 as u8); // memory index 0
    emit_wasm_section(out, 7, &sec7);

    // 6. Code section (id = 10)
    let mut sec10: Vec<u8> = Vec::new();
    emit_uleb(&mut sec10, n_funcs);
    emit_slice(&mut sec10, &code_items, 0, code_items.len() as i64);
    emit_wasm_section(out, 10, &sec10);

    return tk_count(&tk);
}


// =========================================================================
// PART C: DIRECT ZERO-C NATIVE x86-64 ENCODER (WITH ARRAYS + NATIVE STDOUT)
// =========================================================================

struct TargetSpec {
    target_id: i64,
    os_kind: i64,
    image_base_lo: i64,
    image_base_hi: i64,
    text_vaddr: i64,
    file_align: i64,
    page_align: i64,
    exit_syscall: i64,
    write_syscall: i64,
}

fn lookup_target_spec(target_id: i64) -> TargetSpec {
    // Row 1: Windows x86-64 PE32+ (KERNEL32.dll ExitProcess / GetStdHandle / WriteFile)
    let mut spec: TargetSpec = TargetSpec {
        target_id: 1,
        os_kind: 1,
        image_base_lo: 1073741824,
        image_base_hi: 1,
        text_vaddr: 4096,
        file_align: 512,
        page_align: 4096,
        exit_syscall: 0,
        write_syscall: 0,
    };
    // Row 2: Linux x86-64 ELF64 (SYS_write=1, SYS_exit=60)
    if target_id == 2 {
        spec = TargetSpec {
            target_id: 2,
            os_kind: 2,
            image_base_lo: 4194304,
            image_base_hi: 0,
            text_vaddr: 4198400,
            file_align: 4096,
            page_align: 4096,
            exit_syscall: 60,
            write_syscall: 1,
        };
    }
    return spec;
}

fn emit_u16_le(out: &mut Vec<u8>, val: i64) -> i64 {
    let mut v: i64 = val;
    let mut i: i64 = 0;
    while i < 2 {
        let mut b: i64 = v % 256;
        let mut q: i64 = v / 256;
        if b < 0 { b = b + 256; q = q - 1; }
        out.push(b as u8);
        v = q;
        i = i + 1;
    }
    return 0;
}

fn emit_u32_le(out: &mut Vec<u8>, val: i64) -> i64 {
    let mut v: i64 = val;
    let mut i: i64 = 0;
    while i < 4 {
        let mut b: i64 = v % 256;
        let mut q: i64 = v / 256;
        if b < 0 { b = b + 256; q = q - 1; }
        out.push(b as u8);
        v = q;
        i = i + 1;
    }
    return 0;
}

fn emit_i64_le(out: &mut Vec<u8>, val: i64) -> i64 {
    let mut v: i64 = val;
    let mut i: i64 = 0;
    while i < 8 {
        let mut b: i64 = v % 256;
        let mut q: i64 = v / 256;
        if b < 0 { b = b + 256; q = q - 1; }
        out.push(b as u8);
        v = q;
        i = i + 1;
    }
    return 0;
}

fn patch_u32_le(out: &mut Vec<u8>, pos: i64, val: i64) -> i64 {
    let mut v: i64 = val;
    let mut i: i64 = 0;
    while i < 4 {
        let mut b: i64 = v % 256;
        let mut q: i64 = v / 256;
        if b < 0 { b = b + 256; q = q - 1; }
        out[(pos + i) as usize] = b as u8;
        v = q;
        i = i + 1;
    }
    return 0;
}

fn emit_zeros(out: &mut Vec<u8>, count: i64) -> i64 {
    let mut i: i64 = 0;
    while i < count {
        out.push(0 as u8);
        i = i + 1;
    }
    return 0;
}

fn align_up(val: i64, align: i64) -> i64 {
    let rem: i64 = val % align;
    if rem == 0 {
        if val == 0 { return align; }
        return val;
    }
    return val + (align - rem);
}

fn x_find_slot(src: &Vec<u8>, sym: &Vec<i64>, fidx: i64, s: i64, l: i64) -> i64 {
    let n: i64 = (sym.len() as i64) / 6;
    let mut i: i64 = n - 1;
    while i >= 0 {
        if sym[(i * 6) as usize] == 8 && sym[(i * 6 + 1) as usize] == fidx {
            if bytes_eq(src, sym[(i * 6 + 2) as usize], sym[(i * 6 + 3) as usize], s, l) != 0 {
                return sym[(i * 6 + 4) as usize];
            }
        }
        i = i - 1;
    }
    return 0;
}

fn x_find_array_base(src: &Vec<u8>, sym: &Vec<i64>, fidx: i64, s: i64, l: i64) -> i64 {
    let n: i64 = (sym.len() as i64) / 6;
    let mut i: i64 = n - 1;
    while i >= 0 {
        if sym[(i * 6) as usize] == 9 && sym[(i * 6 + 1) as usize] == fidx {
            if bytes_eq(src, sym[(i * 6 + 2) as usize], sym[(i * 6 + 3) as usize], s, l) != 0 {
                return sym[(i * 6 + 4) as usize];
            }
        }
        i = i - 1;
    }
    return 0;
}

fn x_emit_mov_rax_imm64(code: &mut Vec<u8>, val: i64) -> i64 {
    code.push(72 as u8);
    code.push(184 as u8);
    emit_i64_le(code, val);
    return 0;
}

fn x_emit_load_slot(code: &mut Vec<u8>, disp: i64) -> i64 {
    code.push(72 as u8); code.push(139 as u8); code.push(133 as u8);
    emit_u32_le(code, disp);
    return 0;
}

fn x_emit_store_slot(code: &mut Vec<u8>, disp: i64) -> i64 {
    code.push(72 as u8); code.push(137 as u8); code.push(133 as u8);
    emit_u32_le(code, disp);
    return 0;
}

fn x_emit_epilogue(code: &mut Vec<u8>) -> i64 {
    code.push(72 as u8); code.push(137 as u8); code.push(236 as u8);
    code.push(93 as u8); code.push(195 as u8);
    return 0;
}

fn x_emit_acc_println_val(code: &mut Vec<u8>) -> i64 {
    code.push(72 as u8); code.push(139 as u8); code.push(141 as u8);
    emit_u32_le(code, -8);
    code.push(72 as u8); code.push(105 as u8); code.push(201 as u8);
    emit_u32_le(code, 131);
    code.push(72 as u8); code.push(1 as u8); code.push(193 as u8);
    code.push(72 as u8); code.push(137 as u8); code.push(200 as u8);
    code.push(72 as u8); code.push(37 as u8);
    emit_u32_le(code, 2147483647);
    x_emit_store_slot(code, -8);
    return 0;
}

fn x_emit_print_i64_helper(text: &mut Vec<u8>, write_stdout_off: i64) -> i64 {
    // OS-independent __bl_print_i64(val in rax):
    // Converts signed i64 in rax to decimal ASCII + '\n' on stack, calls write_stdout(rsi=ptr, rdx=len)
    let fn_start: i64 = text.len() as i64;
    text.push(85 as u8);                                                  // push rbp
    text.push(72 as u8); text.push(137 as u8); text.push(229 as u8);      // mov rbp, rsp
    text.push(72 as u8); text.push(131 as u8); text.push(236 as u8); text.push(48 as u8); // sub rsp, 0x30
    text.push(72 as u8); text.push(137 as u8); text.push(69 as u8); text.push(216 as u8); // mov [rbp-40], rax
    text.push(72 as u8); text.push(133 as u8); text.push(192 as u8);      // test rax, rax
    text.push(125 as u8); text.push(3 as u8);                             // jge +3
    text.push(72 as u8); text.push(247 as u8); text.push(216 as u8);      // neg rax
    text.push(72 as u8); text.push(141 as u8); text.push(117 as u8); text.push(255 as u8); // lea rsi, [rbp-1]
    text.push(198 as u8); text.push(6 as u8); text.push(10 as u8);        // mov byte [rsi], 0x0A ('\n')
    text.push(72 as u8); text.push(199 as u8); text.push(193 as u8);      // mov rcx, 10
    emit_u32_le(text, 10);
    // Digit loop (18 bytes)
    text.push(72 as u8); text.push(255 as u8); text.push(206 as u8);      // dec rsi (3)
    text.push(49 as u8); text.push(210 as u8);                            // xor edx, edx (2)
    text.push(72 as u8); text.push(247 as u8); text.push(241 as u8);      // div rcx (3)
    text.push(128 as u8); text.push(194 as u8); text.push(48 as u8);      // add dl, 48 (3)
    text.push(136 as u8); text.push(22 as u8);                            // mov [rsi], dl (2)
    text.push(72 as u8); text.push(133 as u8); text.push(192 as u8);      // test rax, rax (3)
    text.push(117 as u8); text.push(238 as u8);                           // jnz -18 (2)
    // Sign check
    text.push(72 as u8); text.push(131 as u8); text.push(125 as u8); text.push(216 as u8); text.push(0 as u8); // cmp qword [rbp-40], 0
    text.push(125 as u8); text.push(6 as u8);                             // jge +6
    text.push(72 as u8); text.push(255 as u8); text.push(206 as u8);      // dec rsi (3)
    text.push(198 as u8); text.push(6 as u8); text.push(45 as u8);        // mov byte [rsi], '-' (3)
    // rdx = rbp - rsi
    text.push(72 as u8); text.push(137 as u8); text.push(234 as u8);      // mov rdx, rbp
    text.push(72 as u8); text.push(41 as u8); text.push(242 as u8);       // sub rdx, rsi
    // Guarantee 16-byte stack alignment for OS write_stdout call
    text.push(72 as u8); text.push(131 as u8); text.push(228 as u8); text.push(240 as u8); // and rsp, -16
    text.push(232 as u8);                                                 // call write_stdout
    let after_call: i64 = (text.len() as i64) + 4;
    emit_u32_le(text, write_stdout_off - after_call);
    x_emit_epilogue(text);
    return fn_start;
}

fn x_parse_primary(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    if st[1] != 0 { return 0; }
    let k: i64 = cur_k(tk, st);
    if k == 2 {
        let v: i64 = parse_int_val(src, cur_s(tk, st), cur_l(tk, st));
        adv(tk, st);
        x_emit_mov_rax_imm64(code, v);
        return 1;
    }
    if k == 17 {
        adv(tk, st);
        x_emit_mov_rax_imm64(code, 1);
        return 2;
    }
    if k == 18 {
        adv(tk, st);
        x_emit_mov_rax_imm64(code, 0);
        return 2;
    }
    if k == 20 {
        adv(tk, st);
        let ty: i64 = x_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 21, 301);
        return ty;
    }
    if k == 1 {
        let ln: i64 = cur_ln(tk, st);
        let s: i64 = cur_s(tk, st);
        let l: i64 = cur_l(tk, st);
        adv(tk, st);
        if cur_k(tk, st) == 20 {
            adv(tk, st);
            let fentry: i64 = find_fn_idx(src, sym, s, l);
            let mut argc: i64 = 0;
            while cur_k(tk, st) != 21 && cur_k(tk, st) != 0 && st[1] == 0 {
                if argc > 0 {
                    let _ = expect(tk, st, 24, 306);
                }
                let _ = x_parse_expr(src, tk, code, st, sym, fixups);
                code.push(80 as u8);
                argc = argc + 1;
            }
            let _ = expect(tk, st, 21, 307);
            if fentry < 0 {
                set_err(st, ln, 607);
                return 0;
            }
            let fidx: i64 = sym[(fentry * 6 + 1) as usize];
            let exp_ar: i64 = sym[(fentry * 6 + 4) as usize];
            if argc != exp_ar {
                set_err(st, ln, 603);
                return 0;
            }
            code.push(232 as u8);
            let ppos: i64 = code.len() as i64;
            emit_u32_le(code, 0);
            fixups.push(ppos);
            fixups.push(fidx);
            if argc > 0 {
                code.push(72 as u8); code.push(129 as u8); code.push(196 as u8);
                emit_u32_le(code, argc * 8);
            }
            return sym[(fentry * 6 + 5) as usize];
        }
        if cur_k(tk, st) == 29 {
            adv(tk, st);
            let base_disp: i64 = x_find_array_base(src, sym, st[6], s, l);
            if base_disp == 0 {
                set_err(st, ln, 608);
                return 0;
            }
            let _ = x_parse_expr(src, tk, code, st, sym, fixups);
            let _ = expect(tk, st, 45, 310);
            // lea rcx, [rbp + base_disp]; mov rax, [rcx + rax*8]
            code.push(72 as u8); code.push(141 as u8); code.push(141 as u8);
            emit_u32_le(code, base_disp);
            code.push(72 as u8); code.push(139 as u8); code.push(4 as u8); code.push(193 as u8);
            return 1;
        }
        let disp: i64 = x_find_slot(src, sym, st[6], s, l);
        if disp == 0 {
            set_err(st, ln, 608);
            return 0;
        }
        x_emit_load_slot(code, disp);
        return 1;
    }
    set_err(st, cur_ln(tk, st), 308);
    return 0;
}

fn x_parse_unary(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    if cur_k(tk, st) == 31 {
        adv(tk, st);
        let _ = x_parse_unary(src, tk, code, st, sym, fixups);
        code.push(72 as u8); code.push(247 as u8); code.push(216 as u8);
        return 1;
    }
    if cur_k(tk, st) == 44 {
        adv(tk, st);
        let _ = x_parse_unary(src, tk, code, st, sym, fixups);
        code.push(72 as u8); code.push(133 as u8); code.push(192 as u8);
        code.push(15 as u8); code.push(148 as u8); code.push(192 as u8);
        code.push(72 as u8); code.push(15 as u8); code.push(182 as u8); code.push(192 as u8);
        return 2;
    }
    let ty: i64 = x_parse_primary(src, tk, code, st, sym, fixups);
    while cur_k(tk, st) == 51 && st[1] == 0 {
        adv(tk, st);
        let _ = expect(tk, st, 1, 316);
    }
    return ty;
}

fn x_parse_mul(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = x_parse_unary(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 32 || cur_k(tk, st) == 33 || cur_k(tk, st) == 34) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        code.push(80 as u8);
        let _ = x_parse_unary(src, tk, code, st, sym, fixups);
        code.push(89 as u8);
        if op == 32 {
            code.push(72 as u8); code.push(15 as u8); code.push(175 as u8); code.push(193 as u8);
        } else {
            code.push(72 as u8); code.push(145 as u8);
            code.push(72 as u8); code.push(153 as u8);
            code.push(72 as u8); code.push(247 as u8); code.push(249 as u8);
            if op == 34 {
                code.push(72 as u8); code.push(137 as u8); code.push(208 as u8);
            }
        }
        ty = 1;
    }
    return ty;
}

fn x_parse_add(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = x_parse_mul(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 30 || cur_k(tk, st) == 31) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        code.push(80 as u8);
        let _ = x_parse_mul(src, tk, code, st, sym, fixups);
        code.push(89 as u8);
        if op == 30 {
            code.push(72 as u8); code.push(1 as u8); code.push(200 as u8);
        } else {
            code.push(72 as u8); code.push(41 as u8); code.push(193 as u8);
            code.push(72 as u8); code.push(137 as u8); code.push(200 as u8);
        }
        ty = 1;
    }
    return ty;
}

fn x_parse_cmp(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = x_parse_add(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 38 || cur_k(tk, st) == 39 || cur_k(tk, st) == 40 || cur_k(tk, st) == 41) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        code.push(80 as u8);
        let _ = x_parse_add(src, tk, code, st, sym, fixups);
        code.push(89 as u8);
        code.push(72 as u8); code.push(57 as u8); code.push(193 as u8);
        code.push(15 as u8);
        if op == 38 { code.push(156 as u8); }
        else if op == 39 { code.push(158 as u8); }
        else if op == 40 { code.push(159 as u8); }
        else { code.push(157 as u8); }
        code.push(192 as u8);
        code.push(72 as u8); code.push(15 as u8); code.push(182 as u8); code.push(192 as u8);
        ty = 2;
    }
    return ty;
}

fn x_parse_eq(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = x_parse_cmp(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 36 || cur_k(tk, st) == 37) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        code.push(80 as u8);
        let _ = x_parse_cmp(src, tk, code, st, sym, fixups);
        code.push(89 as u8);
        code.push(72 as u8); code.push(57 as u8); code.push(193 as u8);
        code.push(15 as u8);
        if op == 36 { code.push(148 as u8); }
        else { code.push(149 as u8); }
        code.push(192 as u8);
        code.push(72 as u8); code.push(15 as u8); code.push(182 as u8); code.push(192 as u8);
        ty = 2;
    }
    return ty;
}

fn x_parse_and(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = x_parse_eq(src, tk, code, st, sym, fixups);
    while st[1] == 0 && cur_k(tk, st) == 42 {
        adv(tk, st);
        code.push(72 as u8); code.push(133 as u8); code.push(192 as u8);
        code.push(15 as u8); code.push(132 as u8);
        let p_false: i64 = code.len() as i64;
        emit_u32_le(code, 0);
        let _ = x_parse_eq(src, tk, code, st, sym, fixups);
        code.push(72 as u8); code.push(133 as u8); code.push(192 as u8);
        code.push(15 as u8); code.push(149 as u8); code.push(192 as u8);
        code.push(72 as u8); code.push(15 as u8); code.push(182 as u8); code.push(192 as u8);
        code.push(233 as u8);
        let p_done: i64 = code.len() as i64;
        emit_u32_le(code, 0);
        let l_false: i64 = code.len() as i64;
        patch_u32_le(code, p_false, l_false - (p_false + 4));
        code.push(49 as u8); code.push(192 as u8);
        let l_done: i64 = code.len() as i64;
        patch_u32_le(code, p_done, l_done - (p_done + 4));
        ty = 2;
    }
    return ty;
}

fn x_parse_expr(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = x_parse_and(src, tk, code, st, sym, fixups);
    while st[1] == 0 && cur_k(tk, st) == 43 {
        adv(tk, st);
        code.push(72 as u8); code.push(133 as u8); code.push(192 as u8);
        code.push(15 as u8); code.push(133 as u8);
        let p_true: i64 = code.len() as i64;
        emit_u32_le(code, 0);
        let _ = x_parse_and(src, tk, code, st, sym, fixups);
        code.push(72 as u8); code.push(133 as u8); code.push(192 as u8);
        code.push(15 as u8); code.push(149 as u8); code.push(192 as u8);
        code.push(72 as u8); code.push(15 as u8); code.push(182 as u8); code.push(192 as u8);
        code.push(233 as u8);
        let p_done: i64 = code.len() as i64;
        emit_u32_le(code, 0);
        let l_true: i64 = code.len() as i64;
        patch_u32_le(code, p_true, l_true - (p_true + 4));
        code.push(184 as u8); emit_u32_le(code, 1);
        let l_done: i64 = code.len() as i64;
        patch_u32_le(code, p_done, l_done - (p_done + 4));
        ty = 2;
    }
    return ty;
}

fn x_parse_println(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>, pfixups: &mut Vec<i64>) -> i64 {
    adv(tk, st);
    let _ = expect(tk, st, 20, 401);
    let _ = expect(tk, st, 3, 402);
    while cur_k(tk, st) == 24 && st[1] == 0 {
        adv(tk, st);
        let _ = x_parse_expr(src, tk, code, st, sym, fixups);
        code.push(80 as u8); // push rax (preserve across native stdout print)
        code.push(232 as u8); // call __bl_print_i64 (patched per OS target wrapper)
        pfixups.push(code.len() as i64);
        emit_u32_le(code, 0);
        code.push(88 as u8); // pop rax
        x_emit_acc_println_val(code);
    }
    let _ = expect(tk, st, 21, 403);
    let _ = expect(tk, st, 25, 404);
    return 0;
}

fn x_parse_block(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>, fixups: &mut Vec<i64>, brks: &mut Vec<i64>, pfixups: &mut Vec<i64>) -> i64 {
    let _ = expect(tk, st, 22, 410);
    while cur_k(tk, st) != 23 && cur_k(tk, st) != 0 && st[1] == 0 {
        x_parse_stmt(src, tk, code, st, sym, fixups, brks, pfixups);
    }
    let _ = expect(tk, st, 23, 411);
    return 0;
}

fn x_parse_stmt(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>, fixups: &mut Vec<i64>, brks: &mut Vec<i64>, pfixups: &mut Vec<i64>) -> i64 {
    if st[1] != 0 { return 0; }
    let k: i64 = cur_k(tk, st);
    if k == 11 {
        let ln: i64 = cur_ln(tk, st);
        adv(tk, st);
        if cur_k(tk, st) == 12 { adv(tk, st); }
        let ni: i64 = expect(tk, st, 1, 420);
        let ns: i64 = tk_start(tk, ni);
        let nl: i64 = tk_len(tk, ni);
        let mut is_arr: i64 = 0;
        let mut arr_len: i64 = 0;
        let mut decl_ty: i64 = 0;
        if cur_k(tk, st) == 26 {
            adv(tk, st);
            if cur_k(tk, st) == 29 {
                // Fixed stack array type: [i64; N]
                adv(tk, st);
                let _ = parse_type_id(src, tk, st, sym);
                let _ = expect(tk, st, 25, 440);
                let li: i64 = expect(tk, st, 2, 441);
                arr_len = parse_int_val(src, tk_start(tk, li), tk_len(tk, li));
                let _ = expect(tk, st, 45, 442);
                is_arr = 1;
            } else {
                decl_ty = parse_type_id(src, tk, st, sym);
            }
        }
        let _ = expect(tk, st, 35, 421);
        if is_arr != 0 {
            let _ = expect(tk, st, 29, 443);
            let _ = x_parse_expr(src, tk, code, st, sym, fixups); // init val in rax
            let _ = expect(tk, st, 25, 444);
            let li2: i64 = expect(tk, st, 2, 445);
            let init_len: i64 = parse_int_val(src, tk_start(tk, li2), tk_len(tk, li2));
            let _ = expect(tk, st, 45, 446);
            let _ = expect(tk, st, 25, 447);
            if init_len != arr_len || arr_len <= 0 {
                set_err(st, ln, 609);
                return 0;
            }
            st[12] = st[12] + arr_len;
            let base_disp: i64 = 0 - (st[12] * 8);
            sym_push(sym, 9, st[6], ns, nl, base_disp, arr_len);
            // lea rdi, [rbp + base_disp]; mov rcx, arr_len; cld; rep stosq
            code.push(72 as u8); code.push(141 as u8); code.push(189 as u8);
            emit_u32_le(code, base_disp);
            code.push(72 as u8); code.push(199 as u8); code.push(193 as u8);
            emit_u32_le(code, arr_len);
            code.push(252 as u8);
            code.push(243 as u8); code.push(72 as u8); code.push(171 as u8);
            return 0;
        }
        let rhs_ty: i64 = x_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 25, 423);
        if decl_ty != 0 && rhs_ty != 0 && decl_ty != rhs_ty {
            set_err(st, ln, 601);
            return 0;
        }
        if nl == 1 && (src[ns as usize] as i64) == 95 {
            return 0;
        }
        st[12] = st[12] + 1;
        let disp: i64 = 0 - (st[12] * 8);
        sym_push(sym, 8, st[6], ns, nl, disp, 1);
        x_emit_store_slot(code, disp);
        return 0;
    }
    if k == 13 {
        adv(tk, st);
        let _ = x_parse_expr(src, tk, code, st, sym, fixups);
        code.push(72 as u8); code.push(133 as u8); code.push(192 as u8);
        code.push(15 as u8); code.push(132 as u8);
        let p_else: i64 = code.len() as i64;
        emit_u32_le(code, 0);
        x_parse_block(src, tk, code, st, sym, fixups, brks, pfixups);
        if cur_k(tk, st) == 14 {
            adv(tk, st);
            code.push(233 as u8);
            let p_end: i64 = code.len() as i64;
            emit_u32_le(code, 0);
            let l_else: i64 = code.len() as i64;
            patch_u32_le(code, p_else, l_else - (p_else + 4));
            if cur_k(tk, st) == 13 {
                x_parse_stmt(src, tk, code, st, sym, fixups, brks, pfixups);
            } else {
                x_parse_block(src, tk, code, st, sym, fixups, brks, pfixups);
            }
            let l_end: i64 = code.len() as i64;
            patch_u32_le(code, p_end, l_end - (p_end + 4));
        } else {
            let l_end: i64 = code.len() as i64;
            patch_u32_le(code, p_else, l_end - (p_else + 4));
        }
        return 0;
    }
    if k == 15 {
        adv(tk, st);
        let l_start: i64 = code.len() as i64;
        let _ = x_parse_expr(src, tk, code, st, sym, fixups);
        code.push(72 as u8); code.push(133 as u8); code.push(192 as u8);
        code.push(15 as u8); code.push(132 as u8);
        let p_end: i64 = code.len() as i64;
        emit_u32_le(code, 0);
        let saved_lid: i64 = st[11];
        st[14] = st[14] + 1;
        let my_lid: i64 = st[14];
        st[11] = my_lid;
        x_parse_block(src, tk, code, st, sym, fixups, brks, pfixups);
        st[11] = saved_lid;
        code.push(233 as u8);
        let jmp_after: i64 = (code.len() as i64) + 4;
        emit_u32_le(code, l_start - jmp_after);
        let l_end: i64 = code.len() as i64;
        patch_u32_le(code, p_end, l_end - (p_end + 4));
        let nb: i64 = (brks.len() as i64) / 2;
        let mut bi: i64 = 0;
        while bi < nb {
            if brks[(bi * 2) as usize] == my_lid {
                let bp: i64 = brks[(bi * 2 + 1) as usize];
                patch_u32_le(code, bp, l_end - (bp + 4));
            }
            bi = bi + 1;
        }
        return 0;
    }
    if k == 50 {
        let ln: i64 = cur_ln(tk, st);
        adv(tk, st);
        let _ = expect(tk, st, 25, 424);
        if st[11] <= 0 {
            set_err(st, ln, 435);
            return 0;
        }
        code.push(233 as u8);
        let bp: i64 = code.len() as i64;
        emit_u32_le(code, 0);
        brks.push(st[11]);
        brks.push(bp);
        return 0;
    }
    if k == 16 {
        adv(tk, st);
        if cur_k(tk, st) == 25 {
            adv(tk, st);
            code.push(49 as u8); code.push(192 as u8);
            x_emit_epilogue(code);
            return 0;
        }
        let _ = x_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 25, 425);
        x_emit_epilogue(code);
        return 0;
    }
    if k == 19 {
        x_parse_println(src, tk, code, st, sym, fixups, pfixups);
        return 0;
    }
    if k == 1 && tk_kind(tk, st[0] + 1) == 35 {
        let ln: i64 = cur_ln(tk, st);
        let ns: i64 = cur_s(tk, st);
        let nl: i64 = cur_l(tk, st);
        let disp: i64 = x_find_slot(src, sym, st[6], ns, nl);
        if disp == 0 {
            set_err(st, ln, 608);
            return 0;
        }
        adv(tk, st);
        adv(tk, st);
        let _ = x_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 25, 426);
        x_emit_store_slot(code, disp);
        return 0;
    }
    if k == 1 && tk_kind(tk, st[0] + 1) == 29 {
        let ln: i64 = cur_ln(tk, st);
        let ns: i64 = cur_s(tk, st);
        let nl: i64 = cur_l(tk, st);
        let base_disp: i64 = x_find_array_base(src, sym, st[6], ns, nl);
        if base_disp == 0 {
            set_err(st, ln, 608);
            return 0;
        }
        adv(tk, st);
        adv(tk, st);
        let _ = x_parse_expr(src, tk, code, st, sym, fixups);
        code.push(80 as u8); // push rax (index)
        let _ = expect(tk, st, 45, 448);
        let _ = expect(tk, st, 35, 449);
        let _ = x_parse_expr(src, tk, code, st, sym, fixups); // value in rax
        let _ = expect(tk, st, 25, 427);
        code.push(90 as u8); // pop rdx (index)
        // lea rcx, [rbp + base_disp]; mov [rcx + rdx*8], rax
        code.push(72 as u8); code.push(141 as u8); code.push(141 as u8);
        emit_u32_le(code, base_disp);
        code.push(72 as u8); code.push(137 as u8); code.push(4 as u8); code.push(209 as u8);
        return 0;
    }
    let _ = x_parse_expr(src, tk, code, st, sym, fixups);
    if cur_k(tk, st) == 25 {
        adv(tk, st);
        return 0;
    }
    set_err(st, cur_ln(tk, st), 428);
    return 0;
}

fn x_parse_fn_header(src: &Vec<u8>, tk: &Vec<i64>, st: &mut Vec<i64>, sym: &mut Vec<i64>, fidx: i64, is_pass1: i64) -> i64 {
    let _ = expect(tk, st, 10, 501);
    let fi: i64 = expect(tk, st, 1, 502);
    let fs: i64 = tk_start(tk, fi);
    let fl: i64 = tk_len(tk, fi);
    let is_m: i64 = kw_main(src, fs, fl);
    let _ = expect(tk, st, 20, 503);
    let mut pstarts: Vec<i64> = Vec::new();
    let mut plens: Vec<i64> = Vec::new();
    let mut pcount: i64 = 0;
    while cur_k(tk, st) != 21 && cur_k(tk, st) != 0 && st[1] == 0 {
        if pcount > 0 {
            let _ = expect(tk, st, 24, 504);
        }
        let pi: i64 = expect(tk, st, 1, 505);
        let _ = expect(tk, st, 26, 506);
        let _ = parse_type_id(src, tk, st, sym);
        pstarts.push(tk_start(tk, pi));
        plens.push(tk_len(tk, pi));
        pcount = pcount + 1;
    }
    let _ = expect(tk, st, 21, 507);
    let mut ret_ty: i64 = 1;
    if cur_k(tk, st) == 27 {
        adv(tk, st);
        ret_ty = parse_type_id(src, tk, st, sym);
    }
    if cur_k(tk, st) == 28 {
        adv(tk, st);
        let _ = expect(tk, st, 1, 508);
        while cur_k(tk, st) == 30 && st[1] == 0 {
            adv(tk, st);
            let _ = expect(tk, st, 1, 509);
        }
    }
    if is_pass1 != 0 {
        sym_push(sym, 5, fidx, fs, fl, pcount, ret_ty);
    } else {
        let mut pi2: i64 = 0;
        while pi2 < pcount {
            let disp: i64 = 16 + 8 * (pcount - 1 - pi2);
            sym_push(sym, 8, fidx, pstarts[pi2 as usize], plens[pi2 as usize], disp, 1);
            pi2 = pi2 + 1;
        }
        st[4] = is_m;
        st[6] = fidx;
        st[11] = 0;
        st[12] = 1;
    }
    return is_m;
}

fn compile_x64_body(src: &Vec<u8>, fn_code: &mut Vec<u8>, pfixups: &mut Vec<i64>, st: &mut Vec<i64>) -> i64 {
    let mut tk: Vec<i64> = Vec::new();
    let mut sym: Vec<i64> = Vec::new();
    lex_source(src, &mut tk, st);
    if st[1] != 0 { return 0; }
    if cur_k(&tk, st) == 0 {
        set_err(st, 1, 100);
        return 0;
    }
    let mut n_funcs: i64 = 0;
    let mut main_fidx: i64 = -1;
    st[0] = 0;
    while cur_k(&tk, st) != 0 && st[1] == 0 {
        let is_m: i64 = x_parse_fn_header(src, &tk, st, &mut sym, n_funcs, 1);
        if is_m != 0 { main_fidx = n_funcs; }
        skip_block(&tk, st);
        n_funcs = n_funcs + 1;
    }
    if st[1] != 0 { return 0; }
    if main_fidx < 0 {
        set_err(st, 1, 540);
        return 0;
    }

    let mut fn_offs: Vec<i64> = Vec::new();
    let mut fixups: Vec<i64> = Vec::new();
    let mut brks: Vec<i64> = Vec::new();
    let mut fidx: i64 = 0;
    st[0] = 0;
    while cur_k(&tk, st) != 0 && st[1] == 0 {
        fn_offs.push(fn_code.len() as i64);
        let is_m: i64 = x_parse_fn_header(src, &tk, st, &mut sym, fidx, 0);
        fn_code.push(85 as u8);
        fn_code.push(72 as u8); fn_code.push(137 as u8); fn_code.push(229 as u8);
        fn_code.push(72 as u8); fn_code.push(129 as u8); fn_code.push(236 as u8);
        let p_frame: i64 = fn_code.len() as i64;
        emit_u32_le(fn_code, 0);
        if is_m != 0 {
            fn_code.push(49 as u8); fn_code.push(192 as u8);
            x_emit_store_slot(fn_code, -8);
        }
        x_parse_block(src, &tk, fn_code, st, &mut sym, &mut fixups, &mut brks, pfixups);
        let frame_bytes: i64 = align_up(st[12] * 8, 16);
        patch_u32_le(fn_code, p_frame, frame_bytes);
        if is_m != 0 {
            x_emit_load_slot(fn_code, -8);
        } else {
            fn_code.push(49 as u8); fn_code.push(192 as u8);
        }
        x_emit_epilogue(fn_code);
        fidx = fidx + 1;
    }
    if st[1] != 0 { return 0; }

    let nfix: i64 = (fixups.len() as i64) / 2;
    let mut fi: i64 = 0;
    while fi < nfix {
        let ppos: i64 = fixups[(fi * 2) as usize];
        let tfid: i64 = fixups[(fi * 2 + 1) as usize];
        let target_off: i64 = fn_offs[tfid as usize];
        patch_u32_le(fn_code, ppos, target_off - (ppos + 4));
        fi = fi + 1;
    }
    st[15] = fn_offs[main_fidx as usize];
    return tk_count(&tk);
}

fn wrap_pe32plus_io(spec: TargetSpec, fn_code: &Vec<u8>, pfixups: &Vec<i64>, main_off: i64, out: &mut Vec<u8>) -> i64 {
    let mut text: Vec<u8> = Vec::new();
    // 1. _start stub (18 bytes)
    text.push(72 as u8); text.push(131 as u8); text.push(236 as u8); text.push(40 as u8); // sub rsp, 0x28
    text.push(232 as u8);
    let p_main: i64 = text.len() as i64;
    emit_u32_le(&mut text, 0);
    text.push(137 as u8); text.push(193 as u8); // mov ecx, eax
    text.push(255 as u8); text.push(21 as u8);  // call [rip + iat_exit]
    let p_exit_iat: i64 = text.len() as i64;
    emit_u32_le(&mut text, 0);
    text.push(204 as u8); // int3

    // 2. Windows write_stdout(rsi=buf_ptr, rdx=buf_len) via GetStdHandle(-11) + WriteFile
    let write_stdout_off: i64 = text.len() as i64;
    text.push(85 as u8);                                                  // push rbp
    text.push(72 as u8); text.push(137 as u8); text.push(229 as u8);      // mov rbp, rsp
    text.push(72 as u8); text.push(131 as u8); text.push(236 as u8); text.push(64 as u8); // sub rsp, 0x40
    text.push(72 as u8); text.push(137 as u8); text.push(117 as u8); text.push(240 as u8); // mov [rbp-16], rsi
    text.push(72 as u8); text.push(137 as u8); text.push(85 as u8); text.push(232 as u8);  // mov [rbp-24], rdx
    text.push(185 as u8); emit_u32_le(&mut text, -11);                    // mov ecx, -11 (STD_OUTPUT_HANDLE)
    text.push(255 as u8); text.push(21 as u8);                            // call [rip + iat_stdh]
    let p_stdh_iat: i64 = text.len() as i64;
    emit_u32_le(&mut text, 0);
    text.push(72 as u8); text.push(137 as u8); text.push(193 as u8);      // mov rcx, rax (hStdOut)
    text.push(72 as u8); text.push(139 as u8); text.push(85 as u8); text.push(240 as u8);  // mov rdx, [rbp-16]
    text.push(76 as u8); text.push(139 as u8); text.push(69 as u8); text.push(232 as u8);  // mov r8, [rbp-24]
    text.push(76 as u8); text.push(141 as u8); text.push(77 as u8); text.push(248 as u8);  // lea r9, [rbp-8]
    text.push(72 as u8); text.push(199 as u8); text.push(68 as u8); text.push(36 as u8); text.push(32 as u8);
    emit_u32_le(&mut text, 0);                                            // mov qword [rsp+32], 0
    text.push(255 as u8); text.push(21 as u8);                            // call [rip + iat_wfil]
    let p_wfil_iat: i64 = text.len() as i64;
    emit_u32_le(&mut text, 0);
    x_emit_epilogue(&mut text);

    // 3. Shared __bl_print_i64(rax)
    let print_fn_off: i64 = x_emit_print_i64_helper(&mut text, write_stdout_off);

    // 4. Append OS-independent compiled user function bodies + backpatch calls
    let fn_base: i64 = text.len() as i64;
    emit_slice(&mut text, fn_code, 0, fn_code.len() as i64);
    patch_u32_le(&mut text, p_main, (fn_base + main_off) - (p_main + 4));
    let np: i64 = pfixups.len() as i64;
    let mut pi: i64 = 0;
    while pi < np {
        let pos: i64 = fn_base + pfixups[pi as usize];
        patch_u32_le(&mut text, pos, print_fn_off - (pos + 4));
        pi = pi + 1;
    }

    let text_vsize: i64 = text.len() as i64;
    let text_fsize: i64 = align_up(text_vsize, spec.file_align);
    let text_vpages: i64 = align_up(text_vsize, spec.page_align);
    let rdata_rva: i64 = spec.text_vaddr + text_vpages;
    let image_size: i64 = rdata_rva + spec.page_align;
    let iat_exit_rva: i64 = rdata_rva + 80; // +0x50
    let iat_stdh_rva: i64 = rdata_rva + 88; // +0x58
    let iat_wfil_rva: i64 = rdata_rva + 96; // +0x60

    patch_u32_le(&mut text, p_exit_iat, iat_exit_rva - (spec.text_vaddr + p_exit_iat + 4));
    patch_u32_le(&mut text, p_stdh_iat, iat_stdh_rva - (spec.text_vaddr + p_stdh_iat + 4));
    patch_u32_le(&mut text, p_wfil_iat, iat_wfil_rva - (spec.text_vaddr + p_wfil_iat + 4));

    // PE32+ Headers (512 bytes)
    out.push(77 as u8); out.push(90 as u8);
    emit_zeros(out, 58);
    emit_u32_le(out, 128);
    emit_zeros(out, 64);
    out.push(80 as u8); out.push(69 as u8); out.push(0 as u8); out.push(0 as u8);
    emit_u16_le(out, 34404);
    emit_u16_le(out, 2);
    emit_u32_le(out, 0);
    emit_u32_le(out, 0);
    emit_u32_le(out, 0);
    emit_u16_le(out, 240);
    emit_u16_le(out, 34);
    emit_u16_le(out, 523);
    out.push(1 as u8); out.push(0 as u8);
    emit_u32_le(out, text_fsize);
    emit_u32_le(out, spec.file_align);
    emit_u32_le(out, 0);
    emit_u32_le(out, spec.text_vaddr);
    emit_u32_le(out, spec.text_vaddr);
    emit_u32_le(out, spec.image_base_lo);
    emit_u32_le(out, spec.image_base_hi);
    emit_u32_le(out, spec.page_align);
    emit_u32_le(out, spec.file_align);
    emit_u16_le(out, 6); emit_u16_le(out, 0);
    emit_u16_le(out, 0); emit_u16_le(out, 0);
    emit_u16_le(out, 6); emit_u16_le(out, 0);
    emit_u32_le(out, 0);
    emit_u32_le(out, image_size);
    emit_u32_le(out, spec.file_align);
    emit_u32_le(out, 0);
    emit_u16_le(out, 3);
    emit_u16_le(out, 33120);
    emit_i64_le(out, 1048576);
    emit_i64_le(out, 4096);
    emit_i64_le(out, 1048576);
    emit_i64_le(out, 4096);
    emit_u32_le(out, 0);
    emit_u32_le(out, 16);
    emit_u32_le(out, 0); emit_u32_le(out, 0);
    emit_u32_le(out, rdata_rva); emit_u32_le(out, 40);
    emit_zeros(out, 80);
    emit_u32_le(out, iat_exit_rva); emit_u32_le(out, 32); // 3 IAT entries + null = 32 B
    emit_zeros(out, 24);
    out.push(46 as u8); out.push(116 as u8); out.push(101 as u8); out.push(120 as u8);
    out.push(116 as u8); out.push(0 as u8); out.push(0 as u8); out.push(0 as u8);
    emit_u32_le(out, text_vsize);
    emit_u32_le(out, spec.text_vaddr);
    emit_u32_le(out, text_fsize);
    emit_u32_le(out, spec.file_align);
    emit_zeros(out, 12);
    emit_u32_le(out, 1610612768);
    out.push(46 as u8); out.push(114 as u8); out.push(100 as u8); out.push(97 as u8);
    out.push(116 as u8); out.push(97 as u8); out.push(0 as u8); out.push(0 as u8);
    emit_u32_le(out, 256);
    emit_u32_le(out, rdata_rva);
    emit_u32_le(out, spec.file_align);
    emit_u32_le(out, spec.file_align + text_fsize);
    emit_zeros(out, 12);
    emit_u32_le(out, 1073741888);
    emit_zeros(out, spec.file_align - (out.len() as i64));

    // .text payload
    emit_slice(out, &text, 0, text_vsize);
    emit_zeros(out, text_fsize - text_vsize);

    // .rdata payload (512 bytes): KERNEL32.dll importing ExitProcess, GetStdHandle, WriteFile
    let rdata_start: i64 = out.len() as i64;
    // +0x00 Import Descriptor #0
    emit_u32_le(out, rdata_rva + 48);  // ILT (+0x30)
    emit_u32_le(out, 0);
    emit_u32_le(out, 0);
    emit_u32_le(out, rdata_rva + 128); // Name (+0x80)
    emit_u32_le(out, rdata_rva + 80);  // IAT (+0x50)
    // +0x14 Null descriptor + pad -> +0x30 (28 bytes)
    emit_zeros(out, 28);
    // +0x30 ILT (32 bytes)
    emit_i64_le(out, rdata_rva + 144); // +0x90 ExitProcess
    emit_i64_le(out, rdata_rva + 160); // +0xA0 GetStdHandle
    emit_i64_le(out, rdata_rva + 176); // +0xB0 WriteFile
    emit_i64_le(out, 0);
    // +0x50 IAT (32 bytes)
    emit_i64_le(out, rdata_rva + 144);
    emit_i64_le(out, rdata_rva + 160);
    emit_i64_le(out, rdata_rva + 176);
    emit_i64_le(out, 0);
    // +0x70 pad -> +0x80 (16 bytes)
    emit_zeros(out, 16);
    // +0x80 "KERNEL32.dll\0" (16 bytes)
    emit_chunk(out, 14439084362712395);
    emit_chunk(out, 465674972722);
    emit_zeros(out, 4);
    // +0x90 Hint(0) + "ExitProcess\0" (16 bytes)
    emit_u16_le(out, 0);
    emit_chunk(out, 31369412290902085);
    emit_chunk(out, 1936942435);
    emit_zeros(out, 3);
    // +0xA0 Hint(0) + "GetStdHandle\0" (16 bytes)
    emit_u16_le(out, 0);
    emit_chunk(out, 20376649102288199);
    emit_chunk(out, 435610218081);
    emit_zeros(out, 2);
    // +0xB0 Hint(0) + "WriteFile\0" (16 bytes)
    emit_u16_le(out, 0);
    emit_chunk(out, 29632274113327703);
    emit_chunk(out, 25964);
    emit_zeros(out, 5);
    emit_zeros(out, spec.file_align - ((out.len() as i64) - rdata_start));
    return 0;
}

fn wrap_elf64_io(spec: TargetSpec, fn_code: &Vec<u8>, pfixups: &Vec<i64>, main_off: i64, out: &mut Vec<u8>) -> i64 {
    let mut text: Vec<u8> = Vec::new();
    // 1. _start stub (20 bytes)
    text.push(232 as u8);
    let p_main: i64 = text.len() as i64;
    emit_u32_le(&mut text, 0);
    text.push(72 as u8); text.push(137 as u8); text.push(193 as u8); // mov rcx, rax
    text.push(72 as u8); text.push(137 as u8); text.push(207 as u8); // mov rdi, rcx
    text.push(72 as u8); text.push(199 as u8); text.push(192 as u8);
    emit_u32_le(&mut text, spec.exit_syscall);                       // mov rax, 60 (SYS_exit)
    text.push(15 as u8); text.push(5 as u8);                         // syscall

    // 2. Linux write_stdout(rsi=buf_ptr, rdx=buf_len) via syscall 1 (SYS_write, fd=1)
    let write_stdout_off: i64 = text.len() as i64;
    text.push(72 as u8); text.push(199 as u8); text.push(192 as u8);
    emit_u32_le(&mut text, spec.write_syscall);                      // mov rax, 1 (SYS_write)
    text.push(72 as u8); text.push(199 as u8); text.push(199 as u8);
    emit_u32_le(&mut text, 1);                                       // mov rdi, 1 (stdout)
    text.push(15 as u8); text.push(5 as u8);                         // syscall
    text.push(195 as u8);                                            // ret

    // 3. Shared __bl_print_i64(rax)
    let print_fn_off: i64 = x_emit_print_i64_helper(&mut text, write_stdout_off);

    // 4. Append OS-independent compiled user function bodies + backpatch calls
    let fn_base: i64 = text.len() as i64;
    emit_slice(&mut text, fn_code, 0, fn_code.len() as i64);
    patch_u32_le(&mut text, p_main, (fn_base + main_off) - (p_main + 4));
    let np: i64 = pfixups.len() as i64;
    let mut pi: i64 = 0;
    while pi < np {
        let pos: i64 = fn_base + pfixups[pi as usize];
        patch_u32_le(&mut text, pos, print_fn_off - (pos + 4));
        pi = pi + 1;
    }

    let text_len: i64 = text.len() as i64;
    let total_size: i64 = spec.file_align + text_len;

    // ELF64 Header (64 bytes) + PT_LOAD (56 bytes)
    out.push(127 as u8); out.push(69 as u8); out.push(76 as u8); out.push(70 as u8);
    out.push(2 as u8); out.push(1 as u8); out.push(1 as u8); out.push(0 as u8);
    emit_zeros(out, 8);
    emit_u16_le(out, 2);
    emit_u16_le(out, 62);
    emit_u32_le(out, 1);
    emit_i64_le(out, spec.text_vaddr);
    emit_i64_le(out, 64);
    emit_i64_le(out, 0);
    emit_u32_le(out, 0);
    emit_u16_le(out, 64);
    emit_u16_le(out, 56);
    emit_u16_le(out, 1);
    emit_u16_le(out, 64);
    emit_u16_le(out, 0);
    emit_u16_le(out, 0);
    emit_u32_le(out, 1);
    emit_u32_le(out, 5);
    emit_i64_le(out, 0);
    emit_i64_le(out, spec.image_base_lo);
    emit_i64_le(out, spec.image_base_lo);
    emit_i64_le(out, total_size);
    emit_i64_le(out, total_size);
    emit_i64_le(out, spec.page_align);
    emit_zeros(out, spec.file_align - (out.len() as i64));
    emit_slice(out, &text, 0, text_len);
    return 0;
}

fn compile_x64_from_table(src: &Vec<u8>, target_id: i64, out: &mut Vec<u8>, st: &mut Vec<i64>) -> i64 {
    let mut fn_code: Vec<u8> = Vec::new();
    let mut pfixups: Vec<i64> = Vec::new();
    let ntok: i64 = compile_x64_body(src, &mut fn_code, &mut pfixups, st);
    if st[1] != 0 { return 0; }
    let spec: TargetSpec = lookup_target_spec(target_id);
    if spec.os_kind == 1 {
        wrap_pe32plus_io(spec, &fn_code, &pfixups, st[15], out);
    } else {
        wrap_elf64_io(spec, &fn_code, &pfixups, st[15], out);
    }
    return ntok;
}


// =========================================================================
// PART D: DIRECT ZERO-C BARE-METAL RISC-V 64 (RV64IM) ELF64 ENCODER
// =========================================================================

fn u_mask(val: i64, m: i64) -> i64 {
    let mut r: i64 = val % m;
    if r < 0 { r = r + m; }
    return r;
}

fn rv_r(code: &mut Vec<u8>, f7: i64, rs2: i64, rs1: i64, f3: i64, rd: i64, op: i64) -> i64 {
    let w: i64 = op + rd * 128 + f3 * 4096 + rs1 * 32768 + rs2 * 1048576 + f7 * 33554432;
    emit_u32_le(code, w);
    return 0;
}

fn rv_i(code: &mut Vec<u8>, imm12: i64, rs1: i64, f3: i64, rd: i64, op: i64) -> i64 {
    let im: i64 = u_mask(imm12, 4096);
    let w: i64 = op + rd * 128 + f3 * 4096 + rs1 * 32768 + im * 1048576;
    emit_u32_le(code, w);
    return 0;
}

fn rv_s(code: &mut Vec<u8>, imm12: i64, rs2: i64, rs1: i64, f3: i64) -> i64 {
    let im: i64 = u_mask(imm12, 4096);
    let lo5: i64 = im % 32;
    let hi7: i64 = im / 32;
    let w: i64 = 35 + lo5 * 128 + f3 * 4096 + rs1 * 32768 + rs2 * 1048576 + hi7 * 33554432;
    emit_u32_le(code, w);
    return 0;
}

fn rv_b(code: &mut Vec<u8>, off13: i64, rs2: i64, rs1: i64, f3: i64) -> i64 {
    let im: i64 = u_mask(off13, 8192);
    let b11: i64 = (im / 2048) % 2;
    let b4_1: i64 = (im / 2) % 16;
    let b10_5: i64 = (im / 32) % 64;
    let b12: i64 = (im / 4096) % 2;
    let w: i64 = 99 + b11 * 128 + b4_1 * 256 + f3 * 4096 + rs1 * 32768 + rs2 * 1048576 + b10_5 * 33554432 + b12 * 2147483648;
    emit_u32_le(code, w);
    return 0;
}

fn rv_u(code: &mut Vec<u8>, imm20: i64, rd: i64, op: i64) -> i64 {
    let hi: i64 = u_mask(imm20, 1048576);
    let w: i64 = op + rd * 128 + hi * 4096;
    emit_u32_le(code, w);
    return 0;
}

fn rv_encode_j(off21: i64, rd: i64) -> i64 {
    let im: i64 = u_mask(off21, 2097152);
    let b19_12: i64 = (im / 4096) % 256;
    let b11: i64 = (im / 2048) % 2;
    let b10_1: i64 = (im / 2) % 1024;
    let b20: i64 = (im / 1048576) % 2;
    return 111 + rd * 128 + b19_12 * 4096 + b11 * 1048576 + b10_1 * 2097152 + b20 * 2147483648;
}

fn rv_j(code: &mut Vec<u8>, off21: i64, rd: i64) -> i64 {
    emit_u32_le(code, rv_encode_j(off21, rd));
    return 0;
}

fn rv_patch_j(code: &mut Vec<u8>, pos: i64, off21: i64, rd: i64) -> i64 {
    patch_u32_le(code, pos, rv_encode_j(off21, rd));
    return 0;
}

fn rv_emit_li(code: &mut Vec<u8>, rd: i64, val: i64) -> i64 {
    if val >= -2048 && val <= 2047 {
        rv_i(code, val, 0, 0, rd, 19); // ADDI rd, x0, val
        return 0;
    }
    let mut lo12: i64 = u_mask(val, 4096);
    if lo12 >= 2048 { lo12 = lo12 - 4096; }
    let hi20: i64 = (val - lo12) / 4096;
    rv_u(code, hi20, rd, 55);          // LUI rd, hi20
    if lo12 != 0 {
        rv_i(code, lo12, rd, 0, rd, 19); // ADDI rd, rd, lo12
    }
    return 0;
}

fn rv_push_a0(code: &mut Vec<u8>) -> i64 {
    rv_i(code, -8, 2, 0, 2, 19);  // ADDI sp, sp, -8
    rv_s(code, 0, 10, 2, 3);      // SD a0, 0(sp)
    return 0;
}

fn rv_pop_reg(code: &mut Vec<u8>, rd: i64) -> i64 {
    rv_i(code, 0, 2, 3, rd, 3);   // LD rd, 0(sp)
    rv_i(code, 8, 2, 0, 2, 19);   // ADDI sp, sp, 8
    return 0;
}

fn rv_emit_load_slot(code: &mut Vec<u8>, disp: i64) -> i64 {
    rv_i(code, disp, 8, 3, 10, 3); // LD a0, disp(fp)
    return 0;
}

fn rv_emit_store_slot(code: &mut Vec<u8>, disp: i64) -> i64 {
    rv_s(code, disp, 10, 8, 3);    // SD a0, disp(fp)
    return 0;
}

fn rv_emit_epilogue(code: &mut Vec<u8>) -> i64 {
    rv_i(code, 0, 8, 0, 2, 19);    // ADDI sp, fp, 0
    rv_i(code, 8, 2, 3, 1, 3);     // LD ra, 8(sp)
    rv_i(code, 0, 2, 3, 8, 3);     // LD fp, 0(sp)
    rv_i(code, 16, 2, 0, 2, 19);   // ADDI sp, sp, 16
    rv_i(code, 0, 1, 0, 0, 103);   // JALR x0, 0(ra) (RET)
    return 0;
}

fn rv_emit_acc_println_val(code: &mut Vec<u8>) -> i64 {
    // [fp - 8] = ([fp - 8] * 131 + a0) & 0x7FFFFFFF
    rv_i(code, -8, 8, 3, 5, 3);    // LD t0, -8(fp)
    rv_emit_li(code, 6, 131);      // LI t1, 131
    rv_r(code, 1, 6, 5, 0, 5, 51); // MUL t0, t0, t1
    rv_r(code, 0, 10, 5, 0, 5, 51);// ADD t0, t0, a0
    rv_emit_li(code, 6, 2147483647);
    rv_r(code, 0, 6, 5, 7, 5, 51); // AND t0, t0, 0x7FFFFFFF
    rv_s(code, -8, 5, 8, 3);       // SD t0, -8(fp)
    return 0;
}

fn rv_emit_print_i64_helper(text: &mut Vec<u8>, write_stdout_off: i64) -> i64 {
    // Pure RV64IM __bl_print_i64(val in a0): decimal ASCII + '\n' -> write_stdout(a1=ptr, a2=len)
    let fn_start: i64 = text.len() as i64;
    rv_i(text, -16, 2, 0, 2, 19);   // ADDI sp, sp, -16
    rv_s(text, 8, 1, 2, 3);         // SD ra, 8(sp)
    rv_s(text, 0, 8, 2, 3);         // SD fp, 0(sp)
    rv_i(text, 0, 2, 0, 8, 19);     // ADDI fp, sp, 0
    rv_i(text, -48, 2, 0, 2, 19);   // ADDI sp, sp, -48
    rv_s(text, -40, 10, 8, 3);      // SD a0, -40(fp) (save signed val)
    rv_b(text, 8, 0, 10, 5);        // BGE a0, x0, +8
    rv_r(text, 32, 10, 0, 0, 10, 51); // SUB a0, x0, a0 (negate)
    rv_i(text, -1, 8, 0, 11, 19);   // ADDI a1, fp, -1 (buf cursor)
    rv_i(text, 10, 0, 0, 5, 19);    // ADDI t0, x0, '\n'
    rv_s(text, 0, 5, 11, 0);        // SB t0, 0(a1)
    rv_i(text, 10, 0, 0, 6, 19);    // ADDI t1, x0, 10
    // Digit loop (6 instructions = 24 bytes; BNE branches back -20 bytes to ADDI a1, a1, -1)
    rv_i(text, -1, 11, 0, 11, 19);  // ADDI a1, a1, -1   (-20)
    rv_r(text, 1, 6, 10, 7, 7, 51); // REMU t2, a0, t1   (-16)
    rv_r(text, 1, 6, 10, 5, 10, 51);// DIVU a0, a0, t1   (-12)
    rv_i(text, 48, 7, 0, 7, 19);    // ADDI t2, t2, 48   (-8)
    rv_s(text, 0, 7, 11, 0);        // SB t2, 0(a1)      (-4)
    rv_b(text, -20, 0, 10, 1);      // BNE a0, x0, -20   (0)
    // Sign check
    rv_i(text, -40, 8, 3, 5, 3);    // LD t0, -40(fp)
    rv_b(text, 16, 0, 5, 5);        // BGE t0, x0, +16 (skips 3 instrs = 12 B)
    rv_i(text, -1, 11, 0, 11, 19);  // ADDI a1, a1, -1
    rv_i(text, 45, 0, 0, 7, 19);    // ADDI t2, x0, '-'
    rv_s(text, 0, 7, 11, 0);        // SB t2, 0(a1)
    // a2 = fp - a1 (length)
    rv_r(text, 32, 11, 8, 0, 12, 51); // SUB a2, fp, a1
    let call_pc: i64 = text.len() as i64;
    rv_j(text, write_stdout_off - call_pc, 1); // JAL ra, write_stdout
    rv_emit_epilogue(text);
    return fn_start;
}

fn rv_parse_primary(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    if st[1] != 0 { return 0; }
    let k: i64 = cur_k(tk, st);
    if k == 2 {
        let v: i64 = parse_int_val(src, cur_s(tk, st), cur_l(tk, st));
        adv(tk, st);
        rv_emit_li(code, 10, v);
        return 1;
    }
    if k == 17 {
        adv(tk, st);
        rv_emit_li(code, 10, 1);
        return 2;
    }
    if k == 18 {
        adv(tk, st);
        rv_emit_li(code, 10, 0);
        return 2;
    }
    if k == 20 {
        adv(tk, st);
        let ty: i64 = rv_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 21, 301);
        return ty;
    }
    if k == 1 {
        let ln: i64 = cur_ln(tk, st);
        let s: i64 = cur_s(tk, st);
        let l: i64 = cur_l(tk, st);
        adv(tk, st);
        if cur_k(tk, st) == 20 {
            adv(tk, st);
            let fentry: i64 = find_fn_idx(src, sym, s, l);
            let mut argc: i64 = 0;
            while cur_k(tk, st) != 21 && cur_k(tk, st) != 0 && st[1] == 0 {
                if argc > 0 { let _ = expect(tk, st, 24, 306); }
                let _ = rv_parse_expr(src, tk, code, st, sym, fixups);
                rv_push_a0(code);
                argc = argc + 1;
            }
            let _ = expect(tk, st, 21, 307);
            if fentry < 0 { set_err(st, ln, 607); return 0; }
            let fidx: i64 = sym[(fentry * 6 + 1) as usize];
            let exp_ar: i64 = sym[(fentry * 6 + 4) as usize];
            if argc != exp_ar { set_err(st, ln, 603); return 0; }
            let ppos: i64 = code.len() as i64;
            rv_j(code, 0, 1); // JAL ra, target (backpatched)
            fixups.push(ppos);
            fixups.push(fidx);
            if argc > 0 {
                rv_i(code, argc * 8, 2, 0, 2, 19); // ADDI sp, sp, argc*8
            }
            return sym[(fentry * 6 + 5) as usize];
        }
        if cur_k(tk, st) == 29 {
            adv(tk, st);
            let base_disp: i64 = x_find_array_base(src, sym, st[6], s, l);
            if base_disp == 0 { set_err(st, ln, 608); return 0; }
            let _ = rv_parse_expr(src, tk, code, st, sym, fixups);
            let _ = expect(tk, st, 45, 310);
            rv_i(code, base_disp, 8, 0, 5, 19); // ADDI t0, fp, base_disp
            rv_i(code, 3, 10, 1, 10, 19);       // SLLI a0, a0, 3
            rv_r(code, 0, 10, 5, 0, 5, 51);     // ADD t0, t0, a0
            rv_i(code, 0, 5, 3, 10, 3);         // LD a0, 0(t0)
            return 1;
        }
        let disp: i64 = x_find_slot(src, sym, st[6], s, l);
        if disp == 0 { set_err(st, ln, 608); return 0; }
        rv_emit_load_slot(code, disp);
        return 1;
    }
    set_err(st, cur_ln(tk, st), 308);
    return 0;
}

fn rv_parse_unary(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    if cur_k(tk, st) == 31 {
        adv(tk, st);
        let _ = rv_parse_unary(src, tk, code, st, sym, fixups);
        rv_r(code, 32, 10, 0, 0, 10, 51); // SUB a0, x0, a0
        return 1;
    }
    if cur_k(tk, st) == 44 {
        adv(tk, st);
        let _ = rv_parse_unary(src, tk, code, st, sym, fixups);
        rv_i(code, 1, 10, 3, 10, 19);     // SLTIU a0, a0, 1 (seqz)
        return 2;
    }
    let ty: i64 = rv_parse_primary(src, tk, code, st, sym, fixups);
    while cur_k(tk, st) == 51 && st[1] == 0 {
        adv(tk, st);
        let _ = expect(tk, st, 1, 316);
    }
    return ty;
}

fn rv_parse_mul(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = rv_parse_unary(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 32 || cur_k(tk, st) == 33 || cur_k(tk, st) == 34) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        rv_push_a0(code);
        let _ = rv_parse_unary(src, tk, code, st, sym, fixups);
        rv_pop_reg(code, 5); // t0 = lhs, a0 = rhs
        if op == 32 { rv_r(code, 1, 10, 5, 0, 10, 51); }      // MUL a0, t0, a0
        else if op == 33 { rv_r(code, 1, 10, 5, 4, 10, 51); } // DIV a0, t0, a0
        else { rv_r(code, 1, 10, 5, 6, 10, 51); }             // REM a0, t0, a0
        ty = 1;
    }
    return ty;
}

fn rv_parse_add(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = rv_parse_mul(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 30 || cur_k(tk, st) == 31) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        rv_push_a0(code);
        let _ = rv_parse_mul(src, tk, code, st, sym, fixups);
        rv_pop_reg(code, 5); // t0 = lhs, a0 = rhs
        if op == 30 { rv_r(code, 0, 10, 5, 0, 10, 51); }  // ADD a0, t0, a0
        else { rv_r(code, 32, 10, 5, 0, 10, 51); }        // SUB a0, t0, a0
        ty = 1;
    }
    return ty;
}

fn rv_parse_cmp(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = rv_parse_add(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 38 || cur_k(tk, st) == 39 || cur_k(tk, st) == 40 || cur_k(tk, st) == 41) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        rv_push_a0(code);
        let _ = rv_parse_add(src, tk, code, st, sym, fixups);
        rv_pop_reg(code, 5); // t0 = lhs, a0 = rhs
        if op == 38 {
            rv_r(code, 0, 10, 5, 2, 10, 51); // SLT a0, t0, a0 (lhs < rhs)
        } else if op == 39 {
            rv_r(code, 0, 5, 10, 2, 10, 51); // SLT a0, a0, t0 (rhs < lhs)
            rv_i(code, 1, 10, 4, 10, 19);    // XORI a0, a0, 1 (!(rhs < lhs) == lhs <= rhs)
        } else if op == 40 {
            rv_r(code, 0, 5, 10, 2, 10, 51); // SLT a0, a0, t0 (rhs < lhs == lhs > rhs)
        } else {
            rv_r(code, 0, 10, 5, 2, 10, 51); // SLT a0, t0, a0 (lhs < rhs)
            rv_i(code, 1, 10, 4, 10, 19);    // XORI a0, a0, 1 (lhs >= rhs)
        }
        ty = 2;
    }
    return ty;
}

fn rv_parse_eq(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = rv_parse_cmp(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 36 || cur_k(tk, st) == 37) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        rv_push_a0(code);
        let _ = rv_parse_cmp(src, tk, code, st, sym, fixups);
        rv_pop_reg(code, 5);
        rv_r(code, 32, 10, 5, 0, 10, 51); // SUB a0, t0, a0
        if op == 36 {
            rv_i(code, 1, 10, 3, 10, 19); // SLTIU a0, a0, 1 (seqz)
        } else {
            rv_r(code, 0, 10, 0, 3, 10, 51); // SLTU a0, x0, a0 (snez)
        }
        ty = 2;
    }
    return ty;
}

fn rv_parse_and(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = rv_parse_eq(src, tk, code, st, sym, fixups);
    while st[1] == 0 && cur_k(tk, st) == 42 {
        adv(tk, st);
        rv_b(code, 8, 0, 10, 1); // BNE a0, x0, +8
        let p_false: i64 = code.len() as i64;
        rv_j(code, 0, 0);
        let _ = rv_parse_eq(src, tk, code, st, sym, fixups);
        rv_r(code, 0, 10, 0, 3, 10, 51); // SLTU a0, x0, a0
        let p_done: i64 = code.len() as i64;
        rv_j(code, 0, 0);
        let l_false: i64 = code.len() as i64;
        rv_patch_j(code, p_false, l_false - p_false, 0);
        rv_emit_li(code, 10, 0);
        let l_done: i64 = code.len() as i64;
        rv_patch_j(code, p_done, l_done - p_done, 0);
        ty = 2;
    }
    return ty;
}

fn rv_parse_expr(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = rv_parse_and(src, tk, code, st, sym, fixups);
    while st[1] == 0 && cur_k(tk, st) == 43 {
        adv(tk, st);
        rv_b(code, 8, 0, 10, 0); // BEQ a0, x0, +8
        let p_true: i64 = code.len() as i64;
        rv_j(code, 0, 0);
        let _ = rv_parse_and(src, tk, code, st, sym, fixups);
        rv_r(code, 0, 10, 0, 3, 10, 51);
        let p_done: i64 = code.len() as i64;
        rv_j(code, 0, 0);
        let l_true: i64 = code.len() as i64;
        rv_patch_j(code, p_true, l_true - p_true, 0);
        rv_emit_li(code, 10, 1);
        let l_done: i64 = code.len() as i64;
        rv_patch_j(code, p_done, l_done - p_done, 0);
        ty = 2;
    }
    return ty;
}

fn rv_parse_println(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>, pfixups: &mut Vec<i64>) -> i64 {
    adv(tk, st);
    let _ = expect(tk, st, 20, 401);
    let _ = expect(tk, st, 3, 402);
    while cur_k(tk, st) == 24 && st[1] == 0 {
        adv(tk, st);
        let _ = rv_parse_expr(src, tk, code, st, sym, fixups);
        rv_push_a0(code);
        pfixups.push(code.len() as i64);
        rv_j(code, 0, 1); // JAL ra, __bl_print_i64 (backpatched)
        rv_pop_reg(code, 10);
        rv_emit_acc_println_val(code);
    }
    let _ = expect(tk, st, 21, 403);
    let _ = expect(tk, st, 25, 404);
    return 0;
}

fn rv_parse_block(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>, fixups: &mut Vec<i64>, brks: &mut Vec<i64>, pfixups: &mut Vec<i64>) -> i64 {
    let _ = expect(tk, st, 22, 410);
    while cur_k(tk, st) != 23 && cur_k(tk, st) != 0 && st[1] == 0 {
        rv_parse_stmt(src, tk, code, st, sym, fixups, brks, pfixups);
    }
    let _ = expect(tk, st, 23, 411);
    return 0;
}

fn rv_parse_stmt(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>, fixups: &mut Vec<i64>, brks: &mut Vec<i64>, pfixups: &mut Vec<i64>) -> i64 {
    if st[1] != 0 { return 0; }
    let k: i64 = cur_k(tk, st);
    if k == 11 {
        let ln: i64 = cur_ln(tk, st);
        adv(tk, st);
        if cur_k(tk, st) == 12 { adv(tk, st); }
        let ni: i64 = expect(tk, st, 1, 420);
        let ns: i64 = tk_start(tk, ni);
        let nl: i64 = tk_len(tk, ni);
        let mut is_arr: i64 = 0;
        let mut arr_len: i64 = 0;
        let mut decl_ty: i64 = 0;
        if cur_k(tk, st) == 26 {
            adv(tk, st);
            if cur_k(tk, st) == 29 {
                adv(tk, st);
                let _ = parse_type_id(src, tk, st, sym);
                let _ = expect(tk, st, 25, 440);
                let li: i64 = expect(tk, st, 2, 441);
                arr_len = parse_int_val(src, tk_start(tk, li), tk_len(tk, li));
                let _ = expect(tk, st, 45, 442);
                is_arr = 1;
            } else {
                decl_ty = parse_type_id(src, tk, st, sym);
            }
        }
        let _ = expect(tk, st, 35, 421);
        if is_arr != 0 {
            let _ = expect(tk, st, 29, 443);
            let _ = rv_parse_expr(src, tk, code, st, sym, fixups); // init val in a0
            let _ = expect(tk, st, 25, 444);
            let li2: i64 = expect(tk, st, 2, 445);
            let init_len: i64 = parse_int_val(src, tk_start(tk, li2), tk_len(tk, li2));
            let _ = expect(tk, st, 45, 446);
            let _ = expect(tk, st, 25, 447);
            if init_len != arr_len || arr_len <= 0 { set_err(st, ln, 609); return 0; }
            st[12] = st[12] + arr_len;
            let base_disp: i64 = 0 - (st[12] * 8);
            sym_push(sym, 9, st[6], ns, nl, base_disp, arr_len);
            // RV64IM inline init loop: t0 = fp + base_disp, t1 = arr_len
            rv_i(code, base_disp, 8, 0, 5, 19); // ADDI t0, fp, base_disp
            rv_emit_li(code, 6, arr_len);       // LI t1, arr_len
            // loop (4 instrs = 16 B): SD a0, 0(t0); ADDI t0, t0, 8; ADDI t1, t1, -1; BNE t1, x0, -12
            rv_s(code, 0, 10, 5, 3);
            rv_i(code, 8, 5, 0, 5, 19);
            rv_i(code, -1, 6, 0, 6, 19);
            rv_b(code, -12, 0, 6, 1);
            return 0;
        }
        let rhs_ty: i64 = rv_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 25, 423);
        if decl_ty != 0 && rhs_ty != 0 && decl_ty != rhs_ty { set_err(st, ln, 601); return 0; }
        if nl == 1 && (src[ns as usize] as i64) == 95 { return 0; }
        st[12] = st[12] + 1;
        let disp: i64 = 0 - (st[12] * 8);
        sym_push(sym, 8, st[6], ns, nl, disp, 1);
        rv_emit_store_slot(code, disp);
        return 0;
    }
    if k == 13 {
        adv(tk, st);
        let _ = rv_parse_expr(src, tk, code, st, sym, fixups);
        rv_b(code, 8, 0, 10, 1); // BNE a0, x0, +8
        let p_else: i64 = code.len() as i64;
        rv_j(code, 0, 0);
        rv_parse_block(src, tk, code, st, sym, fixups, brks, pfixups);
        if cur_k(tk, st) == 14 {
            adv(tk, st);
            let p_end: i64 = code.len() as i64;
            rv_j(code, 0, 0);
            let l_else: i64 = code.len() as i64;
            rv_patch_j(code, p_else, l_else - p_else, 0);
            if cur_k(tk, st) == 13 {
                rv_parse_stmt(src, tk, code, st, sym, fixups, brks, pfixups);
            } else {
                rv_parse_block(src, tk, code, st, sym, fixups, brks, pfixups);
            }
            let l_end: i64 = code.len() as i64;
            rv_patch_j(code, p_end, l_end - p_end, 0);
        } else {
            let l_end: i64 = code.len() as i64;
            rv_patch_j(code, p_else, l_end - p_else, 0);
        }
        return 0;
    }
    if k == 15 {
        adv(tk, st);
        let l_start: i64 = code.len() as i64;
        let _ = rv_parse_expr(src, tk, code, st, sym, fixups);
        rv_b(code, 8, 0, 10, 1); // BNE a0, x0, +8
        let p_end: i64 = code.len() as i64;
        rv_j(code, 0, 0);
        let saved_lid: i64 = st[11];
        st[14] = st[14] + 1;
        let my_lid: i64 = st[14];
        st[11] = my_lid;
        rv_parse_block(src, tk, code, st, sym, fixups, brks, pfixups);
        st[11] = saved_lid;
        let jmp_pc: i64 = code.len() as i64;
        rv_j(code, l_start - jmp_pc, 0);
        let l_end: i64 = code.len() as i64;
        rv_patch_j(code, p_end, l_end - p_end, 0);
        let nb: i64 = (brks.len() as i64) / 2;
        let mut bi: i64 = 0;
        while bi < nb {
            if brks[(bi * 2) as usize] == my_lid {
                let bp: i64 = brks[(bi * 2 + 1) as usize];
                rv_patch_j(code, bp, l_end - bp, 0);
            }
            bi = bi + 1;
        }
        return 0;
    }
    if k == 50 {
        let ln: i64 = cur_ln(tk, st);
        adv(tk, st);
        let _ = expect(tk, st, 25, 424);
        if st[11] <= 0 { set_err(st, ln, 435); return 0; }
        let bp: i64 = code.len() as i64;
        rv_j(code, 0, 0);
        brks.push(st[11]);
        brks.push(bp);
        return 0;
    }
    if k == 16 {
        adv(tk, st);
        if cur_k(tk, st) == 25 {
            adv(tk, st);
            rv_emit_li(code, 10, 0);
            rv_emit_epilogue(code);
            return 0;
        }
        let _ = rv_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 25, 425);
        rv_emit_epilogue(code);
        return 0;
    }
    if k == 19 {
        rv_parse_println(src, tk, code, st, sym, fixups, pfixups);
        return 0;
    }
    if k == 1 && tk_kind(tk, st[0] + 1) == 35 {
        let ln: i64 = cur_ln(tk, st);
        let ns: i64 = cur_s(tk, st);
        let nl: i64 = cur_l(tk, st);
        let disp: i64 = x_find_slot(src, sym, st[6], ns, nl);
        if disp == 0 { set_err(st, ln, 608); return 0; }
        adv(tk, st);
        adv(tk, st);
        let _ = rv_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 25, 426);
        rv_emit_store_slot(code, disp);
        return 0;
    }
    if k == 1 && tk_kind(tk, st[0] + 1) == 29 {
        let ln: i64 = cur_ln(tk, st);
        let ns: i64 = cur_s(tk, st);
        let nl: i64 = cur_l(tk, st);
        let base_disp: i64 = x_find_array_base(src, sym, st[6], ns, nl);
        if base_disp == 0 { set_err(st, ln, 608); return 0; }
        adv(tk, st);
        adv(tk, st);
        let _ = rv_parse_expr(src, tk, code, st, sym, fixups);
        rv_push_a0(code);
        let _ = expect(tk, st, 45, 448);
        let _ = expect(tk, st, 35, 449);
        let _ = rv_parse_expr(src, tk, code, st, sym, fixups); // val in a0
        let _ = expect(tk, st, 25, 427);
        rv_pop_reg(code, 6);                // t1 = index
        rv_i(code, base_disp, 8, 0, 5, 19); // ADDI t0, fp, base_disp
        rv_i(code, 3, 6, 1, 6, 19);         // SLLI t1, t1, 3
        rv_r(code, 0, 6, 5, 0, 5, 51);      // ADD t0, t0, t1
        rv_s(code, 0, 10, 5, 3);            // SD a0, 0(t0)
        return 0;
    }
    let _ = rv_parse_expr(src, tk, code, st, sym, fixups);
    if cur_k(tk, st) == 25 { adv(tk, st); return 0; }
    set_err(st, cur_ln(tk, st), 428);
    return 0;
}

fn compile_rv64_elf(src: &Vec<u8>, out: &mut Vec<u8>, st: &mut Vec<i64>) -> i64 {
    let mut tk: Vec<i64> = Vec::new();
    let mut sym: Vec<i64> = Vec::new();
    lex_source(src, &mut tk, st);
    if st[1] != 0 { return 0; }
    if cur_k(&tk, st) == 0 { set_err(st, 1, 100); return 0; }
    let mut n_funcs: i64 = 0;
    let mut main_fidx: i64 = -1;
    st[0] = 0;
    while cur_k(&tk, st) != 0 && st[1] == 0 {
        let is_m: i64 = x_parse_fn_header(src, &tk, st, &mut sym, n_funcs, 1);
        if is_m != 0 { main_fidx = n_funcs; }
        skip_block(&tk, st);
        n_funcs = n_funcs + 1;
    }
    if st[1] != 0 { return 0; }
    if main_fidx < 0 { set_err(st, 1, 540); return 0; }

    let mut fn_code: Vec<u8> = Vec::new();
    let mut fn_offs: Vec<i64> = Vec::new();
    let mut fixups: Vec<i64> = Vec::new();
    let mut brks: Vec<i64> = Vec::new();
    let mut pfixups: Vec<i64> = Vec::new();
    let mut fidx: i64 = 0;
    st[0] = 0;
    while cur_k(&tk, st) != 0 && st[1] == 0 {
        fn_offs.push(fn_code.len() as i64);
        let is_m: i64 = x_parse_fn_header(src, &tk, st, &mut sym, fidx, 0);
        // RV64IM prologue: ADDI sp,-16; SD ra,8(sp); SD fp,0(sp); ADDI fp,sp,0; ADDI sp,sp,-frame (patched)
        rv_i(&mut fn_code, -16, 2, 0, 2, 19);
        rv_s(&mut fn_code, 8, 1, 2, 3);
        rv_s(&mut fn_code, 0, 8, 2, 3);
        rv_i(&mut fn_code, 0, 2, 0, 8, 19);
        let p_frame: i64 = fn_code.len() as i64;
        rv_i(&mut fn_code, 0, 2, 0, 2, 19);
        if is_m != 0 {
            rv_emit_li(&mut fn_code, 10, 0);
            rv_emit_store_slot(&mut fn_code, -8);
        }
        rv_parse_block(src, &tk, &mut fn_code, st, &mut sym, &mut fixups, &mut brks, &mut pfixups);
        let frame_bytes: i64 = align_up(st[12] * 8, 16);
        let im_f: i64 = u_mask(0 - frame_bytes, 4096);
        patch_u32_le(&mut fn_code, p_frame, 19 + 2 * 128 + 2 * 32768 + im_f * 1048576);
        if is_m != 0 {
            rv_emit_load_slot(&mut fn_code, -8);
        } else {
            rv_emit_li(&mut fn_code, 10, 0);
        }
        rv_emit_epilogue(&mut fn_code);
        fidx = fidx + 1;
    }
    if st[1] != 0 { return 0; }

    let nfix: i64 = (fixups.len() as i64) / 2;
    let mut fi: i64 = 0;
    while fi < nfix {
        let ppos: i64 = fixups[(fi * 2) as usize];
        let tfid: i64 = fixups[(fi * 2 + 1) as usize];
        rv_patch_j(&mut fn_code, ppos, fn_offs[tfid as usize] - ppos, 1);
        fi = fi + 1;
    }
    let main_off: i64 = fn_offs[main_fidx as usize];

    // Row 3 of TargetSpec table: RV64IM ELF64 (EM_RISCV=243, write_syscall=64, exit_syscall=93)
    let mut text: Vec<u8> = Vec::new();
    // 1. _start (12 bytes): JAL ra, main; ADDI a7, x0, 93; ECALL
    let p_main: i64 = text.len() as i64;
    rv_j(&mut text, 0, 1);
    rv_i(&mut text, 93, 0, 0, 17, 19); // a7 = 93 (SYS_exit)
    rv_i(&mut text, 0, 0, 0, 0, 115);  // ECALL

    // 2. write_stdout (16 bytes): ADDI a0, x0, 1 (fd=1); ADDI a7, x0, 64 (SYS_write); ECALL; RET
    let write_stdout_off: i64 = text.len() as i64;
    rv_i(&mut text, 1, 0, 0, 10, 19);
    rv_i(&mut text, 64, 0, 0, 17, 19);
    rv_i(&mut text, 0, 0, 0, 0, 115);
    rv_i(&mut text, 0, 1, 0, 0, 103);

    // 3. __bl_print_i64(a0)
    let print_fn_off: i64 = rv_emit_print_i64_helper(&mut text, write_stdout_off);

    // 4. Append user fn_code + backpatch _start -> main and println -> __bl_print_i64
    let fn_base: i64 = text.len() as i64;
    emit_slice(&mut text, &fn_code, 0, fn_code.len() as i64);
    rv_patch_j(&mut text, p_main, (fn_base + main_off) - p_main, 1);
    let np: i64 = pfixups.len() as i64;
    let mut pi: i64 = 0;
    while pi < np {
        let pos: i64 = fn_base + pfixups[pi as usize];
        rv_patch_j(&mut text, pos, print_fn_off - pos, 1);
        pi = pi + 1;
    }

    // Emit ELF64 (EM_RISCV = 243) header + PT_LOAD + .text
    let text_len: i64 = text.len() as i64;
    let total_size: i64 = 4096 + text_len;
    out.push(127 as u8); out.push(69 as u8); out.push(76 as u8); out.push(70 as u8);
    out.push(2 as u8); out.push(1 as u8); out.push(1 as u8); out.push(0 as u8);
    emit_zeros(out, 8);
    emit_u16_le(out, 2);       // ET_EXEC
    emit_u16_le(out, 243);     // EM_RISCV (243 = 0xF3)
    emit_u32_le(out, 1);       // EV_CURRENT
    emit_i64_le(out, 4198400); // e_entry = 0x401000
    emit_i64_le(out, 64);      // e_phoff
    emit_i64_le(out, 0);       // e_shoff
    emit_u32_le(out, 0);       // e_flags
    emit_u16_le(out, 64);      // e_ehsize
    emit_u16_le(out, 56);      // e_phentsize
    emit_u16_le(out, 1);       // e_phnum = 1
    emit_u16_le(out, 64);
    emit_u16_le(out, 0);
    emit_u16_le(out, 0);
    // PT_LOAD
    emit_u32_le(out, 1);
    emit_u32_le(out, 5);       // PF_R | PF_X
    emit_i64_le(out, 0);
    emit_i64_le(out, 4194304); // 0x400000
    emit_i64_le(out, 4194304);
    emit_i64_le(out, total_size);
    emit_i64_le(out, total_size);
    emit_i64_le(out, 4096);
    emit_zeros(out, 4096 - (out.len() as i64));
    emit_slice(out, &text, 0, text_len);
    return tk_count(&tk);
}


// =========================================================================
// PART E: DIRECT ZERO-C ARM64 AArch64 (A64) ELF64 ENCODER (EM_AARCH64=183)
// =========================================================================

fn a64_movz(code: &mut Vec<u8>, rd: i64, imm16: i64, hw: i64) -> i64 {
    emit_u32_le(code, 3531603968 + hw * 2097152 + u_mask(imm16, 65536) * 32 + rd);
    return 0;
}

fn a64_movn(code: &mut Vec<u8>, rd: i64, imm16: i64, hw: i64) -> i64 {
    emit_u32_le(code, 2457862144 + hw * 2097152 + u_mask(imm16, 65536) * 32 + rd);
    return 0;
}

fn a64_movk(code: &mut Vec<u8>, rd: i64, imm16: i64, hw: i64) -> i64 {
    emit_u32_le(code, 4068474880 + hw * 2097152 + u_mask(imm16, 65536) * 32 + rd);
    return 0;
}

fn a64_emit_li(code: &mut Vec<u8>, rd: i64, val: i64) -> i64 {
    if val >= 0 && val <= 65535 {
        a64_movz(code, rd, val, 0);
        return 0;
    }
    if val >= -65536 && val < 0 {
        a64_movn(code, rd, -1 - val, 0);
        return 0;
    }
    let mut v: i64 = val;
    let mut hw: i64 = 0;
    while hw < 4 {
        let mut chunk: i64 = v % 65536;
        let mut q: i64 = v / 65536;
        if chunk < 0 { chunk = chunk + 65536; q = q - 1; }
        if hw == 0 {
            a64_movz(code, rd, chunk, 0);
        } else if chunk != 0 {
            a64_movk(code, rd, chunk, hw);
        }
        v = q;
        hw = hw + 1;
    }
    return 0;
}

fn a64_add_imm(code: &mut Vec<u8>, rd: i64, rn: i64, imm12: i64) -> i64 {
    emit_u32_le(code, 2432696320 + u_mask(imm12, 4096) * 1024 + rn * 32 + rd);
    return 0;
}

fn a64_sub_imm(code: &mut Vec<u8>, rd: i64, rn: i64, imm12: i64) -> i64 {
    emit_u32_le(code, 3506438144 + u_mask(imm12, 4096) * 1024 + rn * 32 + rd);
    return 0;
}

fn a64_add_reg(code: &mut Vec<u8>, rd: i64, rn: i64, rm: i64) -> i64 {
    emit_u32_le(code, 2332033024 + rm * 65536 + rn * 32 + rd);
    return 0;
}

fn a64_add_reg_lsl3(code: &mut Vec<u8>, rd: i64, rn: i64, rm: i64) -> i64 {
    emit_u32_le(code, 2332036096 + rm * 65536 + rn * 32 + rd);
    return 0;
}

fn a64_sub_reg(code: &mut Vec<u8>, rd: i64, rn: i64, rm: i64) -> i64 {
    emit_u32_le(code, 3405774848 + rm * 65536 + rn * 32 + rd);
    return 0;
}

fn a64_cmp_reg(code: &mut Vec<u8>, rn: i64, rm: i64) -> i64 {
    emit_u32_le(code, 3942645760 + rm * 65536 + rn * 32 + 31); // SUBS xzr, rn, rm
    return 0;
}

fn a64_and_reg(code: &mut Vec<u8>, rd: i64, rn: i64, rm: i64) -> i64 {
    emit_u32_le(code, 2315255808 + rm * 65536 + rn * 32 + rd);
    return 0;
}

fn a64_mul(code: &mut Vec<u8>, rd: i64, rn: i64, rm: i64) -> i64 {
    emit_u32_le(code, 2600500224 + rm * 65536 + rn * 32 + rd);
    return 0;
}

fn a64_sdiv(code: &mut Vec<u8>, rd: i64, rn: i64, rm: i64) -> i64 {
    emit_u32_le(code, 2596277248 + rm * 65536 + rn * 32 + rd);
    return 0;
}

fn a64_udiv(code: &mut Vec<u8>, rd: i64, rn: i64, rm: i64) -> i64 {
    emit_u32_le(code, 2596276224 + rm * 65536 + rn * 32 + rd);
    return 0;
}

fn a64_msub(code: &mut Vec<u8>, rd: i64, rn: i64, rm: i64, ra: i64) -> i64 {
    emit_u32_le(code, 2600501248 + rm * 65536 + ra * 1024 + rn * 32 + rd);
    return 0;
}

fn a64_cset(code: &mut Vec<u8>, rd: i64, inv_cond: i64) -> i64 {
    emit_u32_le(code, 2594113504 + inv_cond * 4096 + rd); // CSINC rd, xzr, xzr, inv_cond
    return 0;
}

fn a64_ldur(code: &mut Vec<u8>, rt: i64, rn: i64, imm9: i64) -> i64 {
    emit_u32_le(code, 4164943872 + u_mask(imm9, 512) * 4096 + rn * 32 + rt);
    return 0;
}

fn a64_stur(code: &mut Vec<u8>, rt: i64, rn: i64, imm9: i64) -> i64 {
    emit_u32_le(code, 4160749568 + u_mask(imm9, 512) * 4096 + rn * 32 + rt);
    return 0;
}

fn a64_strb(code: &mut Vec<u8>, rt: i64, rn: i64) -> i64 {
    emit_u32_le(code, 956301312 + rn * 32 + rt);
    return 0;
}

fn a64_push_x0(code: &mut Vec<u8>) -> i64 {
    emit_u32_le(code, 4162785248); // STR x0, [sp, #-16]!
    return 0;
}

fn a64_pop_reg(code: &mut Vec<u8>, rt: i64) -> i64 {
    emit_u32_le(code, 4165011424 + rt); // LDR rt, [sp], #16
    return 0;
}

fn a64_b(code: &mut Vec<u8>, off_bytes: i64) -> i64 {
    emit_u32_le(code, 335544320 + u_mask(off_bytes / 4, 67108864));
    return 0;
}

fn a64_patch_b(code: &mut Vec<u8>, pos: i64, off_bytes: i64) -> i64 {
    patch_u32_le(code, pos, 335544320 + u_mask(off_bytes / 4, 67108864));
    return 0;
}

fn a64_bl(code: &mut Vec<u8>, off_bytes: i64) -> i64 {
    emit_u32_le(code, 2483027968 + u_mask(off_bytes / 4, 67108864));
    return 0;
}

fn a64_patch_bl(code: &mut Vec<u8>, pos: i64, off_bytes: i64) -> i64 {
    patch_u32_le(code, pos, 2483027968 + u_mask(off_bytes / 4, 67108864));
    return 0;
}

fn a64_cbz(code: &mut Vec<u8>, rt: i64, off_bytes: i64) -> i64 {
    emit_u32_le(code, 3019898880 + u_mask(off_bytes / 4, 524288) * 32 + rt);
    return 0;
}

fn a64_cbnz(code: &mut Vec<u8>, rt: i64, off_bytes: i64) -> i64 {
    emit_u32_le(code, 3036676096 + u_mask(off_bytes / 4, 524288) * 32 + rt);
    return 0;
}

fn a64_emit_load_slot(code: &mut Vec<u8>, disp: i64) -> i64 {
    if disp >= -256 && disp <= 255 {
        a64_ldur(code, 0, 29, disp);
        return 0;
    }
    a64_emit_li(code, 11, disp);
    a64_add_reg(code, 11, 29, 11);
    a64_ldur(code, 0, 11, 0);
    return 0;
}

fn a64_emit_store_slot(code: &mut Vec<u8>, disp: i64) -> i64 {
    if disp >= -256 && disp <= 255 {
        a64_stur(code, 0, 29, disp);
        return 0;
    }
    a64_emit_li(code, 11, disp);
    a64_add_reg(code, 11, 29, 11);
    a64_stur(code, 0, 11, 0);
    return 0;
}

fn a64_emit_epilogue(code: &mut Vec<u8>) -> i64 {
    a64_add_imm(code, 31, 29, 0); // MOV sp, fp
    emit_u32_le(code, 2831252477); // LDP x29, x30, [sp], #16
    emit_u32_le(code, 3596551104); // RET
    return 0;
}

fn a64_emit_acc_println_val(code: &mut Vec<u8>) -> i64 {
    a64_ldur(code, 9, 29, -8);
    a64_emit_li(code, 10, 131);
    a64_mul(code, 9, 9, 10);
    a64_add_reg(code, 9, 9, 0);
    a64_emit_li(code, 10, 2147483647);
    a64_and_reg(code, 9, 9, 10);
    a64_stur(code, 9, 29, -8);
    return 0;
}

fn a64_emit_print_i64_helper(text: &mut Vec<u8>, write_stdout_off: i64) -> i64 {
    // Pure AArch64 __bl_print_i64(val in x0): decimal ASCII + '\n' -> write_stdout(x1=ptr, x2=len)
    let fn_start: i64 = text.len() as i64;
    emit_u32_le(text, 2847898621); // STP x29, x30, [sp, #-16]!
    a64_add_imm(text, 29, 31, 0);  // MOV fp, sp
    a64_sub_imm(text, 31, 31, 48); // SUB sp, sp, #48
    a64_stur(text, 0, 29, -40);    // save signed val at [fp-40]
    a64_cmp_reg(text, 0, 31);      // CMP x0, xzr
    // B.GE +8 (cond=10 -> 0x5400004A = 1409286218)
    emit_u32_le(text, 1409286218);
    a64_sub_reg(text, 0, 31, 0);   // SUB x0, xzr, x0 (negate)
    a64_sub_imm(text, 1, 29, 1);   // x1 = fp - 1
    a64_emit_li(text, 9, 10);      // x9 = '\n'
    a64_strb(text, 9, 1);          // STRB w9, [x1]
    a64_emit_li(text, 10, 10);     // x10 = 10
    // Digit loop (7 instrs = 28 B; CBNZ branches back -24 bytes)
    a64_sub_imm(text, 1, 1, 1);    // SUB x1, x1, #1        (-24)
    a64_udiv(text, 11, 0, 10);     // x11 = x0 / 10         (-20)
    a64_msub(text, 12, 11, 10, 0); // x12 = x0 - x11*10     (-16)
    a64_add_imm(text, 0, 11, 0);   // x0 = x11              (-12)
    a64_add_imm(text, 12, 12, 48); // x12 += '0'            (-8)
    a64_strb(text, 12, 1);         // STRB w12, [x1]        (-4)
    a64_cbnz(text, 0, -24);        // CBNZ x0, -24          (0)
    // Sign check
    a64_ldur(text, 9, 29, -40);
    a64_cmp_reg(text, 9, 31);      // CMP x9, xzr
    // B.GE +16 (skips 3 instrs = 12 B -> imm19=4 -> 0x5400008A = 1409286282)
    emit_u32_le(text, 1409286282);
    a64_sub_imm(text, 1, 1, 1);    // SUB x1, x1, #1
    a64_emit_li(text, 12, 45);     // x12 = '-'
    a64_strb(text, 12, 1);         // STRB w12, [x1]
    // x2 = fp - x1 (len)
    a64_sub_reg(text, 2, 29, 1);
    let call_pc: i64 = text.len() as i64;
    a64_bl(text, write_stdout_off - call_pc);
    a64_emit_epilogue(text);
    return fn_start;
}

fn a64_parse_primary(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    if st[1] != 0 { return 0; }
    let k: i64 = cur_k(tk, st);
    if k == 2 {
        let v: i64 = parse_int_val(src, cur_s(tk, st), cur_l(tk, st));
        adv(tk, st);
        a64_emit_li(code, 0, v);
        return 1;
    }
    if k == 17 { adv(tk, st); a64_emit_li(code, 0, 1); return 2; }
    if k == 18 { adv(tk, st); a64_emit_li(code, 0, 0); return 2; }
    if k == 20 {
        adv(tk, st);
        let ty: i64 = a64_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 21, 301);
        return ty;
    }
    if k == 1 {
        let ln: i64 = cur_ln(tk, st);
        let s: i64 = cur_s(tk, st);
        let l: i64 = cur_l(tk, st);
        adv(tk, st);
        if cur_k(tk, st) == 20 {
            adv(tk, st);
            let fentry: i64 = find_fn_idx(src, sym, s, l);
            let mut argc: i64 = 0;
            while cur_k(tk, st) != 21 && cur_k(tk, st) != 0 && st[1] == 0 {
                if argc > 0 { let _ = expect(tk, st, 24, 306); }
                let _ = a64_parse_expr(src, tk, code, st, sym, fixups);
                a64_push_x0(code);
                argc = argc + 1;
            }
            let _ = expect(tk, st, 21, 307);
            if fentry < 0 { set_err(st, ln, 607); return 0; }
            let fidx: i64 = sym[(fentry * 6 + 1) as usize];
            let exp_ar: i64 = sym[(fentry * 6 + 4) as usize];
            if argc != exp_ar { set_err(st, ln, 603); return 0; }
            let ppos: i64 = code.len() as i64;
            a64_bl(code, 0);
            fixups.push(ppos);
            fixups.push(fidx);
            if argc > 0 { a64_add_imm(code, 31, 31, argc * 16); }
            return sym[(fentry * 6 + 5) as usize];
        }
        if cur_k(tk, st) == 29 {
            adv(tk, st);
            let base_disp: i64 = x_find_array_base(src, sym, st[6], s, l);
            if base_disp == 0 { set_err(st, ln, 608); return 0; }
            let _ = a64_parse_expr(src, tk, code, st, sym, fixups);
            let _ = expect(tk, st, 45, 310);
            a64_emit_li(code, 9, base_disp);
            a64_add_reg(code, 9, 29, 9);
            a64_add_reg_lsl3(code, 9, 9, 0); // x9 = fp + base_disp + x0*8
            a64_ldur(code, 0, 9, 0);
            return 1;
        }
        let disp: i64 = x_find_slot(src, sym, st[6], s, l);
        if disp == 0 { set_err(st, ln, 608); return 0; }
        a64_emit_load_slot(code, disp);
        return 1;
    }
    set_err(st, cur_ln(tk, st), 308);
    return 0;
}

fn a64_parse_unary(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    if cur_k(tk, st) == 31 {
        adv(tk, st);
        let _ = a64_parse_unary(src, tk, code, st, sym, fixups);
        a64_sub_reg(code, 0, 31, 0);
        return 1;
    }
    if cur_k(tk, st) == 44 {
        adv(tk, st);
        let _ = a64_parse_unary(src, tk, code, st, sym, fixups);
        a64_cmp_reg(code, 0, 31);
        a64_cset(code, 0, 1); // EQ -> inv_cond=1 (NE)
        return 2;
    }
    let ty: i64 = a64_parse_primary(src, tk, code, st, sym, fixups);
    while cur_k(tk, st) == 51 && st[1] == 0 {
        adv(tk, st);
        let _ = expect(tk, st, 1, 316);
    }
    return ty;
}

fn a64_parse_mul(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = a64_parse_unary(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 32 || cur_k(tk, st) == 33 || cur_k(tk, st) == 34) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        a64_push_x0(code);
        let _ = a64_parse_unary(src, tk, code, st, sym, fixups);
        a64_pop_reg(code, 9); // x9 = lhs, x0 = rhs
        if op == 32 {
            a64_mul(code, 0, 9, 0);
        } else if op == 33 {
            a64_sdiv(code, 0, 9, 0);
        } else {
            a64_sdiv(code, 10, 9, 0);     // x10 = lhs / rhs
            a64_msub(code, 0, 10, 0, 9);  // x0 = lhs - x10 * rhs
        }
        ty = 1;
    }
    return ty;
}

fn a64_parse_add(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = a64_parse_mul(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 30 || cur_k(tk, st) == 31) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        a64_push_x0(code);
        let _ = a64_parse_mul(src, tk, code, st, sym, fixups);
        a64_pop_reg(code, 9);
        if op == 30 { a64_add_reg(code, 0, 9, 0); }
        else { a64_sub_reg(code, 0, 9, 0); }
        ty = 1;
    }
    return ty;
}

fn a64_parse_cmp(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = a64_parse_add(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 38 || cur_k(tk, st) == 39 || cur_k(tk, st) == 40 || cur_k(tk, st) == 41) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        a64_push_x0(code);
        let _ = a64_parse_add(src, tk, code, st, sym, fixups);
        a64_pop_reg(code, 9);
        a64_cmp_reg(code, 9, 0);
        if op == 38 { a64_cset(code, 0, 10); }      // LT -> inv=GE(10)
        else if op == 39 { a64_cset(code, 0, 12); } // LE -> inv=GT(12)
        else if op == 40 { a64_cset(code, 0, 13); } // GT -> inv=LE(13)
        else { a64_cset(code, 0, 11); }             // GE -> inv=LT(11)
        ty = 2;
    }
    return ty;
}

fn a64_parse_eq(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = a64_parse_cmp(src, tk, code, st, sym, fixups);
    while st[1] == 0 && (cur_k(tk, st) == 36 || cur_k(tk, st) == 37) {
        let op: i64 = cur_k(tk, st);
        adv(tk, st);
        a64_push_x0(code);
        let _ = a64_parse_cmp(src, tk, code, st, sym, fixups);
        a64_pop_reg(code, 9);
        a64_cmp_reg(code, 9, 0);
        if op == 36 { a64_cset(code, 0, 1); } // EQ -> inv=NE(1)
        else { a64_cset(code, 0, 0); }        // NE -> inv=EQ(0)
        ty = 2;
    }
    return ty;
}

fn a64_parse_and(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = a64_parse_eq(src, tk, code, st, sym, fixups);
    while st[1] == 0 && cur_k(tk, st) == 42 {
        adv(tk, st);
        a64_cbnz(code, 0, 8);
        let p_false: i64 = code.len() as i64;
        a64_b(code, 0);
        let _ = a64_parse_eq(src, tk, code, st, sym, fixups);
        a64_cmp_reg(code, 0, 31);
        a64_cset(code, 0, 0); // NE -> inv=EQ(0)
        let p_done: i64 = code.len() as i64;
        a64_b(code, 0);
        let l_false: i64 = code.len() as i64;
        a64_patch_b(code, p_false, l_false - p_false);
        a64_emit_li(code, 0, 0);
        let l_done: i64 = code.len() as i64;
        a64_patch_b(code, p_done, l_done - p_done);
        ty = 2;
    }
    return ty;
}

fn a64_parse_expr(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>) -> i64 {
    let mut ty: i64 = a64_parse_and(src, tk, code, st, sym, fixups);
    while st[1] == 0 && cur_k(tk, st) == 43 {
        adv(tk, st);
        a64_cbz(code, 0, 8);
        let p_true: i64 = code.len() as i64;
        a64_b(code, 0);
        let _ = a64_parse_and(src, tk, code, st, sym, fixups);
        a64_cmp_reg(code, 0, 31);
        a64_cset(code, 0, 0);
        let p_done: i64 = code.len() as i64;
        a64_b(code, 0);
        let l_true: i64 = code.len() as i64;
        a64_patch_b(code, p_true, l_true - p_true);
        a64_emit_li(code, 0, 1);
        let l_done: i64 = code.len() as i64;
        a64_patch_b(code, p_done, l_done - p_done);
        ty = 2;
    }
    return ty;
}

fn a64_parse_println(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &Vec<i64>, fixups: &mut Vec<i64>, pfixups: &mut Vec<i64>) -> i64 {
    adv(tk, st);
    let _ = expect(tk, st, 20, 401);
    let _ = expect(tk, st, 3, 402);
    while cur_k(tk, st) == 24 && st[1] == 0 {
        adv(tk, st);
        let _ = a64_parse_expr(src, tk, code, st, sym, fixups);
        a64_push_x0(code);
        pfixups.push(code.len() as i64);
        a64_bl(code, 0);
        a64_pop_reg(code, 0);
        a64_emit_acc_println_val(code);
    }
    let _ = expect(tk, st, 21, 403);
    let _ = expect(tk, st, 25, 404);
    return 0;
}

fn a64_parse_block(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>, fixups: &mut Vec<i64>, brks: &mut Vec<i64>, pfixups: &mut Vec<i64>) -> i64 {
    let _ = expect(tk, st, 22, 410);
    while cur_k(tk, st) != 23 && cur_k(tk, st) != 0 && st[1] == 0 {
        a64_parse_stmt(src, tk, code, st, sym, fixups, brks, pfixups);
    }
    let _ = expect(tk, st, 23, 411);
    return 0;
}

fn a64_parse_stmt(src: &Vec<u8>, tk: &Vec<i64>, code: &mut Vec<u8>, st: &mut Vec<i64>, sym: &mut Vec<i64>, fixups: &mut Vec<i64>, brks: &mut Vec<i64>, pfixups: &mut Vec<i64>) -> i64 {
    if st[1] != 0 { return 0; }
    let k: i64 = cur_k(tk, st);
    if k == 11 {
        let ln: i64 = cur_ln(tk, st);
        adv(tk, st);
        if cur_k(tk, st) == 12 { adv(tk, st); }
        let ni: i64 = expect(tk, st, 1, 420);
        let ns: i64 = tk_start(tk, ni);
        let nl: i64 = tk_len(tk, ni);
        let mut is_arr: i64 = 0;
        let mut arr_len: i64 = 0;
        let mut decl_ty: i64 = 0;
        if cur_k(tk, st) == 26 {
            adv(tk, st);
            if cur_k(tk, st) == 29 {
                adv(tk, st);
                let _ = parse_type_id(src, tk, st, sym);
                let _ = expect(tk, st, 25, 440);
                let li: i64 = expect(tk, st, 2, 441);
                arr_len = parse_int_val(src, tk_start(tk, li), tk_len(tk, li));
                let _ = expect(tk, st, 45, 442);
                is_arr = 1;
            } else {
                decl_ty = parse_type_id(src, tk, st, sym);
            }
        }
        let _ = expect(tk, st, 35, 421);
        if is_arr != 0 {
            let _ = expect(tk, st, 29, 443);
            let _ = a64_parse_expr(src, tk, code, st, sym, fixups); // init val in x0
            let _ = expect(tk, st, 25, 444);
            let li2: i64 = expect(tk, st, 2, 445);
            let init_len: i64 = parse_int_val(src, tk_start(tk, li2), tk_len(tk, li2));
            let _ = expect(tk, st, 45, 446);
            let _ = expect(tk, st, 25, 447);
            if init_len != arr_len || arr_len <= 0 { set_err(st, ln, 609); return 0; }
            st[12] = st[12] + arr_len;
            let base_disp: i64 = 0 - (st[12] * 8);
            sym_push(sym, 9, st[6], ns, nl, base_disp, arr_len);
            a64_emit_li(code, 9, base_disp);
            a64_add_reg(code, 9, 29, 9);
            a64_emit_li(code, 10, arr_len);
            // loop (4 instrs = 16 B): STUR x0,[x9]; ADD x9,x9,#8; SUB x10,x10,#1; CBNZ x10,-12
            a64_stur(code, 0, 9, 0);
            a64_add_imm(code, 9, 9, 8);
            a64_sub_imm(code, 10, 10, 1);
            a64_cbnz(code, 10, -12);
            return 0;
        }
        let rhs_ty: i64 = a64_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 25, 423);
        if decl_ty != 0 && rhs_ty != 0 && decl_ty != rhs_ty { set_err(st, ln, 601); return 0; }
        if nl == 1 && (src[ns as usize] as i64) == 95 { return 0; }
        st[12] = st[12] + 1;
        let disp: i64 = 0 - (st[12] * 8);
        sym_push(sym, 8, st[6], ns, nl, disp, 1);
        a64_emit_store_slot(code, disp);
        return 0;
    }
    if k == 13 {
        adv(tk, st);
        let _ = a64_parse_expr(src, tk, code, st, sym, fixups);
        a64_cbnz(code, 0, 8);
        let p_else: i64 = code.len() as i64;
        a64_b(code, 0);
        a64_parse_block(src, tk, code, st, sym, fixups, brks, pfixups);
        if cur_k(tk, st) == 14 {
            adv(tk, st);
            let p_end: i64 = code.len() as i64;
            a64_b(code, 0);
            let l_else: i64 = code.len() as i64;
            a64_patch_b(code, p_else, l_else - p_else);
            if cur_k(tk, st) == 13 {
                a64_parse_stmt(src, tk, code, st, sym, fixups, brks, pfixups);
            } else {
                a64_parse_block(src, tk, code, st, sym, fixups, brks, pfixups);
            }
            let l_end: i64 = code.len() as i64;
            a64_patch_b(code, p_end, l_end - p_end);
        } else {
            let l_end: i64 = code.len() as i64;
            a64_patch_b(code, p_else, l_end - p_else);
        }
        return 0;
    }
    if k == 15 {
        adv(tk, st);
        let l_start: i64 = code.len() as i64;
        let _ = a64_parse_expr(src, tk, code, st, sym, fixups);
        a64_cbnz(code, 0, 8);
        let p_end: i64 = code.len() as i64;
        a64_b(code, 0);
        let saved_lid: i64 = st[11];
        st[14] = st[14] + 1;
        let my_lid: i64 = st[14];
        st[11] = my_lid;
        a64_parse_block(src, tk, code, st, sym, fixups, brks, pfixups);
        st[11] = saved_lid;
        let jmp_pc: i64 = code.len() as i64;
        a64_b(code, l_start - jmp_pc);
        let l_end: i64 = code.len() as i64;
        a64_patch_b(code, p_end, l_end - p_end);
        let nb: i64 = (brks.len() as i64) / 2;
        let mut bi: i64 = 0;
        while bi < nb {
            if brks[(bi * 2) as usize] == my_lid {
                let bp: i64 = brks[(bi * 2 + 1) as usize];
                a64_patch_b(code, bp, l_end - bp);
            }
            bi = bi + 1;
        }
        return 0;
    }
    if k == 50 {
        let ln: i64 = cur_ln(tk, st);
        adv(tk, st);
        let _ = expect(tk, st, 25, 424);
        if st[11] <= 0 { set_err(st, ln, 435); return 0; }
        let bp: i64 = code.len() as i64;
        a64_b(code, 0);
        brks.push(st[11]);
        brks.push(bp);
        return 0;
    }
    if k == 16 {
        adv(tk, st);
        if cur_k(tk, st) == 25 {
            adv(tk, st);
            a64_emit_li(code, 0, 0);
            a64_emit_epilogue(code);
            return 0;
        }
        let _ = a64_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 25, 425);
        a64_emit_epilogue(code);
        return 0;
    }
    if k == 19 {
        a64_parse_println(src, tk, code, st, sym, fixups, pfixups);
        return 0;
    }
    if k == 1 && tk_kind(tk, st[0] + 1) == 35 {
        let ln: i64 = cur_ln(tk, st);
        let ns: i64 = cur_s(tk, st);
        let nl: i64 = cur_l(tk, st);
        let disp: i64 = x_find_slot(src, sym, st[6], ns, nl);
        if disp == 0 { set_err(st, ln, 608); return 0; }
        adv(tk, st);
        adv(tk, st);
        let _ = a64_parse_expr(src, tk, code, st, sym, fixups);
        let _ = expect(tk, st, 25, 426);
        a64_emit_store_slot(code, disp);
        return 0;
    }
    if k == 1 && tk_kind(tk, st[0] + 1) == 29 {
        let ln: i64 = cur_ln(tk, st);
        let ns: i64 = cur_s(tk, st);
        let nl: i64 = cur_l(tk, st);
        let base_disp: i64 = x_find_array_base(src, sym, st[6], ns, nl);
        if base_disp == 0 { set_err(st, ln, 608); return 0; }
        adv(tk, st);
        adv(tk, st);
        let _ = a64_parse_expr(src, tk, code, st, sym, fixups);
        a64_push_x0(code);
        let _ = expect(tk, st, 45, 448);
        let _ = expect(tk, st, 35, 449);
        let _ = a64_parse_expr(src, tk, code, st, sym, fixups); // val in x0
        let _ = expect(tk, st, 25, 427);
        a64_pop_reg(code, 10);            // x10 = index
        a64_emit_li(code, 9, base_disp);
        a64_add_reg(code, 9, 29, 9);
        a64_add_reg_lsl3(code, 9, 9, 10); // x9 = fp + base_disp + x10*8
        a64_stur(code, 0, 9, 0);
        return 0;
    }
    let _ = a64_parse_expr(src, tk, code, st, sym, fixups);
    if cur_k(tk, st) == 25 { adv(tk, st); return 0; }
    set_err(st, cur_ln(tk, st), 428);
    return 0;
}

fn a64_parse_fn_header(src: &Vec<u8>, tk: &Vec<i64>, st: &mut Vec<i64>, sym: &mut Vec<i64>, fidx: i64, is_pass1: i64) -> i64 {
    let _ = expect(tk, st, 10, 501);
    let fi: i64 = expect(tk, st, 1, 502);
    let fs: i64 = tk_start(tk, fi);
    let fl: i64 = tk_len(tk, fi);
    let is_m: i64 = kw_main(src, fs, fl);
    let _ = expect(tk, st, 20, 503);
    let mut pstarts: Vec<i64> = Vec::new();
    let mut plens: Vec<i64> = Vec::new();
    let mut pcount: i64 = 0;
    while cur_k(tk, st) != 21 && cur_k(tk, st) != 0 && st[1] == 0 {
        if pcount > 0 { let _ = expect(tk, st, 24, 504); }
        let pi: i64 = expect(tk, st, 1, 505);
        let _ = expect(tk, st, 26, 506);
        let _ = parse_type_id(src, tk, st, sym);
        pstarts.push(tk_start(tk, pi));
        plens.push(tk_len(tk, pi));
        pcount = pcount + 1;
    }
    let _ = expect(tk, st, 21, 507);
    let mut ret_ty: i64 = 1;
    if cur_k(tk, st) == 27 { adv(tk, st); ret_ty = parse_type_id(src, tk, st, sym); }
    if cur_k(tk, st) == 28 {
        adv(tk, st);
        let _ = expect(tk, st, 1, 508);
        while cur_k(tk, st) == 30 && st[1] == 0 { adv(tk, st); let _ = expect(tk, st, 1, 509); }
    }
    if is_pass1 != 0 {
        sym_push(sym, 5, fidx, fs, fl, pcount, ret_ty);
    } else {
        let mut pi2: i64 = 0;
        while pi2 < pcount {
            // 16-byte stack slots per pushed argument on AArch64!
            let disp: i64 = 16 + 16 * (pcount - 1 - pi2);
            sym_push(sym, 8, fidx, pstarts[pi2 as usize], plens[pi2 as usize], disp, 1);
            pi2 = pi2 + 1;
        }
        st[4] = is_m;
        st[6] = fidx;
        st[11] = 0;
        st[12] = 1;
    }
    return is_m;
}

fn compile_aarch64_elf(src: &Vec<u8>, out: &mut Vec<u8>, st: &mut Vec<i64>) -> i64 {
    let mut tk: Vec<i64> = Vec::new();
    let mut sym: Vec<i64> = Vec::new();
    lex_source(src, &mut tk, st);
    if st[1] != 0 { return 0; }
    if cur_k(&tk, st) == 0 { set_err(st, 1, 100); return 0; }
    let mut n_funcs: i64 = 0;
    let mut main_fidx: i64 = -1;
    st[0] = 0;
    while cur_k(&tk, st) != 0 && st[1] == 0 {
        let is_m: i64 = a64_parse_fn_header(src, &tk, st, &mut sym, n_funcs, 1);
        if is_m != 0 { main_fidx = n_funcs; }
        skip_block(&tk, st);
        n_funcs = n_funcs + 1;
    }
    if st[1] != 0 { return 0; }
    if main_fidx < 0 { set_err(st, 1, 540); return 0; }

    let mut fn_code: Vec<u8> = Vec::new();
    let mut fn_offs: Vec<i64> = Vec::new();
    let mut fixups: Vec<i64> = Vec::new();
    let mut brks: Vec<i64> = Vec::new();
    let mut pfixups: Vec<i64> = Vec::new();
    let mut fidx: i64 = 0;
    st[0] = 0;
    while cur_k(&tk, st) != 0 && st[1] == 0 {
        fn_offs.push(fn_code.len() as i64);
        let is_m: i64 = a64_parse_fn_header(src, &tk, st, &mut sym, fidx, 0);
        emit_u32_le(&mut fn_code, 2847898621); // STP x29, x30, [sp, #-16]!
        a64_add_imm(&mut fn_code, 29, 31, 0);  // MOV fp, sp
        let p_frame: i64 = fn_code.len() as i64;
        a64_sub_imm(&mut fn_code, 31, 31, 0);  // SUB sp, sp, #frame (patched)
        if is_m != 0 {
            a64_emit_li(&mut fn_code, 0, 0);
            a64_emit_store_slot(&mut fn_code, -8);
        }
        a64_parse_block(src, &tk, &mut fn_code, st, &mut sym, &mut fixups, &mut brks, &mut pfixups);
        let frame_bytes: i64 = align_up(st[12] * 8, 16);
        patch_u32_le(&mut fn_code, p_frame, 3506438144 + u_mask(frame_bytes, 4096) * 1024 + 31 * 32 + 31);
        if is_m != 0 {
            a64_emit_load_slot(&mut fn_code, -8);
        } else {
            a64_emit_li(&mut fn_code, 0, 0);
        }
        a64_emit_epilogue(&mut fn_code);
        fidx = fidx + 1;
    }
    if st[1] != 0 { return 0; }

    let nfix: i64 = (fixups.len() as i64) / 2;
    let mut fi: i64 = 0;
    while fi < nfix {
        let ppos: i64 = fixups[(fi * 2) as usize];
        let tfid: i64 = fixups[(fi * 2 + 1) as usize];
        a64_patch_bl(&mut fn_code, ppos, fn_offs[tfid as usize] - ppos);
        fi = fi + 1;
    }
    let main_off: i64 = fn_offs[main_fidx as usize];

    let mut text: Vec<u8> = Vec::new();
    // 1. _start (12 bytes): BL main; MOVZ x8, #93; SVC #0
    let p_main: i64 = text.len() as i64;
    a64_bl(&mut text, 0);
    a64_movz(&mut text, 8, 93, 0);  // SYS_exit = 93
    emit_u32_le(&mut text, 3556769793); // SVC #0

    // 2. write_stdout (16 bytes): MOVZ x0, #1; MOVZ x8, #64; SVC #0; RET
    let write_stdout_off: i64 = text.len() as i64;
    a64_movz(&mut text, 0, 1, 0);   // fd = 1
    a64_movz(&mut text, 8, 64, 0);  // SYS_write = 64
    emit_u32_le(&mut text, 3556769793); // SVC #0
    emit_u32_le(&mut text, 3596551104); // RET

    // 3. __bl_print_i64(x0)
    let print_fn_off: i64 = a64_emit_print_i64_helper(&mut text, write_stdout_off);

    // 4. Append user fn_code + backpatch calls
    let fn_base: i64 = text.len() as i64;
    emit_slice(&mut text, &fn_code, 0, fn_code.len() as i64);
    a64_patch_bl(&mut text, p_main, (fn_base + main_off) - p_main);
    let np: i64 = pfixups.len() as i64;
    let mut pi: i64 = 0;
    while pi < np {
        let pos: i64 = fn_base + pfixups[pi as usize];
        a64_patch_bl(&mut text, pos, print_fn_off - pos);
        pi = pi + 1;
    }

    // Emit ELF64 (EM_AARCH64 = 183 = 0xB7) header + PT_LOAD + .text
    let text_len: i64 = text.len() as i64;
    let total_size: i64 = 4096 + text_len;
    out.push(127 as u8); out.push(69 as u8); out.push(76 as u8); out.push(70 as u8);
    out.push(2 as u8); out.push(1 as u8); out.push(1 as u8); out.push(0 as u8);
    emit_zeros(out, 8);
    emit_u16_le(out, 2);       // ET_EXEC
    emit_u16_le(out, 183);     // EM_AARCH64 (183 = 0xB7)
    emit_u32_le(out, 1);
    emit_i64_le(out, 4198400); // e_entry = 0x401000
    emit_i64_le(out, 64);
    emit_i64_le(out, 0);
    emit_u32_le(out, 0);
    emit_u16_le(out, 64);
    emit_u16_le(out, 56);
    emit_u16_le(out, 1);
    emit_u16_le(out, 64);
    emit_u16_le(out, 0);
    emit_u16_le(out, 0);
    emit_u32_le(out, 1);
    emit_u32_le(out, 5);
    emit_i64_le(out, 0);
    emit_i64_le(out, 4194304);
    emit_i64_le(out, 4194304);
    emit_i64_le(out, total_size);
    emit_i64_le(out, total_size);
    emit_i64_le(out, 4096);
    emit_zeros(out, 4096 - (out.len() as i64));
    emit_slice(out, &text, 0, text_len);
    return tk_count(&tk);
}

fn main() ~ Console + FileSystem + Environment + Process {
    let ac: i64 = args_count();
    let mut mode: i64 = 0; // 0=c, 1=wasm, 2=x64-pe, 3=x64-elf, 4=rv64-elf, 5=aarch64-elf
    if ac == 5 && args_get(1) == "--target" {
        if args_get(2) == "wasm" {
            mode = 1;
        } else if args_get(2) == "x64-pe" {
            mode = 2;
        } else if args_get(2) == "x64-elf" {
            mode = 3;
        } else if args_get(2) == "rv64-elf" {
            mode = 4;
        } else if args_get(2) == "aarch64-elf" {
            mode = 5;
        } else if args_get(2) == "c" {
            mode = 0;
        } else {
            println("ERROR: unsupported target (expected c, wasm, x64-pe, x64-elf, rv64-elf, or aarch64-elf)");
            exit(2);
        }
    } else if ac != 3 {
        println("usage: buildc_selfhost_quadarch [--target c|wasm|x64-pe|x64-elf|rv64-elf|aarch64-elf] <in.bld> <out>");
        exit(2);
    }
    let mut src: Vec<u8> = Vec::new();
    if ac == 5 { src = read_file_bytes(args_get(3)); } else { src = read_file_bytes(args_get(1)); }
    if (src.len() as i64) == 0 {
        println("ERROR: empty or unreadable input");
        exit(1);
    }
    let mut out: Vec<u8> = Vec::new();
    let mut st: Vec<i64> = Vec::new();
    let mut zi: i64 = 0;
    while zi < 18 { st.push(0); zi = zi + 1; }
    let mut ntok: i64 = 0;
    if mode == 1 { ntok = compile_wasm(&src, &mut out, &mut st); }
    else if mode == 2 { ntok = compile_x64_from_table(&src, 1, &mut out, &mut st); }
    else if mode == 3 { ntok = compile_x64_from_table(&src, 2, &mut out, &mut st); }
    else if mode == 4 { ntok = compile_rv64_elf(&src, &mut out, &mut st); }
    else if mode == 5 { ntok = compile_aarch64_elf(&src, &mut out, &mut st); }
    else { ntok = compile_c(&src, &mut out, &mut st); }
    if st[1] != 0 {
        println("ERROR (line {}): code={}", st[2], st[3]);
        exit(1);
    }
    let mut ok: bool = false;
    if ac == 5 { ok = write_file_bytes(args_get(4), &out); } else { ok = write_file_bytes(args_get(2), &out); }
    if !ok {
        println("ERROR: failed to write output");
        exit(1);
    }
    if mode == 1 { println("OK: quadarch emitted {} tokens -> {} .wasm bytes", ntok, out.len() as i64); }
    else if mode == 2 { println("OK: quadarch emitted {} tokens -> {} x64-pe bytes", ntok, out.len() as i64); }
    else if mode == 3 { println("OK: quadarch emitted {} tokens -> {} x64-elf bytes", ntok, out.len() as i64); }
    else if mode == 4 { println("OK: quadarch emitted {} tokens -> {} rv64-elf bytes", ntok, out.len() as i64); }
    else if mode == 5 { println("OK: quadarch emitted {} tokens -> {} aarch64-elf bytes", ntok, out.len() as i64); }
    else { println("OK: quadarch compiled {} tokens -> {} .c bytes", ntok, out.len() as i64); }
}
