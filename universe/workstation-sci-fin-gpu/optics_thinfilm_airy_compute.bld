// Finance-Graph-Optics-FFT RGB Airy thin-film interference reflectance compute kernel.
// Evaluates exact multi-bounce Airy thin-film reflectance across red, green, and blue
// bands with smooth bounded phase cosine and strict Fresnel energy bounds [0, 1].

#[compute(workgroup_size = [64, 1, 1])]
fn optics_thinfilm_airy_compute(
    r01: f32,
    r12: f32,
    inv_lam_r: f32,
    inv_lam_g: f32,
    inv_lam_b: f32,
    n_film_buf: &[f32],
    thick_buf: &[f32],
    cos_t_buf: &[f32],
    ref_r_out: &mut [f32],
    ref_g_out: &mut [f32],
    ref_b_out: &mut [f32],
) ~ Gpu {
    let i = gl_GlobalInvocationID.x;
    let opd: f32 = 2.0 * n_film_buf[i] * thick_buf[i] * cos_t_buf[i];

    let r01_2: f32 = r01 * r01;
    let r12_2: f32 = r12 * r12;
    let num_base: f32 = r01_2 + r12_2;
    let den_base: f32 = 1.0 + r01_2 * r12_2;
    let cross: f32 = 2.0 * r01 * r12;

    let pr: f32 = opd * inv_lam_r;
    let pg: f32 = opd * inv_lam_g;
    let pb: f32 = opd * inv_lam_b;

    let cr: f32 = (1.0 - pr * pr) / (1.0 + pr * pr);
    let cg: f32 = (1.0 - pg * pg) / (1.0 + pg * pg);
    let cb: f32 = (1.0 - pb * pb) / (1.0 + pb * pb);

    let mut rr: f32 = (num_base + cross * cr) / (den_base + cross * cr + 0.000001);
    let mut rg: f32 = (num_base + cross * cg) / (den_base + cross * cg + 0.000001);
    let mut rb: f32 = (num_base + cross * cb) / (den_base + cross * cb + 0.000001);

    if rr < 0.0 {
        rr = 0.0;
    }
    if rr > 1.0 {
        rr = 1.0;
    }
    if rg < 0.0 {
        rg = 0.0;
    }
    if rg > 1.0 {
        rg = 1.0;
    }
    if rb < 0.0 {
        rb = 0.0;
    }
    if rb > 1.0 {
        rb = 1.0;
    }

    ref_r_out[i] = rr;
    ref_g_out[i] = rg;
    ref_b_out[i] = rb;
}
