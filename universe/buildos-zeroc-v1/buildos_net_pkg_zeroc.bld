                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p3 = p3 + 1;
        }
        if step < 2 { i = 0; while i < 8 { nodes[step * 8 + i] = hv[i]; i = i + 1; } }
        step = step + 1;
    }

    j = 1; i = 0; while i < 8 { if hv[i] != exp_vfs_root(i) { j = 0; } i = i + 1; }
    if j == 0 { println("{}", -403); println("{}", 0); println("{}", 1); return -403; }

    let granted: i64 = req_caps & policy_allow;
    println("{}", 1);
    println("{}", 1);
    println("{}", 8);
    println("{}", 4);
    println("{}", granted);
    println("{}", tag_w0);
    println("{}", ed_w0);
    i = 0; while i < 8 { println("{}", hv[i]); i = i + 1; }
    return 1;
}

fn buildos_net_pkg_run(mode: i64) -> i64 ~ Console {
    let tag_w0: i64 = pkg_stage1_tls_channel(mode);
    if tag_w0 < 0 { return tag_w0; }
    let r2a: i64 = pkg_stage2a_manifest_log(mode);
    if r2a != 1 { return r2a; }
    let ed_w0: i64 = pkg_stage2b_ed25519(mode);
    if ed_w0 < 0 { return ed_w0; }
    return pkg_stage3_wx_vfs_spawn(mode, tag_w0, ed_w0);
}

fn main() ~ Console {
    let _ = buildos_net_pkg_run(0);
}
