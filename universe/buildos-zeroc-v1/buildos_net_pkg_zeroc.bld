//
// Wave 110C (Slice 21: F1/AC1/N11/N49/N53): Pure-BuildLang Zero-C BuildOS Encrypted
// Transport + Signed Capability Package Installer (buildos_net_pkg_zeroc.bld).
// Stage 1: X25519 + HKDF-SHA256 + ChaCha20-Poly1305 AEAD encrypted package channel
// Stage 2: SHA-256 manifest + anti-downgrade + RFC 6962 proof + Ed25519/SHA-512 verify
// Stage 3: W^X segment + cap policy + content-addressed Merkle VFS + Task 4 spawn
// Compiled with ZERO C compiler, ZERO Rust, ZERO linker across ALL FIVE zero-C ISAs.

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn r64_hi(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((hi >> n) | (lo << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((lo >> m) | (hi << (32 - m))) & 4294967295;
}

fn r64_lo(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((lo >> n) | (hi << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((hi >> m) | (lo << (32 - m))) & 4294967295;
}

fn bswap32(x: i64) -> i64 {
    return ((x & 255) << 24) | (((x >> 8) & 255) << 16) | (((x >> 16) & 255) << 8) | ((x >> 24) & 255);
}

