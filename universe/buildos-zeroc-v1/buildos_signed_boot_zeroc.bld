//
// Wave 98A (Slice 17: F1/AC1/N11/N49/N53): Pure-BuildLang Zero-C Verified Signed OS Boot
// & Software Update Chain (buildos_signed_boot_zeroc.bld).
// Fuses FIPS 180-4 SHA-256 + Monotonic Anti-Rollback + RFC 6962 Transparency Log Proof +
// FIPS 180-4 SHA-512 + RFC 8032 Ed25519 Signature Verification in ONE zero-C binary across
// ALL FIVE targets (x64-pe, x64-elf, rv64-elf, aarch64-elf, wasm).
//
// Modes:
//   0 = Clean signed Slot-B update -> boots Slot B (status=1, boot_allowed=1, boot_slot=2)
//   1 = Planted attack (a): 1-bit kernel image tamper -> SHA-256 rejects (-101, Slot A)
//   2 = Planted attack (b): Anti-rollback epoch downgrade (18 -> 17 <= 17) -> rejects (-201)
//   3 = Planted attack (c): 1-bit RFC 6962 Merkle proof tamper -> rejects (-301)
//   4 = Planted attack (d): 1-bit Ed25519 signature S tamper -> rejects (-401)

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn r64_hi(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((hi >> n) | (lo << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((lo >> m) | (hi << (32 - m))) & 4294967295;
}

fn r64_lo(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((lo >> n) | (hi << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((hi >> m) | (lo << (32 - m))) & 4294967295;
}

fn bswap32(x: i64) -> i64 {
    return ((x & 255) << 24) | (((x >> 8) & 255) << 16) | (((x >> 16) & 255) << 8) | ((x >> 24) & 255);
}

