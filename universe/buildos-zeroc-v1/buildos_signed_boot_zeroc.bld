// Stages 1, 2, 3: SHA-256 Kernel Image Hash + Monotonic Anti-Rollback + RFC 6962 Merkle Proof
fn verify_stages_123(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    // Compact stack arrays (total ~928 B + ~180 B scalars < 1,200 B < 2,048 B RV64)
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut dig: [i64; 8] = [0; 8];
    let mut cur: [i64; 8] = [0; 8];
    let mut sib: [i64; 8] = [0; 8];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut p0: i64 = 0; let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;

    // Unified SHA-256 multi-job driver (job p0:
    //   0 = SHA256(kernel_img, 64 B -> 2 blocks)
    //   1 = SHA256(manifest, 48 B -> 1 block)
    //   2 = SHA256(0x00 || manifest_digest, 33 B -> 1 block) -> leaf
    //   3 = SHA256(0x01 || sib0 || leaf, 65 B -> 2 blocks)   -> node01
    //   4 = SHA256(0x01 || node01 || sib1, 65 B -> 2 blocks) -> log_root)
    p0 = 0;
    while p0 < 5 {
        // Initialize SHA-256 IV
        i = 0;
        while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }

        let mut nblk: i64 = 1;
        if p0 == 0 || p0 == 3 || p0 == 4 { nblk = 2; }
        p1 = 0;
        while p1 < nblk {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p0 == 0 {
                if p1 == 0 {
                    i = 0;
                    while i < 16 { w[i] = bundle_be(i); i = i + 1; }
                    if mode == 1 { w[0] = w[0] ^ 1; } // Planted attack (a): 1-bit kernel image tamper
                } else {
                    w[0] = 2147483648; // 0x80000000
                    w[15] = 512;       // 64 * 8 bits
                }
            } else if p0 == 1 {
                // Manifest (48 B): expected_img_sha256 (32 B) || epoch_new || target_slot || img_len || magic
                i = 0;
                while i < 8 { w[i] = bundle_be(16 + i); i = i + 1; }
                w[8] = 18;
                w[9] = 2;
                w[10] = 64;
                w[11] = 1112297299; // "BLOS"
                w[12] = 2147483648;
                w[15] = 384; // 48 * 8 bits
            } else if p0 == 2 {
