                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p3 = p3 + 1;
        }
        if step < 4 { i = 0; while i < 8 { nodes[step * 8 + i] = hv[i]; i = i + 1; } }
        step = step + 1;
    }

    j = 1; i = 0; while i < 8 { if hv[i] != exp_v1_session_root(i) { j = 0; } i = i + 1; }
    if j == 0 { println("{}", -702); println("{}", 0); println("{}", 1); return -702; }

    // Unified BuildOS-1.0 Full-Session Commit Record (19 words):
    // status=1, session_committed=1, subsystems=7, tasks_active=5, w1..w6, session_root[0..7]
    println("{}", 1);
    println("{}", 1);
    println("{}", 7);
    println("{}", 5);
    println("{}", w1);
    println("{}", w2);
    println("{}", w3);
    println("{}", w4a);
    println("{}", w4b);
    println("{}", w5);
    println("{}", w6);
    i = 0; while i < 8 { println("{}", hv[i]); i = i + 1; }
    return 1;
}

fn buildos_v1_run(mode: i64) -> i64 ~ Console {
    let w1: i64 = os_p1_signed_boot(mode);
    if w1 < 0 { return w1; }
    let w2: i64 = os_p2_wx_cap_sched(mode);
    if w2 < 0 { return w2; }
    let w3: i64 = os_p3_ipc_merkle_vfs(mode);
    if w3 < 0 { return w3; }
    let w4a: i64 = os_p4a_aead_channel(mode);
    if w4a < 0 { return w4a; }
    let r4m: i64 = os_p4b_pkg_manifest(0);
    if r4m != 1 { return r4m; }
    let w4b: i64 = os_p4c_ed25519_pkg(0);
    if w4b < 0 { return w4b; }
    let w5: i64 = os_p5_cap_compositor(mode);
    if w5 < 0 { return w5; }
    let w6: i64 = os_p6_input_audio_dsp(mode);
    if w6 < 0 { return w6; }
    return os_p7_session_root(w1, w2, w3, w4a, w4b, w5, w6);
}

fn main() ~ Console {
    let _ = buildos_v1_run(0);
}
