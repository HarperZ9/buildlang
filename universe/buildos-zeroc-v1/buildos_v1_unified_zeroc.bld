fn pcm_sample(ch: i64, idx: i64) -> i64 {
    if ch == 0 {
        let t: i64 = (idx * 5) & 31;
        if t < 16 { return (t - 16) * 1800; }
        return (16 - (t - 16)) * 1800;
    } else if ch == 1 {
        let t: i64 = (idx * 3 + 7) & 31;
        return (t - 16) * 1650;
    }
    let t: i64 = (idx * 7 + 3) & 31;
    return (16 - t) * 1200;
}

