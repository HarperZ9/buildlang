// Wave 116D (Slice 24: F1/AC1/N11/N49/N53): Unified Zero-C BuildOS-1.0 Full-Stack
// 7-Subsystem OS Kernel (buildos_v1_unified_zeroc.bld). Compiled with ZERO C compiler,
// ZERO Rust, and ZERO external linker across ALL FIVE zero-C ISAs.
//
// 7 Hardware-Isolation Pillars:
//   P1: Signed Boot (SHA-256 + anti-rollback + RFC 6962 boot transparency root)
//   P2: W^X Cap Scheduler (disjoint PFNs + keyed cap MACs + 9-tick deterministic trace)
//   P3: Zero-Copy Cap IPC & Merkle VFS (linear SPSC + 4-block content-addressed root)
//   P4: Encrypted X25519+HKDF+AEAD Channel + Ed25519 Signed Cap Package + Task 4 Spawn
//   P5: Capability Display Compositor (Porter-Duff alpha + 75% damage cull + z-ceiling)
//   P6: Anti-Keylogger HID Input + SAK + Mic Gate + Fixed-Point Q15 Audio DSP Mixer
//   P7: Unified RFC 6962 Section 2.1 6-Leaf MTH BuildOS-1.0 Full-Session Root

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn r64_hi(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((hi >> n) | (lo << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((lo >> m) | (hi << (32 - m))) & 4294967295;
}

fn r64_lo(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((lo >> n) | (hi << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((hi >> m) | (lo << (32 - m))) & 4294967295;
}

fn bswap32(x: i64) -> i64 {
    return ((x & 255) << 24) | (((x >> 8) & 255) << 16) | (((x >> 16) & 255) << 8) | ((x >> 24) & 255);
}

