fn exp_log_root(i: i64) -> i64 {
    if i == 0 { return 3841838528; }
    else if i == 1 { return 3307454371; }
    else if i == 2 { return 2063997328; }
    else if i == 3 { return 1649769775; }
    else if i == 4 { return 1987351453; }
    else if i == 5 { return 45219074; }
    else if i == 6 { return 2096915637; }
    else if i == 7 { return 3075572744; }
    return 0;
}
fn compositor_run(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let bg: i64 = 4278980630; // ARGB(255, 12, 16, 22)

    // Compact stack arrays (1,280 B + ~200 B scalars < 1,550 B < 2,048 B RV64 frame limit)
    let mut fb: [i64; 64] = [0; 64];
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut leaves: [i64; 16] = [0; 16];
    let mut f1_sha: [i64; 8] = [0; 8];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut sid: i64 = 0; let mut fid: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;
    let mut px: i64 = 0; let mut py: i64 = 0; let mut p0: i64 = 0; let mut p1: i64 = 0;

    // =========================================================================
    // PHASE 1: Cross-Surface Screen-Scrape Cap Gate + Rect Bounds + Z-Order Policy
    // =========================================================================
    // Clean reads own surface (target_owner=2); mode==1 scrapes Task 1 without CAP_CAPTURE(8)
    let req_tid: i64 = 2;
    let req_cap: i64 = surf_meta(10 + 3); // Task 2 cap_mask = 1 (no CAP_CAPTURE=8)
    let mut target_owner: i64 = 2;
    if mode == 1 { target_owner = 1; } // Planted attack (a): cross-surface screen-scrape
    if target_owner != req_tid && (req_cap & 8) == 0 {
        println("{}", -101);
        println("{}", 0);
        return -101;
    }

    // Validate every surface rect strictly within 8x8 scanout bounds and trusted-chrome z-order ceiling (< 100)
    sid = 0;
    while sid < 4 {
        p0 = sid * 10;
        let mut sz: i64 = surf_meta(p0 + 1);
        let strust: i64 = surf_meta(p0 + 2);
        let sx: i64 = surf_meta(p0 + 4);
        let sy: i64 = surf_meta(p0 + 5);
        let mut sw: i64 = surf_meta(p0 + 6);
        let sh: i64 = surf_meta(p0 + 7);

        if mode == 2 && sid == 2 { sw = 4; }   // Planted attack (b): x=5 + w=4 = 9 > 8 overflow!
        if mode == 3 && sid == 1 { sz = 120; } // Planted attack (c): untrusted z=120 >= 100 clickjacking!

        if sx < 0 || sy < 0 || sw <= 0 || sh <= 0 || sx + sw > 8 || sy + sh > 8 {
            println("{}", -201);
            println("{}", 0);
            return -201;
        }
        if strust == 0 && sz >= 100 {
            println("{}", -301);
            println("{}", 0);
            return -301;
        }
        sid = sid + 1;
    }

    // =========================================================================
    // PHASE 2: Multi-Frame Porter-Duff Compositing + Damage-Rect Culling + SHA-256 Frame Digest
    //   Frame 0: Full 8x8 scanout (64 dirty pixels)
    //   Frame 1: Incremental damage rect (2..6, 3..7) = 16 dirty pixels (75% culled!)
    // =========================================================================
    i = 0; while i < 64 { fb[i] = bg; i = i + 1; }
    let mut f1_dirty: i64 = 0;

    fid = 0;
    while fid < 2 {
        let mut dx0: i64 = 0; let mut dy0: i64 = 0; let mut dx1: i64 = 8; let mut dy1: i64 = 8;
        if fid == 1 { dx0 = 2; dy0 = 3; dx1 = 6; dy1 = 7; }

        py = dy0;
        while py < dy1 {
            px = dx0;
            while px < dx1 {
                p0 = bg;
                sid = 0;
                while sid < 4 {
                    p1 = sid * 10;
                    a = surf_meta(p1 + 4); b = surf_meta(p1 + 5);
                    c = surf_meta(p1 + 6); d = surf_meta(p1 + 7);
                    if px >= a && px < a + c && py >= b && py < b + d {
                        e = surf_meta(p1 + 8);
                        if fid == 1 { e = surf_meta(p1 + 9); }
                        p0 = blend_over(p0, e);
                    }
                    sid = sid + 1;
                }
                fb[py * 8 + px] = p0;
                if fid == 1 { f1_dirty = f1_dirty + 1; }
                px = px + 1;
            }
            py = py + 1;
        }

        // SHA-256 over 64-pixel scanout framebuffer (256 B = 4 data blocks + 1 padding block = 5 blocks)
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p0 = 0;
        while p0 < 5 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p0 < 4 {
                i = 0; while i < 16 { w[i] = fb[p0 * 16 + i]; i = i + 1; }
            } else {
                w[0] = 2147483648;
                w[15] = 2048; // 256 * 8 bits
            }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32;
                i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
            e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32;
                i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
            hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
            hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p0 = p0 + 1;
        }
        if fid == 1 { i = 0; while i < 8 { f1_sha[i] = hv[i]; i = i + 1; } }

        // RFC 6962 Leaf: SHA256(0x00 || frame_sha) (33 B -> 1 block)
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        w[0] = hv[0] >> 8;
        i = 1; while i < 8 { w[i] = (((hv[i - 1] & 255) << 24) | (hv[i] >> 8)) & m32; i = i + 1; }
        w[8] = (((hv[7] & 255) << 24) | 8388608) & m32; w[15] = 264;
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32;
            i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
        e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32;
            i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
        hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
        hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
        i = 0; while i < 8 { leaves[fid * 8 + i] = hv[i]; i = i + 1; }
        fid = fid + 1;
    }

    // Planted attack (d): Forged scanout digest / RFC 6962 display-integrity log tamper
    if mode == 4 { leaves[0] = leaves[0] ^ 1; }

    // PHASE 3: RFC 6962 Display-Integrity Log Root = SHA256(0x01 || leaf0 || leaf1) (65 B -> 2 blocks)
    i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
    p0 = 0;
    while p0 < 2 {
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        if p0 == 0 {
            w[0] = (16777216 | (leaves[0] >> 8)) & m32;
            i = 1; while i < 8 { w[i] = (((leaves[i - 1] & 255) << 24) | (leaves[i] >> 8)) & m32; i = i + 1; }
            w[8] = (((leaves[7] & 255) << 24) | (leaves[8] >> 8)) & m32;
            i = 1;
            while i < 8 {
                w[8 + i] = (((leaves[8 + i - 1] & 255) << 24) | (leaves[8 + i] >> 8)) & m32;
                i = i + 1;
            }
        } else {
            w[0] = (((leaves[15] & 255) << 24) | 8388608) & m32;
            w[15] = 520;
        }
        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32;
            i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
        e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32;
            i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
        hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
        hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
        p0 = p0 + 1;
    }

    j = 1; i = 0; while i < 8 { if hv[i] != exp_log_root(i) { j = 0; } i = i + 1; }
    if j == 0 {
        println("{}", -401);
        println("{}", 0);
        return -401;
    }

    // Clean commit: status=1, scanout_committed=1, frames=2, f1_dirty=16, 4 sample pixels, f1_sha[0..7], log_root[0..7]
    println("{}", 1);
    println("{}", 1);
    println("{}", 2);
    println("{}", f1_dirty);
    println("{}", fb[0]);
    println("{}", fb[27]);
    println("{}", fb[46]);
    println("{}", fb[63]);
    i = 0; while i < 8 { println("{}", f1_sha[i]); i = i + 1; }
    i = 0; while i < 8 { println("{}", hv[i]); i = i + 1; }
    return 1;
}

fn main() ~ Console {
    let _ = compositor_run(0);
}
