// Wave 114C (Slice 22: F1/AC1/N11/N49/N53): Pure-BuildLang Zero-C BuildOS
// Capability-Isolated Display Compositor (buildos_compositor_zeroc.bld).
// Linear-capability surfaces + fixed-point Porter-Duff premultiplied alpha +
// damage-rect culling + trusted-chrome z-order enforcement + RFC 6962 scanout log.
// Compiled with ZERO C compiler, ZERO Rust, ZERO linker across ALL FIVE zero-C ISAs.
//
// Modes:
//   0 = Clean 2-frame composited scanout + RFC 6962 display log commit (status=1)
//   1 = Planted attack (a): Unauthorized cross-surface screen-scrape -> status=-101
//   2 = Planted attack (b): Out-of-bounds surface rect overflow -> status=-201
//   3 = Planted attack (c): Untrusted z-order clickjacking over chrome -> status=-301
//   4 = Planted attack (d): Forged scanout digest / RFC 6962 log tamper -> status=-401

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn blend_over(dst: i64, src: i64) -> i64 {
    let sa: i64 = (src >> 24) & 255;
    let sr: i64 = (src >> 16) & 255;
    let sg: i64 = (src >> 8) & 255;
    let sb: i64 = src & 255;
    let da: i64 = (dst >> 24) & 255;
    let dr: i64 = (dst >> 16) & 255;
    let dg: i64 = (dst >> 8) & 255;
    let db: i64 = dst & 255;
    let inv: i64 = 255 - sa;
    let mut oa: i64 = sa + ((da * inv + 128) >> 8);
    let mut orr: i64 = sr + ((dr * inv + 128) >> 8);
    let mut og: i64 = sg + ((dg * inv + 128) >> 8);
    let mut ob: i64 = sb + ((db * inv + 128) >> 8);
    if oa > 255 { oa = 255; }
    if orr > 255 { orr = 255; }
    if og > 255 { og = 255; }
    if ob > 255 { ob = 255; }
    return (oa << 24) | (orr << 16) | (og << 8) | ob;
}

fn sha256_iv(i: i64) -> i64 {
    if i == 0 { return 1779033703; }
    else if i == 1 { return 3144134277; }
    else if i == 2 { return 1013904242; }
    else if i == 3 { return 2773480762; }
    else if i == 4 { return 1359893119; }
    else if i == 5 { return 2600822924; }
    else if i == 6 { return 528734635; }
    else if i == 7 { return 1541459225; }
    return 0;
}

