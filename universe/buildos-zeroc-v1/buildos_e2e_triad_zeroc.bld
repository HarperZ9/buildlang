                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32;
                i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
            hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
            hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p3 = p3 + 1;
        }
        if step < 2 { i = 0; while i < 8 { nodes[step * 8 + i] = hv[i]; i = i + 1; } }
        step = step + 1;
    }

    j = 1; i = 0; while i < 8 { if hv[i] != exp_vfs_root(i) { j = 0; } i = i + 1; }
    if j == 0 { println("{}", -402); println("{}", 0); println("{}", 1); return -402; }

    // All 3 Triad Pillars Passed! Emit verified summary + all 3 root digests
    println("{}", 1);
    println("{}", 1);
    println("{}", 2);
    println("{}", 20);
    println("{}", 9);
    println("{}", 4);
    i = 0; while i < 8 { println("{}", boot_w(40 + i)); i = i + 1; }
    i = 0; while i < 8 { println("{}", exp_sched_sha(i)); i = i + 1; }
    i = 0; while i < 8 { println("{}", hv[i]); i = i + 1; }
    return 1;
}

fn buildos_triad_run(mode: i64) -> i64 ~ Console {
    let r1: i64 = triad_stage1_boot(mode);
    if r1 != 1 { return r1; }
    let r2: i64 = triad_stage2_sched(mode);
    if r2 != 1 { return r2; }
    return triad_stage3_ipc_vfs(mode);
}

fn main() ~ Console {
    let _ = buildos_triad_run(0);
}
