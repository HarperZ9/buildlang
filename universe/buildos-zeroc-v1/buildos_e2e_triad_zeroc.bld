// STAGE 1: Verified Signed Boot (SHA-256 Image + Monotonic Anti-Rollback + RFC 6962 Log Root)
fn triad_stage1_boot(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut dig: [i64; 8] = [0; 8];
    let mut cur: [i64; 8] = [0; 8];
    let mut sib: [i64; 8] = [0; 8];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut p0: i64 = 0; let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;

    p0 = 0;
    while p0 < 5 {
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        let mut nblk: i64 = 1;
        if p0 == 0 || p0 == 3 || p0 == 4 { nblk = 2; }
        p1 = 0;
        while p1 < nblk {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p0 == 0 {
                if p1 == 0 {
                    i = 0; while i < 16 { w[i] = boot_w(i); i = i + 1; }
                } else { w[0] = 2147483648; w[15] = 512; }
            } else if p0 == 1 {
                i = 0; while i < 8 { w[i] = boot_w(16 + i); i = i + 1; }
                w[8] = 20; w[9] = 2; w[10] = 64; w[11] = 1112297299;
                w[12] = 2147483648; w[15] = 384;
            } else if p0 == 2 {
                w[0] = dig[0] >> 8;
                i = 1; while i < 8 { w[i] = (((dig[i - 1] & 255) << 24) | (dig[i] >> 8)) & m32; i = i + 1; }
                w[8] = (((dig[7] & 255) << 24) | 8388608) & m32; w[15] = 264;
            } else if p0 == 3 {
                if p1 == 0 {
                    i = 0; while i < 8 { sib[i] = boot_w(24 + i); i = i + 1; }
                    w[0] = (16777216 | (sib[0] >> 8)) & m32;
                    i = 1; while i < 8 { w[i] = (((sib[i - 1] & 255) << 24) | (sib[i] >> 8)) & m32; i = i + 1; }
                    w[8] = (((sib[7] & 255) << 24) | (cur[0] >> 8)) & m32;
                    i = 1; while i < 8 { w[8 + i] = (((cur[i - 1] & 255) << 24) | (cur[i] >> 8)) & m32; i = i + 1; }
                } else { w[0] = (((cur[7] & 255) << 24) | 8388608) & m32; w[15] = 520; }
            } else {
                if p1 == 0 {
                    i = 0; while i < 8 { sib[i] = boot_w(32 + i); i = i + 1; }
