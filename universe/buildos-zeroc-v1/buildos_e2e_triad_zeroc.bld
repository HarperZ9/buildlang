// Wave 107B (Slice 20: F1/AC1/N11/N49/N53): Pure-BuildLang Zero-C Unified BuildOS-Core
// End-to-End Microkernel Triad (buildos_e2e_triad_zeroc.bld).
// Fuses Signed Boot (SHA-256 + Anti-Rollback + RFC 6962) -> W^X Cap Scheduler ->
// Zero-Copy Linear IPC Ring -> Content-Addressed Merkle VFS Commit in ONE zero-C binary
// across ALL FIVE targets (x64-pe, x64-elf, rv64-elf, aarch64-elf, wasm).
//
// Modes:
//   0 = Clean end-to-end Boot -> Schedule -> IPC -> VFS commit (status=1, slot=2)
//   1 = Planted attack (a): Boot epoch rollback downgrade (20 -> 19 <= 19 -> -101)
//   2 = Planted attack (b): Post-boot W^X escalation (Task 1 code PTE = RWX=7 -> -201)
//   3 = Planted attack (c): IPC double-send use-after-transfer ownership fault -> -301
//   4 = Planted attack (d): VFS 1-bit silent block corruption on SHA-256 read -> -401

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

