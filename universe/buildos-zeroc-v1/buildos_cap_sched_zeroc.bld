fn microkernel_run(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    // Compact stack arrays (~992 B + ~200 B scalars < 1,250 B < 2,048 B RV64 frame limit)
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut pfn_used: [i64; 8] = [0; 8];
    let mut rem_bud: [i64; 4] = [0; 4];
    let mut prios: [i64; 4] = [0; 4];
    let mut trace: [i64; 12] = [0; 12];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut tid: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;
    let mut p0: i64 = 0; let mut p1: i64 = 0; let mut p2: i64 = 0; let mut p3: i64 = 0;

    // =========================================================================
    // PHASE 1: W^X Page-Table Permission & Disjoint PFN Isolation Enforcement
    // PERM_R = 1, PERM_W = 2, PERM_X = 4; W^X forbids (perm & 6) == 6
    // =========================================================================
    tid = 0;
    while tid < 4 {
        p0 = task_meta(tid * 8 + 4); // code_pfn
        p1 = task_meta(tid * 8 + 5); // code_perm (5 = R|X)
        p2 = task_meta(tid * 8 + 6); // data_pfn
        p3 = task_meta(tid * 8 + 7); // data_perm (3 = R|W)

        // Planted attack (a): W^X violation mapping Task 1 code page READ|WRITE|EXEC (7)
        if mode == 1 && tid == 1 { p1 = 7; }

        // Enforce strict W^X on both code and data PTEs
        if (p1 & 6) == 6 || (p3 & 6) == 6 {
            println("{}", -101);
            println("{}", 0);
            return -101;
        }
        // Enforce valid bounds and zero shared physical frames (strict task memory isolation)
        if p0 < 0 || p0 >= 8 || p2 < 0 || p2 >= 8 || p0 == p2 {
            println("{}", -102);
            println("{}", 0);
            return -102;
        }
        if pfn_used[p0] != 0 || pfn_used[p2] != 0 {
            println("{}", -103);
            println("{}", 0);
            return -103;
        }
        pfn_used[p0] = 1;
        pfn_used[p2] = 1;
        tid = tid + 1;
    }

    // =========================================================================
    // PHASE 2: Unforgeable Capability Token Verification (Attenuation + Epoch + SHA-256 MAC)
    // =========================================================================
    let root_rights: i64 = 15;
    let root_epoch: i64 = 18;
    tid = 0;
    while tid < 4 {
        p0 = task_meta(tid * 8 + 2); // rights
        p1 = task_meta(tid * 8 + 3); // parent_rights
        p2 = root_epoch;             // token epoch

        // Planted attack (b): Forged/escalated capability bit on Task 2 (adds CAP_CRYPTO=2)
        if mode == 2 && tid == 2 { p0 = p0 | 2; }

        // Check monotonic attenuation (rights subset of parent_rights subset of root_rights) & epoch
        if (p0 & (p1 ^ m32)) != 0 || (p1 & (root_rights ^ m32)) != 0 || p2 != root_epoch {
            println("{}", -201);
            println("{}", 0);
            return -201;
        }

        // Verify cryptographic SHA-256 capability MAC: SHA256(ksecret || tid || rights || epoch || parent_r)
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        i = 0; while i < 8 { w[i] = ksecret_w(i); i = i + 1; }
        w[8] = tid; w[9] = p0; w[10] = p2; w[11] = p1;
        w[12] = 2147483648; w[15] = 384; // 48 * 8 bits

        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32;
            i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
        e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32;
            i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
        hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
        hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;

        j = 1;
        i = 0;
        while i < 8 {
            if hv[i] != exp_cap_mac(tid * 8 + i) { j = 0; }
            i = i + 1;
        }
        if j == 0 {
            println("{}", -201);
            println("{}", 0);
            return -201;
        }
        tid = tid + 1;
    }

    // =========================================================================
    // PHASE 3: FIPS 180-4 SHA-256 Code-Page Attestation Prior to Dispatch (4 tasks x 64 B)
    // =========================================================================
    tid = 0;
    while tid < 4 {
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p0 = 0;
        while p0 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p0 == 0 {
                i = 0; while i < 16 { w[i] = code_page_w(tid * 16 + i); i = i + 1; }
                // Planted attack (c): 1-bit code-page tamper on Task 3 before dispatch
                if mode == 3 && tid == 3 { w[0] = w[0] ^ 1; }
            } else {
                w[0] = 2147483648;
                w[15] = 512; // 64 * 8 bits
            }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32;
                i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
            e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32;
                i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
            hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
            hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p0 = p0 + 1;
        }
        j = 1;
        i = 0;
        while i < 8 {
            if hv[i] != exp_code_sha(tid * 8 + i) { j = 0; }
            i = i + 1;
        }
        if j == 0 {
            println("{}", -301);
            println("{}", 0);
            return -301;
        }
        tid = tid + 1;
    }

    // =========================================================================
    // PHASE 4: Deterministic Priority + Budget-Capped Round-Robin Scheduler (9 ticks)
    // =========================================================================
    tid = 0;
    while tid < 4 {
        prios[tid] = task_meta(tid * 8);
        rem_bud[tid] = task_meta(tid * 8 + 1);
        tid = tid + 1;
    }

    p0 = 0; // rr_cursor
    p1 = 0; // tick index 0..8
    while p1 < 9 {
        p2 = -1; // best tid
        p3 = -1; // best prio
        i = 0;
        while i < 4 {
            j = (p0 + i) & 3;
            if rem_bud[j] > 0 && prios[j] > p3 {
                p2 = j;
                p3 = prios[j];
            }
            i = i + 1;
        }
        if p2 < 0 {
            println("{}", -402);
            println("{}", 0);
            return -402;
        }

        // Tick CPU cost = 1; planted attack (d): Task 0 demands 3 ticks (> budget 2 -> starvation!)
        a = 1;
        if mode == 4 && p2 == 0 { a = 3; }
        if a > rem_bud[p2] {
            println("{}", -401);
            println("{}", 0);
            return -401;
        }

        rem_bud[p2] = rem_bud[p2] - a;
        trace[p1] = p2;
        p0 = (p2 + 1) & 3;
        p1 = p1 + 1;
    }
    trace[9] = 9;
    trace[10] = 4;
    trace[11] = root_epoch;

    // Hash full 12-word dispatch trace attestation via SHA-256 (48 B -> 1 block)
    i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
    i = 0; while i < 16 { w[i] = 0; i = i + 1; }
    i = 0; while i < 12 { w[i] = trace[i]; i = i + 1; }
    w[12] = 2147483648; w[15] = 384;
    i = 16;
    while i < 64 {
        s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
        s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32;
        i = i + 1;
    }
    a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
    e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
    i = 0;
    while i < 64 {
        s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
        t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
        s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
        t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
        h = g; g = f; f = e; e = (d + t1) & m32;
        d = c; c = b; b = a; a = (t1 + t2) & m32;
        i = i + 1;
    }
    hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
    hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
    hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
    hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;

    // Clean pass: print status=1, dispatch_allowed=1, 9-tick trace, and 8-word trace SHA-256
    println("{}", 1);
    println("{}", 1);
    i = 0; while i < 9 { println("{}", trace[i]); i = i + 1; }
    i = 0; while i < 8 { println("{}", hv[i]); i = i + 1; }
    return 1;
}

fn main() ~ Console {
    let _ = microkernel_run(0);
}
