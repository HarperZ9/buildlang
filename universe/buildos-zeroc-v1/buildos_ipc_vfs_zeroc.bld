fn exp_root_w(i: i64) -> i64 {
    if i == 0 { return 1422357189; }
    else if i == 1 { return 2641503083; }
    else if i == 2 { return 3003996700; }
    else if i == 3 { return 767831677; }
    else if i == 4 { return 1392126753; }
    else if i == 5 { return 3324223450; }
    else if i == 6 { return 2135489297; }
    else if i == 7 { return 3512736780; }
    return 0;
}
fn ipc_vfs_run(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    // Compact stack arrays (~1,152 B + ~200 B scalars < 1,400 B < 2,048 B RV64 frame limit)
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut owner: [i64; 4] = [0; 4];     // linear page owner: 0=Producer, -1=InTransit, 3=VFS
    let mut ring_blk: [i64; 4] = [0; 4];  // SPSC ring descriptor: page/block ID
    let mut ring_seq: [i64; 4] = [0; 4];  // SPSC ring monotonic sequence number
    let mut leaves: [i64; 32] = [0; 32];  // 4 x 8-word RFC 6962 leaf hashes
    let mut nodes: [i64; 16] = [0; 16];   // 2 x 8-word interior nodes (node01, node23)
    let mut last_cid: [i64; 8] = [0; 8];  // block 3 content address for telemetry output

    let mut i: i64 = 0; let mut j: i64 = 0; let mut step: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;
    let mut p0: i64 = 0; let mut p1: i64 = 0; let mut p2: i64 = 0; let mut p3: i64 = 0;

    // Capabilities: CAP_COMPUTE=1, CAP_IPC_SEND=4, CAP_IPC_RECV=8
    let mut sender_cap: i64 = 5;
    let recv_cap: i64 = 9;
    if mode == 1 { sender_cap = 1; } // Planted attack (a): unauthorized sender missing CAP_IPC_SEND

    let mut head: i64 = 0;
    let mut tail: i64 = 0;
    let mut expected_seq: i64 = 1;

    // =========================================================================
    // PHASE 1 & 2: Capability-Gated Zero-Copy SPSC IPC + Content-Addressed Block Ingest
    // =========================================================================
    step = 0;
    while step < 4 {
        // 1. Producer capability gate
        if (sender_cap & 4) == 0 || (recv_cap & 8) == 0 {
            println("{}", -101);
            println("{}", 0);
            return -101;
        }

        // Select block to transfer; planted attack (b): double-send block 0 after transfer!
        p0 = step;
        if mode == 2 && step == 2 { p0 = 0; }

        // 2. Linear page-ownership check (zero shared writable alias / anti-use-after-transfer)
        if owner[p0] != 0 {
            println("{}", -201);
            println("{}", 0);
            return -201;
        }
        // Atomically revoke Producer access and place descriptor into SPSC ring slot
        owner[p0] = -1;
        p1 = tail & 3;
        ring_blk[p1] = p0;
        p2 = step + 1; // monotonic sequence 1..4
        if mode == 4 && step == 2 { p2 = 1; } // Planted attack (d): sequence replay forgery
        ring_seq[p1] = p2;
        tail = tail + 1;

        // 3. Consumer pops SPSC ring slot and verifies strict monotonic sequence
        if head >= tail {
            println("{}", -402);
            println("{}", 0);
            return -402;
        }
        p1 = head & 3;
        p0 = ring_blk[p1];
        p2 = ring_seq[p1];
        head = head + 1;
        if p2 != expected_seq {
            println("{}", -401);
            println("{}", 0);
            return -401;
        }
        expected_seq = expected_seq + 1;

        // Transfer exclusive ownership to VFS Server (Task 3)
        owner[p0] = 3;

        // 4. Content-addressed SHA-256 verification of the 64-byte block (2 SHA-256 blocks)
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p3 = 0;
        while p3 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p3 == 0 {
                i = 0; while i < 16 { w[i] = vfs_blk_w(p0 * 16 + i); i = i + 1; }
                // Planted attack (c): 1-bit silent disk/block corruption on block 2
                if mode == 3 && p0 == 2 { w[0] = w[0] ^ 1; }
            } else {
                w[0] = 2147483648;
                w[15] = 512; // 64 * 8 bits
            }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32;
                i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
            e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32;
                i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
            hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
            hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p3 = p3 + 1;
        }

        // Verify content address CID == expected CID
        j = 1;
        i = 0;
        while i < 8 {
            if hv[i] != exp_cid_w(p0 * 8 + i) { j = 0; }
            if p0 == 3 { last_cid[i] = hv[i]; }
            i = i + 1;
        }
        if j == 0 {
            println("{}", -301);
            println("{}", 0);
            return -301;
        }

        // 5. Compute RFC 6962 leaf hash: SHA256(0x00 || cid) (33 B -> 1 block)
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        w[0] = hv[0] >> 8;
        i = 1;
        while i < 8 {
            w[i] = (((hv[i - 1] & 255) << 24) | (hv[i] >> 8)) & m32;
            i = i + 1;
        }
        w[8] = (((hv[7] & 255) << 24) | 8388608) & m32;
        w[15] = 264; // 33 * 8 bits

        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32;
            i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
        e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32;
            i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
        hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
        hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;

        i = 0; while i < 8 { leaves[p0 * 8 + i] = hv[i]; i = i + 1; }
        step = step + 1;
    }

    // =========================================================================
    // PHASE 3: Immutable RFC 6962 VFS Inode Merkle Root Commitment
    //   step=0: node01 = SHA256(0x01 || leaves[0] || leaves[1])
    //   step=1: node23 = SHA256(0x01 || leaves[2] || leaves[3])
    //   step=2: root   = SHA256(0x01 || node01    || node23)
    // =========================================================================
    step = 0;
    while step < 3 {
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p3 = 0;
        while p3 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if step < 2 {
                p0 = step * 16;     // left leaf base
                p1 = step * 16 + 8; // right leaf base
                if p3 == 0 {
                    w[0] = (16777216 | (leaves[p0] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[i] = (((leaves[p0 + i - 1] & 255) << 24) | (leaves[p0 + i] >> 8)) & m32;
                        i = i + 1;
                    }
                    w[8] = (((leaves[p0 + 7] & 255) << 24) | (leaves[p1] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[8 + i] = (((leaves[p1 + i - 1] & 255) << 24) | (leaves[p1 + i] >> 8)) & m32;
                        i = i + 1;
                    }
                } else {
                    w[0] = (((leaves[p1 + 7] & 255) << 24) | 8388608) & m32;
                    w[15] = 520; // 65 * 8 bits
                }
            } else {
                if p3 == 0 {
                    w[0] = (16777216 | (nodes[0] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[i] = (((nodes[i - 1] & 255) << 24) | (nodes[i] >> 8)) & m32;
                        i = i + 1;
                    }
                    w[8] = (((nodes[7] & 255) << 24) | (nodes[8] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[8 + i] = (((nodes[8 + i - 1] & 255) << 24) | (nodes[8 + i] >> 8)) & m32;
                        i = i + 1;
                    }
                } else {
                    w[0] = (((nodes[15] & 255) << 24) | 8388608) & m32;
                    w[15] = 520;
                }
            }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32;
                i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
            e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32;
                i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
            hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
            hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p3 = p3 + 1;
        }
        if step < 2 {
            i = 0; while i < 8 { nodes[step * 8 + i] = hv[i]; i = i + 1; }
        }
        step = step + 1;
    }

    j = 1;
    i = 0;
    while i < 8 {
        if hv[i] != exp_root_w(i) { j = 0; }
        i = i + 1;
    }
    if j == 0 {
        println("{}", -302);
        println("{}", 0);
        return -302;
    }

    // Clean commit: status=1, vfs_committed=1, transferred=4, final_seq=4, inode_root[0..7], blk3_cid[0..7]
    println("{}", 1);
    println("{}", 1);
    println("{}", 4);
    println("{}", 4);
    i = 0; while i < 8 { println("{}", hv[i]); i = i + 1; }
    i = 0; while i < 8 { println("{}", last_cid[i]); i = i + 1; }
    return 1;
}

fn main() ~ Console {
    let _ = ipc_vfs_run(0);
}
