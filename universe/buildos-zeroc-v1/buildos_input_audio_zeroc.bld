}

fn exp_io_root(i: i64) -> i64 {
    if i == 0 { return 3428044092; }
    else if i == 1 { return 3865851637; }
    else if i == 2 { return 443990685; }
    else if i == 3 { return 854782515; }
    else if i == 4 { return 1505095490; }
    else if i == 5 { return 828166038; }
    else if i == 6 { return 3294522760; }
    else if i == 7 { return 1575809771; }
    return 0;
}
fn input_audio_run(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    // Compact stack arrays (896 B + ~200 B scalars < 1,150 B < 2,048 B RV64 frame limit)
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut hid_buf: [i64; 16] = [0; 16];
    let mut pcm_buf: [i64; 16] = [0; 16];
    let mut leaves: [i64; 16] = [0; 16];
    let mut aud_sha: [i64; 8] = [0; 8];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut p0: i64 = 0; let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;

    // =========================================================================
    // PHASE 1: Capability-Isolated Anti-Keylogger Input Router (16 HID events)
    // =========================================================================
    let focused_tid: i64 = 1;
    let mut sak_cnt: i64 = 0;
    i = 0;
    while i < 16 {
        let mut is_sak: i64 = 0;
        if i == 5 || i == 13 { is_sak = 1; }
        let mut et: i64 = 1;
        if is_sak != 0 { et = 9; } else if (i & 3) == 3 { et = 2; }
        let mut code: i64 = 65 + ((i * 7) & 31);
        if is_sak != 0 { code = 240 + i; }

        let mut dst: i64 = focused_tid;
        if is_sak != 0 { dst = 0; }
        // Planted attack (a): Background keylogger Task 3 taps keystroke event #3 without CAP_INPUT_FOCUS
        if mode == 1 && i == 3 { dst = 3; }

        if is_sak != 0 {
            if dst != 0 || (task_caps(dst) & 8) == 0 {
                println("{}", -101); println("{}", 0); return -101;
            }
            sak_cnt = sak_cnt + 1;
        } else {
            if dst != focused_tid || (task_caps(dst) & 1) == 0 {
                println("{}", -101); println("{}", 0); return -101;
            }
        }
        hid_buf[i] = ((dst & 15) << 24) | ((is_sak & 1) << 20) | ((et & 255) << 12) | ((code & 255) << 4) | (i & 15);
        i = i + 1;
    }

    // =========================================================================
    // PHASE 2: Hardware Mic Gate + Bounds-Checked Fixed-Point Q15 Audio DSP Mixer
    // =========================================================================
    // Hardware mic gate: Task 2 holds CAP_AUDIO_CAPTURE(4); mode==2 uses Task 3 (caps=2)
    let mut mic_tid: i64 = 2;
    if mode == 2 { mic_tid = 3; }
    if (task_caps(mic_tid) & 4) == 0 {
        println("{}", -201); println("{}", 0); return -201;
    }

    // Ring-buffer bounds check (32-sample ring capacity)
    let mut ring_off: i64 = 0;
    let mut ring_len: i64 = 32;
    if mode == 3 { ring_off = 24; ring_len = 16; } // Planted attack (c): 24 + 16 = 40 > 32 overrun!
    if ring_off < 0 || ring_len <= 0 || ring_off + ring_len > 32 {
        println("{}", -301); println("{}", 0); return -301;
    }

    // Mix 32 Q15 samples across Tasks 1..3 (verify CAP_AUDIO_PLAY=2 on all 3) with saturating limiter [-28000, +28000]
    if (task_caps(1) & 2) == 0 || (task_caps(2) & 2) == 0 || (task_caps(3) & 2) == 0 {
        println("{}", -202); println("{}", 0); return -202;
    }

    let mut clipped: i64 = 0;
    i = 0;
    while i < 16 {
        p0 = 0;
        j = 0;
        while j < 2 {
            let idx: i64 = i * 2 + j;
            let mut m: i64 = ((pcm_sample(0, idx) * 24576) >> 15)
                           + ((pcm_sample(1, idx) * 24576) >> 15)
                           + ((pcm_sample(2, idx) * 16384) >> 15);
            if m > 28000 { m = 28000; clipped = clipped + 1; }
            else if m < -28000 { m = -28000; clipped = clipped + 1; }
            if j == 0 { p0 = (m & 65535) << 16; }
            else { p0 = p0 | (m & 65535); }
            j = j + 1;
        }
        pcm_buf[i] = p0;
        i = i + 1;
    }

    // =========================================================================
    // PHASE 3: SHA-256 Digests + RFC 6962 I/O Integrity Log Commitment
    //   p1=0: SHA256(hid_buf, 64 B) -> leaf_in
    //   p1=1: SHA256(pcm_buf, 64 B) -> aud_sha -> leaf_aud
    // =========================================================================
    p1 = 0;
    while p1 < 2 {
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p0 = 0;
        while p0 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p0 == 0 {
                i = 0;
                while i < 16 {
                    if p1 == 0 { w[i] = hid_buf[i]; } else { w[i] = pcm_buf[i]; }
                    i = i + 1;
                }
            } else { w[0] = 2147483648; w[15] = 512; }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p0 = p0 + 1;
        }
        if p1 == 1 { i = 0; while i < 8 { aud_sha[i] = hv[i]; i = i + 1; } }

        // RFC 6962 Leaf: SHA256(0x00 || digest)
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        w[0] = hv[0] >> 8;
        i = 1; while i < 8 { w[i] = (((hv[i - 1] & 255) << 24) | (hv[i] >> 8)) & m32; i = i + 1; }
        w[8] = (((hv[7] & 255) << 24) | 8388608) & m32; w[15] = 264;
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
        i = 0; while i < 8 { leaves[p1 * 8 + i] = hv[i]; i = i + 1; }
        p1 = p1 + 1;
    }

    // Planted attack (d): Forged audio/input RFC 6962 audit digest tamper
    if mode == 4 { leaves[0] = leaves[0] ^ 1; }

    // RFC 6962 I/O Integrity Log Root = SHA256(0x01 || leaf_in || leaf_aud)
    i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
    p0 = 0;
    while p0 < 2 {
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        if p0 == 0 {
            w[0] = (16777216 | (leaves[0] >> 8)) & m32;
            i = 1; while i < 8 { w[i] = (((leaves[i - 1] & 255) << 24) | (leaves[i] >> 8)) & m32; i = i + 1; }
            w[8] = (((leaves[7] & 255) << 24) | (leaves[8] >> 8)) & m32;
            i = 1;
            while i < 8 {
                w[8 + i] = (((leaves[8 + i - 1] & 255) << 24) | (leaves[8 + i] >> 8)) & m32; i = i + 1;
            }
        } else { w[0] = (((leaves[15] & 255) << 24) | 8388608) & m32; w[15] = 520; }
        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
        p0 = p0 + 1;
    }

    j = 1; i = 0; while i < 8 { if hv[i] != exp_io_root(i) { j = 0; } i = i + 1; }
    if j == 0 { println("{}", -401); println("{}", 0); return -401; }

    println("{}", 1);
    println("{}", 1);
    println("{}", 16);
    println("{}", sak_cnt);
    println("{}", 32);
    println("{}", clipped);
    i = 0; while i < 8 { println("{}", aud_sha[i]); i = i + 1; }
    i = 0; while i < 8 { println("{}", hv[i]); i = i + 1; }
    return 1;
}

fn main() ~ Console {
    let _ = input_audio_run(0);
}
