// Wave 115B (Slice 23: F1/AC1/N11/N49/N53): Pure-BuildLang Zero-C BuildOS
// Anti-Keylogger Input Router + Capability-Isolated Fixed-Point Audio DSP Bus
// (buildos_input_audio_zeroc.bld). Compiled with ZERO C compiler, ZERO Rust, ZERO linker
// across ALL FIVE zero-C targets (x64-pe, x64-elf, rv64-elf, aarch64-elf, wasm).
//
// Modes:
//   0 = Clean 16-event HID + 32-sample Q15 mix + RFC 6962 I/O log commit (status=1)
//   1 = Planted attack (a): Background keylogger tap without CAP_INPUT_FOCUS -> -101
//   2 = Planted attack (b): Unauthorized mic eavesdrop without CAP_AUDIO_CAPTURE -> -201
//   3 = Planted attack (c): Audio ring-buffer index/length overrun (40 > 32) -> -301
//   4 = Planted attack (d): Forged audio/input RFC 6962 audit digest tamper -> -401

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn task_caps(tid: i64) -> i64 {
    if tid == 0 { return 11; }
    else if tid == 1 { return 3; }
    else if tid == 2 { return 6; }
    else if tid == 3 { return 2; }
    return 0;
}

fn pcm_sample(ch: i64, idx: i64) -> i64 {
    if ch == 0 {
        let t: i64 = (idx * 5) & 31;
        if t < 16 { return (t - 16) * 1800; }
        return (16 - (t - 16)) * 1800;
    } else if ch == 1 {
        let t: i64 = (idx * 3 + 7) & 31;
        return (t - 16) * 1650;
    }
    let t: i64 = (idx * 7 + 3) & 31;
    return (16 - t) * 1200;
}

fn sha256_iv(i: i64) -> i64 {
    if i == 0 { return 1779033703; }
    else if i == 1 { return 3144134277; }
    else if i == 2 { return 1013904242; }
    else if i == 3 { return 2773480762; }
    else if i == 4 { return 1359893119; }
    else if i == 5 { return 2600822924; }
    else if i == 6 { return 528734635; }
    else if i == 7 { return 1541459225; }
    return 0;
}

