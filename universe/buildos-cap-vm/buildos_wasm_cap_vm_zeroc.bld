// =============================================================================
// STAGE 1: Fuel-Metered Capability Sandbox Bytecode VM + Live SHA-256 Hostcall
// Stack arrays: w[64]+hv[8]+mem[32]+stk[16]+regs[8] = 1,024 B + scalars < 1,350 B < 2,048 B RV64!
// =============================================================================
fn vm_stage1_execute(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let fuel_budget: i64 = 512;
    let cap_mask: i64 = 3;
    let code_len: i64 = 42;

    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut mem: [i64; 32] = [0; 32];
    let mut stk: [i64; 16] = [0; 16];
    let mut regs: [i64; 8] = [0; 8];

    let mut pc: i64 = 0; let mut sp: i64 = 0;
    let mut fuel: i64 = fuel_budget; let mut fuel_used: i64 = 0;
    let mut host_out: i64 = 0; let mut trace_fold: i64 = 2654435769;
    let mut halted: i64 = 0;

    let mut i: i64 = 0; let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;

    while halted == 0 {
        // 1. Strict pre-instruction fuel metering (catches infinite loops fail-closed)
        if fuel <= 0 {
            println("{}", -101); println("{}", 0); return -101;
        }
        if pc < 0 || pc >= code_len {
            println("{}", -401); println("{}", 0); return -401;
        }
        fuel = fuel - 1;
        fuel_used = fuel_used + 1;

        let mut op: i64 = vm_code_op(pc);
        let mut arg: i64 = vm_code_arg(pc);
        let cur_pc: i64 = pc;

        // Planted sandbox-escape attacks (a..d):
        if mode == 1 && cur_pc == 23 { op = 13; arg = 4; }   // (a) Infinite-loop JMP 4 -> fuel exhaustion
        if mode == 2 && cur_pc == 32 { arg = 40; }           // (b) Linear-memory OOB write addr=40 >= 32
        if mode == 3 && cur_pc == 40 { arg = 3; }            // (c) Unauthorized HOST_NET_EGRESS (cap 4)
        if mode == 4 && cur_pc == 32 { arg = 1024; }         // (d) W^X code-segment write addr=1024

        trace_fold = (trace_fold * 33 + ((cur_pc << 8) ^ op ^ (sp << 16))) & m32;
        pc = pc + 1;

        if op == 1 {
            if sp >= 16 { println("{}", -202); println("{}", 0); return -202; }
            stk[sp] = arg & m32; sp = sp + 1;
        } else if op == 2 {
            if arg < 0 || arg >= 8 || sp >= 16 { println("{}", -202); println("{}", 0); return -202; }
            stk[sp] = regs[arg]; sp = sp + 1;
        } else if op == 3 {
            if arg < 0 || arg >= 8 || sp <= 0 { println("{}", -202); println("{}", 0); return -202; }
            sp = sp - 1; regs[arg] = stk[sp];
        } else if op == 4 || op == 5 || op == 6 || op == 7 {
            if sp < 2 { println("{}", -202); println("{}", 0); return -202; }
            sp = sp - 1; b = stk[sp]; sp = sp - 1; a = stk[sp];
            if op == 4 { stk[sp] = (a + b) & m32; }
            else if op == 5 { stk[sp] = (a - b) & m32; }
            else if op == 6 { stk[sp] = (a * b) & m32; }
            else { stk[sp] = (a ^ b) & m32; }
            sp = sp + 1;
        } else if op == 10 {
            if sp < 1 { println("{}", -202); println("{}", 0); return -202; }
            sp = sp - 1; a = stk[sp];
            if a < 0 || a >= 32 { println("{}", -201); println("{}", 0); return -201; }
            stk[sp] = mem[a]; sp = sp + 1;
        } else if op == 11 {
            if sp < 2 { println("{}", -202); println("{}", 0); return -202; }
            sp = sp - 1; b = stk[sp]; sp = sp - 1; a = stk[sp];
            // W^X immutable code segment guard (addresses >= 1024 map read-only code!)
            if a >= 1024 { println("{}", -401); println("{}", 0); return -401; }
            if a < 0 || a >= 32 { println("{}", -201); println("{}", 0); return -201; }
            mem[a] = b;
        } else if op == 12 {
            if sp < 1 { println("{}", -202); println("{}", 0); return -202; }
            sp = sp - 1; a = stk[sp];
            if a != 0 {
                if arg < 0 || arg >= code_len { println("{}", -401); println("{}", 0); return -401; }
                pc = arg;
            }
        } else if op == 13 {
            if arg < 0 || arg >= code_len { println("{}", -401); println("{}", 0); return -401; }
            pc = arg;
        } else if op == 14 {
            // Capability-checked hostcall dispatcher
            if arg == 1 {
                if (cap_mask & 1) == 0 { println("{}", -301); println("{}", 0); return -301; }
                // Live FIPS 180-4 SHA-256 over guest linear memory mem[0..15] -> mem[16..23]
                i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
                p1 = 0;
                while p1 < 2 {
                    i = 0; while i < 16 { w[i] = 0; i = i + 1; }
                    if p1 == 0 { i = 0; while i < 16 { w[i] = mem[i]; i = i + 1; } }
                    else { w[0] = 2147483648; w[15] = 512; }
                    i = 16;
                    while i < 64 {
                        s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                        s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
                    }
                    a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
                    i = 0;
                    while i < 64 {
                        s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                        t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                        s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                        t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                        h = g; g = f; f = e; e = (d + t1) & m32;
                        d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
                    }
                    hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
                    hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
                    hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
                    hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
                    p1 = p1 + 1;
                }
                i = 0; while i < 8 { mem[16 + i] = hv[i]; i = i + 1; }
            } else if arg == 2 {
                if (cap_mask & 2) == 0 { println("{}", -301); println("{}", 0); return -301; }
                if sp < 1 { println("{}", -202); println("{}", 0); return -202; }
                sp = sp - 1; host_out = stk[sp];
            } else {
                // Any ungranted / egress hostcall (e.g. HOST_NET_EGRESS=3 requiring cap 4) fails closed!
                println("{}", -301); println("{}", 0); return -301;
            }
        } else if op == 15 {
            halted = 1;
        } else {
            println("{}", -401); println("{}", 0); return -401;
        }
    }

    // Verify guest memory and execution-trace invariants before Stage 2 RFC 6962 commit
    i = 0;
    while i < 16 {
        if mem[i] != exp_guest_mem(i) { println("{}", -402); println("{}", 0); return -402; }
        i = i + 1;
    }
    if fuel_used != 447 || host_out != 4256336022 || trace_fold != 1565305751 || mem[24] != 4256336022 {
        println("{}", -403); println("{}", 0); return -403;
    }
    return vm_stage2_merkle_commit(fuel_used, host_out, trace_fold, mem[16]);
}

