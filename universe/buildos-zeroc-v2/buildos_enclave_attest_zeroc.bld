// =============================================================================
// STAGE 1: Zero-Egress Policy Fence + Fresh Nonce + RFC 6962 Enclave Root + Quote Digest
// =============================================================================
fn enclave_stage1_policy_quote(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut mr: [i64; 8] = [0; 8];
    let mut leaves: [i64; 16] = [0; 16];
    let mut eroot: [i64; 8] = [0; 8];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut p0: i64 = 0; let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;

    // Zero-egress capability allowlist = 5 (CAP_COMPUTE=1 | CAP_SEAL=4; denies CAP_NET_EGRESS=2)
    let policy_allow: i64 = 5;
    let mut req_caps: i64 = 5;
    if mode == 3 { req_caps = 7; } // Planted attack (c): unauthorized CAP_NET_EGRESS escalation!
    if (req_caps & (policy_allow ^ m32)) != 0 {
        println("{}", -301); println("{}", 0); return -301;
    }

    // Fresh monotonic attestation nonce check (last_seen=41, fresh=42)
    let last_nonce_seq: i64 = 41;
    let mut cur_nonce_seq: i64 = 42;
    if mode == 2 { cur_nonce_seq = 41; } // Planted attack (b): replayed/stale attestation nonce!
    if cur_nonce_seq <= last_nonce_seq {
        println("{}", -201); println("{}", 0); return -201;
    }

    // Measure 64-byte enclave code page -> mr_enclave
    i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
    p1 = 0;
    while p1 < 2 {
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
