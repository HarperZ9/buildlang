    if ed_w0 < 0 { return ed_w0; }

    // Clean commit: status=1, attested=1, epoch=28, nonce_seq=42, caps=5, tag_w0, ed_w0, quote[0..7], eroot[0..7]
    println("{}", 1);
    println("{}", 1);
    println("{}", 28);
    println("{}", 42);
    println("{}", 5);
    println("{}", tag_w0);
    println("{}", ed_w0);
