// Wave 125C (Slice 28: F1/AC1/N11/N49/N53): Pure-BuildLang Zero-C BuildOS
// Confidential Enclave, Measurement-Bound Key Sealing & Ed25519 Remote Quote
// Attestation (buildos_enclave_attest_zeroc.bld). Compiled with ZERO C compiler,
// ZERO Rust, and ZERO external linker across ALL FIVE zero-C ISAs.
//
// Modes:
//   0 = Clean enclave launch, HKDF/AEAD seal+unseal, Ed25519 quote (status=1)
//   1 = Planted attack (a): 1-bit mr_enclave tamper failing AEAD unseal -> -101
//   2 = Planted attack (b): Replayed/stale attestation nonce (41 <= 41) -> -201
//   3 = Planted attack (c): Unauthorized zero-egress capability violation -> -301
//   4 = Planted attack (d): Forged Ed25519 remote quote signature S -> -401

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn r64_hi(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((hi >> n) | (lo << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((lo >> m) | (hi << (32 - m))) & 4294967295;
}

fn r64_lo(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((lo >> n) | (hi << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((hi >> m) | (lo << (32 - m))) & 4294967295;
}

fn bswap32(x: i64) -> i64 {
    return ((x & 255) << 24) | (((x >> 8) & 255) << 16) | (((x >> 16) & 255) << 8) | ((x >> 24) & 255);
}

