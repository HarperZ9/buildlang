// Wave 128A (Slice 29: F1/AC1/N11/N49/N53): Pure-BuildLang Zero-C FIPS 203
// q=3329, n=256 ML-KEM-512 Ring-NTT + RFC 7748 X25519 Hybrid Post-Quantum Key
// Exchange (buildos_pq_hybrid_kem_zeroc.bld). Compiled with ZERO C compiler,
// ZERO Rust, and ZERO external linker across ALL FIVE zero-C ISAs.
//
// Modes:
//   0 = Clean ML-KEM-512 + X25519 hybrid key exchange & AEAD commit (status=1)
//   1 = Planted attack (a): 1-bit ML-KEM ciphertext tamper (FO reject) -> -101
//   2 = Planted attack (b): 1-bit X25519 peer public-key MITM -> -201
//   3 = Planted attack (c): Polynomial coeff out-of-range >= 3329 -> -301
//   4 = Planted attack (d): AEAD 1-bit Poly1305 tag tamper -> -401

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn bswap32(x: i64) -> i64 {
    return ((x & 255) << 24) | (((x >> 8) & 255) << 16) | (((x >> 16) & 255) << 8) | ((x >> 24) & 255);
}

fn sha256_iv(i: i64) -> i64 {
    if i == 0 { return 1779033703; }
    else if i == 1 { return 3144134277; }
    else if i == 2 { return 1013904242; }
    else if i == 3 { return 2773480762; }
    else if i == 4 { return 1359893119; }
    else if i == 5 { return 2600822924; }
    else if i == 6 { return 528734635; }
    else if i == 7 { return 1541459225; }
    return 0;
}

