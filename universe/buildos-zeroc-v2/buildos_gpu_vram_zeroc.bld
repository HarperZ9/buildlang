        let tc: i64 = gpu_ctx(p0 * 3 + 1);
        let cap: i64 = gpu_ctx(p0 * 3 + 2);
        if bt < 0 || tc <= 0 || bt + tc > 32 {
            println("{}", -202); println("{}", 0); return -202;
        }
        j = 0;
        while j < tc {
            if vram_owner[bt + j] != -1 {
                println("{}", -203); println("{}", 0); return -203;
            }
            vram_owner[bt + j] = p0;
            j = j + 1;
        }
        vram_buf[p0] = ((p0 & 15) << 24) | ((bt & 255) << 16) | ((tc & 255) << 8) | (cap & 15);
        vram_buf[4 + p0] = allow_shader_sha(p0 * 8);
        p0 = p0 + 1;
    }

    // =========================================================================
    // PHASE 2: Certified Shader Allowlist + VRAM Fence + Watchdog Command Queue
    // =========================================================================
    let mut total_wg: i64 = 0;
    p0 = 0;
    while p0 < 4 {
        let base: i64 = p0 * 8;
        let sid: i64 = gpu_disp(base);
        let cid: i64 = gpu_disp(base + 1);
        let rcap: i64 = gpu_disp(base + 2);
        let mut bbase: i64 = gpu_disp(base + 3);
        let blen: i64 = gpu_disp(base + 4);
        let mut gx: i64 = gpu_disp(base + 5);
        let mut gy: i64 = gpu_disp(base + 6);
        let gz: i64 = gpu_disp(base + 7);

