    let mut i: i64 = 0; let mut j: i64 = 0; let mut step: i64 = 0; let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;

    if wf1 != 129898652 || wf2 != 3233263671 {
        println("{}", -701); println("{}", 0); println("{}", 1); return -701;
    }

    // Compute 4 domain-separated pillar leaves L0..L3 = H(0x00 || pillar_root_k)
    step = 0;
    while step < 4 {
        i = 0; while i < 8 { hv[i] = cl_pillar_root_w(step * 8 + i); i = i + 1; }
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        w[0] = hv[0] >> 8;
        i = 1; while i < 8 { w[i] = (((hv[i - 1] & 255) << 24) | (hv[i] >> 8)) & m32; i = i + 1; }
        w[8] = (((hv[7] & 255) << 24) | 8388608) & m32; w[15] = 264;
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
        i = 0; while i < 8 { leaves[step * 8 + i] = hv[i]; i = i + 1; }
        step = step + 1;
    }

    // Internal nodes: step 0->N01, step 1->N23, step 2->CLUSTER_ROOT(N01, N23)
    step = 0;
    while step < 3 {
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p1 = 0;
        while p1 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if step < 2 {
                let lo: i64 = step * 16; let ro: i64 = lo + 8;
                if p1 == 0 {
                    w[0] = (16777216 | (leaves[lo] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[i] = (((leaves[lo + i - 1] & 255) << 24) | (leaves[lo + i] >> 8)) & m32; i = i + 1;
                    }
                    w[8] = (((leaves[lo + 7] & 255) << 24) | (leaves[ro] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[8 + i] = (((leaves[ro + i - 1] & 255) << 24) | (leaves[ro + i] >> 8)) & m32; i = i + 1;
                    }
                } else { w[0] = (((leaves[ro + 7] & 255) << 24) | 8388608) & m32; w[15] = 520; }
            } else {
                if p1 == 0 {
                    w[0] = (16777216 | (n01[0] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[i] = (((n01[i - 1] & 255) << 24) | (n01[i] >> 8)) & m32; i = i + 1;
                    }
                    w[8] = (((n01[7] & 255) << 24) | (leaves[0] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[8 + i] = (((leaves[i - 1] & 255) << 24) | (leaves[i] >> 8)) & m32; i = i + 1;
                    }
                } else { w[0] = (((leaves[7] & 255) << 24) | 8388608) & m32; w[15] = 520; }
            }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p1 = p1 + 1;
        }
        if step == 0 { i = 0; while i < 8 { n01[i] = hv[i]; i = i + 1; } }
        else if step == 1 { i = 0; while i < 8 { leaves[i] = hv[i]; i = i + 1; } }
        step = step + 1;
    }

    j = 1; i = 0; while i < 8 { if hv[i] != exp_cl_root(i) { j = 0; } i = i + 1; }
    if j == 0 { println("{}", -702); println("{}", 0); println("{}", 1); return -702; }

    // Emit unified BuildOS-2.1 Distributed Sovereign Cluster Commit Record (20 words)
    println("{}", 1);
    println("{}", 1);
    println("{}", 4);
    println("{}", 7);
    println("{}", 512);
    println("{}", 447);
    println("{}", exp_cl_witness(0));
    println("{}", exp_cl_witness(1));
    println("{}", exp_cl_witness(5));
    println("{}", exp_cl_witness(6));
    println("{}", exp_cl_witness(7));
    println("{}", exp_cl_witness(8));
    i = 0; while i < 8 { println("{}", hv[i]); i = i + 1; }
    return 1;
}

fn buildos_v21_cluster_run(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    // L1: QUIC-Lite Zero-Copy Encrypted Transport & CAP_NET_PEER Firewall (Attacks 1, 2)
    let w_quic: i64 = cl_l1_quic_firewall(mode);
    if w_quic < 0 { return w_quic; }

    // L2: Fuel-Metered Capability Sandbox Bytecode VM + SHA-256 Hostcall (Attack 3)
    let w_vm: i64 = cl_l2_sandbox_vm(mode);
    if w_vm < 0 { return w_vm; }

    // L3: Curve25519 Pedersen Opening + Homomorphic Balance + Fiat-Shamir Schnorr ZK (Attack 4)
    let rm: i64 = cl_l3_zk_merkle(0);
    if rm != 1 { return rm; }
    let w_open: i64 = cl_ed25519_eq(0, 0, 0, 0, -402);
    if w_open < 0 { return w_open; }
    let w_sum: i64 = cl_ed25519_eq(1, 0, 0, 0, -403);
    if w_sum < 0 { return w_sum; }
    let w_cin: i64 = cl_ed25519_eq(2, 0, 0, 0, -404);
    if w_cin < 0 { return w_cin; }
    let mut zk_slot: i64 = 3;
    if mode == 4 { zk_slot = 4; } // Attack (4): ZK value-inflation breach -> -401
    let w_zk: i64 = cl_ed25519_eq(zk_slot, 1, 0, 0, -401);
    if w_zk < 0 { return w_zk; }

    // L4: 4-Node 3/4 Ed25519 BFT Quorum Finality + Equivocation Slash (Attacks 5, 6)
    let rb: i64 = cl_l4_bft_chain_log(mode);
    if rb != 1 { return rb; }
    let w_ed0: i64 = cl_ed25519_eq(5, 1, 1, 0, -601);
    if w_ed0 < 0 { return w_ed0; }
    let mut bft_tamper: i64 = 0;
    if mode == 6 { bft_tamper = 1; } // Attack (6): 1-bit forged Ed25519 quorum sig (V1) -> -601
    let w_ed1: i64 = cl_ed25519_eq(6, 1, 1, bft_tamper, -601);
    if w_ed1 < 0 { return w_ed1; }
    let w_ed2: i64 = cl_ed25519_eq(7, 1, 1, 0, -601);
    if w_ed2 < 0 { return w_ed2; }

    // Bind every individual live witness across L1..L4 before L5 Cluster Root commit
    if w_quic != exp_cl_witness(0) || w_vm != exp_cl_witness(1) || w_open != exp_cl_witness(2) {
        println("{}", -701); println("{}", 0); println("{}", 1); return -701;
    }
    if w_sum != exp_cl_witness(3) || w_cin != exp_cl_witness(4) || w_zk != exp_cl_witness(5) {
        println("{}", -701); println("{}", 0); println("{}", 1); return -701;
    }
    if w_ed0 != exp_cl_witness(6) || w_ed1 != exp_cl_witness(7) || w_ed2 != exp_cl_witness(8) {
        println("{}", -701); println("{}", 0); println("{}", 1); return -701;
    }
    let wf1: i64 = (w_quic ^ w_vm ^ w_open ^ w_sum ^ w_cin) & m32;
    let wf2: i64 = (w_zk ^ w_ed0 ^ w_ed1 ^ w_ed2) & m32;
    return cl_l5_cluster_root(wf1, wf2);
}

fn main() ~ Console {
    let _ = buildos_v21_cluster_run(0);
}
