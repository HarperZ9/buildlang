}

fn cl_l2_sandbox_vm(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let fuel_budget: i64 = 512;
    let cap_mask: i64 = 3;
    let code_len: i64 = 42;

    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut mem: [i64; 32] = [0; 32];
    let mut stk: [i64; 16] = [0; 16];
    let mut regs: [i64; 8] = [0; 8];

    let mut pc: i64 = 0; let mut sp: i64 = 0;
    let mut fuel: i64 = fuel_budget; let mut fuel_used: i64 = 0;
    let mut host_out: i64 = 0; let mut trace_fold: i64 = 2654435769;
    let mut halted: i64 = 0;

    let mut i: i64 = 0; let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;

    while halted == 0 {
        // 1. Strict pre-instruction fuel metering (catches infinite loops fail-closed)
        if fuel <= 0 {
            println("{}", -301); println("{}", 0); println("{}", 1); return -301;
        }
        if pc < 0 || pc >= code_len {
            println("{}", -401); println("{}", 0); return -401;
        }
