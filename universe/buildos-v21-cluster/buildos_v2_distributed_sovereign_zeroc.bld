                b = h0 * st[81] + h1 * st[80] + h2 * (st[84] * 5) + h3 * (st[83] * 5) + h4 * (st[82] * 5);
                c = h0 * st[82] + h1 * st[81] + h2 * st[80] + h3 * (st[84] * 5) + h4 * (st[83] * 5);
                d = h0 * st[83] + h1 * st[82] + h2 * st[81] + h3 * st[80] + h4 * (st[84] * 5);
                e = h0 * st[84] + h1 * st[83] + h2 * st[82] + h3 * st[81] + h4 * st[80];
                cp = a >> 26; h0 = a & m26; b = b + cp;
                cp = b >> 26; h1 = b & m26; c = c + cp;
                cp = c >> 26; h2 = c & m26; d = d + cp;
                cp = d >> 26; h3 = d & m26; e = e + cp;
                cp = e >> 26; h4 = e & m26; h0 = h0 + cp * 5;
                cp = h0 >> 26; h0 = h0 & m26; h1 = h1 + cp;
