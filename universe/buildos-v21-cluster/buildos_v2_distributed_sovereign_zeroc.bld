        if mode == 3 && cur_pc == 23 { op = 13; arg = 4; }   // (a) Infinite-loop JMP 4 -> fuel exhaustion
        if mode == 92 && cur_pc == 32 { arg = 40; }           // (b) Linear-memory OOB write addr=40 >= 32
        if mode == 93 && cur_pc == 40 { arg = 3; }            // (c) Unauthorized HOST_NET_EGRESS (cap 4)
        if mode == 94 && cur_pc == 32 { arg = 1024; }         // (d) W^X code-segment write addr=1024

        trace_fold = (trace_fold * 33 + ((cur_pc << 8) ^ op ^ (sp << 16))) & m32;
        pc = pc + 1;

        if op == 1 {
            if sp >= 16 { println("{}", -202); println("{}", 0); return -202; }
            stk[sp] = arg & m32; sp = sp + 1;
        } else if op == 2 {
            if arg < 0 || arg >= 8 || sp >= 16 { println("{}", -202); println("{}", 0); return -202; }
            stk[sp] = regs[arg]; sp = sp + 1;
        } else if op == 3 {
            if arg < 0 || arg >= 8 || sp <= 0 { println("{}", -202); println("{}", 0); return -202; }
            sp = sp - 1; regs[arg] = stk[sp];
        } else if op == 4 || op == 5 || op == 6 || op == 7 {
            if sp < 2 { println("{}", -202); println("{}", 0); return -202; }
            sp = sp - 1; b = stk[sp]; sp = sp - 1; a = stk[sp];
            if op == 4 { stk[sp] = (a + b) & m32; }
            else if op == 5 { stk[sp] = (a - b) & m32; }
            else if op == 6 { stk[sp] = (a * b) & m32; }
            else { stk[sp] = (a ^ b) & m32; }
            sp = sp + 1;
        } else if op == 10 {
            if sp < 1 { println("{}", -202); println("{}", 0); return -202; }
            sp = sp - 1; a = stk[sp];
            if a < 0 || a >= 32 { println("{}", -201); println("{}", 0); return -201; }
            stk[sp] = mem[a]; sp = sp + 1;
        } else if op == 11 {
