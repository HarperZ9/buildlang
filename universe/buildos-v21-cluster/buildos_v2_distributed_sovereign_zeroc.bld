        d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
    }
    hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
    hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;

    // Step B: step=0 -> N01 = H(0x01 || sib_L0 || L1); step=1 -> ROOT = H(0x01 || N01 || sib_N23)
    step = 0;
