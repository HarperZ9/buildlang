    return cl_l1b_quic_commit(tx_fold, fw_fold, cwnd, bmp_lo);
}

fn cl_l2b_vm_commit(fuel_used: i64, host_out: i64, trace_fold: i64, gsha0: i64) -> i64 ~ Console {
