//
// Wave 54C (A7): Assumption-Mutating MAD/Huber 4-Sigma Contrarian Outlier Hunter.
// Scans 1,000 synthetic physical-law residuals using exact median + 1.4826*MAD
// + Huber IRLS location refinement: surfaces 3/3 planted >=4-sigma hidden anomalies
// (100% recall), holds clean-control FPR < 1%, and catches degenerate zero-MAD input.

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

// Deterministic insertion sort on small/medium f64 vectors (n = 1000 takes < 0.5 ms in -O3).
fn sort_f64(v: &Vec<f64>) -> Vec<f64> {
    let n: usize = v.len();
    let mut a: Vec<f64> = Vec::new();
    let mut i: usize = 0;
    while i < n {
        a.push(v[i]);
        i = i + 1;
    }
    i = 1;
    while i < n {
        let key: f64 = a[i];
        let mut j: usize = i;
        while j > 0 && a[j - 1] > key {
            a[j] = a[j - 1];
            j = j - 1;
        }
        a[j] = key;
        i = i + 1;
    }
    a
}

fn median_f64(v: &Vec<f64>) -> f64 {
    let s: Vec<f64> = sort_f64(v);
    let n: usize = s.len();
    if n == 0 {
        return 0.0;
    }
    if (n % 2) == 1 {
        return s[n / 2];
    }
    0.5 * (s[n / 2 - 1] + s[n / 2])
}

struct OutlierReport {
    rc: i32,
    loc_huber: f64,
    sigma_mad: f64,
    flagged_total: i32,
    planted_hits: i32,
    false_positives: i32,
}

// Run MAD/Huber 4-sigma outlier scan; planted_a/b/c are indices of planted anomalies (-1 if none).
fn scan_outliers(vals: &Vec<f64>, planted_a: i32, planted_b: i32, planted_c: i32) -> OutlierReport {
    let n: usize = vals.len();
    let med: f64 = median_f64(vals);
    let mut abs_dev: Vec<f64> = Vec::new();
    let mut i: usize = 0;
    while i < n {
        abs_dev.push(abs_f64(vals[i] - med));
        i = i + 1;
    }
    let mad: f64 = median_f64(&abs_dev);
    let sigma: f64 = 1.4826 * mad;
    if sigma <= 1.0e-12 {
        return OutlierReport {
            rc: -401,
            loc_huber: med,
            sigma_mad: 0.0,
            flagged_total: 0,
            planted_hits: 0,
            false_positives: 0,
        };
    }

    // 8 iterations of Huber IRLS (k = 1.345 * sigma) for robust location
    let k_hub: f64 = 1.345 * sigma;
    let mut mu: f64 = med;
    let mut it: i32 = 0;
    while it < 8 {
        let mut w_sum: f64 = 0.0;
        let mut wx_sum: f64 = 0.0;
        i = 0;
        while i < n {
            let r: f64 = abs_f64(vals[i] - mu);
            let w: f64 = if r <= k_hub { 1.0 } else { k_hub / r };
            w_sum = w_sum + w;
            wx_sum = wx_sum + w * vals[i];
            i = i + 1;
        }
        mu = wx_sum / w_sum;
        it = it + 1;
    }

    let mut total_flag: i32 = 0;
    let mut p_hits: i32 = 0;
    let mut fps: i32 = 0;
    i = 0;
    while i < n {
        let z: f64 = abs_f64(vals[i] - mu) / sigma;
        if z > 4.0 {
            total_flag = total_flag + 1;
            let idx_i: i32 = i as i32;
            if idx_i == planted_a || idx_i == planted_b || idx_i == planted_c {
                p_hits = p_hits + 1;
            } else {
                fps = fps + 1;
            }
        }
        i = i + 1;
    }

    OutlierReport {
        rc: 0,
        loc_huber: mu,
        sigma_mad: sigma,
        flagged_total: total_flag,
        planted_hits: p_hits,
        false_positives: fps,
    }
}

// Generate 1,000 deterministic approx-N(0,1) residuals via Irwin-Hall (sum of 12 U(0,1) - 6).
fn gen_residuals(n: usize) -> Vec<f64> {
    let mut out: Vec<f64> = Vec::new();
    let mut state: u64 = 987654321;
    let inv_m: f64 = 1.0 / 4294967296.0;
    let mut i: usize = 0;
    while i < n {
        let mut s: f64 = 0.0;
        let mut k: i32 = 0;
        while k < 12 {
            state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
            let u32_val: u64 = (state >> 32) & 0xffffffff;
            s = s + (u32_val as f64) * inv_m;
            k = k + 1;
        }
        out.push(s - 6.0);
        i = i + 1;
    }
    out
}

fn main() ~ Console + Clock {
    let t0: i64 = clock_ns();
    let clean: Vec<f64> = gen_residuals(1000);
    let r_clean: OutlierReport = scan_outliers(&clean, -1, -1, -1);

    let mut anom: Vec<f64> = gen_residuals(1000);
    anom[173] = 5.4;
    anom[519] = -4.9;
    anom[842] = 6.2;
    let r_anom: OutlierReport = scan_outliers(&anom, 173, 519, 842);

    // Planted degenerate zero-variance control (MAD == 0 -> rc == -401)
    let mut flat: Vec<f64> = Vec::new();
    let mut i: usize = 0;
    while i < 50 {
        flat.push(1.25);
        i = i + 1;
    }
    let r_flat: OutlierReport = scan_outliers(&flat, -1, -1, -1);

    let t1: i64 = clock_ns();
    let elapsed_ms: f64 = ((t1 - t0) as f64) / 1.0e6;

    let clean_fpr: f64 = (r_clean.false_positives as f64) / 1000.0;
    let mut failures: i32 = 0;
    if r_clean.rc != 0 || clean_fpr >= 0.01 {
        failures = failures + 1;
    }
    if r_anom.rc != 0 || r_anom.planted_hits != 3 || r_anom.false_positives >= 10 {
        failures = failures + 1;
    }
    if r_flat.rc != -401 {
        failures = failures + 1;
    }

    let p1: String = format!(
        "CONTRARY_SCANNER status={} failures={} elapsed_ms={:.4} clean_fpr={:.6} clean_flags={}",
        if failures == 0 { "PASS" } else { "FAIL" },
        failures,
        elapsed_ms,
        clean_fpr,
        r_clean.flagged_total
    );
    let p2: String = format!(
        "anom_recall={}/3 anom_fp={} loc_huber={:.9} sigma_mad={:.9} rc_zero_mad={}",
        r_anom.planted_hits,
        r_anom.false_positives,
        r_anom.loc_huber,
        r_anom.sigma_mad,
        r_flat.rc
    );
    println!("{} {}", p1, p2);
}
