//
// Wave 57E Author Idea AC6 (STA-065): Sensor-First Developmental Model Bootstrapping
// Native BuildLang (buildc 1.15.0 --release --superopt --emit-cert, safe String ops only):
//   Starts from 4 minimal reflex priors (gradient seek, boundary avoid, energy conserve,
//   surprise attend) with strictly O(1) bounded sensory ring buffer (32 slots) and grows a
//   2-level hierarchical sensory predictor over 200 sequential steps:
//     - Proves hierarchical prediction error drops by >= 75% (final < 0.25 * init).
//     - Maintains zero boundary collisions and positive energy reserve.
//     - Planted Control: zero-sensor blind agent (sensor_mask = 0) fails beacon tracking &
//       violates survival/boundary guard fail-closed (rc == -1).

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    x
}

fn clamp_f64(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { return lo; }
    if x > hi { return hi; }
    x
}

// Run 200-step developmental sensory stream; sensor_enabled=false is the planted blind control.
// Writes [init_pred_err, final_pred_err, final_dist, final_energy, collisions] into out5.
// Returns 0 on healthy survival, -1 fail-closed on blind/sensor-loss failure.
fn run_developmental_agent(sensor_enabled: bool, out5: &mut Vec<f64>) -> i32 {
    let mut pos: f64 = -2.2;
    let mut vel: f64 = 0.0;
    let mut energy: f64 = 100.0;
    let beacon: f64 = 1.6;
    let wall_limit: f64 = 3.0;
    let mut collisions: i32 = 0;

    // Strictly bounded O(1) 32-slot circular sensory ring buffer
    let cap: usize = 32;
    let mut ring: Vec<f64> = Vec::new();
    let mut i: usize = 0;
    while i < cap { ring.push(0.0); i = i + 1; }

    // Compact hierarchical predictor weights: pred_next_s = a0 * s_now + a1 * u_now + a2 * s_prev
    let mut a0: f64 = 0.25;
    let mut a1: f64 = 0.05;
    let mut a2: f64 = 0.0;
    let mut s_prev: f64 = beacon - pos;
    let mut init_err_sum: f64 = 0.0;
    let mut final_err_sum: f64 = 0.0;
    let mut reflex_gain: f64 = 0.35;

    let steps: usize = 200;
    let mut t: usize = 0;
    while t < steps {
        // Sensory observation (distance gradient to beacon + wall proximity); zeroed when blind!
        let true_grad: f64 = beacon - pos;
        let obs_grad: f64 = if sensor_enabled { true_grad } else { 0.0 };
        let obs_pos: f64 = if sensor_enabled { pos } else { 0.0 };

        // 4 Minimal Reflex Priors:
        //   R0: gradient seek toward beacon
        //   R1: boundary avoid near |pos| > 2.4
        //   R2: energy conserve (clamp actuator effort)
        //   R3: surprise attend (boost learning rate when prediction error spikes)
        let mut u: f64 = reflex_gain * obs_grad - 0.25 * vel;
        if !sensor_enabled {
            // Blind drift without sensory grounding
            u = 0.45;
        }
        if obs_pos > 2.4 { u = u - 1.5 * (obs_pos - 2.4); }
        if obs_pos < -2.4 { u = u - 1.5 * (obs_pos + 2.4); }
        u = clamp_f64(u, -0.85, 0.85);

        // Level-1 sensory prediction before world step
        let pred_next: f64 = a0 * obs_grad + a1 * u + a2 * s_prev;

        // World physics step (dt = 0.15)
        vel = 0.85 * vel + 0.15 * u;
        pos = pos + 0.15 * vel;
        if abs_f64(pos) > wall_limit {
            collisions = collisions + 1;
            pos = clamp_f64(pos, -wall_limit, wall_limit);
            vel = -0.3 * vel;
        }
        energy = energy - (0.08 + 0.25 * u * u);
        if abs_f64(beacon - pos) < 0.35 {
            energy = energy + 0.30;
        }

        let next_obs: f64 = if sensor_enabled { beacon - pos } else { 0.0 };
        let pe: f64 = next_obs - pred_next;
        let abs_pe: f64 = abs_f64(pe);

        if t < 15 { init_err_sum = init_err_sum + abs_pe; }
        if t >= steps - 30 { final_err_sum = final_err_sum + abs_pe; }

        // Write bounded circular buffer (strictly 32 slots max!)
        ring[t % cap] = next_obs;

        // Surprise-gated Level-1 predictor update + Level-2 slow meta-gain adaptation
        let surprise_lr: f64 = clamp_f64(0.08 + 0.15 * abs_pe, 0.08, 0.22);
        let norm2: f64 = 1.0 + obs_grad * obs_grad + u * u + s_prev * s_prev;
        a0 = a0 + (surprise_lr * pe * obs_grad) / norm2;
        a1 = a1 + (surprise_lr * pe * u) / norm2;
        a2 = a2 + (surprise_lr * pe * s_prev) / norm2;
        if sensor_enabled && abs_pe < 0.08 && reflex_gain < 0.65 {
            reflex_gain = reflex_gain + 0.005;
        }
        s_prev = obs_grad;
        t = t + 1;
    }

    let init_err: f64 = init_err_sum / 15.0;
    let final_err: f64 = final_err_sum / 30.0;
    let final_dist: f64 = abs_f64(beacon - pos);
    out5[0] = init_err;
    out5[1] = final_err;
    out5[2] = final_dist;
    out5[3] = energy;
    out5[4] = collisions as f64;

    if !sensor_enabled || collisions > 0 || final_dist > 0.25 || energy <= 0.0 {
        return -1;
    }
    0
}

fn main() ~ Console + Clock {
    let mut failures: i32 = 0;
    let t0: i64 = clock_ns();

    let mut out_ok: Vec<f64> = Vec::new();
    let mut out_blind: Vec<f64> = Vec::new();
    let mut i: usize = 0;
    while i < 5 { out_ok.push(0.0); out_blind.push(0.0); i = i + 1; }

    let rc_ok: i32 = run_developmental_agent(true, &mut out_ok);
    let rc_blind: i32 = run_developmental_agent(false, &mut out_blind);

    let init_err: f64 = out_ok[0];
    let final_err: f64 = out_ok[1];
    let err_ratio: f64 = final_err / (if init_err > 1.0e-12 { init_err } else { 1.0e-12 });
    let final_dist: f64 = out_ok[2];
    let final_energy: f64 = out_ok[3];
    let blind_collisions: f64 = out_blind[4];
    let blind_dist: f64 = out_blind[2];
    let ctrl_blind_caught: bool = rc_blind == -1 && blind_collisions > 0.0 && blind_dist > 1.0;

    if rc_ok != 0 || err_ratio >= 0.25 || !ctrl_blind_caught {
        failures = failures + 1;
    }
    let t1: i64 = clock_ns();
    let elapsed_ns: i64 = t1 - t0;

    println!(
        "METRIC init_pred_err={:.12} final_pred_err={:.12} err_ratio={:.12} final_dist={:.12}",
        init_err, final_err, err_ratio, final_dist
    );
    println!(
        "METRIC final_energy={:.12} blind_collisions={:.1} blind_dist={:.12} ctrl_blind_caught={} elapsed_ns={}",
        final_energy, blind_collisions, blind_dist, ctrl_blind_caught, elapsed_ns
    );
    println!("SUMMARY failures={}", failures);
}
