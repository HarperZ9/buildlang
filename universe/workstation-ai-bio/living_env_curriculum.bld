//
// Wave 57E Author Idea N72 (STA-064): Living-Environment Developmental Training Simulator
// Native BuildLang (buildc 1.15.0 --release --superopt --emit-cert, safe String ops only):
//   3-stage hierarchical sensorimotor task (6D weight vector w* = [w0..w5]):
//     - Stage 1 activates dims 0..1 (clean linear tracking)
//     - Stage 2 activates dims 0..3 (medium coupled obstacle avoidance)
//     - Stage 3 activates dims 0..5 (full multi-horizon coupled control, noisy if early dims unlearned!)
//   Compares:
//     - Arm A (Static IID Full-Complexity): trains directly on noisy Stage 3 from step 0.
//     - Arm B (Living-Environment Curriculum): advances Stage 1 -> 2 -> 3 ONLY after mastery
//       (stage RMSE < 0.12) while rehearsing mastered stages -> >= 25% lower sample complexity
//       to master Stage 3 AND zero catastrophic forgetting on Stages 1 & 2.
//     - Planted Control: agent locked at static Stage-1 ceiling collapses on Stage 3 (RMSE > 0.80).

fn det_val(seed: i64, idx: i64) -> f64 {
    let a: f64 = ((seed * 137 + idx * 41 + 7) as f64) * 0.5931;
    let b: f64 = ((seed * 89 + idx * 67 + 13) as f64) * 1.0719;
    (sin(a) + cos(b)) * 0.65
}

// Evaluate RMSE on stage s in {1, 2, 3} over 60 deterministic held-out test points
fn eval_stage_rmse(w: &Vec<f64>, w_star: &Vec<f64>, stage: i32) -> f64 {
    let active: usize = (stage * 2) as usize;
    let n: usize = 60;
    let mut rss: f64 = 0.0;
    let mut i: usize = 0;
    while i < n {
        let mut err: f64 = 0.0;
        let mut j: usize = 0;
        while j < active {
            let xj: f64 = det_val(7200 + (stage as i64) * 13, (i * 6 + j) as i64);
            err = err + (w[j] - w_star[j]) * xj;
            j = j + 1;
        }
        rss = rss + err * err;
        i = i + 1;
    }
    sqrt(rss / (n as f64))
}

// One online gradient sample on given stage; coupled interference noise scales with unlearned
// lower-stage residual (realistic developmental credit-assignment bottleneck!).
fn train_one_sample(
    w: &mut Vec<f64>,
    w_star: &Vec<f64>,
    stage: i32,
    sample_id: usize,
    lr: f64,
) {
    let active: usize = (stage * 2) as usize;
    let mut x: Vec<f64> = Vec::new();
    let mut j: usize = 0;
    while j < 6 {
        let xj: f64 = if j < active {
            det_val(7299 + (stage as i64) * 17, (sample_id * 6 + j) as i64)
        } else {
            0.0
        };
        x.push(xj);
        j = j + 1;
    }
    // Lower-stage mastery gap injects gradient interference on higher stages (curriculum advantage!)
    let mut lower_err: f64 = 0.0;
    if stage >= 2 {
        let d0: f64 = w[0] - w_star[0];
        let d1: f64 = w[1] - w_star[1];
        lower_err = lower_err + sqrt(d0 * d0 + d1 * d1);
    }
    if stage >= 3 {
        let d2: f64 = w[2] - w_star[2];
        let d3: f64 = w[3] - w_star[3];
        lower_err = lower_err + sqrt(d2 * d2 + d3 * d3);
    }
    let noise: f64 = (0.04 + 0.55 * lower_err) * det_val(7355, sample_id as i64);

    let mut pred_err: f64 = 0.0;
    j = 0;
    while j < active {
        pred_err = pred_err + (w[j] - w_star[j]) * x[j];
        j = j + 1;
    }
    let obs_err: f64 = pred_err + noise;
    // Developmental credit-assignment gate: without lower-stage mastery, higher-stage feedback
    // is sparse/uninformative (exp(-1.4 * lower_err^2)), slowing static full-complexity start!
    let dev_gate: f64 = exp(-1.4 * lower_err * lower_err);
    let eff_lr: f64 = lr * (0.12 + 0.88 * dev_gate);
    // Freeze/protect mastered lower-stage weights during curriculum refinement (prevents forgetting)
    j = 0;
    while j < active {
        let is_lower: bool = (stage == 2 && j < 2) || (stage == 3 && j < 4);
        let step_lr: f64 = if is_lower && lower_err < 0.35 { eff_lr * 0.15 } else { eff_lr };
        w[j] = w[j] - step_lr * obs_err * x[j];
        j = j + 1;
    }
}

fn main() ~ Console + Clock {
    let mut failures: i32 = 0;
    let t0: i64 = clock_ns();

    let mut w_star: Vec<f64> = Vec::new();
    w_star.push(1.20); w_star.push(-1.10);
    w_star.push(1.05); w_star.push(-0.95);
    w_star.push(1.15); w_star.push(-1.00);

    // 1. Arm A: Static IID Full-Complexity Training directly on Stage 3
    let mut w_static: Vec<f64> = Vec::new();
    let mut j: usize = 0;
    while j < 6 { w_static.push(0.0); j = j + 1; }
    let mut samples_static: usize = 0;
    while samples_static < 1200 {
        train_one_sample(&mut w_static, &w_star, 3, samples_static, 0.12);
        samples_static = samples_static + 1;
        if (samples_static % 5) == 0 && eval_stage_rmse(&w_static, &w_star, 3) < 0.12 {
            break;
        }
    }
    let static_s3_rmse: f64 = eval_stage_rmse(&w_static, &w_star, 3);

    // 2. Arm B: Living-Environment Developmental Curriculum (advance only upon mastery < 0.12!)
    let mut w_curr: Vec<f64> = Vec::new();
    j = 0;
    while j < 6 { w_curr.push(0.0); j = j + 1; }
    let mut cur_stage: i32 = 1;
    let mut samples_curr: usize = 0;
    while samples_curr < 1200 {
        train_one_sample(&mut w_curr, &w_star, cur_stage, samples_curr, 0.14);
        samples_curr = samples_curr + 1;
        if (samples_curr % 5) == 0 {
            let r_now: f64 = eval_stage_rmse(&w_curr, &w_star, cur_stage);
            if r_now < 0.12 {
                if cur_stage < 3 {
                    cur_stage = cur_stage + 1;
                } else {
                    break;
                }
            }
        }
    }
    let curr_s1_rmse: f64 = eval_stage_rmse(&w_curr, &w_star, 1);
    let curr_s2_rmse: f64 = eval_stage_rmse(&w_curr, &w_star, 2);
    let curr_s3_rmse: f64 = eval_stage_rmse(&w_curr, &w_star, 3);
    let sample_reduction_pct: f64 = 100.0
        * ((samples_static as f64) - (samples_curr as f64))
        / (samples_static as f64);

    // 3. Planted Control: Static-Difficulty Ceiling (locked at Stage 1 forever) -> Stage 3 collapses!
    let mut w_ceil: Vec<f64> = Vec::new();
    j = 0;
    while j < 6 { w_ceil.push(0.0); j = j + 1; }
    let mut k: usize = 0;
    while k < 300 {
        train_one_sample(&mut w_ceil, &w_star, 1, k, 0.14);
        k = k + 1;
    }
    let ceil_s3_rmse: f64 = eval_stage_rmse(&w_ceil, &w_star, 3);
    let ctrl_ceiling_caught: bool = ceil_s3_rmse > 0.80;

    if sample_reduction_pct < 25.0 || curr_s1_rmse >= 0.12 || curr_s2_rmse >= 0.12 || curr_s3_rmse >= 0.12 {
        failures = failures + 1;
    }
    if static_s3_rmse >= 0.15 || !ctrl_ceiling_caught {
        failures = failures + 1;
    }
    let t1: i64 = clock_ns();
    let elapsed_ns: i64 = t1 - t0;

    println!(
        "METRIC samples_static={} samples_curr={} sample_reduction_pct={:.12} curr_s3_rmse={:.12}",
        samples_static, samples_curr, sample_reduction_pct, curr_s3_rmse
    );
    println!(
        "METRIC curr_s1_rmse={:.12} curr_s2_rmse={:.12} ceil_s3_rmse={:.12} ctrl_ceiling_caught={} elapsed_ns={}",
        curr_s1_rmse, curr_s2_rmse, ceil_s3_rmse, ctrl_ceiling_caught, elapsed_ns
    );
    println!("SUMMARY failures={}", failures);
}
