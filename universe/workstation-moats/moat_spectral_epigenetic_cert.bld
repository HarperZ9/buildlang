// Wave 65C (Moat 9, STA-071; J13, N33, N49): Weights-Only Spectral Epigenetics
// Certificate Kernel. Computes deflated power-iteration top-3 singular values,
// sigma1/sigma2 decay ratios, and Shannon effective rank exp(H_s) across 16 8x8
// LoRA weight-delta matrices (zero inference calls!), classifies clean vs rank-
// collapse shortcuts (100% separation), and seals the certificate with pure-BuildLang
// FIPS 180-4 SHA-256 + planted forged digest and rank-1 shortcut bypass controls.

fn rotr32(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

fn sha256_k() -> Vec<u32> {
    let mut k: Vec<u32> = Vec::new();
    k.push(0x428a2f98); k.push(0x71374491); k.push(0xb5c0fbcf); k.push(0xe9b5dba5);
    k.push(0x3956c25b); k.push(0x59f111f1); k.push(0x923f82a4); k.push(0xab1c5ed5);
    k.push(0xd807aa98); k.push(0x12835b01); k.push(0x243185be); k.push(0x550c7dc3);
    k.push(0x72be5d74); k.push(0x80deb1fe); k.push(0x9bdc06a7); k.push(0xc19bf174);
    k.push(0xe49b69c1); k.push(0xefbe4786); k.push(0x0fc19dc6); k.push(0x240ca1cc);
    k.push(0x2de92c6f); k.push(0x4a7484aa); k.push(0x5cb0a9dc); k.push(0x76f988da);
    k.push(0x983e5152); k.push(0xa831c66d); k.push(0xb00327c8); k.push(0xbf597fc7);
    k.push(0xc6e00bf3); k.push(0xd5a79147); k.push(0x06ca6351); k.push(0x14292967);
    k.push(0x27b70a85); k.push(0x2e1b2138); k.push(0x4d2c6dfc); k.push(0x53380d13);
    k.push(0x650a7354); k.push(0x766a0abb); k.push(0x81c2c92e); k.push(0x92722c85);
    k.push(0xa2bfe8a1); k.push(0xa81a664b); k.push(0xc24b8b70); k.push(0xc76c51a3);
    k.push(0xd192e819); k.push(0xd6990624); k.push(0xf40e3585); k.push(0x106aa070);
    k.push(0x19a4c116); k.push(0x1e376c08); k.push(0x2748774c); k.push(0x34b0bcb5);
    k.push(0x391c0cb3); k.push(0x4ed8aa4a); k.push(0x5b9cca4f); k.push(0x682e6ff3);
    k.push(0x748f82ee); k.push(0x78a5636f); k.push(0x84c87814); k.push(0x8cc70208);
    k.push(0x90befffa); k.push(0xa4506ceb); k.push(0xbef9a3f7); k.push(0xc67178f2);
    k
}

fn sha256_bytes(msg: &Vec<u32>, k_tbl: &Vec<u32>) -> Vec<u32> {
    let orig_len: usize = msg.len();
    let bit_len: u64 = (orig_len as u64) * 8;
    let mut buf: Vec<u32> = Vec::new();
    let mut i: usize = 0;
    while i < orig_len { buf.push(msg[i] & 255); i = i + 1; }
    buf.push(0x80);
    while (buf.len() % 64) != 56 { buf.push(0); }
    let mut shift: u64 = 56;
    let mut bi: i32 = 0;
    while bi < 8 {
        buf.push(((bit_len >> shift) & 255) as u32);
        if shift >= 8 { shift = shift - 8; }
        bi = bi + 1;
    }

    let mut h0: u32 = 0x6a09e667; let mut h1: u32 = 0xbb67ae85;
    let mut h2: u32 = 0x3c6ef372; let mut h3: u32 = 0xa54ff53a;
    let mut h4: u32 = 0x510e527f; let mut h5: u32 = 0x9b05688c;
    let mut h6: u32 = 0x1f83d9ab; let mut h7: u32 = 0x5be0cd19;
    let mut w: Vec<u32> = Vec::new();
    i = 0;
    while i < 64 { w.push(0); i = i + 1; }

    let total_bytes: usize = buf.len();
    let mut off: usize = 0;
    while off < total_bytes {
        let mut t: usize = 0;
        while t < 16 {
            let p: usize = off + t * 4;
            w[t] = (buf[p] << 24) | (buf[p + 1] << 16) | (buf[p + 2] << 8) | buf[p + 3];
            t = t + 1;
        }
        while t < 64 {
            let s0: u32 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3);
            let s1: u32 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10);
            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);
            t = t + 1;
        }
        let mut a: u32 = h0; let mut b: u32 = h1; let mut c: u32 = h2; let mut d: u32 = h3;
        let mut e: u32 = h4; let mut f: u32 = h5; let mut g: u32 = h6; let mut h: u32 = h7;
        t = 0;
        while t < 64 {
            let s1: u32 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch: u32 = (e & f) ^ ((!e) & g);
            let t1: u32 = h.wrapping_add(s1).wrapping_add(ch).wrapping_add(k_tbl[t]).wrapping_add(w[t]);
            let s0: u32 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj: u32 = (a & b) ^ (a & c) ^ (b & c);
            let t2: u32 = s0.wrapping_add(maj);
            h = g; g = f; f = e; e = d.wrapping_add(t1);
            d = c; c = b; b = a; a = t1.wrapping_add(t2);
            t = t + 1;
        }
        h0 = h0.wrapping_add(a); h1 = h1.wrapping_add(b);
        h2 = h2.wrapping_add(c); h3 = h3.wrapping_add(d);
        h4 = h4.wrapping_add(e); h5 = h5.wrapping_add(f);
        h6 = h6.wrapping_add(g); h7 = h7.wrapping_add(h);
        off = off + 64;
    }

    let mut out: Vec<u32> = Vec::new();
    let mut words: Vec<u32> = Vec::new();
    words.push(h0); words.push(h1); words.push(h2); words.push(h3);
    words.push(h4); words.push(h5); words.push(h6); words.push(h7);
    let mut wi: usize = 0;
    while wi < 8 {
        let val: u32 = words[wi];
        out.push((val >> 24) & 255); out.push((val >> 16) & 255);
        out.push((val >> 8) & 255); out.push(val & 255);
        wi = wi + 1;
    }
    out
}

fn hex_nibble(n: u32) -> String {
    let digits: String = "0123456789abcdef";
    digits.char_at((n & 15) as usize)
}

fn digest_to_hex(d: &Vec<u32>) -> String {
    let mut hex: String = "";
    let mut i: usize = 0;
    while i < 32 {
        let b: u32 = d[i];
        hex = format!("{}{}{}", hex, hex_nibble(b >> 4), hex_nibble(b & 15));
        i = i + 1;
    }
    hex
}

fn build_ascii_lut() -> HashMap<String, u32> {
    let mut lut: HashMap<String, u32> = HashMap::new();
    let printable: String = format!(
        "{}{}{}",
        " !\"#$%&'()*+,-./0123456789:;<=>?@",
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`",
        "abcdefghijklmnopqrstuvwxyz{|}~"
    );
    let n: usize = printable.len();
    let mut i: usize = 0;
    while i < n {
        lut.insert(printable.char_at(i), (32 + i) as u32);
        i = i + 1;
    }
    lut
}

fn sha256_str(s: &String, lut: &HashMap<String, u32>, k_tbl: &Vec<u32>) -> String {
    let n: usize = s.len();
    let mut bytes: Vec<u32> = Vec::new();
    let mut i: usize = 0;
    while i < n {
        let ch: String = s.char_at(i);
        match lut.get(&ch) {
            Some(v) => bytes.push(v),
            None => bytes.push(63),
        }
        i = i + 1;
    }
    digest_to_hex(&sha256_bytes(&bytes, k_tbl))
}

fn ln_f64(x_in: f64) -> f64 {
    if x_in <= 0.0 { return 0.0; }
    let mut x: f64 = x_in;
    let mut k: i32 = 0;
    let ln2: f64 = 0.6931471805599453;
    while x > 1.4142135623730951 { x = x * 0.5; k = k + 1; }
    while x < 0.7071067811865476 { x = x * 2.0; k = k - 1; }
    let u: f64 = (x - 1.0) / (x + 1.0);
    let u2: f64 = u * u;
    let mut term: f64 = u;
    let mut sum: f64 = u;
    let mut n: i32 = 3;
    while n <= 25 {
        term = term * u2;
        sum = sum + term / (n as f64);
        n = n + 2;
    }
    2.0 * sum + (k as f64) * ln2
}

fn exp_f64(x_in: f64) -> f64 {
    let ln2: f64 = 0.6931471805599453;
    let kf: f64 = x_in / ln2;
    let k: i32 = if kf >= 0.0 { (kf + 0.5) as i32 } else { (kf - 0.5) as i32 };
    let r: f64 = x_in - (k as f64) * ln2;
    let mut term: f64 = 1.0;
    let mut sum: f64 = 1.0;
    let mut n: i32 = 1;
    while n <= 20 {
        term = term * r / (n as f64);
        sum = sum + term;
        n = n + 1;
    }
    let mut scale: f64 = 1.0;
    let mut i: i32 = 0;
    if k > 0 {
        while i < k { scale = scale * 2.0; i = i + 1; }
    } else {
        while i < -k { scale = scale * 0.5; i = i + 1; }
    }
    sum * scale
}

// Construct deterministic 8x8 LoRA weight-delta matrix A = sum_{r=0..3} s_r * u_r * v_r^T
// using exact orthogonal Hadamard columns u_r, v_r (norm 1) so singular values are exact s_r.
fn hadamard_sign(row: usize, col: usize) -> f64 {
    let mut x: usize = row & col;
    let mut parity: usize = 0;
    while x > 0 {
        parity = parity ^ (x & 1);
        x = x >> 1;
    }
    if parity == 0 { 0.3535533905932738 } else { -0.3535533905932738 }
}

fn build_lora_delta(s0: f64, s1: f64, s2: f64, s3: f64, perm_shift: usize) -> Vec<f64> {
    let mut a: Vec<f64> = Vec::new();
    let mut r: usize = 0;
    while r < 8 {
        let mut c: usize = 0;
        while c < 8 {
            let v: f64 = s0 * hadamard_sign(r, (0 + perm_shift) & 7) * hadamard_sign(c, 0)
                + s1 * hadamard_sign(r, (1 + perm_shift) & 7) * hadamard_sign(c, 1)
                + s2 * hadamard_sign(r, (2 + perm_shift) & 7) * hadamard_sign(c, 2)
                + s3 * hadamard_sign(r, (3 + perm_shift) & 7) * hadamard_sign(c, 3);
            a.push(v);
            c = c + 1;
        }
        r = r + 1;
    }
    a
}

struct SpectralStats {
    sigma1: f64,
    sigma2: f64,
    sigma3: f64,
    ratio12: f64,
    eff_rank: f64,
}

// Compute Gram G = A^T A (8x8) and extract top-3 singular values via deflated power iteration.
fn analyze_spectrum(a: &Vec<f64>) -> SpectralStats {
    let mut g: Vec<f64> = Vec::new();
    let mut i: usize = 0;
    while i < 8 {
        let mut j: usize = 0;
        while j < 8 {
            let mut dot: f64 = 0.0;
            let mut k: usize = 0;
            while k < 8 {
                dot = dot + a[k * 8 + i] * a[k * 8 + j];
                k = k + 1;
            }
            g.push(dot);
            j = j + 1;
        }
        i = i + 1;
    }

    let mut sigmas: Vec<f64> = Vec::new();
    let mut comp: usize = 0;
    while comp < 3 {
        let mut v: Vec<f64> = Vec::new();
        i = 0;
        while i < 8 {
            v.push(1.0 + 0.13 * ((i + comp + 1) as f64));
            i = i + 1;
        }
        let mut it: i32 = 0;
        while it < 60 {
            let mut w: Vec<f64> = Vec::new();
            let mut norm2: f64 = 0.0;
            i = 0;
            while i < 8 {
                let mut acc: f64 = 0.0;
                let mut j: usize = 0;
                while j < 8 {
                    acc = acc + g[i * 8 + j] * v[j];
                    j = j + 1;
                }
                w.push(acc);
                norm2 = norm2 + acc * acc;
                i = i + 1;
            }
            let nrm: f64 = if norm2 > 1.0e-30 { sqrt(norm2) } else { 1.0 };
            i = 0;
            while i < 8 { v[i] = w[i] / nrm; i = i + 1; }
            it = it + 1;
        }
        // Rayleigh quotient lambda = v^T G v
        let mut lam: f64 = 0.0;
        i = 0;
        while i < 8 {
            let mut j: usize = 0;
            while j < 8 {
                lam = lam + v[i] * g[i * 8 + j] * v[j];
                j = j + 1;
            }
            i = i + 1;
        }
        if lam < 0.0 { lam = 0.0; }
        sigmas.push(sqrt(lam));
        // Hotelling deflation: G <- G - lambda * v v^T
        i = 0;
        while i < 8 {
            let mut j: usize = 0;
            while j < 8 {
                g[i * 8 + j] = g[i * 8 + j] - lam * v[i] * v[j];
                j = j + 1;
            }
            i = i + 1;
        }
        comp = comp + 1;
    }

    let s1: f64 = sigmas[0];
    let s2: f64 = sigmas[1];
    let s3: f64 = sigmas[2];
    let ratio12: f64 = if s2 > 1.0e-12 { s1 / s2 } else { 1.0e6 };
    let total: f64 = s1 + s2 + s3;
    let p1: f64 = s1 / total;
    let p2: f64 = s2 / total;
    let p3: f64 = s3 / total;
    let mut h_s: f64 = 0.0;
    if p1 > 1.0e-15 { h_s = h_s - p1 * ln_f64(p1); }
    if p2 > 1.0e-15 { h_s = h_s - p2 * ln_f64(p2); }
    if p3 > 1.0e-15 { h_s = h_s - p3 * ln_f64(p3); }
    SpectralStats { sigma1: s1, sigma2: s2, sigma3: s3, ratio12: ratio12, eff_rank: exp_f64(h_s) }
}

// Fail-closed weights-only epigenetic classifier: 0=CLEAN, -952=RANK_COLLAPSE_SHORTCUT.
fn classify_spectral(st: &SpectralStats) -> i32 {
    if st.ratio12 <= 2.5 && st.eff_rank >= 2.2 { 0 } else { -952 }
}

// Fail-closed spectral certificate digest verifier: 0=VALID, -951=FORGED_DIGEST.
fn verify_cert_digest(expected_hex: &String, claimed_hex: &String) -> i32 {
    if expected_hex.len() != 64 || claimed_hex.len() != 64 { return -951; }
    let mut i: usize = 0;
    while i < 64 {
        if expected_hex.char_at(i) != claimed_hex.char_at(i) { return -951; }
        i = i + 1;
    }
    0
}

fn main() ~ Console + Clock {
    let t0: i64 = clock_ns();
    let k_tbl: Vec<u32> = sha256_k();
    let lut: HashMap<String, u32> = build_ascii_lut();

    // 16 8x8 LoRA weight-delta matrices: 0..7 clean full-rank, 8..15 shortcut rank-collapse
    let mut clean_ok: i32 = 0;
    let mut collapse_ok: i32 = 0;
    let mut c0_r12: f64 = 0.0;
    let mut c0_er: f64 = 0.0;
    let mut k0_r12: f64 = 0.0;
    let mut k0_er: f64 = 0.0;

    let mut m: usize = 0;
    while m < 16 {
        let mut s0: f64 = 0.0;
        let mut s1: f64 = 0.0;
        let mut s2: f64 = 0.0;
        let mut s3: f64 = 0.0;
        if m < 8 {
            let mf: f64 = m as f64;
            s0 = 3.2 + 0.15 * mf;
            s1 = 2.4 + 0.10 * mf;
            s2 = 1.7 + 0.08 * mf;
            s3 = 0.4 + 0.02 * mf;
        } else {
            let mf: f64 = (m - 8) as f64;
            s0 = 6.0 + 0.25 * mf;
            s1 = 0.85 + 0.04 * mf;
            s2 = 0.25 + 0.02 * mf;
            s3 = 0.05;
        }
        let mat: Vec<f64> = build_lora_delta(s0, s1, s2, s3, m & 7);
        let st: SpectralStats = analyze_spectrum(&mat);
        let rc: i32 = classify_spectral(&st);
        if m == 0 { c0_r12 = st.ratio12; c0_er = st.eff_rank; }
        if m == 8 { k0_r12 = st.ratio12; k0_er = st.eff_rank; }
        if m < 8 && rc == 0 { clean_ok = clean_ok + 1; }
        if m >= 8 && rc == -952 { collapse_ok = collapse_ok + 1; }
        m = m + 1;
    }

    let payload: String = format!(
        "moat9|n=16|clean={}|collapse={}|c0_r12={:.6}|c0_er={:.6}|k0_r12={:.6}|k0_er={:.6}",
        clean_ok, collapse_ok, c0_r12, c0_er, k0_r12, k0_er
    );
    let cert_hex: String = sha256_str(&payload, &lut, &k_tbl);

    // Planted controls:
    // 1. Forged digest (first nibble flipped) -> -951
    let mut bad_hex: String = if cert_hex.char_at(0) == "0" { "1" } else { "0" };
    let mut hi: usize = 1;
    while hi < 64 {
        bad_hex = format!("{}{}", bad_hex, cert_hex.char_at(hi));
        hi = hi + 1;
    }
    let rc_valid_cert: i32 = verify_cert_digest(&cert_hex, &cert_hex);
    let rc_forged_cert: i32 = verify_cert_digest(&cert_hex, &bad_hex);

    // 2. Planted rank-1 shortcut bypass matrix (s0=9.0, s1=0.01, s2=0.001) -> -952
    let rank1_mat: Vec<f64> = build_lora_delta(9.0, 0.01, 0.001, 0.0, 2);
    let rank1_st: SpectralStats = analyze_spectrum(&rank1_mat);
    let rc_rank1_bypass: i32 = classify_spectral(&rank1_st);

    let t1: i64 = clock_ns();
    let elapsed_ms: f64 = ((t1 - t0) as f64) / 1.0e6;

    let mut failures: i32 = 0;
    if clean_ok != 8 || collapse_ok != 8 { failures = failures + 1; }
    if rc_valid_cert != 0 || rc_forged_cert != -951 || rc_rank1_bypass != -952 {
        failures = failures + 1;
    }

    let st_lbl: String = if failures == 0 { "PASS" } else { "FAIL" };
    println!(
        "SPECTRAL_CERT status={} failures={} elapsed_ms={:.4} clean_ok={} collapse_ok={}",
        st_lbl, failures, elapsed_ms, clean_ok, collapse_ok
    );
    println!(
        "SPECTRAL_CERT_METRICS c0_r12={:.9} c0_er={:.9} k0_r12={:.9} k0_er={:.9}",
        c0_r12, c0_er, k0_r12, k0_er
    );
    println!("SPECTRAL_CERT_METRICS cert_hex={}", cert_hex);
    println!(
        "SPECTRAL_CERT_METRICS rc_valid={} rc_forged={} rc_rank1_bypass={}",
        rc_valid_cert, rc_forged_cert, rc_rank1_bypass
    );
}
