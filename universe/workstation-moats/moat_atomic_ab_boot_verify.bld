// Wave 65A - Moat 5 Kernel: BuildOS Signed Atomic A/B Boot-Slot Verifier (F2, N54)
// Uses pure-BuildLang FIPS 180-4 SHA-256 + monotonic security-epoch anti-rollback guard +
// 3-strike hardware watchdog automatic rollback from Slot B to verified golden Slot A.
// Planted Controls: epoch downgrade attack, 1-bit image tamper, and 3-boot crash storm caught.

fn rotr32(x: i64, n: i64) -> i64 {
    let m: i64 = 4294967295;
    let v: i64 = x & m;
    ((v >> n) | ((v << (32 - n)) & m)) & m
}

fn sha256_bytes(msg: &Vec<i64>) -> Vec<i64> {
    let k: Vec<i64> = vec![
        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298,
    ];
    let mut h: Vec<i64> = vec![
        1779033703, 3144134277, 1013904242, 2773480762,
        1359893119, 2600822924, 528734635, 1541459225,
    ];
    let m32: i64 = 4294967295;
    let orig_len: usize = msg.len();
    let bit_len: i64 = (orig_len as i64) * 8;

    let mut padded: Vec<i64> = Vec::new();
    let mut i: usize = 0;
    while i < orig_len {
        padded.push(msg[i] & 255);
        i = i + 1;
    }
    padded.push(128);
    while (padded.len() % 64) != 56 {
        padded.push(0);
    }
    let mut sh: i64 = 56;
    while sh >= 0 {
        padded.push((bit_len >> sh) & 255);
        sh = sh - 8;
    }

    let n_blocks: usize = padded.len() / 64;
    let mut blk: usize = 0;
    while blk < n_blocks {
        let mut w: Vec<i64> = vec![0; 64];
        let mut t: usize = 0;
        while t < 16 {
            let b: usize = blk * 64 + t * 4;
            w[t] = (padded[b] << 24) | (padded[b + 1] << 16) | (padded[b + 2] << 8) | padded[b + 3];
            t = t + 1;
        }
        while t < 64 {
            let s0: i64 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3);
            let s1: i64 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10);
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & m32;
            t = t + 1;
        }
        let mut a: i64 = h[0];
        let mut b: i64 = h[1];
        let mut c: i64 = h[2];
        let mut d: i64 = h[3];
        let mut e: i64 = h[4];
        let mut f: i64 = h[5];
        let mut g: i64 = h[6];
        let mut hv: i64 = h[7];

        t = 0;
        while t < 64 {
            let s1: i64 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch: i64 = (e & f) ^ (((!e) & m32) & g);
            let t1: i64 = (hv + s1 + ch + k[t] + w[t]) & m32;
            let s0: i64 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj: i64 = (a & b) ^ (a & c) ^ (b & c);
            let t2: i64 = (s0 + maj) & m32;
            hv = g;
            g = f;
            f = e;
            e = (d + t1) & m32;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) & m32;
            t = t + 1;
        }
        h[0] = (h[0] + a) & m32;
        h[1] = (h[1] + b) & m32;
        h[2] = (h[2] + c) & m32;
        h[3] = (h[3] + d) & m32;
        h[4] = (h[4] + e) & m32;
        h[5] = (h[5] + f) & m32;
        h[6] = (h[6] + g) & m32;
        h[7] = (h[7] + hv) & m32;
        blk = blk + 1;
    }
    h
}

fn digests_equal(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    let mut i: usize = 0;
    while i < 8 {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

// Build deterministic 32-byte slot manifest: [slot_id, epoch_hi, epoch_lo, payload bytes...]
fn build_slot_manifest(slot_id: i64, epoch: i64, seed: i64) -> Vec<i64> {
    let mut buf: Vec<i64> = Vec::new();
    buf.push(slot_id & 255);
    buf.push((epoch >> 8) & 255);
    buf.push(epoch & 255);
    let mut i: i64 = 0;
    while i < 29 {
        let byte: i64 = (seed + i * 37 + slot_id * 13 + epoch * 7) & 255;
        buf.push(byte);
        i = i + 1;
    }
    buf
}

// Verify candidate boot slot:
// Returns 0=VALID, 1=REJECT_EPOCH_DOWNGRADE, 2=REJECT_SHA256_TAMPER
fn verify_slot_image(
    manifest: &Vec<i64>,
    expected_digest: &Vec<i64>,
    slot_epoch: i64,
    fused_min_epoch: i64,
) -> i32 {
    if slot_epoch < fused_min_epoch {
        return 1;
    }
    let actual: Vec<i64> = sha256_bytes(manifest);
    if !digests_equal(&actual, expected_digest) {
        return 2;
    }
    0
}

// Simulate 3-strike hardware watchdog auto-rollback:
// If candidate slot crashes 3 consecutive times before boot_commit(), roll back to fallback_slot.
fn run_watchdog_boots(candidate_slot: i32, fallback_slot: i32, crashes_in_row: i32) -> (i32, i32) {
    let mut active: i32 = candidate_slot;
    let mut strikes: i32 = 0;
    let mut b: i32 = 0;
    while b < crashes_in_row {
        strikes = strikes + 1;
        if strikes >= 3 {
            active = fallback_slot;
            return (active, strikes);
        }
        b = b + 1;
    }
    (active, strikes)
}

fn main() ~ Clock + Console {
    let t0: i64 = clock_ns();

    // Verify FIPS 180-4 SHA256("abc") known-answer self-check
    let abc: Vec<i64> = vec![97, 98, 99];
    let abc_h: Vec<i64> = sha256_bytes(&abc);
    let sha_selfcheck_ok: i32 = if abc_h[0] == 3128432319 && abc_h[7] == 4060091821 { 1 } else { 0 };

    let fused_min_epoch: i64 = 10;

    // Golden Slot A (slot=0, epoch=10) & Upgraded Slot B (slot=1, epoch=12)
    let slot_a: Vec<i64> = build_slot_manifest(0, 10, 41);
    let dig_a: Vec<i64> = sha256_bytes(&slot_a);

    let slot_b: Vec<i64> = build_slot_manifest(1, 12, 83);
    let dig_b: Vec<i64> = sha256_bytes(&slot_b);

    let slot_a_status: i32 = verify_slot_image(&slot_a, &dig_a, 10, fused_min_epoch);
    let slot_b_status: i32 = verify_slot_image(&slot_b, &dig_b, 12, fused_min_epoch);

    // Planted Control 1: Security-epoch downgrade attack (epoch_new=8 < fused_min_epoch=10)
    let slot_down: Vec<i64> = build_slot_manifest(1, 8, 83);
    let dig_down: Vec<i64> = sha256_bytes(&slot_down);
    let planted_downgrade_status: i32 = verify_slot_image(&slot_down, &dig_down, 8, fused_min_epoch);

    // Planted Control 2: 1-bit tamper in Slot B image byte 17
    let mut slot_tamper: Vec<i64> = build_slot_manifest(1, 12, 83);
    slot_tamper[17] = slot_tamper[17] ^ 1;
    let planted_tamper_status: i32 = verify_slot_image(&slot_tamper, &dig_b, 12, fused_min_epoch);

    // Planted Control 3: 3-boot crash storm on Slot B triggers automatic rollback to Slot A (0)
    let wd_res: (i32, i32) = run_watchdog_boots(1, 0, 3);
    let rollback_slot: i32 = wd_res.0;
    let strikes_fired: i32 = wd_res.1;
    let planted_watchdog_ok: i32 = if rollback_slot == 0 && strikes_fired == 3 { 1 } else { 0 };

    let elapsed_ms: f64 = ((clock_ns() - t0) as f64) / 1000000.0;

    println!(
        "MOAT5_PART1 sha_ok={} slot_a_ok={} slot_b_ok={} dig_b_h0={} dig_b_h7={}",
        sha_selfcheck_ok, slot_a_status, slot_b_status, dig_b[0], dig_b[7]
    );
    println!(
        "MOAT5_PART2 planted_downgrade={} planted_tamper={} rollback_slot={} strikes={} watchdog_ok={}",
        planted_downgrade_status, planted_tamper_status, rollback_slot, strikes_fired, planted_watchdog_ok
    );
    println!(
        "MOAT5_PART3 dig_a_h0={} dig_a_h7={} elapsed_ms={}",
        dig_a[0], dig_a[7], elapsed_ms
    );
}
