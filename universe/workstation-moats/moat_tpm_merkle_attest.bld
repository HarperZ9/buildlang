// Wave 63C (Moat 10, SIG-141; N46, N47, N49): Pure-BuildLang FIPS 180-4 SHA-256
// TPM-Style PCR-Extend Chain (PCR_{i+1} = SHA256(PCR_i || m_i)) + Monotonic NV-Counter
// Replay Guard + RFC 6962 Merkle Leaf-to-Root Inclusion Proof (bit-exact parity vs
// Python hashlib.sha256) + planted NV rollback and 1-bit PCR/Merkle tamper controls.

fn rotr32(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

fn sha256_k() -> Vec<u32> {
    let mut k: Vec<u32> = Vec::new();
    k.push(0x428a2f98); k.push(0x71374491); k.push(0xb5c0fbcf); k.push(0xe9b5dba5);
    k.push(0x3956c25b); k.push(0x59f111f1); k.push(0x923f82a4); k.push(0xab1c5ed5);
    k.push(0xd807aa98); k.push(0x12835b01); k.push(0x243185be); k.push(0x550c7dc3);
    k.push(0x72be5d74); k.push(0x80deb1fe); k.push(0x9bdc06a7); k.push(0xc19bf174);
    k.push(0xe49b69c1); k.push(0xefbe4786); k.push(0x0fc19dc6); k.push(0x240ca1cc);
    k.push(0x2de92c6f); k.push(0x4a7484aa); k.push(0x5cb0a9dc); k.push(0x76f988da);
    k.push(0x983e5152); k.push(0xa831c66d); k.push(0xb00327c8); k.push(0xbf597fc7);
    k.push(0xc6e00bf3); k.push(0xd5a79147); k.push(0x06ca6351); k.push(0x14292967);
    k.push(0x27b70a85); k.push(0x2e1b2138); k.push(0x4d2c6dfc); k.push(0x53380d13);
    k.push(0x650a7354); k.push(0x766a0abb); k.push(0x81c2c92e); k.push(0x92722c85);
    k.push(0xa2bfe8a1); k.push(0xa81a664b); k.push(0xc24b8b70); k.push(0xc76c51a3);
    k.push(0xd192e819); k.push(0xd6990624); k.push(0xf40e3585); k.push(0x106aa070);
    k.push(0x19a4c116); k.push(0x1e376c08); k.push(0x2748774c); k.push(0x34b0bcb5);
    k.push(0x391c0cb3); k.push(0x4ed8aa4a); k.push(0x5b9cca4f); k.push(0x682e6ff3);
    k.push(0x748f82ee); k.push(0x78a5636f); k.push(0x84c87814); k.push(0x8cc70208);
    k.push(0x90befffa); k.push(0xa4506ceb); k.push(0xbef9a3f7); k.push(0xc67178f2);
    k
}

fn sha256_bytes(msg: &Vec<u32>, k_tbl: &Vec<u32>) -> Vec<u32> {
    let orig_len: usize = msg.len();
    let bit_len: u64 = (orig_len as u64) * 8;
    let mut buf: Vec<u32> = Vec::new();
    let mut i: usize = 0;
    while i < orig_len {
        buf.push(msg[i] & 255);
        i = i + 1;
    }
    buf.push(0x80);
    while (buf.len() % 64) != 56 {
        buf.push(0);
    }
    let mut shift: u64 = 56;
    let mut bi: i32 = 0;
    while bi < 8 {
        buf.push(((bit_len >> shift) & 255) as u32);
        if shift >= 8 { shift = shift - 8; }
        bi = bi + 1;
    }

    let mut h0: u32 = 0x6a09e667; let mut h1: u32 = 0xbb67ae85;
    let mut h2: u32 = 0x3c6ef372; let mut h3: u32 = 0xa54ff53a;
    let mut h4: u32 = 0x510e527f; let mut h5: u32 = 0x9b05688c;
    let mut h6: u32 = 0x1f83d9ab; let mut h7: u32 = 0x5be0cd19;

    let mut w: Vec<u32> = Vec::new();
    i = 0;
    while i < 64 { w.push(0); i = i + 1; }

    let total_bytes: usize = buf.len();
    let mut off: usize = 0;
    while off < total_bytes {
        let mut t: usize = 0;
        while t < 16 {
            let p: usize = off + t * 4;
            w[t] = (buf[p] << 24) | (buf[p + 1] << 16) | (buf[p + 2] << 8) | buf[p + 3];
            t = t + 1;
        }
        while t < 64 {
            let s0: u32 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3);
            let s1: u32 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10);
            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);
            t = t + 1;
        }
        let mut a: u32 = h0; let mut b: u32 = h1; let mut c: u32 = h2; let mut d: u32 = h3;
        let mut e: u32 = h4; let mut f: u32 = h5; let mut g: u32 = h6; let mut h: u32 = h7;
        t = 0;
        while t < 64 {
            let s1: u32 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch: u32 = (e & f) ^ ((!e) & g);
            let t1: u32 = h.wrapping_add(s1).wrapping_add(ch).wrapping_add(k_tbl[t]).wrapping_add(w[t]);
            let s0: u32 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj: u32 = (a & b) ^ (a & c) ^ (b & c);
            let t2: u32 = s0.wrapping_add(maj);
            h = g; g = f; f = e; e = d.wrapping_add(t1);
            d = c; c = b; b = a; a = t1.wrapping_add(t2);
            t = t + 1;
        }
        h0 = h0.wrapping_add(a); h1 = h1.wrapping_add(b);
        h2 = h2.wrapping_add(c); h3 = h3.wrapping_add(d);
        h4 = h4.wrapping_add(e); h5 = h5.wrapping_add(f);
        h6 = h6.wrapping_add(g); h7 = h7.wrapping_add(h);
        off = off + 64;
    }

    let mut out: Vec<u32> = Vec::new();
    let mut words: Vec<u32> = Vec::new();
    words.push(h0); words.push(h1); words.push(h2); words.push(h3);
    words.push(h4); words.push(h5); words.push(h6); words.push(h7);
    let mut wi: usize = 0;
    while wi < 8 {
        let val: u32 = words[wi];
        out.push((val >> 24) & 255); out.push((val >> 16) & 255);
        out.push((val >> 8) & 255); out.push(val & 255);
        wi = wi + 1;
    }
    out
}

fn hex_nibble(n: u32) -> String {
    let digits: String = "0123456789abcdef";
    digits.char_at((n & 15) as usize)
}

fn digest_to_hex(d: &Vec<u32>) -> String {
    let mut hex: String = "";
    let mut i: usize = 0;
    while i < 32 {
        let b: u32 = d[i];
        hex = format!("{}{}{}", hex, hex_nibble(b >> 4), hex_nibble(b & 15));
        i = i + 1;
    }
    hex
}

fn digests_equal(a: &Vec<u32>, b: &Vec<u32>) -> i32 {
    if a.len() != 32 || b.len() != 32 { return 0; }
    let mut i: usize = 0;
    while i < 32 {
        if a[i] != b[i] { return 0; }
        i = i + 1;
    }
    1
}

fn build_ascii_lut() -> HashMap<String, u32> {
    let mut lut: HashMap<String, u32> = HashMap::new();
    let printable: String = format!(
        "{}{}{}",
        " !\"#$%&'()*+,-./0123456789:;<=>?@",
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`",
        "abcdefghijklmnopqrstuvwxyz{|}~"
    );
    let n: usize = printable.len();
    let mut i: usize = 0;
    while i < n {
        lut.insert(printable.char_at(i), (32 + i) as u32);
        i = i + 1;
    }
    lut
}

fn str_to_bytes(s: &String, lut: &HashMap<String, u32>) -> Vec<u32> {
    let n: usize = s.len();
    let mut out: Vec<u32> = Vec::new();
    let mut i: usize = 0;
    while i < n {
        let ch: String = s.char_at(i);
        match lut.get(&ch) {
            Some(v) => out.push(v),
            None => out.push(63),
        }
        i = i + 1;
    }
    out
}

// TPM PCR_Extend: PCR_{i+1} = SHA256(PCR_i || m_i)
fn pcr_extend(pcr: &Vec<u32>, msg: &Vec<u32>, k_tbl: &Vec<u32>) -> Vec<u32> {
    let mut buf: Vec<u32> = Vec::new();
    let mut i: usize = 0;
    while i < pcr.len() { buf.push(pcr[i]); i = i + 1; }
    i = 0;
    while i < msg.len() { buf.push(msg[i]); i = i + 1; }
    sha256_bytes(&buf, k_tbl)
}

// Monotonic NV-Counter Replay Guard: strictly requires next_nv > prev_nv (0 OK, -901 rollback/replay).
fn check_nv_monotonic(prev_nv: u64, next_nv: u64) -> i32 {
    if next_nv > prev_nv { 0 } else { -901 }
}

// RFC 6962 Leaf Hash: SHA256(0x00 || payload)
fn rfc6962_leaf(payload: &Vec<u32>, k_tbl: &Vec<u32>) -> Vec<u32> {
    let mut buf: Vec<u32> = Vec::new();
    buf.push(0x00);
    let mut i: usize = 0;
    while i < payload.len() { buf.push(payload[i]); i = i + 1; }
    sha256_bytes(&buf, k_tbl)
}

// RFC 6962 Internal Node Hash: SHA256(0x01 || left || right)
fn rfc6962_node(left: &Vec<u32>, right: &Vec<u32>, k_tbl: &Vec<u32>) -> Vec<u32> {
    let mut buf: Vec<u32> = Vec::new();
    buf.push(0x01);
    let mut i: usize = 0;
    while i < 32 { buf.push(left[i]); i = i + 1; }
    i = 0;
    while i < 32 { buf.push(right[i]); i = i + 1; }
    sha256_bytes(&buf, k_tbl)
}

fn zero_digest() -> Vec<u32> {
    let mut z: Vec<u32> = Vec::new();
    let mut i: usize = 0;
    while i < 32 { z.push(0); i = i + 1; }
    z
}

fn main() ~ Console + Clock {
    let t0: i64 = clock_ns();
    let k_tbl: Vec<u32> = sha256_k();
    let lut: HashMap<String, u32> = build_ascii_lut();

    // Build 8 deterministic attestation measurements + extend TPM PCR chain + advance NV counter
    let mut msgs: Vec<Vec<u32>> = Vec::new();
    let mut pcr: Vec<u32> = zero_digest();
    let mut nv_counter: u64 = 100u64;
    let mut nv_ok_count: i32 = 0;
    let mut idx: i32 = 0;
    while idx < 8 {
        let label: String = format!("moat10-stage-{}-nv-{}", idx, nv_counter + 1u64);
        let mb: Vec<u32> = str_to_bytes(&label, &lut);
        let rc_nv: i32 = check_nv_monotonic(nv_counter, nv_counter + 1u64);
        if rc_nv == 0 {
            nv_counter = nv_counter + 1u64;
            nv_ok_count = nv_ok_count + 1;
        }
        pcr = pcr_extend(&pcr, &mb, &k_tbl);
        msgs.push(mb);
        idx = idx + 1;
    }

    // Build RFC 6962 Merkle tree over all 8 measurement leaves (L0: 8, L1: 4, L2: 2, L3: root)
    let mut l0: Vec<Vec<u32>> = Vec::new();
    let mut i: usize = 0;
    while i < 8 {
        l0.push(rfc6962_leaf(&msgs[i], &k_tbl));
        i = i + 1;
    }
    let mut l1: Vec<Vec<u32>> = Vec::new();
    i = 0;
    while i < 4 {
        l1.push(rfc6962_node(&l0[2 * i], &l0[2 * i + 1], &k_tbl));
        i = i + 1;
    }
    let mut l2: Vec<Vec<u32>> = Vec::new();
    l2.push(rfc6962_node(&l1[0], &l1[1], &k_tbl));
    l2.push(rfc6962_node(&l1[2], &l1[3], &k_tbl));
    let root: Vec<u32> = rfc6962_node(&l2[0], &l2[1], &k_tbl);

    // Verify leaf-to-root RFC 6962 inclusion proof for every single leaf (8/8)
    let mut proofs_verified: i32 = 0;
    i = 0;
    while i < 8 {
        let sib0_idx: usize = i ^ 1;
        let h1: Vec<u32> = if (i % 2) == 0 {
            rfc6962_node(&l0[i], &l0[sib0_idx], &k_tbl)
        } else {
            rfc6962_node(&l0[sib0_idx], &l0[i], &k_tbl)
        };
        let i1: usize = i / 2;
        let sib1_idx: usize = i1 ^ 1;
        let h2: Vec<u32> = if (i1 % 2) == 0 {
            rfc6962_node(&h1, &l1[sib1_idx], &k_tbl)
        } else {
            rfc6962_node(&l1[sib1_idx], &h1, &k_tbl)
        };
        let i2: usize = i1 / 2;
        let sib2_idx: usize = i2 ^ 1;
        let h3: Vec<u32> = if (i2 % 2) == 0 {
            rfc6962_node(&h2, &l2[sib2_idx], &k_tbl)
        } else {
            rfc6962_node(&l2[sib2_idx], &h2, &k_tbl)
        };
        if digests_equal(&h3, &root) == 1 {
            proofs_verified = proofs_verified + 1;
        }
        i = i + 1;
    }

    // Planted control 1: NV-counter rollback (108 -> 107) and replay (108 -> 108) rejected (-901)
    let rc_nv_rollback: i32 = check_nv_monotonic(nv_counter, nv_counter - 1u64);
    let rc_nv_replay: i32 = check_nv_monotonic(nv_counter, nv_counter);

    // Planted control 2: 1-bit PCR measurement tamper on stage 3 rejected (-902)
    let mut pcr_bad: Vec<u32> = zero_digest();
    i = 0;
    while i < 8 {
        if i == 3 {
            let mut tampered: Vec<u32> = Vec::new();
            let mut j: usize = 0;
            while j < msgs[i].len() {
                let b: u32 = if j == 0 { msgs[i][j] ^ 1u32 } else { msgs[i][j] };
                tampered.push(b);
                j = j + 1;
            }
            pcr_bad = pcr_extend(&pcr_bad, &tampered, &k_tbl);
        } else {
            pcr_bad = pcr_extend(&pcr_bad, &msgs[i], &k_tbl);
        }
        i = i + 1;
    }
    let rc_pcr_tamper: i32 = if digests_equal(&pcr, &pcr_bad) == 0 { -902 } else { 0 };

    // Planted control 3: 1-bit Merkle sibling tamper during inclusion proof rejected (-903)
    let mut bad_sib: Vec<u32> = Vec::new();
    i = 0;
    while i < 32 {
        bad_sib.push(if i == 0 { l0[1][i] ^ 1u32 } else { l0[1][i] });
        i = i + 1;
    }
    let bad_h1: Vec<u32> = rfc6962_node(&l0[0], &bad_sib, &k_tbl);
    let bad_h2: Vec<u32> = rfc6962_node(&bad_h1, &l1[1], &k_tbl);
    let bad_root: Vec<u32> = rfc6962_node(&bad_h2, &l2[1], &k_tbl);
    let rc_merkle_tamper: i32 = if digests_equal(&bad_root, &root) == 0 { -903 } else { 0 };

    let t1: i64 = clock_ns();
    let elapsed_ms: f64 = ((t1 - t0) as f64) / 1.0e6;

    let mut failures: i32 = 0;
    if nv_ok_count != 8 || proofs_verified != 8 { failures = failures + 1; }
    if rc_nv_rollback != -901 || rc_nv_replay != -901 { failures = failures + 1; }
    if rc_pcr_tamper != -902 || rc_merkle_tamper != -903 { failures = failures + 1; }

    let st: String = if failures == 0 { "PASS" } else { "FAIL" };
    println!(
        "TPM_MERKLE status={} failures={} elapsed_ms={:.4} stages=8 nv_final={} proofs_ok={}",
        st, failures, elapsed_ms, nv_counter, proofs_verified
    );
    println!("TPM_MERKLE_METRICS pcr_hex={}", digest_to_hex(&pcr));
    println!("TPM_MERKLE_METRICS merkle_root={}", digest_to_hex(&root));
    println!(
        "TPM_MERKLE_METRICS rc_nv_rollback={} rc_nv_replay={} rc_pcr_tamper={} rc_merkle_tamper={}",
        rc_nv_rollback, rc_nv_replay, rc_pcr_tamper, rc_merkle_tamper
    );
}
