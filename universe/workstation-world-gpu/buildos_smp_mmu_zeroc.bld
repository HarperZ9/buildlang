fn exp_smp_mmu_root(i: i64) -> i64 {
    if i == 0 { return 1984600807; }
    else if i == 1 { return 172004385; }
    else if i == 2 { return 2317912884; }
    else if i == 3 { return 3302220514; }
    else if i == 4 { return 3162710607; }
    else if i == 5 { return 1426733961; }
    else if i == 6 { return 3209658165; }
    else if i == 7 { return 1122558035; }
    return 0;
}
fn smp_mmu_run(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    // Compact stack arrays (1,248 B + ~200 B scalars < 1,500 B < 2,048 B RV64 frame limit)
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut leaves: [i64; 16] = [0; 16];
    let mut smp_buf: [i64; 16] = [0; 16];
    let mut mmu_buf: [i64; 16] = [0; 16];
    let mut task_st: [i64; 16] = [0; 16];
    let mut pfn_st: [i64; 16] = [0; 16];
    let mut tlb_ep: [i64; 4] = [0; 4];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut p0: i64 = 0; let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;

    // =========================================================================
    // PHASE 1: Sv39 3-Level Page-Table Walk + W^X No-Alias PFN + TLB Shootdown
    // =========================================================================
    i = 0; while i < 16 { pfn_st[i] = -1; i = i + 1; }
    i = 0; while i < 4 { tlb_ep[i] = 7; i = i + 1; }

    p0 = 0;
    while p0 < 8 {
        let base: i64 = p0 * 7;
        let va: i64 = sv39_tbl(base);
        let l2_pte: i64 = sv39_tbl(base + 1);
        let l1_pte: i64 = sv39_tbl(base + 2);
        let mut l0_pte: i64 = sv39_tbl(base + 3);

        // Extract 9-bit Sv39 VPN fields and validate 3-level walk non-leaf pointers
        let vpn2: i64 = (va >> 30) & 511;
        let vpn1: i64 = (va >> 21) & 511;
        let vpn0: i64 = (va >> 12) & 511;
        if vpn2 != sv39_tbl(base + 4) || vpn1 != sv39_tbl(base + 5) || vpn0 != sv39_tbl(base + 6) {
            println("{}", -302); println("{}", 0); return -302;
        }
        if (l2_pte & 1) == 0 || (l2_pte & 14) != 0 || (l1_pte & 1) == 0 || (l1_pte & 14) != 0 {
            println("{}", -303); println("{}", 0); return -303;
        }

        // Planted attack (c): VA #6 (data R|W=3) aliases executable code PFN 2 (R|X=5 -> RWX alias!)
        if mode == 3 && p0 == 6 {
            l0_pte = (7 << 16) | (2 << 10) | (3 << 1) | 1;
        }
        // Clean remap of VA #7 from PFN 7 -> fresh unaliased PFN 11 at epoch 8
        if p0 == 7 {
            l0_pte = (8 << 16) | (11 << 10) | (3 << 1) | 1;
        }

        let perm: i64 = (l0_pte >> 1) & 7;
        let pfn: i64 = (l0_pte >> 10) & 15;
        if (l0_pte & 1) == 0 || perm == 0 || (perm & 6) == 6 {
            println("{}", -301); println("{}", 0); return -301;
        }
        // Strict no-alias physical-frame ownership & combined W^X alias rejection
        if pfn_st[pfn] != -1 {
            println("{}", -301); println("{}", 0); return -301;
        }
        pfn_st[pfn] = (p0 << 4) | perm;
        mmu_buf[p0] = ((p0 & 15) << 24) | ((vpn2 & 63) << 18) | ((vpn1 & 63) << 12) | ((pfn & 15) << 4) | perm;
        p0 = p0 + 1;
    }

    // Generation-pinned 4-core TLB shootdown after VA #7 unmap/remap (epoch 7 -> 8)
    let global_ep: i64 = 8;
    i = 0;
    while i < 4 {
        // Planted attack (a): Core 2 misses TLB shootdown ACK, retaining stale epoch 7 < 8!
        if mode == 1 && i == 2 {
            tlb_ep[i] = 7;
        } else {
            tlb_ep[i] = global_ep;
        }
        if tlb_ep[i] != global_ep {
            println("{}", -101); println("{}", 0); return -101;
        }
        mmu_buf[8 + i] = ((i & 15) << 24) | ((tlb_ep[i] & 255) << 8) | global_ep;
        i = i + 1;
    }
    mmu_buf[12] = 8; mmu_buf[13] = 11; mmu_buf[14] = global_ep; mmu_buf[15] = 1398158137; // "SV39"

    // =========================================================================
    // PHASE 2: 4-Core Deterministic Capability Work-Stealing Scheduler (16 Tasks)
    // =========================================================================
    i = 0;
    while i < 16 {
        if i < 10 { task_st[i] = 0; } else { task_st[i] = 1; }
        i = i + 1;
    }

    let mut steals: i64 = 0;
    let mut tick: i64 = 0;
    while tick < 4 {
        let mut core: i64 = 0;
        while core < 4 {
            let mut picked: i64 = -1;
            i = 0;
            while i < 16 {
                if picked < 0 && task_st[i] == core { picked = i; }
                i = i + 1;
            }
            let mut was_steal: i64 = 0;
            let mut victim: i64 = core;
            if picked < 0 {
                // Find busiest victim core deterministically
                let mut best_v: i64 = -1;
                let mut best_cnt: i64 = 0;
                let mut vc: i64 = 0;
                while vc < 4 {
                    let mut cnt: i64 = 0;
                    i = 0; while i < 16 { if task_st[i] == vc { cnt = cnt + 1; } i = i + 1; }
                    if cnt > best_cnt { best_cnt = cnt; best_v = vc; }
                    vc = vc + 1;
                }
                // Steal tail (highest tid) from victim deque via linear ownership transfer
                i = 15;
                while i >= 0 {
                    if picked < 0 && task_st[i] == best_v { picked = i; }
                    i = i - 1;
                }
                if picked < 0 || task_st[picked] != best_v {
                    println("{}", -201); println("{}", 0); return -201;
                }
                victim = best_v;
                was_steal = 1;
                task_st[picked] = -1;   // atomic in-transit state
                task_st[picked] = core; // exclusive linear ownership transfer
                steals = steals + 1;
            }

            // Planted attack (b): Core 3 attempts unowned double-exec of Task 0 (already done by Core 0!)
            if mode == 2 && tick == 1 && core == 3 { picked = 0; }

            if picked < 0 || task_st[picked] != core {
                println("{}", -201); println("{}", 0); return -201;
            }
            task_st[picked] = 10 + core;
            smp_buf[tick * 4 + core] = ((tick & 15) << 24) | ((core & 15) << 20)
                | ((was_steal & 1) << 16) | ((victim & 15) << 12) | (picked & 255);
            core = core + 1;
        }
        tick = tick + 1;
    }

    i = 0;
    while i < 16 {
        if task_st[i] < 10 { println("{}", -202); println("{}", 0); return -202; }
        i = i + 1;
    }

    // =========================================================================
    // PHASE 3: SHA-256 SMP & MMU Trace Digests + RFC 6962 SMP-MMU Integrity Root
    //   p0 == 0: smp_sha -> L_smp (leaves[0..7]); p0 == 1: mmu_sha -> L_mmu (leaves[8..15])
    // =========================================================================
    p0 = 0;
    while p0 < 2 {
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p1 = 0;
        while p1 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p1 == 0 {
                if p0 == 0 { i = 0; while i < 16 { w[i] = smp_buf[i]; i = i + 1; } }
                else { i = 0; while i < 16 { w[i] = mmu_buf[i]; i = i + 1; } }
            } else { w[0] = 2147483648; w[15] = 512; }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p1 = p1 + 1;
        }
        // Save mmu_sha in smp_buf[0..7] (now free!) for clean commit output
        if p0 == 1 { i = 0; while i < 8 { smp_buf[i] = hv[i]; i = i + 1; } }
        // Planted attack (d): flip bit 0 of SMP trace digest prior to RFC 6962 leaf commitment
        if mode == 4 && p0 == 0 { hv[0] = hv[0] ^ 1; }

        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        w[0] = hv[0] >> 8;
        i = 1; while i < 8 { w[i] = (((hv[i - 1] & 255) << 24) | (hv[i] >> 8)) & m32; i = i + 1; }
        w[8] = (((hv[7] & 255) << 24) | 8388608) & m32; w[15] = 264;
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
        i = 0; while i < 8 { leaves[p0 * 8 + i] = hv[i]; i = i + 1; }
        p0 = p0 + 1;
    }

    // Internal node: RFC 6962 Root = SHA256(0x01 || L_smp || L_mmu)
    i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
    p0 = 0;
    while p0 < 2 {
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        if p0 == 0 {
            w[0] = (16777216 | (leaves[0] >> 8)) & m32;
            i = 1; while i < 8 { w[i] = (((leaves[i - 1] & 255) << 24) | (leaves[i] >> 8)) & m32; i = i + 1; }
            w[8] = (((leaves[7] & 255) << 24) | (leaves[8] >> 8)) & m32;
            i = 1;
            while i < 8 {
                w[8 + i] = (((leaves[8 + i - 1] & 255) << 24) | (leaves[8 + i] >> 8)) & m32; i = i + 1;
            }
        } else { w[0] = (((leaves[15] & 255) << 24) | 8388608) & m32; w[15] = 520; }
        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
        p0 = p0 + 1;
    }

    j = 1; i = 0; while i < 8 { if hv[i] != exp_smp_mmu_root(i) { j = 0; } i = i + 1; }
    if j == 0 { println("{}", -401); println("{}", 0); return -401; }

    // Clean commit: status=1, committed=1, cores=4, tasks=16, steals, pages=8, epoch=8, mmu_sha[0..7], root[0..7]
    println("{}", 1);
    println("{}", 1);
    println("{}", 4);
    println("{}", 16);
    println("{}", steals);
    println("{}", 8);
    println("{}", global_ep);
    i = 0; while i < 8 { println("{}", smp_buf[i]); i = i + 1; }
    i = 0; while i < 8 { println("{}", hv[i]); i = i + 1; }
    return 1;
}

fn main() ~ Console {
    let _ = smp_mmu_run(0);
}
