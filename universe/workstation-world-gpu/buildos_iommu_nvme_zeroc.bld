                println("{}", -103); println("{}", 0); return -103;
            }
            pfn_owner[bp + j] = p0;
            j = j + 1;
        }
        iommu_buf[p0] = ((p0 & 15) << 24) | ((bp & 255) << 16) | ((cnt & 255) << 8) | (cap & 15);
        p0 = p0 + 1;
    }

