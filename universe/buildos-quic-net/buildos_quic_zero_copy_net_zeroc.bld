// =============================================================================
// STAGE 1: Capability Egress Firewall + 64-Bit Anti-Replay Window + NewReno CWND
//          + RFC 9000 Short-Header ChaCha20-Poly1305 AEAD Zero-Copy Transport
// Stack arrays: st[96] (768 B) + tag_tx[4] (32 B) = 800 B + scalars < 1,250 B < 2,048 B RV64!
// =============================================================================
fn quic_stage1_transport_firewall(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let m26: i64 = 67108863;
    let dcid_lo: i64 = 1112294481;
    let dcid_hi: i64 = 825439554;

    let mut st: [i64; 96] = [0; 96];
    let mut tag_tx: [i64; 4] = [0; 4];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut k: i64 = 0; let mut cp: i64 = 0;
    let mut pidx: i64 = 0; let mut p0: i64 = 0; let mut p3: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut h0: i64 = 0; let mut h1: i64 = 0; let mut h2: i64 = 0;
    let mut h3: i64 = 0; let mut h4: i64 = 0;
    let mut q0: i64 = 0; let mut q1: i64 = 0; let mut q2: i64 = 0; let mut q3: i64 = 0;

    let mut max_pn: i64 = 99;
    let mut bmp_lo: i64 = 0;
    let mut bmp_hi: i64 = 0;
    let mut cwnd: i64 = 4800;
    let mut ssthresh: i64 = 9600;
    let mut tx_fold: i64 = 2654435769;
    let mut fw_fold: i64 = 2246822507;

    pidx = 0;
    while pidx < 8 {
        let base: i64 = pidx * 6;
        let tid: i64 = quic_pkt(base);
        let mut peer: i64 = quic_pkt(base + 1);
        let stream: i64 = quic_pkt(base + 2);
        let mut pn: i64 = quic_pkt(base + 3);
        let plen: i64 = quic_pkt(base + 4);
        let loss: i64 = quic_pkt(base + 5);

        // Planted attack (d): Task 1 attempts unauthorized egress to Peer 3 (no CAP_NET_PEER)
        if mode == 4 && pidx == 6 { peer = 3; }
        // Planted attack (a): Replayed packet sequence number (pn=101 already in 64-bit window)
        if mode == 1 && pidx == 5 { pn = 101; }
        // Planted attack (b): Out-of-window spoofed nonce / stale packet number (104 - 30 = 74 >= 64)
        if mode == 2 && pidx == 5 { pn = 30; }

        // 1. Deny-by-default CAP_NET_PEER egress firewall check
        if peer < 0 || peer >= 4 || tid < 0 || tid >= 3 {
            println("{}", -401); println("{}", 0); return -401;
        }
        let req_cap: i64 = peer_cap_bit(peer);
        let allow_cap: i64 = task_peer_allow(tid);
        if (allow_cap & req_cap) != req_cap {
            println("{}", -401); println("{}", 0); return -401;
        }

        // 2. Zero-copy NIC ring admission against deterministic cwnd budget
        if plen <= 0 || plen > cwnd {
            println("{}", -402); println("{}", 0); return -402;
        }

        // 3. 64-bit sliding anti-replay bitmap window (paired 32-bit bmp_lo / bmp_hi)
        if pn > max_pn {
            let sh: i64 = pn - max_pn;
            if sh >= 64 {
                bmp_hi = 0; bmp_lo = 1;
            } else if sh >= 32 {
                bmp_hi = (bmp_lo << (sh - 32)) & m32; bmp_lo = 1;
            } else {
                bmp_hi = ((bmp_hi << sh) | (bmp_lo >> (32 - sh))) & m32;
                bmp_lo = ((bmp_lo << sh) | 1) & m32;
            }
            max_pn = pn;
        } else {
            let diff: i64 = max_pn - pn;
            if diff >= 64 {
                println("{}", -201); println("{}", 0); return -201;
            } else if diff < 32 {
                let bit: i64 = 1 << diff;
                if (bmp_lo & bit) != 0 {
                    println("{}", -101); println("{}", 0); return -101;
                }
                bmp_lo = bmp_lo | bit;
            } else {
                let bit: i64 = 1 << (diff - 32);
                if (bmp_hi & bit) != 0 {
                    println("{}", -101); println("{}", 0); return -101;
                }
                bmp_hi = bmp_hi | bit;
            }
        }

        // 4. RFC 9000 short header (16 B AAD in st[56..59]) + plaintext (32 B in st[48..55])
        st[56] = 64 | ((tid & 15) << 8) | ((peer & 15) << 16) | ((stream & 255) << 24);
        st[57] = dcid_lo;
        st[58] = dcid_hi;
        st[59] = pn & m32;
        i = 0; while i < 8 { st[48 + i] = pkt_pt_w(pidx, i); i = i + 1; }

        // 5. RFC 8439 ChaCha20-Poly1305 encrypt (p0=0) and receiver verify+decrypt (p0=1)
        st[0] = 1634760805; st[1] = 857760878; st[2] = 2036477234; st[3] = 1797285236;
        i = 0; while i < 8 { st[4 + i] = quic_key_le(i); i = i + 1; }
        st[13] = (quic_iv_le(0) ^ pn) & m32;
        st[14] = (quic_iv_le(1) ^ (peer * 65537 + stream)) & m32;
        st[15] = (quic_iv_le(2) ^ 257) & m32;

        // Compute OTK (blk 0 -> st[32..39]) and keystream (blk 1 -> st[64..71])
        p3 = 0;
        while p3 < 2 {
            st[12] = p3;
            i = 0; while i < 16 { st[16 + i] = st[i]; i = i + 1; }
            j = 0;
            while j < 10 {
                k = 0;
                while k < 8 {
                    q0 = 16 + (k & 3);
                    q1 = 20 + (((k & 3) + (k >> 2)) & 3);
                    q2 = 24 + (((k & 3) + (k >> 2) * 2) & 3);
                    q3 = 28 + (((k & 3) + (k >> 2) * 3) & 3);
                    a = st[q0]; b = st[q1]; c = st[q2]; d = st[q3];
                    a = (a + b) & m32; d = rotr32(d ^ a, 16);
                    c = (c + d) & m32; b = rotr32(b ^ c, 20);
                    a = (a + b) & m32; d = rotr32(d ^ a, 24);
                    c = (c + d) & m32; b = rotr32(b ^ c, 25);
                    st[q0] = a; st[q1] = b; st[q2] = c; st[q3] = d;
                    k = k + 1;
                }
                j = j + 1;
            }
            i = 0;
            while i < 8 {
                a = (st[16 + i] + st[i]) & m32;
                if p3 == 0 { st[32 + i] = a; } else { st[64 + i] = a; }
                i = i + 1;
            }
            p3 = p3 + 1;
        }

        // Ciphertext in st[40..47]
        i = 0; while i < 8 { st[40 + i] = (st[48 + i] ^ st[64 + i]) & m32; i = i + 1; }

        // Poly1305 MAC over AAD (16B) || CT (32B) || len64(16) || len64(32)
        a = st[32] & 268435455; b = st[33] & 268435452; c = st[34] & 268435452; d = st[35] & 268435452;
        st[80] = a & m26;
        st[81] = ((a >> 26) | (b << 6)) & m26;
        st[82] = ((b >> 20) | (c << 12)) & m26;
        st[83] = ((c >> 14) | (d << 18)) & m26;
        st[84] = (d >> 8) & m26;

        p0 = 0;
        while p0 < 2 {
            h0 = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0;
            p3 = 0;
            while p3 < 4 {
                q0 = 16; q1 = 0; q2 = 32; q3 = 0;
                if p3 == 0 { q0 = st[56]; q1 = st[57]; q2 = st[58]; q3 = st[59]; }
                else if p3 == 1 { q0 = st[40]; q1 = st[41]; q2 = st[42]; q3 = st[43]; }
                else if p3 == 2 { q0 = st[44]; q1 = st[45]; q2 = st[46]; q3 = st[47]; }
                h0 = h0 + (q0 & m26);
                h1 = h1 + (((q0 >> 26) | (q1 << 6)) & m26);
                h2 = h2 + (((q1 >> 20) | (q2 << 12)) & m26);
                h3 = h3 + (((q2 >> 14) | (q3 << 18)) & m26);
                h4 = h4 + ((q3 >> 8) | 16777216);
                a = h0 * st[80] + h1 * (st[84] * 5) + h2 * (st[83] * 5) + h3 * (st[82] * 5) + h4 * (st[81] * 5);
                b = h0 * st[81] + h1 * st[80] + h2 * (st[84] * 5) + h3 * (st[83] * 5) + h4 * (st[82] * 5);
                c = h0 * st[82] + h1 * st[81] + h2 * st[80] + h3 * (st[84] * 5) + h4 * (st[83] * 5);
                d = h0 * st[83] + h1 * st[82] + h2 * st[81] + h3 * st[80] + h4 * (st[84] * 5);
                e = h0 * st[84] + h1 * st[83] + h2 * st[82] + h3 * st[81] + h4 * st[80];
                cp = a >> 26; h0 = a & m26; b = b + cp;
                cp = b >> 26; h1 = b & m26; c = c + cp;
                cp = c >> 26; h2 = c & m26; d = d + cp;
                cp = d >> 26; h3 = d & m26; e = e + cp;
                cp = e >> 26; h4 = e & m26; h0 = h0 + cp * 5;
                cp = h0 >> 26; h0 = h0 & m26; h1 = h1 + cp;
                p3 = p3 + 1;
            }
            cp = h1 >> 26; h1 = h1 & m26; h2 = h2 + cp;
            cp = h2 >> 26; h2 = h2 & m26; h3 = h3 + cp;
            cp = h3 >> 26; h3 = h3 & m26; h4 = h4 + cp;
            cp = h4 >> 26; h4 = h4 & m26; h0 = h0 + cp * 5;
            cp = h0 >> 26; h0 = h0 & m26; h1 = h1 + cp;
            a = h0 + 5; cp = a >> 26; a = a & m26;
            b = h1 + cp; cp = b >> 26; b = b & m26;
            c = h2 + cp; cp = c >> 26; c = c & m26;
            d = h3 + cp; cp = d >> 26; d = d & m26;
            if h4 + cp - 67108864 >= 0 { h0 = a; h1 = b; h2 = c; h3 = d; h4 = h4 + cp - 67108864; }
            a = ((h0 | (h1 << 26)) & m32) + st[36]; cp = a >> 32; a = a & m32;
            b = (((h1 >> 6) | (h2 << 20)) & m32) + st[37] + cp; cp = b >> 32; b = b & m32;
            c = (((h2 >> 12) | (h3 << 14)) & m32) + st[38] + cp; cp = c >> 32; c = c & m32;
            d = ((((h3 >> 18) | (h4 << 8)) & m32) + st[39] + cp) & m32;

            if p0 == 0 {
                tag_tx[0] = a; tag_tx[1] = b; tag_tx[2] = c; tag_tx[3] = d;
                // Planted attack (c): 1-bit forged Poly1305 tag in transit on packet 4
                if mode == 3 && pidx == 4 { tag_tx[0] = tag_tx[0] ^ 1; }
            } else {
                e = (a ^ tag_tx[0]) | (b ^ tag_tx[1]) | (c ^ tag_tx[2]) | (d ^ tag_tx[3]);
                if e != 0 {
                    println("{}", -301); println("{}", 0); return -301;
                }
                i = 0;
                while i < 8 {
                    if ((st[40 + i] ^ st[64 + i]) & m32) != st[48 + i] {
                        println("{}", -302); println("{}", 0); return -302;
                    }
                    i = i + 1;
                }
            }
            p0 = p0 + 1;
        }

        // 6. RFC 9002 deterministic NewReno congestion-window update
        if loss == 1 {
            ssthresh = cwnd >> 1;
            if ssthresh < 2400 { ssthresh = 2400; }
            cwnd = ssthresh;
        } else if cwnd < ssthresh {
            cwnd = cwnd + 1200;
        } else {
            cwnd = cwnd + 300;
        }

        // Fold verified packet tag/ciphertext and firewall/cwnd state into live witnesses
        let fw_w: i64 = ((tid & 15) << 28) | ((peer & 15) << 24) | ((pn & 255) << 16) | (cwnd & 65535);
        if tag_tx[0] != exp_tx_words(pidx * 2) || st[40] != exp_tx_words(pidx * 2 + 1) || fw_w != exp_fw_words(pidx) {
            println("{}", -403); println("{}", 0); return -403;
        }
        tx_fold = (tx_fold * 33 + tag_tx[0] + st[40]) & m32;
        fw_fold = (fw_fold * 33 + fw_w + bmp_lo) & m32;
        pidx = pidx + 1;
    }

    if cwnd != 5550 || ssthresh != 4950 || max_pn != 107 || bmp_lo != 255 || bmp_hi != 0 {
        println("{}", -404); println("{}", 0); return -404;
    }
    return quic_stage2_merkle_commit(tx_fold, fw_fold, cwnd, bmp_lo);
}

// =============================================================================
// STAGE 2: FIPS 180-4 SHA-256 Transcript & Firewall Digests + RFC 6962 Root
// Stack arrays: w[64] + hv[8] + leaves[16] + tx_sha[8] = 768 B + scalars < 1,050 B < 2,048 B RV64!
// =============================================================================
fn quic_stage2_merkle_commit(tx_fold: i64, fw_fold: i64, cwnd: i64, bmp_lo: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut leaves: [i64; 16] = [0; 16];
    let mut tx_sha: [i64; 8] = [0; 8];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut p0: i64 = 0; let mut p1: i64 = 0;
