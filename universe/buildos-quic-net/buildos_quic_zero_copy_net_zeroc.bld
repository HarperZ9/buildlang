fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn pkt_pt_w(pidx: i64, wi: i64) -> i64 {
    let a: i64 = (1364543811 + pidx * 16843009 + wi * 2654435769) & 4294967295;
    let b: i64 = ((pidx + 1) * (wi + 3) * 2246822507) & 4294967295;
    return (a ^ b) & 4294967295;
}

