// Wave 49M - Author Idea N01: Bio-Inspired Flapping-Wing Aero & 3D Swarm Dynamics
// Part 1: Weis-Fogh clap-and-fling unsteady flapping-wing lift augmentation (> 1.3x quasi-steady).
// Part 2: 3D Boids/Reynolds 12-agent swarm cohesion/alignment/separation (0 collisions / 10,000 steps).
// Part 3: Planted zero-separation collision control (caught fail-closed).

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn wrap_pi(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let two_pi: f64 = 6.28318530717958647692;
    let mut y: f64 = x;
    while y > pi {
        y = y - two_pi;
    }
    while y < -pi {
        y = y + two_pi;
    }
    y
}

fn det_sin_poly(y: f64) -> f64 {
    let y2: f64 = y * y;
    let t7: f64 = 1.6059043836821613e-10 - y2 * 7.647163731819816e-13;
    let t6: f64 = 2.505210838544172e-8 - y2 * t7;
    let t5: f64 = 2.7557319223985893e-6 - y2 * t6;
    let t4: f64 = 1.984126984126984e-4 - y2 * t5;
    let t3: f64 = 8.333333333333333e-3 - y2 * t4;
    let t2: f64 = 1.6666666666666666e-1 - y2 * t3;
    y * (1.0 - y2 * t2)
}

fn det_cos_poly(y: f64) -> f64 {
    let y2: f64 = y * y;
    let t7: f64 = 2.08767569878681e-9 - y2 * 1.1470745597729725e-11;
    let t6: f64 = 2.7557319223985893e-7 - y2 * t7;
    let t5: f64 = 2.48015873015873e-5 - y2 * t6;
    let t4: f64 = 1.388888888888889e-3 - y2 * t5;
    let t3: f64 = 4.1666666666666664e-2 - y2 * t4;
    let t2: f64 = 0.5 - y2 * t3;
    1.0 - y2 * t2
}

fn det_sin(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let half_pi: f64 = 1.57079632679489661923;
    let q_pi: f64 = 0.78539816339744830962;
    let mut y: f64 = wrap_pi(x);
    let mut sign: f64 = 1.0;
    if y < 0.0 {
        y = -y;
        sign = -1.0;
    }
    if y > half_pi {
        y = pi - y;
    }
    if y <= q_pi {
        sign * det_sin_poly(y)
    } else {
        sign * det_cos_poly(half_pi - y)
    }
}

fn det_cos(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let half_pi: f64 = 1.57079632679489661923;
    let q_pi: f64 = 0.78539816339744830962;
    let mut y: f64 = abs_f64(wrap_pi(x));
    let mut sign: f64 = 1.0;
    if y > half_pi {
        y = pi - y;
        sign = -1.0;
    }
    if y <= q_pi {
        sign * det_cos_poly(y)
    } else {
        sign * det_sin_poly(half_pi - y)
    }
}

fn det_exp(x: f64) -> f64 {
    if x < -40.0 {
        return 0.0;
    }
    // Range reduction: exp(x) = exp(x / 64)^64
    let u: f64 = x / 64.0;
    let mut term: f64 = 1.0 + u * (1.0 + u * (0.5 + u * (0.16666666666666666 + u * 0.041666666666666664)));
    let mut i: i32 = 0;
    while i < 6 {
        term = term * term;
        i = i + 1;
    }
    term
}

fn det_sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    let mut g: f64 = x;
    if g < 1.0 {
        g = 1.0;
    }
    let mut i: i32 = 0;
    while i < 24 {
        g = 0.5 * (g + x / g);
        i = i + 1;
    }
    g
}

struct SwarmResult {
    collisions: i32,
    min_dist: f64,
    final_polarization: f64,
    final_radius: f64,
    checksum: f64,
}

fn run_boids_3d(steps: i32, w_sep: f64) -> SwarmResult {
    let n: usize = 12;
    let mut px: Vec<f64> = Vec::new();
    let mut py: Vec<f64> = Vec::new();
    let mut pz: Vec<f64> = Vec::new();
    let mut vx: Vec<f64> = Vec::new();
    let mut vy: Vec<f64> = Vec::new();
    let mut vz: Vec<f64> = Vec::new();

    // Deterministic ring + vertical offset initialization (safe initial spacing > 2.2 m)
    let two_pi: f64 = 6.28318530717958647692;
    let mut i: usize = 0;
    while i < n {
        let ang: f64 = (i as f64) * two_pi / (n as f64);
        let rad: f64 = 5.5 + 0.6 * det_cos(2.0 * ang);
        px.push(rad * det_cos(ang));
        py.push(rad * det_sin(ang));
        pz.push(1.8 * det_sin(3.0 * ang));
        vx.push(-2.5 * det_sin(ang) + 0.4 * det_cos(ang));
        vy.push(2.5 * det_cos(ang) + 0.4 * det_sin(ang));
        vz.push(0.3 * det_cos(2.0 * ang));
        i = i + 1;
    }

    let dt: f64 = 0.02;
    let r_col: f64 = 0.50;
    let r_sep: f64 = 2.40;
    let w_coh: f64 = 0.25;
    let w_ali: f64 = 0.55;
    let w_home: f64 = 0.06;
    let v_min: f64 = 2.0;
    let v_max: f64 = 4.5;

    let mut collisions: i32 = 0;
    let mut min_dist: f64 = 1.0e9;

    let mut ax: Vec<f64> = vec![0.0; n];
    let mut ay: Vec<f64> = vec![0.0; n];
    let mut az: Vec<f64> = vec![0.0; n];

    let mut step: i32 = 0;
    while step < steps {
        // Compute flock center & mean velocity
        let mut cx: f64 = 0.0;
        let mut cy: f64 = 0.0;
        let mut cz: f64 = 0.0;
        let mut mvx: f64 = 0.0;
        let mut mvy: f64 = 0.0;
        let mut mvz: f64 = 0.0;
        i = 0;
        while i < n {
            cx = cx + px[i];
            cy = cy + py[i];
            cz = cz + pz[i];
            mvx = mvx + vx[i];
            mvy = mvy + vy[i];
            mvz = mvz + vz[i];
            i = i + 1;
        }
        let inv_n: f64 = 1.0 / (n as f64);
        cx = cx * inv_n;
        cy = cy * inv_n;
        cz = cz * inv_n;
        mvx = mvx * inv_n;
        mvy = mvy * inv_n;
        mvz = mvz * inv_n;

        i = 0;
        while i < n {
            let mut sx: f64 = 0.0;
            let mut sy: f64 = 0.0;
            let mut sz: f64 = 0.0;
            let mut j: usize = 0;
            while j < n {
                if i != j {
                    let dx: f64 = px[i] - px[j];
                    let dy: f64 = py[i] - py[j];
                    let dz: f64 = pz[i] - pz[j];
                    let d2: f64 = dx * dx + dy * dy + dz * dz;
                    let d: f64 = det_sqrt(d2 + 1.0e-12);
                    if j > i {
                        if d < min_dist {
                            min_dist = d;
                        }
                        if d < r_col {
                            collisions = collisions + 1;
                        }
                    }
                    if d < r_sep {
                        let gap: f64 = r_sep - d;
                        let push: f64 = (gap / (d * d + 0.05));
                        sx = sx + dx * push;
                        sy = sy + dy * push;
                        sz = sz + dz * push;
                    }
                }
                j = j + 1;
            }
            ax[i] = w_coh * (cx - px[i]) + w_ali * (mvx - vx[i]) + w_sep * sx - w_home * px[i];
            ay[i] = w_coh * (cy - py[i]) + w_ali * (mvy - vy[i]) + w_sep * sy - w_home * py[i];
            az[i] = w_coh * (cz - pz[i]) + w_ali * (mvz - vz[i]) + w_sep * sz - w_home * pz[i];
            i = i + 1;
        }

        // Symplectic velocity + position update with speed clamping
        i = 0;
        while i < n {
            let mut nvx: f64 = vx[i] + dt * ax[i];
            let mut nvy: f64 = vy[i] + dt * ay[i];
            let mut nvz: f64 = vz[i] + dt * az[i];
            let spd: f64 = det_sqrt(nvx * nvx + nvy * nvy + nvz * nvz + 1.0e-12);
            if spd > v_max {
                let sc: f64 = v_max / spd;
                nvx = nvx * sc;
                nvy = nvy * sc;
                nvz = nvz * sc;
            } else if spd < v_min {
                let sc: f64 = v_min / spd;
                nvx = nvx * sc;
                nvy = nvy * sc;
                nvz = nvz * sc;
            }
            vx[i] = nvx;
            vy[i] = nvy;
            vz[i] = nvz;
            px[i] = px[i] + dt * nvx;
            py[i] = py[i] + dt * nvy;
            pz[i] = pz[i] + dt * nvz;
            i = i + 1;
        }
        step = step + 1;
    }

    // Final order parameters: polarization & cohesion radius
    let mut cx: f64 = 0.0;
    let mut cy: f64 = 0.0;
    let mut cz: f64 = 0.0;
    let mut ux: f64 = 0.0;
    let mut uy: f64 = 0.0;
    let mut uz: f64 = 0.0;
    let mut checksum: f64 = 0.0;
    i = 0;
    while i < n {
        cx = cx + px[i];
        cy = cy + py[i];
        cz = cz + pz[i];
        let sp: f64 = det_sqrt(vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i] + 1.0e-12);
        ux = ux + vx[i] / sp;
        uy = uy + vy[i] / sp;
        uz = uz + vz[i] / sp;
        checksum = checksum + px[i] + py[i] + pz[i];
        i = i + 1;
    }
    let inv_n: f64 = 1.0 / (n as f64);
    cx = cx * inv_n;
    cy = cy * inv_n;
    cz = cz * inv_n;
    let pol: f64 = det_sqrt(ux * ux + uy * uy + uz * uz) * inv_n;

    let mut rad_sum: f64 = 0.0;
    i = 0;
    while i < n {
        let dx: f64 = px[i] - cx;
        let dy: f64 = py[i] - cy;
        let dz: f64 = pz[i] - cz;
        rad_sum = rad_sum + det_sqrt(dx * dx + dy * dy + dz * dz);
        i = i + 1;
    }

    SwarmResult {
        collisions: collisions,
        min_dist: min_dist,
        final_polarization: pol,
        final_radius: rad_sum * inv_n,
        checksum: checksum,
    }
}

fn main() ~ Clock + Console {
    let mut failures: i32 = 0;
    let t0_ns: i64 = clock_ns();

    // 1. Weis-Fogh Clap-and-Fling Unsteady Flapping-Wing Lift Augmentation
    let pi: f64 = 3.14159265358979323846;
    let two_pi: f64 = 6.28318530717958647692;
    let rho: f64 = 1.225;
    let chord: f64 = 0.012;
    let span: f64 = 0.045;
    let area: f64 = chord * span;
    let r2_hat_sq: f64 = 0.34;
    let phi_amp: f64 = 1.0471975511965976; // 60 deg half-amplitude (120 deg stroke)
    let freq: f64 = 40.0;
    let omega: f64 = two_pi * freq;

    let n_phase: i32 = 400;
    let mut lift_qs_sum: f64 = 0.0;
    let mut lift_wf_sum: f64 = 0.0;
    let mut p: i32 = 0;
    while p < n_phase {
        let tau: f64 = ((p as f64) + 0.5) / (n_phase as f64); // [0, 1)
        let theta: f64 = two_pi * tau;
        // Stroke angular velocity dphi/dt = -phi_amp * omega * sin(theta)
        let phi_dot: f64 = -phi_amp * omega * det_sin(theta);
        let u_tip: f64 = span * abs_f64(phi_dot);
        let q_dyn: f64 = 0.5 * rho * area * r2_hat_sq * u_tip * u_tip;

        // Effective angle of attack ~45 deg mid-stroke, pitched toward 75 deg at reversal
        let alpha: f64 = 0.7853981633974483 + 0.35 * det_cos(theta) * det_cos(theta);
        let cl_qs: f64 = 0.225 + 1.58 * det_sin(2.13 * alpha - 0.12566370614359174);
        let l_qs: f64 = q_dyn * cl_qs;

        // Stable Leading-Edge Vortex (LEV) bound-circulation boost during mid-stroke
        let sin_a: f64 = det_sin(alpha);
        let l_lev: f64 = q_dyn * (0.28 * sin_a * sin_a);

        // Weis-Fogh clap-and-fling dorsal opening impulse near tau=0 and tau=1 (Lighthill 1973)
        let d_open: f64 = if tau < 0.5 { tau } else { 1.0 - tau };
        let fling_env: f64 = det_exp(-(d_open * d_open) / (2.0 * 0.09 * 0.09));
        let alpha_dot_fling: f64 = 2.4 * omega;
        let gamma_fling: f64 = 0.92 * chord * chord * alpha_dot_fling * fling_env;
        let l_fling: f64 = rho * span * (0.55 * span * omega * phi_amp) * gamma_fling;

        lift_qs_sum = lift_qs_sum + l_qs;
        lift_wf_sum = lift_wf_sum + (l_qs + l_lev + l_fling);
        p = p + 1;
    }
    let lift_qs_avg: f64 = lift_qs_sum / (n_phase as f64);
    let lift_wf_avg: f64 = lift_wf_sum / (n_phase as f64);
    let wf_ratio: f64 = lift_wf_avg / lift_qs_avg;

    if wf_ratio > 1.30 && wf_ratio < 2.20 {
        println!(
            "[PASS] weis_fogh_clap_fling lift_qs_mN={:.6} lift_wf_mN={:.6} ratio={:.6}x",
            lift_qs_avg * 1000.0, lift_wf_avg * 1000.0, wf_ratio
        );
    } else {
        println!("[FAIL] weis_fogh_clap_fling ratio={:.6}x", wf_ratio);
        failures = failures + 1;
    }

    // 2. 3D Boids/Reynolds Swarm (10,000 steps, 0 collisions)
    let sw_ok: SwarmResult = run_boids_3d(10000, 7.5);
    if sw_ok.collisions == 0 && sw_ok.min_dist > 0.50 {
        println!(
            "[PASS] boids_3d_10k collisions={} min_dist_m={:.6} polarization={:.6} radius_m={:.6}",
            sw_ok.collisions, sw_ok.min_dist, sw_ok.final_polarization, sw_ok.final_radius
        );
    } else {
        println!(
            "[FAIL] boids_3d_10k collisions={} min_dist_m={:.6}",
            sw_ok.collisions, sw_ok.min_dist
        );
        failures = failures + 1;
    }

    // 3. Planted Control: Zero-Separation Swarm Must Trigger Collisions
    let sw_bad: SwarmResult = run_boids_3d(2000, 0.0);
    if sw_bad.collisions > 0 && sw_bad.min_dist < 0.50 {
        println!(
            "[PASS] planted_ctrl_zero_sep caught collisions={} min_dist_m={:.6}",
            sw_bad.collisions, sw_bad.min_dist
        );
    } else {
        println!(
            "[FAIL] planted_ctrl_zero_sep missed collisions={} min_dist_m={:.6}",
            sw_bad.collisions, sw_bad.min_dist
        );
        failures = failures + 1;
    }

    let elapsed_ms: f64 = ((clock_ns() - t0_ns) as f64) / 1.0e6;
    println!(
        "[METRICS_N01] elapsed_ms={:.4} wf_ratio={:.9} swarm_checksum={:.9} failures={}",
        elapsed_ms, wf_ratio, sw_ok.checksum, failures
    );
}
