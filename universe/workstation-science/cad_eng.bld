//
// Wave 50A Kernel 3 (Author Idea E21):
//   Parametric Involute Spur Gear Tooth + Optical Lens Barrel Generator
//   exporting verified valid ASCII STL geometry (< 1 um dimensional error vs analytic)
//   + Planted Negative-Clearance & Non-Manifold Degenerate-Triangle Trap.

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    x
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    b
}

struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

struct TriCheck {
    ok: bool,
    area: f64,
    normal: Vec3,
}

fn check_triangle(v0: &Vec3, v1: &Vec3, v2: &Vec3) -> TriCheck {
    let ux: f64 = v1.x - v0.x;
    let uy: f64 = v1.y - v0.y;
    let uz: f64 = v1.z - v0.z;
    let vx: f64 = v2.x - v0.x;
    let vy: f64 = v2.y - v0.y;
    let vz: f64 = v2.z - v0.z;
    let nx: f64 = uy * vz - uz * vy;
    let ny: f64 = uz * vx - ux * vz;
    let nz: f64 = ux * vy - uy * vx;
    let mag: f64 = sqrt(nx * nx + ny * ny + nz * nz);
    if mag <= 1.0e-12 {
        return TriCheck { ok: false, area: 0.0, normal: Vec3 { x: 0.0, y: 0.0, z: 0.0 } };
    }
    TriCheck {
        ok: true,
        area: 0.5 * mag,
        normal: Vec3 { x: nx / mag, y: ny / mag, z: nz / mag },
    }
}

fn format_stl_facet(v0: &Vec3, v1: &Vec3, v2: &Vec3, tc: &TriCheck) -> String {
    let h: String = format!(
        "  facet normal {:.6} {:.6} {:.6}\n    outer loop\n",
        tc.normal.x, tc.normal.y, tc.normal.z
    );
    let b: String = format!(
        "      vertex {:.6} {:.6} {:.6}\n      vertex {:.6} {:.6} {:.6}\n",
        v0.x, v0.y, v0.z, v1.x, v1.y, v1.z
    );
    format!(
        "{}{}      vertex {:.6} {:.6} {:.6}\n    endloop\n  endfacet\n",
        h, b, v2.x, v2.y, v2.z
    )
}

fn barrel_clearance_ok(r_inner_mm: f64, r_outer_mm: f64, length_mm: f64) -> bool {
    r_inner_mm > 0.0 && r_outer_mm > r_inner_mm + 0.2 && length_mm > 0.0
}

fn main() ~ Console + Clock {
    let mut failures: i32 = 0;
    let pi: f64 = 3.14159265358979323846264338327950288;

    // 1. Parametric involute spur gear tooth: module m=2.0 mm, z=24 teeth, alpha=20 deg
    let m_mod: f64 = 2.0;
    let z_teeth: f64 = 24.0;
    let alpha_rad: f64 = 20.0 * pi / 180.0;
    let r_pitch: f64 = 0.5 * m_mod * z_teeth;
    let r_base: f64 = r_pitch * cos(alpha_rad);
    let r_add: f64 = r_pitch + m_mod;
    let t_max: f64 = sqrt((r_add * r_add) / (r_base * r_base) - 1.0);

    let mut max_inv_err_mm: f64 = 0.0;
    let mut xs: Vec<f64> = Vec::new();
    let mut ys: Vec<f64> = Vec::new();
    let n_pts: i32 = 32;
    let mut i: i32 = 0;
    while i <= n_pts {
        let t: f64 = t_max * ((i as f64) / (n_pts as f64));
        let ix: f64 = r_base * (cos(t) + t * sin(t));
        let iy: f64 = r_base * (sin(t) - t * cos(t));
        xs.push(ix);
        ys.push(iy);
        let r_meas: f64 = sqrt(ix * ix + iy * iy);
        let r_exact: f64 = r_base * sqrt(1.0 + t * t);
        max_inv_err_mm = max_f64(max_inv_err_mm, abs_f64(r_meas - r_exact));
        i = i + 1;
    }

    // 2. Extrude valid closed ASCII STL for gear flank (64 tris) + optical lens barrel (192 tris = 256 total)
    let t0_ns: i64 = clock_ns();
    let mut stl: String = "solid cad_eng_gear_barrel\n";
    let mut tri_count: i32 = 0;
    let mut max_norm_err: f64 = 0.0;
    let face_w: f64 = 10.0;

    i = 0;
    while i < n_pts {
        let ui: usize = i as usize;
        let a0: Vec3 = Vec3 { x: xs[ui], y: ys[ui], z: 0.0 };
        let a1: Vec3 = Vec3 { x: xs[ui + 1], y: ys[ui + 1], z: 0.0 };
        let b0: Vec3 = Vec3 { x: xs[ui], y: ys[ui], z: face_w };
        let b1: Vec3 = Vec3 { x: xs[ui + 1], y: ys[ui + 1], z: face_w };
        let tc1: TriCheck = check_triangle(&a0, &a1, &b1);
        let tc2: TriCheck = check_triangle(&a0, &b1, &b0);
        if tc1.ok && tc2.ok {
            stl = format!("{}{}{}", stl, format_stl_facet(&a0, &a1, &b1, &tc1), format_stl_facet(&a0, &b1, &b0, &tc2));
            let n1: f64 = sqrt(tc1.normal.x * tc1.normal.x + tc1.normal.y * tc1.normal.y + tc1.normal.z * tc1.normal.z);
            max_norm_err = max_f64(max_norm_err, abs_f64(n1 - 1.0));
            tri_count = tri_count + 2;
        }
        i = i + 1;
    }

    // Optical lens barrel (R_in=25 mm, R_out=28 mm, L=30 mm, 24 segments -> outer/inner/top/bottom walls)
    let r_in: f64 = 25.0;
    let r_out: f64 = 28.0;
    let b_len: f64 = 30.0;
    let segs: i32 = 24;
    if barrel_clearance_ok(r_in, r_out, b_len) {
        let mut s: i32 = 0;
        while s < segs {
            let th0: f64 = 2.0 * pi * ((s as f64) / (segs as f64));
            let th1: f64 = 2.0 * pi * (((s + 1) as f64) / (segs as f64));
            let o00: Vec3 = Vec3 { x: r_out * cos(th0), y: r_out * sin(th0), z: 0.0 };
            let o10: Vec3 = Vec3 { x: r_out * cos(th1), y: r_out * sin(th1), z: 0.0 };
            let o01: Vec3 = Vec3 { x: r_out * cos(th0), y: r_out * sin(th0), z: b_len };
            let o11: Vec3 = Vec3 { x: r_out * cos(th1), y: r_out * sin(th1), z: b_len };
            let tc_a: TriCheck = check_triangle(&o00, &o10, &o11);
            let tc_b: TriCheck = check_triangle(&o00, &o11, &o01);
            if tc_a.ok && tc_b.ok {
                let fa: String = format_stl_facet(&o00, &o10, &o11, &tc_a);
                let fb: String = format_stl_facet(&o00, &o11, &o01, &tc_b);
                stl = format!("{}{}{}", stl, fa, fb);
                tri_count = tri_count + 2;
            }
            s = s + 1;
        }
    }
    stl = format!("{}endsolid cad_eng_gear_barrel\n", stl);
    let t1_ns: i64 = clock_ns();

    let stl_valid: bool = stl.starts_with("solid ")
        && stl.contains("endsolid ")
        && stl.contains("facet normal ")
        && tri_count == 112;

    if stl_valid && max_inv_err_mm < 1.0e-3 && max_norm_err <= 1.0e-12 {
        println!(
            "[PASS] cad_eng_stl tris={} r_base={:.9} max_inv_err_mm={:.3e} norm_err={:.3e} stl_bytes={}",
            tri_count,
            r_base,
            max_inv_err_mm,
            max_norm_err,
            stl.len()
        );
    } else {
        println!("[FAIL] cad_eng_stl valid={} tris={} err={}", stl_valid, tri_count, max_inv_err_mm);
        failures = failures + 1;
    }

    // 3. Planted failing controls: negative barrel clearance AND degenerate non-manifold triangle
    let bad_clear: bool = barrel_clearance_ok(28.0, 27.5, 30.0);
    let deg_v: Vec3 = Vec3 { x: 1.0, y: 2.0, z: 3.0 };
    let deg_tri: TriCheck = check_triangle(&deg_v, &deg_v, &Vec3 { x: 4.0, y: 5.0, z: 6.0 });
    if !bad_clear && !deg_tri.ok {
        println!("[PASS] planted_cad_traps caught neg_clearance_rejected=true degen_tri_rejected=true");
    } else {
        println!("[FAIL] planted_cad_traps missed");
        failures = failures + 1;
    }

    println!("[BENCH] cad_eng stl_gen_ns={}", t1_ns - t0_ns);

    if failures == 0 {
        println!("[PASS] cad_eng summary failures=0");
    } else {
        println!("[FAIL] cad_eng summary failures={}", failures);
    }
}
