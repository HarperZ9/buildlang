// Photonics-Geo GPU 320-Pack: Hillaire 2020 multiscattering atmosphere sky LUT kernel.
// Integrates Rayleigh, Mie, and Ozone extinction with Henyey-Greenstein phase anisotropy
// and evaluates the geometric-series multiscattering transfer factor Psi_ms.

#[compute(workgroup_size = [64, 1, 1])]
fn atmosphere_multiscatter_lut_gpu(
    g_mie: f32,
    albedo_ground: f32,
    dt_ray: f32,
    sigma_ray_buf: &[f32],
    sigma_mie_buf: &[f32],
    sigma_oz_buf: &[f32],
    cos_theta_buf: &[f32],
    trans_sun_buf: &[f32],
    l2_prev_buf: &[f32],
    fms_prev_buf: &[f32],
    psi_ms_out: &mut [f32],
    l_total_out: &mut [f32],
) ~ Gpu {
    let i = gl_GlobalInvocationID.x;
    let s_ray: f32 = sigma_ray_buf[i];
    let s_mie: f32 = sigma_mie_buf[i];
    let s_ext: f32 = s_ray + s_mie * 1.11 + sigma_oz_buf[i] + 0.000001;
    let s_scat: f32 = s_ray + s_mie;

    let tau: f32 = s_ext * dt_ray;
    let trans_step: f32 = 1.0 / (1.0 + tau + 0.5 * tau * tau + 0.16666667 * tau * tau * tau);

    let mu: f32 = cos_theta_buf[i];
    let phase_ray: f32 = 0.0596831 * (1.0 + mu * mu);
    let g2: f32 = g_mie * g_mie;
    let hg_base: f32 = 1.0 + g2 - 2.0 * g_mie * mu + 0.0001;
    let mut hg_sqrt: f32 = 0.5 * (hg_base + 1.0);
    hg_sqrt = 0.5 * (hg_sqrt + hg_base / hg_sqrt);
    hg_sqrt = 0.5 * (hg_sqrt + hg_base / hg_sqrt);
    let phase_mie: f32 = 0.07957747 * (1.0 - g2) / (hg_base * hg_sqrt + 0.000001);

    let integ_factor: f32 = (1.0 - trans_step) / s_ext;
    let l_single: f32 = (s_ray * phase_ray + s_mie * phase_mie) * trans_sun_buf[i] * integ_factor;
    let f_ms_step: f32 = s_scat * 0.07957747 * integ_factor;

    let mut f_ms: f32 = fms_prev_buf[i] + f_ms_step * (1.0 + 0.25 * albedo_ground);
    if f_ms > 0.95 {
        f_ms = 0.95;
    }
    let l2: f32 = l2_prev_buf[i] + l_single;
    let psi_ms: f32 = l2 / (1.0 - f_ms);

    psi_ms_out[i] = psi_ms;
    l_total_out[i] = l_single + psi_ms * s_scat * 0.07957747;
}
