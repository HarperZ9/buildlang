// Titan AI/RLVR 240-Pack: Fused 4-feature RMSNorm + SwiGLU MLP gate compute kernel.
// Computes inverse RMS via Newton-Raphson iterations over four activation features,
// evaluates rational SiLU-gated SwiGLU projection, and adds bounded residual skip.

#[compute(workgroup_size = [64, 1, 1])]
fn rmsnorm_swiglu_fused(
    eps: f32,
    w_gate: f32,
    w_up: f32,
    res_scale: f32,
    x0_buf: &[f32],
    x1_buf: &[f32],
    x2_buf: &[f32],
    x3_buf: &[f32],
    gamma_buf: &[f32],
    y_out: &mut [f32],
) ~ Gpu {
    let i = gl_GlobalInvocationID.x;
    let x0: f32 = x0_buf[i];
    let x1: f32 = x1_buf[i];
    let x2: f32 = x2_buf[i];
    let x3: f32 = x3_buf[i];
    let g: f32 = gamma_buf[i];

    let ms: f32 = 0.25 * (x0 * x0 + x1 * x1 + x2 * x2 + x3 * x3) + eps;
    let mut rms: f32 = 0.5 * (ms + 1.0);
    rms = 0.5 * (rms + ms / rms);
    rms = 0.5 * (rms + ms / rms);
    rms = 0.5 * (rms + ms / rms);
    let inv_rms: f32 = g / (rms + eps);

    let n0: f32 = x0 * inv_rms;
    let n1: f32 = x1 * inv_rms;
    let n2: f32 = x2 * inv_rms;
    let n3: f32 = x3 * inv_rms;

    let gate: f32 = w_gate * (n0 + 0.5 * n2) + 0.25 * n1;
    let up: f32 = w_up * (n1 + 0.5 * n3) + 0.25 * n0;
    let sig: f32 = 0.5 + (0.5 * gate) / (1.0 + gate * gate);
    let mut y: f32 = (gate * sig) * up + res_scale * x0;
    if y < -24.0 {
        y = -24.0;
    }
    if y > 24.0 {
        y = 24.0;
    }
    y_out[i] = y;
}
