// Titan AI/RLVR 240-Pack: Sparse MoE top-2 load-balanced capacity router compute kernel.
// Ranks four auxiliary-balanced expert logits, throttles overloaded capacity factor lanes,
// renormalizes top-2 probabilities to unit sum, and emits routed expert output.

#[compute(workgroup_size = [64, 1, 1])]
fn moe_topk2_capacity_router(
    balance_gain: f32,
    cap_factor: f32,
    e0_buf: &[f32],
    e1_buf: &[f32],
    e2_buf: &[f32],
    e3_buf: &[f32],
    load_buf: &[f32],
    x_buf: &[f32],
    y_out: &mut [f32],
    w1_out: &mut [f32],
    w2_out: &mut [f32],
) ~ Gpu {
    let i = gl_GlobalInvocationID.x;
    let pen: f32 = balance_gain * load_buf[i];
    let s0: f32 = e0_buf[i] - pen;
    let s1: f32 = e1_buf[i] + 0.5 * pen;
    let s2: f32 = e2_buf[i] - 0.5 * pen;
    let s3: f32 = e3_buf[i] + 0.25 * pen;

    let mut top1: f32 = s0;
    let mut top2: f32 = s1;
    if s1 > top1 {
        top2 = top1;
        top1 = s1;
    }
    if s2 > top1 {
        top2 = top1;
        top1 = s2;
    } else {
        if s2 > top2 {
            top2 = s2;
        }
    }
    if s3 > top1 {
        top2 = top1;
        top1 = s3;
    } else {
        if s3 > top2 {
            top2 = s3;
        }
    }

    let mut gap: f32 = top1 - top2;
    if gap < 0.0 {
        gap = 0.0;
    }
    let e2_rel: f32 = 1.0 / (1.0 + gap + 0.5 * gap * gap);
    let inv_sum: f32 = 1.0 / (1.0 + e2_rel);
    let mut w1: f32 = inv_sum;
    let mut w2: f32 = e2_rel * inv_sum;

    if load_buf[i] > cap_factor {
        w1 = 0.5 * w1;
        w2 = 1.0 - w1;
    }

    y_out[i] = x_buf[i] * (w1 * top1 + w2 * top2);
    w1_out[i] = w1;
    w2_out[i] = w2;
}
