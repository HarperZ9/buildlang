// BuildOS Track 1: Capability-to-Landlock/Seccomp Policy Compiler (buildos_cap_sandbox.bld)
// Translates declared BuildLang effect rows into strict Linux Landlock v4 + seccomp-BPF
// allowlist policies + canonical FIPS 180-4 SHA-256 policy digest.
// Zero ambient authority. Zero em/en dashes. Safe BuildLang 1.15.0 idioms only.

// Return codes
const SB_OK: i64 = 0;
const ERR_NET_ESCAPE: i64 = -201;
const ERR_FS_WRITE_ESCAPE: i64 = -202;
const ERR_PROC_EXEC_ESCAPE: i64 = -203;
const ERR_UNKNOWN_CAP: i64 = -204;

// Declared BuildLang effect-row bitmask
const EFF_PURE: u64 = 0_u64;
const EFF_CONSOLE: u64 = 1_u64;
const EFF_FS_RO: u64 = 2_u64;
const EFF_FS_RW: u64 = 4_u64;
const EFF_NET_LOCAL: u64 = 8_u64;
const EFF_PROCESS: u64 = 16_u64;

// Linux Landlock v4 ABI rights bitmask
const LL_FS_READ_FILE: u64 = 1_u64;
const LL_FS_READ_DIR: u64 = 2_u64;
const LL_FS_WRITE_FILE: u64 = 4_u64;
const LL_FS_REMOVE_FILE: u64 = 8_u64;
const LL_FS_MAKE_REG: u64 = 16_u64;
const LL_NET_BIND_LOCAL: u64 = 32_u64;
const LL_NET_CONNECT_LOCAL: u64 = 64_u64;

// Linux x86-64 / RV64 canonical syscall operation IDs
const SYSCALL_EXIT_GROUP: i64 = 231;
const SYSCALL_WRITE_STDIO: i64 = 1;
const SYSCALL_OPENAT_RO: i64 = 257;
const SYSCALL_WRITE_FILE: i64 = 1001;
const SYSCALL_UNLINKAT: i64 = 263;
const SYSCALL_SOCKET: i64 = 41;
const SYSCALL_CONNECT: i64 = 42;
const SYSCALL_EXECVE: i64 = 59;

// Seccomp allowlist bitmask
const SEC_BASE_EXIT: u64 = 1_u64;
const SEC_STDIO_WRITE: u64 = 2_u64;
const SEC_FS_OPEN_RO: u64 = 4_u64;
const SEC_FS_WRITE_UNLINK: u64 = 8_u64;
const SEC_NET_LOCAL: u64 = 16_u64;
const SEC_PROC_EXEC: u64 = 32_u64;

// ============================================================================
// Pure-BuildLang FIPS 180-4 SHA-256 (32-bit masked wrapping arithmetic)
// ============================================================================

fn mask32(x: u64) -> u64 {
    x & 0xFFFFFFFF_u64
}

fn rotr32(x: u64, n: u64) -> u64 {
    let v: u64 = mask32(x);
    mask32((v >> n) | (v << (32_u64 - n)))
}

fn sha256_k(idx: usize) -> u64 {
    let k: Vec<u64> = vec![
        0x428a2f98_u64, 0x71374491_u64, 0xb5c0fbcf_u64, 0xe9b5dba5_u64,
        0x3956c25b_u64, 0x59f111f1_u64, 0x923f82a4_u64, 0xab1c5ed5_u64,
        0xd807aa98_u64, 0x12835b01_u64, 0x243185be_u64, 0x550c7dc3_u64,
        0x72be5d74_u64, 0x80deb1fe_u64, 0x9bdc06a7_u64, 0xc19bf174_u64,
        0xe49b69c1_u64, 0xefbe4786_u64, 0x0fc19dc6_u64, 0x240ca1cc_u64,
        0x2de92c6f_u64, 0x4a7484aa_u64, 0x5cb0a9dc_u64, 0x76f988da_u64,
        0x983e5152_u64, 0xa831c66d_u64, 0xb00327c8_u64, 0xbf597fc7_u64,
        0xc6e00bf3_u64, 0xd5a79147_u64, 0x06ca6351_u64, 0x14292967_u64,
        0x27b70a85_u64, 0x2e1b2138_u64, 0x4d2c6dfc_u64, 0x53380d13_u64,
        0x650a7354_u64, 0x766a0abb_u64, 0x81c2c92e_u64, 0x92722c85_u64,
        0xa2bfe8a1_u64, 0xa81a664b_u64, 0xc24b8b70_u64, 0xc76c51a3_u64,
        0xd192e819_u64, 0xd6990624_u64, 0xf40e3585_u64, 0x106aa070_u64,
        0x19a4c116_u64, 0x1e376c08_u64, 0x2748774c_u64, 0x34b0bcb5_u64,
        0x391c0cb3_u64, 0x4ed8aa4a_u64, 0x5b9cca4f_u64, 0x682e6ff3_u64,
        0x748f82ee_u64, 0x78a5636f_u64, 0x84c87814_u64, 0x8cc70208_u64,
        0x90befffa_u64, 0xa4506ceb_u64, 0xbef9a3f7_u64, 0xc67178f2_u64,
    ];
    k[idx]
}

struct Sha256Digest {
    h0: u64, h1: u64, h2: u64, h3: u64,
    h4: u64, h5: u64, h6: u64, h7: u64,
}

fn sha256_bytes(data: &Vec<u64>) -> Sha256Digest {
    let orig_len: u64 = data.len() as u64;
    let mut msg: Vec<u64> = Vec::new();
    let mut i: usize = 0;
    while i < data.len() {
        msg.push(data[i] & 0xFF_u64);
        i = i + 1;
    }
    msg.push(0x80_u64);
    while (msg.len() % 64) != 56 {
        msg.push(0_u64);
    }
    let bit_len: u64 = orig_len * 8_u64;
    let mut s: i64 = 56;
    while s >= 0 {
        msg.push((bit_len >> (s as u64)) & 0xFF_u64);
        s = s - 8;
    }

    let mut h0: u64 = 0x6a09e667_u64;
    let mut h1: u64 = 0xbb67ae85_u64;
    let mut h2: u64 = 0x3c6ef372_u64;
    let mut h3: u64 = 0xa54ff53a_u64;
    let mut h4: u64 = 0x510e527f_u64;
    let mut h5: u64 = 0x9b05688c_u64;
    let mut h6: u64 = 0x1f83d9ab_u64;
    let mut h7: u64 = 0x5be0cd19_u64;

    let mut off: usize = 0;
    while off < msg.len() {
        let mut w: Vec<u64> = Vec::new();
        let mut t: usize = 0;
        while t < 16 {
            let b0: u64 = msg[off + t * 4];
            let b1: u64 = msg[off + t * 4 + 1];
            let b2: u64 = msg[off + t * 4 + 2];
            let b3: u64 = msg[off + t * 4 + 3];
            w.push((b0 << 24_u64) | (b1 << 16_u64) | (b2 << 8_u64) | b3);
            t = t + 1;
        }
        while t < 64 {
            let s0: u64 = rotr32(w[t - 15], 7_u64) ^ rotr32(w[t - 15], 18_u64) ^ (w[t - 15] >> 3_u64);
            let s1: u64 = rotr32(w[t - 2], 17_u64) ^ rotr32(w[t - 2], 19_u64) ^ (w[t - 2] >> 10_u64);
            w.push(mask32(w[t - 16] + s0 + w[t - 7] + s1));
            t = t + 1;
        }
        let mut a: u64 = h0;
        let mut b: u64 = h1;
        let mut c: u64 = h2;
        let mut d: u64 = h3;
        let mut e: u64 = h4;
        let mut f: u64 = h5;
        let mut g: u64 = h6;
        let mut hh: u64 = h7;

        let mut r: usize = 0;
        while r < 64 {
            let big_s1: u64 = rotr32(e, 6_u64) ^ rotr32(e, 11_u64) ^ rotr32(e, 25_u64);
            let ch: u64 = (e & f) ^ (mask32(!e) & g);
            let temp1: u64 = mask32(hh + big_s1 + ch + sha256_k(r) + w[r]);
            let big_s0: u64 = rotr32(a, 2_u64) ^ rotr32(a, 13_u64) ^ rotr32(a, 22_u64);
            let maj: u64 = (a & b) ^ (a & c) ^ (b & c);
            let temp2: u64 = mask32(big_s0 + maj);

            hh = g;
            g = f;
            f = e;
            e = mask32(d + temp1);
            d = c;
            c = b;
            b = a;
            a = mask32(temp1 + temp2);
            r = r + 1;
        }
        h0 = mask32(h0 + a);
        h1 = mask32(h1 + b);
        h2 = mask32(h2 + c);
        h3 = mask32(h3 + d);
        h4 = mask32(h4 + e);
        h5 = mask32(h5 + f);
        h6 = mask32(h6 + g);
        h7 = mask32(h7 + hh);
        off = off + 64;
    }

    Sha256Digest { h0: h0, h1: h1, h2: h2, h3: h3, h4: h4, h5: h5, h6: h6, h7: h7 }
}

fn digest_eq(a: &Sha256Digest, b: &Sha256Digest) -> bool {
    a.h0 == b.h0 && a.h1 == b.h1 && a.h2 == b.h2 && a.h3 == b.h3
        && a.h4 == b.h4 && a.h5 == b.h5 && a.h6 == b.h6 && a.h7 == b.h7
}

fn push_u64_be(buf: &mut Vec<u64>, v: u64) {
    let mut s: i64 = 56;
    while s >= 0 {
        buf.push((v >> (s as u64)) & 0xFF_u64);
        s = s - 8;
    }
}

// ============================================================================
// Effect Parser + Landlock/Seccomp Policy Compiler + Runtime Enforcer
// ============================================================================

fn parse_single_effect(tok: &String) -> i64 {
    if tok == "pure" { return EFF_PURE as i64; }
    if tok == "Console" { return EFF_CONSOLE as i64; }
    if tok == "FileSystem(ro)" { return EFF_FS_RO as i64; }
    if tok == "FileSystem(rw)" { return EFF_FS_RW as i64; }
    if tok == "Network(local)" { return EFF_NET_LOCAL as i64; }
    if tok == "Process" { return EFF_PROCESS as i64; }
    ERR_UNKNOWN_CAP
}

struct SandboxPolicy {
    ok: bool,
    err_code: i64,
    effect_mask: u64,
    landlock_mask: u64,
    seccomp_mask: u64,
    sha: Sha256Digest,
}

fn compile_policy(effects: &Vec<String>) -> SandboxPolicy {
    let mut eff_mask: u64 = 0_u64;
    let mut i: usize = 0;
    while i < effects.len() {
        let code: i64 = parse_single_effect(&effects[i]);
        if code < 0 {
            let zero_d: Sha256Digest = Sha256Digest {
                h0: 0_u64, h1: 0_u64, h2: 0_u64, h3: 0_u64,
                h4: 0_u64, h5: 0_u64, h6: 0_u64, h7: 0_u64,
            };
            return SandboxPolicy {
                ok: false,
                err_code: code,
                effect_mask: 0_u64,
                landlock_mask: 0_u64,
                seccomp_mask: 0_u64,
                sha: zero_d,
            };
        }
        eff_mask = eff_mask | (code as u64);
        i = i + 1;
    }

    let mut ll: u64 = 0_u64;
    let mut sec: u64 = SEC_BASE_EXIT;

    if (eff_mask & EFF_CONSOLE) != 0_u64 {
        sec = sec | SEC_STDIO_WRITE;
    }
    if (eff_mask & EFF_FS_RO) != 0_u64 {
        ll = ll | LL_FS_READ_FILE | LL_FS_READ_DIR;
        sec = sec | SEC_FS_OPEN_RO;
    }
    if (eff_mask & EFF_FS_RW) != 0_u64 {
        ll = ll | LL_FS_READ_FILE | LL_FS_READ_DIR | LL_FS_WRITE_FILE | LL_FS_REMOVE_FILE | LL_FS_MAKE_REG;
        sec = sec | SEC_FS_OPEN_RO | SEC_FS_WRITE_UNLINK;
    }
    if (eff_mask & EFF_NET_LOCAL) != 0_u64 {
        ll = ll | LL_NET_BIND_LOCAL | LL_NET_CONNECT_LOCAL;
        sec = sec | SEC_NET_LOCAL;
    }
    if (eff_mask & EFF_PROCESS) != 0_u64 {
        sec = sec | SEC_PROC_EXEC;
    }

    // Canonical binary policy manifest -> FIPS 180-4 SHA-256
    let mut raw: Vec<u64> = Vec::new();
    // Header tag "BLSB" + version 1
    raw.push(66_u64);
    raw.push(76_u64);
    raw.push(83_u64);
    raw.push(66_u64);
    raw.push(1_u64);
    push_u64_be(&mut raw, eff_mask);
    push_u64_be(&mut raw, ll);
    push_u64_be(&mut raw, sec);
    let dig: Sha256Digest = sha256_bytes(&raw);

    SandboxPolicy {
        ok: true,
        err_code: SB_OK,
        effect_mask: eff_mask,
        landlock_mask: ll,
        seccomp_mask: sec,
        sha: dig,
    }
}

fn enforce_syscall(pol: &SandboxPolicy, syscall_id: i64) -> i64 {
    if !pol.ok {
        return pol.err_code;
    }
    if syscall_id == SYSCALL_EXIT_GROUP {
        return SB_OK;
    }
    if syscall_id == SYSCALL_WRITE_STDIO {
        if (pol.seccomp_mask & SEC_STDIO_WRITE) != 0_u64 { return SB_OK; }
        return ERR_FS_WRITE_ESCAPE;
    }
    if syscall_id == SYSCALL_OPENAT_RO {
        if (pol.seccomp_mask & SEC_FS_OPEN_RO) != 0_u64 && (pol.landlock_mask & LL_FS_READ_FILE) != 0_u64 {
            return SB_OK;
        }
        return ERR_FS_WRITE_ESCAPE;
    }
    if syscall_id == SYSCALL_WRITE_FILE || syscall_id == SYSCALL_UNLINKAT {
        let ll_ok: bool = (pol.landlock_mask & (LL_FS_WRITE_FILE | LL_FS_REMOVE_FILE)) != 0_u64;
        if (pol.seccomp_mask & SEC_FS_WRITE_UNLINK) != 0_u64 && ll_ok {
            return SB_OK;
        }
        return ERR_FS_WRITE_ESCAPE;
    }
    if syscall_id == SYSCALL_SOCKET || syscall_id == SYSCALL_CONNECT {
        if (pol.seccomp_mask & SEC_NET_LOCAL) != 0_u64 && (pol.landlock_mask & LL_NET_CONNECT_LOCAL) != 0_u64 {
            return SB_OK;
        }
        return ERR_NET_ESCAPE;
    }
    if syscall_id == SYSCALL_EXECVE {
        if (pol.seccomp_mask & SEC_PROC_EXEC) != 0_u64 {
            return SB_OK;
        }
        return ERR_PROC_EXEC_ESCAPE;
    }
    ERR_UNKNOWN_CAP
}

fn main() -> i64 ~ Console {
    // Verify pure SHA-256 known-answer test: SHA256("abc") first word == 0xba7816bf
    let abc: Vec<u64> = vec![97_u64, 98_u64, 99_u64];
    let abc_d: Sha256Digest = sha256_bytes(&abc);
    let sha_kat_ok: bool = abc_d.h0 == 0xba7816bf_u64 && abc_d.h7 == 0xf20015ad_u64;
    println("SHA256_KAT_ABC: ok={} h0={} h7={}", sha_kat_ok, abc_d.h0, abc_d.h7);

    // Compile canonical policies for pure, FileSystem(ro)+Console, and full Workstation daemon
    let eff_pure: Vec<String> = vec!["pure".to_string()];
    let eff_ro: Vec<String> = vec!["Console".to_string(), "FileSystem(ro)".to_string()];
    let eff_daemon: Vec<String> = vec![
        "Console".to_string(),
        "FileSystem(rw)".to_string(),
        "Network(local)".to_string(),
        "Process".to_string(),
    ];

    let pol_pure_1: SandboxPolicy = compile_policy(&eff_pure);
    let pol_pure_2: SandboxPolicy = compile_policy(&eff_pure);
    let pol_ro: SandboxPolicy = compile_policy(&eff_ro);
    let pol_daemon: SandboxPolicy = compile_policy(&eff_daemon);

    let det_ok: bool = pol_pure_1.ok && digest_eq(&pol_pure_1.sha, &pol_pure_2.sha)
        && !digest_eq(&pol_pure_1.sha, &pol_ro.sha)
        && !digest_eq(&pol_ro.sha, &pol_daemon.sha);

    let allow_ok: bool = enforce_syscall(&pol_ro, SYSCALL_OPENAT_RO) == SB_OK
        && enforce_syscall(&pol_ro, SYSCALL_WRITE_STDIO) == SB_OK
        && enforce_syscall(&pol_daemon, SYSCALL_CONNECT) == SB_OK
        && enforce_syscall(&pol_daemon, SYSCALL_EXECVE) == SB_OK;

    println(
        "POLICY_PURE: ok={} ll={} sec={} sha_h0={} sha_h1={}",
        pol_pure_1.ok, pol_pure_1.landlock_mask, pol_pure_1.seccomp_mask, pol_pure_1.sha.h0, pol_pure_1.sha.h1
    );
    println(
        "POLICY_FS_RO: ok={} ll={} sec={} sha_h0={} sha_h1={}",
        pol_ro.ok, pol_ro.landlock_mask, pol_ro.seccomp_mask, pol_ro.sha.h0, pol_ro.sha.h1
    );
    println(
        "POLICY_DAEMON: ok={} ll={} sec={} sha_h0={} sha_h1={}",
        pol_daemon.ok, pol_daemon.landlock_mask, pol_daemon.seccomp_mask, pol_daemon.sha.h0, pol_daemon.sha.h1
    );

    // 4/4 Planted Sandbox-Escape Controls
    let mut caught: i64 = 0;

    // Control 1: pure app calling socket() / connect()
    let c1_sock: i64 = enforce_syscall(&pol_pure_1, SYSCALL_SOCKET);
    let c1_conn: i64 = enforce_syscall(&pol_pure_1, SYSCALL_CONNECT);
    if c1_sock == ERR_NET_ESCAPE && c1_conn == ERR_NET_ESCAPE {
        println("CONTROL_1_PURE_NET_ESCAPE: CAUGHT_FAIL_CLOSED rc_sock={} rc_conn={}", c1_sock, c1_conn);
        caught = caught + 1;
    }

    // Control 2: FileSystem(ro) app calling unlink() / write_file()
    let c2_unlink: i64 = enforce_syscall(&pol_ro, SYSCALL_UNLINKAT);
    let c2_write: i64 = enforce_syscall(&pol_ro, SYSCALL_WRITE_FILE);
    if c2_unlink == ERR_FS_WRITE_ESCAPE && c2_write == ERR_FS_WRITE_ESCAPE {
        println("CONTROL_2_FS_RO_WRITE_ESCAPE: CAUGHT_FAIL_CLOSED rc_unlink={} rc_write={}", c2_unlink, c2_write);
        caught = caught + 1;
    }

    // Control 3: Undeclared Process effect calling execve()
    let c3_exec: i64 = enforce_syscall(&pol_ro, SYSCALL_EXECVE);
    if c3_exec == ERR_PROC_EXEC_ESCAPE {
        println("CONTROL_3_UNDECLARED_EXECVE: CAUGHT_FAIL_CLOSED rc_exec={}", c3_exec);
        caught = caught + 1;
    }

    // Control 4: Unknown or forged capability string
    let forged: Vec<String> = vec!["Console".to_string(), "KernelAdmin(all)".to_string()];
    let pol_forged: SandboxPolicy = compile_policy(&forged);
    if !pol_forged.ok && pol_forged.err_code == ERR_UNKNOWN_CAP {
        println("CONTROL_4_FORGED_CAPABILITY: CAUGHT_FAIL_CLOSED rc={}", pol_forged.err_code);
        caught = caught + 1;
    }

    println("SANDBOX_CONTROLS: caught={}/4 det_ok={} allow_ok={} sha_kat_ok={}", caught, det_ok, allow_ok, sha_kat_ok);
    if sha_kat_ok && det_ok && allow_ok && caught == 4 {
        println("BUILDOS_CAP_SANDBOX ALL_PASS checks=7 failures=0");
        return 0;
    }
    println("BUILDOS_CAP_SANDBOX FAILED");
    1
}
