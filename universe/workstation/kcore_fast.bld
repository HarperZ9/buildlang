//
// BuildLang Dogfood Kernel Suite (Layer 1, 12 Verified FORMULAS.tsv Equations):
//   1.  HASH-FNV : FNV-1a 64-bit hash matching Superframe native/bld/kit.bld (1469598103934665603)
//   2.  COL-001  : IEC 61966-2-1 sRGB transfer function and inverse
//   3.  COL-003  : CIE XYZ (D65) to CIELAB using native cbrt
//   4.  COL-005  : Linear sRGB to Oklab perceptual coordinates using native cbrt
//   5.  COL-030  : WCAG 2.x relative luminance contrast ratio
//   6.  OPT-001  : Vector Snell refraction with total internal reflection detection
//   7.  OPT-002  : Unpolarized dielectric Fresnel reflectance with TIR
//   8.  OPT-004  : Schlick Fresnel approximation
//   9.  OPT-008  : Airy disc diffraction radius (1.22 and exact j1/pi forms)
//   10. OPT-014  : Three-term Sellmeier dispersion (verified on textbook N-BK7)
//   11. OPT-033  : Beer-Lambert optical transmission T = exp(-alpha * d)
//   12. SIG-013  : Shannon information entropy H = -sum(p * log2(p)) in bits
//
// Each equation includes known-answer checks (<= 1e-12 vs f64 reference) AND a
// planted-wrong-control test that MUST be caught, plus a 1,048,576-point par_for
// multi-thread sweep verified bit-exact across thread counts and timed via clock_ns().

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    x
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    b
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b {
        return a;
    }
    b
}

struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

struct SnellResult {
    tir: bool,
    dir: Vec3,
}

// ---------------------------------------------------------------- 1. HASH-FNV (Superframe parity)

fn fnv_start() -> u64 {
    1469598103934665603
}

fn fnv_u8(h0: u64, b: u64) -> u64 {
    (h0 ^ b).wrapping_mul(1099511628211)
}

fn fnv_f32(h0: u64, v: f64) -> u64 {
    let bits: u32 = (v as f32).to_bits();
    let mut h: u64 = h0;
    let mut k: u32 = 0;
    while k < 4 {
        h = fnv_u8(h, ((bits >> (8 * k)) & 255) as u64);
        k = k + 1;
    }
    h
}

fn fnv_u64(h0: u64, v: u64) -> u64 {
    let mut h: u64 = h0;
    let mut k: u64 = 0;
    while k < 8 {
        h = fnv_u8(h, (v >> (8 * k)) & 255);
        k = k + 1;
    }
    h
}

fn fnv_str(s: str) -> u64 {
    let b = s.as_bytes();
    let n = s.len();
    let mut h: u64 = fnv_start();
    let mut i: usize = 0;
    while i < n {
        h = fnv_u8(h, b[i] as u64);
        i = i + 1;
    }
    h
}

// ---------------------------------------------------------------- 2. COL-001: sRGB transfer

fn srgb_to_linear(v: f64) -> f64 {
    if v <= 0.04045 {
        return v / 12.92;
    }
    pow((v + 0.055) / 1.055, 2.4)
}

fn linear_to_srgb(lin: f64) -> f64 {
    if lin <= 0.0031308 {
        return lin * 12.92;
    }
    1.055 * pow(lin, 1.0 / 2.4) - 0.055
}

// ---------------------------------------------------------------- 3. COL-003: XYZ to CIELAB

fn lab_f(t: f64) -> f64 {
    let eps: f64 = 216.0 / 24389.0;
    let kap: f64 = 24389.0 / 27.0;
    if t > eps {
        return cbrt(t);
    }
    (kap * t + 16.0) / 116.0
}

fn xyz_to_cielab(x: f64, y: f64, z: f64, xn: f64, yn: f64, zn: f64) -> Vec3 {
    let fx: f64 = lab_f(x / xn);
    let fy: f64 = lab_f(y / yn);
    let fz: f64 = lab_f(z / zn);
    Vec3 {
        x: 116.0 * fy - 16.0,
        y: 500.0 * (fx - fy),
        z: 200.0 * (fy - fz),
    }
}

// ---------------------------------------------------------------- 4. COL-005: Linear sRGB to Oklab

fn linear_srgb_to_oklab(r: f64, g: f64, b: f64) -> Vec3 {
    let l: f64 = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b;
    let m: f64 = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b;
    let s: f64 = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b;
    let l_: f64 = cbrt(l);
    let m_: f64 = cbrt(m);
    let s_: f64 = cbrt(s);
    Vec3 {
        x: 0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        y: 1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        z: 0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_,
    }
}

// ---------------------------------------------------------------- 5. COL-030: WCAG contrast ratio

fn wcag_contrast(l1: f64, l2: f64) -> f64 {
    let hi: f64 = max_f64(l1, l2);
    let lo: f64 = min_f64(l1, l2);
    (hi + 0.05) / (lo + 0.05)
}

// ---------------------------------------------------------------- 6. OPT-001: Vector Snell refraction

fn snell_refract(d: Vec3, n: Vec3, n1: f64, n2: f64) -> SnellResult {
    let e: f64 = n1 / n2;
    let c: f64 = -(d.x * n.x + d.y * n.y + d.z * n.z);
    let k: f64 = 1.0 - e * e * (1.0 - c * c);
    if k < 0.0 {
        return SnellResult {
            tir: true,
            dir: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        };
    }
    let s: f64 = e * c - sqrt(k);
    SnellResult {
        tir: false,
        dir: Vec3 {
            x: e * d.x + s * n.x,
            y: e * d.y + s * n.y,
            z: e * d.z + s * n.z,
        },
    }
}

// ---------------------------------------------------------------- 7. OPT-002: Fresnel dielectric

fn fresnel_dielectric(n1: f64, n2: f64, cos_i: f64) -> f64 {
    let sin2_i: f64 = 1.0 - cos_i * cos_i;
    let eta: f64 = n1 / n2;
    let sin2_t: f64 = eta * eta * sin2_i;
    if sin2_t >= 1.0 {
        return 1.0;
    }
    let cos_t: f64 = sqrt(1.0 - sin2_t);
    let rs_num: f64 = n1 * cos_i - n2 * cos_t;
    let rs_den: f64 = n1 * cos_i + n2 * cos_t;
    let rp_num: f64 = n1 * cos_t - n2 * cos_i;
    let rp_den: f64 = n1 * cos_t + n2 * cos_i;
    let rs: f64 = (rs_num / rs_den) * (rs_num / rs_den);
    let rp: f64 = (rp_num / rp_den) * (rp_num / rp_den);
    0.5 * (rs + rp)
}

fn fresnel_planted_missing_tir(n1: f64, n2: f64, cos_i: f64) -> f64 {
    let sin2_i: f64 = 1.0 - cos_i * cos_i;
    let eta: f64 = n1 / n2;
    let sin2_t: f64 = eta * eta * sin2_i;
    let mut cos_t: f64 = 0.5;
    if sin2_t < 1.0 {
        cos_t = sqrt(1.0 - sin2_t);
    }
    let rs_num: f64 = n1 * cos_i - n2 * cos_t;
    let rs_den: f64 = n1 * cos_i + n2 * cos_t;
    let rp_num: f64 = n1 * cos_t - n2 * cos_i;
    let rp_den: f64 = n1 * cos_t + n2 * cos_i;
    let rs: f64 = (rs_num / rs_den) * (rs_num / rs_den);
    let rp: f64 = (rp_num / rp_den) * (rp_num / rp_den);
    0.5 * (rs + rp)
}

// ---------------------------------------------------------------- 8. OPT-004: Schlick approximation

fn schlick_fresnel(f0: f64, cos_theta: f64) -> f64 {
    let omc: f64 = 1.0 - cos_theta;
    let omc2: f64 = omc * omc;
    f0 + (1.0 - f0) * (omc2 * omc2 * omc)
}

// ---------------------------------------------------------------- 9. OPT-008: Airy disc radius

fn airy_radius(lam: f64, f_num: f64, exact_j1: bool) -> f64 {
    if exact_j1 {
        return 1.2196698912665045 * lam * f_num;
    }
    1.22 * lam * f_num
}

// ---------------------------------------------------------------- 10. OPT-014: Sellmeier 3-term

fn sellmeier_3(
    lam_um: f64,
    b1: f64,
    b2: f64,
    b3: f64,
    c1: f64,
    c2: f64,
    c3: f64
) -> f64 {
    let l2: f64 = lam_um * lam_um;
    let n2: f64 = 1.0
        + (b1 * l2) / (l2 - c1)
        + (b2 * l2) / (l2 - c2)
        + (b3 * l2) / (l2 - c3);
    sqrt(n2)
}

// ---------------------------------------------------------------- 11. OPT-033: Beer-Lambert law

fn beer_lambert(alpha: f64, dist: f64) -> f64 {
    exp(-alpha * dist)
}

// ---------------------------------------------------------------- 12. SIG-013: Shannon entropy

fn shannon_entropy_2(p0: f64, p1: f64) -> f64 {
    let mut h: f64 = 0.0;
    if p0 > 0.0 {
        h = h - p0 * log2(p0);
    }
    if p1 > 0.0 {
        h = h - p1 * log2(p1);
    }
    h
}

fn shannon_entropy_4(p0: f64, p1: f64, p2: f64, p3: f64) -> f64 {
    shannon_entropy_2(p0, p1) + shannon_entropy_2(p2, p3)
}

// ---------------------------------------------------------------- Pure parallel 12-eq sweep

struct SweepCtx {
    chunks: i64,
    chunk_len: i64,
}

// Pure kernel (~ ()): evaluates all 12 equations per point and folds into FNV-1a.
fn eval_chunk(ctx: &SweepCtx, chunk_id: i64) -> u64 {
    let total: f64 = (ctx.chunks * ctx.chunk_len) as f64;
    let base: i64 = chunk_id * ctx.chunk_len;
    let mut h: u64 = fnv_start();
    let mut j: i64 = 0;
    while j < ctx.chunk_len {
        let idx: f64 = (base + j) as f64;
        let u: f64 = (idx + 0.5) / total;
        let lin: f64 = srgb_to_linear(u);
        let lab: Vec3 = xyz_to_cielab(0.95047 * lin, lin, 1.08883 * lin, 0.95047, 1.0, 1.08883);
        let ok: Vec3 = linear_srgb_to_oklab(lin, 0.5 * lin, 0.25 * lin);
        let wcag: f64 = wcag_contrast(lin, 1.0 - lin);
        let d_in = Vec3 { x: 0.5 * u, y: -sqrt(1.0 - 0.25 * u * u), z: 0.0 };
        let n_up = Vec3 { x: 0.0, y: 1.0, z: 0.0 };
        let snell: SnellResult = snell_refract(d_in, n_up, 1.0, 1.5);
        let fres: f64 = fresnel_dielectric(1.0, 1.5, u);
        let schlick: f64 = schlick_fresnel(0.04, u);
        let airy: f64 = airy_radius(0.4 + 0.3 * u, 2.0, true);
        let bk7: f64 = sellmeier_3(
            0.4 + 0.3 * u,
            1.03961212,
            0.231792344,
            1.01046945,
            0.00600069867,
            0.0200179144,
            103.560653
        );
        let trans: f64 = beer_lambert(2.0, u);
        let ent: f64 = shannon_entropy_2(u, 1.0 - u);

        h = fnv_f32(h, lin);
        h = fnv_f32(h, lab.x);
        h = fnv_f32(h, ok.x);
        h = fnv_f32(h, wcag);
        h = fnv_f32(h, snell.dir.x);
        h = fnv_f32(h, fres);
        h = fnv_f32(h, schlick);
        h = fnv_f32(h, airy);
        h = fnv_f32(h, bk7);
        h = fnv_f32(h, trans);
        h = fnv_f32(h, ent);
        j = j + 1;
    }
    h
}

fn reduce_chunk_hashes(parts: &Vec<u64>) -> u64 {
    let mut h: u64 = fnv_start();
    let mut i: usize = 0;
    while i < parts.len() {
        h = fnv_u64(h, parts[i]);
        i = i + 1;
    }
    h
}

// ---------------------------------------------------------------- Verification helpers

fn check_near(label: str, got: f64, want: f64, tol: f64) -> i32 ~ Console {
    let diff: f64 = abs_f64(got - want);
    if diff <= tol {
        println!("[PASS] {} got={} want={} diff={}", label, got, want, diff);
        return 0;
    }
    println!("[FAIL] {} got={} want={} diff={} tol={}", label, got, want, diff, tol);
    1
}

fn check_planted_gt(label: str, metric: f64, threshold: f64) -> i32 ~ Console {
    if metric > threshold {
        println!("[PASS] {} caught delta={}", label, metric);
        return 0;
    }
    println!("[FAIL] {} missed delta={} threshold={}", label, metric, threshold);
    1
}

fn verify_color_equations() -> i32 ~ Console {
    let mut f: i32 = 0;

    // 2. COL-001 sRGB transfer + inverse + planted gamma 2.2 control
    f = f + check_near("COL-001_zero", srgb_to_linear(0.0), 0.0, 1e-14);
    f = f + check_near("COL-001_half", srgb_to_linear(0.5), 0.21404114048223255, 1e-12);
    f = f + check_near("COL-001_roundtrip", linear_to_srgb(srgb_to_linear(0.5)), 0.5, 1e-12);
    f = f + check_planted_gt("planted_COL-001_gamma22", abs_f64(pow(0.5, 2.2) - 0.21404114048223255), 1e-3);

    // 3. COL-003 XYZ to CIELAB (D65 white = (100,0,0)) + planted D50 whitepoint control
    let lab_w: Vec3 = xyz_to_cielab(0.95047, 1.0, 1.08883, 0.95047, 1.0, 1.08883);
    f = f + check_near("COL-003_white_L", lab_w.x, 100.0, 1e-12);
    f = f + check_near("COL-003_white_a", lab_w.y, 0.0, 1e-12);
    f = f + check_near("COL-003_white_b", lab_w.z, 0.0, 1e-12);
    let lab_d50: Vec3 = xyz_to_cielab(0.95047, 1.0, 1.08883, 0.96422, 1.0, 0.82521);
    f = f + check_planted_gt("planted_COL-003_d50_shift", abs_f64(lab_d50.z), 1e-2);

    // 4. COL-005 Oklab (white -> (1,0,0)) + planted gamma-encoded input control
    let ok_w: Vec3 = linear_srgb_to_oklab(1.0, 1.0, 1.0);
    f = f + check_near("COL-005_white_L", ok_w.x, 1.0, 1e-6);
    f = f + check_near("COL-005_white_a", ok_w.y, 0.0, 1e-6);
    f = f + check_near("COL-005_white_b", ok_w.z, 0.0, 1e-6);
    let ok_lin: Vec3 = linear_srgb_to_oklab(0.21404114, 0.21404114, 0.21404114);
    let ok_gam: Vec3 = linear_srgb_to_oklab(0.5, 0.5, 0.5);
    f = f + check_planted_gt("planted_COL-005_gamma_input", abs_f64(ok_gam.x - ok_lin.x), 0.1);

    // 5. COL-030 WCAG contrast ratio + planted missing +0.05 numerator control
    f = f + check_near("COL-030_bw_21", wcag_contrast(1.0, 0.0), 21.0, 1e-12);
    f = f + check_near("COL-030_same_1", wcag_contrast(0.5, 0.5), 1.0, 1e-12);
    f = f + check_planted_gt("planted_COL-030_no_offset", abs_f64((1.0 / 0.05) - 21.0), 0.5);

    f
}

fn verify_optics_and_signal_equations() -> i32 ~ Console {
    let mut f: i32 = 0;

    // 6. OPT-001 Vector Snell refraction + planted TIR detection control
    let sn_norm: SnellResult = snell_refract(
        Vec3 { x: 0.0, y: -1.0, z: 0.0 },
        Vec3 { x: 0.0, y: 1.0, z: 0.0 },
        1.0,
        1.5
    );
    f = f + check_near("OPT-001_normal_y", sn_norm.dir.y, -1.0, 1e-12);
    let sn_oblique: SnellResult = snell_refract(
        Vec3 { x: 0.6, y: -0.8, z: 0.0 },
        Vec3 { x: 0.0, y: 1.0, z: 0.0 },
        1.0,
        1.5
    );
    f = f + check_near("OPT-001_snell_sin_t", sn_oblique.dir.x, 0.4, 1e-12);
    let sn_tir: SnellResult = snell_refract(
        Vec3 { x: 0.8660254037844386, y: -0.5, z: 0.0 },
        Vec3 { x: 0.0, y: 1.0, z: 0.0 },
        1.5,
        1.0
    );
    if sn_tir.tir {
        println!("[PASS] planted_OPT-001_tir caught");
    } else {
        println!("[FAIL] planted_OPT-001_tir missed");
        f = f + 1;
    }

    // 7. OPT-002 Fresnel dielectric + planted missing TIR control
    f = f + check_near("OPT-002_normal_n1.5", fresnel_dielectric(1.0, 1.5, 1.0), 0.04, 1e-12);
    f = f + check_near("OPT-002_tir", fresnel_dielectric(1.5, 1.0, 0.5), 1.0, 1e-12);
    f = f + check_planted_gt("planted_OPT-002_no_tir", abs_f64(fresnel_planted_missing_tir(1.5, 1.0, 0.5) - 1.0), 0.1);

    // 8. OPT-004 Schlick approximation + planted exponent-2 wrong control
    f = f + check_near("OPT-004_normal", schlick_fresnel(0.04, 1.0), 0.04, 1e-12);
    f = f + check_near("OPT-004_grazing", schlick_fresnel(0.04, 0.0), 1.0, 1e-12);
    let sch_half: f64 = schlick_fresnel(0.04, 0.5);
    f = f + check_near("OPT-004_half", sch_half, 0.07, 1e-12);
    let sch_bad: f64 = 0.04 + 0.96 * 0.25;
    f = f + check_planted_gt("planted_OPT-004_pow2", abs_f64(sch_bad - sch_half), 0.1);

    // 9. OPT-008 Airy disc radius + planted 1.22 vs exact j1/pi control
    let airy_std: f64 = airy_radius(0.550, 2.0, false);
    let airy_j1: f64 = airy_radius(0.550, 2.0, true);
    f = f + check_near("OPT-008_122", airy_std, 1.342, 1e-12);
    f = f + check_near("OPT-008_exact_j1", airy_j1, 1.341636880393155, 1e-12);
    f = f + check_planted_gt("planted_OPT-008_122_vs_j1", abs_f64(airy_std - airy_j1), 1e-4);

    // 10. OPT-014 Sellmeier 3-term (textbook N-BK7 d-line 0.5875618 um) + planted nm-unit control
    let nd_bk7: f64 = sellmeier_3(
        0.5875618,
        1.03961212,
        0.231792344,
        1.01046945,
        0.00600069867,
        0.0200179144,
        103.560653
    );
    f = f + check_near("OPT-014_bk7_nd", nd_bk7, 1.5168000345005885, 1e-12);
    let nd_nm: f64 = sellmeier_3(
        587.5618,
        1.03961212,
        0.231792344,
        1.01046945,
        0.00600069867,
        0.0200179144,
        103.560653
    );
    f = f + check_planted_gt("planted_OPT-014_nm_unit", abs_f64(nd_nm - nd_bk7), 0.1);

    // 11. OPT-033 Beer-Lambert law + planted positive-exponent growth control
    let bl_1: f64 = beer_lambert(2.0, 0.5);
    f = f + check_near("OPT-033_exp_neg1", bl_1, 0.36787944117144233, 1e-12);
    f = f + check_planted_gt("planted_OPT-033_pos_sign", abs_f64(exp(2.0 * 0.5) - bl_1), 1.0);

    // 12. SIG-013 Shannon entropy + planted natural-log nats control
    f = f + check_near("SIG-013_fair_coin", shannon_entropy_2(0.5, 0.5), 1.0, 1e-12);
    f = f + check_near("SIG-013_uniform_4", shannon_entropy_4(0.25, 0.25, 0.25, 0.25), 2.0, 1e-12);
    let nats_bad: f64 = -2.0 * 0.5 * log(0.5);
    f = f + check_planted_gt("planted_SIG-013_nats_vs_bits", abs_f64(nats_bad - 1.0), 0.2);

    f
}

fn main() ~ Console + Clock {
    let mut failures: i32 = 0;

    // 1. HASH-FNV parity + planted 1-bit offset control
    let h_empty: u64 = fnv_str("");
    if h_empty == 1469598103934665603 {
        println!("[PASS] HASH-FNV_empty offset={}", h_empty);
    } else {
        println!("[FAIL] HASH-FNV_empty got={}", h_empty);
        failures = failures + 1;
    }
    let h_bad_offset: u64 = (1469598103934665604 ^ 97).wrapping_mul(1099511628211);
    let h_good_a: u64 = fnv_u8(fnv_start(), 97);
    if h_bad_offset != h_good_a {
        println!("[PASS] planted_HASH-FNV_offset caught bad={:x} good={:x}", h_bad_offset, h_good_a);
    } else {
        println!("[FAIL] planted_HASH-FNV_offset missed");
        failures = failures + 1;
    }

    failures = failures + verify_color_equations();
    failures = failures + verify_optics_and_signal_equations();

    // Deterministic 12-equation par_for vs serial benchmark (64 * 16384 = 1,048,576 points)
    let ctx = SweepCtx { chunks: 64, chunk_len: 16384 };

    let t0: i64 = clock_ns();
    let mut serial_parts: Vec<u64> = Vec::new();
    let mut c: i64 = 0;
    while c < ctx.chunks {
        serial_parts.push(eval_chunk(&ctx, c));
        c = c + 1;
    }
    let serial_hash: u64 = reduce_chunk_hashes(&serial_parts);
    let t1: i64 = clock_ns();

    let t2: i64 = clock_ns();
    let par_parts: Vec<u64> = par_for(ctx.chunks, &ctx, eval_chunk);
    let par_hash: u64 = reduce_chunk_hashes(&par_parts);
    let t3: i64 = clock_ns();

    if par_hash == serial_hash {
        println!(
            "[PASS] par_for_bit_exact hash={:x} equations=12 points={} serial_ns={} par_ns={}",
            par_hash,
            ctx.chunks * ctx.chunk_len,
            t1 - t0,
            t3 - t2
        );
    } else {
        println!("[FAIL] par_for_bit_exact serial={:x} par={:x}", serial_hash, par_hash);
        failures = failures + 1;
    }

    if failures == 0 {
        println!("[PASS] kcore_fast summary equations=12 failures=0");
    } else {
        println!("[FAIL] kcore_fast summary equations=12 failures={}", failures);
    }
}
