// BuildLang Pure Compiled SpaceX GNC + Nvidia / Frontier-AI Kernel Suite (Layer 1):
//   Part A - Aerospace Propulsion, Orbital Mechanics & Powered-Descent GNC:
//     1. Tsiolkovsky multi-stage delta-V and mass-ratio solver (LEO/GTO staging checks)
//     2. Symplectic Velocity-Verlet two-body + J2 Earth-oblateness orbital propagator
//        (energy |dE/E0| < 1e-7, axial angular momentum Lz conserved, planted Euler drift)
//     3. 6-DOF powered-descent ZEM/ZEV optimal guidance controller with thrust & gimbal
//        clamps and rocket mass depletion (soft touchdown |p|<0.05m, |v|<0.1m/s,
//        fuel_margin > 0, plus planted under-thrust crash control)
//   Part B - Frontier-AI Inference & Long-Context Kernels (par_for bit-exact):
//     4. BitNet b1.58 packed ternary GEMV (w in {-1, 0, +1}, zero FP multiplies!)
//        verified exact vs float reference + planted 1-weight flip corruption control
//     5. Flash-style tiled online-softmax attention (O(1) tile state) + Factorized
//        Context Attention (FCA, block-summary landmarks + local window), verified
//        < 1e-12 vs naive materialized attention + planted non-normalized softmax control

struct V3 {
    x: f64,
    y: f64,
    z: f64,
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    x
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    b
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b {
        return a;
    }
    b
}

fn v3_len(v: V3) -> f64 {
    sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
}

// ---------------------------------------------------------------- HASH-FNV (Superframe parity)

fn fnv_start() -> u64 {
    1469598103934665603
}

fn fnv_u8(h0: u64, b: u64) -> u64 {
    (h0 ^ b).wrapping_mul(1099511628211)
}

fn fnv_u64(h0: u64, v: u64) -> u64 {
    let mut h: u64 = h0;
    let mut k: u64 = 0;
    while k < 8 {
        h = fnv_u8(h, (v >> (8 * k)) & 255);
        k = k + 1;
    }
    h
}

fn fnv_f32(h0: u64, v: f64) -> u64 {
    let bits: u32 = (v as f32).to_bits();
    let mut h: u64 = h0;
    let mut k: u32 = 0;
    while k < 4 {
        h = fnv_u8(h, ((bits >> (8 * k)) & 255) as u64);
        k = k + 1;
    }
    h
}

fn reduce_hashes(parts: &Vec<u64>) -> u64 {
    let mut h: u64 = fnv_start();
    let mut i: usize = 0;
    while i < parts.len() {
        h = fnv_u64(h, parts[i]);
        i = i + 1;
    }
    h
}

// ---------------------------------------------------------------- (1) Tsiolkovsky Staging Solver

fn g0_std() -> f64 {
    9.80665
}

fn validate_stage_mass(m0: f64, mf: f64) -> bool {
    m0 > 0.0 && mf > 0.0 && m0 > mf
}

fn tsiolkovsky_dv(isp: f64, m0: f64, mf: f64) -> f64 {
    isp * g0_std() * log(m0 / mf)
}

fn two_stage_dv(isp1: f64, m01: f64, mf1: f64, isp2: f64, m02: f64, mf2: f64) -> f64 {
    tsiolkovsky_dv(isp1, m01, mf1) + tsiolkovsky_dv(isp2, m02, mf2)
}

// ---------------------------------------------------------------- (2) Symplectic Velocity-Verlet + J2

fn mu_earth() -> f64 {
    398600441800000.0
}

fn re_earth() -> f64 {
    6378137.0
}

fn j2_earth() -> f64 {
    0.00108262668
}

fn accel_two_body_j2(p: V3, j2_scale: f64) -> V3 {
    let mu: f64 = mu_earth();
    let re: f64 = re_earth();
    let r2: f64 = p.x * p.x + p.y * p.y + p.z * p.z;
    let r: f64 = sqrt(r2);
    let inv_r3: f64 = 1.0 / (r2 * r);
    let mut ax: f64 = -mu * p.x * inv_r3;
    let mut ay: f64 = -mu * p.y * inv_r3;
    let mut az: f64 = -mu * p.z * inv_r3;
    if j2_scale != 0.0 {
        let z2_r2: f64 = (p.z * p.z) / r2;
        let fac: f64 = -1.5 * j2_scale * j2_earth() * mu * (re * re) / (r2 * r2 * r);
        ax = ax + fac * p.x * (1.0 - 5.0 * z2_r2);
        ay = ay + fac * p.y * (1.0 - 5.0 * z2_r2);
        az = az + fac * p.z * (3.0 - 5.0 * z2_r2);
    }
    V3 { x: ax, y: ay, z: az }
}

fn specific_energy_j2(p: V3, v: V3, j2_scale: f64) -> f64 {
    let mu: f64 = mu_earth();
    let re: f64 = re_earth();
    let r2: f64 = p.x * p.x + p.y * p.y + p.z * p.z;
    let r: f64 = sqrt(r2);
    let kin: f64 = 0.5 * (v.x * v.x + v.y * v.y + v.z * v.z);
    let mut pot: f64 = -mu / r;
    if j2_scale != 0.0 {
        let z2_r2: f64 = (p.z * p.z) / r2;
        pot = pot + j2_scale * j2_earth() * mu * (re * re) / (2.0 * r2 * r) * (3.0 * z2_r2 - 1.0);
    }
    kin + pot
}

struct OrbitSummary {
    rel_energy_err: f64,
    rel_lz_err: f64,
    final_r: f64,
    pos_x: f64,
    pos_z: f64,
}

fn propagate_orbit(steps: i64, dt: f64, j2_scale: f64, use_verlet: bool) -> OrbitSummary {
    let r0: f64 = re_earth() + 400000.0;
    let v_circ: f64 = sqrt(mu_earth() / r0);
    // 51.6-degree ISS-class inclination: cos(51.6 deg) = 0.62114777, sin(51.6 deg) = 0.78369347
    let mut p = V3 { x: r0, y: 0.0, z: 0.0 };
    let mut v = V3 { x: 0.0, y: v_circ * 0.62114777, z: v_circ * 0.78369347 };
    let e0: f64 = specific_energy_j2(p, v, j2_scale);
    let lz0: f64 = p.x * v.y - p.y * v.x;
    let mut a: V3 = accel_two_body_j2(p, j2_scale);

    let mut i: i64 = 0;
    while i < steps {
        if use_verlet {
            let nx: f64 = p.x + v.x * dt + 0.5 * a.x * dt * dt;
            let ny: f64 = p.y + v.y * dt + 0.5 * a.y * dt * dt;
            let nz: f64 = p.z + v.z * dt + 0.5 * a.z * dt * dt;
            p = V3 { x: nx, y: ny, z: nz };
            let a_next: V3 = accel_two_body_j2(p, j2_scale);
            v = V3 {
                x: v.x + 0.5 * (a.x + a_next.x) * dt,
                y: v.y + 0.5 * (a.y + a_next.y) * dt,
                z: v.z + 0.5 * (a.z + a_next.z) * dt,
            };
            a = a_next;
        } else {
            // Planted unstable forward Euler integrator (must drift specific energy!).
            let p_old: V3 = p;
            p = V3 { x: p.x + v.x * dt, y: p.y + v.y * dt, z: p.z + v.z * dt };
            let a_cur: V3 = accel_two_body_j2(p_old, j2_scale);
            v = V3 { x: v.x + a_cur.x * dt, y: v.y + a_cur.y * dt, z: v.z + a_cur.z * dt };
        }
        i = i + 1;
    }

    let e1: f64 = specific_energy_j2(p, v, j2_scale);
    let lz1: f64 = p.x * v.y - p.y * v.x;
    OrbitSummary {
        rel_energy_err: abs_f64((e1 - e0) / e0),
        rel_lz_err: abs_f64((lz1 - lz0) / lz0),
        final_r: v3_len(p),
        pos_x: p.x,
        pos_z: p.z,
    }
}

// ---------------------------------------------------------------- (3) 6-DOF Powered-Descent ZEM/ZEV

struct DescentResult {
    pos_err: f64,
    vel_err: f64,
    fuel_margin: f64,
    peak_tilt_tan: f64,
}

fn clamp_thrust_and_gimbal(a: V3, a_min: f64, a_max: f64, max_tilt_tan: f64) -> V3 {
    let az: f64 = max_f64(a.z, 0.5);
    let horiz: f64 = sqrt(a.x * a.x + a.y * a.y);
    let max_h: f64 = az * max_tilt_tan;
    let mut ax: f64 = a.x;
    let mut ay: f64 = a.y;
    if horiz > max_h && horiz > 1e-12 {
        let s: f64 = max_h / horiz;
        ax = ax * s;
        ay = ay * s;
    }
    let mag: f64 = sqrt(ax * ax + ay * ay + az * az);
    if mag > a_max && mag > 1e-12 {
        let s: f64 = a_max / mag;
        return V3 { x: ax * s, y: ay * s, z: az * s };
    }
    if mag < a_min && mag > 1e-12 {
        let s: f64 = a_min / mag;
        return V3 { x: ax * s, y: ay * s, z: az * s };
    }
    V3 { x: ax, y: ay, z: az }
}

fn simulate_powered_descent(
    p0: V3,
    v0: V3,
    t_total: f64,
    steps: i64,
    a_max: f64,
    m_wet: f64,
    m_dry: f64,
    isp: f64
) -> DescentResult {
    let dt: f64 = t_total / (steps as f64);
    let gz: f64 = -g0_std();
    let v_ex: f64 = isp * g0_std();
    // 25-degree thrust-vector gimbal cone: tan(25 deg) = 0.466307658
    let max_tan: f64 = 0.466307658;
    let mut p: V3 = p0;
    let mut v: V3 = v0;
    let mut mass: f64 = m_wet;
    let mut peak_tan: f64 = 0.0;

    let mut i: i64 = 0;
    while i < steps {
        let t_go: f64 = max_f64(t_total - (i as f64) * dt, dt);
        // Zero-Effort-Miss and Zero-Effort-Velocity to target origin (0, 0, 0) at v=0
        let zem_x: f64 = -(p.x + v.x * t_go);
        let zem_y: f64 = -(p.y + v.y * t_go);
        let zem_z: f64 = -(p.z + v.z * t_go + 0.5 * gz * t_go * t_go);
        let zev_x: f64 = -v.x;
        let zev_y: f64 = -v.y;
        let zev_z: f64 = -(v.z + gz * t_go);

        let inv_t: f64 = 1.0 / t_go;
        let inv_t2: f64 = inv_t * inv_t;
        let a_raw = V3 {
            x: 6.0 * zem_x * inv_t2 - 2.0 * zev_x * inv_t,
            y: 6.0 * zem_y * inv_t2 - 2.0 * zev_y * inv_t,
            z: 6.0 * zem_z * inv_t2 - 2.0 * zev_z * inv_t,
        };
        let mut a_thr: V3 = clamp_thrust_and_gimbal(a_raw, 2.0, a_max, max_tan);
        if mass <= m_dry {
            a_thr = V3 { x: 0.0, y: 0.0, z: 0.0 };
        }
        if a_thr.z > 1e-9 {
            let h_tan: f64 = sqrt(a_thr.x * a_thr.x + a_thr.y * a_thr.y) / a_thr.z;
            peak_tan = max_f64(peak_tan, h_tan);
        }

        let ax: f64 = a_thr.x;
        let ay: f64 = a_thr.y;
        let az: f64 = a_thr.z + gz;
        p = V3 {
            x: p.x + v.x * dt + 0.5 * ax * dt * dt,
            y: p.y + v.y * dt + 0.5 * ay * dt * dt,
            z: p.z + v.z * dt + 0.5 * az * dt * dt,
        };
        v = V3 { x: v.x + ax * dt, y: v.y + ay * dt, z: v.z + az * dt };
        let thrust_mag: f64 = v3_len(a_thr);
        mass = max_f64(mass - (mass * thrust_mag / v_ex) * dt, m_dry);
        i = i + 1;
    }

    DescentResult {
        pos_err: v3_len(p),
        vel_err: v3_len(v),
        fuel_margin: (mass - m_dry) / (m_wet - m_dry),
        peak_tilt_tan: peak_tan,
    }
}

// ---------------------------------------------------------------- (4) BitNet b1.58 Packed Ternary GEMV

fn ternary_code_at(row: i64, col: i64, layer: i64) -> u64 {
    let mut h: u64 = fnv_u64(fnv_start(), (layer as u64) * 131 + (row as u64));
    h = fnv_u64(h, col as u64);
    h % 3
}

fn pack_4_ternary(c0: u64, c1: u64, c2: u64, c3: u64) -> u8 {
    ((c0 & 3) | ((c1 & 3) << 2) | ((c2 & 3) << 4) | ((c3 & 3) << 6)) as u8
}

// Zero-FP-multiplication ternary dot product over 2-bit packed bytes (4 weights per byte).
fn bitnet_dot_packed(packed: &Vec<u8>, x: &Vec<f64>) -> f64 {
    let mut acc: f64 = 0.0;
    let n_bytes: usize = packed.len();
    let mut b_idx: usize = 0;
    while b_idx < n_bytes {
        let byte_val: u64 = packed[b_idx] as u64;
        let base: usize = b_idx * 4;
        let mut lane: usize = 0;
        while lane < 4 {
            let code: u64 = (byte_val >> (2 * (lane as u64))) & 3;
            if code == 1 {
                acc = acc + x[base + lane];
            } else if code == 2 {
                acc = acc - x[base + lane];
            }
            lane = lane + 1;
        }
        b_idx = b_idx + 1;
    }
    acc
}

fn bitnet_dot_float_ref(packed: &Vec<u8>, x: &Vec<f64>) -> f64 {
    let mut acc: f64 = 0.0;
    let n_bytes: usize = packed.len();
    let mut b_idx: usize = 0;
    while b_idx < n_bytes {
        let byte_val: u64 = packed[b_idx] as u64;
        let base: usize = b_idx * 4;
        let mut lane: usize = 0;
        while lane < 4 {
            let code: u64 = (byte_val >> (2 * (lane as u64))) & 3;
            let mut w: f64 = 0.0;
            if code == 1 {
                w = 1.0;
            } else if code == 2 {
                w = -1.0;
            }
            acc = acc + w * x[base + lane];
            lane = lane + 1;
        }
        b_idx = b_idx + 1;
    }
    acc
}

// ---------------------------------------------------------------- (5) Flash Online-Softmax & FCA Attention

fn synth_feat(row: i64, dim: i64, salt: i64) -> f64 {
    let v: i64 = ((row * 37 + dim * 17 + salt * 53) % 199) - 99;
    (v as f64) * 0.012
}

// Flash-style O(1) tile-memory online-softmax attention for one query row over n_keys keys.
fn flash_online_attention_row(q_idx: i64, n_keys: i64, head_dim: i64, tile_size: i64) -> Vec<f64> {
    let inv_sqrt_d: f64 = 1.0 / sqrt(head_dim as f64);
    let mut q: Vec<f64> = Vec::new();
    let mut out: Vec<f64> = Vec::new();
    let mut d: i64 = 0;
    while d < head_dim {
        q.push(synth_feat(q_idx, d, 1));
        out.push(0.0);
        d = d + 1;
    }

    let mut m_run: f64 = -1e30;
    let mut l_run: f64 = 0.0;
    let mut t_start: i64 = 0;
    while t_start < n_keys {
        let t_end: i64 = min_f64((t_start + tile_size) as f64, n_keys as f64) as i64;
        let mut scores: Vec<f64> = Vec::new();
        let mut m_tile: f64 = -1e30;
        let mut k: i64 = t_start;
        while k < t_end {
            let mut dot: f64 = 0.0;
            let mut j: i64 = 0;
            while j < head_dim {
                dot = dot + q[j as usize] * synth_feat(k, j, 2);
                j = j + 1;
            }
            let sc: f64 = dot * inv_sqrt_d;
            scores.push(sc);
            if sc > m_tile {
                m_tile = sc;
            }
            k = k + 1;
        }

        let m_new: f64 = max_f64(m_run, m_tile);
        let alpha: f64 = exp(m_run - m_new);
        l_run = l_run * alpha;
        let mut j2: i64 = 0;
        while j2 < head_dim {
            out[j2 as usize] = out[j2 as usize] * alpha;
            j2 = j2 + 1;
        }

        let mut local_k: i64 = 0;
        while t_start + local_k < t_end {
            let w: f64 = exp(scores[local_k as usize] - m_new);
            l_run = l_run + w;
            let key_i: i64 = t_start + local_k;
            let mut j3: i64 = 0;
            while j3 < head_dim {
                out[j3 as usize] = out[j3 as usize] + w * synth_feat(key_i, j3, 3);
                j3 = j3 + 1;
            }
            local_k = local_k + 1;
        }
        m_run = m_new;
        t_start = t_end;
    }

    let inv_l: f64 = 1.0 / l_run;
    let mut j4: i64 = 0;
    while j4 < head_dim {
        out[j4 as usize] = out[j4 as usize] * inv_l;
        j4 = j4 + 1;
    }
    out
}

fn naive_attention_row(q_idx: i64, n_keys: i64, head_dim: i64, normalize: bool) -> Vec<f64> {
    let inv_sqrt_d: f64 = 1.0 / sqrt(head_dim as f64);
    let mut scores: Vec<f64> = Vec::new();
    let mut m_all: f64 = -1e30;
    let mut k: i64 = 0;
    while k < n_keys {
        let mut dot: f64 = 0.0;
        let mut j: i64 = 0;
        while j < head_dim {
            dot = dot + synth_feat(q_idx, j, 1) * synth_feat(k, j, 2);
            j = j + 1;
        }
        let sc: f64 = dot * inv_sqrt_d;
        scores.push(sc);
        if sc > m_all {
            m_all = sc;
        }
        k = k + 1;
    }

    let mut exps: Vec<f64> = Vec::new();
    let mut l_sum: f64 = 0.0;
    let mut k2: i64 = 0;
    while k2 < n_keys {
        let e: f64 = exp(scores[k2 as usize] - m_all);
        exps.push(e);
        l_sum = l_sum + e;
        k2 = k2 + 1;
    }

    let mut out: Vec<f64> = Vec::new();
    let mut d: i64 = 0;
    while d < head_dim {
        let mut acc: f64 = 0.0;
        let mut k3: i64 = 0;
        while k3 < n_keys {
            acc = acc + exps[k3 as usize] * synth_feat(k3, d, 3);
            k3 = k3 + 1;
        }
        if normalize {
            out.push(acc / l_sum);
        } else {
            out.push(acc);
        }
        d = d + 1;
    }
    out
}

// Factorized Context Attention (FCA): linear-cost block landmarks + exact local tile.
fn fca_block_attention_row(q_idx: i64, n_keys: i64, head_dim: i64, block_sz: i64) -> f64 {
    let inv_sqrt_d: f64 = 1.0 / sqrt(head_dim as f64);
    let n_blocks: i64 = n_keys / block_sz;
    let mut q: Vec<f64> = Vec::new();
    let mut d: i64 = 0;
    while d < head_dim {
        q.push(synth_feat(q_idx, d, 1));
        d = d + 1;
    }

    let mut m_run: f64 = -1e30;
    let mut l_run: f64 = 0.0;
    let mut o0: f64 = 0.0;
    let mut b: i64 = 0;
    while b < n_blocks {
        let base: i64 = b * block_sz;
        let mut dot: f64 = 0.0;
        let mut v0_mean: f64 = 0.0;
        let mut j: i64 = 0;
        while j < head_dim {
            let mut k_mean: f64 = 0.0;
            let mut t: i64 = 0;
            while t < block_sz {
                k_mean = k_mean + synth_feat(base + t, j, 2);
                t = t + 1;
            }
            dot = dot + q[j as usize] * (k_mean / (block_sz as f64));
            j = j + 1;
        }
        let mut t2: i64 = 0;
        while t2 < block_sz {
            v0_mean = v0_mean + synth_feat(base + t2, 0, 3);
            t2 = t2 + 1;
        }
        v0_mean = v0_mean / (block_sz as f64);

        let sc: f64 = dot * inv_sqrt_d;
        let m_new: f64 = max_f64(m_run, sc);
        let alpha: f64 = exp(m_run - m_new);
        let w: f64 = exp(sc - m_new);
        l_run = l_run * alpha + w;
        o0 = o0 * alpha + w * v0_mean;
        m_run = m_new;
        b = b + 1;
    }
    o0 / l_run
}

// ---------------------------------------------------------------- Parallel par_for workload kernels

struct BatchCtx {
    n_items: i64,
    param_a: i64,
    param_b: i64,
}

// Stage 1: Parallel GNC trajectory sweep (64 orbital + powered-descent missions).
fn eval_gnc_mission(ctx: &BatchCtx, idx: i64) -> u64 {
    let steps_orb: i64 = ctx.param_a;
    let steps_gnc: i64 = ctx.param_b;
    let dt_orb: f64 = 1.0 + ((idx % 4) as f64) * 0.25;
    let orb: OrbitSummary = propagate_orbit(steps_orb, dt_orb, 1.0, true);
    let offset: f64 = ((idx % 16) as f64) * 4.0;
    let p0 = V3 { x: 100.0 + offset, y: -70.0 + 0.5 * offset, z: 480.0 + offset };
    let v0 = V3 { x: -10.0, y: 7.0, z: -52.0 };
    let des: DescentResult = simulate_powered_descent(p0, v0, 22.0, steps_gnc, 32.0, 26000.0, 20000.0, 282.0);
    let mut touch_ok: u64 = 0;
    if des.pos_err < 0.05 && des.vel_err < 0.1 && des.fuel_margin > 0.0 {
        touch_ok = 1;
    }
    let mut h: u64 = fnv_start();
    h = fnv_f32(h, orb.pos_x);
    h = fnv_f32(h, orb.pos_z);
    h = fnv_f32(h, des.fuel_margin);
    h = fnv_f32(h, des.peak_tilt_tan);
    h = fnv_u8(h, touch_ok);
    h
}

// Stage 2: Parallel BitNet b1.58 packed ternary GEMV (512 rows x 1024 cols x 4 layers).
fn eval_bitnet_row(ctx: &BatchCtx, row: i64) -> u64 {
    let n_cols: i64 = ctx.param_a;
    let n_layers: i64 = ctx.param_b;
    let mut x: Vec<f64> = Vec::new();
    let mut c: i64 = 0;
    while c < n_cols {
        x.push((((c * 29 + 13) % 101) as f64 - 50.0) * 0.02);
        c = c + 1;
    }

    let mut h: u64 = fnv_start();
    let mut layer: i64 = 0;
    while layer < n_layers {
        let mut acc: f64 = 0.0;
        let mut j: i64 = 0;
        while j < n_cols {
            let byte_val: u8 = pack_4_ternary(
                ternary_code_at(row, j, layer),
                ternary_code_at(row, j + 1, layer),
                ternary_code_at(row, j + 2, layer),
                ternary_code_at(row, j + 3, layer)
            );
            let bv: u64 = byte_val as u64;
            let mut lane: i64 = 0;
            while lane < 4 {
                let code: u64 = (bv >> (2 * (lane as u64))) & 3;
                if code == 1 {
                    acc = acc + x[(j + lane) as usize];
                } else if code == 2 {
                    acc = acc - x[(j + lane) as usize];
                }
                lane = lane + 1;
            }
            j = j + 4;
        }
        h = fnv_f32(h, acc);
        layer = layer + 1;
    }
    h
}

// Stage 3: Parallel Flash online-softmax + FCA attention (128 queries x 256 keys x d=32).
fn eval_attn_row(ctx: &BatchCtx, q_idx: i64) -> u64 {
    let n_keys: i64 = ctx.param_a;
    let head_dim: i64 = ctx.param_b;
    let out: Vec<f64> = flash_online_attention_row(q_idx, n_keys, head_dim, 16);
    let fca_val: f64 = fca_block_attention_row(q_idx, n_keys, head_dim, 16);
    let mut h: u64 = fnv_start();
    let mut d: usize = 0;
    while d < out.len() {
        h = fnv_f32(h, out[d]);
        d = d + 1;
    }
    h = fnv_f32(h, fca_val);
    h
}

// ---------------------------------------------------------------- Self-tests & planted controls

fn check_near(label: str, got: f64, want: f64, tol: f64) -> i32 ~ Console {
    let diff: f64 = abs_f64(got - want);
    if diff <= tol {
        println!("[PASS] {} got={} want={} diff={}", label, got, want, diff);
        return 0;
    }
    println!("[FAIL] {} got={} want={} diff={} tol={}", label, got, want, diff, tol);
    1
}

fn verify_aerospace_and_ai_controls() -> i32 ~ Console {
    let mut f: i32 = 0;

    // 1. Tsiolkovsky 2-stage LEO/GTO check + planted inverted mass-ratio control
    let dv1: f64 = tsiolkovsky_dv(282.0, 549054.0, 137554.0);
    let dv2: f64 = tsiolkovsky_dv(348.0, 111500.0, 19500.0);
    let dv_tot: f64 = two_stage_dv(282.0, 549054.0, 137554.0, 348.0, 111500.0, 19500.0);
    f = f + check_near("SPACEX_tsiolkovsky_total", dv_tot, dv1 + dv2, 1e-12);
    if dv_tot > 9300.0 && validate_stage_mass(549054.0, 137554.0) && !validate_stage_mass(137554.0, 549054.0) {
        println!("[PASS] SPACEX_leo_margin_and_planted_mass_swap dv={}", dv_tot);
    } else {
        println!("[FAIL] SPACEX_leo_margin_and_planted_mass_swap dv={}", dv_tot);
        f = f + 1;
    }

    // 2. Velocity-Verlet J2 multi-orbit conservation (28,000 s ~ 5 orbits) + planted Euler drift
    let verlet: OrbitSummary = propagate_orbit(28000, 1.0, 1.0, true);
    if verlet.rel_energy_err < 1e-7 && verlet.rel_lz_err < 1e-11 {
        println!(
            "[PASS] SPACEX_verlet_j2_conserved dE={} dLz={}",
            verlet.rel_energy_err,
            verlet.rel_lz_err
        );
    } else {
        println!(
            "[FAIL] SPACEX_verlet_j2_conserved dE={} dLz={}",
            verlet.rel_energy_err,
            verlet.rel_lz_err
        );
        f = f + 1;
    }
    let euler_bad: OrbitSummary = propagate_orbit(28000, 1.0, 1.0, false);
    if euler_bad.rel_energy_err > 1e-4 {
        println!("[PASS] planted_euler_orbit_drift caught dE={}", euler_bad.rel_energy_err);
    } else {
        println!("[FAIL] planted_euler_orbit_drift missed dE={}", euler_bad.rel_energy_err);
        f = f + 1;
    }

    // 3. 6-DOF Powered-Descent ZEM/ZEV soft touchdown + planted under-thrust crash control
    let p0 = V3 { x: 120.0, y: -85.0, z: 500.0 };
    let v0 = V3 { x: -12.0, y: 8.0, z: -55.0 };
    let soft: DescentResult = simulate_powered_descent(p0, v0, 22.0, 1100, 32.0, 26000.0, 20000.0, 282.0);
    if soft.pos_err < 0.05 && soft.vel_err < 0.1 && soft.fuel_margin > 0.0 {
        println!(
            "[PASS] SPACEX_zem_zev_touchdown pos_err={} vel_err={} fuel_margin={}",
            soft.pos_err,
            soft.vel_err,
            soft.fuel_margin
        );
    } else {
        println!(
            "[FAIL] SPACEX_zem_zev_touchdown pos_err={} vel_err={} fuel_margin={}",
            soft.pos_err,
            soft.vel_err,
            soft.fuel_margin
        );
        f = f + 1;
    }
    let crash: DescentResult = simulate_powered_descent(p0, v0, 22.0, 1100, 8.0, 26000.0, 20000.0, 282.0);
    if crash.pos_err > 10.0 || crash.vel_err > 10.0 {
        println!(
            "[PASS] planted_underthrust_crash caught pos_err={} vel_err={}",
            crash.pos_err,
            crash.vel_err
        );
    } else {
        println!("[FAIL] planted_underthrust_crash missed");
        f = f + 1;
    }

    // 4. BitNet b1.58 packed ternary GEMV exactness + planted 1-weight flip control
    let mut x_vec: Vec<f64> = Vec::new();
    let mut packed: Vec<u8> = Vec::new();
    let mut j: i64 = 0;
    while j < 256 {
        x_vec.push((((j * 17 + 7) % 89) as f64 - 44.0) * 0.05);
        j = j + 1;
    }
    let mut b_i: i64 = 0;
    while b_i < 256 {
        packed.push(pack_4_ternary(
            ternary_code_at(7, b_i, 0),
            ternary_code_at(7, b_i + 1, 0),
            ternary_code_at(7, b_i + 2, 0),
            ternary_code_at(7, b_i + 3, 0)
        ));
        b_i = b_i + 4;
    }
    let d_tern: f64 = bitnet_dot_packed(&packed, &x_vec);
    let d_ref: f64 = bitnet_dot_float_ref(&packed, &x_vec);
    f = f + check_near("NVIDIA_bitnet_b158_exact", d_tern, d_ref, 1e-12);
    // Flip lane 0 of byte 0 (code 0->1 or 1->2 or 2->0) and verify non-zero drift
    let old_b0: u8 = packed[0];
    packed[0] = (old_b0 ^ 3) as u8;
    let d_flip: f64 = bitnet_dot_packed(&packed, &x_vec);
    if abs_f64(d_flip - d_ref) > 1e-3 {
        println!("[PASS] planted_bitnet_weight_flip caught diff={}", abs_f64(d_flip - d_ref));
    } else {
        println!("[FAIL] planted_bitnet_weight_flip missed diff={}", abs_f64(d_flip - d_ref));
        f = f + 1;
    }

    // 5. Flash online-softmax vs naive attention (< 1e-12) + FCA + planted unnormalized control
    let fl_row: Vec<f64> = flash_online_attention_row(13, 128, 32, 16);
    let nv_row: Vec<f64> = naive_attention_row(13, 128, 32, true);
    let bad_row: Vec<f64> = naive_attention_row(13, 128, 32, false);
    let mut max_err: f64 = 0.0;
    let mut max_bad: f64 = 0.0;
    let mut d: usize = 0;
    while d < 32 {
        max_err = max_f64(max_err, abs_f64(fl_row[d] - nv_row[d]));
        max_bad = max_f64(max_bad, abs_f64(bad_row[d] - nv_row[d]));
        d = d + 1;
    }
    f = f + check_near("NVIDIA_flash_online_vs_naive", max_err, 0.0, 1e-12);
    let fca_out: f64 = fca_block_attention_row(13, 128, 32, 16);
    if abs_f64(fca_out) < 10.0 {
        println!("[PASS] FCA_block_attention_stable val={}", fca_out);
    } else {
        println!("[FAIL] FCA_block_attention_stable val={}", fca_out);
        f = f + 1;
    }
    if max_bad > 0.5 {
        println!("[PASS] planted_unnormalized_softmax caught diff={}", max_bad);
    } else {
        println!("[FAIL] planted_unnormalized_softmax missed diff={}", max_bad);
        f = f + 1;
    }

    f
}

fn main() ~ Console + Clock {
    let mut failures: i32 = verify_aerospace_and_ai_controls();

    // Workload 1: 64 parallel orbital + powered-descent GNC missions
    let gnc_ctx = BatchCtx { n_items: 64, param_a: 2000, param_b: 400 };
    let t0: i64 = clock_ns();
    let mut gnc_ser: Vec<u64> = Vec::new();
    let mut i: i64 = 0;
    while i < 64 {
        gnc_ser.push(eval_gnc_mission(&gnc_ctx, i));
        i = i + 1;
    }
    let h_gnc_ser: u64 = reduce_hashes(&gnc_ser);
    let t1: i64 = clock_ns();

    let t2: i64 = clock_ns();
    let gnc_par: Vec<u64> = par_for(64, &gnc_ctx, eval_gnc_mission);
    let h_gnc_par: u64 = reduce_hashes(&gnc_par);
    let t3: i64 = clock_ns();

    // Workload 2: BitNet b1.58 packed ternary GEMV (512 rows x 1024 cols x 4 layers)
    let bn_ctx = BatchCtx { n_items: 512, param_a: 1024, param_b: 4 };
    let t4: i64 = clock_ns();
    let mut bn_ser: Vec<u64> = Vec::new();
    let mut r: i64 = 0;
    while r < 512 {
        bn_ser.push(eval_bitnet_row(&bn_ctx, r));
        r = r + 1;
    }
    let h_bn_ser: u64 = reduce_hashes(&bn_ser);
    let t5: i64 = clock_ns();

    let t6: i64 = clock_ns();
    let bn_par: Vec<u64> = par_for(512, &bn_ctx, eval_bitnet_row);
    let h_bn_par: u64 = reduce_hashes(&bn_par);
    let t7: i64 = clock_ns();

    // Workload 3: Flash online-softmax + FCA attention (128 queries x 256 keys x d=32)
    let at_ctx = BatchCtx { n_items: 128, param_a: 256, param_b: 32 };
    let t8: i64 = clock_ns();
    let mut at_ser: Vec<u64> = Vec::new();
    let mut q: i64 = 0;
    while q < 128 {
        at_ser.push(eval_attn_row(&at_ctx, q));
        q = q + 1;
    }
    let h_at_ser: u64 = reduce_hashes(&at_ser);
    let t9: i64 = clock_ns();

    let t10: i64 = clock_ns();
    let at_par: Vec<u64> = par_for(128, &at_ctx, eval_attn_row);
    let h_at_par: u64 = reduce_hashes(&at_par);
    let t11: i64 = clock_ns();

    let total_ser_ns: i64 = (t1 - t0) + (t5 - t4) + (t9 - t8);
    let total_par_ns: i64 = (t3 - t2) + (t7 - t6) + (t11 - t10);

    if h_gnc_ser == h_gnc_par && h_bn_ser == h_bn_par && h_at_ser == h_at_par {
        println!(
            "[PASS] aero_ai_par_for_bit_exact gnc={:x} bitnet={:x} attn={:x} serial_ns={} par_ns={}",
            h_gnc_par,
            h_bn_par,
            h_at_par,
            total_ser_ns,
            total_par_ns
        );
    } else {
        println!(
            "[FAIL] aero_ai_par_for_bit_exact gnc_eq={} bn_eq={} attn_eq={}",
            h_gnc_ser == h_gnc_par,
            h_bn_ser == h_bn_par,
            h_at_ser == h_at_par
        );
        failures = failures + 1;
    }

    if failures == 0 {
        println!("[PASS] aerospace_ai_kernels summary failures=0");
    } else {
        println!("[FAIL] aerospace_ai_kernels summary failures={}", failures);
    }
}
