//
// Algebraic Quantization of Gravity from the Null Cone (arXiv:2611.34924)
// Deterministic f64 BuildLang verification kernel for Eqs. 3.26-3.28,
// 4.33-4.34, 5.29 (DS08-043 corner-boost reverberation shift), and 5.60-5.69,
// paired with 4 planted-failure controls.

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn tanh_f64(x: f64) -> f64 {
    let ep = exp(x);
    let em = exp(0.0 - x);
    (ep - em) / (ep + em)
}

// Eq. 3.26: Xi(v) = (1/8) * integral_{eps}^{v} s * sigma^2 ds
// Composite Simpson quadrature (n must be even).
fn simpson_xi(eps: f64, v: f64, sigma: f64, n: i64) -> f64 {
    let h = (v - eps) / (n as f64);
    let s2 = sigma * sigma;
    let mut sum: f64 = eps * s2 + v * s2;
    let mut i: i64 = 1;
    while i < n {
        let s = eps + (i as f64) * h;
        let w = if i % 2 == 1 { 4.0 } else { 2.0 };
        sum = sum + w * s * s2;
        i = i + 1;
    }
    0.125 * (h / 3.0) * sum
}

fn closed_xi(eps: f64, v: f64, sigma: f64) -> f64 {
    (sigma * sigma / 16.0) * (v * v - eps * eps)
}

// Eq. 3.28: u_* = rho_S * integral_{eps}^{1} exp(Xi(v)) dv
fn simpson_u_star(eps: f64, rho_s: f64, sigma: f64, n: i64) -> f64 {
    let h = (1.0 - eps) / (n as f64);
    let mut sum: f64 = exp(simpson_xi(eps, eps, sigma, 64)) + exp(simpson_xi(eps, 1.0, sigma, 64));
    let mut i: i64 = 1;
    while i < n {
        let v = eps + (i as f64) * h;
        let w = if i % 2 == 1 { 4.0 } else { 2.0 };
        let xi = closed_xi(eps, v, sigma);
        sum = sum + w * exp(xi);
        i = i + 1;
    }
    rho_s * (h / 3.0) * sum
}

// Eq. 4.33: Re(Li_2(exp(-2i/s)) / (2 s^2))
fn li2_scaled_re(s: f64, terms: i64) -> f64 {
    let theta = 2.0 / s;
    let mut sum: f64 = 0.0;
    let mut k: i64 = 1;
    while k <= terms {
        let kf = k as f64;
        sum = sum + cos(kf * theta) / (kf * kf);
        k = k + 1;
    }
    sum / (2.0 * s * s)
}

// Eq. 4.33: Im(Li_2(exp(-2i/s)) / (2 s^2))
fn li2_scaled_im(s: f64, terms: i64) -> f64 {
    let theta = 2.0 / s;
    let mut sum: f64 = 0.0;
    let mut k: i64 = 1;
    while k <= terms {
        let kf = k as f64;
        sum = sum - sin(kf * theta) / (kf * kf);
        k = k + 1;
    }
    sum / (2.0 * s * s)
}

// Exact real closed form for Re(Li_2(exp(-i theta))) / (2 s^2) on theta in (0, 2*pi).
fn li2_scaled_re_exact(s: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let theta = 2.0 / s;
    let re_li2 = (pi * pi) / 6.0 - (theta * (2.0 * pi - theta)) / 4.0;
    re_li2 / (2.0 * s * s)
}

// Asymptotic Eq. 4.34: Im(Li_2(exp(-2i/s)) / (2 s^2)) ~ -(1 / s^3) * (ln(s/2) + 1)
fn li2_scaled_im_asymp(s: f64) -> f64 {
    (0.0 - 1.0) * (log(s / 2.0) + 1.0) / (s * s * s)
}

// Perturbative O(G_N^3) harmonic sum: -(1 / s^3) * sum_{k=1}^{N} 1/k
fn pert_harmonic_im(s: f64, n: i64) -> f64 {
    let mut h_n: f64 = 0.0;
    let mut k: i64 = 1;
    while k <= n {
        h_n = h_n + 1.0 / (k as f64);
        k = k + 1;
    }
    (0.0 - h_n) / (s * s * s)
}

// Eq. 5.29: 4 * exp(eta) / (1 + exp(eta))^2 vs 1 - tanh^2(eta / 2)
fn boost_lhs(eta: f64) -> f64 {
    let e = exp(eta);
    let d = 1.0 + e;
    (4.0 * e) / (d * d)
}

fn boost_rhs(eta: f64) -> f64 {
    let t = tanh_f64(eta * 0.5);
    1.0 - t * t
}

fn check_raychaudhuri() -> i64 ~ Console {
    let mut fails: i64 = 0;
    let eps: f64 = 0.05;
    let rho_s: f64 = 1.0;

    let xi_num_1 = simpson_xi(eps, 0.75, 1.0, 1000);
    let xi_ana_1 = closed_xi(eps, 0.75, 1.0);
    let xi_err_1 = abs_f64(xi_num_1 - xi_ana_1);
    let xi_num_2 = simpson_xi(eps, 1.0, 2.0, 1000);
    let xi_ana_2 = closed_xi(eps, 1.0, 2.0);
    let xi_err_2 = abs_f64(xi_num_2 - xi_ana_2);
    if xi_err_1 > 1.0e-13 || xi_err_2 > 1.0e-13 {
        fails = fails + 1;
    }

    let u0 = simpson_u_star(eps, rho_s, 0.0, 2000);
    let u1 = simpson_u_star(eps, rho_s, 1.0, 2000);
    let u2 = simpson_u_star(eps, rho_s, 2.0, 2000);
    let u0_err = abs_f64(u0 - (1.0 - eps));
    if u0_err > 1.0e-14 || !(u0 < u1 && u1 < u2) {
        fails = fails + 1;
    }
    println!(
        "EQ_3_26_3_28 xi_err1={:.3e} xi_err2={:.3e} u0={:.12} u1={:.12} u2={:.12}",
        xi_err_1, xi_err_2, u0, u1, u2
    );
    fails
}

fn check_polylog_crossover() -> i64 ~ Console {
    let mut fails: i64 = 0;
    let terms: i64 = 200000;
    let mut ss: Vec<f64> = Vec::new();
    ss.push(10.0);
    ss.push(50.0);
    ss.push(100.0);
    let mut idx: i64 = 0;
    while idx < 3 {
        let s = ss[idx as usize];
        let re_num = li2_scaled_re(s, terms);
        let re_ex = li2_scaled_re_exact(s);
        let re_err = abs_f64(re_num - re_ex);
        let im_num = li2_scaled_im(s, terms);
        let im_asy = li2_scaled_im_asymp(s);
        let im_rel = abs_f64(im_num - im_asy) / abs_f64(im_asy);
        let n_cross = (s * 0.5) as i64;
        let pert_cross = pert_harmonic_im(s, n_cross);
        if re_err > 1.0e-6 || im_rel > 2.0e-3 {
            fails = fails + 1;
        }
        println!(
            "EQ_4_33_4_34 s={:.0} re={:.12} re_err={:.3e} im={:.12} im_asymp={:.12} im_rel={:.3e} pert_cross={:.12}",
            s, re_num, re_err, im_num, im_asy, im_rel, pert_cross
        );
        idx = idx + 1;
    }
    fails
}

fn check_corner_boost() -> i64 ~ Console {
    let mut fails: i64 = 0;
    let mut etas: Vec<f64> = Vec::new();
    etas.push(-2.0);
    etas.push(-1.0);
    etas.push(0.0);
    etas.push(0.5);
    etas.push(1.0);
    etas.push(2.0);
    etas.push(4.0);
    let mut max_err: f64 = 0.0;
    let mut i: i64 = 0;
    while i < 7 {
        let eta = etas[i as usize];
        let lhs = boost_lhs(eta);
        let rhs = boost_rhs(eta);
        let err = abs_f64(lhs - rhs);
        if err > max_err {
            max_err = err;
        }
        if err > 1.0e-14 {
            fails = fails + 1;
        }
        if eta == 0.0 {
            if abs_f64(lhs - 1.0) > 1.0e-15 {
                fails = fails + 1;
            }
        } else if !(lhs < 1.0 && lhs > 0.0) {
            fails = fails + 1;
        }
        i = i + 1;
    }
    let sym_err = abs_f64(boost_lhs(-2.0) - boost_lhs(2.0));
    if sym_err > 1.0e-15 {
        fails = fails + 1;
    }
    println!(
        "EQ_5_29 max_err={:.3e} sym_err={:.3e} shift_eta1={:.12} shift_eta4={:.12}",
        max_err,
        sym_err,
        boost_lhs(1.0),
        boost_lhs(4.0)
    );
    fails
}

fn check_clock_entropy_log() -> i64 ~ Console {
    let mut fails: i64 = 0;
    let mut xs: Vec<f64> = Vec::new();
    xs.push(0.1);
    xs.push(0.3);
    xs.push(0.5);
    xs.push(0.7);
    xs.push(0.9);
    let mut max_alg_err: f64 = 0.0;
    let mut i: i64 = 0;
    while i < 5 {
        let x = xs[i as usize];
        let x2 = x * x;
        let q = (2.0 * x2) / (1.0 + x2);
        let lhs = q / (2.0 * (1.0 - q));
        let rhs = x2 / (1.0 - x2);
        let err = abs_f64(lhs - rhs);
        if err > max_alg_err {
            max_alg_err = err;
        }
        if err > 1.0e-14 {
            fails = fails + 1;
        }
        i = i + 1;
    }

    let q_fixed = 257.0 / 302.0;
    let val_fixed = q_fixed / (2.0 * (1.0 - q_fixed)) - 0.5;
    let target = 106.0 / 45.0;
    let fixed_err = abs_f64(val_fixed - target);
    if fixed_err > 1.0e-15 {
        fails = fails + 1;
    }
    println!(
        "EQ_5_60_5_69 max_alg_err={:.3e} q_fixed_val={:.15} target={:.15} fixed_err={:.3e}",
        max_alg_err, val_fixed, target, fixed_err
    );
    fails
}

fn check_planted_failures() -> i64 ~ Console {
    let mut caught: i64 = 0;

    // Planted control (a): inverted integration bounds produce negative Xi < 0
    let neg_xi = simpson_xi(0.75, 0.05, 1.0, 200);
    if neg_xi < 0.0 {
        caught = caught + 1;
    }

    // Planted control (b): perturbed q = 256/302 must fail 106/45 match
    let q_bad = 256.0 / 302.0;
    let bad_val = q_bad / (2.0 * (1.0 - q_bad)) - 0.5;
    let bad_err = abs_f64(bad_val - (106.0 / 45.0));
    if bad_err > 1.0e-2 {
        caught = caught + 1;
    }

    // Planted control (c): wrong boost sign 1 + tanh^2(eta/2) must fail Eq. 5.29
    let t1 = tanh_f64(0.5);
    let wrong_boost = 1.0 + t1 * t1;
    if abs_f64(boost_lhs(1.0) - wrong_boost) > 0.1 {
        caught = caught + 1;
    }

    // Planted control (d): perturbative sum at N=10000, s=10 diverges from Li_2
    let im_nonpert = li2_scaled_im(10.0, 50000);
    let im_pert_10k = pert_harmonic_im(10.0, 10000);
    let div_gap = abs_f64(im_nonpert - im_pert_10k);
    if div_gap > 5.0e-3 {
        caught = caught + 1;
    }

    println!(
        "PLANTED_CONTROLS caught={}/4 neg_xi={:.6} q256_err={:.6} boost_diff={:.6} pert_div_gap={:.6}",
        caught,
        neg_xi,
        bad_err,
        abs_f64(boost_lhs(1.0) - wrong_boost),
        div_gap
    );
    if caught == 4 { 0 } else { 4 - caught }
}

fn main() ~ Console {
    let mut failures: i64 = 0;
    failures = failures + check_raychaudhuri();
    failures = failures + check_polylog_crossover();
    failures = failures + check_corner_boost();
    failures = failures + check_clock_entropy_log();
    failures = failures + check_planted_failures();
    if failures == 0 {
        println!("NULL_CONE_GRAVITY_CHECK PASS failures=0 planted_caught=4/4");
    } else {
        println!("NULL_CONE_GRAVITY_CHECK FAIL failures={}", failures);
    }
}
