// Wave 49A Kernel 4 (Author Idea D1, FORMULAS.tsv SIG-059):
//   Matched-Filter Linear-FM Chirp Detector (-15 dB input SNR) + Frequency-Domain Wiener
//   Deconvolution + Cramer-Rao Lower Bound (CRLB) + White-Noise Null Rejection Control.

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    x
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    b
}

fn splitmix64_next(state: u64) -> u64 {
    let mut z: u64 = state.wrapping_add(11400714819323198485);
    z = (z ^ (z >> 30)).wrapping_mul(13787848793156543929);
    z = (z ^ (z >> 27)).wrapping_mul(10723151780598845931);
    z ^ (z >> 31)
}

fn u64_unit(u: u64) -> f64 {
    let v: f64 = ((u >> 11) as f64) / 9007199254740992.0;
    if v < 1.0e-12 {
        return 1.0e-12;
    }
    v
}

// Radix-2 FFT for Wiener deconvolution (N power of two).
fn radix2_fft(re: &mut Vec<f64>, im: &mut Vec<f64>, inverse: bool) {
    let n: usize = re.len();
    let mut j: usize = 0;
    let mut i: usize = 1;
    while i < n {
        let mut bit: usize = n >> 1;
        while (j & bit) != 0 {
            j = j ^ bit;
            bit = bit >> 1;
        }
        j = j ^ bit;
        if i < j {
            let tr: f64 = re[i];
            re[i] = re[j];
            re[j] = tr;
            let ti: f64 = im[i];
            im[i] = im[j];
            im[j] = ti;
        }
        i = i + 1;
    }
    let pi: f64 = 3.14159265358979323846264338327950288;
    let mut len: usize = 2;
    while len <= n {
        let half: usize = len >> 1;
        let sign: f64 = if inverse { 1.0 } else { -1.0 };
        let ang: f64 = sign * 2.0 * pi / (len as f64);
        let wlen_re: f64 = cos(ang);
        let wlen_im: f64 = sin(ang);
        let mut st: usize = 0;
        while st < n {
            let mut wr: f64 = 1.0;
            let mut wi: f64 = 0.0;
            let mut k: usize = 0;
            while k < half {
                let ur: f64 = re[st + k];
                let ui: f64 = im[st + k];
                let vr: f64 = re[st + k + half];
                let vi: f64 = im[st + k + half];
                let tr: f64 = vr * wr - vi * wi;
                let ti: f64 = vr * wi + vi * wr;
                re[st + k] = ur + tr;
                im[st + k] = ui + ti;
                re[st + k + half] = ur - tr;
                im[st + k + half] = ui - ti;
                let nwr: f64 = wr * wlen_re - wi * wlen_im;
                let nwi: f64 = wr * wlen_im + wi * wlen_re;
                wr = nwr;
                wi = nwi;
                k = k + 1;
            }
            st = st + len;
        }
        len = len << 1;
    }
    if inverse {
        let inv_n: f64 = 1.0 / (n as f64);
        i = 0;
        while i < n {
            re[i] = re[i] * inv_n;
            im[i] = im[i] * inv_n;
            i = i + 1;
        }
    }
}

struct MatchResult {
    best_lag: usize,
    peak_z: f64,
    out_snr_db: f64,
}

fn run_matched_filter(rx: &Vec<f64>, tmpl: &Vec<f64>, tmpl_energy: f64, noise_std: f64) -> MatchResult {
    let n: usize = rx.len();
    let l: usize = tmpl.len();
    let max_lag: usize = n - l;
    let denom_std: f64 = noise_std * sqrt(tmpl_energy);
    let mut best_lag: usize = 0;
    let mut best_val: f64 = -1.0e300;
    let mut lag: usize = 0;
    while lag <= max_lag {
        let mut acc: f64 = 0.0;
        let mut k: usize = 0;
        while k < l {
            acc = acc + rx[lag + k] * tmpl[k];
            k = k + 1;
        }
        if acc > best_val {
            best_val = acc;
            best_lag = lag;
        }
        lag = lag + 1;
    }
    let z: f64 = best_val / denom_std;
    let ln10: f64 = 2.302585092994045684017991454684364208;
    let snr_db: f64 = 20.0 * log(max_f64(z, 1.0e-9)) / ln10;
    MatchResult { best_lag: best_lag, peak_z: z, out_snr_db: snr_db }
}

fn main() ~ Console + Clock {
    let mut failures: i32 = 0;
    let pi: f64 = 3.14159265358979323846264338327950288;
    let ln10: f64 = 2.302585092994045684017991454684364208;

    // 1. Build linear-FM chirp template (L=2048) embedded at tau_true=713 inside N=3072 at -15 dB SNR
    let n_sig: usize = 3072;
    let l_ch: usize = 2048;
    let tau_true: usize = 713;
    let mut tmpl: Vec<f64> = Vec::new();
    let mut tmpl_e: f64 = 0.0;
    let mut i: usize = 0;
    while i < l_ch {
        let t: f64 = (i as f64) / (l_ch as f64);
        // Linear chirp sweeping f0=0.05 to f1=0.35 cycles/sample
        let phase: f64 = 2.0 * pi * (0.05 * (i as f64) + 0.15 * t * (i as f64));
        let v: f64 = cos(phase);
        tmpl.push(v);
        tmpl_e = tmpl_e + v * v;
        i = i + 1;
    }
    let sig_pow: f64 = tmpl_e / (l_ch as f64);
    // Exact -15.0 dB input per-sample SNR -> noise variance = sig_pow * 10^(15/10)
    let noise_var: f64 = sig_pow * exp(1.5 * ln10);
    let noise_std: f64 = sqrt(noise_var);
    let theory_out_snr_db: f64 = 10.0 * log(tmpl_e / noise_var) / ln10;

    // Run 16 independent -15 dB SNR Monte Carlo trials to verify 16/16 exact lag recovery & SNR bound
    let trials: i32 = 16;
    let mut sum_z: f64 = 0.0;
    let mut sum_null_z: f64 = 0.0;
    let mut exact_hits: i32 = 0;
    let mut first_lag: usize = 0;
    let mut t_match_ns: i64 = 0;
    let mut rng: u64 = 31415926535;
    let mut tr: i32 = 0;
    while tr < trials {
        let mut noise: Vec<f64> = Vec::new();
        let mut rx: Vec<f64> = Vec::new();
        i = 0;
        while i < n_sig {
            rng = splitmix64_next(rng);
            let u1: f64 = u64_unit(rng);
            rng = splitmix64_next(rng);
            let u2: f64 = u64_unit(rng);
            let g: f64 = sqrt(-2.0 * log(u1)) * cos(2.0 * pi * u2) * noise_std;
            noise.push(g);
            let sig_i: f64 = if i >= tau_true && i < tau_true + l_ch {
                tmpl[i - tau_true]
            } else {
                0.0
            };
            rx.push(g + sig_i);
            i = i + 1;
        }
        let t0: i64 = clock_ns();
        let det: MatchResult = run_matched_filter(&rx, &tmpl, tmpl_e, noise_std);
        let t1: i64 = clock_ns();
        if tr == 0 {
            t_match_ns = t1 - t0;
            first_lag = det.best_lag;
        }
        let null_det: MatchResult = run_matched_filter(&noise, &tmpl, tmpl_e, noise_std);
        if det.best_lag == tau_true {
            exact_hits = exact_hits + 1;
        }
        sum_z = sum_z + det.peak_z;
        sum_null_z = sum_null_z + null_det.peak_z;
        tr = tr + 1;
    }

    let mean_z: f64 = sum_z / (trials as f64);
    let mean_null_z: f64 = sum_null_z / (trials as f64);
    let meas_out_snr_db: f64 = 20.0 * log(max_f64(mean_z, 1.0e-9)) / ln10;

    // Exact CRLB delay standard deviation for linear chirp (bandwidth B=0.30 -> beta_rms = pi*B/sqrt(3))
    let beta_rms: f64 = pi * 0.30 / sqrt(3.0);
    let snr_out_lin: f64 = tmpl_e / noise_var;
    let crlb_delay_std: f64 = 1.0 / sqrt(2.0 * snr_out_lin * beta_rms * beta_rms);
    let snr_gap_db: f64 = abs_f64(meas_out_snr_db - theory_out_snr_db);

    if exact_hits == trials && snr_gap_db <= 0.5 && mean_z > 7.5 {
        println!(
            "[PASS] matched_filter_chirp hits={}/16 lag={} theory_snr={:.6} meas_snr={:.6} gap_db={:.6} crlb_std={:.9}",
            exact_hits,
            first_lag,
            theory_out_snr_db,
            meas_out_snr_db,
            snr_gap_db,
            crlb_delay_std
        );
    } else {
        println!(
            "[FAIL] matched_filter_chirp hits={} theory={} meas={} gap={}",
            exact_hits,
            theory_out_snr_db,
            meas_out_snr_db,
            snr_gap_db
        );
        failures = failures + 1;
    }

    // 2. Planted failing control: pure white-noise null MUST stay below detection threshold (mean_z < 4.5)
    if mean_null_z < 4.5 && (mean_z - mean_null_z) > 4.0 {
        println!(
            "[PASS] planted_white_noise_null rejected null_z={:.6} chirp_z={:.6}",
            mean_null_z,
            mean_z
        );
    } else {
        println!("[FAIL] planted_white_noise_null false_trigger null_z={}", mean_null_z);
        failures = failures + 1;
    }

    // 3. Frequency-domain Wiener deconvolution on N=256 blurred pulse (exact MSE improvement)
    let nw: usize = 256;
    let mut x_true: Vec<f64> = Vec::new();
    let mut h_re: Vec<f64> = Vec::new();
    let mut h_im: Vec<f64> = Vec::new();
    let mut x_re: Vec<f64> = Vec::new();
    let mut x_im: Vec<f64> = Vec::new();
    i = 0;
    while i < nw {
        let d1: f64 = (i as f64) - 80.0;
        let d2: f64 = (i as f64) - 160.0;
        let xv: f64 = exp(-0.08 * d1 * d1) + 0.7 * exp(-0.08 * d2 * d2);
        x_true.push(xv);
        x_re.push(xv);
        x_im.push(0.0);
        // Symmetric 5-tap blur PSF wrapped around 0
        let mut hv: f64 = 0.0;
        if i == 0 {
            hv = 0.40;
        } else if i == 1 || i == nw - 1 {
            hv = 0.22;
        } else if i == 2 || i == nw - 2 {
            hv = 0.08;
        }
        h_re.push(hv);
        h_im.push(0.0);
        i = i + 1;
    }
    radix2_fft(&mut x_re, &mut x_im, false);
    radix2_fft(&mut h_re, &mut h_im, false);

    // Observed spectrum Y = H * X + tiny noise
    let mut y_re: Vec<f64> = Vec::new();
    let mut y_im: Vec<f64> = Vec::new();
    let mut w_re: Vec<f64> = Vec::new();
    let mut w_im: Vec<f64> = Vec::new();
    let nsr: f64 = 0.002;
    i = 0;
    while i < nw {
        let yr: f64 = x_re[i] * h_re[i] - x_im[i] * h_im[i];
        let yi: f64 = x_re[i] * h_im[i] + x_im[i] * h_re[i];
        y_re.push(yr);
        y_im.push(yi);
        let h2: f64 = h_re[i] * h_re[i] + h_im[i] * h_im[i];
        let den: f64 = h2 + nsr;
        w_re.push((yr * h_re[i] + yi * h_im[i]) / den);
        w_im.push((yi * h_re[i] - yr * h_im[i]) / den);
        i = i + 1;
    }
    radix2_fft(&mut y_re, &mut y_im, true);
    radix2_fft(&mut w_re, &mut w_im, true);

    let mut blur_mse: f64 = 0.0;
    let mut wiener_mse: f64 = 0.0;
    i = 0;
    while i < nw {
        let eb: f64 = y_re[i] - x_true[i];
        let ew: f64 = w_re[i] - x_true[i];
        blur_mse = blur_mse + eb * eb;
        wiener_mse = wiener_mse + ew * ew;
        i = i + 1;
    }
    blur_mse = blur_mse / (nw as f64);
    wiener_mse = wiener_mse / (nw as f64);
    let mse_cut: f64 = blur_mse / wiener_mse;

    if mse_cut > 50.0 {
        println!(
            "[PASS] wiener_deconv blur_mse={:.6e} wiener_mse={:.6e} mse_cut={:.2}x",
            blur_mse,
            wiener_mse,
            mse_cut
        );
    } else {
        println!("[FAIL] wiener_deconv mse_cut={}", mse_cut);
        failures = failures + 1;
    }

    println!("[BENCH] signal_kcore matched_filter_ns={}", t_match_ns);

    if failures == 0 {
        println!("[PASS] signal_kcore summary failures=0");
    } else {
        println!("[FAIL] signal_kcore summary failures={}", failures);
    }
}
