// Crypto-Med GPU 360-Pack: MRI Kaiser-Bessel NUFFT k-space gridding kernel.
// Evaluates a polynomial Kaiser-Bessel window kernel over 2D non-Cartesian k-space offsets,
// applies density compensation weights, and accumulates gridded complex k-space samples.

#[compute(workgroup_size = [64, 1, 1])]
fn mri_nufft_gridding_gpu(
    beta_kb: f32,
    inv_half_w: f32,
    dkx_buf: &[f32],
    dky_buf: &[f32],
    dcf_buf: &[f32],
    kr_buf: &[f32],
    ki_buf: &[f32],
    grid_r_prev_buf: &[f32],
    grid_i_prev_buf: &[f32],
    grid_r_out: &mut [f32],
    grid_i_out: &mut [f32],
    weight_out: &mut [f32],
) ~ Gpu {
    let i = gl_GlobalInvocationID.x;
    let ux: f32 = dkx_buf[i] * inv_half_w;
    let uy: f32 = dky_buf[i] * inv_half_w;

    let mut arg_x: f32 = 1.0 - ux * ux;
    if arg_x < 0.0 {
        arg_x = 0.0;
    }
    let mut arg_y: f32 = 1.0 - uy * uy;
    if arg_y < 0.0 {
        arg_y = 0.0;
    }

    let z2_x: f32 = 0.25 * beta_kb * beta_kb * arg_x;
    let z2_y: f32 = 0.25 * beta_kb * beta_kb * arg_y;
    let i0_x: f32 = 1.0 + z2_x + 0.25 * z2_x * z2_x + 0.02777778 * z2_x * z2_x * z2_x;
    let i0_y: f32 = 1.0 + z2_y + 0.25 * z2_y * z2_y + 0.02777778 * z2_y * z2_y * z2_y;

    let w_kb: f32 = i0_x * i0_y * dcf_buf[i];
    grid_r_out[i] = grid_r_prev_buf[i] + w_kb * kr_buf[i];
    grid_i_out[i] = grid_i_prev_buf[i] + w_kb * ki_buf[i];
    weight_out[i] = w_kb;
}
