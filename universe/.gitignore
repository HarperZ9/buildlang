# BuildLang compiler has its own repo (HarperZ9/buildlang)
buildlang/

# Calibrate Pro Python artifacts
calibrate/__pycache__/
calibrate/*.pyc
calibrate/build/
calibrate/dist/
calibrate/*.egg-info/
calibrate/.pytest_cache/

# Build artifacts & archives
target/
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.zip
*.tar.gz
*.cube
*.icc
build_output.txt
nul

# Test output
calibration_output/
test_simple.c

