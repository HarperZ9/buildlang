*/lib.c
tests/programs/*.c
programs/*.c

# safe_write pre-calibration archive
.warden-safe-cache/

# coherence-membrane build-state witnesses (per-machine)
tools/coherence/witness/

# release/build artifacts
__pycache__/
*.pyc
*.spec
*.bin
*.bak

# Local-only Claude instructions (global standard: never commit)
CLAUDE.local.md

# Environment files (global standard: never commit)
.env
.env.*
# ...but the committed template must survive the .env.* rule above
!.env.example

# Build output (global standard: never commit)
dist/

# direnv environment files (can hold exported secrets)
.envrc
.envrc.local
