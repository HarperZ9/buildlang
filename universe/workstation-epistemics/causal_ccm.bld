// Wave 51K - Author Idea A23: Causal Granger + Transfer-Entropy + CCM (Sugihara 2012)
// Evaluates unidirectional coupled chaotic logistic maps (X -> Y) across 20 independent seeds:
//   X_{t+1} = X_t (3.8 - 3.8 X_t),   Y_{t+1} = Y_t (3.5 - 3.5 Y_t - beta_yx X_t)
// Verifies Granger, Transfer Entropy, and Convergent Cross Mapping (E=3, L=50 -> L=250)
// recover X -> Y on >= 20/20 seeds (> 95%), while flagging uncoupled and reversed-time
// planted controls as null / reversed fail-closed.

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn det_sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    let mut g: f64 = x;
    if g < 1.0 {
        g = 1.0;
    }
    let mut i: i32 = 0;
    while i < 24 {
        g = 0.5 * (g + x / g);
        i = i + 1;
    }
    g
}

fn det_ln(x: f64) -> f64 {
    if x <= 1.0e-30 {
        return -69.0;
    }
    let mut v: f64 = x;
    let mut k: i32 = 0;
    let ln2: f64 = 0.69314718055994530942;
    while v > 1.4142135623730951 {
        v = v * 0.5;
        k = k + 1;
    }
    while v < 0.7071067811865476 {
        v = v * 2.0;
        k = k - 1;
    }
    let y: f64 = (v - 1.0) / (v + 1.0);
    let y2: f64 = y * y;
    let mut term: f64 = y;
    let mut sum: f64 = y;
    let mut n: i32 = 1;
    while n < 10 {
        term = term * y2;
        sum = sum + term / ((2 * n + 1) as f64);
        n = n + 1;
    }
    2.0 * sum + (k as f64) * ln2
}

fn det_exp(x: f64) -> f64 {
    if x < -45.0 {
        return 0.0;
    }
    let u: f64 = x / 64.0;
    let mut t: f64 = 1.0 + u * (1.0 + u * (0.5 + u * (0.16666666666666666 + u * 0.041666666666666664)));
    let mut i: i32 = 0;
    while i < 6 {
        t = t * t;
        i = i + 1;
    }
    t
}

fn solve_3x3(a: &Vec<f64>, b: &Vec<f64>) -> Vec<f64> {
    let mut m: Vec<f64> = vec![
        a[0], a[1], a[2], b[0],
        a[3], a[4], a[5], b[1],
        a[6], a[7], a[8], b[2],
    ];
    let mut p: usize = 0;
    while p < 3 {
        let piv: f64 = m[p * 4 + p];
        let mut r: usize = p + 1;
        while r < 3 {
            let fac: f64 = m[r * 4 + p] / piv;
            let mut c: usize = p;
            while c < 4 {
                m[r * 4 + c] = m[r * 4 + c] - fac * m[p * 4 + c];
                c = c + 1;
            }
            r = r + 1;
        }
        p = p + 1;
    }
    let x2: f64 = m[11] / m[10];
    let x1: f64 = (m[7] - m[6] * x2) / m[5];
    let x0: f64 = (m[3] - m[1] * x1 - m[2] * x2) / m[0];
    vec![x0, x1, x2]
}

// Lag-1 quadratic Granger log-variance ratio: does src improve prediction of dst_{t+1}?
fn granger_score(src: &Vec<f64>, dst: &Vec<f64>) -> f64 {
    let n: usize = dst.len();
    // Restricted: dst_{t+1} ~ c0 + c1*dst_t + c2*dst_t^2
    let mut a_r: Vec<f64> = vec![0.0; 9];
    let mut b_r: Vec<f64> = vec![0.0; 3];
    let mut t: usize = 0;
    while t < n - 1 {
        let y: f64 = dst[t + 1];
        let f0: f64 = 1.0;
        let f1: f64 = dst[t];
        let f2: f64 = f1 * f1;
        let phi: Vec<f64> = vec![f0, f1, f2];
        let mut i: usize = 0;
        while i < 3 {
            b_r[i] = b_r[i] + phi[i] * y;
            let mut j: usize = 0;
            while j < 3 {
                a_r[i * 3 + j] = a_r[i * 3 + j] + phi[i] * phi[j];
                j = j + 1;
            }
            i = i + 1;
        }
        t = t + 1;
    }
    a_r[0] = a_r[0] + 1.0e-9;
    a_r[4] = a_r[4] + 1.0e-9;
    a_r[8] = a_r[8] + 1.0e-9;
    let wr: Vec<f64> = solve_3x3(&a_r, &b_r);

    // Regress residual on (1, src_t, src_t * dst_t) to test nonlinear interaction gain
    let mut rss_r: f64 = 0.0;
    let mut a_u: Vec<f64> = vec![0.0; 9];
    let mut b_u: Vec<f64> = vec![0.0; 3];
    t = 0;
    while t < n - 1 {
        let pred_r: f64 = wr[0] + wr[1] * dst[t] + wr[2] * dst[t] * dst[t];
        let res: f64 = dst[t + 1] - pred_r;
        rss_r = rss_r + res * res;
        let phi: Vec<f64> = vec![1.0, src[t], src[t] * dst[t]];
        let mut i: usize = 0;
        while i < 3 {
            b_u[i] = b_u[i] + phi[i] * res;
            let mut j: usize = 0;
            while j < 3 {
                a_u[i * 3 + j] = a_u[i * 3 + j] + phi[i] * phi[j];
                j = j + 1;
            }
            i = i + 1;
        }
        t = t + 1;
    }
    a_u[0] = a_u[0] + 1.0e-9;
    a_u[4] = a_u[4] + 1.0e-9;
    a_u[8] = a_u[8] + 1.0e-9;
    let wu: Vec<f64> = solve_3x3(&a_u, &b_u);

    let mut rss_u: f64 = 0.0;
    t = 0;
    while t < n - 1 {
        let pred_r: f64 = wr[0] + wr[1] * dst[t] + wr[2] * dst[t] * dst[t];
        let res: f64 = dst[t + 1] - pred_r;
        let res2: f64 = res - (wu[0] + wu[1] * src[t] + wu[2] * src[t] * dst[t]);
        rss_u = rss_u + res2 * res2;
        t = t + 1;
    }
    det_ln((rss_r + 1.0e-15) / (rss_u + 1.0e-15))
}

fn bin4(v: f64) -> usize {
    if v < 0.25 { 0 } else if v < 0.50 { 1 } else if v < 0.75 { 2 } else { 3 }
}

// Transfer Entropy TE(src -> dst) = I(dst_{t+1}; src_t | dst_t) in bits (4-bin)
fn transfer_entropy(src: &Vec<f64>, dst: &Vec<f64>) -> f64 {
    let n: usize = dst.len() - 1;
    let mut c_xyz: Vec<i32> = vec![0; 64]; // (dst_{t+1}, dst_t, src_t)
    let mut c_xy: Vec<i32> = vec![0; 16];  // (dst_{t+1}, dst_t)
    let mut c_yz: Vec<i32> = vec![0; 16];  // (dst_t, src_t)
    let mut c_y: Vec<i32> = vec![0; 4];    // (dst_t)
    let mut t: usize = 0;
    while t < n {
        let bx: usize = bin4(dst[t + 1]);
        let by: usize = bin4(dst[t]);
        let bz: usize = bin4(src[t]);
        c_xyz[(bx * 4 + by) * 4 + bz] = c_xyz[(bx * 4 + by) * 4 + bz] + 1;
        c_xy[bx * 4 + by] = c_xy[bx * 4 + by] + 1;
        c_yz[by * 4 + bz] = c_yz[by * 4 + bz] + 1;
        c_y[by] = c_y[by] + 1;
        t = t + 1;
    }
    let nf: f64 = n as f64;
    let ln2: f64 = 0.69314718055994530942;
    let mut te: f64 = 0.0;
    let mut bx: usize = 0;
    while bx < 4 {
        let mut by: usize = 0;
        while by < 4 {
            let mut bz: usize = 0;
            while bz < 4 {
                let n_xyz: i32 = c_xyz[(bx * 4 + by) * 4 + bz];
                if n_xyz > 0 {
                    let p_xyz: f64 = (n_xyz as f64) / nf;
                    let num: f64 = (n_xyz as f64) * (c_y[by] as f64);
                    let den: f64 = (c_yz[by * 4 + bz] as f64) * (c_xy[bx * 4 + by] as f64);
                    te = te + p_xyz * (det_ln(num / den) / ln2);
                }
                bz = bz + 1;
            }
            by = by + 1;
        }
        bx = bx + 1;
    }
    te
}

// Sugihara (2012) CCM: cross-map target using E=3 shadow manifold of lib_series (length lib_len)
fn ccm_xmap_rho(lib_series: &Vec<f64>, target: &Vec<f64>, lib_len: usize) -> f64 {
    let n_pts: usize = lib_len - 2;
    let mut preds: Vec<f64> = Vec::new();
    let mut trues: Vec<f64> = Vec::new();
    let mut i: usize = 2;
    while i < lib_len {
        let a0: f64 = lib_series[i];
        let a1: f64 = lib_series[i - 1];
        let a2: f64 = lib_series[i - 2];

        // Find E+1 = 4 nearest neighbors in delay embedding M_lib (leave-one-out)
        let mut d0: f64 = 1.0e9;
        let mut d1: f64 = 1.0e9;
        let mut d2: f64 = 1.0e9;
        let mut d3: f64 = 1.0e9;
        let mut i0: usize = 2;
        let mut i1: usize = 2;
        let mut i2: usize = 2;
        let mut i3: usize = 2;

        let mut j: usize = 2;
        while j < lib_len {
            if j != i {
                let dx0: f64 = a0 - lib_series[j];
                let dx1: f64 = a1 - lib_series[j - 1];
                let dx2: f64 = a2 - lib_series[j - 2];
                let dist: f64 = det_sqrt(dx0 * dx0 + dx1 * dx1 + dx2 * dx2);
                if dist < d0 {
                    d3 = d2; i3 = i2; d2 = d1; i2 = i1; d1 = d0; i1 = i0; d0 = dist; i0 = j;
                } else if dist < d1 {
                    d3 = d2; i3 = i2; d2 = d1; i2 = i1; d1 = dist; i1 = j;
                } else if dist < d2 {
                    d3 = d2; i3 = i2; d2 = dist; i2 = j;
                } else if dist < d3 {
                    d3 = dist; i3 = j;
                }
            }
            j = j + 1;
        }
        let d_min: f64 = if d0 > 1.0e-12 { d0 } else { 1.0e-12 };
        let w0: f64 = det_exp(-d0 / d_min);
        let w1: f64 = det_exp(-d1 / d_min);
        let w2: f64 = det_exp(-d2 / d_min);
        let w3: f64 = det_exp(-d3 / d_min);
        let w_sum: f64 = w0 + w1 + w2 + w3;
        let y_hat: f64 = (w0 * target[i0] + w1 * target[i1] + w2 * target[i2] + w3 * target[i3]) / w_sum;
        preds.push(y_hat);
        trues.push(target[i]);
        i = i + 1;
    }

    // Pearson correlation rho(preds, trues)
    let mut mp: f64 = 0.0;
    let mut mt: f64 = 0.0;
    let mut k: usize = 0;
    while k < n_pts {
        mp = mp + preds[k];
        mt = mt + trues[k];
        k = k + 1;
    }
    mp = mp / (n_pts as f64);
    mt = mt / (n_pts as f64);
    let mut cov: f64 = 0.0;
    let mut vp: f64 = 0.0;
    let mut vt: f64 = 0.0;
    k = 0;
    while k < n_pts {
        let dp: f64 = preds[k] - mp;
        let dt: f64 = trues[k] - mt;
        cov = cov + dp * dt;
        vp = vp + dp * dp;
        vt = vt + dt * dt;
        k = k + 1;
    }
    cov / det_sqrt(vp * vt + 1.0e-18)
}

struct CoupledSeries {
    x: Vec<f64>,
    y: Vec<f64>,
}

fn gen_coupled_logistic(seed: i32, beta_yx: f64, beta_xy: f64, reverse_time: bool) -> CoupledSeries {
    let mut x: f64 = 0.17 + 0.031 * ((seed % 20) as f64);
    let mut y: f64 = 0.23 + 0.029 * (((seed * 7 + 3) % 20) as f64);
    let mut xs: Vec<f64> = Vec::new();
    let mut ys: Vec<f64> = Vec::new();
    let mut t: i32 = 0;
    while t < 360 {
        let xn: f64 = x * (3.8 - 3.8 * x - beta_xy * y);
        let yn: f64 = y * (3.5 - 3.5 * y - beta_yx * x);
        x = xn;
        y = yn;
        if t >= 100 {
            xs.push(x);
            ys.push(y);
        }
        t = t + 1;
    }
    if reverse_time {
        let n: usize = xs.len();
        let mut rx: Vec<f64> = Vec::new();
        let mut ry: Vec<f64> = Vec::new();
        let mut k: usize = 0;
        while k < n {
            rx.push(xs[n - 1 - k]);
            ry.push(ys[n - 1 - k]);
            k = k + 1;
        }
        return CoupledSeries { x: rx, y: ry };
    }
    CoupledSeries { x: xs, y: ys }
}

fn main() ~ Clock + Console {
    let mut failures: i32 = 0;
    let t0_ns: i64 = clock_ns();

    // 1. Coupled X -> Y across 20 independent seeds (beta_yx=0.20, beta_xy=0.0)
    let mut g_hits: i32 = 0;
    let mut te_hits: i32 = 0;
    let mut ccm_hits: i32 = 0;
    let mut mean_ccm_xy: f64 = 0.0;
    let mut mean_ccm_yx: f64 = 0.0;
    let mut mean_g_diff: f64 = 0.0;
    let mut mean_te_diff: f64 = 0.0;
    let mut checksum: f64 = 0.0;

    let mut s: i32 = 0;
    while s < 20 {
        let cs: CoupledSeries = gen_coupled_logistic(s, 0.20, 0.0, false);
        let g_xy: f64 = granger_score(&cs.x, &cs.y);
        let g_yx: f64 = granger_score(&cs.y, &cs.x);
        let te_xy: f64 = transfer_entropy(&cs.x, &cs.y);
        let te_yx: f64 = transfer_entropy(&cs.y, &cs.x);
        // X drives Y => Y's manifold cross-maps X (rho_y_xmap_x >> rho_x_xmap_y) & converges with L
        let rho_short: f64 = ccm_xmap_rho(&cs.y, &cs.x, 50);
        let rho_long: f64 = ccm_xmap_rho(&cs.y, &cs.x, 250);
        let rho_rev: f64 = ccm_xmap_rho(&cs.x, &cs.y, 250);

        if g_xy > g_yx + 1.0 {
            g_hits = g_hits + 1;
        }
        if te_xy > te_yx + 0.10 {
            te_hits = te_hits + 1;
        }
        if rho_long > 0.70 && rho_long > rho_short && rho_long > rho_rev + 0.35 {
            ccm_hits = ccm_hits + 1;
        }
        mean_ccm_xy = mean_ccm_xy + rho_long;
        mean_ccm_yx = mean_ccm_yx + rho_rev;
        mean_g_diff = mean_g_diff + (g_xy - g_yx);
        mean_te_diff = mean_te_diff + (te_xy - te_yx);
        checksum = checksum + g_xy + te_xy + rho_long;
        s = s + 1;
    }
    mean_ccm_xy = mean_ccm_xy / 20.0;
    mean_ccm_yx = mean_ccm_yx / 20.0;
    mean_g_diff = mean_g_diff / 20.0;
    mean_te_diff = mean_te_diff / 20.0;

    if g_hits == 20 && te_hits == 20 && ccm_hits == 20 {
        println!(
            "[PASS] causal_x_to_y_20seeds g={}/20 te={}/20 ccm={}/20 rho_y_xmap_x={:.4} rho_x_xmap_y={:.4}",
            g_hits, te_hits, ccm_hits, mean_ccm_xy, mean_ccm_yx
        );
    } else {
        println!(
            "[FAIL] causal_x_to_y_20seeds g={}/20 te={}/20 ccm={}/20",
            g_hits, te_hits, ccm_hits
        );
        failures = failures + 1;
    }

    // 2. Planted Control 1: Uncoupled Null (beta_yx=0, beta_xy=0)
    let cs_null: CoupledSeries = gen_coupled_logistic(0, 0.0, 0.0, false);
    let g_null: f64 = granger_score(&cs_null.x, &cs_null.y);
    let ccm_null: f64 = ccm_xmap_rho(&cs_null.y, &cs_null.x, 250);
    if g_null < 0.20 && abs_f64(ccm_null) < 0.25 {
        println!(
            "[PASS] planted_ctrl1_uncoupled_null flagged_null g_xy={:.6} ccm_rho={:.6}",
            g_null, ccm_null
        );
    } else {
        println!("[FAIL] planted_ctrl1_uncoupled_null missed g={:.6} ccm={:.6}", g_null, ccm_null);
        failures = failures + 1;
    }

    // 3. Planted Control 2: Reversed-Time Arrow-of-Time Check (destroys forward Granger X -> Y)
    let cs_rev: CoupledSeries = gen_coupled_logistic(0, 0.20, 0.0, true);
    let g_rev_xy: f64 = granger_score(&cs_rev.x, &cs_rev.y);
    let te_rev_xy: f64 = transfer_entropy(&cs_rev.x, &cs_rev.y);
    if g_rev_xy < 0.50 {
        println!(
            "[PASS] planted_ctrl2_reversed_time flagged_broken_arrow g_rev_xy={:.6} te_rev_xy={:.6}",
            g_rev_xy, te_rev_xy
        );
    } else {
        println!("[FAIL] planted_ctrl2_reversed_time missed g_rev_xy={:.6}", g_rev_xy);
        failures = failures + 1;
    }

    let elapsed_ms: f64 = ((clock_ns() - t0_ns) as f64) / 1.0e6;
    println!(
        "[METRICS_A23] elapsed_ms={:.4} mean_g_diff={:.6} mean_te_diff={:.6} checksum={:.9} failures={}",
        elapsed_ms, mean_g_diff, mean_te_diff, checksum, failures
    );
}
