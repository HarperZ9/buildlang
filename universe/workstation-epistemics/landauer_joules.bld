// Wave 51K - Author Idea D8: Landauer Reversible-Gate Thermodynamics
// Computes exact Landauer limit k_B * T * ln(2) at 300 K (2.8709e-21 J/bit),
// verifies bijective 3-bit Toffoli gate (8/8 distinct outputs, 0 bits erased) vs
// irreversible 2-input AND gate (1.188722 bits erased, > 0 dissipation), and
// catches a planted non-bijective fake-reversible gate fail-closed.

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

// High-precision natural log via range reduction to [sqrt(0.5), sqrt(2)] + atanh series
fn det_ln(x: f64) -> f64 {
    let mut v: f64 = x;
    let mut k: i32 = 0;
    let ln2: f64 = 0.69314718055994530942;
    while v > 1.4142135623730951 {
        v = v * 0.5;
        k = k + 1;
    }
    while v < 0.7071067811865476 {
        v = v * 2.0;
        k = k - 1;
    }
    let y: f64 = (v - 1.0) / (v + 1.0);
    let y2: f64 = y * y;
    let mut term: f64 = y;
    let mut sum: f64 = y;
    let mut n: i32 = 1;
    while n < 12 {
        term = term * y2;
        sum = sum + term / ((2 * n + 1) as f64);
        n = n + 1;
    }
    2.0 * sum + (k as f64) * ln2
}

fn det_log2(x: f64) -> f64 {
    det_ln(x) / 0.69314718055994530942
}

struct GateAudit {
    distinct_outputs: i32,
    bijective: bool,
    h_in_bits: f64,
    h_out_bits: f64,
    erased_bits: f64,
    min_joules_300k: f64,
}

// Audit a deterministic gate mapping 2^n_in states to outputs in [0, 2^n_out - 1]
fn audit_gate(outputs: &Vec<i32>, n_in_bits: i32, temp_k: f64) -> GateAudit {
    let n_states: usize = outputs.len();
    let kb: f64 = 1.380649e-23; // Exact SI 2019 Boltzmann constant (J/K)
    let ln2: f64 = 0.69314718055994530942;
    let landauer_j: f64 = kb * temp_k * ln2;

    let mut counts: Vec<i32> = vec![0; 16];
    let mut i: usize = 0;
    while i < n_states {
        let o: usize = outputs[i] as usize;
        counts[o] = counts[o] + 1;
        i = i + 1;
    }

    let mut distinct: i32 = 0;
    let mut h_out: f64 = 0.0;
    let total_f: f64 = n_states as f64;
    let mut c_idx: usize = 0;
    while c_idx < 16 {
        if counts[c_idx] > 0 {
            distinct = distinct + 1;
            let p: f64 = (counts[c_idx] as f64) / total_f;
            h_out = h_out - p * det_log2(p);
        }
        c_idx = c_idx + 1;
    }

    let h_in: f64 = n_in_bits as f64;
    let mut erased: f64 = h_in - h_out;
    if abs_f64(erased) < 1.0e-14 {
        erased = 0.0;
    }
    let bijective: bool = distinct == (n_states as i32);

    GateAudit {
        distinct_outputs: distinct,
        bijective: bijective,
        h_in_bits: h_in,
        h_out_bits: h_out,
        erased_bits: erased,
        min_joules_300k: erased * landauer_j,
    }
}

fn main() ~ Clock + Console {
    let mut failures: i32 = 0;
    let t0_ns: i64 = clock_ns();

    // 1. Exact Landauer bit-erasure dissipation at T = 300 K
    let kb: f64 = 1.380649e-23;
    let temp_k: f64 = 300.0;
    let landauer_300k: f64 = kb * temp_k * det_ln(2.0);
    let expected_j: f64 = 2.870978885078724e-21;
    let rel_err: f64 = abs_f64(landauer_300k - expected_j) / expected_j;
    if rel_err <= 1.0e-12 {
        println!(
            "[PASS] landauer_300k j_per_bit={:.15e} rel_err={:.3e}",
            landauer_300k, rel_err
        );
    } else {
        println!("[FAIL] landauer_300k j_per_bit={:.15e} rel_err={:.3e}", landauer_300k, rel_err);
        failures = failures + 1;
    }

    // 2. Reversible 3-bit Toffoli (CCNOT) gate: (a, b, c) -> (a, b, c XOR (a AND b))
    let mut toffoli_out: Vec<i32> = Vec::new();
    let mut x: i32 = 0;
    while x < 8 {
        let a: i32 = (x >> 2) & 1;
        let b: i32 = (x >> 1) & 1;
        let c: i32 = x & 1;
        let c_out: i32 = c ^ (a & b);
        toffoli_out.push((a << 2) | (b << 1) | c_out);
        x = x + 1;
    }
    let tof: GateAudit = audit_gate(&toffoli_out, 3, temp_k);
    if tof.bijective && tof.distinct_outputs == 8 && tof.erased_bits == 0.0 && tof.min_joules_300k == 0.0 {
        println!(
            "[PASS] toffoli_reversible distinct={}/8 erased_bits={:.6} j_300k={:.3e}",
            tof.distinct_outputs, tof.erased_bits, tof.min_joules_300k
        );
    } else {
        println!("[FAIL] toffoli_reversible distinct={} erased={:.6}", tof.distinct_outputs, tof.erased_bits);
        failures = failures + 1;
    }

    // 3. Irreversible 2-bit AND gate: (a, b) -> (a AND b)
    let and_out: Vec<i32> = vec![0, 0, 0, 1];
    let and_aud: GateAudit = audit_gate(&and_out, 2, temp_k);
    if !and_aud.bijective && and_aud.erased_bits > 1.18 && and_aud.min_joules_300k > 3.4e-21 {
        println!(
            "[PASS] and_irreversible distinct={}/4 erased_bits={:.9} j_300k={:.12e}",
            and_aud.distinct_outputs, and_aud.erased_bits, and_aud.min_joules_300k
        );
    } else {
        println!("[FAIL] and_irreversible erased={:.6}", and_aud.erased_bits);
        failures = failures + 1;
    }

    // 4. Planted Control: Non-bijective fake-reversible 3-bit gate (collides state 3 -> 7)
    let mut fake_rev: Vec<i32> = vec![0, 1, 2, 7, 4, 5, 6, 7];
    let fake_aud: GateAudit = audit_gate(&fake_rev, 3, temp_k);
    if !fake_aud.bijective && fake_aud.distinct_outputs == 7 && fake_aud.erased_bits > 0.24 {
        println!(
            "[PASS] planted_ctrl_fake_reversible caught distinct={}/8 erased_bits={:.6} j_300k={:.6e}",
            fake_aud.distinct_outputs, fake_aud.erased_bits, fake_aud.min_joules_300k
        );
    } else {
        println!("[FAIL] planted_ctrl_fake_reversible missed bijective={}", fake_aud.bijective);
        failures = failures + 1;
    }

    let elapsed_ms: f64 = ((clock_ns() - t0_ns) as f64) / 1.0e6;
    println!(
        "[METRICS_D8] elapsed_ms={:.4} landauer_zJ={:.12} and_erased={:.12} fake_erased={:.12} failures={}",
        elapsed_ms, landauer_300k * 1.0e21, and_aud.erased_bits, fake_aud.erased_bits, failures
    );
}
