//
// Wave 53E (Author Idea G12): 6-Decade OOD Log-Sweep Stress Harness (ood_log_sweep.bld)
// - Sweeps 121 log-spaced points from 1e-6 to 1e+6 (12 orders of magnitude, +/- 6 decades)
// - Proves clean stabilized physics kernel passes 121/121 with 0 NaN, 0 overflow, 0 symmetry error
// - Flags 3/3 planted OOD traps fail-closed: NaN domain failure, exp() overflow, and even-symmetry break

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return -x; }
    x
}

fn is_nan_f64(x: f64) -> i32 {
    if x != x { return 1; }
    0
}

fn is_inf_or_overflow(x: f64) -> i32 {
    let a: f64 = abs_f64(x);
    if a > 1.0e300 {
        return 1;
    }
    0
}

// Well-conditioned even kernel: g_clean(x) = 1.0 / (1.0 + x*x) and stabilized sqrt(1+x^2)-|x|
fn clean_kernel(x: f64) -> f64 {
    let ax: f64 = abs_f64(x);
    1.0 / (sqrt(1.0 + ax * ax) + ax)
}

fn main() ~ Clock + Console {
    let t0: i64 = clock_ns();
    let ln10: f64 = log(10.0);
    let n_pts: i32 = 121;

    let mut clean_nan: i32 = 0;
    let mut clean_ovf: i32 = 0;
    let mut clean_sym_err: f64 = 0.0;
    let mut clean_csum: f64 = 0.0;

    let mut trap_nan_hits: i32 = 0;
    let mut trap_ovf_hits: i32 = 0;
    let mut trap_sym_max_err: f64 = 0.0;

    let mut k: i32 = 0;
    while k < n_pts {
        // Log-sweep from 1e-6 (k=0) to 1e+6 (k=120)
        let expo: f64 = -6.0 + 12.0 * (k as f64) / 120.0;
        let x: f64 = exp(expo * ln10);

        // 1. Clean stabilized kernel audit
        let y_pos: f64 = clean_kernel(x);
        let y_neg: f64 = clean_kernel(-x);
        if is_nan_f64(y_pos) == 1 || is_nan_f64(y_neg) == 1 { clean_nan = clean_nan + 1; }
        if is_inf_or_overflow(y_pos) == 1 || is_inf_or_overflow(y_neg) == 1 { clean_ovf = clean_ovf + 1; }
        let se: f64 = abs_f64(y_pos - y_neg);
        if se > clean_sym_err { clean_sym_err = se; }
        clean_csum = clean_csum + y_pos;

        // 2. Planted NaN trap: sqrt(x - 1e-3) goes NaN for small OOD x < 1e-3
        let y_nan: f64 = sqrt(x - 1.0e-3);
        if is_nan_f64(y_nan) == 1 { trap_nan_hits = trap_nan_hits + 1; }

        // 3. Planted overflow trap: exp(x) overflows for large OOD x > 709.8
        let y_ovf: f64 = exp(x);
        if is_inf_or_overflow(y_ovf) == 1 { trap_ovf_hits = trap_ovf_hits + 1; }

        // 4. Planted symmetry-breakdown trap: even kernel + odd linear OOD drift 1e-3 * x
        let b_pos: f64 = 1.0 / (1.0 + x * x) + 1.0e-3 * x;
        let b_neg: f64 = 1.0 / (1.0 + x * x) - 1.0e-3 * x;
        let b_err: f64 = abs_f64(b_pos - b_neg);
        if b_err > trap_sym_max_err { trap_sym_max_err = b_err; }

        k = k + 1;
    }

    let clean_ok: i32 = if clean_nan == 0 && clean_ovf == 0 && clean_sym_err < 1.0e-12 { 1 } else { 0 };
    let traps_caught: i32 =
        (if trap_nan_hits > 0 { 1 } else { 0 })
        + (if trap_ovf_hits > 0 { 1 } else { 0 })
        + (if trap_sym_max_err > 1.0 { 1 } else { 0 });

    let t1: i64 = clock_ns();
    let elapsed_ms: f64 = ((t1 - t0) as f64) / 1.0e6;

    println!("G12_POINTS_SWEPT={}", n_pts);
    println!("G12_CLEAN_NAN={}", clean_nan);
    println!("G12_CLEAN_OVF={}", clean_ovf);
    println!("G12_CLEAN_SYM_ERR={:.15}", clean_sym_err);
    println!("G12_CLEAN_CHECKSUM={:.12}", clean_csum);
    println!("G12_TRAP_NAN_HITS={}", trap_nan_hits);
    println!("G12_TRAP_OVF_HITS={}", trap_ovf_hits);
    println!("G12_TRAP_SYM_MAX_ERR={:.6}", trap_sym_max_err);
    println!("G12_TRAPS_CAUGHT={}", traps_caught);
    println!("G12_ELAPSED_MS={:.4}", elapsed_ms);

    if clean_ok == 1 && traps_caught == 3 {
        println!(
            "[PASS] G12_OOD_LOG_SWEEP pts=121 clean_ok=1 traps=3/3 nan={} ovf={} sym_err={:.1}",
            trap_nan_hits, trap_ovf_hits, trap_sym_max_err
        );
    } else {
        println!("[FAIL] G12_OOD_LOG_SWEEP clean_ok={} traps={}/3", clean_ok, traps_caught);
    }
}
