// Wave 57G (Author Idea N51, SIG-113): Articulate Personal Voice Twin Calibrator
// Extracts cadence CV, normalized sentence-length entropy, contraction rate, and
// corporate-register density calibrated strictly to a consenting single-user baseline.
// Rejects corporate-slop drift (>= 0.50) and unconsented third-party impersonation fail-closed.

struct VoiceProfile {
    cadence_cv: f64,
    len_entropy: f64,
    contraction_rate: f64,
    corp_density: f64,
}

fn log2_f64(x: f64) -> f64 {
    ln(x) / 0.693147180559945309417232121458176568
}

fn extract_voice_profile(
    sent_lens: &Vec<f64>,
    contractions: i32,
    corp_hits: i32,
) -> VoiceProfile {
    let n: usize = sent_lens.len();
    let nf: f64 = n as f64;
    let mut sum: f64 = 0.0;
    let mut i: usize = 0;
    while i < n {
        sum = sum + sent_lens[i];
        i = i + 1;
    }
    let mean: f64 = sum / nf;
    let mut var_acc: f64 = 0.0;
    let mut bins: Vec<i32> = vec![0, 0, 0, 0];
    i = 0;
    while i < n {
        let d: f64 = sent_lens[i] - mean;
        var_acc = var_acc + d * d;
        let v: f64 = sent_lens[i];
        if v < 8.0 {
            bins[0] = bins[0] + 1;
        } else if v < 15.0 {
            bins[1] = bins[1] + 1;
        } else if v < 23.0 {
            bins[2] = bins[2] + 1;
        } else {
            bins[3] = bins[3] + 1;
        }
        i = i + 1;
    }
    let cv: f64 = sqrt(var_acc / nf) / mean;

    let mut ent: f64 = 0.0;
    let mut b: usize = 0;
    while b < 4 {
        if bins[b] > 0 {
            let p: f64 = (bins[b] as f64) / nf;
            ent = ent - p * log2_f64(p);
        }
        b = b + 1;
    }
    let norm_ent: f64 = ent / 2.0;
    let c_rate: f64 = (contractions as f64) / sum;
    let corp_d: f64 = (corp_hits as f64) / sum;

    VoiceProfile {
        cadence_cv: cv,
        len_entropy: norm_ent,
        contraction_rate: c_rate,
        corp_density: corp_d,
    }
}

fn voice_distance(a: &VoiceProfile, b: &VoiceProfile) -> f64 {
    let d0: f64 = a.cadence_cv - b.cadence_cv;
    let d1: f64 = a.len_entropy - b.len_entropy;
    let d2: f64 = 4.0 * (a.contraction_rate - b.contraction_rate);
    let d3: f64 = 8.0 * (a.corp_density - b.corp_density);
    sqrt(d0 * d0 + d1 * d1 + d2 * d2 + d3 * d3)
}

// Fail-closed calibration gate:
// 0=MATCHED_VOICE, -201=SLOP_DRIFT, -202=NO_SINGLE_USER_CONSENT
fn gate_voice_twin(
    owner_id: i32,
    target_id: i32,
    consent_granted: bool,
    dist: f64,
) -> i32 {
    if !consent_granted || owner_id != target_id {
        return -202;
    }
    if dist > 0.05 {
        return -201;
    }
    0
}

fn main() ~ Console + Clock {
    let t0: i64 = clock_ns();

    // Consenting owner baseline: varied natural cadence across all 4 length bins
    let base_lens: Vec<f64> = vec![6.0, 19.0, 11.0, 27.0, 7.0, 14.0, 24.0, 10.0];
    let base_vp: VoiceProfile = extract_voice_profile(&base_lens, 6, 0);

    // Matched owner draft: nearly identical rhythm and contractions
    let match_lens: Vec<f64> = vec![6.0, 18.0, 12.0, 26.0, 7.0, 14.0, 25.0, 10.0];
    let match_vp: VoiceProfile = extract_voice_profile(&match_lens, 6, 0);

    // Synthetic corporate-slop rewrite: metronomic uniform 18-word sentences, zero contractions, heavy filler
    let slop_lens: Vec<f64> = vec![18.0, 18.0, 19.0, 18.0, 17.0, 18.0, 18.0, 18.0];
    let slop_vp: VoiceProfile = extract_voice_profile(&slop_lens, 0, 8);

    let d_match: f64 = voice_distance(&match_vp, &base_vp);
    let d_slop: f64 = voice_distance(&slop_vp, &base_vp);

    let rc_match: i32 = gate_voice_twin(42, 42, true, d_match);
    let rc_slop: i32 = gate_voice_twin(42, 42, true, d_slop);
    // Planted third-party impersonation attempt (target_id=99 != owner_id=42)
    let rc_impers: i32 = gate_voice_twin(42, 99, true, d_match);
    let rc_noconsent: i32 = gate_voice_twin(42, 42, false, d_match);

    let t1: i64 = clock_ns();
    let elapsed_ms: f64 = ((t1 - t0) as f64) / 1.0e6;

    let mut failures: i32 = 0;
    if rc_match != 0 || d_match > 0.05 {
        failures = failures + 1;
    }
    if rc_slop != -201 || d_slop < 0.50 {
        failures = failures + 1;
    }
    if rc_impers != -202 || rc_noconsent != -202 {
        failures = failures + 1;
    }

    let p1: String = format!(
        "VOICE_TWIN status={} failures={} elapsed_ms={:.4} base_cv={:.9} d_match={:.9} d_slop={:.9}",
        if failures == 0 { "PASS" } else { "FAIL" },
        failures,
        elapsed_ms,
        base_vp.cadence_cv,
        d_match,
        d_slop
    );
    let p2: String = format!(
        "rc_match={} rc_slop={} rc_impers={} rc_noconsent={}",
        rc_match, rc_slop, rc_impers, rc_noconsent
    );
    println!("{} {}", p1, p2);
}
