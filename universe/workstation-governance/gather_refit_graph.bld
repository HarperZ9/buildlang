//
// Wave 57F (N32 / SIG-108): Gather Deterministic Refit Provenance DAG.
// Links (source_sha256 -> crop_bbox/span -> quote_hash -> claim_hash) using
// pure BuildLang FIPS 180-4 SHA-256, Kahn topological cycle detection, and
// cryptographic root-ancestor reachability. Rejects planted orphan and cyclic
// provenance links fail-closed.

fn m32(x: u64) -> u64 {
    return x & 4294967295;
}

fn rotr32(x: u64, n: u64) -> u64 {
    let v: u64 = m32(x);
    return m32((v >> n) | (v << (32 - n)));
}

fn sha256_k(i: i64) -> u64 {
    let mut k: Vec<u64> = Vec::new();
    k.push(1116352408); k.push(1899447441); k.push(3049323471); k.push(3921009573);
    k.push(961987163);  k.push(1508970993); k.push(2453635748); k.push(2870763221);
    k.push(3624381080); k.push(310598401);  k.push(607225278);  k.push(1426881987);
    k.push(1925078388); k.push(2162078206); k.push(2614888103); k.push(3248222580);
    k.push(3835390401); k.push(4022224774); k.push(264347078);  k.push(604807628);
    k.push(770255983);  k.push(1249150122); k.push(1555081692); k.push(1996064986);
    k.push(2554220882); k.push(2821834349); k.push(2952996808); k.push(3210313671);
    k.push(3336571891); k.push(3584528711); k.push(113926993);  k.push(338241895);
    k.push(666307205);  k.push(773529912);  k.push(1294757372); k.push(1396182291);
    k.push(1695183700); k.push(1986661051); k.push(2177026350); k.push(2456956037);
    k.push(2730485921); k.push(2820302411); k.push(3259730800); k.push(3345764771);
    k.push(3516065817); k.push(3600352804); k.push(4094571909); k.push(275423344);
    k.push(430227734);  k.push(506948616);  k.push(659060556);  k.push(883997877);
    k.push(958139571);  k.push(1322822218); k.push(1537002063); k.push(1747873779);
    k.push(1955562222); k.push(2024104815); k.push(2227730452); k.push(2361852424);
    k.push(2428436474); k.push(2756734187); k.push(3204031479); k.push(3329325298);
    return k[i as usize];
}

fn sha256_bytes(msg: &Vec<u64>) -> Vec<u64> {
    let mut padded: Vec<u64> = Vec::new();
    let msg_len: i64 = msg.len() as i64;
    let mut i: i64 = 0;
    while i < msg_len {
        padded.push(msg[i as usize] & 255);
        i = i + 1;
    }
    padded.push(128);
    while ((padded.len() as i64) % 64) != 56 {
        padded.push(0);
    }
    let bit_len: u64 = (msg_len as u64) * 8;
    let mut b: i64 = 7;
    while b >= 0 {
        let shift: u64 = (b as u64) * 8;
        padded.push((bit_len >> shift) & 255);
        b = b - 1;
    }

    let mut h0: u64 = 1779033703;
    let mut h1: u64 = 3144134277;
    let mut h2: u64 = 1013904242;
    let mut h3: u64 = 2773480762;
    let mut h4: u64 = 1359893119;
    let mut h5: u64 = 2600822924;
    let mut h6: u64 = 528734635;
    let mut h7: u64 = 1541459225;

    let blocks: i64 = (padded.len() as i64) / 64;
    let mut blk: i64 = 0;
    while blk < blocks {
        let mut w: Vec<u64> = Vec::new();
        let base: i64 = blk * 64;
        let mut t: i64 = 0;
        while t < 16 {
            let p: i64 = base + t * 4;
            let word: u64 = (padded[p as usize] << 24)
                | (padded[(p + 1) as usize] << 16)
                | (padded[(p + 2) as usize] << 8)
                | padded[(p + 3) as usize];
            w.push(m32(word));
            t = t + 1;
        }
        while t < 64 {
            let w15: u64 = w[(t - 15) as usize];
            let w2: u64 = w[(t - 2) as usize];
            let s0: u64 = rotr32(w15, 7) ^ rotr32(w15, 18) ^ (w15 >> 3);
            let s1: u64 = rotr32(w2, 17) ^ rotr32(w2, 19) ^ (w2 >> 10);
            let nxt: u64 = m32(w[(t - 16) as usize] + s0 + w[(t - 7) as usize] + s1);
            w.push(nxt);
            t = t + 1;
        }

        let mut a: u64 = h0;
        let mut bv: u64 = h1;
        let mut c: u64 = h2;
        let mut d: u64 = h3;
        let mut e: u64 = h4;
        let mut f: u64 = h5;
        let mut g: u64 = h6;
        let mut hv: u64 = h7;

        t = 0;
        while t < 64 {
            let s1: u64 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch: u64 = (e & f) ^ ((m32(e ^ 4294967295)) & g);
            let t1: u64 = m32(hv + s1 + ch + sha256_k(t) + w[t as usize]);
            let s0: u64 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj: u64 = (a & bv) ^ (a & c) ^ (bv & c);
            let t2: u64 = m32(s0 + maj);
            hv = g;
            g = f;
            f = e;
            e = m32(d + t1);
            d = c;
            c = bv;
            bv = a;
            a = m32(t1 + t2);
            t = t + 1;
        }
        h0 = m32(h0 + a);
        h1 = m32(h1 + bv);
        h2 = m32(h2 + c);
        h3 = m32(h3 + d);
        h4 = m32(h4 + e);
        h5 = m32(h5 + f);
        h6 = m32(h6 + g);
        h7 = m32(h7 + hv);
        blk = blk + 1;
    }

    let mut out: Vec<u64> = Vec::new();
    out.push(h0); out.push(h1); out.push(h2); out.push(h3);
    out.push(h4); out.push(h5); out.push(h6); out.push(h7);
    return out;
}

fn push_ascii_tag(buf: &mut Vec<u64>, tag: i64, payload_id: i64) -> i64 {
    buf.push((65 + (tag % 26)) as u64);
    buf.push(58);
    buf.push((48 + ((payload_id / 10) % 10)) as u64);
    buf.push((48 + (payload_id % 10)) as u64);
    return 0;
}

fn hash_node(parent_h: &Vec<u64>, has_parent: i64, tag: i64, payload_id: i64) -> Vec<u64> {
    let mut msg: Vec<u64> = Vec::new();
    if has_parent == 1 {
        let mut i: i64 = 0;
        while i < 8 {
            let w: u64 = parent_h[i as usize];
            msg.push((w >> 24) & 255);
            msg.push((w >> 16) & 255);
            msg.push((w >> 8) & 255);
            msg.push(w & 255);
            i = i + 1;
        }
    }
    let _ = push_ascii_tag(&mut msg, tag, payload_id);
    return sha256_bytes(&msg);
}

fn hash_eq(a: &Vec<u64>, b: &Vec<u64>) -> i64 {
    let mut i: i64 = 0;
    while i < 8 {
        if a[i as usize] != b[i as usize] {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// Validate DAG acyclicity (Kahn algorithm) and root-ancestor reachability
// Returns 0 on valid DAG, -101 on orphan node, -102 on cycle
fn validate_provenance_dag(
    n: i64,
    kinds: &Vec<i64>,
    edge_u: &Vec<i64>,
    edge_v: &Vec<i64>
) -> i64 {
    let m: i64 = edge_u.len() as i64;
    let mut indeg: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < n {
        indeg.push(0);
        i = i + 1;
    }
    let mut e: i64 = 0;
    while e < m {
        let v: i64 = edge_v[e as usize];
        indeg[v as usize] = indeg[v as usize] + 1;
        e = e + 1;
    }

    // Any non-root node (kind != 0) with indeg == 0 is an orphan!
    i = 0;
    while i < n {
        if kinds[i as usize] != 0 && indeg[i as usize] == 0 {
            return -101;
        }
        i = i + 1;
    }

    // Kahn topological sort to detect cycles
    let mut queue: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        if indeg[i as usize] == 0 {
            queue.push(i);
        }
        i = i + 1;
    }
    let mut head: i64 = 0;
    let mut visited: i64 = 0;
    while head < (queue.len() as i64) {
        let u: i64 = queue[head as usize];
        head = head + 1;
        visited = visited + 1;
        e = 0;
        while e < m {
            if edge_u[e as usize] == u {
                let v: i64 = edge_v[e as usize];
                indeg[v as usize] = indeg[v as usize] - 1;
                if indeg[v as usize] == 0 {
                    queue.push(v);
                }
            }
            e = e + 1;
        }
    }
    if visited != n {
        return -102;
    }
    return 0;
}

fn main() -> i64 ~ Console {
    // Clean 4-stage provenance chain:
    // 0: source_sha256 (kind=0) -> 1: crop_bbox (kind=1) -> 2: quote_hash (kind=2) -> 3: claim_hash (kind=3)
    let empty: Vec<u64> = Vec::new();
    let h_src: Vec<u64> = hash_node(&empty, 0, 18, 1);
    let h_crop: Vec<u64> = hash_node(&h_src, 1, 2, 11);
    let h_quote: Vec<u64> = hash_node(&h_crop, 1, 16, 22);
    let h_claim: Vec<u64> = hash_node(&h_quote, 1, 3, 33);

    // Re-derive independently from root to verify cryptographic chain
    let h_claim_check: Vec<u64> = hash_node(
        &hash_node(&hash_node(&h_src, 1, 2, 11), 1, 16, 22),
        1, 3, 33
    );
    let chain_ok: i64 = hash_eq(&h_claim, &h_claim_check);

    let mut kinds: Vec<i64> = Vec::new();
    kinds.push(0); kinds.push(1); kinds.push(2); kinds.push(3);
    let mut eu: Vec<i64> = Vec::new();
    let mut ev: Vec<i64> = Vec::new();
    eu.push(0); ev.push(1);
    eu.push(1); ev.push(2);
    eu.push(2); ev.push(3);
    let clean_rc: i64 = validate_provenance_dag(4, &kinds, &eu, &ev);

    // Planted control 1: orphan claim node (node 4, kind=3, no parent edge) -> -101
    let mut kinds_o: Vec<i64> = Vec::new();
    kinds_o.push(0); kinds_o.push(1); kinds_o.push(2); kinds_o.push(3); kinds_o.push(3);
    let orphan_rc: i64 = validate_provenance_dag(5, &kinds_o, &eu, &ev);

    // Planted control 2: cyclic provenance edge (3 -> 1) -> -102
    let mut eu_c: Vec<i64> = Vec::new();
    let mut ev_c: Vec<i64> = Vec::new();
    eu_c.push(0); ev_c.push(1);
    eu_c.push(1); ev_c.push(2);
    eu_c.push(2); ev_c.push(3);
    eu_c.push(3); ev_c.push(1);
    let cycle_rc: i64 = validate_provenance_dag(4, &kinds, &eu_c, &ev_c);

    println!(
        "CLAIM_SHA256_H0H1={:08x}{:08x} chain_ok={} clean_rc={}",
        h_claim[0], h_claim[1], chain_ok, clean_rc
    );
    println!(
        "PLANTED_CONTROLS orphan_rc={} cycle_rc={}",
        orphan_rc, cycle_rc
    );

    if chain_ok == 1 && clean_rc == 0 && orphan_rc == -101 && cycle_rc == -102 {
        println!(
            "[PASS] N32_GATHER_REFIT_GRAPH h0={:08x} h7={:08x} orphan_caught=1 cycle_caught=1",
            h_claim[0], h_claim[7]
        );
        return 0;
    }
    println!("[FAIL] N32_GATHER_REFIT_GRAPH");
    return 1;
}
