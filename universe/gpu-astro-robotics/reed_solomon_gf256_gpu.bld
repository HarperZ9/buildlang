// Astro-Robotics GPU 440-Pack: GF(2^8) Reed-Solomon syndrome and erasure parity kernel.
// Performs Russian-peasant multiplication over GF(2^8) modulo AES/RS primitive polynomial
// 0x11d (285) across four data symbols to emit two parity syndromes S0 and S1.

#[compute(workgroup_size = [64, 1, 1])]
fn reed_solomon_gf256_gpu(
    alpha: u32,
    poly: u32,
    d0_buf: &[u32],
    d1_buf: &[u32],
    d2_buf: &[u32],
    d3_buf: &[u32],
    s0_out: &mut [u32],
    s1_out: &mut [u32],
) ~ Gpu {
    let i = gl_GlobalInvocationID.x;
    let d0: u32 = d0_buf[i] & 255;
    let d1: u32 = d1_buf[i] & 255;
    let d2: u32 = d2_buf[i] & 255;
    let d3: u32 = d3_buf[i] & 255;

    let s0: u32 = d0 ^ d1 ^ d2 ^ d3;

    // Horner evaluation S1 = (((d3 * alpha ^ d2) * alpha ^ d1) * alpha ^ d0) in GF(2^8)
    let mut acc: u32 = d3;
    let mut step: i32 = 0;
    while step < 3 {
        let mut a: u32 = acc;
        let mut b: u32 = alpha & 255;
        let mut p: u32 = 0;
        let mut bit: i32 = 0;
        while bit < 8 {
            if (b & 1) != 0 {
                p = p ^ a;
            }
            let hi: u32 = a & 128;
            a = (a << 1) & 255;
            if hi != 0 {
                a = a ^ (poly & 255);
            }
            b = b >> 1;
            bit = bit + 1;
        }
        if step == 0 {
            acc = p ^ d2;
        }
        if step == 1 {
            acc = p ^ d1;
        }
        if step == 2 {
            acc = p ^ d0;
        }
        step = step + 1;
    }

    s0_out[i] = s0;
    s1_out[i] = acc;
}
