// Wave 50H - Author Idea N05: Space Geodesy Parker-Oldenburg Gravity Bathymetry Inversion
// Recovers a planted 1,500 m Gaussian seamount beneath 4,000 m ocean from noisy satellite
// altimetry geoid-gradient / gravity-anomaly grid (32x32, 5 km spacing) within 50 m RMS
// depth error via 2D FFT downward continuation + Parker nonlinear series + Wiener filter.
// Planted Control: unregularized downward continuation (W=1) blows up on high-freq noise.

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn wrap_pi(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let two_pi: f64 = 6.28318530717958647692;
    let mut y: f64 = x;
    while y > pi {
        y = y - two_pi;
    }
    while y < -pi {
        y = y + two_pi;
    }
    y
}

fn det_sin_poly(y: f64) -> f64 {
    let y2: f64 = y * y;
    let t7: f64 = 1.6059043836821613e-10 - y2 * 7.647163731819816e-13;
    let t6: f64 = 2.505210838544172e-8 - y2 * t7;
    let t5: f64 = 2.7557319223985893e-6 - y2 * t6;
    let t4: f64 = 1.984126984126984e-4 - y2 * t5;
    let t3: f64 = 8.333333333333333e-3 - y2 * t4;
    let t2: f64 = 1.6666666666666666e-1 - y2 * t3;
    y * (1.0 - y2 * t2)
}

fn det_cos_poly(y: f64) -> f64 {
    let y2: f64 = y * y;
    let t7: f64 = 2.08767569878681e-9 - y2 * 1.1470745597729725e-11;
    let t6: f64 = 2.7557319223985893e-7 - y2 * t7;
    let t5: f64 = 2.48015873015873e-5 - y2 * t6;
    let t4: f64 = 1.388888888888889e-3 - y2 * t5;
    let t3: f64 = 4.1666666666666664e-2 - y2 * t4;
    let t2: f64 = 0.5 - y2 * t3;
    1.0 - y2 * t2
}

fn det_sin(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let half_pi: f64 = 1.57079632679489661923;
    let q_pi: f64 = 0.78539816339744830962;
    let mut y: f64 = wrap_pi(x);
    let mut sign: f64 = 1.0;
    if y < 0.0 {
        y = -y;
        sign = -1.0;
    }
    if y > half_pi {
        y = pi - y;
    }
    if y <= q_pi { sign * det_sin_poly(y) } else { sign * det_cos_poly(half_pi - y) }
}

fn det_cos(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let half_pi: f64 = 1.57079632679489661923;
    let q_pi: f64 = 0.78539816339744830962;
    let mut y: f64 = abs_f64(wrap_pi(x));
    let mut sign: f64 = 1.0;
    if y > half_pi {
        y = pi - y;
        sign = -1.0;
    }
    if y <= q_pi { sign * det_cos_poly(y) } else { sign * det_sin_poly(half_pi - y) }
}

fn det_exp(x: f64) -> f64 {
    if x < -50.0 {
        return 0.0;
    }
    let u: f64 = x / 128.0;
    let p6: f64 = 1.388888888888889e-3 + u * 1.984126984126984e-4;
    let p5: f64 = 8.333333333333333e-3 + u * p6;
    let p4: f64 = 4.1666666666666664e-2 + u * p5;
    let mut t: f64 = 1.0 + u * (1.0 + u * (0.5 + u * (0.16666666666666666 + u * p4)));
    let mut i: i32 = 0;
    while i < 7 {
        t = t * t;
        i = i + 1;
    }
    t
}

fn det_sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    let mut g: f64 = x;
    if g < 1.0 {
        g = 1.0;
    }
    let mut i: i32 = 0;
    while i < 24 {
        g = 0.5 * (g + x / g);
        i = i + 1;
    }
    g
}

// 1D radix-2 Cooley-Tukey FFT on length n=32 (sign = -1 forward, +1 inverse)
fn fft1d_32(re: &mut Vec<f64>, im: &mut Vec<f64>, offset: usize, stride: usize, inv: bool) {
    let n: usize = 32;
    // Bit-reversal permutation for n=32 (5 bits)
    let mut i: usize = 0;
    while i < n {
        let mut rev: usize = 0;
        let mut b: usize = 0;
        let mut tmp: usize = i;
        while b < 5 {
            rev = (rev << 1) | (tmp & 1);
            tmp = tmp >> 1;
            b = b + 1;
        }
        if i < rev {
            let idx_i: usize = offset + i * stride;
            let idx_r: usize = offset + rev * stride;
            let tr: f64 = re[idx_i];
            let ti: f64 = im[idx_i];
            re[idx_i] = re[idx_r];
            im[idx_i] = im[idx_r];
            re[idx_r] = tr;
            im[idx_r] = ti;
        }
        i = i + 1;
    }

    let two_pi: f64 = 6.28318530717958647692;
    let sign: f64 = if inv { 1.0 } else { -1.0 };
    let mut len: usize = 2;
    while len <= n {
        let half: usize = len / 2;
        let ang_step: f64 = sign * two_pi / (len as f64);
        let mut start: usize = 0;
        while start < n {
            let mut k: usize = 0;
            while k < half {
                let ang: f64 = ang_step * (k as f64);
                let wr: f64 = det_cos(ang);
                let wi: f64 = det_sin(ang);
                let u_idx: usize = offset + (start + k) * stride;
                let v_idx: usize = offset + (start + k + half) * stride;
                let ur: f64 = re[u_idx];
                let ui: f64 = im[u_idx];
                let vr: f64 = re[v_idx] * wr - im[v_idx] * wi;
                let vi: f64 = re[v_idx] * wi + im[v_idx] * wr;
                re[u_idx] = ur + vr;
                im[u_idx] = ui + vi;
                re[v_idx] = ur - vr;
                im[v_idx] = ui - vi;
                k = k + 1;
            }
            start = start + len;
        }
        len = len * 2;
    }

    if inv {
        let inv_n: f64 = 1.0 / (n as f64);
        let mut k: usize = 0;
        while k < n {
            let idx: usize = offset + k * stride;
            re[idx] = re[idx] * inv_n;
            im[idx] = im[idx] * inv_n;
            k = k + 1;
        }
    }
}

fn fft2d_32(re: &mut Vec<f64>, im: &mut Vec<f64>, inv: bool) {
    let mut r: usize = 0;
    while r < 32 {
        fft1d_32(re, im, r * 32, 1, inv);
        r = r + 1;
    }
    let mut c: usize = 0;
    while c < 32 {
        fft1d_32(re, im, c, 32, inv);
        c = c + 1;
    }
}

fn k_mag_2d(kx_i: usize, ky_i: usize, l_box: f64) -> f64 {
    let two_pi: f64 = 6.28318530717958647692;
    let fx: f64 = if kx_i <= 16 { kx_i as f64 } else { (kx_i as f64) - 32.0 };
    let fy: f64 = if ky_i <= 16 { ky_i as f64 } else { (ky_i as f64) - 32.0 };
    let kx: f64 = two_pi * fx / l_box;
    let ky: f64 = two_pi * fy / l_box;
    det_sqrt(kx * kx + ky * ky)
}

fn lcg_next(state: i64) -> i64 {
    let m: i64 = 2147483647;
    let nxt: i64 = (state * 48271) % m;
    if nxt <= 0 { nxt + m } else { nxt }
}

struct RngGauss {
    val: f64,
    state: i64,
}

fn next_gauss(seed: i64) -> RngGauss {
    let mut st: i64 = seed;
    let mut acc: f64 = 0.0;
    let mut k: i32 = 0;
    while k < 6 {
        st = lcg_next(st);
        let u: f64 = (st as f64) / 2147483647.0;
        acc = acc + (2.0 * u - 1.0);
        k = k + 1;
    }
    RngGauss { val: acc * 0.7071067811865475, state: st }
}

fn invert_parker_oldenburg(
    dg_obs_re: &Vec<f64>,
    dg_obs_im: &Vec<f64>,
    z0: f64,
    l_box: f64,
    c_grav: f64,
    regularize: bool,
) -> Vec<f64> {
    let n2: usize = 1024;
    let mut h_est: Vec<f64> = vec![0.0; n2];
    let n_iter: i32 = if regularize { 5 } else { 1 };

    let mut it: i32 = 0;
    while it < n_iter {
        // Compute F[h^2] and F[h^3] for Parker nonlinear correction terms
        let mut h2_re: Vec<f64> = vec![0.0; n2];
        let mut h2_im: Vec<f64> = vec![0.0; n2];
        let mut h3_re: Vec<f64> = vec![0.0; n2];
        let mut h3_im: Vec<f64> = vec![0.0; n2];
        let mut idx: usize = 0;
        while idx < n2 {
            let hv: f64 = h_est[idx];
            h2_re[idx] = hv * hv;
            h3_re[idx] = hv * hv * hv;
            idx = idx + 1;
        }
        fft2d_32(&mut h2_re, &mut h2_im, false);
        fft2d_32(&mut h3_re, &mut h3_im, false);

        let mut next_re: Vec<f64> = vec![0.0; n2];
        let mut next_im: Vec<f64> = vec![0.0; n2];
        let mut ky: usize = 0;
        while ky < 32 {
            let mut kx: usize = 0;
            while kx < 32 {
                let k: f64 = k_mag_2d(kx, ky, l_box);
                let id: usize = ky * 32 + kx;
                let up: f64 = det_exp(k * z0);
                // Wiener low-pass downward-continuation stabilizer
                let w: f64 = if regularize {
                    let kz: f64 = k * z0;
                    let pen: f64 = 0.008 * up * up * kz * kz * kz * kz;
                    1.0 / (1.0 + pen)
                } else {
                    1.0
                };
                let lin_re: f64 = (dg_obs_re[id] * up) / c_grav;
                let lin_im: f64 = (dg_obs_im[id] * up) / c_grav;
                let nl_re: f64 = 0.5 * k * h2_re[id] + (k * k / 6.0) * h3_re[id];
                let nl_im: f64 = 0.5 * k * h2_im[id] + (k * k / 6.0) * h3_im[id];
                next_re[id] = w * (lin_re - nl_re);
                next_im[id] = w * (lin_im - nl_im);
                kx = kx + 1;
            }
            ky = ky + 1;
        }
        fft2d_32(&mut next_re, &mut next_im, true);
        h_est = next_re;
        it = it + 1;
    }
    h_est
}

fn main() ~ Clock + Console {
    let mut failures: i32 = 0;
    let t0_ns: i64 = clock_ns();

    let n: usize = 32;
    let n2: usize = 1024;
    let dx: f64 = 5000.0;
    let l_box: f64 = (n as f64) * dx; // 160 km
    let z0: f64 = 4000.0;
    let g_const: f64 = 6.67430e-11;
    let delta_rho: f64 = 1770.0; // basalt 2800 - seawater 1030 kg/m^3
    let two_pi: f64 = 6.28318530717958647692;
    let c_grav: f64 = two_pi * g_const * delta_rho;

    // 1. Build planted 1,500 m Gaussian seamount (sigma = 14 km) beneath 4,000 m ocean
    let mut h_true: Vec<f64> = vec![0.0; n2];
    let sigma: f64 = 14000.0;
    let mut y: usize = 0;
    while y < n {
        let mut x: usize = 0;
        while x < n {
            let rx: f64 = ((x as f64) - 16.0) * dx;
            let ry: f64 = ((y as f64) - 16.0) * dx;
            let r2: f64 = rx * rx + ry * ry;
            h_true[y * n + x] = 1500.0 * det_exp(-r2 / (2.0 * sigma * sigma));
            x = x + 1;
        }
        y = y + 1;
    }

    // 2. Exact 3-term nonlinear Parker forward gravity + noisy satellite altimetry geoid gradient
    let mut h1_re: Vec<f64> = vec![0.0; n2];
    let mut h1_im: Vec<f64> = vec![0.0; n2];
    let mut h2_re: Vec<f64> = vec![0.0; n2];
    let mut h2_im: Vec<f64> = vec![0.0; n2];
    let mut h3_re: Vec<f64> = vec![0.0; n2];
    let mut h3_im: Vec<f64> = vec![0.0; n2];
    let mut i: usize = 0;
    while i < n2 {
        let hv: f64 = h_true[i];
        h1_re[i] = hv;
        h2_re[i] = hv * hv;
        h3_re[i] = hv * hv * hv;
        i = i + 1;
    }
    fft2d_32(&mut h1_re, &mut h1_im, false);
    fft2d_32(&mut h2_re, &mut h2_im, false);
    fft2d_32(&mut h3_re, &mut h3_im, false);

    let mut dg_re: Vec<f64> = vec![0.0; n2];
    let mut dg_im: Vec<f64> = vec![0.0; n2];
    let mut ky: usize = 0;
    while ky < n {
        let mut kx: usize = 0;
        while kx < n {
            let k: f64 = k_mag_2d(kx, ky, l_box);
            let id: usize = ky * n + kx;
            let att: f64 = c_grav * det_exp(-k * z0);
            dg_re[id] = att * (h1_re[id] + 0.5 * k * h2_re[id] + (k * k / 6.0) * h3_re[id]);
            dg_im[id] = att * (h1_im[id] + 0.5 * k * h2_im[id] + (k * k / 6.0) * h3_im[id]);
            kx = kx + 1;
        }
        ky = ky + 1;
    }
    fft2d_32(&mut dg_re, &mut dg_im, true);

    // Add realistic 1.5 mGal (1.5e-5 m/s^2) satellite altimetry gravity noise
    let mut rng: i64 = 987654321;
    let noise_std: f64 = 1.5e-5;
    i = 0;
    while i < n2 {
        let g: RngGauss = next_gauss(rng);
        rng = g.state;
        dg_re[i] = dg_re[i] + noise_std * g.val;
        dg_im[i] = 0.0;
        i = i + 1;
    }
    fft2d_32(&mut dg_re, &mut dg_im, false);

    // 3. Regularized Parker-Oldenburg Inversion
    let h_rec: Vec<f64> = invert_parker_oldenburg(&dg_re, &dg_im, z0, l_box, c_grav, true);
    let mut sq_err: f64 = 0.0;
    let mut peak_rec: f64 = 0.0;
    let mut checksum: f64 = 0.0;
    i = 0;
    while i < n2 {
        let d: f64 = h_rec[i] - h_true[i];
        sq_err = sq_err + d * d;
        if h_rec[i] > peak_rec {
            peak_rec = h_rec[i];
        }
        checksum = checksum + h_rec[i];
        i = i + 1;
    }
    let rms_reg_m: f64 = det_sqrt(sq_err / (n2 as f64));

    if rms_reg_m < 50.0 && abs_f64(peak_rec - 1500.0) < 120.0 {
        println!(
            "[PASS] parker_oldenburg_seamount rms_err_m={:.4} peak_rec_m={:.4} true_peak_m=1500.0",
            rms_reg_m, peak_rec
        );
    } else {
        println!(
            "[FAIL] parker_oldenburg_seamount rms_err_m={:.4} peak_rec_m={:.4}",
            rms_reg_m, peak_rec
        );
        failures = failures + 1;
    }

    // 4. Planted Control: Unregularized Downward Continuation Must Blow Up on HF Noise
    let h_raw: Vec<f64> = invert_parker_oldenburg(&dg_re, &dg_im, z0, l_box, c_grav, false);
    let mut sq_raw: f64 = 0.0;
    i = 0;
    while i < n2 {
        let d: f64 = h_raw[i] - h_true[i];
        sq_raw = sq_raw + d * d;
        i = i + 1;
    }
    let rms_raw_m: f64 = det_sqrt(sq_raw / (n2 as f64));
    let blowup_x: f64 = rms_raw_m / rms_reg_m;

    if rms_raw_m > 150.0 && blowup_x > 5.0 {
        println!(
            "[PASS] planted_ctrl_unreg_blowup caught raw_rms_m={:.4} blowup={:.2}x",
            rms_raw_m, blowup_x
        );
    } else {
        println!(
            "[FAIL] planted_ctrl_unreg_blowup missed raw_rms_m={:.4} blowup={:.2}x",
            rms_raw_m, blowup_x
        );
        failures = failures + 1;
    }

    let elapsed_ms: f64 = ((clock_ns() - t0_ns) as f64) / 1.0e6;
    println!(
        "[METRICS_N05] elapsed_ms={:.4} rms_reg_m={:.9} checksum={:.9} failures={}",
        elapsed_ms, rms_reg_m, checksum, failures
    );
}
