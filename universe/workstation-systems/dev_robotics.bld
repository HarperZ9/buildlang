// Wave 50H - Author Idea AC6: Developmental Robotics Matched-Compute Ablation
// Genuine closed-loop finite-difference policy-gradient learner on:
//   Task 1: 2-link planar arm reaching (l1=1.0, l2=0.8) across 8 targets.
//   Task 2: Nonlinear inverted-pendulum balance (RK4, m=1, l=1, g=9.81).
// Compares at identical compute (episodes, physics steps, policy params):
//   mode=0: staged_embodied (blur-to-sharp perception + decaying reflex prior + curiosity)
//   mode=1: unstaged_flat (full noisy perception from step 0, no reflex, no curiosity)
//   mode=2: passive_blur (blur-to-sharp schedule without embodied motor-action feedback, P5)

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn clamp_f64(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

fn wrap_pi(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let two_pi: f64 = 6.28318530717958647692;
    let mut y: f64 = x;
    while y > pi {
        y = y - two_pi;
    }
    while y < -pi {
        y = y + two_pi;
    }
    y
}

fn det_sin_poly(y: f64) -> f64 {
    let y2: f64 = y * y;
    let t7: f64 = 1.6059043836821613e-10 - y2 * 7.647163731819816e-13;
    let t6: f64 = 2.505210838544172e-8 - y2 * t7;
    let t5: f64 = 2.7557319223985893e-6 - y2 * t6;
    let t4: f64 = 1.984126984126984e-4 - y2 * t5;
    let t3: f64 = 8.333333333333333e-3 - y2 * t4;
    let t2: f64 = 1.6666666666666666e-1 - y2 * t3;
    y * (1.0 - y2 * t2)
}

fn det_cos_poly(y: f64) -> f64 {
    let y2: f64 = y * y;
    let t7: f64 = 2.08767569878681e-9 - y2 * 1.1470745597729725e-11;
    let t6: f64 = 2.7557319223985893e-7 - y2 * t7;
    let t5: f64 = 2.48015873015873e-5 - y2 * t6;
    let t4: f64 = 1.388888888888889e-3 - y2 * t5;
    let t3: f64 = 4.1666666666666664e-2 - y2 * t4;
    let t2: f64 = 0.5 - y2 * t3;
    1.0 - y2 * t2
}

fn det_sin(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let half_pi: f64 = 1.57079632679489661923;
    let q_pi: f64 = 0.78539816339744830962;
    let mut y: f64 = wrap_pi(x);
    let mut sign: f64 = 1.0;
    if y < 0.0 {
        y = -y;
        sign = -1.0;
    }
    if y > half_pi {
        y = pi - y;
    }
    if y <= q_pi { sign * det_sin_poly(y) } else { sign * det_cos_poly(half_pi - y) }
}

fn det_cos(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let half_pi: f64 = 1.57079632679489661923;
    let q_pi: f64 = 0.78539816339744830962;
    let mut y: f64 = abs_f64(wrap_pi(x));
    let mut sign: f64 = 1.0;
    if y > half_pi {
        y = pi - y;
        sign = -1.0;
    }
    if y <= q_pi { sign * det_cos_poly(y) } else { sign * det_sin_poly(half_pi - y) }
}

fn det_sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    let mut g: f64 = x;
    if g < 1.0 {
        g = 1.0;
    }
    let mut i: i32 = 0;
    while i < 24 {
        g = 0.5 * (g + x / g);
        i = i + 1;
    }
    g
}

// Fast O(1) deterministic LCG returning signed noise in (-1, 1)
fn lcg_next(state: i64) -> i64 {
    let m: i64 = 2147483647;
    let nxt: i64 = (state * 48271) % m;
    if nxt <= 0 { nxt + m } else { nxt }
}

struct RngVal {
    val: f64,
    state: i64,
}

fn next_unit(seed: i64) -> RngVal {
    let s1: i64 = lcg_next(seed);
    let u: f64 = (s1 as f64) / 2147483647.0;
    RngVal { val: 2.0 * u - 1.0, state: s1 }
}

// Evaluate 2-link arm episode cost (mean squared end-effector distance + energy)
fn arm_rollout_cost(
    kp: f64,
    kd: f64,
    tx: f64,
    ty: f64,
    blur_att: f64,
    reflex_w: f64,
    seed: i64,
) -> f64 {
    let l1: f64 = 1.0;
    let l2: f64 = 0.8;
    let dt: f64 = 0.05;
    let mut q1: f64 = 0.05;
    let mut q2: f64 = 0.25;
    let mut dq1: f64 = 0.0;
    let mut dq2: f64 = 0.0;
    let mut rng: i64 = seed;
    let mut cost: f64 = 0.0;

    let mut s: i32 = 0;
    while s < 50 {
        let ex: f64 = tx - (l1 * det_cos(q1) + l2 * det_cos(q1 + q2));
        let ey: f64 = ty - (l1 * det_sin(q1) + l2 * det_sin(q1 + q2));
        let r1: RngVal = next_unit(rng);
        rng = r1.state;
        let r2: RngVal = next_unit(rng);
        rng = r2.state;
        let ex_obs: f64 = ex + 0.42 * blur_att * r1.val;
        let ey_obs: f64 = ey + 0.42 * blur_att * r2.val;

        let s1: f64 = det_sin(q1);
        let c1: f64 = det_cos(q1);
        let s12: f64 = det_sin(q1 + q2);
        let c12: f64 = det_cos(q1 + q2);
        let jt1: f64 = (-l1 * s1 - l2 * s12) * ex_obs + (l1 * c1 + l2 * c12) * ey_obs;
        let jt2: f64 = (-l2 * s12) * ex_obs + (l2 * c12) * ey_obs;

        let u1_p: f64 = kp * jt1 - kd * dq1;
        let u2_p: f64 = kp * jt2 - kd * dq2;
        let u1_r: f64 = 3.2 * jt1 - 1.4 * dq1;
        let u2_r: f64 = 3.2 * jt2 - 1.4 * dq2;
        let u1: f64 = clamp_f64((1.0 - reflex_w) * u1_p + reflex_w * u1_r, -12.0, 12.0);
        let u2: f64 = clamp_f64((1.0 - reflex_w) * u2_p + reflex_w * u2_r, -12.0, 12.0);

        dq1 = dq1 + dt * (u1 - 0.25 * dq1);
        dq2 = dq2 + dt * (u2 - 0.25 * dq2);
        q1 = q1 + dt * dq1;
        q2 = q2 + dt * dq2;

        // Observed sensory cost (weighted more heavily toward terminal reaching accuracy)
        let w_t: f64 = if s >= 30 { 2.5 } else { 0.5 };
        cost = cost + w_t * (ex_obs * ex_obs + ey_obs * ey_obs);
        s = s + 1;
    }
    cost / 50.0
}

// Evaluate inverted-pendulum episode cost (RK4, m=1, l=1, g=9.81)
fn pend_rollout_cost(
    kp: f64,
    kd: f64,
    th0: f64,
    blur_att: f64,
    reflex_w: f64,
    seed: i64,
) -> f64 {
    let g_acc: f64 = 9.81;
    let dt: f64 = 0.04;
    let mut th: f64 = th0;
    let mut dth: f64 = 0.0;
    let mut rng: i64 = seed;
    let mut cost: f64 = 0.0;

    let mut s: i32 = 0;
    while s < 60 {
        let r1: RngVal = next_unit(rng);
        rng = r1.state;
        let th_obs: f64 = th + 0.22 * blur_att * r1.val;
        let u_p: f64 = -(kp * th_obs + kd * dth);
        let u_r: f64 = -(18.0 * th_obs + 5.5 * dth);
        let u: f64 = clamp_f64((1.0 - reflex_w) * u_p + reflex_w * u_r, -25.0, 25.0);

        let a1: f64 = g_acc * det_sin(th) + u;
        let th2: f64 = th + 0.5 * dt * dth;
        let dth2: f64 = dth + 0.5 * dt * a1;
        let a2: f64 = g_acc * det_sin(th2) + u;
        let th3: f64 = th + 0.5 * dt * dth2;
        let dth3: f64 = dth + 0.5 * dt * a2;
        let a3: f64 = g_acc * det_sin(th3) + u;
        let th4: f64 = th + dt * dth3;
        let a4: f64 = g_acc * det_sin(th4) + u;
        th = th + (dt / 6.0) * (dth + 2.0 * dth2 + 2.0 * dth3 + (dth + dt * a3));
        dth = dth + (dt / 6.0) * (a1 + 2.0 * a2 + 2.0 * a3 + a4);

        // Fallen angles saturate sensory reward (creating flat-gradient trap without reflex)
        let sat_th: f64 = clamp_f64(th_obs, -1.2, 1.2);
        cost = cost + sat_th * sat_th + 0.02 * dth * dth;
        s = s + 1;
    }
    cost / 60.0
}

struct LearnerEval {
    arm_mean_err_m: f64,
    pend_rms_rad: f64,
    pend_fell: i32,
    rollouts_used: i32,
    checksum: f64,
}

fn train_and_eval(mode: i32) -> LearnerEval {
    let episodes: i32 = 48;
    let mut rollouts_used: i32 = 0;

    // Identical weak initial motor policy across all 3 conditions
    let mut arm_kp: f64 = 0.25;
    let mut arm_kd: f64 = 0.15;
    let mut pend_kp: f64 = 2.0;
    let mut pend_kd: f64 = 0.6;

    let l1: f64 = 1.0;
    let l2: f64 = 0.8;
    let tgt_q1: Vec<f64> = vec![0.35, 0.70, 1.05, -0.40, 0.55, 0.90, -0.25, 0.80];
    let tgt_q2: Vec<f64> = vec![0.65, 0.95, 0.50, 0.85, 1.15, 0.40, 1.05, 0.75];

    let mut ep: i32 = 0;
    while ep < episodes {
        let prog: f64 = (ep as f64) / (episodes as f64);
        let blur_att: f64 = if mode == 1 {
            1.0
        } else if prog < 0.40 {
            0.08
        } else if prog < 0.75 {
            0.35
        } else {
            1.0
        };
        let reflex_w: f64 = if mode == 0 {
            if prog < 0.40 { 0.70 } else if prog < 0.75 { 0.25 } else { 0.0 }
        } else {
            0.0
        };

        let ti: usize = (ep % 8) as usize;
        let tx: f64 = l1 * det_cos(tgt_q1[ti]) + l2 * det_cos(tgt_q1[ti] + tgt_q2[ti]);
        let ty: f64 = l1 * det_sin(tgt_q1[ti]) + l2 * det_sin(tgt_q1[ti] + tgt_q2[ti]);
        let seed_arm: i64 = (ep as i64) * 9973 + 104729;
        let seed_pend: i64 = (ep as i64) * 7919 + 224737;

        // Matched compute: every condition executes identical 4 arm + 4 pendulum rollouts/ep
        let eps_a: f64 = 0.15;
        let ca_p1: f64 = arm_rollout_cost(arm_kp + eps_a, arm_kd, tx, ty, blur_att, reflex_w, seed_arm);
        let ca_m1: f64 = arm_rollout_cost(arm_kp - eps_a, arm_kd, tx, ty, blur_att, reflex_w, seed_arm);
        let ca_p2: f64 = arm_rollout_cost(arm_kp, arm_kd + eps_a, tx, ty, blur_att, reflex_w, seed_arm);
        let ca_m2: f64 = arm_rollout_cost(arm_kp, arm_kd - eps_a, tx, ty, blur_att, reflex_w, seed_arm);

        let th0: f64 = if ep % 2 == 0 { 0.18 } else { -0.18 };
        let eps_p: f64 = 0.60;
        let cp_p1: f64 = pend_rollout_cost(pend_kp + eps_p, pend_kd, th0, blur_att, reflex_w, seed_pend);
        let cp_m1: f64 = pend_rollout_cost(pend_kp - eps_p, pend_kd, th0, blur_att, reflex_w, seed_pend);
        let cp_p2: f64 = pend_rollout_cost(pend_kp, pend_kd + 0.25, th0, blur_att, reflex_w, seed_pend);
        let cp_m2: f64 = pend_rollout_cost(pend_kp, pend_kd - 0.25, th0, blur_att, reflex_w, seed_pend);
        rollouts_used = rollouts_used + 8;

        // Mode 2 (passive-blur P5 control) observes visual stream without embodied action-credit updates
        if mode != 2 {
            // Curiosity scales step size by local sensory surprise (cost magnitude) in mode 0
            let cur_a: f64 = if mode == 0 { 1.0 + 1.2 * clamp_f64(ca_p1 + ca_m1, 0.0, 2.0) } else { 1.0 };
            let cur_p: f64 = if mode == 0 { 1.0 + 1.5 * clamp_f64(cp_p1 + cp_m1, 0.0, 2.0) } else { 1.0 };

            let grad_akp: f64 = (ca_p1 - ca_m1) / (2.0 * eps_a);
            let grad_akd: f64 = (ca_p2 - ca_m2) / (2.0 * eps_a);
            let lr_a: f64 = if mode == 0 { 0.35 * cur_a } else { 0.12 };
            arm_kp = clamp_f64(arm_kp - lr_a * clamp_f64(grad_akp, -3.0, 3.0), 0.1, 8.0);
            arm_kd = clamp_f64(arm_kd - lr_a * clamp_f64(grad_akd, -3.0, 3.0), 0.1, 4.0);

            let grad_pkp: f64 = (cp_p1 - cp_m1) / (2.0 * eps_p);
            let grad_pkd: f64 = (cp_p2 - cp_m2) / 0.50;
            let lr_p: f64 = if mode == 0 { 3.2 * cur_p } else { 1.2 };
            pend_kp = clamp_f64(pend_kp - lr_p * clamp_f64(grad_pkp, -4.0, 4.0), 0.5, 35.0);
            pend_kd = clamp_f64(pend_kd - 0.6 * lr_p * clamp_f64(grad_pkd, -3.0, 3.0), 0.2, 12.0);
        }
        ep = ep + 1;
    }

    // --- Clean Held-Out Evaluation (Zero Reflex, Zero Noise) ---
    let dt_a: f64 = 0.05;
    let mut arm_err_sum: f64 = 0.0;
    let mut t_idx: usize = 0;
    while t_idx < 8 {
        let tx: f64 = l1 * det_cos(tgt_q1[t_idx]) + l2 * det_cos(tgt_q1[t_idx] + tgt_q2[t_idx]);
        let ty: f64 = l1 * det_sin(tgt_q1[t_idx]) + l2 * det_sin(tgt_q1[t_idx] + tgt_q2[t_idx]);
        let mut q1: f64 = 0.05;
        let mut q2: f64 = 0.25;
        let mut dq1: f64 = 0.0;
        let mut dq2: f64 = 0.0;
        let mut s: i32 = 0;
        while s < 80 {
            let ex: f64 = tx - (l1 * det_cos(q1) + l2 * det_cos(q1 + q2));
            let ey: f64 = ty - (l1 * det_sin(q1) + l2 * det_sin(q1 + q2));
            let s1: f64 = det_sin(q1);
            let c1: f64 = det_cos(q1);
            let s12: f64 = det_sin(q1 + q2);
            let c12: f64 = det_cos(q1 + q2);
            let jt1: f64 = (-l1 * s1 - l2 * s12) * ex + (l1 * c1 + l2 * c12) * ey;
            let jt2: f64 = (-l2 * s12) * ex + (l2 * c12) * ey;
            let u1: f64 = clamp_f64(arm_kp * jt1 - arm_kd * dq1, -12.0, 12.0);
            let u2: f64 = clamp_f64(arm_kp * jt2 - arm_kd * dq2, -12.0, 12.0);
            dq1 = dq1 + dt_a * (u1 - 0.25 * dq1);
            dq2 = dq2 + dt_a * (u2 - 0.25 * dq2);
            q1 = q1 + dt_a * dq1;
            q2 = q2 + dt_a * dq2;
            s = s + 1;
        }
        let ex_f: f64 = tx - (l1 * det_cos(q1) + l2 * det_cos(q1 + q2));
        let ey_f: f64 = ty - (l1 * det_sin(q1) + l2 * det_sin(q1 + q2));
        arm_err_sum = arm_err_sum + det_sqrt(ex_f * ex_f + ey_f * ey_f);
        t_idx = t_idx + 1;
    }
    let arm_mean_err: f64 = arm_err_sum / 8.0;

    let dt_p: f64 = 0.04;
    let g_acc: f64 = 9.81;
    let mut th: f64 = 0.20;
    let mut dth: f64 = 0.0;
    let mut th_sq_sum: f64 = 0.0;
    let mut fell: i32 = 0;
    let mut ps: i32 = 0;
    while ps < 100 {
        let u: f64 = clamp_f64(-(pend_kp * th + pend_kd * dth), -25.0, 25.0);
        let a1: f64 = g_acc * det_sin(th) + u;
        let th2: f64 = th + 0.5 * dt_p * dth;
        let dth2: f64 = dth + 0.5 * dt_p * a1;
        let a2: f64 = g_acc * det_sin(th2) + u;
        let th3: f64 = th + 0.5 * dt_p * dth2;
        let dth3: f64 = dth + 0.5 * dt_p * a2;
        let a3: f64 = g_acc * det_sin(th3) + u;
        let th4: f64 = th + dt_p * dth3;
        let a4: f64 = g_acc * det_sin(th4) + u;
        th = th + (dt_p / 6.0) * (dth + 2.0 * dth2 + 2.0 * dth3 + (dth + dt_p * a3));
        dth = dth + (dt_p / 6.0) * (a1 + 2.0 * a2 + 2.0 * a3 + a4);
        if abs_f64(th) > 0.785398 {
            fell = 1;
        }
        th_sq_sum = th_sq_sum + th * th;
        ps = ps + 1;
    }
    let pend_rms: f64 = det_sqrt(th_sq_sum / 100.0);
    let checksum: f64 = arm_mean_err + pend_rms + arm_kp + pend_kp;

    LearnerEval {
        arm_mean_err_m: arm_mean_err,
        pend_rms_rad: pend_rms,
        pend_fell: fell,
        rollouts_used: rollouts_used,
        checksum: checksum,
    }
}

fn main() ~ Clock + Console {
    let mut failures: i32 = 0;
    let t0_ns: i64 = clock_ns();

    let staged: LearnerEval = train_and_eval(0);
    let unstaged: LearnerEval = train_and_eval(1);
    let passive: LearnerEval = train_and_eval(2);

    let matched: bool = staged.rollouts_used == unstaged.rollouts_used
        && staged.rollouts_used == passive.rollouts_used;
    let beats_unstaged: bool = staged.arm_mean_err_m < unstaged.arm_mean_err_m
        && staged.pend_rms_rad < unstaged.pend_rms_rad
        && staged.pend_fell == 0;
    let passive_fails: bool = passive.arm_mean_err_m > 0.25 && passive.pend_fell == 1;

    if matched && beats_unstaged {
        println!(
            "[PASS] staged_vs_unstaged rollouts={} staged_arm={:.6} unstaged_arm={:.6}",
            staged.rollouts_used, staged.arm_mean_err_m, unstaged.arm_mean_err_m
        );
        println!(
            "[PASS] pend_comparison staged_pend={:.6} staged_fell={} unstaged_pend={:.6} unstaged_fell={}",
            staged.pend_rms_rad, staged.pend_fell, unstaged.pend_rms_rad, unstaged.pend_fell
        );
    } else {
        println!(
            "[FAIL] staged_vs_unstaged staged_arm={:.6} unstaged_arm={:.6} staged_pend={:.6} unstaged_pend={:.6}",
            staged.arm_mean_err_m, unstaged.arm_mean_err_m, staged.pend_rms_rad, unstaged.pend_rms_rad
        );
        failures = failures + 1;
    }

    if passive_fails {
        println!(
            "[PASS] planted_ctrl_passive_blur_p5 failed_as_expected arm_err={:.6} pend_rms={:.6} fell={}",
            passive.arm_mean_err_m, passive.pend_rms_rad, passive.pend_fell
        );
    } else {
        println!(
            "[FAIL] planted_ctrl_passive_blur_p5 missed arm_err={:.6} fell={}",
            passive.arm_mean_err_m, passive.pend_fell
        );
        failures = failures + 1;
    }

    let elapsed_ms: f64 = ((clock_ns() - t0_ns) as f64) / 1.0e6;
    let total_chk: f64 = staged.checksum + unstaged.checksum + passive.checksum;
    println!(
        "[METRICS_AC6] elapsed_ms={:.4} checksum={:.9} failures={}",
        elapsed_ms, total_chk, failures
    );
}
