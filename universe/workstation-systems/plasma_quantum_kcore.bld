// Wave 50G (P2 Author Idea N12): Non-Critical Open Plasma & Quantum Physics Kernels (plasma_quantum_kcore.bld)
// Strictly non-critical open textbook physics:
// 1. Solovev / Grad-Shafranov tokamak magnetic-flux equilibrium (4th-order FD residual < 1e-8)
// 2. WKB Gamow alpha-decay Coulomb-barrier tunneling reproducing Geiger-Nuttall log10(T1/2)
//    across 10 textbook even-even alpha emitters (R^2 > 0.98)
// 3. Casimir parallel-plate force F/A = -pi^2 * hbar * c / (240 * d^4) to < 1e-8
// 4. Planted failing controls: wrong-sign Casimir force + inverted WKB barrier caught fail-closed

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    x
}

fn cbrt_pos(x: f64) -> f64 {
    exp(log(x) / 3.0)
}

fn acos_unit(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846264338327950288;
    if x >= 1.0 { return 0.0; }
    if x <= -1.0 { return pi; }
    let s: f64 = sqrt(1.0 - x * x);
    if x > 0.0 {
        return atan(s / x);
    }
    if x < 0.0 {
        return pi + atan(s / x);
    }
    0.5 * pi
}

// Solovev exact Grad-Shafranov poloidal flux psi(R, Z)
// Delta* psi = d^2psi/dR^2 - (1/R) dpsi/dR + d^2psi/dZ^2 = (psi0 / R0^4) * (R^2 + R0^2 / kappa^2)
fn solovev_psi(r: f64, z: f64, r0: f64, kappa: f64, delta_s: f64, psi0: f64) -> f64 {
    let r2: f64 = r * r;
    let r02: f64 = r0 * r0;
    let z2: f64 = z * z;
    let term1: f64 = 0.125 * (r2 - r02) * (r2 - r02);
    let term2: f64 = (0.5 / (kappa * kappa)) * r02 * z2;
    let term3: f64 = delta_s * (r2 * z2 - 0.25 * r2 * r2);
    (psi0 / (r02 * r02)) * (term1 + term2 + term3)
}

fn eval_grad_shafranov_max_res(r0: f64, kappa: f64, delta_s: f64, psi0: f64) -> f64 {
    let h: f64 = 0.01;
    let inv_12h: f64 = 1.0 / (12.0 * h);
    let inv_12h2: f64 = 1.0 / (12.0 * h * h);
    let r02: f64 = r0 * r0;
    let mut max_res: f64 = 0.0;
    let mut ir: i32 = 0;
    while ir < 16 {
        let r: f64 = 1.15 + (ir as f64) * (1.0 / 15.0);
        let rhs: f64 = (psi0 / (r02 * r02)) * (r * r + r02 / (kappa * kappa));
        let mut iz: i32 = 0;
        while iz < 16 {
            let z: f64 = -0.65 + (iz as f64) * (1.30 / 15.0);
            let p0: f64 = solovev_psi(r, z, r0, kappa, delta_s, psi0);
            let pr_m2: f64 = solovev_psi(r - 2.0 * h, z, r0, kappa, delta_s, psi0);
            let pr_m1: f64 = solovev_psi(r - h, z, r0, kappa, delta_s, psi0);
            let pr_p1: f64 = solovev_psi(r + h, z, r0, kappa, delta_s, psi0);
            let pr_p2: f64 = solovev_psi(r + 2.0 * h, z, r0, kappa, delta_s, psi0);

            let pz_m2: f64 = solovev_psi(r, z - 2.0 * h, r0, kappa, delta_s, psi0);
            let pz_m1: f64 = solovev_psi(r, z - h, r0, kappa, delta_s, psi0);
            let pz_p1: f64 = solovev_psi(r, z + h, r0, kappa, delta_s, psi0);
            let pz_p2: f64 = solovev_psi(r, z + 2.0 * h, r0, kappa, delta_s, psi0);

            // 4th-order central finite differences (exact for degree-4 Solovev polynomial)
            let dpsi_dr: f64 = (pr_m2 - 8.0 * pr_m1 + 8.0 * pr_p1 - pr_p2) * inv_12h;
            let d2psi_dr2: f64 = (-pr_m2 + 16.0 * pr_m1 - 30.0 * p0 + 16.0 * pr_p1 - pr_p2) * inv_12h2;
            let d2psi_dz2: f64 = (-pz_m2 + 16.0 * pz_m1 - 30.0 * p0 + 16.0 * pz_p1 - pz_p2) * inv_12h2;
            let lhs: f64 = d2psi_dr2 - (dpsi_dr / r) + d2psi_dz2;
            let err: f64 = abs_f64(lhs - rhs);
            if err > max_res {
                max_res = err;
            }
            iz = iz + 1;
        }
        ir = ir + 1;
    }
    max_res
}

// WKB Gamow alpha-decay log10(T1/2 in seconds) for even-even parent (Z, A) with Q_alpha in MeV
fn gamow_log10_t12(z_parent: f64, a_parent: f64, q_mev: f64) -> f64 {
    let alpha_fs: f64 = 1.0 / 137.035999177;
    let hbar_c: f64 = 197.3269804;
    let c_fm_s: f64 = 2.99792458e23;
    let amu_mev: f64 = 931.49410242;
    let ln10: f64 = log(10.0);
    let ln2: f64 = log(2.0);

    let z_d: f64 = z_parent - 2.0;
    let a_d: f64 = a_parent - 4.0;
    let mu_mev: f64 = (4.0 * a_d / (4.0 + a_d)) * amu_mev;
    let r_n: f64 = 1.22 * (cbrt_pos(a_d) + cbrt_pos(4.0));
    let v_barrier: f64 = 2.0 * z_d * alpha_fs * hbar_c / r_n;
    let x: f64 = q_mev / v_barrier;
    if x >= 1.0 || x <= 0.0 {
        return -999.0;
    }
    let sx: f64 = sqrt(x);
    let geom: f64 = acos_unit(sx) - sqrt(x * (1.0 - x));
    let two_g: f64 = 4.0 * sqrt(2.0 * mu_mev / q_mev) * (2.0 * z_d * alpha_fs) * geom;
    // Assault frequency nu0 = v_alpha / (2 * R_n)
    let v_rel_c: f64 = sqrt(2.0 * q_mev / mu_mev);
    let nu0: f64 = (v_rel_c * c_fm_s) / (2.0 * r_n);
    (log(ln2 / nu0) + two_g) / ln10
}

fn casimir_pressure_pa(d_m: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846264338327950288;
    let hbar: f64 = 1.054571817e-34;
    let c: f64 = 299792458.0;
    let d4: f64 = d_m * d_m * d_m * d_m;
    -(pi * pi * hbar * c) / (240.0 * d4)
}

fn main() ~ Clock + Console {
    let t0: i64 = clock_ns();

    // 1. Solovev / Grad-Shafranov tokamak equilibrium check
    let r0: f64 = 1.65;
    let kappa: f64 = 1.65;
    let delta_s: f64 = 0.08;
    let psi0: f64 = 1.0;
    let gs_max_res: f64 = eval_grad_shafranov_max_res(r0, kappa, delta_s, psi0);
    let psi_axis: f64 = solovev_psi(r0, 0.0, r0, kappa, delta_s, psi0);

    // 2. WKB Gamow tunneling Geiger-Nuttall correlation across 10 even-even alpha emitters
    let mut zs: Vec<f64> = Vec::new();
    let mut as_v: Vec<f64> = Vec::new();
    let mut qs: Vec<f64> = Vec::new();
    let mut exps: Vec<f64> = Vec::new();

    // Po-212, Po-214, Po-216, Po-218, Rn-220, Rn-222, Ra-224, Ra-226, Th-228, U-238
    zs.push(84.0); as_v.push(212.0); qs.push(8.954); exps.push(-6.524);
    zs.push(84.0); as_v.push(214.0); qs.push(7.833); exps.push(-3.784);
    zs.push(84.0); as_v.push(216.0); qs.push(6.906); exps.push(-0.839);
    zs.push(84.0); as_v.push(218.0); qs.push(6.115); exps.push(2.270);
    zs.push(86.0); as_v.push(220.0); qs.push(6.405); exps.push(1.745);
    zs.push(86.0); as_v.push(222.0); qs.push(5.590); exps.push(5.519);
    zs.push(88.0); as_v.push(224.0); qs.push(5.789); exps.push(5.499);
    zs.push(88.0); as_v.push(226.0); qs.push(4.871); exps.push(10.703);
    zs.push(90.0); as_v.push(228.0); qs.push(5.520); exps.push(7.781);
    zs.push(92.0); as_v.push(238.0); qs.push(4.270); exps.push(17.149);

    let mut preds: Vec<f64> = Vec::new();
    let mut mean_x: f64 = 0.0;
    let mut mean_y: f64 = 0.0;
    let mut k: usize = 0;
    while k < 10 {
        let pr: f64 = gamow_log10_t12(zs[k], as_v[k], qs[k]);
        preds.push(pr);
        mean_x = mean_x + pr;
        mean_y = mean_y + exps[k];
        k = k + 1;
    }
    mean_x = mean_x / 10.0;
    mean_y = mean_y / 10.0;
    let mut sxy: f64 = 0.0;
    let mut sxx: f64 = 0.0;
    let mut syy: f64 = 0.0;
    let mut gamow_sum: f64 = 0.0;
    k = 0;
    while k < 10 {
        let dx: f64 = preds[k] - mean_x;
        let dy: f64 = exps[k] - mean_y;
        sxy = sxy + dx * dy;
        sxx = sxx + dx * dx;
        syy = syy + dy * dy;
        gamow_sum = gamow_sum + preds[k];
        k = k + 1;
    }
    let r_corr: f64 = sxy / sqrt(sxx * syy);
    let r2: f64 = r_corr * r_corr;

    // 3. Casimir parallel-plate pressure at d = 100 nm, 500 nm, 1 um
    let cas_100nm: f64 = casimir_pressure_pa(1.0e-7);
    let cas_500nm: f64 = casimir_pressure_pa(5.0e-7);
    let cas_1um: f64 = casimir_pressure_pa(1.0e-6);

    // 4. Planted failing controls (2/2 MUST be caught fail-closed)
    let bad_casimir_repulsive: f64 = -cas_100nm;
    let cas_sign_caught: i32 = if bad_casimir_repulsive >= 0.0 && cas_100nm < 0.0 { 1 } else { 0 };
    let bad_barrier_ret: f64 = gamow_log10_t12(92.0, 238.0, 45.0);
    let barrier_caught: i32 = if bad_barrier_ret < -900.0 { 1 } else { 0 };
    let planted_caught: i32 = if cas_sign_caught == 1 && barrier_caught == 1 { 1 } else { 0 };

    let t1: i64 = clock_ns();
    let elapsed_ms: f64 = ((t1 - t0) as f64) / 1.0e6;

    println!("N12_GS_MAX_RES={:.15}", gs_max_res);
    println!("N12_PSI_AXIS={:.12}", psi_axis);
    println!("N12_GAMOW_R2={:.12}", r2);
    println!("N12_GAMOW_SUM={:.12}", gamow_sum);
    println!("N12_CASIMIR_100NM={:.12}", cas_100nm);
    println!("N12_CASIMIR_500NM={:.12}", cas_500nm);
    println!("N12_CASIMIR_1UM={:.15}", cas_1um);
    println!("N12_PLANTED_CAUGHT={}", planted_caught);
    println!("N12_ELAPSED_MS={:.4}", elapsed_ms);

    if gs_max_res < 1.0e-8 && r2 > 0.98 && cas_100nm < 0.0 && planted_caught == 1 {
        println!(
            "[PASS] N12_PLASMA_QUANTUM gs_res={:.3e} gamow_r2={:.6} cas_100nm={:.6}Pa planted_caught=1",
            gs_max_res, r2, cas_100nm
        );
    } else {
        println!(
            "[FAIL] N12_PLASMA_QUANTUM gs_res={:.3e} gamow_r2={:.6} planted_caught={}",
            gs_max_res, r2, planted_caught
        );
    }
}
