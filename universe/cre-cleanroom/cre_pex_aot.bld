// Wave 52C (Author Ideas N17 / F1 / A1):
//   Clean-Room OpenMW-Style Engine Track-B Slice 2:
//   PEX (0xFA57C0DE) Bytecode Reference Interpreter + Native AOT C99 Compiler.
//   100% clean-room synthetic bytecode scripts (zero external game files or assets).
//   ISA (11 opcodes): 0=NOP, 1=ASSIGN, 2=IADD, 3=ISUB, 4=IMUL, 5=IDIV,
//                     6=CMP, 7=JMP, 8=JMPT, 9=JMPF, 10=RETURN.

fn push_instr(code: &mut Vec<i64>, op: i64, dst: i64, a: i64, b: i64) {
    code.push(op);
    code.push(dst);
    code.push(a);
    code.push(b);
}

fn new_pex_buf() -> Vec<i64> {
    let mut b: Vec<i64> = Vec::new();
    // Header word 0 = magic 0xFA57C0DE (4200054990), word 1 = instr_count placeholder
    b.push(4200054990);
    b.push(0);
    b
}

fn finish_pex_buf(b: &mut Vec<i64>) {
    let count: i64 = ((b.len() as i64) - 2) / 4;
    b[1] = count;
}

// Fail-closed bytecode verifier:
//   0 = OK, -100 = bad_magic/truncated, -102 = invalid_opcode, -103 = oob_jump, -104 = bad_reg.
fn validate_pex(code: &Vec<i64>) -> i32 {
    if code.len() < 6 {
        return -100;
    }
    if code[0] != 4200054990 {
        return -100;
    }
    let n_ins: i64 = code[1];
    if n_ins <= 0 || ((code.len() as i64) != 2 + n_ins * 4) {
        return -100;
    }
    let mut pc: i64 = 0;
    while pc < n_ins {
        let base: usize = (2 + pc * 4) as usize;
        let op: i64 = code[base];
        let dst: i64 = code[base + 1];
        let a: i64 = code[base + 2];
        let b: i64 = code[base + 3];
        if op < 0 || op > 10 {
            return -102;
        }
        if op == 1 {
            if dst < 0 || dst >= 16 {
                return -104;
            }
            if b == 1 && (a < 0 || a >= 16) {
                return -104;
            }
        } else if op >= 2 && op <= 6 {
            if dst < 0 || dst >= 16 || a < 0 || a >= 16 || b < 0 || b >= 16 {
                return -104;
            }
        } else if op == 7 {
            if dst < 0 || dst >= n_ins {
                return -103;
            }
        } else if op == 8 || op == 9 {
            if dst < 0 || dst >= n_ins {
                return -103;
            }
            if a < 0 || a >= 16 {
                return -104;
            }
        } else if op == 10 {
            if a < 0 || a >= 16 {
                return -104;
            }
        }
        pc = pc + 1;
    }
    0
}

struct InterpRes {
    err: i32,
    val: i64,
    steps: i64,
}

// Clean-room reference PEX bytecode interpreter (r0 = seed_in, r1 = iters_in).
fn exec_pex_interp(code: &Vec<i64>, seed_in: i64, iters_in: i64) -> InterpRes {
    let vrc: i32 = validate_pex(code);
    if vrc != 0 {
        return InterpRes { err: vrc, val: 0, steps: 0 };
    }
    let n_ins: i64 = code[1];
    let mut reg: Vec<i64> = Vec::new();
    let mut ri: i32 = 0;
    while ri < 16 {
        reg.push(0);
        ri = ri + 1;
    }
    reg[0] = seed_in;
    reg[1] = iters_in;

    let mut pc: i64 = 0;
    let mut steps: i64 = 0;
    while pc < n_ins {
        let base: usize = (2 + pc * 4) as usize;
        let op: i64 = code[base];
        let dst: i64 = code[base + 1];
        let a: i64 = code[base + 2];
        let b: i64 = code[base + 3];
        steps = steps + 1;

        if op == 0 {
            pc = pc + 1;
        } else if op == 1 {
            if b == 0 {
                reg[dst as usize] = a;
            } else {
                reg[dst as usize] = reg[a as usize];
            }
            pc = pc + 1;
        } else if op == 2 {
            reg[dst as usize] = reg[a as usize] + reg[b as usize];
            pc = pc + 1;
        } else if op == 3 {
            reg[dst as usize] = reg[a as usize] - reg[b as usize];
            pc = pc + 1;
        } else if op == 4 {
            reg[dst as usize] = reg[a as usize] * reg[b as usize];
            pc = pc + 1;
        } else if op == 5 {
            let denom: i64 = reg[b as usize];
            if denom == 0 {
                return InterpRes { err: -101, val: 0, steps: steps };
            }
            reg[dst as usize] = reg[a as usize] / denom;
            pc = pc + 1;
        } else if op == 6 {
            reg[dst as usize] = if reg[a as usize] < reg[b as usize] { 1 } else { 0 };
            pc = pc + 1;
        } else if op == 7 {
            pc = dst;
        } else if op == 8 {
            if reg[a as usize] != 0 {
                pc = dst;
            } else {
                pc = pc + 1;
            }
        } else if op == 9 {
            if reg[a as usize] == 0 {
                pc = dst;
            } else {
                pc = pc + 1;
            }
        } else if op == 10 {
            return InterpRes { err: 0, val: reg[a as usize], steps: steps };
        } else {
            return InterpRes { err: -102, val: 0, steps: steps };
        }
    }
    InterpRes { err: 0, val: reg[0], steps: steps }
}

// Clean-room AOT compiler: lowers validated PEX bytecode to zero-warning -O2 C99.
fn emit_c99_function(fn_name: &String, code: &Vec<i64>) -> i32 ~ Console {
    let vrc: i32 = validate_pex(code);
    if vrc != 0 {
        return vrc;
    }
    let n_ins: i64 = code[1];
    // Mark jump target PCs so only referenced C labels are emitted (-Wall -Wextra -Werror clean).
    let mut is_target: Vec<i32> = Vec::new();
    let mut idx: i64 = 0;
    while idx < n_ins {
        is_target.push(0);
        idx = idx + 1;
    }
    let mut pc: i64 = 0;
    while pc < n_ins {
        let base: usize = (2 + pc * 4) as usize;
        let op: i64 = code[base];
        let dst: i64 = code[base + 1];
        if op == 7 || op == 8 || op == 9 {
            is_target[dst as usize] = 1;
        }
        pc = pc + 1;
    }

    println!(
        "static __attribute__((noinline)) int64_t {}(int64_t seed_in, int64_t iters_in, int *err_out) {{",
        fn_name
    );
    println!("    int64_t r0 = seed_in, r1 = iters_in, r2 = 0, r3 = 0;");
    println!("    int64_t r4 = 0, r5 = 0, r6 = 0, r7 = 0;");
    println!("    int64_t r8 = 0, r9 = 0, r10 = 0, r11 = 0;");
    println!("    int64_t r12 = 0, r13 = 0, r14 = 0, r15 = 0;");
    println!("    (void)r0; (void)r1; (void)r2; (void)r3;");
    println!("    (void)r4; (void)r5; (void)r6; (void)r7;");
    println!("    (void)r8; (void)r9; (void)r10; (void)r11;");
    println!("    (void)r12; (void)r13; (void)r14; (void)r15;");
    println!("    *err_out = 0;");

    pc = 0;
    while pc < n_ins {
        if is_target[pc as usize] == 1 {
            println!("L{}:", pc);
        }
        let base: usize = (2 + pc * 4) as usize;
        let op: i64 = code[base];
        let dst: i64 = code[base + 1];
        let a: i64 = code[base + 2];
        let b: i64 = code[base + 3];

        if op == 0 {
            println!("    /* NOP */");
        } else if op == 1 {
            if b == 0 {
                println!("    r{} = {}LL;", dst, a);
            } else {
                println!("    r{} = r{};", dst, a);
            }
        } else if op == 2 {
            println!("    r{} = r{} + r{};", dst, a, b);
        } else if op == 3 {
            println!("    r{} = r{} - r{};", dst, a, b);
        } else if op == 4 {
            println!("    r{} = r{} * r{};", dst, a, b);
        } else if op == 5 {
            println!("    if (r{} == 0) {{ *err_out = -101; return 0; }}", b);
            println!("    r{} = r{} / r{};", dst, a, b);
        } else if op == 6 {
            println!("    r{} = (r{} < r{}) ? 1LL : 0LL;", dst, a, b);
        } else if op == 7 {
            println!("    goto L{};", dst);
        } else if op == 8 {
            println!("    if (r{} != 0) goto L{};", a, dst);
        } else if op == 9 {
            println!("    if (r{} == 0) goto L{};", a, dst);
        } else if op == 10 {
            println!("    return r{};", a);
        }
        pc = pc + 1;
    }
    println!("    return r0;");
    println!("}}");
    0
}

// ---- 5 Clean-Room Synthetic PEX Scripts + 3 Planted Traps ----

// Script 1: 10,000-iteration game-tick / combat-formula loop (armor, crit, stamina, shield, wrap).
fn build_s1_combat_tick() -> Vec<i64> {
    let mut c: Vec<i64> = new_pex_buf();
    // r0=seed_in (atk), r1=iters_in, r2=tick, r3=score, r4=1, r5=3, r6=20 (armor),
    // r7=2, r8=200, r9=120, r10..r15=temps
    push_instr(&mut c, 1, 2, 0, 0);    // 0: r2 = 0 (tick)
    push_instr(&mut c, 1, 3, 0, 0);    // 1: r3 = 0 (score)
    push_instr(&mut c, 1, 4, 1, 0);    // 2: r4 = 1
    push_instr(&mut c, 1, 5, 3, 0);    // 3: r5 = 3
    push_instr(&mut c, 1, 6, 20, 0);   // 4: r6 = 20 (armor)
    push_instr(&mut c, 1, 7, 2, 0);    // 5: r7 = 2
    push_instr(&mut c, 1, 8, 200, 0);  // 6: r8 = 200
    push_instr(&mut c, 1, 9, 120, 0);  // 7: r9 = 120
    push_instr(&mut c, 1, 13, 5, 0);   // 8: r13 = 5 (crit_scale)
    // Loop header (pc = 9)
    push_instr(&mut c, 6, 10, 2, 1);   // 9: r10 = (tick < iters)
    push_instr(&mut c, 9, 32, 10, 0);  // 10: if !r10 goto 32 (exit)
    push_instr(&mut c, 4, 11, 0, 5);   // 11: r11 = atk * 3
    push_instr(&mut c, 3, 11, 11, 6);  // 12: r11 = atk*3 - armor
    push_instr(&mut c, 5, 11, 11, 7);  // 13: r11 = (atk*3 - armor) / 2
    push_instr(&mut c, 4, 14, 0, 13);  // 14: r14 = atk * 5
    push_instr(&mut c, 2, 14, 14, 11); // 15: r14 = atk*5 + base_dmg
    push_instr(&mut c, 3, 15, 14, 6);  // 16: r15 = r14 - armor
    push_instr(&mut c, 2, 15, 15, 0);  // 17: r15 += atk
    push_instr(&mut c, 2, 14, 14, 5);  // 18: stamina_term = r14 + 3
    push_instr(&mut c, 3, 14, 14, 7);  // 19: shield_soak = stamina_term - 2
    push_instr(&mut c, 2, 15, 15, 14); // 20: r15 += shield_soak
    push_instr(&mut c, 4, 14, 11, 7);  // 21: dodge_bonus = base_dmg * 2
    push_instr(&mut c, 3, 14, 14, 5);  // 22: dodge_bonus -= 3
    push_instr(&mut c, 2, 15, 15, 14); // 23: r15 += dodge_bonus
    push_instr(&mut c, 2, 3, 3, 11);   // 24: score += base_dmg
    push_instr(&mut c, 2, 3, 3, 15);   // 25: score += total_term
    push_instr(&mut c, 2, 0, 0, 4);    // 26: atk += 1
    push_instr(&mut c, 6, 12, 0, 8);   // 27: r12 = (atk < 200)
    push_instr(&mut c, 8, 30, 12, 0);  // 28: if atk < 200 goto 30
    push_instr(&mut c, 3, 0, 0, 9);    // 29: atk -= 120
    push_instr(&mut c, 2, 2, 2, 4);    // 30: tick += 1
    push_instr(&mut c, 7, 9, 0, 0);    // 31: goto 9
    push_instr(&mut c, 10, 0, 3, 0);   // 32: return score
    finish_pex_buf(&mut c);
    c
}

// Script 2: Euclidean GCD via IDIV/IMUL/ISUB loop (r0=a, r1=b).
fn build_s2_gcd_euclid() -> Vec<i64> {
    let mut c: Vec<i64> = new_pex_buf();
    push_instr(&mut c, 1, 2, 0, 0);    // 0: r2 = 0
    // Loop header (pc = 1): while (0 < r1)
    push_instr(&mut c, 6, 3, 2, 1);    // 1: r3 = (0 < r1)
    push_instr(&mut c, 9, 9, 3, 0);    // 2: if !r3 goto 9
    push_instr(&mut c, 5, 4, 0, 1);    // 3: q = r0 / r1
    push_instr(&mut c, 4, 5, 4, 1);    // 4: r5 = q * r1
    push_instr(&mut c, 3, 6, 0, 5);    // 5: rem = r0 - q*r1
    push_instr(&mut c, 1, 0, 1, 1);    // 6: r0 = r1
    push_instr(&mut c, 1, 1, 6, 1);    // 7: r1 = rem
    push_instr(&mut c, 7, 1, 0, 0);    // 8: goto 1
    push_instr(&mut c, 10, 0, 0, 0);   // 9: return r0
    finish_pex_buf(&mut c);
    c
}

// Script 3: Modular polynomial step accumulator over iters (r0=seed, r1=iters).
fn build_s3_poly_step() -> Vec<i64> {
    let mut c: Vec<i64> = new_pex_buf();
    push_instr(&mut c, 1, 2, 0, 0);    // 0: i = 0
    push_instr(&mut c, 1, 3, 1, 0);    // 1: one = 1
    push_instr(&mut c, 1, 4, 5, 0);    // 2: five = 5
    push_instr(&mut c, 1, 5, 17, 0);   // 3: c17 = 17
    push_instr(&mut c, 1, 6, 997, 0);  // 4: mod = 997
    // Loop (pc = 5)
    push_instr(&mut c, 6, 7, 2, 1);    // 5: r7 = (i < iters)
    push_instr(&mut c, 9, 14, 7, 0);   // 6: if !r7 goto 14
    push_instr(&mut c, 4, 8, 0, 4);    // 7: r8 = r0 * 5
    push_instr(&mut c, 2, 8, 8, 5);    // 8: r8 += 17
    push_instr(&mut c, 5, 9, 8, 6);    // 9: q = r8 / 997
    push_instr(&mut c, 4, 10, 9, 6);   // 10: r10 = q * 997
    push_instr(&mut c, 3, 0, 8, 10);   // 11: r0 = r8 % 997
    push_instr(&mut c, 2, 2, 2, 3);    // 12: i += 1
    push_instr(&mut c, 7, 5, 0, 0);    // 13: goto 5
    push_instr(&mut c, 10, 0, 0, 0);   // 14: return r0
    finish_pex_buf(&mut c);
    c
}

// Script 4: Quest FSM branch & cooldown state machine (NOP + CMP + JMPT + JMPF).
fn build_s4_quest_fsm() -> Vec<i64> {
    let mut c: Vec<i64> = new_pex_buf();
    push_instr(&mut c, 0, 0, 0, 0);    // 0: NOP
    push_instr(&mut c, 1, 2, 50, 0);   // 1: thresh = 50
    push_instr(&mut c, 1, 3, 100, 0);  // 2: bonus = 100
    push_instr(&mut c, 1, 4, 7, 0);    // 3: penalty = 7
    push_instr(&mut c, 6, 5, 0, 2);    // 4: r5 = (seed < 50)
    push_instr(&mut c, 8, 8, 5, 0);    // 5: if seed < 50 goto 8
    push_instr(&mut c, 2, 0, 0, 3);    // 6: r0 = seed + 100
    push_instr(&mut c, 7, 9, 0, 0);    // 7: goto 9
    push_instr(&mut c, 3, 0, 0, 4);    // 8: r0 = seed - 7
    push_instr(&mut c, 4, 0, 0, 1);    // 9: r0 = r0 * iters
    push_instr(&mut c, 10, 0, 0, 0);   // 10: return r0
    finish_pex_buf(&mut c);
    c
}

// Script 5: Safe stamina/encumbrance iterative halving + bias (IDIV + ISUB + JMPT).
fn build_s5_stamina_decay() -> Vec<i64> {
    let mut c: Vec<i64> = new_pex_buf();
    push_instr(&mut c, 1, 2, 0, 0);    // 0: sum = 0
    push_instr(&mut c, 1, 3, 2, 0);    // 1: two = 2
    push_instr(&mut c, 1, 4, 1, 0);    // 2: one = 1
    push_instr(&mut c, 1, 5, 0, 0);    // 3: i = 0
    // Loop (pc = 4)
    push_instr(&mut c, 6, 6, 5, 1);    // 4: r6 = (i < iters)
    push_instr(&mut c, 9, 10, 6, 0);   // 5: if !r6 goto 10
    push_instr(&mut c, 2, 2, 2, 0);    // 6: sum += r0
    push_instr(&mut c, 5, 0, 0, 3);    // 7: r0 = r0 / 2
    push_instr(&mut c, 2, 5, 5, 4);    // 8: i += 1
    push_instr(&mut c, 7, 4, 0, 0);    // 9: goto 4
    push_instr(&mut c, 10, 0, 2, 0);   // 10: return sum
    finish_pex_buf(&mut c);
    c
}

// Planted Trap 1: Division by zero (r2 = 0; r3 = r0 / r2)
fn build_trap1_div_zero() -> Vec<i64> {
    let mut c: Vec<i64> = new_pex_buf();
    push_instr(&mut c, 1, 2, 0, 0);    // 0: r2 = 0
    push_instr(&mut c, 5, 3, 0, 2);    // 1: r3 = r0 / r2 -> DIV_ZERO (-101)
    push_instr(&mut c, 10, 0, 3, 0);   // 2: return r3
    finish_pex_buf(&mut c);
    c
}

// Planted Trap 2: Invalid opcode 0xFF (255)
fn build_trap2_bad_op() -> Vec<i64> {
    let mut c: Vec<i64> = new_pex_buf();
    push_instr(&mut c, 255, 0, 0, 0);
    push_instr(&mut c, 10, 0, 0, 0);
    finish_pex_buf(&mut c);
    c
}

// Planted Trap 3: Out-of-bounds jump target (999 >= instr_count)
fn build_trap3_oob_jump() -> Vec<i64> {
    let mut c: Vec<i64> = new_pex_buf();
    push_instr(&mut c, 7, 999, 0, 0);
    push_instr(&mut c, 10, 0, 0, 0);
    finish_pex_buf(&mut c);
    c
}

fn main() ~ Console + Clock {
    let mut failures: i32 = 0;

    let s1: Vec<i64> = build_s1_combat_tick();
    let s2: Vec<i64> = build_s2_gcd_euclid();
    let s3: Vec<i64> = build_s3_poly_step();
    let s4: Vec<i64> = build_s4_quest_fsm();
    let s5: Vec<i64> = build_s5_stamina_decay();

    let r1: InterpRes = exec_pex_interp(&s1, 45, 10000);
    let r2: InterpRes = exec_pex_interp(&s2, 1071, 462);
    let r3: InterpRes = exec_pex_interp(&s3, 19, 2000);
    let r4: InterpRes = exec_pex_interp(&s4, 72, 13);
    let r5: InterpRes = exec_pex_interp(&s5, 65535, 16);

    if r1.err == 0 && r2.err == 0 && r3.err == 0 && r4.err == 0 && r5.err == 0 {
        println!(
            "[PASS] pex_interp_5scripts s1={} s2={} s3={} s4={} s5={}",
            r1.val, r2.val, r3.val, r4.val, r5.val
        );
    } else {
        println!("[FAIL] pex_interp_5scripts errs={} {}", r1.err, r2.err);
        failures = failures + 1;
    }

    // Planted Traps (3/3 fail-closed)
    let t1_code: Vec<i64> = build_trap1_div_zero();
    let t2_code: Vec<i64> = build_trap2_bad_op();
    let t3_code: Vec<i64> = build_trap3_oob_jump();
    let tr1: InterpRes = exec_pex_interp(&t1_code, 100, 1);
    let tr2: InterpRes = exec_pex_interp(&t2_code, 100, 1);
    let tr3: InterpRes = exec_pex_interp(&t3_code, 100, 1);
    if tr1.err == -101 && tr2.err == -102 && tr3.err == -103 {
        println!(
            "[PASS] pex_planted_traps div0_rc={} bad_op_rc={} oob_jmp_rc={}",
            tr1.err, tr2.err, tr3.err
        );
    } else {
        println!("[FAIL] pex_planted_traps rcs={} {} {}", tr1.err, tr2.err, tr3.err);
        failures = failures + 1;
    }

    // Benchmark reference bytecode interpreter: 500 x 10,000 ticks = 5,000,000 ticks
    let t0: i64 = clock_ns();
    let mut interp_xor: i64 = 0;
    let mut run_i: i64 = 0;
    while run_i < 500 {
        let rr: InterpRes = exec_pex_interp(&s1, 45 + (run_i & 31), 10000);
        interp_xor = interp_xor ^ rr.val;
        run_i = run_i + 1;
    }
    let t1: i64 = clock_ns();
    println!(
        "[BENCH] pex_interp runs=500 ticks_each=10000 elapsed_ns={} xor={}",
        t1 - t0, interp_xor
    );

    // Emit standalone zero-warning -O2 C99 AOT artifact for gcc compilation & head-to-head timing
    println!("/* === BEGIN_PEX_AOT_C99 === */");
    println!("#include <stdint.h>");
    println!("#include <stdio.h>");
    println!("#include <stdlib.h>");
    println!("#ifdef _WIN32");
    println!("#include <windows.h>");
    println!("static int64_t now_ns(void) {{");
    println!("    LARGE_INTEGER f, c; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&c);");
    println!("    return (int64_t)((double)c.QuadPart * 1e9 / (double)f.QuadPart);");
    println!("}}");
    println!("#else");
    println!("#include <time.h>");
    println!("static int64_t now_ns(void) {{");
    println!("    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);");
    println!("    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;");
    println!("}}");
    println!("#endif");

    let n1: String = String::from("pex_s1_combat_tick");
    let n2: String = String::from("pex_s2_gcd_euclid");
    let n3: String = String::from("pex_s3_poly_step");
    let n4: String = String::from("pex_s4_quest_fsm");
    let n5: String = String::from("pex_s5_stamina_decay");
    let nt1: String = String::from("pex_trap1_div_zero");
    let e1: i32 = emit_c99_function(&n1, &s1);
    let e2: i32 = emit_c99_function(&n2, &s2);
    let e3: i32 = emit_c99_function(&n3, &s3);
    let e4: i32 = emit_c99_function(&n4, &s4);
    let e5: i32 = emit_c99_function(&n5, &s5);
    let et1: i32 = emit_c99_function(&nt1, &t1_code);

    // Confirm invalid bytecode refuses C99 emission fail-closed
    let nb2: String = String::from("bad2");
    let nb3: String = String::from("bad3");
    let eb2: i32 = emit_c99_function(&nb2, &t2_code);
    let eb3: i32 = emit_c99_function(&nb3, &t3_code);

    println!("int main(int argc, char **argv) {{");
    println!("    int64_t iters = (argc > 1) ? atoll(argv[1]) : 10000LL;");
    println!("    int e1 = 0, e2 = 0, e3 = 0, e4 = 0, e5 = 0, et = 0;");
    println!("    int64_t v1 = pex_s1_combat_tick(45, iters, &e1);");
    println!("    int64_t v2 = pex_s2_gcd_euclid(1071, 462, &e2);");
    println!("    int64_t v3 = pex_s3_poly_step(19, 2000, &e3);");
    println!("    int64_t v4 = pex_s4_quest_fsm(72, 13, &e4);");
    println!("    int64_t v5 = pex_s5_stamina_decay(65535, 16, &e5);");
    println!("    (void)pex_trap1_div_zero(100, 1, &et);");
    println!("    printf(\"[AOT] 5scripts s1=%lld s2=%lld s3=%lld s4=%lld s5=%lld div0_rc=%d\\n\",");
    println!("           (long long)v1, (long long)v2, (long long)v3, (long long)v4, (long long)v5, et);");
    println!("    int64_t t0 = now_ns();");
    println!("    int64_t aot_xor = 0;");
    println!("    for (int64_t i = 0; i < 500; i++) {{");
    println!("        int er = 0;");
    println!("        aot_xor ^= pex_s1_combat_tick(45 + (i & 31), iters, &er);");
    println!("    }}");
    println!("    int64_t t1 = now_ns();");
    println!("    printf(\"[AOT_BENCH] runs=500 ticks_each=%lld elapsed_ns=%lld xor=%lld\\n\",");
    println!("           (long long)iters, (long long)(t1 - t0), (long long)aot_xor);");
    println!("    return (e1 | e2 | e3 | e4 | e5) == 0 && et == -101 ? 0 : 1;");
    println!("}}");
    println!("/* === END_PEX_AOT_C99 === */");

    if e1 != 0 || e2 != 0 || e3 != 0 || e4 != 0 || e5 != 0 || et1 != 0 || eb2 != -102 || eb3 != -103 {
        println!("[FAIL] pex_aot_emit codes={} {}", eb2, eb3);
        failures = failures + 1;
    } else {
        println!("[PASS] pex_aot_emit ok=6 rejected_bad_op={} rejected_oob_jmp={}", eb2, eb3);
    }

    if failures == 0 {
        println!("[PASS] wave52c_cre_pex_aot summary failures=0");
    } else {
        println!("[FAIL] wave52c_cre_pex_aot summary failures={}", failures);
    }
}
