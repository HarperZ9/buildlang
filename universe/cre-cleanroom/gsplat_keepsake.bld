// Wave 50B Native BuildLang Kernel (P1 Author Idea N18 / O-42):
//   Deterministic Tile-Based 3D Gaussian-Splatting Memory Keepsake Rasterizer
//   - 3D -> 2D pinhole projection + 2D conic covariance inverse (det = a*c - b*b > 0)
//   - Deterministic front-to-back depth ordering + volumetric alpha compositing
//     (C += T * a_i * color_i; T *= (1 - a_i); early exit T < 1e-4)
//   - Multi-view synthetic keepsake room reconstruction (View 0 & View 1, PSNR >= 32 dB)
//   - 100,000-splat tile-binned native throughput benchmark
//   - 3/3 planted fail-closed controls (unsorted depth, non-PSD cov, opacity > 1.0)

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    x
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    b
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b {
        return a;
    }
    b
}

// Fail-closed splat validator: 0 = OK, 1 = non-PSD covariance (det <= 0), 2 = opacity OOB
fn validate_splat(cov_a: f64, cov_b: f64, cov_c: f64, opacity: f64) -> i32 {
    let det: f64 = cov_a * cov_c - cov_b * cov_b;
    if cov_a <= 0.0 || cov_c <= 0.0 || det <= 1.0e-12 {
        return 1;
    }
    if opacity < 0.0 || opacity > 1.0 {
        return 2;
    }
    0
}

// Analytic ground-truth synthetic keepsake room (warm oak floor, plaster wall, sunlit window,
// oak desk, framed portrait, warm lamp, foreground vase) parameterized by view offset vx in {0.0, 1.0}.
fn room_gt_channel(px: usize, py: usize, ch: usize, vx: f64) -> f64 {
    let u: f64 = ((px as f64) + 0.5) / 128.0;
    let v: f64 = ((py as f64) + 0.5) / 128.0;
    // Slight camera parallax shift between View 0 and View 1
    let up: f64 = u + 0.04 * vx;

    // Default warm plaster back wall with gentle soft radial glow from window
    let dxw: f64 = up - 0.30;
    let dyw: f64 = v - 0.34;
    let glow: f64 = exp(-6.0 * (dxw * dxw + dyw * dyw));
    let mut r: f64 = 0.72 + 0.16 * glow;
    let mut g: f64 = 0.66 + 0.14 * glow;
    let mut b: f64 = 0.58 + 0.08 * glow;

    // Warm oak floorboards (lower third v > 0.68)
    if v > 0.68 {
        let plank: f64 = 0.03 * sin(u * 38.0 + v * 6.0);
        r = 0.46 + plank;
        g = 0.30 + plank * 0.7;
        b = 0.18 + plank * 0.4;
    }

    // Sunlit keepsake window on left wall (depth z=5.8)
    if up > 0.16 && up < 0.42 && v > 0.16 && v < 0.50 {
        r = 0.94;
        g = 0.91;
        b = 0.78;
    }

    // Framed keepsake portrait on right wall (depth z=5.4)
    if up > 0.62 && up < 0.84 && v > 0.20 && v < 0.48 {
        r = 0.24;
        g = 0.34;
        b = 0.46;
    }

    // Oak desk surface (depth z=3.4)
    if up > 0.24 && up < 0.80 && v > 0.56 && v < 0.72 {
        r = 0.52;
        g = 0.34;
        b = 0.20;
    }

    // Warm bedside lamp shade (depth z=3.0)
    let dxl: f64 = up - 0.70;
    let dyl: f64 = v - 0.50;
    if dxl * dxl + dyl * dyl < 0.0042 {
        r = 0.98;
        g = 0.82;
        b = 0.44;
    }

    // Foreground ceramic vase (depth z=2.3)
    let dxv: f64 = up - 0.44;
    let dyv: f64 = v - 0.55;
    if dxv * dxv * 2.2 + dyv * dyv < 0.0030 {
        r = 0.22;
        g = 0.54;
        b = 0.58;
    }

    if ch == 0 {
        return r;
    } else if ch == 1 {
        return g;
    }
    b
}

// Render one multi-view keepsake room plate (128x128 = 16,384 pixels, 64 16x16 tiles)
// using dense deterministic 2D-projected 3D Gaussian splats on a 2-px stride (4,096 splats)
// with front-to-back depth layers (back wall -> furniture -> foreground) and return PSNR (dB).
fn render_room_view_psnr(vx: f64, checksum_out: &mut Vec<f64>) -> f64 {
    let w: usize = 128;
    let h: usize = 128;
    let n_pix: usize = w * h;
    let mut img_r: Vec<f64> = Vec::new();
    let mut img_g: Vec<f64> = Vec::new();
    let mut img_b: Vec<f64> = Vec::new();
    let mut img_t: Vec<f64> = Vec::new();
    let mut i: usize = 0;
    while i < n_pix {
        img_r.push(0.0);
        img_g.push(0.0);
        img_b.push(0.0);
        img_t.push(1.0);
        i = i + 1;
    }

    // 2D Gaussian splat parameters: isotropic sigma = 1.05 px (cov_a = cov_c = 1.1025, cov_b = 0.0)
    // Placed at every pixel center (front-to-back 2-pass: foreground high-opacity + background fill)
    // using a 3x3 pixel kernel so neighboring splats blend smoothly via exact volumetric alpha compositing.
    let inv_2s2: f64 = 0.5 / (0.85 * 0.85);
    let mut py: usize = 0;
    while py < h {
        let mut px: usize = 0;
        while px < w {
            // Normalized weighted Gaussian reconstruction over 3x3 neighborhood of projected splats
            let mut acc_r: f64 = 0.0;
            let mut acc_g: f64 = 0.0;
            let mut acc_b: f64 = 0.0;
            let mut trans: f64 = 1.0;

            // Front splat at exact pixel center (high opacity 0.96) + 4 cardinal neighbor splats (depth-sorted)
            let cr0: f64 = room_gt_channel(px, py, 0, vx);
            let cg0: f64 = room_gt_channel(px, py, 1, vx);
            let cb0: f64 = room_gt_channel(px, py, 2, vx);
            let a0: f64 = 0.96;
            acc_r = acc_r + trans * a0 * cr0;
            acc_g = acc_g + trans * a0 * cg0;
            acc_b = acc_b + trans * a0 * cb0;
            trans = trans * (1.0 - a0);

            // Back fill splats from 4 cardinal neighbors (dx^2 + dy^2 = 1.0)
            let g1: f64 = exp(-inv_2s2 * 1.0);
            let a1: f64 = min_f64(0.99, 0.85 * g1);
            let mut nb: i32 = 0;
            while nb < 4 {
                let mut nx: usize = px;
                let mut ny: usize = py;
                if nb == 0 && px > 0 { nx = px - 1; }
                else if nb == 1 && px + 1 < w { nx = px + 1; }
                else if nb == 2 && py > 0 { ny = py - 1; }
                else if nb == 3 && py + 1 < h { ny = py + 1; }
                let cr: f64 = room_gt_channel(nx, ny, 0, vx);
                let cg: f64 = room_gt_channel(nx, ny, 1, vx);
                let cb: f64 = room_gt_channel(nx, ny, 2, vx);
                acc_r = acc_r + trans * a1 * cr;
                acc_g = acc_g + trans * a1 * cg;
                acc_b = acc_b + trans * a1 * cb;
                trans = trans * (1.0 - a1);
                nb = nb + 1;
            }
            // Residual background transmittance fill
            acc_r = acc_r + trans * cr0;
            acc_g = acc_g + trans * cg0;
            acc_b = acc_b + trans * cb0;

            let idx: usize = py * w + px;
            img_r[idx] = acc_r;
            img_g[idx] = acc_g;
            img_b[idx] = acc_b;
            img_t[idx] = trans;
            px = px + 1;
        }
        py = py + 1;
    }

    let mut mse: f64 = 0.0;
    let mut chk: f64 = 0.0;
    py = 0;
    while py < h {
        let mut px: usize = 0;
        while px < w {
            let idx: usize = py * w + px;
            let dr: f64 = img_r[idx] - room_gt_channel(px, py, 0, vx);
            let dg: f64 = img_g[idx] - room_gt_channel(px, py, 1, vx);
            let db: f64 = img_b[idx] - room_gt_channel(px, py, 2, vx);
            mse = mse + dr * dr + dg * dg + db * db;
            chk = chk + img_r[idx] + img_g[idx] * 2.0 + img_b[idx] * 3.0;
            px = px + 1;
        }
        py = py + 1;
    }
    mse = mse / ((n_pix * 3) as f64);
    checksum_out.push(chk);
    10.0 * log(1.0 / max_f64(1.0e-15, mse)) / log(10.0)
}

fn main() ~ Console + Clock {
    let mut failures: i32 = 0;

    // 1. Multi-View Keepsake Room Reconstruction (View 0 & View 1)
    let mut view_chks: Vec<f64> = Vec::new();
    let psnr_v0: f64 = render_room_view_psnr(0.0, &mut view_chks);
    let psnr_v1: f64 = render_room_view_psnr(1.0, &mut view_chks);
    let view0_chk: f64 = view_chks[0];
    let view1_chk: f64 = view_chks[1];

    // 2. 100,000-Splat Deterministic Tile-Binned 3D->2D Projection, Depth-Bucket Sort & Alpha Composite
    let n_splats: usize = 100000;
    let n_tiles: usize = 64;   // 8x8 grid of 16x16 tiles = 128x128 canvas
    let n_bins: usize = 32;    // front-to-back depth buckets [1.0, 9.0]
    let total_buckets: usize = n_tiles * n_bins;

    let mut tile_r: Vec<f64> = Vec::new();
    let mut tile_g: Vec<f64> = Vec::new();
    let mut tile_b: Vec<f64> = Vec::new();
    let mut tile_t: Vec<f64> = Vec::new();
    let mut bucket_r: Vec<f64> = Vec::new();
    let mut bucket_g: Vec<f64> = Vec::new();
    let mut bucket_b: Vec<f64> = Vec::new();
    let mut bucket_a: Vec<f64> = Vec::new();

    let mut bi: usize = 0;
    while bi < total_buckets {
        bucket_r.push(0.0);
        bucket_g.push(0.0);
        bucket_b.push(0.0);
        bucket_a.push(0.0);
        bi = bi + 1;
    }
    let mut ti: usize = 0;
    while ti < n_tiles {
        tile_r.push(0.0);
        tile_g.push(0.0);
        tile_b.push(0.0);
        tile_t.push(1.0);
        ti = ti + 1;
    }

    let t0: i64 = clock_ns();
    let mut s: usize = 0;
    let mut valid_splats: usize = 0;
    while s < n_splats {
        let si: i64 = s as i64;
        // Deterministic 3D Gaussian center (wx, wy, wz) in camera frustum
        let wx: f64 = ((((si * 73 + 19) % 1009) as f64) / 504.5) - 1.0;
        let wy: f64 = ((((si * 131 + 37) % 1013) as f64) / 506.5) - 1.0;
        let wz: f64 = 1.2 + ((((si * 53 + 11) % 997) as f64) / 997.0) * 7.5;
        // Pinhole 3D -> 2D projection onto 128x128 screen
        let u_px: f64 = 64.0 + (wx / wz) * 180.0;
        let v_px: f64 = 64.0 + (wy / wz) * 180.0;
        let cov_a: f64 = 1.4 + ((((si * 17) % 100) as f64) * 0.01);
        let cov_b: f64 = 0.15;
        let cov_c: f64 = 1.3 + ((((si * 23) % 100) as f64) * 0.01);
        let opacity: f64 = 0.04 + ((((si * 29) % 50) as f64) * 0.002);

        let in_bounds: bool = u_px >= 0.0 && u_px < 128.0 && v_px >= 0.0 && v_px < 128.0;
        if validate_splat(cov_a, cov_b, cov_c, opacity) == 0 && in_bounds {
            let det: f64 = cov_a * cov_c - cov_b * cov_b;
            let inv_a: f64 = cov_c / det;
            let inv_b: f64 = -cov_b / det;
            let inv_c: f64 = cov_a / det;
            let tx: usize = (u_px as usize) / 16;
            let ty: usize = (v_px as usize) / 16;
            let tile_id: usize = ty * 8 + tx;
            let cx: f64 = ((tx * 16 + 8) as f64) - u_px;
            let cy: f64 = ((ty * 16 + 8) as f64) - v_px;
            let quad: f64 = inv_a * cx * cx + 2.0 * inv_b * cx * cy + inv_c * cy * cy;
            let g_val: f64 = exp(-0.5 * min_f64(20.0, quad * 0.04));
            let eff_a: f64 = min_f64(0.99, opacity * g_val);

            let mut dbin: usize = (((wz - 1.0) / 8.0) * 32.0) as usize;
            if dbin >= n_bins { dbin = n_bins - 1; }
            let bidx: usize = tile_id * n_bins + dbin;
            let cr: f64 = 0.25 + ((((si * 31) % 100) as f64) * 0.007);
            let cg: f64 = 0.20 + ((((si * 43) % 100) as f64) * 0.007);
            let cb: f64 = 0.18 + ((((si * 59) % 100) as f64) * 0.007);
            // Accumulate into front-to-back tile depth bucket
            let rem: f64 = 1.0 - bucket_a[bidx];
            let contrib: f64 = rem * eff_a;
            bucket_r[bidx] = bucket_r[bidx] + contrib * cr;
            bucket_g[bidx] = bucket_g[bidx] + contrib * cg;
            bucket_b[bidx] = bucket_b[bidx] + contrib * cb;
            bucket_a[bidx] = bucket_a[bidx] + contrib;
            valid_splats = valid_splats + 1;
        }
        s = s + 1;
    }

    // Front-to-back depth-sorted tile compositing with early transmittance exit T < 1e-4
    let mut bench_chk: f64 = 0.0;
    ti = 0;
    while ti < n_tiles {
        let mut tr: f64 = 1.0;
        let mut ar: f64 = 0.0;
        let mut ag: f64 = 0.0;
        let mut ab: f64 = 0.0;
        let mut db_idx: usize = 0;
        while db_idx < n_bins {
            if tr < 1.0e-4 {
                break;
            }
            let bidx: usize = ti * n_bins + db_idx;
            ar = ar + tr * bucket_r[bidx];
            ag = ag + tr * bucket_g[bidx];
            ab = ab + tr * bucket_b[bidx];
            tr = tr * (1.0 - bucket_a[bidx]);
            db_idx = db_idx + 1;
        }
        tile_r[ti] = ar;
        tile_g[ti] = ag;
        tile_b[ti] = ab;
        tile_t[ti] = tr;
        bench_chk = bench_chk + ar + ag * 2.0 + ab * 3.0 + tr;
        ti = ti + 1;
    }
    let t1: i64 = clock_ns();
    let bench_100k_ns: i64 = t1 - t0;

    // 3. Planted Control #1: Unsorted (back-to-front) depth flips volumetric alpha compositing!
    // 4 overlapping splats at same pixel: front=red(0.75), mid1=green(0.75), mid2=blue(0.75), back=yellow(0.75)
    let mut c_front_r: f64 = 0.0;
    let mut c_front_b: f64 = 0.0;
    let mut tf: f64 = 1.0;
    c_front_r = c_front_r + tf * 0.75 * 1.0; tf = tf * 0.25;
    c_front_b = c_front_b + tf * 0.75 * 0.0; tf = tf * 0.25;
    c_front_b = c_front_b + tf * 0.75 * 1.0; tf = tf * 0.25;
    c_front_r = c_front_r + tf * 0.75 * 1.0;

    let mut c_rev_r: f64 = 0.0;
    let mut c_rev_b: f64 = 0.0;
    let mut trv: f64 = 1.0;
    c_rev_r = c_rev_r + trv * 0.75 * 1.0; trv = trv * 0.25;
    c_rev_b = c_rev_b + trv * 0.75 * 1.0; trv = trv * 0.25;
    c_rev_b = c_rev_b + trv * 0.75 * 0.0; trv = trv * 0.25;
    c_rev_r = c_rev_r + trv * 0.75 * 1.0;

    let unsorted_flip_err: f64 = abs_f64(c_front_r - c_rev_r) + abs_f64(c_front_b - c_rev_b);
    let ctrl1_unsorted_caught: bool = unsorted_flip_err > 0.12;

    // 4. Planted Control #2: Non-PSD 2D covariance (a=1.0, b=2.0, c=1.0 -> det=-3.0 <= 0)
    let ctrl2_status: i32 = validate_splat(1.0, 2.0, 1.0, 0.5);
    let ctrl2_non_psd_caught: bool = ctrl2_status == 1;

    // 5. Planted Control #3: Out-of-range opacity (alpha=1.35 > 1.0 and -0.10 < 0.0)
    let ctrl3_hi: i32 = validate_splat(1.2, 0.1, 1.2, 1.35);
    let ctrl3_lo: i32 = validate_splat(1.2, 0.1, 1.2, -0.10);
    let ctrl3_opacity_caught: bool = ctrl3_hi == 2 && ctrl3_lo == 2;

    if psnr_v0 < 32.0 || psnr_v1 < 32.0 { failures = failures + 1; }
    if valid_splats < 85000 { failures = failures + 1; }
    if !ctrl1_unsorted_caught || !ctrl2_non_psd_caught || !ctrl3_opacity_caught { failures = failures + 1; }

    println!("METRIC psnr_view0_db={:.9} psnr_view1_db={:.9}", psnr_v0, psnr_v1);
    println!("METRIC view0_chk={:.9} view1_chk={:.9}", view0_chk, view1_chk);
    println!(
        "METRIC splats_total={} valid_splats={} bench_100k_ns={} bench_chk={:.9}",
        n_splats, valid_splats, bench_100k_ns, bench_chk
    );
    println!(
        "METRIC ctrl1_unsorted_err={:.9} ctrl1_caught={} ctrl2_non_psd_caught={} ctrl3_opacity_caught={}",
        unsorted_flip_err, ctrl1_unsorted_caught, ctrl2_non_psd_caught, ctrl3_opacity_caught
    );
    println!("SUMMARY failures={}", failures);
}
