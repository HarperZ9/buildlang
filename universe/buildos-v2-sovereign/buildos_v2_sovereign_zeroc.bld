fn barrett3329(x: i64) -> i64 {
    let q: i64 = (x * 5039) >> 24;
    let mut r: i64 = x - q * 3329;
    if r >= 3329 { r = r - 3329; }
    if r >= 3329 { r = r - 3329; }
    return r;
}

fn widx5(i: i64) -> i64 {
    return (i * 205) >> 10;
}

fn p5_get(w: i64, i: i64) -> i64 {
    let lane: i64 = i - widx5(i) * 5;
    return (w >> (lane * 12)) & 4095;
}

fn p5_set(w: i64, i: i64, val: i64) -> i64 {
    let lane: i64 = i - widx5(i) * 5;
    let sh: i64 = lane * 12;
    let cur: i64 = (w >> sh) & 4095;
    return w + ((val - cur) << sh);
}

fn a_hat_coeff(row: i64, col: i64, idx: i64) -> i64 {
    let seed: i64 = 73 + row * 197 + col * 389;
    return barrett3329((idx * seed + row * 521 + col * 911 + 17) * 29);
}

fn cbd_coeff(kind: i64, idx: i64) -> i64 {
    let x: i64 = (idx * (13 + kind * 7) + kind * 31 + 5) ^ ((idx >> 1) * 19);
    let q5: i64 = (x * 52429) >> 18;
    let mut r: i64 = x - q5 * 5;
    while r >= 5 { r = r - 5; }
    let d: i64 = r - 2;
    if d < 0 { return 3329 + d; }
    return d;
}

