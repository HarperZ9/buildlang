                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p1 = p1 + 1;
        }
        j = 1; i = 0; while i < 8 { if hv[i] != exp_wal_sha(p0 * 8 + i) { j = 0; } i = i + 1; }
        if j == 0 { println("{}", -201); println("{}", 0); return -201; }

        i = 0; while i < 8 { prev_wal[i] = hv[i]; i = i + 1; }
        nvme_buf[p0] = ((cid & 15) << 24) | ((lba & 255) << 16) | ((pfn & 255) << 8) | 1;
        nvme_buf[4 + p0] = hv[0];
        p0 = p0 + 1;
    }
    i = 0; while i < 8 { nvme_buf[8 + i] = prev_wal[i]; i = i + 1; }

    // =========================================================================
    // PHASE 3: RFC 6962 Storage-Integrity Root = H(0x01 || L_iommu || L_nvme)
    // =========================================================================
