fn buildos_v2_run(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    // S01: Signed Boot (SHA-256 + anti-rollback + RFC 6962 + Ed25519 Boot Signature #1)
    let w_boot: i64 = os_s01_boot_log(0);
    if w_boot < 0 { return w_boot; }
    let mut boot_tamper: i64 = 0;
    if mode == 1 { boot_tamper = 1; }
    let w_boot_ed: i64 = os_ed25519_verify(0, boot_tamper, -101);
    if w_boot_ed < 0 { return w_boot_ed; }

    // S02: 4-Core SMP Work-Stealing + Sv39 W^X MMU + TLB Shootdown
    let w_smp: i64 = os_s02_smp_sv39_mmu(mode);
    if w_smp < 0 { return w_smp; }

    // S03 & S04: W^X Capability Scheduler + Zero-Copy Cap IPC & Merkle VFS
    let w_sched: i64 = os_s03_wx_cap_sched(0);
    if w_sched < 0 { return w_sched; }
    let w_vfs: i64 = os_s04_ipc_merkle_vfs(0);
    if w_vfs < 0 { return w_vfs; }

    // S05: PCIe IOMMU 20-PFN DMA Fence + NVMe SQ/CQ + SHA-256 Crash-Recovery WAL
    let w_stor: i64 = os_s05_iommu_nvme_wal(mode);
    if w_stor < 0 { return w_stor; }

    // S06: FIPS 203 q=3329 ML-KEM-512 Ring-NTT + X25519 + HKDF-SHA256 + AEAD Channel
    let w_pq: i64 = os_s06a_mlkem512(mode);
    if w_pq < 0 { return w_pq; }
    let w_khyb: i64 = os_s06b_x25519_hybrid_aead(w_pq);
    if w_khyb < 0 { return w_khyb; }

    // S07: Signed Package Manifest + RFC 6962 Log + Ed25519 Signature #2 + W^X / Cap Check
    let r_pkg: i64 = os_s07_pkg_manifest(0);
    if r_pkg != 1 { return r_pkg; }
    let w_pkg_ed: i64 = os_ed25519_verify(1, 0, -702);
    if w_pkg_ed < 0 { return w_pkg_ed; }
    let pkg_code_perm: i64 = 5; let pkg_data_perm: i64 = 3;
    let pkg_req_caps: i64 = 5; let pkg_allow: i64 = 13;
    if (pkg_code_perm & 6) == 6 || (pkg_data_perm & 6) == 6 || (pkg_req_caps & (pkg_allow ^ m32)) != 0 {
        println("{}", -703); println("{}", 0); println("{}", 1); return -703;
    }

    // S08: Confidential Enclave + Zero-Egress + Measurement-Bound Seal + Ed25519 Quote #3
    let r_encl: i64 = os_s08a_enclave_policy(0);
    if r_encl != 1 { return r_encl; }
    let w_encl_tag: i64 = os_s08b_enclave_seal(mode);
    if w_encl_tag < 0 { return w_encl_tag; }
    let w_encl_ed: i64 = os_ed25519_verify(2, 0, -502);
    if w_encl_ed < 0 { return w_encl_ed; }

    // S09: Certified GPU Command Queue + Shader Allowlist + 32-Tile Exclusive VRAM Arena
    let w_gpu: i64 = os_s09_gpu_vram(mode);
    if w_gpu < 0 { return w_gpu; }

    // S10: Capability-Isolated Display Compositor
    let w_disp: i64 = os_s10_cap_compositor(mode);
    if w_disp < 0 { return w_disp; }

    // S11: Anti-Keylogger HID + SAK + Hardware Mic Gate + Q15 Audio DSP Mixer
    let w_io: i64 = os_s11_input_audio_dsp(mode);
    if w_io < 0 { return w_io; }

    // Verify every individual live witness against expected digests before S12 root commit
    if w_boot != exp_v2_witness(0) || w_boot_ed != exp_v2_witness(1) || w_smp != exp_v2_witness(2) {
        println("{}", -901); println("{}", 0); println("{}", 1); return -901;
    }
    if w_sched != exp_v2_witness(3) || w_vfs != exp_v2_witness(4) || w_stor != exp_v2_witness(5) {
        println("{}", -901); println("{}", 0); println("{}", 1); return -901;
    }
    if w_pq != exp_v2_witness(6) || w_khyb != exp_v2_witness(7) || w_pkg_ed != exp_v2_witness(8) {
        println("{}", -901); println("{}", 0); println("{}", 1); return -901;
    }
    if w_encl_tag != exp_v2_witness(9) || w_encl_ed != exp_v2_witness(10) {
        println("{}", -901); println("{}", 0); println("{}", 1); return -901;
    }
    if w_gpu != exp_v2_witness(11) || w_disp != exp_v2_witness(12) || w_io != exp_v2_witness(13) {
        println("{}", -901); println("{}", 0); println("{}", 1); return -901;
    }
    let wh1: i64 = (w_boot ^ w_boot_ed ^ w_smp ^ w_sched ^ w_vfs ^ w_stor ^ w_pq) & m32;
    let wh2: i64 = (w_khyb ^ w_pkg_ed ^ w_encl_tag ^ w_encl_ed ^ w_gpu ^ w_disp ^ w_io) & m32;
    return os_s12_sovereign_root(wh1, wh2);
}

fn main() ~ Console {
    let _ = buildos_v2_run(0);
}
