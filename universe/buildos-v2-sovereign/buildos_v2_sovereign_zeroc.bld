            i = 0; while i < 52 { pa[i] = 0; i = i + 1; }
            i = 0; while i < 256 { c0 = widx5(i); pa[c0] = p5_set(pa[c0], i, cbd_coeff(col, i)); i = i + 1; }
            k = 1; len = 128;
