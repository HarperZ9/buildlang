// Wave 142B (Slice 33: F1/AC1/N11/N49/N53): Pure-BuildLang Zero-C Deterministic
// 4-Node (3f+1, f=1, 3/4 Quorum) Ed25519 BFT Consensus & Tamper-Evident RFC 6962
// Transparency Log (buildos_bft_consensus_ledger_zeroc.bld). Compiled directly by
// untouched Stage-2 buildc_crypto_stage2.exe (ZERO C compiler, ZERO Rust, ZERO
// external linker) across ALL FIVE zero-C ISAs.
//
// Modes:
//   0 = Clean 3-height 4-node BFT commit + 3/4 live Ed25519 QC + RFC 6962 root (status=1)
//   1 = Planted attack (a): Equivocating double-vote validator V1 slashed -> status=-101
//   2 = Planted attack (b): Insufficient 2/4 sub-quorum (< 3) -> status=-201
//   3 = Planted attack (c): 1-bit forged Ed25519 validator signature (V1) -> status=-301
//   4 = Planted attack (d): Tampered parent-hash / log history on Block 3 -> status=-401

fn rotr32(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

fn r64_hi(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((hi >> n) | (lo << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((lo >> m) | (hi << (32 - m))) & 4294967295;
}

fn r64_lo(hi: i64, lo: i64, n: i64) -> i64 {
    if n < 32 { return ((lo >> n) | (hi << (32 - n))) & 4294967295; }
    let m: i64 = n - 32;
    return ((hi >> m) | (lo << (32 - m))) & 4294967295;
}

fn bswap32(x: i64) -> i64 {
    return ((x & 255) << 24) | (((x >> 8) & 255) << 16) | (((x >> 16) & 255) << 8) | ((x >> 24) & 255);
}

