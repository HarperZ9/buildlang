                                else if q1 == 14 { b = 3; c = q3; d = 12; e = 13; }
                                else if q1 == 15 { b = 3; c = q3 + 1; d = 11; e = 9; }
                                else if q1 == 16 { b = 3; c = q3 + 2; d = 13; e = 11; }
                                else { b = 3; c = q3 + 3; d = 12; e = 9; }
                                c = c * 10; d = d * 10; e = e * 10;
                                if b == 1 || b == 2 {
                                    k = 0;
                                    while k < 10 {
                                        if b == 1 { acc[k] = fe[d + k] + fe[e + k]; }
                                        else { acc[k] = fe[d + k] - fe[e + k]; }
                                        k = k + 1;
                                    }
                                } else {
                                    k = 0; while k < 10 { acc[k] = 0; k = k + 1; }
                                    i = 0;
                                    while i < 10 {
                                        f = fe[d + i]; g = i & 1; j = 0;
                                        while j < 10 {
                                            h = i + j; q2 = 1;
                                            if g != 0 && (j & 1) != 0 { q2 = 2; }
                                            if h >= 10 { h = h - 10; q2 = q2 * 19; }
                                            acc[h] = acc[h] + f * fe[e + j] * q2; j = j + 1;
                                        }
                                        i = i + 1;
                                    }
                                }
                                cp = 0;
                                while cp < 2 {
                                    i = 0;
                                    while i < 10 {
                                        f = 26; g = m26; if (i & 1) != 0 { f = 25; g = 33554431; }
                                        h = acc[i] >> f; acc[i] = acc[i] & g;
                                        if i < 9 { acc[i + 1] = acc[i + 1] + h; } else { acc[0] = acc[0] + h * 19; }
                                        i = i + 1;
                                    }
                                    cp = cp + 1;
                                }
                                i = 0; while i < 10 { fe[c + i] = acc[i]; i = i + 1; }
                                q1 = q1 + 1;
                            }
                        }
                        q0 = q0 + 1;
                    }
                    p2 = p2 + 1;
                }
            }

            if p1 == 3 {
                i = 0; while i < 10 { fe[80 + i] = 0; fe[90 + i] = fe[20 + i]; i = i + 1; }
                fe[80] = 1; q0 = 0;
                while q0 < 255 {
                    q1 = 0;
                    while q1 < 2 {
                        a = 0; if q1 == 0 { if q0 != 2 && q0 != 4 { a = 14473; } } else { a = 14745; }
                        if a != 0 {
                            c = ((a >> 8) & 15) * 10; d = ((a >> 4) & 15) * 10; e = (a & 15) * 10;
                            k = 0; while k < 10 { acc[k] = 0; k = k + 1; }
                            i = 0;
                            while i < 10 {
                                f = fe[d + i]; g = i & 1; j = 0;
                                while j < 10 {
                                    h = i + j; q2 = 1;
                                    if g != 0 && (j & 1) != 0 { q2 = 2; }
                                    if h >= 10 { h = h - 10; q2 = q2 * 19; }
                                    acc[h] = acc[h] + f * fe[e + j] * q2; j = j + 1;
                                }
                                i = i + 1;
                            }
                            cp = 0;
                            while cp < 2 {
                                i = 0;
                                while i < 10 {
                                    f = 26; g = m26; if (i & 1) != 0 { f = 25; g = 33554431; }
                                    h = acc[i] >> f; acc[i] = acc[i] & g;
                                    if i < 9 { acc[i + 1] = acc[i + 1] + h; } else { acc[0] = acc[0] + h * 19; }
                                    i = i + 1;
                                }
                                cp = cp + 1;
                            }
                            i = 0; while i < 10 { fe[c + i] = acc[i]; i = i + 1; }
                        }
                        q1 = q1 + 1;
                    }
                    q0 = q0 + 1;
                }

                q0 = 0;
                while q0 < 2 {
                    d = q0 * 10; e = 80;
                    k = 0; while k < 10 { acc[k] = 0; k = k + 1; }
                    i = 0;
                    while i < 10 {
                        f = fe[d + i]; g = i & 1; j = 0;
                        while j < 10 {
                            h = i + j; q2 = 1;
                            if g != 0 && (j & 1) != 0 { q2 = 2; }
                            if h >= 10 { h = h - 10; q2 = q2 * 19; }
                            acc[h] = acc[h] + f * fe[e + j] * q2; j = j + 1;
                        }
                        i = i + 1;
                    }
                    cp = 0;
                    while cp < 3 {
                        i = 0;
                        while i < 10 {
                            f = 26; g = m26; if (i & 1) != 0 { f = 25; g = 33554431; }
                            h = acc[i] >> f; acc[i] = acc[i] & g;
                            if i < 9 { acc[i + 1] = acc[i + 1] + h; } else { acc[0] = acc[0] + h * 19; }
                            i = i + 1;
                        }
                        cp = cp + 1;
                    }
                    while acc[9] < 0 {
                        acc[0] = acc[0] - 19; acc[9] = acc[9] + 33554432;
                        cp = 0;
                        while cp < 2 {
                            i = 0;
                            while i < 10 {
                                f = 26; g = m26; if (i & 1) != 0 { f = 25; g = 33554431; }
                                h = acc[i] >> f; acc[i] = acc[i] & g;
                                if i < 9 { acc[i + 1] = acc[i + 1] + h; } else { acc[0] = acc[0] + h * 19; }
                                i = i + 1;
                            }
                            cp = cp + 1;
                        }
                    }
                    i = 0; while i < 10 { fe[120 + i] = acc[i]; i = i + 1; }
                    fe[120] = fe[120] + 19;
                    i = 0;
                    while i < 9 {
                        f = 26; g = m26; if (i & 1) != 0 { f = 25; g = 33554431; }
                        h = fe[120 + i] >> f; fe[120 + i] = fe[120 + i] & g;
                        fe[120 + i + 1] = fe[120 + i + 1] + h; i = i + 1;
                    }
                    a = fe[129] >> 25; fe[129] = fe[129] & 33554431;
                    if a > 0 { i = 0; while i < 10 { acc[i] = fe[120 + i]; i = i + 1; } }
                    if q0 == 0 { p2 = acc[0] & 1; }
                    else {
                        i = 0; while i < 8 { pt_w[i] = 0; i = i + 1; }
                        q1 = 0; i = 0;
                        while i < 10 {
                            f = 26; if (i & 1) != 0 { f = 25; }
                            b = q1 >> 5; c = q1 & 31;
                            pt_w[b] = (pt_w[b] | ((acc[i] << c) & m32)) & m32;
                            if c + f > 32 && b + 1 < 8 {
                                pt_w[b + 1] = (pt_w[b + 1] | (acc[i] >> (32 - c))) & m32;
                            }
                            q1 = q1 + f; i = i + 1;
                        }
                        pt_w[7] = pt_w[7] | (p2 << 31);
                    }
                    q0 = q0 + 1;
                }
                if p0 == 0 { i = 0; while i < 8 { lhs_w[i] = pt_w[i]; i = i + 1; } }
            }
            p1 = p1 + 1;
        }
        p0 = p0 + 1;
    }

    a = 1; i = 0; while i < 8 { if lhs_w[i] != pt_w[i] { a = 0; } i = i + 1; }
    if a == 0 { println("{}", -301); println("{}", 0); return -301; }
    return lhs_w[0];
}

// =============================================================================
// STAGE 1: 4-Validator (3f+1) Parent-Hash Chain + Equivocation Slash + 3/4 Quorum
//          + 4-Leaf RFC 6962 Append-Only Transparency Log Root MTH(D[0:4])
// Stack arrays: w[64]+hv[8]+prev[8]+leaves[32]+n01[8]+vh[4]+vseen[4] = 1,024 B < 1,350 B!
// =============================================================================
fn bft_stage1_chain_quorum_log(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut prev: [i64; 8] = [0; 8];
    let mut leaves: [i64; 32] = [0; 32];
    let mut n01: [i64; 8] = [0; 8];
    let mut vhash: [i64; 4] = [0; 4];
    let mut vseen: [i64; 4] = [0; 4];

    let mut i: i64 = 0; let mut j: i64 = 0; let mut step: i64 = 0; let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut t1: i64 = 0; let mut t2: i64 = 0; let mut s0: i64 = 0; let mut s1: i64 = 0;

    // Height 0: Genesis leaf L0 = H(0x00 || genesis)
    i = 0; while i < 8 { prev[i] = bft_genesis_w(i); hv[i] = prev[i]; i = i + 1; }
    i = 0; while i < 16 { w[i] = 0; i = i + 1; }
    w[0] = hv[0] >> 8;
    i = 1; while i < 8 { w[i] = (((hv[i - 1] & 255) << 24) | (hv[i] >> 8)) & m32; i = i + 1; }
    w[8] = (((hv[7] & 255) << 24) | 8388608) & m32; w[15] = 264;
    i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
    i = 16;
    while i < 64 {
        s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
        s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
    }
    a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
    i = 0;
    while i < 64 {
        s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
        t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
        s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
        t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
        h = g; g = f; f = e; e = (d + t1) & m32;
        d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
    }
    hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
    hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
    i = 0; while i < 8 { leaves[i] = hv[i]; i = i + 1; }

    // Heights 1..3: Parent-hash chain verification + 4-validator voting + equivocation & quorum checks
    step = 1;
    while step <= 3 {
        // Hash 64-byte block header: parent_hash(8w) || view(1w) || payload(7w)
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p1 = 0;
        while p1 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p1 == 0 {
                i = 0; while i < 8 { w[i] = prev[i]; i = i + 1; }
                // Planted attack (d): tamper bit 0 of Block 3 parent_hash -> breaks history chain!
                if mode == 4 && step == 3 { w[0] = w[0] ^ 1; }
                if w[0] != prev[0] { println("{}", -401); println("{}", 0); return -401; }
                w[8] = step;
                i = 0; while i < 7 { w[9 + i] = bft_payload_w((step - 1) * 7 + i); i = i + 1; }
            } else { w[0] = 2147483648; w[15] = 512; }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p1 = p1 + 1;
        }
        i = 0; while i < 8 { prev[i] = hv[i]; i = i + 1; }

        // Deterministic 4-validator voting round (f=1, quorum=3/4) + equivocation slashing
        i = 0; while i < 4 { vseen[i] = 0; vhash[i] = 0; i = i + 1; }
        let mut vote_cnt: i64 = 0;
        let mut v_rounds: i64 = 3;
        if mode == 1 && step == 3 { v_rounds = 4; }  // Extra conflicting vote from V1
        if mode == 2 && step == 3 { v_rounds = 2; }  // Sub-quorum 2/4 (< 3)
        j = 0;
        while j < v_rounds {
            let mut vid: i64 = j;
            let mut voted_h: i64 = prev[0];
            // Planted attack (a): Validator V1 equivocates with conflicting block hash in view 3!
            if mode == 1 && step == 3 && j == 3 { vid = 1; voted_h = prev[0] ^ 1; }
            if vseen[vid] != 0 {
                if vhash[vid] != voted_h {
                    // Equivocation detected -> slash validator and fail closed!
                    println("{}", -101); println("{}", 0); return -101;
                }
            } else {
                vseen[vid] = 1;
                vhash[vid] = voted_h;
                vote_cnt = vote_cnt + 1;
            }
            j = j + 1;
        }
        // Strict BFT quorum threshold check: require >= 2f+1 = 3 distinct validator votes
        if vote_cnt < 3 {
            println("{}", -201); println("{}", 0); return -201;
        }

        // Append RFC 6962 domain-separated leaf L_step = H(0x00 || block_hash_step)
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        w[0] = prev[0] >> 8;
        i = 1; while i < 8 { w[i] = (((prev[i - 1] & 255) << 24) | (prev[i] >> 8)) & m32; i = i + 1; }
        w[8] = (((prev[7] & 255) << 24) | 8388608) & m32; w[15] = 264;
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
        i = 0; while i < 8 { leaves[step * 8 + i] = hv[i]; i = i + 1; }
        step = step + 1;
    }

    // Verify computed Block 3 digest matches QC_3 signed digest
    j = 1; i = 0; while i < 8 { if prev[i] != bft_blk3_be(i) { j = 0; } i = i + 1; }
    if j == 0 { println("{}", -401); println("{}", 0); return -401; }

    // RFC 6962 4-leaf Merkle Tree Hash: step 0->N01, step 1->N23, step 2->ROOT(N01, N23)
    step = 0;
    while step < 3 {
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p1 = 0;
        while p1 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if step < 2 {
                let lo: i64 = step * 16; let ro: i64 = lo + 8;
                if p1 == 0 {
                    w[0] = (16777216 | (leaves[lo] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[i] = (((leaves[lo + i - 1] & 255) << 24) | (leaves[lo + i] >> 8)) & m32; i = i + 1;
                    }
                    w[8] = (((leaves[lo + 7] & 255) << 24) | (leaves[ro] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[8 + i] = (((leaves[ro + i - 1] & 255) << 24) | (leaves[ro + i] >> 8)) & m32; i = i + 1;
                    }
                } else { w[0] = (((leaves[ro + 7] & 255) << 24) | 8388608) & m32; w[15] = 520; }
            } else {
                if p1 == 0 {
                    w[0] = (16777216 | (n01[0] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[i] = (((n01[i - 1] & 255) << 24) | (n01[i] >> 8)) & m32; i = i + 1;
                    }
                    w[8] = (((n01[7] & 255) << 24) | (leaves[0] >> 8)) & m32;
                    i = 1;
                    while i < 8 {
                        w[8 + i] = (((leaves[i - 1] & 255) << 24) | (leaves[i] >> 8)) & m32; i = i + 1;
                    }
                } else { w[0] = (((leaves[7] & 255) << 24) | 8388608) & m32; w[15] = 520; }
            }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3]; e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32; hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32; hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p1 = p1 + 1;
        }
        if step == 0 { i = 0; while i < 8 { n01[i] = hv[i]; i = i + 1; } }
        else if step == 1 { i = 0; while i < 8 { leaves[i] = hv[i]; i = i + 1; } }
        step = step + 1;
    }

    j = 1; i = 0; while i < 8 { if hv[i] != exp_ledger_root(i) { j = 0; } i = i + 1; }
    if j == 0 { println("{}", -402); println("{}", 0); return -402; }
    return 1;
}

fn bft_consensus_run(mode: i64) -> i64 ~ Console {
    let r1: i64 = bft_stage1_chain_quorum_log(mode);
    if r1 != 1 { return r1; }
    // Verify ALL THREE (3/4 quorum: V0, V1, V2) live RFC 8032 Ed25519 QC_3 signatures!
    let ed0: i64 = bft_ed25519_verify(0, 0);
    if ed0 < 0 { return ed0; }
    let mut t1: i64 = 0;
    if mode == 3 { t1 = 1; } // Planted attack (c): 1-bit forged Ed25519 signature S on V1
    let ed1: i64 = bft_ed25519_verify(1, t1);
    if ed1 < 0 { return ed1; }
    let ed2: i64 = bft_ed25519_verify(2, 0);
    if ed2 < 0 { return ed2; }

    // Clean commit: status=1, committed=1, nodes=4, quorum=3, height=3, ed0..ed2, blk3[0..7], root[0..7]
    println("{}", 1);
    println("{}", 1);
    println("{}", 4);
    println("{}", 3);
    println("{}", 3);
    println("{}", ed0);
    println("{}", ed1);
    println("{}", ed2);
    let mut i: i64 = 0;
    while i < 8 { println("{}", bft_blk3_be(i)); i = i + 1; }
    i = 0;
    while i < 8 { println("{}", exp_ledger_root(i)); i = i + 1; }
    return 1;
}

fn main() ~ Console {
    let _ = bft_consensus_run(0);
}
