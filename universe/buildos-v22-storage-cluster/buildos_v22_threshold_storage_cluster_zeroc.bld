    i = 0;
    while i < 8 {
        q0 = ct[8 + i]; q1 = ct[24 + i]; q2 = par[i]; q3 = par[8 + i];
        u0 = 0;
        while u0 < 4 {
            u1 = 0; j = 0;
            while j < 4 {
                cp = (3 - j) * 8;
                a = gf_mul(st[u0 * 8 + 4], (q0 >> cp) & 255);
                b = gf_mul(st[u0 * 8 + 5], (q1 >> cp) & 255);
                c = gf_mul(st[u0 * 8 + 6], (q2 >> cp) & 255);
