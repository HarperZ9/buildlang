    }
    cp = h1 >> 26; h1 = h1 & m26; h2 = h2 + cp;
    cp = h2 >> 26; h2 = h2 & m26; h3 = h3 + cp;
    cp = h3 >> 26; h3 = h3 & m26; h4 = h4 + cp;
    cp = h4 >> 26; h4 = h4 & m26; h0 = h0 + cp * 5;
    cp = h0 >> 26; h0 = h0 & m26; h1 = h1 + cp;
    a = h0 + 5; cp = a >> 26; a = a & m26;
    b = h1 + cp; cp = b >> 26; b = b & m26;
