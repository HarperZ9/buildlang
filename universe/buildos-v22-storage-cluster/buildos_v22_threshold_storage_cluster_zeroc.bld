    if h4 + cp - 67108864 >= 0 { h0 = a; h1 = b; h2 = c; h3 = d; h4 = h4 + cp - 67108864; }
    a = ((h0 | (h1 << 26)) & m32) + otk[4]; cp = a >> 32; a = a & m32;
    b = (((h1 >> 6) | (h2 << 20)) & m32) + otk[5] + cp; cp = b >> 32; b = b & m32;
    c = (((h2 >> 12) | (h3 << 14)) & m32) + otk[6] + cp; cp = c >> 32; c = c & m32;
    d = ((((h3 >> 18) | (h4 << 8)) & m32) + otk[7] + cp) & m32;
    e = (a ^ tag[0]) | (b ^ tag[1]) | (c ^ tag[2]) | (d ^ tag[3]);
    if e != 0 { println("{}", -601); println("{}", 0); return -601; }

    // 9. Live ChaCha20 decryption of healed ciphertext and bit-exact 128B plaintext check
    i = 0; while i < 8 { leaves[i] = v22_derive_dek_word(k_master, i); i = i + 1; }
    h0 = 2654435769;
