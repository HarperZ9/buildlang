fn fp_add(a: i64, b: i64) -> i64 {
    let p: i64 = 2147480000 + 3647;
    let mut s: i64 = a + b;
    s = (s & p) + (s >> 31);
    let over: i64 = (s + 1) >> 31;
    return s - over * p;
}

fn fp_sub(a: i64, b: i64) -> i64 {
    let p: i64 = 2147480000 + 3647;
    return fp_add(a, p - b);
}

fn fp_mul(a: i64, b: i64) -> i64 {
    let p: i64 = 2147480000 + 3647;
    let prod: i64 = a * b;
    let mut s: i64 = (prod & p) + (prod >> 31);
    s = (s & p) + (s >> 31);
    let over: i64 = (s + 1) >> 31;
    return s - over * p;
}

fn fp_inv(a: i64) -> i64 {
    let mut exp: i64 = 2147480000 + 3645;
    let mut acc: i64 = 1;
    let mut cur: i64 = a;
    let mut i: i64 = 0;
    while i < 31 {
        let bit: i64 = exp & 1;
        let prod: i64 = fp_mul(acc, cur);
        acc = acc + bit * (prod - acc);
        cur = fp_mul(cur, cur);
        exp = exp >> 1;
        i = i + 1;
    }
    return acc;
}

fn q_mul(a: i64, b: i64) -> i64 {
    let q: i64 = 98784247763;
    let b_lo: i64 = b & 524287;
    let b_hi: i64 = b >> 19;
    let t1: i64 = (a * b_hi) % q;
    let t2: i64 = (t1 << 19) % q;
    let t3: i64 = (a * b_lo) % q;
    let sum: i64 = t2 + t3;
    let over: i64 = (sum + 38654705709) >> 37;
    return sum - over * q;
}

fn q_pow(base: i64, exp_in: i64) -> i64 {
    let mut exp: i64 = exp_in;
    let mut acc: i64 = 1;
    let mut cur: i64 = base;
    let mut i: i64 = 0;
    while i < 31 {
        let bit: i64 = exp & 1;
        let prod: i64 = q_mul(acc, cur);
        acc = acc + bit * (prod - acc);
        cur = q_mul(cur, cur);
        exp = exp >> 1;
        i = i + 1;
    }
    return acc;
}

fn pedersen_commit(v: i64, r: i64) -> i64 {
    let g: i64 = 34359770408;
    let h: i64 = 20254375004;
    return q_mul(q_pow(g, v), q_pow(h, r));
}

fn eval_poly2(c0: i64, c1: i64, c2: i64, x: i64) -> i64 {
    let x2: i64 = fp_mul(x, x);
    return fp_add(c0, fp_add(fp_mul(c1, x), fp_mul(c2, x2)));
}

fn vss_check_share(x: i64, y: i64, b: i64, c0: i64, c1: i64, c2: i64) -> i64 {
    let lhs: i64 = pedersen_commit(y, b);
    let x2: i64 = fp_mul(x, x);
    let rhs: i64 = q_mul(c0, q_mul(q_pow(c1, x), q_pow(c2, x2)));
    if lhs == rhs { return 1; }
    return 0;
}

fn lagrange_reconstruct(cnt: i64, x0: i64, y0: i64, x1: i64, y1: i64, x2: i64, y2: i64) -> i64 {
    if cnt < 3 { return -101; }
    if x0 < 1 || x0 > 5 || x1 < 1 || x1 > 5 || x2 < 1 || x2 > 5 { return -102; }
    if x0 == x1 || x0 == x2 || x1 == x2 { return -102; }
    let l0: i64 = fp_mul(fp_mul(fp_sub(0, x1), fp_sub(0, x2)), fp_inv(fp_mul(fp_sub(x0, x1), fp_sub(x0, x2))));
    let l1: i64 = fp_mul(fp_mul(fp_sub(0, x0), fp_sub(0, x2)), fp_inv(fp_mul(fp_sub(x1, x0), fp_sub(x1, x2))));
    let l2: i64 = fp_mul(fp_mul(fp_sub(0, x0), fp_sub(0, x1)), fp_inv(fp_mul(fp_sub(x2, x0), fp_sub(x2, x1))));
    return fp_add(fp_mul(y0, l0), fp_add(fp_mul(y1, l1), fp_mul(y2, l2)));
}

fn gf_mul(a_in: i64, b_in: i64) -> i64 {
    let mut a: i64 = a_in & 255;
    let mut b: i64 = b_in & 255;
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < 8 {
        let bit: i64 = b & 1;
        acc = acc ^ (a & (0 - bit));
        let hi: i64 = (a >> 7) & 1;
        a = ((a << 1) ^ (285 & (0 - hi))) & 255;
        b = b >> 1;
        i = i + 1;
    }
    return acc;
}

fn gf_inv(a: i64) -> i64 {
    let mut p: i64 = gf_mul(a, a);
    let mut res: i64 = p;
    let mut i: i64 = 0;
    while i < 6 {
        p = gf_mul(p, p);
        res = gf_mul(res, p);
        i = i + 1;
    }
    return res;
}

fn rs_mat(r: i64, c: i64) -> i64 {
    if r < 4 {
        if r == c { return 1; }
        return 0;
    }
    if r == 4 {
        if c == 0 { return 71; }
        else if c == 1 { return 167; }
        else if c == 2 { return 122; }
        else if c == 3 { return 186; }
    }
    if c == 0 { return 167; }
    else if c == 1 { return 71; }
    else if c == 2 { return 186; }
    else if c == 3 { return 122; }
    return 0;
}

fn stripe_pt_word(s: i64, wi: i64) -> i64 {
    let m32: i64 = 4294967295;
    let t0: i64 = 1112494898 ^ (((s + 1) * 2654435769) & m32);
    let t1: i64 = t0 ^ (((wi + 1) * 2246822507) & m32);
    return (t1 + s * 257 + wi * 31) & m32;
}

fn v22_stage1_threshold_hsm(mode: i64) -> i64 {
    let a0: i64 = 1513918951; let a1: i64 = 918273645; let a2: i64 = 1234567891;
    let r0: i64 = 1876543219; let r1: i64 = 445566778; let r2: i64 = 1998877665;
    let c0: i64 = pedersen_commit(a0, r0);
    let c1: i64 = pedersen_commit(a1, r1);
    let c2: i64 = pedersen_commit(a2, r2);
    let mut y0: [i64; 5] = [0; 5]; let mut b0: [i64; 5] = [0; 5];
    let mut y1: [i64; 5] = [0; 5]; let mut b1: [i64; 5] = [0; 5];
    let mut i: i64 = 0;
    while i < 5 {
        y0[i] = eval_poly2(a0, a1, a2, i + 1);
        b0[i] = eval_poly2(r0, r1, r2, i + 1);
        if vss_check_share(i + 1, y0[i], b0[i], c0, c1, c2) == 0 { return -202; }
        i = i + 1;
    }
    // Epoch 1 zero-secret proactive refresh (Attack 2 mode=2 injects g0=1337 != 0)
    let mut g0: i64 = 0;
    if mode == 2 { g0 = 1337; }
    let g1: i64 = 654321987; let g2: i64 = 1472583691;
    let u0: i64 = 0; let u1: i64 = 314159265; let u2: i64 = 271828182;
    let d0: i64 = pedersen_commit(g0, u0);
    let d1: i64 = pedersen_commit(g1, u1);
    let d2: i64 = pedersen_commit(g2, u2);
    if d0 != 1 { return -201; }
    let c0p: i64 = q_mul(c0, d0);
    let c1p: i64 = q_mul(c1, d1);
    let c2p: i64 = q_mul(c2, d2);
    if c0p != c0 || c1p == c1 { return -201; }
    i = 0;
    while i < 5 {
        let dx: i64 = eval_poly2(g0, g1, g2, i + 1);
        let ex: i64 = eval_poly2(u0, u1, u2, i + 1);
        if vss_check_share(i + 1, dx, ex, d0, d1, d2) == 0 { return -201; }
        y1[i] = fp_add(y0[i], dx);
        b1[i] = fp_add(b0[i], ex);
        if y1[i] == y0[i] { return -201; }
        if vss_check_share(i + 1, y1[i], b1[i], c0p, c1p, c2p) == 0 { return -202; }
        i = i + 1;
    }
    // Attack 1 mode=1: sub-threshold 2/5 Epoch-1 recovery attempt
    if mode == 1 { return lagrange_reconstruct(2, 2, y1[1], 4, y1[3], 0, 0); }
    // Reconstruct master key from 3 rotated Epoch-1 custodians {2, 4, 5}
    let k_rec: i64 = lagrange_reconstruct(3, 2, y1[1], 4, y1[3], 5, y1[4]);
    if k_rec != a0 { return -103; }
    return k_rec;
}

fn v22_derive_dek_word(k_master: i64, want_i: i64) -> i64 {
    let m32: i64 = 4294967295;
    let c0p: i64 = 5490325201; let c1p: i64 = 85464028118; let c2p: i64 = 40603644525;
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut i: i64 = 0;
    while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
    let mut p1: i64 = 0;
    while p1 < 2 {
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        if p1 == 0 {
            w[0] = 1112494898; w[1] = 38; w[2] = k_master & m32;
            w[3] = (c0p >> 32) & m32; w[4] = c0p & m32;
            w[5] = (c1p >> 32) & m32; w[6] = c1p & m32;
            w[7] = (c2p >> 32) & m32; w[8] = c2p & m32;
            w[9] = 1; w[10] = 3; w[11] = 5; w[12] = 4; w[13] = 2; w[14] = 128; w[15] = 1145391921;
        } else { w[0] = 2147483648; w[15] = 512; }
        i = 16;
        while i < 64 {
            let s0: i64 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            let s1: i64 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
        }
        let mut a: i64 = hv[0]; let mut b: i64 = hv[1]; let mut c: i64 = hv[2]; let mut d: i64 = hv[3];
        let mut e: i64 = hv[4]; let mut f: i64 = hv[5]; let mut g: i64 = hv[6]; let mut h: i64 = hv[7];
        i = 0;
        while i < 64 {
            let s1: i64 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let t1: i64 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            let s0: i64 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let t2: i64 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
        hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
        hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
        p1 = p1 + 1;
    }
    return hv[want_i];
}

fn v22_stage3_cluster_commit(k_master: i64, cap_mask: i64, t0: i64, t1_in: i64, t2_in: i64, t3_in: i64,
    ct_fold: i64, pt_fold: i64, hct0: i64, hct31: i64, dpt0: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    let c0: i64 = 5490325201; let c0p: i64 = 5490325201;
    let c1: i64 = 5932253081; let c1p: i64 = 85464028118;
    let c2: i64 = 32388936935; let c2p: i64 = 40603644525;
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut leaves: [i64; 32] = [0; 32];
    let mut dek: [i64; 8] = [0; 8];
    let mut i: i64 = 0;
    while i < 8 { dek[i] = v22_derive_dek_word(k_master, i); i = i + 1; }
