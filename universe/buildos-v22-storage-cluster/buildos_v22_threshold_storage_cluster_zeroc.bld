        cp = c >> 26; h2 = c & m26; d = d + cp;
        cp = d >> 26; h3 = d & m26; e = e + cp;
        cp = e >> 26; h4 = e & m26; h0 = h0 + cp * 5;
        cp = h0 >> 26; h0 = h0 & m26; h1 = h1 + cp;
