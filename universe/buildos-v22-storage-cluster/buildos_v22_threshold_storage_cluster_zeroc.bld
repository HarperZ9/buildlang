        p1 = 0;
        while p1 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p1 == 0 {
                if p0 == 0 {
                    w[0] = 1446130224; w[1] = 3; w[2] = 5; w[3] = k_master & m32;
                    w[4] = (c0 >> 32) & m32; w[5] = c0 & m32;
                    w[6] = (c0p >> 32) & m32; w[7] = c0p & m32;
                    w[8] = (c1 >> 32) & m32; w[9] = c1 & m32;
                    w[10] = (c1p >> 32) & m32; w[11] = c1p & m32;
                    w[12] = (c2 >> 32) & m32; w[13] = c2 & m32;
                    w[14] = (c2p >> 32) & m32; w[15] = c2p & m32;
                } else if p0 == 1 {
                    w[0] = 1446130225; w[1] = dek[0]; w[2] = dek[1]; w[3] = dek[2]; w[4] = dek[3];
                    w[5] = t0; w[6] = t1_in; w[7] = t2_in; w[8] = t3_in;
                    w[9] = 1112494898; w[10] = 38; w[11] = 1; w[12] = cap_mask;
                    w[13] = ct_fold; w[14] = 128; w[15] = 1095057732;
                } else if p0 == 2 {
