    while i < 6 { if ((u0 >> i) & 1) != 0 { u1 = u1 + 1; } i = i + 1; }
    if u1 > 2 { println("{}", -401); println("{}", 0); return -401; }
    // Live 2-shard simultaneous destruction (zero out shards 0 and 2) + RS(4,2) self-healing
    i = 0; while i < 8 { ct[i] = 0; ct[16 + i] = 0; i = i + 1; }
    st[40] = 1; st[41] = 3; st[42] = 4; st[43] = 5;
    i = 0;
    while i < 4 {
        j = 0;
        while j < 4 {
