                k = k + 1;
            }
            j = j + 1;
        }
        u1 = (u0 - 1) * 16;
        i = 0;
        while i < 16 {
            a = (st[16 + i] + st[i]) & m32;
            b = (ct[u1 + i] ^ a) & m32;
            if b != stripe_pt_word((u1 + i) >> 3, (u1 + i) & 7) {
                println("{}", -602); println("{}", 0); return -602;
            }
            if u1 + i == 0 { h2 = b; }
            h0 = (h0 * 33 + ct[u1 + i]) & m32;
            h1 = (h1 * 33 + b) & m32;
            i = i + 1;
        }
        u0 = u0 + 1;
    }
    return v22_stage3_cluster_commit(
        k_master, cap_mask, tag[0], tag[1], tag[2], tag[3], h0, h1, ct[0], ct[31], h2
