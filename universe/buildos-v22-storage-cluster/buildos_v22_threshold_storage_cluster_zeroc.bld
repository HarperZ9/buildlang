                a = st[q0]; b = st[q1]; c = st[q2]; d = st[q3];
                a = (a + b) & m32; d = rotr32(d ^ a, 16);
                c = (c + d) & m32; b = rotr32(b ^ c, 20);
                a = (a + b) & m32; d = rotr32(d ^ a, 24);
