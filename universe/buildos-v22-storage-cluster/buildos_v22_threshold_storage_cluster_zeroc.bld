    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut s0: i64 = 0; let mut s1: i64 = 0; let mut tv1: i64 = 0; let mut tv2: i64 = 0;
    while p0 < 4 {
