        while u0 < 4 && st[u0 * 8 + k] == 0 { u0 = u0 + 1; }
        if u0 != k {
            j = 0;
            while j < 8 {
                a = st[k * 8 + j]; st[k * 8 + j] = st[u0 * 8 + j]; st[u0 * 8 + j] = a; j = j + 1;
            }
        }
        u1 = gf_inv(st[k * 8 + k]);
        j = 0; while j < 8 { st[k * 8 + j] = gf_mul(st[k * 8 + j], u1); j = j + 1; }
        i = 0;
        while i < 4 {
