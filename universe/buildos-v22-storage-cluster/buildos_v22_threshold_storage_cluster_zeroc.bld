    }

    // 8. Live RFC 8439 Poly1305 AEAD verification on healed ciphertext (Attack 6 mode=6 -> -601)
    if mode == 6 { tag[0] = tag[0] ^ 1; }
    a = otk[0] & 268435455; b = otk[1] & 268435452; c = otk[2] & 268435452; d = otk[3] & 268435452;
    st[50] = a & m26; st[51] = ((a >> 26) | (b << 6)) & m26;
    st[52] = ((b >> 20) | (c << 12)) & m26; st[53] = ((c >> 14) | (d << 18)) & m26;
    st[54] = (d >> 8) & m26;
    h0 = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0;
    u0 = 0;
    while u0 < 10 {
        if u0 == 0 {
            q0 = 1112494898; q1 = 38; q2 = 1; q3 = cap_mask;
        } else if u0 < 9 {
            u1 = (u0 - 1) * 4;
            q0 = ct[u1]; q1 = ct[u1 + 1]; q2 = ct[u1 + 2]; q3 = ct[u1 + 3];
        } else { q0 = 16; q1 = 0; q2 = 128; q3 = 0; }
        h0 = h0 + (q0 & m26); h1 = h1 + (((q0 >> 26) | (q1 << 6)) & m26);
        h2 = h2 + (((q1 >> 20) | (q2 << 12)) & m26); h3 = h3 + (((q2 >> 14) | (q3 << 18)) & m26);
        h4 = h4 + ((q3 >> 8) | 16777216);
        a = h0 * st[50] + h1 * (st[54] * 5) + h2 * (st[53] * 5) + h3 * (st[52] * 5) + h4 * (st[51] * 5);
        b = h0 * st[51] + h1 * st[50] + h2 * (st[54] * 5) + h3 * (st[53] * 5) + h4 * (st[52] * 5);
        c = h0 * st[52] + h1 * st[51] + h2 * st[50] + h3 * (st[54] * 5) + h4 * (st[53] * 5);
        d = h0 * st[53] + h1 * st[52] + h2 * st[51] + h3 * st[50] + h4 * (st[54] * 5);
        e = h0 * st[54] + h1 * st[53] + h2 * st[52] + h3 * st[51] + h4 * st[50];
        cp = a >> 26; h0 = a & m26; b = b + cp;
