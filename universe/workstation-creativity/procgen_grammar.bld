// Wave 55I - Author Idea E16: Seeded Artifact Grammar Compiler (FIPS 180-4 SHA-256)
// Compiles 100 deterministic mixed scene/audio/layout artifact manifests from grammar specs
// in < 1 s with 100% bit-exact FIPS 180-4 SHA-256 repeatability across runs.
// Planted Control: empty grammar spec rejected fail-closed.

fn rotr32(x: i64, n: i64) -> i64 {
    let m: i64 = 4294967295;
    let v: i64 = x & m;
    ((v >> n) | ((v << (32 - n)) & m)) & m
}

// Pure FIPS 180-4 SHA-256 on byte Vec<i64> (avoids String::as_bytes()) -> returns 8 u32 words
fn sha256_bytes(msg: &Vec<i64>) -> Vec<i64> {
    let k: Vec<i64> = vec![
        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298,
    ];
    let mut h: Vec<i64> = vec![
        1779033703, 3144134277, 1013904242, 2773480762,
        1359893119, 2600822924, 528734635, 1541459225,
    ];
    let m32: i64 = 4294967295;
    let orig_len: usize = msg.len();
    let bit_len: i64 = (orig_len as i64) * 8;

    let mut padded: Vec<i64> = Vec::new();
    let mut i: usize = 0;
    while i < orig_len {
        padded.push(msg[i] & 255);
        i = i + 1;
    }
    padded.push(128);
    while (padded.len() % 64) != 56 {
        padded.push(0);
    }
    let mut sh: i64 = 56;
    while sh >= 0 {
        padded.push((bit_len >> sh) & 255);
        sh = sh - 8;
    }

    let n_blocks: usize = padded.len() / 64;
    let mut blk: usize = 0;
    while blk < n_blocks {
        let mut w: Vec<i64> = vec![0; 64];
        let mut t: usize = 0;
        while t < 16 {
            let b: usize = blk * 64 + t * 4;
            w[t] = (padded[b] << 24) | (padded[b + 1] << 16) | (padded[b + 2] << 8) | padded[b + 3];
            t = t + 1;
        }
        while t < 64 {
            let s0: i64 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3);
            let s1: i64 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10);
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & m32;
            t = t + 1;
        }

        let mut a: i64 = h[0];
        let mut b: i64 = h[1];
        let mut c: i64 = h[2];
        let mut d: i64 = h[3];
        let mut e: i64 = h[4];
        let mut f: i64 = h[5];
        let mut g: i64 = h[6];
        let mut hv: i64 = h[7];

        t = 0;
        while t < 64 {
            let s1: i64 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch: i64 = (e & f) ^ (((!e) & m32) & g);
            let t1: i64 = (hv + s1 + ch + k[t] + w[t]) & m32;
            let s0: i64 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj: i64 = (a & b) ^ (a & c) ^ (b & c);
            let t2: i64 = (s0 + maj) & m32;
            hv = g;
            g = f;
            f = e;
            e = (d + t1) & m32;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) & m32;
            t = t + 1;
        }
        h[0] = (h[0] + a) & m32;
        h[1] = (h[1] + b) & m32;
        h[2] = (h[2] + c) & m32;
        h[3] = (h[3] + d) & m32;
        h[4] = (h[4] + e) & m32;
        h[5] = (h[5] + f) & m32;
        h[6] = (h[6] + g) & m32;
        h[7] = (h[7] + hv) & m32;
        blk = blk + 1;
    }
    h
}

fn lcg_next(state: i64) -> i64 {
    let m: i64 = 2147483647;
    let nxt: i64 = (state * 48271) % m;
    if nxt <= 0 { nxt + m } else { nxt }
}

struct CompileResult {
    status: i32,
    h0: i64,
    h1: i64,
    bytes_emitted: usize,
}

// Compile a grammar spec (kind: 0=scene, 1=audio, 2=layout; n_rules > 0) -> manifest bytes + SHA-256
fn compile_grammar_manifest(seed: i64, kind: i64, n_rules: i32) -> CompileResult {
    if n_rules <= 0 {
        return CompileResult { status: 1, h0: 0, h1: 0, bytes_emitted: 0 };
    }
    let mut buf: Vec<i64> = Vec::new();
    // Canonical header bytes: 'G', 'R', 'M', kind, n_rules
    buf.push(71);
    buf.push(82);
    buf.push(77);
    buf.push(kind & 255);
    buf.push((n_rules as i64) & 255);

    let mut st: i64 = (seed * 131 + kind * 17 + 97) % 2147483647;
    if st <= 0 {
        st = st + 2147483647;
    }
    // Expand recursive production rules into deterministic numeric token stream
    let mut r: i32 = 0;
    while r < n_rules {
        st = lcg_next(st);
        let opcode: i64 = (st % 16) + kind * 16;
        st = lcg_next(st);
        let p1: i64 = st & 255;
        st = lcg_next(st);
        let p2: i64 = st & 255;
        st = lcg_next(st);
        let p3: i64 = st & 255;
        buf.push(opcode);
        buf.push(p1);
        buf.push(p2);
        buf.push(p3);
        r = r + 1;
    }
    let digest: Vec<i64> = sha256_bytes(&buf);
    CompileResult { status: 0, h0: digest[0], h1: digest[1], bytes_emitted: buf.len() }
}

fn main() ~ Clock + Console {
    let mut failures: i32 = 0;
    let t0_ns: i64 = clock_ns();

    // 1. FIPS 180-4 SHA-256("abc") sanity check: h0 == 0xba7816bf, h7 == 0xf20015ad
    let abc: Vec<i64> = vec![97, 98, 99];
    let d_abc: Vec<i64> = sha256_bytes(&abc);
    if d_abc[0] == 3128432319 && d_abc[7] == 4060091821 {
        println!("[PASS] sha256_fips180_4_abc h0={} h7={}", d_abc[0], d_abc[7]);
    } else {
        println!("[FAIL] sha256_fips180_4_abc h0={} h7={}", d_abc[0], d_abc[7]);
        failures = failures + 1;
    }

    // 2. Compile 100 mixed scene/audio/layout manifests twice and verify 100% SHA-256 repeatability
    let mut run1_h0: Vec<i64> = Vec::new();
    let mut run1_h1: Vec<i64> = Vec::new();
    let mut i: i32 = 0;
    while i < 100 {
        let kind: i64 = (i % 3) as i64;
        let rules: i32 = 8 + (i % 7);
        let res: CompileResult = compile_grammar_manifest((i + 1) as i64, kind, rules);
        if res.status != 0 {
            failures = failures + 1;
        }
        run1_h0.push(res.h0);
        run1_h1.push(res.h1);
        i = i + 1;
    }

    let mut repeat_ok: i32 = 0;
    let mut xor_h0: i64 = 0;
    i = 0;
    while i < 100 {
        let kind: i64 = (i % 3) as i64;
        let rules: i32 = 8 + (i % 7);
        let res2: CompileResult = compile_grammar_manifest((i + 1) as i64, kind, rules);
        if res2.h0 == run1_h0[i as usize] && res2.h1 == run1_h1[i as usize] {
            repeat_ok = repeat_ok + 1;
        }
        xor_h0 = xor_h0 ^ res2.h0;
        i = i + 1;
    }

    // Check all 100 manifests have distinct digests
    let mut dup_digests: i32 = 0;
    let mut a: usize = 0;
    while a < 100 {
        let mut b: usize = a + 1;
        while b < 100 {
            if run1_h0[a] == run1_h0[b] && run1_h1[a] == run1_h1[b] {
                dup_digests = dup_digests + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }

    let elapsed_ms: f64 = ((clock_ns() - t0_ns) as f64) / 1.0e6;
    if repeat_ok == 100 && dup_digests == 0 && elapsed_ms < 1000.0 {
        println!(
            "[PASS] procgen_100_manifests repeat={}/100 unique=100/100 elapsed_ms={:.4}",
            repeat_ok, elapsed_ms
        );
    } else {
        println!("[FAIL] procgen_100_manifests repeat={} dups={}", repeat_ok, dup_digests);
        failures = failures + 1;
    }

    // 3. Planted Control: Empty Grammar Spec Trap Rejected Fail-Closed
    let bad: CompileResult = compile_grammar_manifest(1, 0, 0);
    if bad.status == 1 {
        println!("[PASS] planted_ctrl_empty_spec caught status=1");
    } else {
        println!("[FAIL] planted_ctrl_empty_spec missed status={}", bad.status);
        failures = failures + 1;
    }

    println!(
        "[METRICS_E16] elapsed_ms={:.4} xor_h0={} failures={}",
        elapsed_ms, xor_h0, failures
    );
}
