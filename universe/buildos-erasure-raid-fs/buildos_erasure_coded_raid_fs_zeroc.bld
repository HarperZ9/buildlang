    else if r == 62 { return 3204031479; }
    else if r == 63 { return 3329325298; }
    return 0;
}

fn exp_raid_root(i: i64) -> i64 {
    if i == 0 { return 2152789816; }
    else if i == 1 { return 841460056; }
    else if i == 2 { return 3963987207; }
    else if i == 3 { return 380195933; }
    else if i == 4 { return 1382766012; }
    else if i == 5 { return 385681041; }
    else if i == 6 { return 427219716; }
    else if i == 7 { return 1565706480; }
    return 0;
}

fn gf_mul(a_in: i64, b_in: i64) -> i64 {
    let mut a: i64 = a_in & 255;
    let mut b: i64 = b_in & 255;
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < 8 {
        let bit: i64 = b & 1;
        acc = acc ^ (a & (0 - bit));
        let hi: i64 = (a >> 7) & 1;
        a = ((a << 1) ^ (285 & (0 - hi))) & 255;
        b = b >> 1;
        i = i + 1;
    }
    return acc;
}

fn gf_inv(a: i64) -> i64 {
    let mut p: i64 = gf_mul(a, a);
    let mut res: i64 = p;
    let mut i: i64 = 0;
    while i < 6 {
        p = gf_mul(p, p);
        res = gf_mul(res, p);
        i = i + 1;
    }
    return res;
}

fn rs_mat(r: i64, c: i64) -> i64 {
    if r < 4 {
        if r == c { return 1; }
        return 0;
    }
    if r == 4 {
        if c == 0 { return 71; }
        else if c == 1 { return 167; }
        else if c == 2 { return 122; }
        else if c == 3 { return 186; }
    }
    if c == 0 { return 167; }
    else if c == 1 { return 71; }
    else if c == 2 { return 186; }
    else if c == 3 { return 122; }
    return 0;
}

fn raid_data_word(s: i64, wi: i64) -> i64 {
    let m32: i64 = 4294967295;
    let t0: i64 = 1380010308 ^ (((s + 1) * 2654435769) & m32);
    let t1: i64 = t0 ^ (((wi + 1) * 2246822507) & m32);
    return (t1 + s * 131 + wi * 17) & m32;
}

fn raid_shard_word(s: i64, wi: i64) -> i64 {
    if s < 4 { return raid_data_word(s, wi); }
    let d0: i64 = raid_data_word(0, wi);
    let d1: i64 = raid_data_word(1, wi);
    let d2: i64 = raid_data_word(2, wi);
    let d3: i64 = raid_data_word(3, wi);
    let mut out: i64 = 0;
    let mut b: i64 = 0;
    while b < 4 {
        let sh: i64 = (3 - b) * 8;
        let v0: i64 = gf_mul(rs_mat(s, 0), (d0 >> sh) & 255);
        let v1: i64 = gf_mul(rs_mat(s, 1), (d1 >> sh) & 255);
        let v2: i64 = gf_mul(rs_mat(s, 2), (d2 >> sh) & 255);
        let v3: i64 = gf_mul(rs_mat(s, 3), (d3 >> sh) & 255);
        out = (out << 8) | ((v0 ^ v1 ^ v2 ^ v3) & 255);
        b = b + 1;
    }
    return out;
}

fn raid_heal_all15() -> i64 {
    let mut swords: [i64; 48] = [0; 48];
    let mut aug: [i64; 32] = [0; 32];
    let mut keep: [i64; 4] = [0; 4];
    let mut s: i64 = 0;
    let mut wi: i64 = 0;
    while s < 6 {
        wi = 0;
        while wi < 8 {
            swords[s * 8 + wi] = raid_shard_word(s, wi);
            wi = wi + 1;
        }
        s = s + 1;
    }
    let mut healed: i64 = 0;
    let mut e0: i64 = 0;
    let mut e1: i64 = 0;
    while e0 < 5 {
        e1 = e0 + 1;
        while e1 < 6 {
            // Select the 4 surviving shards
            let mut ki: i64 = 0;
            s = 0;
            while s < 6 {
                if s != e0 && s != e1 { keep[ki] = s; ki = ki + 1; }
                s = s + 1;
            }
            // Populate 4x8 augmented matrix [A | I_4] over GF(2^8)
            let mut r: i64 = 0;
            let mut c: i64 = 0;
            while r < 4 {
                c = 0;
                while c < 4 {
                    aug[r * 8 + c] = rs_mat(keep[r], c);
                    if r == c { aug[r * 8 + 4 + c] = 1; } else { aug[r * 8 + 4 + c] = 0; }
                    c = c + 1;
                }
                r = r + 1;
            }
            // Live 4x4 Gauss-Jordan inversion over GF(2^8)
            let mut col: i64 = 0;
            while col < 4 {
                let mut piv: i64 = col;
                while piv < 4 && aug[piv * 8 + col] == 0 { piv = piv + 1; }
                if piv >= 4 { return -102; }
                if piv != col {
                    c = 0;
                    while c < 8 {
                        let tmp: i64 = aug[col * 8 + c];
                        aug[col * 8 + c] = aug[piv * 8 + c];
                        aug[piv * 8 + c] = tmp;
                        c = c + 1;
                    }
                }
                let inv_p: i64 = gf_inv(aug[col * 8 + col]);
                c = 0;
                while c < 8 {
                    aug[col * 8 + c] = gf_mul(aug[col * 8 + c], inv_p);
                    c = c + 1;
                }
                r = 0;
                while r < 4 {
                    if r != col {
                        let fac: i64 = aug[r * 8 + col];
                        if fac != 0 {
                            c = 0;
                            while c < 8 {
                                aug[r * 8 + c] = aug[r * 8 + c] ^ gf_mul(fac, aug[col * 8 + c]);
                                c = c + 1;
                            }
                        }
                    }
                    r = r + 1;
                }
                col = col + 1;
            }
            // Reconstruct all 4 data shards (32 byte lanes) and verify bit-exact parity
            wi = 0;
            while wi < 8 {
                let w0: i64 = swords[keep[0] * 8 + wi];
                let w1: i64 = swords[keep[1] * 8 + wi];
                let w2: i64 = swords[keep[2] * 8 + wi];
                let w3: i64 = swords[keep[3] * 8 + wi];
                let mut dc: i64 = 0;
                while dc < 4 {
                    let mut rec_w: i64 = 0;
                    let mut b: i64 = 0;
                    while b < 4 {
                        let sh: i64 = (3 - b) * 8;
                        let m0: i64 = gf_mul(aug[dc * 8 + 4], (w0 >> sh) & 255);
                        let m1: i64 = gf_mul(aug[dc * 8 + 5], (w1 >> sh) & 255);
                        let m2: i64 = gf_mul(aug[dc * 8 + 6], (w2 >> sh) & 255);
                        let m3: i64 = gf_mul(aug[dc * 8 + 7], (w3 >> sh) & 255);
                        rec_w = (rec_w << 8) | ((m0 ^ m1 ^ m2 ^ m3) & 255);
                        b = b + 1;
                    }
                    if rec_w != swords[dc * 8 + wi] { return -103; }
                    dc = dc + 1;
                }
                wi = wi + 1;
            }
            healed = healed + 1;
            e1 = e1 + 1;
        }
        e0 = e0 + 1;
    }
    return healed;
}

fn raid_stage1_execute(mode: i64) -> i64 ~ Console {
    let m32: i64 = 4294967295;
    // Attack (d) mode=4: unauthorized write without CAP_FS_WRITE (bit 1 clear)
    let mut cap_mask: i64 = 7;
    if mode == 4 { cap_mask = 5; }
    if (cap_mask & 2) == 0 {
        println("{}", -401); println("{}", 0); return -401;
    }
    // Attack (a) mode=1: 3-shard simultaneous loss (shards 0, 1, 3) > m=2 tolerance
    let mut erased_mask: i64 = 0;
    if mode == 1 { erased_mask = 11; }
    let mut lost: i64 = 0;
    let mut i: i64 = 0;
    while i < 6 {
        if ((erased_mask >> i) & 1) != 0 { lost = lost + 1; }
        i = i + 1;
    }
    if lost > 2 {
        println("{}", -101); println("{}", 0); return -101;
    }

    // Compute live 6-shard RFC 6962 Storage Merkle Root MTH(D[0:6]) and scrub shards
    let mut w: [i64; 64] = [0; 64];
    let mut hv: [i64; 8] = [0; 8];
    let mut leaves: [i64; 48] = [0; 48];
    let mut s: i64 = 0;
    let mut p1: i64 = 0;
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0; let mut d: i64 = 0;
    let mut e: i64 = 0; let mut f: i64 = 0; let mut g: i64 = 0; let mut h: i64 = 0;
    let mut s0: i64 = 0; let mut s1: i64 = 0; let mut t1: i64 = 0; let mut t2: i64 = 0;
    while s < 6 {
        // Attack (c) mode=3: replay shard 1 payload and provenance header into slot 0
        let mut src_s: i64 = s;
        if mode == 3 && s == 0 { src_s = 1; }
        if src_s != s {
            println("{}", -301); println("{}", 0); return -301;
        }
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p1 = 0;
        while p1 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p1 == 0 {
                w[0] = 1380010308; w[1] = 37; w[2] = s; w[3] = cap_mask;
                w[4] = 4; w[5] = 2; w[6] = 32; w[7] = 1195782712;
                i = 0;
                while i < 8 {
                    let mut sw: i64 = raid_shard_word(src_s, i);
                    // Attack (b) mode=2: silent 1-bit bit-rot on surviving shard 2 word 3
                    if mode == 2 && s == 2 && i == 3 { sw = sw ^ 1; }
                    w[8 + i] = sw & m32;
                    i = i + 1;
                }
            } else { w[0] = 2147483648; w[15] = 512; }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
            e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
            hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
            hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p1 = p1 + 1;
        }
        // RFC 6962 leaf prefix 0x00 || hash32
        i = 0; while i < 16 { w[i] = 0; i = i + 1; }
        w[0] = hv[0] >> 8;
        i = 1;
        while i < 8 {
            w[i] = (((hv[i - 1] & 255) << 24) | (hv[i] >> 8)) & m32; i = i + 1;
        }
        w[8] = (((hv[7] & 255) << 24) | 8388608) & m32; w[15] = 264;
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        i = 16;
        while i < 64 {
            s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
        }
        a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
        e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
        i = 0;
        while i < 64 {
            s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
            s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
            h = g; g = f; f = e; e = (d + t1) & m32;
            d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
        }
        hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
        hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
        hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
        hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
        i = 0; while i < 8 { leaves[s * 8 + i] = hv[i]; i = i + 1; }
        s = s + 1;
    }

    // RFC 6962 MTH(D[0:6]) interior nodes:
    // step 0: N01=H(0x01||L0||L1)->leaves[0..7]
    // step 1: N23=H(0x01||L2||L3)->leaves[8..15]
    // step 2: N03=H(0x01||N01||N23)->leaves[0..7]
    // step 3: N45=H(0x01||L4||L5)->leaves[8..15]
    // step 4: ROOT=H(0x01||N03||N45)->hv[0..7]
    let mut step: i64 = 0;
    while step < 5 {
        let mut loff: i64 = 0;
        let mut roff: i64 = 8;
        if step == 1 { loff = 16; roff = 24; }
        else if step == 3 { loff = 32; roff = 40; }
        i = 0; while i < 8 { hv[i] = sha256_iv(i); i = i + 1; }
        p1 = 0;
        while p1 < 2 {
            i = 0; while i < 16 { w[i] = 0; i = i + 1; }
            if p1 == 0 {
                w[0] = (16777216 | (leaves[loff] >> 8)) & m32;
                i = 1;
                while i < 8 {
                    let lprev: i64 = leaves[loff + i - 1];
                    let lcur: i64 = leaves[loff + i];
                    w[i] = (((lprev & 255) << 24) | (lcur >> 8)) & m32; i = i + 1;
                }
                w[8] = (((leaves[loff + 7] & 255) << 24) | (leaves[roff] >> 8)) & m32;
                i = 1;
                while i < 8 {
                    let rprev: i64 = leaves[roff + i - 1];
                    let rcur: i64 = leaves[roff + i];
                    w[8 + i] = (((rprev & 255) << 24) | (rcur >> 8)) & m32; i = i + 1;
                }
            } else { w[0] = (((leaves[roff + 7] & 255) << 24) | 8388608) & m32; w[15] = 520; }
            i = 16;
            while i < 64 {
                s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
                s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
                w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32; i = i + 1;
            }
            a = hv[0]; b = hv[1]; c = hv[2]; d = hv[3];
            e = hv[4]; f = hv[5]; g = hv[6]; h = hv[7];
            i = 0;
            while i < 64 {
                s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                t1 = (h + s1 + ((e & f) ^ ((e ^ m32) & g)) + sha256_k(i) + w[i]) & m32;
                s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                t2 = (s0 + ((a & b) ^ (a & c) ^ (b & c))) & m32;
                h = g; g = f; f = e; e = (d + t1) & m32;
                d = c; c = b; b = a; a = (t1 + t2) & m32; i = i + 1;
            }
            hv[0] = (hv[0] + a) & m32; hv[1] = (hv[1] + b) & m32;
            hv[2] = (hv[2] + c) & m32; hv[3] = (hv[3] + d) & m32;
            hv[4] = (hv[4] + e) & m32; hv[5] = (hv[5] + f) & m32;
            hv[6] = (hv[6] + g) & m32; hv[7] = (hv[7] + h) & m32;
            p1 = p1 + 1;
        }
        if step == 0 || step == 2 { i = 0; while i < 8 { leaves[i] = hv[i]; i = i + 1; } }
        else if step == 1 || step == 3 { i = 0; while i < 8 { leaves[8 + i] = hv[i]; i = i + 1; } }
        step = step + 1;
    }

    // Merkle scrubber verification: catches silent 1-bit bit-rot fail-closed (-201)
    let mut scrub_ok: i64 = 1;
    i = 0;
    while i < 8 { if hv[i] != exp_raid_root(i) { scrub_ok = 0; } i = i + 1; }
    if scrub_ok == 0 { println("{}", -201); println("{}", 0); return -201; }

    // Live self-healing check across all 15/15 distinct 2-erasure failure patterns
    let healed: i64 = raid_heal_all15();
    if healed != 15 { println("{}", healed); println("{}", 0); return healed; }

    // Clean commit trace (19 i64 values)
    println("{}", 1);
    println("{}", 1);
    println("{}", 4);
    println("{}", 2);
    println("{}", cap_mask);
    println("{}", healed);
    println("{}", 192);
    println("{}", healed * 192);
    println("{}", 6);
    println("{}", 48);
    println("{}", 0);
    i = 0; while i < 8 { println("{}", hv[i]); i = i + 1; }
    return 1;
}

fn main() ~ Console {
    let _ = raid_stage1_execute(0);
}
